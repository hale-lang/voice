// Voice's log sink: every `std::log` event as one logfmt record, so a log
// is data a collector parses rather than text a person reads (the standard
// pack's first clause, GH #1591, "Logs are structured"):
//
//   time=2026-10-19T04:12:09Z level=info logger=voice.api msg=serving url=http://127.0.0.1:8080
//
// `time` is the event's own (stamped where it was logged, to the second),
// then `level`, `logger` and `msg`, then the event's fields as the caller
// wrote them with `std::log::kv`, which quotes a value as logfmt does.
// Info and below go to stdout, warnings and errors to stderr, as
// `std::log::StdoutSink` routes them; the record is the same on both.
// Each of voice's programs holds one in its `fn main`.

/// A `std::log` event's level, as a record names it.
fn level_name(level: Int) -> String {
    if level == 1 { return "info"; }
    if level == 2 { return "warn"; }
    if level == 3 { return "error"; }
    if level == 4 { return "debug"; }
    if level == 5 { return "trace"; }
    return "unknown";
}

/// The record of one event.
fn record(e: std::log::LogEvent) -> String {
    return "time=" + std::time::iso8601(std::time::time_from_unix(e.ts)) + " level=" + level_name(e.level) + " " + std::log::kv("logger", e.path) + " " + std::log::kv("msg", e.msg) + (if len(e.fields) > 0 { " " + e.fields } else { "" });
}

/// Writes every logger's events as records.
locus RecordSink {
    params { x: Int = 0; }
    bus { subscribe "log.**" as on_event of type std::log::LogEvent; }
    fn on_event(e: std::log::LogEvent) {
        if e.level == 2 || e.level == 3 { eprintln(record(e)); } else { println(record(e)); }
    }
}
