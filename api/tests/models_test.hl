// The caller plane's catalog: GET /v1/models and GET /v1/models/{model},
// as the presented project key sees them, through the router.
import ".." as api;

fn admin(e: api::Endpoints, method: String, path: String, body: String) -> std::http::Response {
    return e.handle(std::http::Request { method: method, path: path, body: body });
}

fn caller(e: api::Endpoints, path: String, key: String) -> std::http::Response {
    return e.handle(std::http::Request { method: "GET", path: path, headers: "Authorization: Bearer " + key });
}

fn expect(r: std::http::Response, status: Int, what: String) {
    std::test::assert_eq_int(r.status, status, what + ": " + r.body);
}

fn code(r: std::http::Response) -> String {
    return std::json::find_string_field(std::json::find_field_raw(r.body, "error"), "code");
}

/// A new key's secret.
fn key(e: api::Endpoints, project: String, body: String) -> String {
    let r = admin(e, "POST", "/admin/v1/projects/" + project + "/keys", body);
    expect(r, 201, "a key under " + project);
    return std::json::find_string_field(r.body, "secret");
}

fn main() {
    let e = api::Endpoints { };
    expect(admin(e, "POST", "/admin/v1/models", "{\"id\": \"echo-1\", \"context_length\": 8192, \"max_output_tokens\": 1024, \"price\": {\"input_per_mtok_micros\": 3000000, \"output_per_mtok_micros\": 15000000}}"), 201, "a model");
    expect(admin(e, "POST", "/admin/v1/models", "{\"id\": \"claude-sonnet-5\", \"owned_by\": \"anthropic\", \"kind\": \"hosted\"}"), 201, "another");
    expect(admin(e, "POST", "/admin/v1/models", "{\"id\": \"old-1\"}"), 201, "a third");
    expect(admin(e, "DELETE", "/admin/v1/models/old-1", ""), 200, "removed");
    expect(admin(e, "POST", "/admin/v1/projects", "{\"id\": \"work\", \"name\": \"Work\"}"), 201, "an open project");
    expect(admin(e, "POST", "/admin/v1/projects", "{\"id\": \"lab\", \"name\": \"Lab\", \"models\": [\"echo-1\"]}"), 201, "a restricted project");
    let open = key(e, "work", "{\"name\": \"ci\"}");
    let narrow = key(e, "work", "{\"name\": \"narrow\", \"models\": [\"claude-sonnet-5\"]}");
    let lab = key(e, "lab", "{\"name\": \"lab\"}");

    // who may ask
    let none = e.handle(std::http::Request { method: "GET", path: "/v1/models" });
    expect(none, 401, "no key");
    std::test::assert_eq_str(code(none), "invalid_key", "invalid_key");
    std::test::assert_eq_str(std::json::find_string_field(std::json::find_field_raw(none.body, "error"), "type"), "authentication_error", "an authentication error");
    expect(caller(e, "/v1/models", "vk-0000000000000000000000000000000000000000"), 401, "an unknown key");
    expect(e.handle(std::http::Request { method: "GET", path: "/v1/models", headers: "Authorization: Basic " + open }), 401, "not a bearer");

    // what each key sees
    let all = caller(e, "/v1/models", open);
    expect(all, 200, "the open key");
    std::test::assert(std::str::starts_with(all.headers, "X-Request-Id: req_"), "a request id");
    std::test::assert_eq_str(std::json::find_string_field(all.body, "object"), "list", "a list");
    std::test::assert(std::str::contains(all.body, "\"echo-1\"") && std::str::contains(all.body, "\"claude-sonnet-5\""), "the whole catalog");
    std::test::assert(!std::str::contains(all.body, "old-1"), "but no removed model");
    std::test::assert(!std::str::contains(caller(e, "/v1/models", narrow).body, "\"echo-1\""), "a key's restriction narrows it");
    let labs = caller(e, "/v1/models", lab);
    std::test::assert(std::str::contains(labs.body, "\"echo-1\"") && !std::str::contains(labs.body, "claude-sonnet-5"), "and so does a project's");

    // one model
    let one = caller(e, "/v1/models/echo-1", open);
    expect(one, 200, "get");
    std::test::assert_eq_str(std::json::find_string_field(one.body, "object"), "model", "a model");
    std::test::assert_eq_str(std::json::find_string_field(one.body, "owned_by"), "local", "owned_by");
    std::test::assert(std::json::find_int_field(one.body, "created") > 1700000000, "created, in Unix seconds");
    let v = std::json::find_field_raw(one.body, "voice");
    std::test::assert_eq_str(std::json::find_string_field(v, "kind"), "local", "kind");
    std::test::assert_eq_int(std::json::find_int_field(v, "max_output_tokens"), 1024, "max_output_tokens");
    std::test::assert_eq_int(std::json::find_int_field(std::json::find_field_raw(v, "price"), "input_per_mtok_micros"), 3000000, "its price");
    std::test::assert(!std::json::find_bool_field(v, "available"), "no seat serves it yet");
    std::test::assert_eq_str(std::str::trim(std::json::find_field_raw(v, "data_classes")), "[]", "so no data class either");

    let hidden = caller(e, "/v1/models/echo-1", narrow);
    expect(hidden, 404, "a model the key cannot see");
    std::test::assert_eq_str(code(hidden), "model_not_found", "is one that does not exist");
    expect(caller(e, "/v1/models/old-1", open), 404, "a removed model");
    expect(caller(e, "/v1/models/nope", open), 404, "an unknown model");
    expect(e.handle(std::http::Request { method: "GET", path: "/v1/models/echo-1" }), 401, "a key first");

    // a key stops working when it is revoked, or its project archived
    let listed = admin(e, "GET", "/admin/v1/projects/work/keys", "");
    let ci = std::json::find_string_field(std::json::array_first(std::json::find_field_raw(listed.body, "data")).element, "id");
    expect(admin(e, "DELETE", "/admin/v1/projects/work/keys/" + ci, ""), 200, "revoke");
    expect(caller(e, "/v1/models", open), 401, "a revoked key");
    expect(caller(e, "/v1/models", narrow), 200, "the project's other key still works");
    expect(admin(e, "DELETE", "/admin/v1/projects/lab", ""), 200, "archive");
    expect(caller(e, "/v1/models", lab), 401, "an archived project's key");
}
