// A project's rate limit from the admin to the caller, end to end
// through a DNA organization (hale-lang/voice#1): admin_limits.sh.
//
// It runs against a local hale checkout, HALE_SOURCE (with HALE_BIN built
// from it), and docker. The released toolchain voice builds with does not
// carry the head's service principal yet, so without HALE_SOURCE it is
// skipped, saying so.
fn script() -> String {
    if std::io::fs::file_exists("api/tests/admin_limits.sh") { return "api/tests/admin_limits.sh"; }
    return "tests/admin_limits.sh";
}

fn main() {
    if len(std::env::var("HALE_SOURCE")) == 0 {
        eprintln("admin_limits_test: skipped: it waits for a hale release that carries hale-lang/hale#1153 #1188 #1190 #1193 #1200; set HALE_SOURCE to a hale checkout to run it");
        return;
    }
    let ran = std::process::run("bash\n" + script()) or std::process::ProcessOutput { code: -1, signal: 0, stdout: "", stderr: "could not start bash" };
    std::test::assert_eq_int(ran.code, 0, "admin_limits.sh: " + ran.stdout + ran.stderr);
}
