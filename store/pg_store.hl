    fn route_table_locked() -> String fallible(StoreError) {
        return self.row(
            "SELECT (jsonb_build_object('version', version, 'at', to_char(at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.MS\"Z\"')) || body)::text FROM route_table",
            db::Args { },
        ) or raise;
    }

    // ---- the operator token

    fn operator_token(fresh: String) -> String fallible(StoreError) {
        self.lock.enter();
        let taken = self.operator_token_locked(fresh) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return taken;
    }

    /// The row kept, or `fresh` kept now: two apis minting at once keep
    /// the first one written, and both read it back.
    fn operator_token_locked(fresh: String) -> String fallible(StoreError) {
        if len(fresh) > 0 {
            let a = db::Args { };
            a.add(fresh);
            self.row(
                "INSERT INTO operator_token (token) VALUES ($1) ON CONFLICT (id) DO NOTHING RETURNING id",
                a,
            ) or raise;
        }
        let kept = self.row(
            "SELECT json_build_object('token', token)::text FROM operator_token",
            db::Args { },
        ) or raise;
        return std::json::find_string_field(kept, "token");
    }

    fn habitat_grant() -> String fallible(StoreError) {
        self.lock.enter();
        let taken = self.row("SELECT body::text FROM habitat_grant", db::Args { }) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return taken;
    }

    fn changes(q: ChangeQuery) -> ChangeRows fallible(StoreError) {
        self.lock.enter();
        let taken = self.changes_locked(q) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return taken;
    }

    fn changes_locked(q: ChangeQuery) -> ChangeRows fallible(StoreError) {
        let limit = if q.limit < 1 { 100 } else if q.limit > 1000 { 1000 } else { q.limit };
        let a = db::Args { };
        a.add(q.target);
        if q.has_from { a.add(std::time::iso8601(q.from)); } else { a.add_null(); }
        if q.has_to { a.add(std::time::iso8601(q.to)); } else { a.add_null(); }
        let cursor = if std::str::starts_with(q.cursor, "chg_") {
            std::str::parse_int(q.cursor[4..len(q.cursor)]) or 0
        } else {
            0
        };
        if len(q.cursor) > 0 {
            let c = db::Args { };
            c.add(to_string(cursor));
            let known = if cursor > 0 {
                self.row(
                    "SELECT row_to_json(t) FROM (SELECT id FROM change WHERE id = $1::bigint) t",
                    c,
                ) or raise
            } else {
                ""
            };
            if len(known) == 0 { return ChangeRows { cursor_known: false }; }
        }
        a.add(to_string(cursor));
        a.add(to_string(limit + 1));
        let all = self.rows(
            "SELECT row_to_json(t) FROM (SELECT id, at, action, target, before, after FROM change WHERE ($1 = '' OR target = $1 OR starts_with(target, $1 || '/')) AND ($2::timestamptz IS NULL OR at >= $2::timestamptz) AND ($3::timestamptz IS NULL OR at <= $3::timestamptz) AND ($4::bigint = 0 OR id < $4::bigint) ORDER BY id DESC LIMIT $5::int) t",
            a,
        ) or raise;
        let mut out = ChangeRows { };
        let v = std::str::bytes_view(all);
        let mut start = 0;
        while start < v.n {
            let nl = line_end(v, start);
            let line = std::str::trim(std::str::slice(v, start, nl));
            start = nl + 1;
            if len(line) == 0 { continue; }
            if count(out.rows) >= limit {
                out.more = true;
                return out;
            }
            let id = std::json::find_int_field(line, "id");
            push(out.rows, ChangeRow {
                seq: id,
                id: "chg_" + pad(id, 6),
                at: pg_time(pg_text(line, "at")),
                action: pg_text(line, "action"),
                target: pg_text(line, "target"),
                before: raw_or_empty(line, "before"),
                after: raw_or_empty(line, "after")
            }) or discard;
        }
        return out;
    }

    // ---- the usage ledger

    fn insert_usage(row: UsageRow) fallible(StoreError) {
        self.lock.enter();
        self.insert_usage_locked(row) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
    }

    fn insert_usage_locked(row: UsageRow) fallible(StoreError) {
        let a = db::Args { };
        a.add(row.id);
        a.add(std::time::iso8601(row.created_at));
        a.add(row.project);
        a.add(row.key);
        if len(row.account) > 0 { a.add(row.account); } else { a.add_null(); }
        a.add(row.requested_model);
        a.add(row.status);
        add_json(a, row.served);
        a.add(to_string(row.input_tokens));
        a.add(to_string(row.output_tokens));
        a.add(to_string(row.price_micros));
        a.add(row.currency);
        a.add(row.record);
        self.write(
            "INSERT INTO usage (id, created_at, project, key, account, requested_model, status, served, input_tokens, output_tokens, price_micros, currency, record) VALUES ($1, $2::timestamptz, $3, $4, $5, $6, $7, $8::jsonb, $9::bigint, $10::bigint, $11::bigint, $12, $13::jsonb) ON CONFLICT (id) DO NOTHING",
            a,
        ) or raise;
    }

    fn usage(id: String) -> UsageRow fallible(StoreError) {
        self.lock.enter();
        let taken = self.usage_locked(id) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return taken;
    }

    fn usage_locked(id: String) -> UsageRow fallible(StoreError) {
        let a = db::Args { };
        a.add(id);
        let line = self.row(
            "SELECT row_to_json(t) FROM (SELECT seq, id, created_at, record FROM usage WHERE id = $1) t",
            a,
        ) or raise;
        return if len(line) == 0 { UsageRow { } } else { usage_row(line) };
    }

    fn usage_rows(q: UsageQuery) -> UsageRows fallible(StoreError) {
        self.lock.enter();
        let taken = self.usage_rows_locked(q) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return taken;
    }

    fn usage_rows_locked(q: UsageQuery) -> UsageRows fallible(StoreError) {
        let limit = if q.limit < 1 { 100 } else if q.limit > 1000 { 1000 } else { q.limit };
        let a = db::Args { };
        let cond = usage_where(q, a);
        a.add(to_string(limit + 1));
        let all = self.rows(
            "SELECT row_to_json(t) FROM (SELECT seq, id, created_at, record FROM usage WHERE "
                + cond + " ORDER BY seq DESC LIMIT $" + to_string(9 + 2 * count(q.metadata.items))
                + "::int) t",
            a,
        ) or raise;
        let mut out = UsageRows { };
        let v = std::str::bytes_view(all);
        let mut start = 0;
        while start < v.n {
            let nl = line_end(v, start);
            let line = std::str::trim(std::str::slice(v, start, nl));
            start = nl + 1;
            if len(line) == 0 { continue; }
            if count(out.rows) >= limit {
                out.more = true;
                return out;
            }
            push(out.rows, usage_row(line)) or discard;
        }
        return out;
    }

    fn usage_after(seq: Int, limit: Int) -> UsageRows fallible(StoreError) {
        self.lock.enter();
        let taken = self.usage_after_locked(seq, limit) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return taken;
    }

    fn usage_after_locked(seq: Int, limit: Int) -> UsageRows fallible(StoreError) {
        let a = db::Args { };
        a.add(to_string(seq));
        a.add(to_string(limit));
        let all = self.rows(
            "SELECT row_to_json(t) FROM (SELECT seq, id, created_at, record FROM usage WHERE seq > $1::bigint ORDER BY seq LIMIT $2::int) t",
            a,
        ) or raise;
        let mut out = UsageRows { };
        let v = std::str::bytes_view(all);
        let mut start = 0;
        while start < v.n {
            let nl = line_end(v, start);
            let line = std::str::trim(std::str::slice(v, start, nl));
            start = nl + 1;
            if len(line) > 0 { push(out.rows, usage_row(line)) or discard; }
        }
        return out;
    }

    fn usage_summary(s: UsageSummaryQuery) -> UsageGroups fallible(StoreError) {
        self.lock.enter();
        let taken = self.usage_summary_locked(s) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return taken;
    }

    fn usage_summary_locked(s: UsageSummaryQuery) -> UsageGroups fallible(StoreError) {
        let mut exprs = "";
        let mut names = "";
        for f in s.by.items {
            let e = group_sql(f);
            if len(e) == 0 { fail StoreError { kind: "invalid", message: "no group " + f }; }
            exprs = exprs + (if len(exprs) > 0 { ", " } else { "" }) + "'" + f + "', " + e;
            names = names + f;
        }
        let a = db::Args { };
        let cond = usage_where(s.q, a);
        let all = self.rows(
            "SELECT row_to_json(t) FROM (SELECT jsonb_build_object(" + exprs
                + ")::text AS grp, count(*) AS requests, coalesce(sum(input_tokens), 0)::bigint AS input_tokens, coalesce(sum(output_tokens), 0)::bigint AS output_tokens, coalesce(sum(price_micros), 0)::bigint AS price_micros, currency, min(created_at) AS first_at, max(created_at) AS last_at, (array_agg(id ORDER BY seq DESC))[1] AS last_request FROM usage WHERE "
                + cond + " GROUP BY 1, currency ORDER BY max(seq) DESC LIMIT "
                + to_string(SUMMARY_GROUPS) + ") t",
            a,
        ) or raise;
        let mut out = UsageGroups { };
        let v = std::str::bytes_view(all);
        let mut start = 0;
        while start < v.n {
            let nl = line_end(v, start);
            let line = std::str::trim(std::str::slice(v, start, nl));
            start = nl + 1;
            if len(line) == 0 { continue; }
            push(out.rows, UsageGroup {
                group: pg_text(line, "grp"),
                requests: std::json::find_int_field(line, "requests"),
                input_tokens: std::json::find_int_field(line, "input_tokens"),
                output_tokens: std::json::find_int_field(line, "output_tokens"),
                price_micros: std::json::find_int_field(line, "price_micros"),
                currency: pg_text(line, "currency"),
                first_at: pg_time(pg_text(line, "first_at")),
                last_at: pg_time(pg_text(line, "last_at")),
                last_request: pg_text(line, "last_request")
            }) or discard;
        }
        return out;
    }

    // ---- the fleet as reported

    fn fleet(node: String) -> FleetRow fallible(StoreError) {
        self.lock.enter();
        let taken = self.fleet_locked(node) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return taken;
    }

    fn fleet_locked(node: String) -> FleetRow fallible(StoreError) {
        let a = db::Args { };
        a.add(node);
        let j = self.row(
            "SELECT row_to_json(t) FROM (SELECT node, version, capabilities, local, registered_at, applied_version, draining FROM node_state WHERE node = $1) t",
            a,
        ) or raise;
        if len(j) == 0 { return FleetRow { }; }
        return FleetRow {
            node: pg_text(j, "node"),
            version: pg_text(j, "version"),
            capabilities: raw_or_empty(j, "capabilities"),
            local: raw_or_empty(j, "local"),
            registered_at: pg_time(pg_text(j, "registered_at")),
            applied_version: if std::json::string_field(j, "applied_version").kind == "number" {
                std::json::find_int_field(j, "applied_version")
            } else {
                    -1
            },
            draining: std::json::find_bool_field(j, "draining"),
            present: true
        };
    }

    fn put_fleet(row: FleetRow) fallible(StoreError) {
        self.lock.enter();
        self.put_fleet_locked(row) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
    }

    fn put_fleet_locked(row: FleetRow) fallible(StoreError) {
        let a = db::Args { };
        a.add(row.node);
        a.add(row.version);
        a.add(row.capabilities);
        a.add(row.local);
        a.add(std::time::iso8601(row.registered_at));
        if row.applied_version >= 0 {
            a.add(to_string(row.applied_version));
        } else {
            a.add_null();
        }
        a.add(if row.draining { "true" } else { "false" });
        self.write(
            "INSERT INTO node_state (node, version, capabilities, local, registered_at, applied_version, draining) VALUES ($1, $2, $3::jsonb, $4::jsonb, $5::timestamptz, $6::int, $7::boolean) ON CONFLICT (node) DO UPDATE SET version = excluded.version, capabilities = excluded.capabilities, local = excluded.local, registered_at = excluded.registered_at, applied_version = excluded.applied_version, draining = excluded.draining",
            a,
        ) or raise;
    }

    fn beat(node: String) -> Beat fallible(StoreError) {
        self.lock.enter();
        let taken = self.beat_locked(node) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return taken;
    }

    fn beat_locked(node: String) -> Beat fallible(StoreError) {
        let a = db::Args { };
        a.add(node);
        let j = self.row(
            "SELECT row_to_json(t) FROM (SELECT last_heartbeat_at, in_flight FROM node_state WHERE node = $1 AND last_heartbeat_at IS NOT NULL) t",
            a,
        ) or raise;
        if len(j) == 0 { return Beat { }; }
        return Beat {
            at: pg_time(pg_text(j, "last_heartbeat_at")),
            in_flight: std::json::find_int_field(j, "in_flight"),
            present: true,
        };
    }

    fn put_beat(node: String, when: Time, in_flight: Int) fallible(StoreError) {
        self.lock.enter();
        self.put_beat_locked(node, when, in_flight) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
    }

    fn put_beat_locked(node: String, when: Time, in_flight: Int) fallible(StoreError) {
        // the store's clock, which the brain judges it by; `when` is the
        // memory store's
        let a = db::Args { };
        a.add(node);
        a.add(to_string(in_flight));
        self.write(
            "UPDATE node_state SET last_heartbeat_at = now(), in_flight = $2::int WHERE node = $1",
            a,
        ) or raise;
    }

    fn seat_states(node: String) -> SeatStateRows fallible(StoreError) {
        self.lock.enter();
        let taken = self.seat_states_locked(node) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return taken;
    }

    fn seat_states_locked(node: String) -> SeatStateRows fallible(StoreError) {
        let a = db::Args { };
        a.add(node);
        let all = self.rows(
            "SELECT row_to_json(t) FROM (SELECT node, seat, status, reason, in_flight, done_bytes, total_bytes, context FROM seat_state WHERE node = $1 ORDER BY seat) t",
            a,
        ) or raise;
        let mut out = SeatStateRows { };
        let v = std::str::bytes_view(all);
        let mut start = 0;
        while start < v.n {
            let nl = line_end(v, start);
            let line = std::str::trim(std::str::slice(v, start, nl));
            start = nl + 1;
            if len(line) == 0 { continue; }
            let seat = pg_text(line, "seat");
            push(out.rows, SeatStateRow {
                ref: node + "/" + seat,
                node: node,
                seat: seat,
                status: pg_text(line, "status"),
                reason: pg_text(line, "reason"),
                in_flight: std::json::find_int_field(line, "in_flight"),
                has_progress: std::json::string_field(line, "total_bytes").kind == "number",
                done_bytes: std::json::find_int_field(line, "done_bytes"),
                total_bytes: std::json::find_int_field(line, "total_bytes"),
                context: std::json::find_int_field(line, "context"),
                present: true
            }) or discard;
        }
        return out;
    }

    fn put_seat_state(row: SeatStateRow) fallible(StoreError) {
        self.lock.enter();
        self.put_seat_state_locked(row) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
    }

    fn put_seat_state_locked(row: SeatStateRow) fallible(StoreError) {
        let a = db::Args { };
        a.add(row.node);
        a.add(row.seat);
        a.add(row.status);
        if len(row.reason) > 0 { a.add(row.reason); } else { a.add_null(); }
        a.add(to_string(row.in_flight));
        if row.has_progress { a.add(to_string(row.done_bytes)); } else { a.add_null(); }
        if row.has_progress { a.add(to_string(row.total_bytes)); } else { a.add_null(); }
        if row.context > 0 { a.add(to_string(row.context)); } else { a.add_null(); }
        self.write(
            "INSERT INTO seat_state (node, seat, status, reason, in_flight, reported_at, done_bytes, total_bytes, context) VALUES ($1, $2, $3, $4, $5::int, now(), $6::bigint, $7::bigint, $8::int) ON CONFLICT (node, seat) DO UPDATE SET status = excluded.status, reason = excluded.reason, in_flight = excluded.in_flight, reported_at = excluded.reported_at, done_bytes = excluded.done_bytes, total_bytes = excluded.total_bytes, context = excluded.context",
            a,
        ) or raise;
    }

    fn put_flight(row: FlightRow) fallible(StoreError) {
        self.lock.enter();
        self.put_flight_locked(row) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
    }

    fn put_flight_locked(row: FlightRow) fallible(StoreError) {
        let a = db::Args { };
        a.add(row.request_id);
        a.add(row.project);
        a.add(row.key);
        a.add(row.model);
        a.add(row.seat);
        a.add(row.account);
        a.add(std::time::iso8601(row.started_at));
        // written anew, so a later attempt on another seat is told too
        self.write(
            "INSERT INTO in_flight (request_id, project, key, model, seat, account, started_at) VALUES ($1, $2, $3, $4, $5, $6, $7::timestamptz) ON CONFLICT (request_id) DO UPDATE SET seq = nextval('in_flight_seq_seq'), seat = excluded.seat, account = excluded.account, started_at = excluded.started_at",
            a,
        ) or raise;
    }

    fn drop_flight(request_id: String) fallible(StoreError) {
        self.lock.enter();
        let a = db::Args { };
        a.add(request_id);
        self.write("DELETE FROM in_flight WHERE request_id = $1", a) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
    }

    fn flights_after(seq: Int, limit: Int) -> FlightRows fallible(StoreError) {
        self.lock.enter();
        let out = self.flights_after_locked(seq, limit) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return out;
    }

    fn flights_after_locked(seq: Int, limit: Int) -> FlightRows fallible(StoreError) {
        let a = db::Args { };
        a.add(to_string(seq));
        a.add(to_string(if limit > 100 { 100 } else { limit }));
        let all = self.rows(
            "SELECT row_to_json(t) FROM (SELECT seq, request_id, project, key, model, seat, account, started_at FROM in_flight WHERE seq > $1::bigint AND started_at > now() - interval '1 hour' ORDER BY seq LIMIT $2::int) t",
            a,
        ) or raise;
        let mut out = FlightRows { };
        let v = std::str::bytes_view(all);
        let mut start = 0;
        while start < v.n {
            let nl = line_end(v, start);
            let line = std::str::trim(std::str::slice(v, start, nl));
            start = nl + 1;
            if len(line) == 0 { continue; }
            push(out.rows, FlightRow {
                seq: std::json::find_int_field(line, "seq"),
                request_id: pg_text(line, "request_id"),
                project: pg_text(line, "project"),
                key: pg_text(line, "key"),
                model: pg_text(line, "model"),
                seat: pg_text(line, "seat"),
                account: pg_text(line, "account"),
                started_at: pg_time(pg_text(line, "started_at")),
            }) or discard;
        }
        return out;
    }

    fn put_peek(row: PeekRow) fallible(StoreError) {
        self.lock.enter();
        self.put_peek_locked(row) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
    }

    fn put_peek_locked(row: PeekRow) fallible(StoreError) {
        let a = db::Args { };
        a.add(row.request_id);
        a.add(row.project);
        a.add(row.key);
        a.add(row.model);
        a.add(std::time::iso8601(row.created_at));
        a.add(row.input);
        a.add(row.output);
        self.write(
            "INSERT INTO peek (request_id, project, key, model, created_at, input, output) VALUES ($1, $2, $3, $4, $5::timestamptz, $6, $7) ON CONFLICT (request_id) DO NOTHING",
            a,
        ) or raise;
        let gone = db::Args { };
        gone.add(to_string(PEEK_DAYS));
        self.write(
            "DELETE FROM peek WHERE created_at < now() - ($1 || ' days')::interval",
            gone,
        ) or raise;
    }

    fn peeks(project: String, key: String, limit: Int) -> PeekRows fallible(StoreError) {
        self.lock.enter();
        let out = self.peeks_locked(project, key, limit) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return out;
    }

    fn peeks_locked(project: String, key: String, limit: Int) -> PeekRows fallible(StoreError) {
        let a = db::Args { };
        a.add(project);
        a.add(key);
        a.add(to_string(if limit > 200 { 200 } else { limit }));
        let all = self.rows(
            "SELECT row_to_json(t) FROM (SELECT request_id, project, key, model, created_at FROM peek WHERE ($1 = '' OR project = $1) AND ($2 = '' OR key = $2) ORDER BY created_at DESC, request_id LIMIT $3::int) t",
            a,
        ) or raise;
        let mut out = PeekRows { };
        let v = std::str::bytes_view(all);
        let mut start = 0;
        while start < v.n {
            let nl = line_end(v, start);
            let line = std::str::trim(std::str::slice(v, start, nl));
            start = nl + 1;
            if len(line) == 0 { continue; }
            push(out.rows, peek_row(line)) or discard;
        }
        return out;
    }

    fn peek(request_id: String) -> PeekRow fallible(StoreError) {
        self.lock.enter();
        let out = self.peek_locked(request_id) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return out;
    }

    fn peek_locked(request_id: String) -> PeekRow fallible(StoreError) {
        let a = db::Args { };
        a.add(request_id);
        let one = self.rows(
            "SELECT row_to_json(t) FROM (SELECT request_id, project, key, model, created_at, input, output FROM peek WHERE request_id = $1) t",
            a,
        ) or raise;
        let line = std::str::trim(one);
        if len(line) == 0 { return PeekRow { }; }
        return peek_row(line);
    }

    fn windows(account: String) -> String fallible(StoreError) {
        self.lock.enter();
        let taken = self.windows_locked(account) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
        return taken;
    }

    fn windows_locked(account: String) -> String fallible(StoreError) {
        let a = db::Args { };
        a.add(account);
        let j = self.row(
            "SELECT jsonb_agg(jsonb_build_object('name', name, 'used_percent', used_percent, 'resets_at', resets_at, 'observed_at', observed_at) || CASE WHEN seat IS NULL THEN '{}'::jsonb ELSE jsonb_build_object('seat', seat) END ORDER BY name) FROM quota_window WHERE account = $1",
            a,
        ) or raise;
        return if std::str::starts_with(j, "[") { j } else { "" };
    }

    fn put_windows(account: String, json: String) fallible(StoreError) {
        self.lock.enter();
        self.put_windows_locked(account, json) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
    }

    fn put_windows_locked(account: String, json: String) fallible(StoreError) {
        self.begin() or raise;
        let a = db::Args { };
        a.add(account);
        self.step("DELETE FROM quota_window WHERE account = $1", a) or raise;
        let b = db::Args { };
        b.add(account);
        b.add(json);
        self.step(
            "INSERT INTO quota_window (account, name, used_percent, resets_at, observed_at, seat) SELECT $1, w->>'name', (w->>'used_percent')::numeric, (w->>'resets_at')::timestamptz, (w->>'observed_at')::timestamptz, w->>'seat' FROM jsonb_array_elements($2::jsonb) w",
            b,
        ) or raise;
        let st = self.conn.commit();
        if !st.ok {
            self.conn.rollback();
            fail StoreError { message: "commit: " + st.err.detail };
        }
    }

    /// One statement on its own, over a fresh connection once when the
    /// first one is gone.
    fn write(sql: String, a: db::Args) fallible(StoreError) {
        if !self.open() {
            fail StoreError {
                message: "Postgres unreachable at " + self.conn.host + ":"
                    + to_string(self.conn.port),
            };
        }
        let mut r = self.conn.exec_params(sql, a);
        if !r.ok && r.err.kind == "io" && self.redial() { r = self.conn.exec_params(sql, a); }
        if !r.ok { fail StoreError { message: r.err.kind + ": " + r.err.detail }; }
    }
}

// ---- rows and their columns ----------------------------------------------

/// A DSN's parts; `problem` says what is wrong with it, "" when nothing is.
/// `vault` names the `std::secret` vault entry that holds the password,
/// when the DSN carries none (the habitat's, below).
type Dsn {
    host: String = "127.0.0.1";
    port: Int = 5432;
    user: String = "postgres";
    password: String = "";
    vault: String = "";
    database: String = "postgres";
    sslmode: String = "prefer";
    problem: String = "";
}

/// `postgres://user[:password]@host[:port]/database[?sslmode=MODE][&vault=ENTRY]`.
/// The credentials end at the last `@`, so a password may hold one, and
/// the user, the password and the database are percent-decoded. A DSN the
/// habitat hands a grafted heart (`HALE_DNA_DATABASE_DSN`) carries no
/// password: its `vault` names the entry that holds it, which pq reads on
/// the sealed side when it authenticates. A DSN with both is refused.
/// Nothing of a DSN is ever printed but the host and the port.
fn parse_dsn(url: String) -> Dsn {
    let mut d = Dsn { };
    let sep = std::str::index_of(url, "://");
    let mut rest = if sep >= 0 { url[(sep + 3)..len(url)] } else { url };
    let q = std::str::index_of(rest, "?");
    if q >= 0 {
        let query = rest[(q + 1)..len(rest)];
        d.sslmode = query_value(query, "sslmode", d.sslmode);
        d.vault = pct_decode(query_value(query, "vault", ""));
        rest = rest[0..q];
    }
    let at = last_index(rest, "@");
    if at >= 0 {
        let cred = rest[0..at];
        rest = rest[(at + 1)..len(rest)];
        let colon = std::str::index_of(cred, ":");
        if colon >= 0 {
            d.user = pct_decode(cred[0..colon]);
            d.password = pct_decode(cred[(colon + 1)..len(cred)]);
        } else {
            d.user = pct_decode(cred);
        }
    }
    let slash = std::str::index_of(rest, "/");
    if slash >= 0 {
        d.database = pct_decode(rest[(slash + 1)..len(rest)]);
        rest = rest[0..slash];
    }
    let pc = last_index(rest, ":");
    if pc >= 0 {
        d.host = rest[0..pc];
        d.port = std::str::parse_int(rest[(pc + 1)..len(rest)]) or - 1;
        if d.port < 1 || d.port > 65535 {
            d.problem = "the database URL's port is not a port number";
        }
    } else if len(rest) > 0 {
        d.host = rest;
    }
    if len(d.vault) > 0 && len(d.password) > 0 {
        d.problem = "the database URL names both a password and a vault entry for it";
    }
    return d;
}

/// Where a grafted voice finds its database: the habitat provisions the
/// `database` its genome needs (hale.toml, `[dna] needs`) and hands the
/// heart its DSN here, its password in the vault entry the DSN names.
const HABITAT_DATABASE_ENV: String = "HALE_DNA_DATABASE_DSN";

/// The database a program was given: `given` (its `--database`, or
/// `VOICE_DATABASE_URL`, standalone), else the habitat's when voice is
/// grafted, else "" (the store in memory).
fn database_or_habitat(given: String) -> String {
    if len(given) > 0 { return given; }
    return if std::env::var_exists(HABITAT_DATABASE_ENV) {
        std::env::var(HABITAT_DATABASE_ENV)
    } else {
        ""
    };
}

/// The value of `name` in a URL's query, `otherwise` without it.
fn query_value(query: String, name: String, otherwise: String) -> String {
    let key = name + "=";
    let at = if std::str::starts_with(query, key) {
        0
    } else {
        std::str::index_of(query, "&" + key)
    };
    if at < 0 { return otherwise; }
    let v = query[(at + (if at == 0 { 0 } else { 1 }) + len(key))..len(query)];
    let amp = std::str::index_of(v, "&");
    return if amp >= 0 { v[0..amp] } else { v };
}

/// `text` with the DSN's password, user and database taken out, for a
/// message that may quote what the driver was given.
fn redact(text: String, d: Dsn) -> String {
    let mut out = text;
    if len(d.password) > 0 { out = std::str::replace(out, d.password, "[password]"); }
    if len(d.user) > 0 { out = std::str::replace(out, d.user, "[user]"); }
    if len(d.database) > 0 { out = std::str::replace(out, d.database, "[database]"); }
    return out;
}

/// The index of the last `sub` in `s`, or -1.
fn last_index(s: String, sub: String) -> Int {
    let mut found = -1;
    let mut at = std::str::index_of(s, sub);
    while at >= 0 {
        found = at;
        at = std::str::index_of_from(s, sub, at + 1);
    }
    return found;
}

/// `%XX` escapes decoded; one that is not two hex digits is kept as it is.
fn pct_decode(s: String) -> String {
    if std::str::index_of(s, "%") < 0 { return s; }
    let v = std::str::bytes_view(s);
    let out = std::bytes::BytesBuilder { initial_cap: 64 };
    let mut i = 0;
    while i < v.n {
        let b = std::str::byte_at(v, i);
        let hi = hex_value(std::str::byte_at(v, i + 1));
        let lo = hex_value(std::str::byte_at(v, i + 2));
        if b == 37 && hi >= 0 && lo >= 0 {
            out.append(std::bytes::from_int(hi * 16 + lo));
            i = i + 3;
        } else {
            out.append(std::bytes::from_int(b));
            i = i + 1;
        }
    }
    let decoded = out.snapshot() or b"";
    return std::str::from_bytes(decoded);
}

fn hex_value(b: Int) -> Int {
    if b >= 48 && b <= 57 { return b - 48; }
    if b >= 65 && b <= 70 { return b - 55; }
    if b >= 97 && b <= 102 { return b - 87; }
    return -1;
}

/// Arguments of one value.
fn single_value(v: String) -> db::Args {
    let a = db::Args { };
    a.add(v);
    return a;
}

/// A `text[]` from the JSON array in parameter `$n`; `{}` for none.
fn names_param(n: Int) -> String {
    return "coalesce((SELECT array_agg(x) FROM jsonb_array_elements_text($" + to_string(n)
        + "::jsonb) x), '{}')";
}

/// A nullable `text[]` from the JSON array or `null` in parameter `$n`.
fn restriction_param(n: Int) -> String {
    return "CASE WHEN $" + to_string(n) + "::jsonb IS NULL THEN NULL ELSE " + names_param(n)
        + " END";
}

const MODEL_COLUMNS: String = "SELECT id, owned_by, kind, context_length, max_output_tokens, price, created_at, removed_at, recipe FROM catalog_model";

const PROJECT_COLUMNS: String = "SELECT p.id, p.name, p.status, p.owners, p.data_classes, p.models, p.accounts, p.inherits, p.parent, p.peek, p.position, p.created_at, p.archived_at, (SELECT row_to_json(b) FROM (SELECT allowance_micros, currency, period, period_anchor FROM budget WHERE project = p.id) b) AS budget, (SELECT coalesce(json_agg(json_build_object('scope', scope, 'model', model_id, 'account', account, 'window_seconds', window_seconds, 'requests', requests, 'input_tokens', input_tokens, 'output_tokens', output_tokens, 'concurrent', concurrent) ORDER BY id), '[]') FROM \"limit\" WHERE project = p.id AND key IS NULL AND scope IN ('project', 'model')) AS limits FROM project p";

const KEY_COLUMNS: String = "SELECT k.id, k.project, k.name, k.prefix, encode(k.secret_digest, 'hex') AS digest, k.models, k.accounts, k.status, k.created_at, k.expires_at, k.last_used_at, k.revoked_at, k.peek, (SELECT coalesce(json_agg(json_build_object('scope', scope, 'model', model_id, 'account', account, 'window_seconds', window_seconds, 'requests', requests, 'input_tokens', input_tokens, 'output_tokens', output_tokens, 'concurrent', concurrent) ORDER BY id), '[]') FROM \"limit\" WHERE key = k.id) AS limits FROM api_key k";

const ACCOUNT_COLUMNS: String = "SELECT a.id, a.name, a.provider, a.billing, a.status, a.created_at, a.archived_at, (SELECT coalesce(json_agg(json_build_object('scope', scope, 'model', model_id, 'account', account, 'window_seconds', window_seconds, 'requests', requests, 'input_tokens', input_tokens, 'output_tokens', output_tokens, 'concurrent', concurrent) ORDER BY id), '[]') FROM \"limit\" WHERE account = a.id AND scope = 'account') AS limits FROM account a";

const NODE_COLUMNS: String = "SELECT id, name, encode(token_digest, 'hex') AS token_digest, max_in_flight, status, assignment_version, created_at, revoked_at FROM node";

const SEAT_COLUMNS: String = "SELECT node, id, engine, account, serves, data_classes, concurrency, enabled, config FROM seat";

const INSERT_LIMIT: String = "INSERT INTO \"limit\" (scope, project, key, model_id, account, window_seconds, requests, input_tokens, output_tokens, concurrent) VALUES ($1, $2, $3, $4, $5, $6::int, $7::int, $8::bigint, $9::bigint, $10::int)";

/// The SQL a summary groups `field` by, "" for a field it does not.
fn group_sql(field: String) -> String {
    if field == "project" { return "project"; }
    if field == "key" { return "key"; }
    if field == "model" { return "coalesce(served->>'model', requested_model)"; }
    if field == "account" { return "coalesce(account, '')"; }
    if field == "seat" { return "coalesce(served->>'seat', '')"; }
    if field == "node" { return "coalesce(served->>'node', '')"; }
    if field == "conversation" { return "coalesce(record->>'conversation', '')"; }
    if field == "day" {
        return "to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"00:00:00\"Z\"')";
    }
    if field == "hour" {
        return "to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:00:00\"Z\"')";
    }
    return "";
}

/// The condition `q` puts on `usage` (the cursor included), its
/// parameters added to `a` as $1..$8 and then a pair each for the metadata.
// Each parameter goes into `a`, a list built for one statement.
@bounded_by(a)
fn usage_where(q: UsageQuery, a: db::Args) -> String {
    a.add(q.project);
    a.add(q.key);
    a.add(q.model);
    a.add(q.account);
    if q.has_from { a.add(std::time::iso8601(q.from)); } else { a.add_null(); }
    if q.has_to { a.add(std::time::iso8601(q.to)); } else { a.add_null(); }
    a.add(to_string(q.cursor));
    a.add(q.conversation);
    let mut cond = "($1 = '' OR project = $1) AND ($2 = '' OR key = $2) AND ($3 = '' OR requested_model = $3 OR served->>'model' = $3) AND ($4 = '' OR account = $4) AND ($5::timestamptz IS NULL OR created_at >= $5::timestamptz) AND ($6::timestamptz IS NULL OR created_at <= $6::timestamptz) AND ($7::bigint = 0 OR seq < $7::bigint) AND ($8 = '' OR record->>'conversation' = $8)";
    let mut n = 9;
    for pair in q.metadata.items {
        let eq = std::str::index_of(pair, "=");
        a.add(if eq < 0 { pair } else { pair[0..eq] });
        if eq < 0 { a.add_null(); } else { a.add(pair[(eq + 1)..len(pair)]); }
        cond = cond + " AND record->'metadata'->>$" + to_string(n) + " = $" + to_string(n + 1);
        n = n + 2;
    }
    return cond;
}

/// A ledger row as a read answers it.
fn usage_row(line: String) -> UsageRow {
    return UsageRow {
        seq: std::json::find_int_field(line, "seq"),
        id: pg_text(line, "id"),
        created_at: pg_time(pg_text(line, "created_at")),
        record: raw_or_empty(line, "record"),
        present: true
    };
}

/// A timestamptz as Postgres writes it in UTC (`...+00:00`), as a `Time`.
fn pg_time(text: String) -> Time {
    if len(text) == 0 { return `1970-01-01T00:00:00Z`; }
    let t = if std::str::ends_with(text, "+00:00") { text[0..(len(text) - 6)] + "Z" } else { text };
    return std::time::parse_time(t) or `1970-01-01T00:00:00Z`;
}

/// A text member, "" for `null` or absent (`find_string_field` answers
/// `null` as the text "null").
fn pg_text(json: String, name: String) -> String {
    let f = std::json::string_field(json, name);
    return if f.kind == "string" { f.text } else { "" };
}

/// A member's raw JSON, "" for `null` or absent.
fn raw_or_empty(json: String, name: String) -> String {
    let raw = std::str::trim(std::json::find_field_raw(json, name));
    return if len(raw) == 0 || raw == "null" { "" } else { raw };
}

/// A JSON array of strings as `Names`, empty for anything else.
fn pg_names(raw: String) -> Names {
    let mut out = Names { };
    let mut it = std::json::array_first(raw);
    while !it.done {
        let e = std::str::trim(it.element);
        if len(e) >= 2 && std::str::starts_with(e, "\"") {
            push(out.items, std::json::unescape_string(e[1..(len(e) - 1)])) or discard;
        }
        it = std::json::array_next(it);
    }
    return out;
}

/// A nullable `text[]` as a `Restriction`.
fn pg_restriction(json: String, name: String) -> Restriction {
    let raw = raw_or_empty(json, name);
    if len(raw) == 0 { return Restriction { }; }
    return Restriction { any: false, names: pg_names(raw) };
}

/// A count that may be `null`, -1 for `null`.
fn pg_count(json: String, name: String) -> Int {
    return if std::json::string_field(json, name).kind == "number" {
        std::json::find_int_field(json, name)
    } else {
            -1
    };
}

/// The limits a row's `limits` column holds.
fn pg_limits(json: String) -> Limits {
    let mut out = Limits { };
    let mut it = std::json::array_first(std::json::find_field_raw(json, "limits"));
    while !it.done {
        let l = it.element;
        push(out.items, counted(Limit {
            scope: scope_of(pg_text(l, "scope")),
            model: pg_text(l, "model"),
            account: pg_text(l, "account"),
            window_seconds: std::json::find_int_field(l, "window_seconds"),
            requests: pg_count(l, "requests"),
            input_tokens: pg_count(l, "input_tokens"),
            output_tokens: pg_count(l, "output_tokens"),
            concurrent: pg_count(l, "concurrent")
        })) or discard;
        it = std::json::array_next(it);
    }
    return out;
}

fn model_row(j: String) -> ModelRow {
    if len(j) == 0 { return ModelRow { }; }
    let price = std::json::find_field_raw(j, "price");
    let priced = std::json::string_field(j, "price").kind == "object";
    let removed = len(raw_or_empty(j, "removed_at")) > 0;
    return ModelRow {
        id: pg_text(j, "id"),
        owned_by: pg_text(j, "owned_by"),
        kind: pg_text(j, "kind"),
        context_length: if pg_count(j, "context_length") > 0 {
            pg_count(j, "context_length")
        } else {
            0
        },
        max_output_tokens: if pg_count(j, "max_output_tokens") > 0 {
            pg_count(j, "max_output_tokens")
        } else {
            0
        },
        priced: priced,
        price: if priced {
            ModelPrice {
                input_per_mtok_micros: std::json::find_int_field(price, "input_per_mtok_micros"),
                output_per_mtok_micros: std::json::find_int_field(price, "output_per_mtok_micros"),
                currency: pg_text(price, "currency"),
            }
        } else {
            ModelPrice { }
        },
        created_at: pg_time(pg_text(j, "created_at")),
        removed: removed,
        removed_at: pg_time(pg_text(j, "removed_at")),
        recipe: pg_text(j, "recipe"),
        present: true
    };
}

