// A page of the change log is built in memory linear in its size, and is
// small whatever the changes hold: a page lists each change's summary, not
// the resource it holds (getChange answers that), so the largest page, 100
// changes of a project of a few hundred bytes each, is a few kilobytes of
// JSON, and the process's peak grows linearly as it is built and written
// (hale: the codec's list encoder keeps every prefix it made, so a page of
// whole changes grew quadratically).
import ".." as api;
import "../../store" as st;

/// The process's peak resident memory so far, in kB (`VmHWM`).
fn peak_kb() -> Int {
    let status = std::io::fs::read_file("/proc/self/status") or "";
    let at = std::str::index_of(status, "VmHWM:");
    if at < 0 { return 0; }
    let rest = std::str::trim(status[at + 6..len(status)]);
    let end = std::str::index_of(rest, " ");
    return std::str::parse_int(rest[0..end]) or 0;
}

fn main() {
    let store = st::MemoryStore { };
    let projects = api::Projects { store: store };
    let changes = api::Changes { store: store };
    let long = "a project whose name is long enough that each of its changes carries a few hundred bytes of JSON, before and after";
    projects.create(api::ProjectCreate { id: "work", name: long }) or discard;
    let mut i = 1;
    while i < 1000 {
        let mut renamed = "";
        projects.update(
            api::ProjectUpdate {
                project: "work",
                has_name: true,
                name: long + " " + to_string(i),
            },
        ) or {
            renamed = api::ctl_problem(err).message;
        };
        std::test::assert_eq_str(renamed, "", "rename " + to_string(i));
        i = i + 1;
    }

    let before = peak_kb();
    std::test::assert(before > 0, "the peak is readable from /proc/self/status");
    let page = changes.list(api::ChangeAsk { }) or api::ChangeList { };
    let built = peak_kb();
    std::test::assert(
        count(page.data) == 100 && page.has_next_cursor,
        "the default page is the largest, 100, and names the next",
    );
    let newest = changes.get(
        api::ChangeRef {
            change: (
                at(page.data, 0) or api::ChangeSummary { action: api::ChangeAction::create }
            ).id,
        },
    ) or api::Change { action: api::ChangeAction::create };
    std::test::assert(
        std::str::contains(newest.after.text, long + " 999"),
        "the newest first, whole by its id",
    );
    let body = api::ChangeList::api_encode(page);
    let after = peak_kb();
    std::test::assert(
        len(body) < 32768,
        "100 changes listed, without what they hold, are under 32 KiB: " + to_string(len(body)),
    );
    std::test::assert(
        !std::str::contains(body, long),
        "no resource a change holds is on the page",
    );
    std::test::assert(
        built - before < 32768,
        "building the page grew the peak by " + to_string(built - before)
            + " kB; under 32 MB is linear",
    );
    std::test::assert(
        after - built < 32768,
        "encoding the page (the transport's codec) grew the peak by " + to_string(after - built)
            + " kB; under 32 MB is linear",
    );
}
