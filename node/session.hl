/// The node's connection to the coordinator (../protocol.yaml).
///
/// Skeleton: it reaches for the coordinator, retries, and reports its state
/// in `session.json`. The protocol (hello, welcome, seats, heartbeat, serve)
/// lands with the coordinator's end of it.
locus Session {
    params {
        id: String = "";
        data: String = "node-data";
        coordinator: String = "";
        token: String = "";
        connected_at: String = "";
    }
    run() {
        while true {
            self.attempt();
            std::time::sleep(5s);
        }
    }
    /// One try. A method, so each iteration's memory is reclaimed.
    fn attempt() {
        let url = std::http::parse_url(self.coordinator) or std::http::Url { };
        if len(url.host) == 0 {
            self.report("refused", "bad coordinator address: " + self.coordinator);
            return;
        }
        let fd = std::io::tcp::connect(url.host, url.port) or - 1;
        if fd < 0 {
            self.report("connecting", "coordinator unreachable at " + url.host + ":" + to_string(url.port));
            return;
        }
        std::io::tcp::close_fd(fd);
        self.report("connecting", "coordinator reachable; the node protocol is not implemented yet");
    }
    fn report(state: String, error: String) {
        let body = "{\"url\": \"" + std::json::escape_string(self.coordinator) + "\", \"state\": \"" + state + "\", \"connected_at\": null, \"last_error\": \"" + std::json::escape_string(error) + "\"}";
        std::io::fs::write_file(self.data + "/session.json", body) or discard;
    }
}
