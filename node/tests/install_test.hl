// The install, without a machine to install on: enrolling against an api
// that answers as the real one does, the capabilities voice decides, the
// LaunchDaemon's plist and the systemd unit, and an account's home.
import ".." as node;

/// An api with node `taken` already recorded.
locus FakeApi {
    params { calls: String = ""; }
    fn send(method: String, path: String, body: String) -> node::Reply {
        self.calls = self.calls + method + " " + path + "\n";
        if method == "POST" && path == "/admin/v1/nodes" {
            if std::str::contains(body, "\"taken\"") {
                return node::Reply { status: 409, body: "{}" };
            }
            return node::Reply {
                status: 201,
                body: "{\"id\": \"new\", \"enrollment_token\": \"vn-new\"}",
            };
        }
        if method == "POST" && path == "/admin/v1/nodes/taken/token" {
            return node::Reply { status: 200, body: "{\"enrollment_token\": \"vn-rotated\"}" };
        }
        return node::Reply { status: 500, body: "unexpected" };
    }
}

/// An api that refuses the operator token.
locus RefusingApi {
    fn send(method: String, path: String, body: String) -> node::Reply {
        return node::Reply { status: 401, body: "{\"Unauthorized\": {}}" };
    }
}

fn main() {
    claude_tokens_kept();
    claude_found();
    let api = FakeApi { };
    let fresh = node::enroll(api, "new", false);
    std::test::assert(
        fresh.ok && fresh.token == "vn-new",
        "a new node is recorded, its token kept",
    );
    let again = node::enroll(api, "taken", true);
    std::test::assert(
        again.ok && len(again.token) == 0,
        "installing again with the token kept changes nothing",
    );
    let lost = node::enroll(api, "taken", false);
    std::test::assert(
        lost.ok && lost.token == "vn-rotated",
        "a node whose token is gone is given a new one",
    );
    let refused = node::enroll(RefusingApi { }, "new", false);
    std::test::assert(
        !refused.ok && std::str::contains(refused.why, "401"),
        "an api that refuses says so: " + refused.why,
    );

    std::test::assert_eq_str(
        node::capabilities_problem(node::node_capabilities(false, -1, "")),
        "",
        "the managed engine alone",
    );
    let both = node::node_capabilities(true, -1, "");
    std::test::assert(
        node::capabilities_problem(both) == "" && std::str::contains(both, "\"claude-cli\""),
        "and the claude CLI when the machine holds its login",
    );
    let shared = node::node_capabilities(false, 120000000000, "");
    std::test::assert(
        node::capabilities_problem(shared) == "" && node::held_back(shared) == 120000000000,
        "the memory left for models, where some of the machine is another's: " + shared,
    );
    std::test::assert(
        !std::str::contains(both, "hardware"),
        "and none said when it is all the node's",
    );
    // the links its operator declared are the machine's: written again as
    // they were, and an unusable list is not carried over
    let declared = "{\"max_in_flight\": 4, \"engines\": [], \"links\": [{\"peer\": \"flare\", \"ports\": [{\"ifname\": \"enp1s0f0np0\", \"address\": \"192.168.100.1\", \"hca\": \"rocep1s0f0\"}], \"gid_index\": 3}]}";
    let kept = node::node_capabilities(false, -1, node::kept_links(declared));
    std::test::assert(
        node::capabilities_problem(kept) == ""
            && std::str::contains(kept, "\"links\": [{\"peer\": \"flare\""),
        "an install keeps the links the file declares: " + kept,
    );
    std::test::assert_eq_str(
        node::kept_links("{\"links\": [{\"peer\": \"Flare\"}]}"),
        "",
        "and drops a list the node would refuse",
    );
    std::test::assert_eq_str(node::kept_links(""), "", "and keeps nothing from no file");

    std::test::assert(node::on_loopback("http://127.0.0.1:8080"), "127.0.0.1 is this machine");
    std::test::assert(node::on_loopback("http://localhost:8080/"), "and localhost");
    std::test::assert(node::on_loopback("http://[::1]:8080"), "and ::1");
    std::test::assert(!node::on_loopback("http://10.73.20.5:8080"), "another address is not");
    std::test::assert(
        !node::on_loopback("http://localhost.example.net:8080"),
        "nor a name that starts so",
    );
    let total = 137438953472;
    std::test::assert_eq_int(
        node::memory_left(total, "http://127.0.0.1:8080", false, 0, false),
        total - 8589934592,
        "outside a habitat, the coordinator on this machine is held back",
    );
    std::test::assert_eq_int(
        node::memory_left(total, "http://10.73.20.5:8080", false, 0, false),
            -1,
        "and nothing when it runs elsewhere",
    );
    std::test::assert_eq_int(
        node::memory_left(total, "http://127.0.0.1:8080", true, 4000000000, true),
        total - 4000000000,
        "in a habitat, what it said its own services take here",
    );
    std::test::assert_eq_int(
        node::memory_left(total, "http://127.0.0.1:8080", true, 0, true),
            -1,
        "all of it where the habitat runs nothing",
    );
    std::test::assert_eq_int(
        node::memory_left(4000000000, "http://10.73.20.5:8080", true, 8000000000, true),
        0,
        "none when it takes more than there is",
    );
    std::test::assert_eq_int(
        node::memory_left(total, "http://lin1.lab.dark.coffee:8080", false, 0, true),
        total - 8589934592,
        "a habitat that does not say what it takes is held to the coordinator's 8 GiB",
    );

    let s = node::Service {
        name: "voice-node-spark",
        user: "riley",
        home: "/home/riley",
        node_bin: "/home/riley/.voice/bin/voice-node",
        id: "spark",
        api: "http://10.73.20.5:8080",
        token_vault: "node-spark-enrollment",
        data: "/home/riley/.voice/node-data",
        capabilities: "/home/riley/.voice/node-data/capabilities.json",
        port: 8081,
        vault_dir: "/home/riley/.voice/vault",
        path: "/usr/bin:/bin",
        log: "/home/riley/.voice/node-spark.log",
    };
    let plist = node::launchd_daemon_plist(s);
    std::test::assert(
        std::str::contains(plist, "<key>UserName</key><string>riley</string>")
            && std::str::contains(plist, "<string>--token-vault</string>")
            && std::str::contains(plist, "<string>node-spark-enrollment</string>")
            && std::str::contains(plist, "<key>KeepAlive</key><true/>")
            && std::str::contains(plist, "<key>LOTUS_DRAIN_GRACE_MS</key><string>15000</string>")
            && std::str::contains(plist, "<key>ExitTimeOut</key><integer>20</integer>"),
        "the LaunchDaemon runs the node as its account, kept running",
    );
    let unit = node::systemd_unit(s);
    std::test::assert(
        std::str::contains(unit, "User=riley\n")
            && std::str::contains(
                unit,
                "ExecStart=\"/home/riley/.voice/bin/voice-node\" \"--id\" \"spark\"",
            )
            && std::str::contains(unit, "Restart=always")
            && std::str::contains(unit, "After=network-online.target docker.service"),
        "the systemd unit runs it as its account, after docker, restarted: " + unit,
    );
    std::test::assert(
        !std::str::contains(unit, "\nExecStop=\"")
            && std::str::contains(
                unit,
                "voice-node\" \"stop-seats\" \"--id\" \"spark\" \"--data\" ",
            )
            && std::str::contains(unit, "\nExecStopPost=\"")
            && std::str::contains(unit, "KillMode=mixed\n")
            && std::str::contains(unit, "LOTUS_DRAIN_GRACE_MS=15000")
            && std::str::contains(unit, "TimeoutStopSec=20\n"),
        "stopping, the node alone is signalled and drains, its servers stopped by its drain, then what is left of its stopped, what is left of its group killed after 20 s: "
            + unit,
    );
    std::test::assert_eq_str(
        node::unit_value("50% \"x\""),
        "\"50%% \\\"x\\\"\"",
        "a unit's value is quoted and escaped",
    );

    std::test::assert_eq_str(
        node::home_in_dscl("NFSHomeDirectory: /Users/riley\n"),
        "/Users/riley",
        "a Mac's home",
    );
    std::test::assert_eq_str(
        node::home_in_passwd("riley:x:1000:1000:Riley,,,:/home/riley:/bin/bash\n"),
        "/home/riley",
        "a Linux home",
    );
    std::test::assert_eq_str(node::home_in_passwd(""), "", "no account, no home");
}

/// The Claude accounts' tokens the habitat hands over are kept in the
/// node's vault under their labels, and one no longer handed over goes.
fn claude_tokens_kept() {
    let root = "/tmp/voice-install-test-" + to_string(std::time::monotonic_ns());
    let handed = root + "/handed";
    let vault = root + "/vault";
    node::run_out("mkdir\n-p\n" + handed + "\n" + vault);
    std::io::fs::write_file(handed + "/secret-dna_ab12-claude-token--work", "tok-work") or discard;
    std::io::fs::write_file(
        handed + "/secret-dna_ab12-claude-token--personal-1",
        "tok-p1",
    ) or discard;
    std::io::fs::write_file(vault + "/claude-token--gone", "tok-gone") or discard;
    std::io::fs::write_file(vault + "/node-x-enrollment", "vn-x") or discard;
    node::keep_handed_tokens(
        handed,
        "secret-dna_ab12-claude-token--personal-1\nsecret-dna_ab12-claude-token--work\n",
        vault,
    );
    std::test::assert(
        node::claude_labels(vault) == "personal-1\nwork\n",
        "the handed accounts are kept, by label",
    );
    std::test::assert(
        (std::io::fs::read_file(vault + "/claude-token--work") or "") == "tok-work",
        "a token is kept as handed",
    );
    std::test::assert(
        !std::io::fs::file_exists(vault + "/claude-token--gone"),
        "an account no longer handed over goes",
    );
    std::test::assert(
        std::io::fs::file_exists(vault + "/node-x-enrollment"),
        "the vault's other entries stay",
    );
    std::test::assert(
        std::str::starts_with(
            node::run_out("ls\n-l\n" + vault + "/claude-token--work"),
            "-rw-------",
        ),
        "a kept token is private",
    );
    node::run_out("rm\n-rf\n" + root);
}

/// The claude CLI is looked for where the node's account installs it, in
/// order, and the service's PATH reaches the one found first.
fn claude_found() {
    let root = "/tmp/voice-install-claude-" + to_string(std::time::monotonic_ns());
    let home = root + "/home";
    let sys = root + "/sys";
    let login = root + "/login";
    node::run_out(
        "mkdir\n-p\n" + home + "/.local/bin\n" + home + "/.claude/local\n" + sys + "\n" + login,
    );
    let empty = sys + ":" + root + "/none";
    std::test::assert_eq_str(
        node::find_claude("", home, empty),
        "",
        "no claude anywhere, none found",
    );
    std::io::fs::write_file(sys + "/claude", "#!/bin/sh\n") or discard;
    std::test::assert_eq_str(
        node::find_claude("", home, empty),
        "",
        "a file it cannot run is not the CLI",
    );
    node::run_out("chmod\n755\n" + sys + "/claude");
    std::test::assert_eq_str(
        node::find_claude("", home, empty),
        sys + "/claude",
        "the system's directories, last",
    );
    std::io::fs::write_file(home + "/.claude/local/claude", "#!/bin/sh\n") or discard;
    node::run_out("chmod\n755\n" + home + "/.claude/local/claude");
    std::test::assert_eq_str(
        node::find_claude("", home, empty),
        home + "/.claude/local/claude",
        "an older install's ~/.claude/local before them",
    );
    std::io::fs::write_file(home + "/.local/bin/claude", "#!/bin/sh\n") or discard;
    node::run_out("chmod\n755\n" + home + "/.local/bin/claude");
    std::test::assert_eq_str(
        node::find_claude("", home, empty),
        home + "/.local/bin/claude",
        "the native installer's ~/.local/bin before that",
    );
    std::io::fs::write_file(login + "/claude", "#!/bin/sh\n") or discard;
    node::run_out("chmod\n755\n" + login + "/claude");
    std::test::assert_eq_str(
        node::find_claude("welcome back\n" + login + "/claude\n", home, empty),
        login + "/claude",
        "what the account's login shell finds, first, past what its profile printed",
    );
    std::test::assert_eq_str(
        node::find_claude("claude: aliased\n", home, empty),
        home + "/.local/bin/claude",
        "a login shell's answer that is no program is passed over",
    );
    std::test::assert_eq_str(
        node::find_claude(root + "/gone/claude", home, empty),
        home + "/.local/bin/claude",
        "and one that is not there",
    );

    let vault = root + "/vault";
    node::run_out("mkdir\n-p\n" + vault);
    let cli = home + "/.local/bin/claude";
    std::test::assert(!node::offers_claude(vault, cli), "the CLI without a token offers no engine");
    std::io::fs::write_file(vault + "/claude-token--work", "tok") or discard;
    std::test::assert(!node::offers_claude(vault, ""), "nor a token without the CLI");
    std::test::assert(node::offers_claude(vault, cli), "both, the claude-cli engine");

    let system = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin";
    std::test::assert_eq_str(
        node::service_path("", system),
        system,
        "no claude, the system's PATH",
    );
    std::test::assert_eq_str(
        node::service_path("/Users/op/.local/bin/claude", system),
        "/Users/op/.local/bin:" + system,
        "the claude CLI's directory first",
    );
    std::test::assert_eq_str(
        node::service_path("/usr/local/bin/claude", system),
        "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin",
        "ahead of a system directory with another claude",
    );

    let s = node::Service {
        name: "voice-node-mac",
        user: "op",
        home: "/Users/op",
        node_bin: "/Users/op/.voice/bin/voice-node",
        id: "mac",
        api: "http://10.73.20.5:8080",
        token_vault: "node-mac-enrollment",
        data: "/Users/op/.voice/node-data",
        capabilities: "/Users/op/.voice/node-data/capabilities.json",
        vault_dir: "/Users/op/.voice/vault",
        path: node::service_path("/Users/op/.local/bin/claude", system),
        log: "/Users/op/.voice/node-mac.log",
    };
    std::test::assert(
        std::str::contains(
            node::launchd_daemon_plist(s),
            "<key>PATH</key><string>/Users/op/.local/bin:/opt/homebrew/bin:",
        ),
        "the LaunchDaemon runs the node with the claude CLI's directory first on PATH",
    );
    std::test::assert(
        std::str::contains(
            node::systemd_unit(s),
            "Environment=\"PATH=/Users/op/.local/bin:/opt/homebrew/bin:",
        ),
        "and so does the systemd unit",
    );
    node::run_out("rm\n-rf\n" + root);
}
