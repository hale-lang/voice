// The catalog: configured on the admin plane (`Catalog`), read by callers
// through their key (`Models`).
//
// A model lists the seats configured to serve it, and is available while
// one of them could take a request (inference.hl, `seat_ready`); the data
// classes a caller sees are those such seats carry.

locus Catalog {
    params {
        store: st::Store;
        // serializes the store's use across requests (store/lock.hl): the admin plane takes turns, a row at a time
        gate: st::Lock = st::Lock { };
        // the recipes a local model may name (recipes.hl), behind the same gate
        recipes: Recipes = Recipes { store: self.store, gate: self.gate };
    }

    /// `listCatalogModels`: every model not removed.
    fn list() -> CatalogList fallible(CtlError) {
        self.gate.enter();
        let gated = self.list_in_gate() or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `list`, inside the gate.
    fn list_in_gate() -> CatalogList fallible(CtlError) {
        let rows = self.store.models() or fail store_down(err);
        let mut out = CatalogList { };
        for r in rows.rows {
            if !r.removed {
                let v = self.view(r) or raise;
                push(out.data, v) or discard;
            }
        }
        return out;
    }

    /// `createCatalogModel`.
    fn create(m: CatalogModelCreate) -> CatalogModel fallible(CtlError) {
        self.gate.enter();
        let gated = self.create_in_gate(m) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `create`, inside the gate.
    fn create_in_gate(m: CatalogModelCreate) -> CatalogModel fallible(CtlError) {
        if len(m.id) == 0 || len(m.id) > 128 { fail bad("`id` is 1 to 128 characters", "id"); }
        check_model_fields(m.context_length, m.max_output_tokens) or raise;
        if m.has_recipe {
            if m.has_kind && m.kind == ModelKind::hosted {
                fail bad("a hosted model has no recipe", "recipe");
            }
            let known = self.recipes.known_in_gate(m.recipe) or raise;
            if !known {
                fail bad(
                    "no recipe " + m.recipe
                        + ": voice ships none, nor has the operator allowed one",
                    "recipe"
                );
            }
        }
        // a model made from a recipe is as long as its weights are made for,
        // unless the operator says otherwise
        let mut context = m.context_length;
        if m.has_recipe && context == 0 {
            let r = self.recipes.get_in_gate(m.recipe) or raise;
            context = r.context_length;
        }
        let row = st::ModelRow {
            id: m.id,
            owned_by: if len(m.owned_by) > 0 { m.owned_by } else { "local" },
            kind: if m.has_kind { model_kind_name(m.kind) } else { "local" },
            context_length: context,
            max_output_tokens: m.max_output_tokens,
            priced: m.has_price,
            price: m.price,
            recipe: if m.has_recipe { m.recipe } else { "" },
            created_at: now_seconds()
        };
        let v = self.view(row) or raise;
        let added = self.store.insert_model(
            row,
            checked_change("create", "models/" + m.id, "", catalog_model_json(v)) or raise,
        ) or fail store_down(err);
        if !added { fail clash("model " + m.id + " exists; a model id is never reused"); }
        return v;
    }

    /// `getCatalogModel`.
    fn get(r: ModelRef) -> CatalogModel fallible(CtlError) {
        self.gate.enter();
        let gated = self.get_in_gate(r) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `get`, inside the gate.
    fn get_in_gate(r: ModelRef) -> CatalogModel fallible(CtlError) {
        let row = self.live(r.model) or raise;
        return self.view(row) or raise;
    }

    /// `updateCatalogModel`: the fields the request sets.
    fn update(u: CatalogModelUpdate) -> CatalogModel fallible(CtlError) {
        self.gate.enter();
        let gated = self.update_in_gate(u) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `update`, inside the gate.
    fn update_in_gate(u: CatalogModelUpdate) -> CatalogModel fallible(CtlError) {
        if u.has_id { fail bad("a model's `id` cannot change", "id"); }
        if u.has_recipe { fail bad("a model's `recipe` cannot change", "recipe"); }
        self.store.hold("models/" + u.model) or fail store_down(err);
        let out = self.update_held(u) or {
            self.store.let_go();
            fail err;
        };
        self.store.let_go();
        return out;
    }

    /// `update`, holding the resource from its read to its write.
    fn update_held(u: CatalogModelUpdate) -> CatalogModel fallible(CtlError) {
        let mut row = self.live(u.model) or raise;
        let before = self.view(row) or raise;
        if u.has_owned_by { row.owned_by = u.owned_by; }
        if u.has_kind { row.kind = model_kind_name(u.kind); }
        if u.has_context_length { row.context_length = u.context_length; }
        if u.has_max_output_tokens { row.max_output_tokens = u.max_output_tokens; }
        if u.has_price || u.clear_price {
            row.priced = u.has_price;
            row.price = u.price;
        }
        check_model_fields(row.context_length, row.max_output_tokens) or raise;
        if len(row.recipe) > 0 && row.kind == "hosted" {
            fail bad("a model with a recipe is local", "kind");
        }
        let after = self.view(row) or raise;
        self.store.update_model(
            row,
            checked_change(
                "update",
                "models/" + row.id,
                catalog_model_json(before),
                catalog_model_json(after),
            ) or raise,
        ) or fail store_down(err);
        return after;
    }

    /// `removeCatalogModel`: callers naming it get `model_not_found`; the
    /// id stays taken.
    fn remove(r: ModelRef) -> CatalogModel fallible(CtlError) {
        self.gate.enter();
        let gated = self.remove_in_gate(r) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `remove`, inside the gate.
    fn remove_in_gate(r: ModelRef) -> CatalogModel fallible(CtlError) {
        self.store.hold("models/" + r.model) or fail store_down(err);
        let out = self.remove_held(r) or {
            self.store.let_go();
            fail err;
        };
        self.store.let_go();
        return out;
    }

    /// `remove`, holding the resource from its read to its write.
    fn remove_held(r: ModelRef) -> CatalogModel fallible(CtlError) {
        let mut row = self.live(r.model) or raise;
        let placed = self.store.placements() or fail store_down(err);
        for p in placed.rows {
            if !p.removed && p.model == row.id {
                fail clash("placement " + p.id + " places model " + row.id + "; withdraw it first");
            }
        }
        let before = self.view(row) or raise;
        row.removed = true;
        row.removed_at = now_seconds();
        self.store.update_model(
            row,
            checked_change("delete", "models/" + row.id, catalog_model_json(before), "") or raise,
        ) or fail store_down(err);
        return before;
    }

    /// The model `id`, unless it is absent or removed.
    fn live(id: String) -> st::ModelRow fallible(CtlError) {
        let row = self.store.model(id) or fail store_down(err);
        if !row.present || row.removed { fail missing("no model " + id + " in the catalog"); }
        return row;
    }

    /// The row with the seats that serve it.
    fn view(r: st::ModelRow) -> CatalogModel fallible(CtlError) {
        let seats = self.store.seats() or fail store_down(err);
        let mut v = catalog_view(r);
        let a = availability(self.store, r.id) or fail store_down(err);
        v.available = a.available;
        v.has_served_context_length = a.context > 0;
        v.served_context_length = a.context;
        for s in seats.rows {
            if seat_serves(s, r.id) { push(v.seats, s.ref) or discard; }
        }
        return v;
    }
}

/// The catalog as the key a caller presented sees it: the models its
/// project and the key itself are not restricted from.
locus Models {
    params { store: st::Store; }

    /// `listModels`.
    fn list(ctx: std::api::Context) -> ModelList fallible(ApiError) {
        let k = self.caller_key(ctx) or raise;
        let p = as_in_force(
            self.store,
            self.store.project(k.project) or fail metering_failed(err),
        ) or fail metering_failed(err);
        let rows = self.store.models() or fail metering_failed(err);
        let mut out = ModelList { };
        for r in rows.rows {
            if !r.removed && visible(p, k, r.id) {
                let v = model_for(self.store, r, spends_of(p, k)) or fail metering_failed(err);
                push(out.data, v) or discard;
            }
        }
        // the names the project gives models (aliases.hl), each as the model
        // it is now, by the name a caller asks for
        let named = resolved_aliases(self.store, p) or fail metering_failed(err);
        for a in named.items {
            let row = self.store.model(a.model) or fail metering_failed(err);
            if row.present && !row.removed && visible(p, k, row.id) {
                let mut v = model_for(
                    self.store,
                    row,
                    spends_of(p, k),
                ) or fail metering_failed(err);
                v.id = a.name;
                push(out.data, v) or discard;
            }
        }
        return out;
    }

    /// `getModel`. A model the key cannot see is answered as one that
    /// does not exist.
    fn get(r: ModelRef, ctx: std::api::Context) -> Model fallible(ApiError) {
        let k = self.caller_key(ctx) or raise;
        let p = as_in_force(
            self.store,
            self.store.project(k.project) or fail metering_failed(err),
        ) or fail metering_failed(err);
        // a name the project gives a model (aliases.hl) is that model, by it
        let target = alias_target(self.store, p, r.model) or fail metering_failed(err);
        let id = if len(target) > 0 { target } else { r.model };
        let row = self.store.model(id) or fail metering_failed(err);
        if !row.present || row.removed || !visible(p, k, id) {
            fail ApiError {
                status: 404,
                kind: "not_found",
                code: ErrorCode::model_not_found,
                message: "no model " + r.model,
                has_param: true,
                param: "model",
            };
        }
        let mut v = model_for(self.store, row, spends_of(p, k)) or fail metering_failed(err);
        v.id = r.model;
        return v;
    }

    /// `getCapabilities`: the project and key, the models the key may
    /// name, the accounts it may spend, every limit that applies to it at
    /// any scope, and the project's budget.
    fn capabilities(ctx: std::api::Context) -> Capabilities fallible(ApiError) {
        let k = self.caller_key(ctx) or raise;
        let p = as_in_force(
            self.store,
            self.store.project(k.project) or fail metering_failed(err),
        ) or fail metering_failed(err);
        let rows = self.store.models() or fail metering_failed(err);
        let mut out = Capabilities {
            project_id: p.id,
            project_name: p.name,
            key_id: k.id,
            key_name: k.name,
            has_budget: p.budgeted,
            budget: budget_view(p.budget, now_seconds())
        };
        let spends = spends_of(p, k);
        out.has_accounts = !spends.any;
        out.accounts = spends.names.items;
        out.data_classes = p.data_classes.items;
        for r in rows.rows {
            if !r.removed && visible(p, k, r.id) { push(out.models, r.id) or discard; }
        }
        for l in p.limits.items {
            push(out.limits, l) or discard;
        }
        for l in k.limits.items {
            push(out.limits, l) or discard;
        }
        let accounts = self.store.accounts() or fail metering_failed(err);
        for a in accounts.rows {
            if !a.archived && allows(spends, a.id) {
                for l in a.limits.items {
                    push(out.limits, l) or discard;
                }
            }
        }
        return out;
    }

    /// The key the caller is, as the bearer source named it.
    fn caller_key(ctx: std::api::Context) -> st::KeyRow fallible(ApiError) {
        let k = self.store.key(ctx.caller.name) or fail metering_failed(err);
        if !k.present { fail invalid_key(); }
        return k;
    }
}

/// The accounts a key may spend: those both it and its project allow (as
/// serving holds them, inference.hl), its project's as in force, the
/// habitat's grant for an inheriting tenant.
fn spends_of(p: st::ProjectRow, k: st::KeyRow) -> st::Restriction {
    if k.accounts.any { return p.accounts; }
    if p.accounts.any { return k.accounts; }
    let mut both = st::Restriction { any: false };
    for n in k.accounts.names.items {
        if allows(p.accounts, n) { push(both.names.items, n) or discard; }
    }
    return both;
}

/// True when the project and the key both let `model` through.
fn visible(p: st::ProjectRow, k: st::KeyRow, model: String) -> Bool {
    return allows(p.models, model) && allows(k.models, model);
}

/// True when `r` is no restriction or names `name`.
fn allows(r: st::Restriction, name: String) -> Bool {
    return r.any || has_name(r.names.items, name);
}

fn has_name(ns: bounded[String; 32], name: String) -> Bool {
    for n in ns {
        if n == name { return true; }
    }
    return false;
}

fn check_model_fields(context_length: Int, max_output_tokens: Int) -> Bool fallible(CtlError) {
    if context_length < 0 { fail bad("`context_length` is at least 1", "context_length"); }
    if max_output_tokens < 0 {
        fail bad("`max_output_tokens` is at least 1", "max_output_tokens");
    }
    return true;
}

/// The row alone; `Catalog.view` adds its seats.
fn catalog_view(r: st::ModelRow) -> CatalogModel {
    return CatalogModel {
        id: r.id,
        owned_by: r.owned_by,
        kind: model_kind_of(r.kind),
        has_context_length: r.context_length > 0,
        context_length: r.context_length,
        has_max_output_tokens: r.max_output_tokens > 0,
        max_output_tokens: r.max_output_tokens,
        has_price: r.priced,
        price: r.price,
        has_recipe: len(r.recipe) > 0,
        recipe: r.recipe,
        available: false,
        created_at: r.created_at
    };
}

fn model_view(r: st::ModelRow) -> Model {
    return Model {
        id: r.id,
        created: std::time::unix(r.created_at),
        owned_by: r.owned_by,
        kind: r.kind,
        context_length: r.context_length,
        max_output_tokens: r.max_output_tokens,
        has_price: r.priced,
        price: r.price,
        available: false
    };
}

// ---- errors ----------------------------------------------------------

fn invalid(message: String, param: String) -> ApiError {
    return ApiError {
        status: 400,
        kind: "invalid_request",
        code: ErrorCode::invalid_request,
        message: message,
        has_param: len(param) > 0,
        param: param,
    };
}

fn unsupported(message: String, param: String) -> ApiError {
    return ApiError {
        status: 400,
        kind: "invalid_request",
        code: ErrorCode::unsupported,
        message: message,
        has_param: len(param) > 0,
        param: param,
    };
}

fn not_found(message: String) -> ApiError {
    return ApiError {
        status: 404,
        kind: "not_found",
        code: ErrorCode::not_found,
        message: message,
    };
}

fn conflict(message: String) -> ApiError {
    return ApiError {
        status: 409,
        kind: "invalid_request",
        code: ErrorCode::conflict,
        message: message,
    };
}

fn invalid_key() -> ApiError {
    return ApiError {
        status: 401,
        kind: "authentication_error",
        code: ErrorCode::invalid_key,
        message: "a valid project key is required: Authorization: Bearer vk-...",
    };
}

/// A store that could not answer an admin request. A full list is the
/// caller's to fix; a store that is down is a failure inside the api.
fn store_failed(e: st::StoreError) -> ApiError {
    if e.kind == "full" { return invalid(e.message, ""); }
    let id = store_incident(e);
    return ApiError {
        status: 500,
        kind: "server_error",
        code: ErrorCode::internal_error,
        message: "the store could not complete the request (" + id + ")",
        has_voice: true,
        voice: ErrorVoice { request_id: id },
    };
}

/// The caller plane's store failure: nothing is served while the store
/// cannot record usage.
fn metering_failed(e: st::StoreError) -> ApiError {
    let id = store_incident(e);
    return ApiError {
        status: 503,
        kind: "server_error",
        code: ErrorCode::metering_unavailable,
        message: "the store is unavailable; nothing is served until it is back (" + id + ")",
        has_voice: true,
        voice: ErrorVoice { request_id: id },
    };
}

/// A store failure, on the api's stderr with an id the answer quotes. What
/// the store said (Postgres's own text, which can name constraints and
/// the values they refused) stays here and never reaches a response.
fn store_incident(e: st::StoreError) -> String {
    let id = "err_" + (random_hex(8) or "0");
    log_error(
        "store failure",
        fields2(
            std::log::kv("incident", id),
            fields2(std::log::kv("kind", e.kind), std::log::kv("detail", e.message)),
        ),
    );
    return id;
}

/// Now, to the second: what every timestamp voice writes is.
fn now_seconds() -> Time {
    return std::time::time_from_unix(std::time::unix(std::time::current()));
}

// ---- capabilities ------------------------------------------------------

/// Model ids, as many as the catalog holds (`ModelRows`).
type ModelIds { items: bounded[String; 256]; }

/// Limits at every scope that applies to one key: the project's (16), the
/// key's (16) and each of at most 64 accounts' (16 each), so the bound
/// holds them all and nothing is dropped.
type AppliedLimits { items: bounded[st::Limit; 1056]; }

/// `Capabilities`. `budget` is `null` for a project with none.
type Capabilities {
    project_id: String = "";
    project_name: String = "";
    key_id: String = "";
    key_name: String = "";
    data_classes: bounded[String; 32];
    models: bounded[String; 256];
    has_accounts: Bool = false;
    accounts: bounded[String; 32];
    limits: bounded[st::Limit; 1056];
    has_budget: Bool = false;
    budget: Budget = Budget { };
}

fn capabilities_json(c: Capabilities) -> String {
    let models_list = st::JsonList { };
    for m in c.models {
        models_list.add(jq(m));
    }
    let models = models_list.text();
    let limits_list = st::JsonList { };
    for l in c.limits {
        limits_list.add(limit_json(l));
    }
    let limits = limits_list.text();
    return "{\"project\": {\"id\": " + jq(c.project_id) + ", \"name\": " + jq(c.project_name)
        + "}, \"key\": {\"id\": " + jq(c.key_id) + ", \"name\": " + jq(c.key_name) + "}"
        + ", \"data_classes\": " + st::jnames(c.data_classes) + ", \"models\": [" + models
        + "], \"accounts\": " + jnames_or_null(c.has_accounts, c.accounts)
        + ", \"limits\": [" + limits + "], \"budget\": "
        + (if c.has_budget { budget_json(c.budget) } else { "null" }) + "}";
}

/// Whether a model can be served now, and the data classes the seats that
/// could serve it carry.
type Availability {
    available: Bool = false;
    tools: Bool = false;
    // the least context, in tokens, a seat that could serve it took; 0 when
    // none has said
    context: Int = 0;
    data_classes: bounded[String; 32];
}

/// A seat could serve `model` when it is enabled, spends an account that
/// is not archived, and its node is up, not draining, has applied its
/// assignment, reports it `up` and holds it by no local control.
fn availability(store: st::Store, model: String) -> Availability fallible(st::StoreError) {
    return availability_for(store, model, st::Restriction { }) or raise;
}

/// `availability`, counting only seats that spend an account in `spends`:
/// what a caller whose key may spend those could be served by. With it,
/// whether one of them carries a request's `tools` through to its model.
@unbounded
fn availability_for(
    store: st::Store,
    model: String,
    spends: st::Restriction
) -> Availability fallible(st::StoreError) {
    let seats = store.seats() or raise;
    let mut out = Availability { };
    for s in seats.rows {
        if seat_serves(s, model) && s.enabled && allows(spends, s.account) {
            let ready = seat_ready(store, s) or raise;
            if ready {
                out.available = true;
                let c = seat_context(store, s) or raise;
                if c > 0 && (out.context == 0 || c < out.context) { out.context = c; }
                if !out.tools {
                    out.tools = seat_tools(store, s) or raise;
                }
                for dc in s.data_classes.items {
                    if !has_name(out.data_classes, dc) { push(out.data_classes, dc) or discard; }
                }
            }
        }
    }
    return out;
}

/// The context, in tokens, seat `s`'s server took, as its node last
/// reported; 0 when it has not said.
fn seat_context(store: st::Store, s: st::SeatRow) -> Int fallible(st::StoreError) {
    let states = store.seat_states(s.node) or raise;
    for st in states.rows {
        if st.seat == s.id { return st.context; }
    }
    return 0;
}

fn model_with_seats(store: st::Store, r: st::ModelRow) -> Model fallible(st::StoreError) {
    return model_for(store, r, st::Restriction { }) or raise;
}

/// The model as a caller that may spend `spends` sees it: available when a
/// seat it may spend serves it, with tools when one of those carries them.
fn model_for(
    store: st::Store,
    r: st::ModelRow,
    spends: st::Restriction
) -> Model fallible(st::StoreError) {
    let mut v = model_view(r);
    let a = availability_for(store, r.id, spends) or raise;
    v.available = a.available;
    v.tools = a.tools;
    // what a caller can count on: the least any seat that could serve it
    // took, never more than the model is made for
    if a.context > 0 && (v.context_length == 0 || a.context < v.context_length) {
        v.context_length = a.context;
    }
    v.data_classes = a.data_classes;
    return v;
}

/// True when seat `s` carries a request's `tools` through to its model and
/// back as tool calls: an openai-compatible engine passes them to its
/// upstream; a managed seat under llama-server applies the model's own chat
/// template, which knows its tools (b11913 uses Jinja by default), and one
/// under vLLM does not until voice starts it with a tool-call parser; the
/// static engine when its drill makes a call; the claude CLI answers text.
fn seat_tools(store: st::Store, s: st::SeatRow) -> Bool fallible(st::StoreError) {
    let f = store.fleet(s.node) or raise;
    let kind = engine_kind_of(f.capabilities, s.engine);
    if kind == "openai-compatible" { return true; }
    if kind == "managed" {
        let rt = std::json::find_field_raw(s.config, "runtime");
        return std::json::find_string_field(rt, "server") == "llama-server";
    }
    if kind == "static" {
        return std::str::starts_with(
            std::str::trim(std::json::find_field_raw(s.config, "tool_call")),
            "{",
        );
    }
    return false;
}

/// The kind of the engine `engine` in a node's declared capabilities, ""
/// when it declares none by that id.
@bounded_by(capabilities)
fn engine_kind_of(capabilities: String, engine: String) -> String {
    let mut it = std::json::array_first(std::json::find_field_raw(capabilities, "engines"));
    while !it.done {
        if std::json::find_string_field(it.element, "id") == engine {
            return std::json::find_string_field(it.element, "kind");
        }
        it = std::json::array_next(it);
    }
    return "";
}
