// `node install` and `node uninstall`: a machine joins as a voice node, a
// system service on macOS and Linux alike (service.hl,
// docs/adding-a-node.md). The habitat runs them on a host it manages
// (hale.toml `[dna.host.node]`); an operator can run them by hand.
//
// `install` adds a node and nothing else: it records the node on the api
// (the operator token, from a file, is used for that alone), keeps its
// enrollment token in the node's vault, writes the capabilities voice
// decides (the managed engine, which runs the models placed on the node,
// and the claude CLI when the machine holds its login), copies the node
// program where the service runs it, and installs and starts the service
// as the account that ran it with sudo. Models come to the node through
// placements, never through its install. It prints no secret, and running
// it again changes nothing that is already right.
//
// This file is the commands' own output: what they print is their product,
// so it is the one place in the node that writes to stdout outside the
// logger.

/// The admin calls over HTTP, to the api at `api`.
locus HttpAdmin {
    params {
        api: String = "";
        key: String = "";
    }
    @unbounded
    fn send(method: String, path: String, body: String) -> Reply {
        let url = std::http::parse_url(self.api + path) or std::http::Url { };
        if len(url.host) == 0 { return Reply { status: 0, body: "bad api address: " + self.api }; }
        let auth = if len(self.key) > 0 {
            "Authorization: Bearer " + self.key + "\r\n"
        } else {
            ""
        };
        let r = std::http::request(
            std::http::ClientRequest {
                method: method,
                url: url,
                headers: auth + "Content-Type: application/json",
                body: std::bytes::from_string(body),
            },
        ) or std::http::ClientResponse { status: 0, body: b"" };
        return Reply { status: r.status, body: std::str::from_bytes(r.body) };
    }
}

type Reply { status: Int = 0; body: String = ""; }

/// The admin calls an install makes: bound to HTTP, or a test's stand-in.
interface AdminCalls {
    fn send(method: String, path: String, body: String) -> Reply;
}

/// What enrolling did: the node's enrollment token, "" when the node
/// already holds one.
type Enrolled { ok: Bool = false; why: String = ""; token: String = ""; }

/// Record the node on the api, or find it there: a new node's enrollment
/// token, a fresh one when the node has none of its own (`token_known`
/// false), or none when it holds one.
@unbounded
fn enroll(admin: AdminCalls, node: String, token_known: Bool) -> Enrolled {
    let n = admin.send("POST", "/admin/v1/nodes", "{\"id\": " + quote(node) + "}");
    if n.status == 201 {
        return Enrolled {
            ok: true,
            token: std::json::find_string_field(n.body, "enrollment_token"),
        };
    }
    if n.status != 409 { return Enrolled { why: "the node was not recorded: " + reason_of(n) }; }
    if token_known { return Enrolled { ok: true }; }
    let t = admin.send("POST", "/admin/v1/nodes/" + node + "/token", "");
    if t.status != 200 {
        return Enrolled { why: "the node's token was not renewed: " + reason_of(t) };
    }
    return Enrolled { ok: true, token: std::json::find_string_field(t.body, "enrollment_token") };
}

fn reason_of(r: Reply) -> String {
    if r.status == 0 { return r.body; }
    return to_string(r.status) + " " + r.body;
}

@unbounded
fn quote(s: String) -> String { return "\"" + std::json::escape_string(s) + "\""; }

/// The capabilities voice decides for a node: the managed engine, and the
/// claude CLI when the machine holds its login.
@unbounded
fn node_capabilities(claude: Bool) -> String {
    return "{\"max_in_flight\": 4, \"engines\": [{\"id\": \"managed\", \"kind\": \"managed\"}"
        + (if claude { ", {\"id\": \"claude\", \"kind\": \"claude-cli\"}" } else { "" }) + "]}";
}

const SERVICE_PREFIX: String = "net.hale-lang.voice-node.";

const INSTALL_USAGE: String = "usage: sudo node install --id ID --api URL --operator-token-file FILE [--port N] [--no-start]\n       sudo node uninstall --id ID [--operator-token-file FILE] [--purge]";

/// `node install`.
@unbounded
fn install() {
    let id = option("--id", "");
    let api = option("--api", "");
    let token_file = option("--operator-token-file", "");
    if !is_slug(id) || len(api) == 0 || len(token_file) == 0 {
        log_error(INSTALL_USAGE, "");
        std::process::exit(2);
    }
    let a = installing_account();
    let mac = os_of(run_out("uname\n-s")) == "darwin";
    let voice = a.home + "/.voice";
    let data = voice + "/node-data";
    let vault = voice + "/vault";
    let enrollment = "node-" + id + "-enrollment";
    let path = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin";

    let key = std::str::trim(std::io::fs::read_file(token_file) or "");
    if len(key) == 0 { fail_install("no operator token in " + token_file); }
    run_out("mkdir\n-p\n" + data);
    run_out("mkdir\n-p\n-m\n700\n" + vault);
    run_out("mkdir\n-p\n" + voice + "/bin");

    let e = enroll(
        HttpAdmin { api: api, key: key },
        id,
        std::io::fs::file_exists(vault + "/" + enrollment),
    );
    if !e.ok { fail_install(e.why); }
    if len(e.token) > 0 {
        std::io::fs::write_file(vault + "/" + enrollment, e.token) or fail_install(
            "the enrollment token could not be kept",
        );
    }
    run_out("chmod\n600\n" + vault + "/" + enrollment);

    let claude = std::io::fs::file_exists(vault + "/claude-" + id + "-token")
        && len(std::str::trim(run_out("sh\n-c\nPATH=\"$0\" command -v claude\n" + path))) > 0;
    std::io::fs::write_file(data + "/capabilities.json", node_capabilities(claude)) or fail_install(
        "the capabilities file could not be written",
    );

    // the node program where the service runs it, so it does not hang on
    // a build cache or a checkout
    let node_bin = voice + "/bin/voice-node";
    run_out("cp\n-f\n" + std::env::arg(0) + "\n" + node_bin + ".new");
    run_out("chmod\n755\n" + node_bin + ".new");
    std::io::fs::rename(node_bin + ".new", node_bin) or fail_install(
        "the node program could not be put at " + node_bin,
    );
    run_out("chown\n-R\n" + a.user + "\n" + voice);

    let s = Service {
        name: SERVICE_PREFIX + id,
        user: a.user,
        home: a.home,
        node_bin: node_bin,
        id: id,
        api: api,
        token_vault: enrollment,
        data: data,
        capabilities: data + "/capabilities.json",
        port: std::str::parse_int(option("--port", "8081")) or 8081,
        vault_dir: vault,
        path: path,
        log: voice + "/node-" + id + ".log"
    };
    let start = !flag_given("--no-start");
    if mac {
        std::io::fs::write_file(daemon_plist_path(s.name), launchd_daemon_plist(s)) or fail_install(
            "the LaunchDaemon's plist could not be written: run it with sudo",
        );
        if start {
            run_out("launchctl\nbootout\nsystem/" + s.name);
            let o = std::process::run("launchctl\nbootstrap\nsystem\n" + daemon_plist_path(s.name))
            or std::process::ProcessOutput {
                code: 1,
                signal: 0,
                stdout: "",
                stderr: "launchctl did not run",
            };
            if o.code != 0 {
                fail_install("launchctl could not start the node: " + std::str::trim(o.stderr));
            }
        }
        println(
            "node " + id + " installed: LaunchDaemon " + s.name + ", as " + a.user + ", log "
                + s.log,
        );
    } else {
        std::io::fs::write_file(unit_path("voice-node-" + id), systemd_unit(s)) or fail_install(
            "the systemd unit could not be written: run it with sudo",
        );
        // container runtimes run under docker, as the node's account
        if len(run_out("getent\ngroup\ndocker")) > 0 {
            run_out("usermod\n-aG\ndocker\n" + a.user);
        } else {
            println(
                "note: docker is not installed; a model whose runtime is a container (vLLM, llama.cpp on CUDA) needs it",
            );
        }
        if start {
            run_out("systemctl\ndaemon-reload");
            let o = std::process::run("systemctl\nenable\n--now\nvoice-node-" + id)
            or std::process::ProcessOutput {
                code: 1,
                signal: 0,
                stdout: "",
                stderr: "systemctl did not run",
            };
            if o.code != 0 {
                fail_install("systemd could not start the node: " + std::str::trim(o.stderr));
            }
        }
        println(
            "node " + id + " installed: systemd unit voice-node-" + id + ", as " + a.user
                + ", log journalctl -u voice-node-" + id,
        );
    }
}

/// `node uninstall`: the service stopped and removed; with the operator
/// token, the node revoked on the api; with `--purge`, its data and vault
/// entry removed too.
@unbounded
fn uninstall() {
    let id = option("--id", "");
    if !is_slug(id) {
        log_error(INSTALL_USAGE, "");
        std::process::exit(2);
    }
    let a = installing_account();
    let name = SERVICE_PREFIX + id;
    if os_of(run_out("uname\n-s")) == "darwin" {
        run_out("launchctl\nbootout\nsystem/" + name);
        run_out("rm\n-f\n" + daemon_plist_path(name));
    } else {
        run_out("systemctl\ndisable\n--now\nvoice-node-" + id);
        run_out("rm\n-f\n" + unit_path("voice-node-" + id));
        run_out("systemctl\ndaemon-reload");
    }
    let token_file = option("--operator-token-file", "");
    let api = option("--api", "");
    if len(token_file) > 0 && len(api) > 0 {
        let key = std::str::trim(std::io::fs::read_file(token_file) or "");
        let r = HttpAdmin { api: api, key: key }.send("DELETE", "/admin/v1/nodes/" + id, "");
        if r.status != 200 && r.status != 404 {
            fail_install("the node was not revoked: " + reason_of(r));
        }
    }
    if flag_given("--purge") {
        run_out("rm\n-rf\n" + a.home + "/.voice/node-data");
        run_out("rm\n-f\n" + a.home + "/.voice/vault/node-" + id + "-enrollment");
    }
    println("node " + id + " uninstalled");
}

/// The account a node is installed for: the one that ran the command with
/// sudo. Installing writes a system service, so it runs as root, and the
/// node then runs as that account, never as root.
type Account { user: String = ""; home: String = ""; }

@unbounded
fn installing_account() -> Account {
    if std::str::trim(run_out("id\n-u")) != "0" {
        fail_install("the node installs as a system service: run it with sudo");
    }
    let user = if std::env::var_exists("SUDO_USER") { std::env::var("SUDO_USER") } else { "" };
    if len(user) == 0 || user == "root" {
        fail_install("run it with sudo from the account the node runs as, not as root itself");
    }
    let home = home_of(user, os_of(run_out("uname\n-s")) == "darwin");
    if !std::str::starts_with(home, "/") { fail_install("no home for account " + user); }
    return Account { user: user, home: home };
}

/// An account's home, from the system's account database, no shell
/// between: `dscl` on macOS, `getent passwd` on Linux.
@unbounded
fn home_of(user: String, mac: Bool) -> String {
    if mac {
        return home_in_dscl(run_out("dscl\n.\n-read\n/Users/" + user + "\nNFSHomeDirectory"));
    }
    return home_in_passwd(run_out("getent\npasswd\n" + user));
}

/// `dscl . -read /Users/<u> NFSHomeDirectory`: `NFSHomeDirectory: /Users/u`.
fn home_in_dscl(out: String) -> String {
    let at = std::str::index_of(out, ":");
    return if at < 0 { "" } else { std::str::trim(out[(at + 1)..len(out)]) };
}

/// A passwd line, `name:x:uid:gid:gecos:home:shell`: its sixth field.
@bounded_by(line)
fn home_in_passwd(line: String) -> String {
    let mut rest = std::str::trim(line);
    let mut i = 0;
    while i < 5 {
        let at = std::str::index_of(rest, ":");
        if at < 0 { return ""; }
        rest = rest[(at + 1)..len(rest)];
        i = i + 1;
    }
    let at = std::str::index_of(rest, ":");
    return if at < 0 { rest } else { rest[0..at] };
}

fn fail_install(why: String) {
    log_error(why, "");
    std::process::exit(1);
}

/// The value after `name` in the arguments from 2 on, or `otherwise`.
@unbounded
fn option(name: String, otherwise: String) -> String {
    let mut i = 2;
    while i + 1 < std::env::args_count() {
        if std::env::arg(i) == name { return std::env::arg(i + 1); }
        i = i + 1;
    }
    return otherwise;
}

@unbounded
fn flag_given(name: String) -> Bool {
    let mut i = 2;
    while i < std::env::args_count() {
        if std::env::arg(i) == name { return true; }
        i = i + 1;
    }
    return false;
}
