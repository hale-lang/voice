// The openai-compatible engine: its config, the chat-completions request
// it sends, the events it plays from an upstream's stream, and a seat run
// against a stub upstream in this same program (canned SSE, no model).
import ".." as node;

fn sse(chunks: String, usage: String, finish: String) -> String {
    return chunks + "data: {\"model\":\"stub-7b\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"" + finish + "\"}]}\n\n"
        + (if len(usage) > 0 { "data: {\"model\":\"stub-7b\",\"choices\":[],\"usage\":" + usage + "}\n\n" } else { "" }) + "data: [DONE]\n\n";
}

const HELLO: String = "data: {\"model\":\"stub-7b\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"Hel\"}}]}\n\ndata: {\"model\":\"stub-7b\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"lo\"}}]}\n\n";

fn hex(n: Int) -> String {
    if n < 16 { return substring("0123456789abcdef", n, n + 1); }
    return hex(n / 16) + substring("0123456789abcdef", n % 16, n % 16 + 1);
}

fn substring(s: String, lo: Int, hi: Int) -> String {
    return std::str::substring(s, lo, hi);
}

fn chunk(s: String) -> String {
    return hex(len(s)) + "\r\n" + s + "\r\n";
}

fn last_write_file() -> String {
    return "/tmp/voice-compat-" + to_string(std::process::pid()) + ".last";
}

fn answer(s: std::io::tcp::Stream, status: String, body: String) {
    s.send("HTTP/1.1 " + status + "\r\nContent-Type: application/json\r\nContent-Length: " + to_string(len(body)) + "\r\nConnection: close\r\n\r\n" + body) or discard;
}

/// The stub upstream: one connection, one canned answer. The streamed one
/// sends its SSE in several chunked writes, an event cut across two of
/// them, with a pause between, and notes the time of its last write.
fn stub_conn(s: std::io::tcp::Stream) {
    let req = s.recv(65536) or "";
    if !std::str::starts_with(req, "POST ") { answer(s, "405 Method Not Allowed", "{}"); return; }
    if std::str::starts_with(req, "POST /v1/chat/completions ") {
        if std::str::contains(req, "Authorization: Bearer stub-key") && std::str::contains(req, "\"stream\":true") && std::str::contains(req, "\"model\":\"stub-7b\"") {
            s.send("HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n") or discard;
            let first = "data: {\"model\":\"stub-7b\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"Hel\"}}]}\n\n";
            s.send(chunk(first)) or discard;
            std::time::sleep(300ms);
            let second = "data: {\"model\":\"stub-7b\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"lo\"}}]}\n\n";
            s.send(chunk(second[0..20])) or discard;
            std::time::sleep(100ms);
            s.send(chunk(second[20..len(second)])) or discard;
            std::time::sleep(300ms);
            std::io::fs::write_file(last_write_file(), to_string(std::time::monotonic_ns())) or discard;
            s.send(chunk("data: {\"model\":\"stub-7b\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: {\"model\":\"stub-7b\",\"choices\":[],\"usage\":{\"prompt_tokens\":12,\"completion_tokens\":2,\"total_tokens\":14}}\n\ndata: [DONE]\n\n") + "0\r\n\r\n") or discard;
            return;
        }
        answer(s, "401 Unauthorized", "{\"error\":{\"message\":\"bad key\"}}");
        return;
    }
    if std::str::starts_with(req, "POST /local/chat/completions ") {
        // no framing: the body runs to the end of the connection
        s.send("HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nConnection: close\r\n\r\n" + sse(HELLO, "", "length")) or discard;
        return;
    }
    if std::str::starts_with(req, "POST /cut/chat/completions ") {
        // closes mid-stream: one event, no terminal chunk, no [DONE]
        s.send("HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n" + chunk("data: {\"model\":\"stub-7b\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hel\"}}]}\n\n")) or discard;
        return;
    }
    answer(s, "503 Service Unavailable", "{\"error\":{\"message\":\"model is loading\"}}");
}

/// Takes the stub's connections, one at a time, on a listener the test
/// bound.
locus Stub {
    params { fd: Int = -1; }
    run() {
        while true {
            let conn = std::io::tcp::accept_one(self.fd) or - 1;
            if conn < 0 { return; }
            stub_conn(std::io::tcp::Stream { conn_fd: conn, owns_fd: false });
            // the stub's answer ends with the connection
            std::io::tcp::close_fd(conn);
        }
    }
}

fn free_port() -> Int {
    let mut port = 21000 + std::process::pid() % 9000;
    while port < 30000 {
        let fd = std::io::tcp::__listen_socket("127.0.0.1", port);
        if fd >= 0 {
            std::io::tcp::__close_fd(fd);
            return port;
        }
        port = port + 1;
    }
    return -1;
}

main locus App {
    params {
        srv: Stub = Stub { };
        base: String = "";
    }
    placement { srv: cooperative(pool = io); }
    run() {
        std::time::sleep(200ms);
        let ask = "{\"model\": \"voice-1\", \"input\": \"hi there\"}";
        // a keyed seat: the key is read from the vault slot, sent, and
        // never appears in what the run plays
        let keyed = node::compat_config("{\"base_url\": \"" + self.base + "/v1\", \"model\": \"stub-7b\", \"api_key_vault\": \"voice-test-key\", \"input_per_mtok_micros\": 500000, \"output_per_mtok_micros\": 1500000}");
        std::test::assert_eq_str(keyed.problem, "", "a valid config");
        let run = node::run_compat("resp_k1", "voice-1", ask, keyed);
        std::test::assert_eq_str(run.outcome, "served", "served: " + run.failure);
        std::test::assert_eq_str(run.model, "stub-7b", "the model the upstream reported");
        std::test::assert_eq_int(run.input_tokens, 12, "usage from the upstream's final chunk");
        std::test::assert_eq_int(run.output_tokens, 2, "and its completion tokens");
        std::test::assert_eq_int(run.cost_micros, 9, "priced per million tokens, rounded up");
        std::test::assert(std::str::contains(run.script, "\"delta\":\"Hel\""), "the first chunk is a delta");
        std::test::assert(std::str::contains(run.script, "\"type\":\"response.completed\""), "and the run completes");
        std::test::assert(std::str::contains(run.script, "\"text\":\"Hello\""), "with the whole text");
        std::test::assert(!std::str::contains(run.script, "stub-key"), "the key is not played");
        std::test::assert(std::str::contains(node::result_message("resp_k1", run, 1, 2), "\"usage\":{\"cost_micros\":9}"), "the result carries the cost");

        // streamed: the first event is published before the stub's last write
        let up = node::upstream_for("resp_k0", "voice-1", ask, keyed);
        up.open(node::compat_request(ask, keyed));
        let mut first_at = -1;
        while !up.done {
            let d = up.next_data();
            if len(d) > 0 {
                let lines = up.feed(d);
                if first_at < 0 && std::str::contains(lines, "response.output_text.delta") { first_at = std::time::monotonic_ns(); }
            }
        }
        let end = up.finish();
        let last = std::str::parse_int(std::io::fs::read_file(last_write_file()) or "0") or 0;
        std::test::assert(first_at > 0 && last > 0 && first_at < last, "the first event is published before the upstream's last write");
        std::test::assert_eq_str(end.outcome, "served", "and the run ends served: " + end.failure);
        std::test::assert_eq_int(end.output_tokens, 2, "with the usage of the last chunk");

        // the upstream refuses the key: a failure, with nothing played
        let wrong = node::run_compat("resp_k2", "voice-1", ask, node::compat_config("{\"base_url\": \"" + self.base + "/v1\", \"model\": \"stub-7b\"}"));
        std::test::assert_eq_str(wrong.outcome, "failed", "a refused key fails the seat");
        std::test::assert(std::str::contains(wrong.failure, "401") && std::str::contains(wrong.failure, "bad key"), "and says why: " + wrong.failure);
        std::test::assert_eq_int(len(wrong.script), 0, "before any output");

        // a loading model, a stream cut by the length limit, and a local seat
        let loading = node::run_compat("resp_k3", "voice-1", ask, node::compat_config("{\"base_url\": \"" + self.base + "/other\", \"model\": \"stub-7b\"}"));
        std::test::assert(loading.outcome == "failed" && std::str::contains(loading.failure, "503"), "an upstream error fails the seat");
        let local = node::run_compat("resp_k4", "voice-1", ask, node::compat_config("{\"base_url\": \"" + self.base + "/local/\", \"model\": \"stub-7b\"}"));
        std::test::assert_eq_str(local.outcome, "incomplete", "finish_reason length is incomplete");
        std::test::assert_eq_int(local.cost_micros, 0, "a local seat costs nothing");
        std::test::assert_eq_int(local.output_tokens, 2, "tokens estimated when the upstream gives no usage");
        let cut = node::run_compat("resp_k6", "voice-1", ask, node::compat_config("{\"base_url\": \"" + self.base + "/cut\", \"model\": \"stub-7b\"}"));
        std::test::assert_eq_str(cut.outcome, "failed", "a stream that closes before its end fails the run");
        std::test::assert(std::str::contains(cut.failure, "early"), "and says so: " + cut.failure);
        let nobody = node::run_compat("resp_k5", "voice-1", ask, node::compat_config("{\"base_url\": \"http://127.0.0.1:1\", \"model\": \"stub-7b\"}"));
        std::test::assert(nobody.outcome == "failed" && std::str::contains(nobody.failure, "could not be reached"), "an unreachable upstream fails the seat");
    }
}

fn main() {
    // config
    std::test::assert(len(node::compat_config("{\"model\": \"m\"}").problem) > 0, "base_url is required");
    std::test::assert(len(node::compat_config("{\"base_url\": \"ftp://x\", \"model\": \"m\"}").problem) > 0, "and is http or https");
    std::test::assert(len(node::compat_config("{\"base_url\": \"http://x\"}").problem) > 0, "model is required");
    std::test::assert(len(node::compat_config("{\"base_url\": \"http://x\", \"model\": \"m\", \"input_per_mtok_micros\": -1}").problem) > 0, "prices are not negative");
    let c = node::compat_config("{\"base_url\": \"http://localhost:11434/v1/\", \"model\": \"llama3\"}");
    std::test::assert_eq_str(c.problem, "", "a local seat needs no key and no price");
    std::test::assert_eq_str(c.base_url, "http://localhost:11434/v1", "a trailing slash is dropped");
    std::test::assert_eq_int(c.input_per_mtok_micros + c.output_per_mtok_micros, 0, "the price defaults to zero");

    // the request sent
    let req = node::compat_request("{\"model\": \"voice-1\", \"instructions\": \"be brief\", \"input\": [{\"role\": \"user\", \"content\": [{\"type\": \"input_text\", \"text\": \"a\"}, {\"type\": \"input_text\", \"text\": \"b\"}]}, {\"role\": \"assistant\", \"content\": \"ok\"}], \"max_output_tokens\": 50}", c);
    std::test::assert(std::str::contains(req, "\"model\":\"llama3\""), "the upstream's model, not the catalog's");
    std::test::assert(std::str::contains(req, "[{\"role\":\"system\",\"content\":\"be brief\"},{\"role\":\"user\",\"content\":\"ab\"},{\"role\":\"assistant\",\"content\":\"ok\"}]"), "instructions and items become messages: " + req);
    std::test::assert(std::str::contains(req, "\"stream\":true") && std::str::contains(req, "\"include_usage\":true") && std::str::contains(req, "\"max_tokens\":50"), "streamed, with usage and the cap");

    // the node offers the kind and checks its seats
    let file = "{\"max_in_flight\": 2, \"engines\": [{\"id\": \"ollama\", \"kind\": \"openai-compatible\"}]}";
    std::test::assert_eq_str(node::capabilities_problem(file), "", "the kind is one this build runs");
    std::test::assert(std::str::contains(node::declared_capabilities(file), "\"base_url\""), "and declares its config schema");
    let assigned = "{\"version\": 1, \"max_in_flight\": 2, \"seats\": [{\"id\": \"a\", \"engine\": \"ollama\", \"config\": {\"base_url\": \"http://localhost:11434/v1\", \"model\": \"llama3\"}}, {\"id\": \"b\", \"engine\": \"ollama\", \"config\": {\"model\": \"llama3\"}}]}";
    let seats = node::apply_assignment(assigned, node::declared_capabilities(file), node::LOCAL_DEFAULT);
    std::test::assert_eq_str(node::seat_of(seats, "a").status, "up", "a seat with a valid config is up");
    std::test::assert_eq_str(node::seat_of(seats, "b").status, "refused", "one without a base_url is refused");

    // the stream's own errors and ends
    let hello = node::compat_play("resp_p", "voice-1", "stub", "{}", c, 200, sse(HELLO, "", "stop"));
    std::test::assert_eq_str(hello.outcome, "served", "a stream without usage is served");
    std::test::assert_eq_int(hello.output_tokens, 2, "and counted one token per four characters");
    std::test::assert_eq_str(node::compat_play("resp_p", "voice-1", "stub", "{}", c, 200, "data: [DONE]\n\n").outcome, "failed", "a stream with no output fails the seat");
    std::test::assert_eq_str(node::compat_play("resp_p", "voice-1", "stub", "{}", c, 200, "data: {\"error\":{\"message\":\"oom\"}}\n\n").outcome, "failed", "an error chunk fails the seat");

    // the stub upstream, and the key in the vault
    std::io::fs::write_file(std::secret::vault_local_dir() + "/voice-test-key", "stub-key") or discard;
    let port = free_port();
    std::test::assert(port > 0, "a free loopback port");
    let fd = std::io::tcp::listen_socket("127.0.0.1", port) or - 1;
    std::test::assert(fd >= 0, "the stub listens");
    App { srv: Stub { fd: fd }, base: "http://127.0.0.1:" + to_string(port) };
}
