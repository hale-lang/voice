// A machine's GPU is placed on through its native API first (CUDA, ROCm,
// Metal), then Vulkan, then the processors: an AMD card with ROCm takes the
// ROCm runtime, one without ROCm's compute device the Vulkan one, and a
// machine with no GPU the CPU one.
import ".." as api;

fn runtime(id: String, accel: api::RuntimeAccelerator) -> api::Runtime {
    let mut r = api::Runtime { id: id, server: "llama-server", accelerator: accel };
    push(r.formats, api::ModelFormat::gguf) or discard;
    push(
        r.platforms,
        api::RuntimePlatform { os: api::HostOs::linux, arch: api::HostArch::x86_64 },
    ) or discard;
    return r;
}

fn hw(kinds: String) -> String {
    return "{\"os\": \"linux\", \"arch\": \"x86_64\", \"accelerators\": [" + kinds + "]}";
}

fn main() {
    let mut rts = api::RuntimeList { };
    // listed CPU first, Vulkan before ROCm: the order says nothing
    push(rts.data, runtime("cpu", api::RuntimeAccelerator::cpu)) or discard;
    push(rts.data, runtime("vulkan", api::RuntimeAccelerator::vulkan)) or discard;
    push(rts.data, runtime("rocm", api::RuntimeAccelerator::rocm)) or discard;
    push(rts.data, runtime("cuda", api::RuntimeAccelerator::cuda)) or discard;
    let amd = hw("{\"kind\": \"rocm\"}, {\"kind\": \"vulkan\"}");
    std::test::assert_eq_str(
        api::runtime_for("gguf", amd, rts),
        "rocm",
        "an AMD card with ROCm: ROCm",
    );
    std::test::assert_eq_str(
        api::runtime_for("gguf", hw("{\"kind\": \"vulkan\"}"), rts),
        "vulkan",
        "a GPU through Vulkan only: Vulkan, before the processors",
    );
    std::test::assert_eq_str(
        api::runtime_for("gguf", hw(""), rts),
        "cpu",
        "no GPU: the processors",
    );
    std::test::assert_eq_str(
        api::runtime_for("gguf", hw("{\"kind\": \"cuda\"}"), rts),
        "cuda",
        "an NVIDIA card: CUDA",
    );
    std::test::assert_eq_int(
        api::format_rank("gguf", amd),
        0,
        "llama.cpp's own format first on AMD",
    );
}
