// The operator token: the admin plane's one credential (/admin/v1).
//
// The api mints it on its first start and keeps it where it keeps its
// state: the store's `operator_token` row (spec/store.md, migration 7) when
// it has a database, so every api over that database answers to the same
// token; a standalone api's (its store in memory) a file of its state
// directory (`--state`, by default `$XDG_STATE_HOME/voice-api`), private
// from its first byte (operator_token_file), so a restart keeps it. It is never logged and
// never read from the environment. `api admin-token` prints it (minting it
// when no api has yet): under Compose, `docker compose exec api voice-api
// admin-token`.
//
// `AdminBearer` (ctl.hl) admits a request whose `Authorization: Bearer`
// is the token, comparing digests in constant time; the event stream and
// the route table, which the data plane serves, ask it too.

/// The file a standalone api keeps its operator token in, in its state
/// directory.
const OPERATOR_TOKEN_FILE: String = "operator-token";

type TokenError { message: String = ""; }

/// A new operator token: `va-` and 32 random bytes from the kernel, in hex.
/// Minted once per process at most: the bearer holds the digest of the
/// token it read.
@unbounded
fn mint_operator_token() -> String fallible(TokenError) {
    let b = std::os::getrandom(32) or fail TokenError { message: "no randomness from the kernel" };
    return "va-" + std::hex::encode(b);
}

/// The state directory: `--state`, else `$XDG_STATE_HOME/voice-api`, else
/// `$HOME/.local/state/voice-api`.
fn state_dir_or(given: String) -> String {
    if len(given) > 0 { return given; }
    if std::env::var_exists("XDG_STATE_HOME") && len(std::env::var("XDG_STATE_HOME")) > 0 {
        return std::env::var("XDG_STATE_HOME") + "/voice-api";
    }
    return std::env::var("HOME") + "/.local/state/voice-api";
}

/// The permission bits of `path` (`stat -c %a`), -1 when it cannot be read.
fn mode_of(path: String) -> Int {
    let out = std::process::run("stat\n-L\n-c\n%a\n" + path) or {
        return -1;
    };
    if out.code != 0 { return -1; }
    let text = std::str::trim(out.stdout);
    let mut mode = 0;
    let mut i = 0;
    while i < len(text) {
        let d = std::str::byte_at(std::str::bytes_view(text), i) - 48;
        if d < 0 || d > 7 { return -1; }
        mode = mode * 8 + d;
        i = i + 1;
    }
    return if len(text) == 0 { -1 } else { mode };
}

/// The state directory, made private when it is new; refused when it
/// cannot be told private, or when another user may write in it (group or
/// world write), where the token's file could be swapped.
fn private_state(state: String) -> Bool fallible(TokenError) {
    if !std::io::fs::file_exists(state) {
        std::process::run("mkdir\n-p\n-m\n700\n" + state) or discard;
    }
    let mode = mode_of(state);
    if mode < 0 {
        fail TokenError { message: "the state directory " + state + " could not be made or read" };
    }
    if (mode & 18) != 0 {
        fail TokenError {
            message: "the state directory " + state + " is writable by other users (mode "
                + to_string(mode) + "): make it 700 or name another with --state",
        };
    }
    return true;
}

/// The token kept at `path`: "" when there is none; refused when the file
/// is readable by other users.
fn kept_token(path: String) -> String fallible(TokenError) {
    if !std::io::fs::file_exists(path) { return ""; }
    let mode = mode_of(path);
    if mode < 0 || (mode & 63) != 0 {
        fail TokenError {
            message: "the operator token's file " + path
                + " is readable by other users, or its mode cannot be read: make it 600",
        };
    }
    return std::str::trim(std::io::fs::read_file(path) or "");
}

/// A standalone api's operator token, from its state directory: the one
/// kept there, or one minted and kept now. The new token is written into a
/// file `mktemp` creates with mode 600, so no byte of it is ever readable
/// by another user, and published under its name by a hard link, which
/// fails when the name is taken: of two first starts at once one link
/// wins, and the other reads back the winner's whole token, so every caller
/// returns the same one.
fn operator_token_file(state: String) -> String fallible(TokenError) {
    private_state(state) or raise;
    let path = state + "/" + OPERATOR_TOKEN_FILE;
    let kept = kept_token(path) or raise;
    if len(kept) > 0 { return kept; }
    let fresh = mint_operator_token() or raise;
    return publish_operator_token(state, fresh) or raise;
}

/// Publish `fresh` as the state directory's operator token unless another
/// is there: the token kept under the name afterwards, `fresh` or the
/// winner's.
fn publish_operator_token(state: String, fresh: String) -> String fallible(TokenError) {
    let path = state + "/" + OPERATOR_TOKEN_FILE;
    let draft = std::io::fs::mktemp(state + "/.operator-token-", "") or fail TokenError {
        message: "the operator token could not be written in " + state,
    };
    let mut written = true;
    std::io::fs::write_file(draft, fresh) or { written = false; };
    let mut linked = false;
    if written && mode_of(draft) == 384 {
        let ln = std::process::run("ln\n" + draft + "\n" + path) or std::process::ProcessOutput {
            code: 1,
            signal: 0,
            stdout: "",
            stderr: "",
        };
        linked = ln.code == 0;
    }
    std::io::fs::unlink(draft) or discard;
    if linked { return fresh; }
    // another caller's token won the name: read back its whole value
    let won = kept_token(path) or raise;
    if len(won) == 0 {
        fail TokenError { message: "the operator token could not be kept in " + path };
    }
    return won;
}

/// The operator token over a database: the row kept, or one minted and
/// kept now.
@unbounded
fn operator_token_kept(store: st::Store) -> String fallible(TokenError) {
    let fresh = mint_operator_token() or raise;
    let token = store.operator_token(fresh) or fail TokenError {
        message: "the store could not keep the operator token: " + err.message,
    };
    if len(token) == 0 { fail TokenError { message: "the store kept no operator token" }; }
    return token;
}

/// The digest an operator token is compared as: SHA-256, in hex.
fn operator_digest(token: String) -> String {
    return std::hex::encode(std::crypto::sha256(std::bytes::from_string(token)));
}

/// True when `token`'s digest is `want` (a digest of `operator_digest`),
/// compared in time that does not depend on where they differ; an empty
/// `want` (no token kept yet) admits nothing.
fn operator_matches(want: String, token: String) -> Bool {
    if len(want) != 64 || len(token) == 0 { return false; }
    let got = operator_digest(token);
    let a = std::str::bytes_view(want);
    let b = std::str::bytes_view(got);
    let mut diff = 0;
    let mut i = 0;
    while i < 64 {
        diff = diff | (std::str::byte_at(a, i) ^ std::str::byte_at(b, i));
        i = i + 1;
    }
    return diff == 0;
}

/// The bearer of an `Authorization` header, "" when it names none.
fn bearer_of(authorization: String) -> String {
    if len(authorization) < 7 || std::str::lower(authorization[0..7]) != "bearer " { return ""; }
    return std::str::trim(authorization[7..len(authorization)]);
}

/// Why a request without the operator token is refused.
const OPERATOR_REFUSED: String = "the admin plane takes the operator token: Authorization: Bearer va-... (voice-api admin-token prints it)";

/// The data plane's refusal of an admin path without the operator token,
/// as the exposure refuses a row's: 401, `unauthenticated`.
fn operator_refusal() -> std::http::Response {
    return std::http::Response {
        status: 401,
        content_type: "application/json",
        headers: "WWW-Authenticate: Bearer",
        body: "{\"refusal\": {\"kind\": \"unauthenticated\", \"reason\": \"" + OPERATOR_REFUSED
            + "\"}}",
    };
}

/// The operator token as the api starts: minted when none is kept. Over a
/// database "" (the bearer reads the row it kept); standalone, the token
/// kept in the state directory, for the store in memory. The process ends
/// when it cannot be kept.
fn operator_token_at_start(database: String, state: String) -> String {
    if len(database) > 0 {
        operator_token_kept(st::PgStore { url: database }) or {
            log_error("the operator token could not be kept", std::log::kv("why", err.message));
            std::process::exit(1);
            return "";
        };
        return "";
    }
    return operator_token_file(state_dir_or(state)) or {
        log_error("the operator token could not be kept", std::log::kv("why", err.message));
        std::process::exit(1);
        return "";
    };
}
