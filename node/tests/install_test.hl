// The install, without a machine to install on: enrolling against an api
// that answers as the real one does, the capabilities voice decides, the
// LaunchDaemon's plist and the systemd unit, and an account's home.
import ".." as node;

/// An api with node `taken` already recorded.
locus FakeApi {
    params { calls: String = ""; }
    fn send(method: String, path: String, body: String) -> node::Reply {
        self.calls = self.calls + method + " " + path + "\n";
        if method == "POST" && path == "/admin/v1/nodes" {
            if std::str::contains(body, "\"taken\"") {
                return node::Reply { status: 409, body: "{}" };
            }
            return node::Reply {
                status: 201,
                body: "{\"id\": \"new\", \"enrollment_token\": \"vn-new\"}",
            };
        }
        if method == "POST" && path == "/admin/v1/nodes/taken/token" {
            return node::Reply { status: 200, body: "{\"enrollment_token\": \"vn-rotated\"}" };
        }
        return node::Reply { status: 500, body: "unexpected" };
    }
}

/// An api that refuses the operator token.
locus RefusingApi {
    fn send(method: String, path: String, body: String) -> node::Reply {
        return node::Reply { status: 401, body: "{\"Unauthorized\": {}}" };
    }
}

fn main() {
    claude_tokens_dropped();
    service_path_is_the_system_s();
    declared_engines_kept();
    let api = FakeApi { };
    let fresh = node::enroll(api, "new", false);
    std::test::assert(
        fresh.ok && fresh.token == "vn-new",
        "a new node is recorded, its token kept",
    );
    let again = node::enroll(api, "taken", true);
    std::test::assert(
        again.ok && len(again.token) == 0,
        "installing again with the token kept changes nothing",
    );
    let lost = node::enroll(api, "taken", false);
    std::test::assert(
        lost.ok && lost.token == "vn-rotated",
        "a node whose token is gone is given a new one",
    );
    let refused = node::enroll(RefusingApi { }, "new", false);
    std::test::assert(
        !refused.ok && std::str::contains(refused.why, "401"),
        "an api that refuses says so: " + refused.why,
    );

    std::test::assert_eq_str(
        node::capabilities_problem(node::node_capabilities(-1, "")),
        "",
        "the managed engine alone",
    );
    std::test::assert(
        !std::str::contains(node::node_capabilities(-1, ""), "max_in_flight"),
        "and no cap of the node's own: its capacity is its seats'",
    );
    std::test::assert(
        !std::str::contains(node::node_capabilities(-1, ""), "claude"),
        "and no claude-cli engine, which no node runs now",
    );
    let shared = node::node_capabilities(120000000000, "");
    std::test::assert(
        node::capabilities_problem(shared) == "" && node::held_back(shared) == 120000000000,
        "the memory left for models, where some of the machine is another's: " + shared,
    );
    std::test::assert(
        !std::str::contains(node::node_capabilities(-1, ""), "hardware"),
        "and none said when it is all the node's",
    );
    // the links its operator declared are the machine's: written again as
    // they were, and an unusable list is not carried over
    let declared = "{\"max_in_flight\": 4, \"engines\": [], \"links\": [{\"peer\": \"node-b\", \"ports\": [{\"ifname\": \"enp1s0f0np0\", \"address\": \"198.51.100.1\", \"hca\": \"rocep1s0f0\"}], \"gid_index\": 3}]}";
    let kept = node::node_capabilities(-1, declared);
    std::test::assert(
        node::capabilities_problem(kept) == ""
            && std::str::contains(kept, "\"links\": [{\"peer\": \"node-b\""),
        "an install keeps the links the file declares: " + kept,
    );
    std::test::assert_eq_str(
        node::kept_links("{\"links\": [{\"peer\": \"Node-B\"}]}"),
        "",
        "and drops a list the node would refuse",
    );
    std::test::assert_eq_str(node::kept_links(""), "", "and keeps nothing from no file");

    std::test::assert(node::on_loopback("http://127.0.0.1:8080"), "127.0.0.1 is this machine");
    std::test::assert(node::on_loopback("http://localhost:8080/"), "and localhost");
    std::test::assert(node::on_loopback("http://[::1]:8080"), "and ::1");
    std::test::assert(!node::on_loopback("http://192.0.2.5:8080"), "another address is not");
    std::test::assert(
        !node::on_loopback("http://localhost.example.net:8080"),
        "nor a name that starts so",
    );
    let total = 137438953472;
    std::test::assert_eq_int(
        node::memory_left(total, "http://127.0.0.1:8080", false, 0, false),
        total - 8589934592,
        "outside a habitat, the coordinator on this machine is held back",
    );
    std::test::assert_eq_int(
        node::memory_left(total, "http://192.0.2.5:8080", false, 0, false),
            -1,
        "and nothing when it runs elsewhere",
    );
    std::test::assert_eq_int(
        node::memory_left(total, "http://127.0.0.1:8080", true, 4000000000, true),
        total - 4000000000,
        "in a habitat, what it said its own services take here",
    );
    std::test::assert_eq_int(
        node::memory_left(total, "http://127.0.0.1:8080", true, 0, true),
            -1,
        "all of it where the habitat runs nothing",
    );
    std::test::assert_eq_int(
        node::memory_left(4000000000, "http://192.0.2.5:8080", true, 8000000000, true),
        0,
        "none when it takes more than there is",
    );
    std::test::assert_eq_int(
        node::memory_left(total, "http://gpu-box.example.com:8080", false, 0, true),
        total - 8589934592,
        "a habitat that does not say what it takes is held to the coordinator's 8 GiB",
    );

    let s = node::Service {
        name: "voice-node-node-a",
        user: "op",
        home: "/home/op",
        node_bin: "/home/op/.voice/bin/voice-node",
        id: "node-a",
        api: "http://192.0.2.5:8080",
        token_vault: "node-node-a-enrollment",
        data: "/home/op/.voice/node-data",
        capabilities: "/home/op/.voice/node-data/capabilities.json",
        port: 8081,
        vault_dir: "/home/op/.voice/vault",
        path: "/usr/bin:/bin",
        log: "/home/op/.voice/node-node-a.log",
    };
    let plist = node::launchd_daemon_plist(s);
    std::test::assert(
        std::str::contains(plist, "<key>UserName</key><string>op</string>")
            && std::str::contains(plist, "<string>--token-vault</string>")
            && std::str::contains(plist, "<string>node-node-a-enrollment</string>")
            && std::str::contains(plist, "<key>KeepAlive</key><true/>")
            && std::str::contains(plist, "<key>LOTUS_DRAIN_GRACE_MS</key><string>15000</string>")
            && std::str::contains(plist, "<key>ExitTimeOut</key><integer>20</integer>"),
        "the LaunchDaemon runs the node as its account, kept running",
    );
    let unit = node::systemd_unit(s);
    std::test::assert(
        std::str::contains(unit, "User=op\n")
            && std::str::contains(
                unit,
                "ExecStart=\"/home/op/.voice/bin/voice-node\" \"--id\" \"node-a\"",
            )
            && std::str::contains(unit, "Restart=always")
            && std::str::contains(unit, "After=network-online.target docker.service"),
        "the systemd unit runs it as its account, after docker, restarted: " + unit,
    );
    std::test::assert(
        !std::str::contains(unit, "\nExecStop=\"")
            && std::str::contains(
                unit,
                "voice-node\" \"stop-seats\" \"--id\" \"node-a\" \"--data\" ",
            )
            && std::str::contains(unit, "\nExecStopPost=\"")
            && std::str::contains(unit, "KillMode=mixed\n")
            && std::str::contains(unit, "LOTUS_DRAIN_GRACE_MS=15000")
            && std::str::contains(unit, "TimeoutStopSec=20\n"),
        "stopping, the node alone is signalled and drains, its servers stopped by its drain, then what is left of its stopped, what is left of its group killed after 20 s: "
            + unit,
    );
    std::test::assert_eq_str(
        node::unit_value("50% \"x\""),
        "\"50%% \\\"x\\\"\"",
        "a unit's value is quoted and escaped",
    );

    std::test::assert_eq_str(
        node::home_in_dscl("NFSHomeDirectory: /Users/op\n"),
        "/Users/op",
        "a Mac's home",
    );
    std::test::assert_eq_str(
        node::home_in_passwd("op:x:1000:1000:Op,,,:/home/op:/bin/bash\n"),
        "/home/op",
        "a Linux home",
    );
    std::test::assert_eq_str(node::home_in_passwd(""), "", "no account, no home");
}

/// The Claude accounts' tokens an install from before kept in the node's
/// vault for its claude-cli seats go, and the vault's other entries stay.
fn claude_tokens_dropped() {
    let root = "/tmp/voice-install-test-" + to_string(std::time::monotonic_ns());
    let vault = root + "/vault";
    node::run_out("mkdir\n-p\n" + vault);
    std::io::fs::write_file(vault + "/claude-token--work", "tok-work") or discard;
    std::io::fs::write_file(vault + "/claude-token--personal-1", "tok-p1") or discard;
    std::io::fs::write_file(vault + "/claude-token--", "not one") or discard;
    std::io::fs::write_file(vault + "/node-x-enrollment", "vn-x") or discard;
    std::io::fs::write_file(vault + "/hf-token", "hf") or discard;
    node::drop_claude_tokens(vault);
    std::test::assert(
        !std::io::fs::file_exists(vault + "/claude-token--work")
            && !std::io::fs::file_exists(vault + "/claude-token--personal-1"),
        "every account's token goes",
    );
    std::test::assert(
        std::io::fs::file_exists(vault + "/node-x-enrollment")
            && std::io::fs::file_exists(vault + "/hf-token")
            && std::io::fs::file_exists(vault + "/claude-token--"),
        "the vault's other entries stay",
    );
    node::drop_claude_tokens(vault);
    std::test::assert(
        std::io::fs::file_exists(vault + "/node-x-enrollment"),
        "and running it again changes nothing",
    );
    node::run_out("rm\n-rf\n" + root);
}

/// The service runs the node with the system's program directories on its
/// PATH, where docker and the rest are found.
fn service_path_is_the_system_s() {
    let s = node::Service {
        name: "voice-node-mac",
        user: "op",
        home: "/Users/op",
        node_bin: "/Users/op/.voice/bin/voice-node",
        id: "mac",
        api: "http://192.0.2.5:8080",
        token_vault: "node-mac-enrollment",
        data: "/Users/op/.voice/node-data",
        capabilities: "/Users/op/.voice/node-data/capabilities.json",
        vault_dir: "/Users/op/.voice/vault",
        path: node::SYSTEM_PATH,
        log: "/Users/op/.voice/node-mac.log",
    };
    std::test::assert(
        std::str::contains(
            node::launchd_daemon_plist(s),
            "<key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:",
        ),
        "the LaunchDaemon runs the node with the system's PATH",
    );
    std::test::assert(
        std::str::contains(
            node::systemd_unit(s),
            "Environment=\"PATH=/opt/homebrew/bin:/usr/local/bin:",
        ),
        "and so does the systemd unit",
    );
}

/// An install writes the capabilities file again over the one it had: the
/// engines its operator declared there, a static drill or any other, are
/// kept as they were, in order, after install's own, which it writes
/// afresh, once each.
fn declared_engines_kept() {
    let drill = "{\"id\": \"drill\", \"kind\": \"static\", \"text\": \"x\"}";
    let custom = "{\"id\": \"lab-proxy\", \"kind\": \"openai-compatible\", \"local\": {\"note\": \"x\"}}";
    let had = "{\"max_in_flight\": 4, \"engines\": [{\"id\": \"managed\", \"kind\": \"managed\"}, "
        + drill + ", {\"id\": \"claude\", \"kind\": \"claude-cli\"}, " + custom
        + "], \"hardware\": {\"model_memory_bytes\": 1}, \"links\": [{\"peer\": \"node-b\", \"ports\": [{\"ifname\": \"enp1s0f0np0\", \"address\": \"198.51.100.1\"}]}], \"site\": {\"rack\": 2}}";
    let again = node::node_capabilities(120000000000, had);
    std::test::assert_eq_str(
        node::top_value(again, "engines"),
        "[{\"id\": \"managed\", \"kind\": \"managed\"}, " + drill + ", " + custom + "]",
        "a re-install keeps a declared static engine and a custom one, as written, after its own, each once, and drops the claude-cli engine of a node from before",
    );
    std::test::assert_eq_str(node::capabilities_problem(again), "", "and the node runs it");
    std::test::assert(
        node::held_back(again) == 120000000000,
        "the memory left for models is install's, written afresh: " + again,
    );
    std::test::assert(
        std::str::contains(again, "\"links\": [{\"peer\": \"node-b\""),
        "the links are still kept: " + again,
    );
    std::test::assert_eq_str(
        node::top_value(again, "site"),
        "{\"rack\": 2}",
        "an entry install does not write is kept as it was",
    );
    std::test::assert(
        !std::str::contains(again, "max_in_flight"),
        "and the cap an install from before wrote is not: " + again,
    );
    std::test::assert_eq_str(
        node::node_capabilities(120000000000, again),
        again,
        "installing again changes nothing that is already right",
    );

    std::test::assert(
        std::str::contains(
            node::capabilities_problem(had),
            "kind claude-cli is no longer run",
        ),
        "a node from before, not installed again, says why it does not start",
    );
    let gone = node::node_capabilities(-1, had);
    std::test::assert(
        !std::str::contains(gone, "hardware"),
        "and so does memory no longer held back",
    );

    let clash = "{\"engines\": [{\"id\": \"managed\", \"kind\": \"static\", \"text\": \"x\"}, {\"id\": \"claude\", \"kind\": \"openai-compatible\"}]}";
    std::test::assert_eq_str(
        node::top_value(node::node_capabilities(-1, clash), "engines"),
        "[{\"id\": \"managed\", \"kind\": \"managed\"}, {\"id\": \"claude\", \"kind\": \"openai-compatible\"}]",
        "a declared engine whose id install writes gives way to install's, and one of another id is kept",
    );

    let unusable = "{\"engines\": [{\"id\": \"Bad Id\", \"kind\": \"static\"}, {\"id\": \"gpu\", \"kind\": \"warp-drive\"}, {\"id\": \"coding\", \"kind\": \"harness\"}, {\"id\": \"claude\", \"kind\": \"claude-cli\"}, \"coding\", {\"id\": \"twin\", \"kind\": \"openai-compatible\"}, {\"id\": \"twin\", \"kind\": \"static\"}]}";
    std::test::assert_eq_str(
        node::top_value(node::node_capabilities(-1, unusable), "engines"),
        "[{\"id\": \"managed\", \"kind\": \"managed\"}, {\"id\": \"twin\", \"kind\": \"openai-compatible\"}]",
        "an engine the node could not run is not carried over, a harness or claude-cli engine from before among them",
    );

    let fresh = "{\"engines\": [{\"id\": \"managed\", \"kind\": \"managed\"}]}";
    std::test::assert_eq_str(
        node::node_capabilities(-1, ""),
        fresh,
        "no file: the managed engine alone, and no engine of install's finding",
    );
    std::test::assert_eq_str(
        node::node_capabilities(-1, "{\"engines\": [" + drill + ", "),
        fresh,
        "and a file that is no JSON object is as none",
    );
    std::test::assert_eq_str(
        node::node_capabilities(-1, "{\"engines\": " + drill + "}"),
        fresh,
        "as are engines that are no list",
    );
}
