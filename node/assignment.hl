// An assignment, applied (protocol.yaml): the node runs exactly the seats
// the coordinator assigned, and refuses any outside what it offers. Local
// controls only restrict: a paused node or seat is `paused`, and a local
// cap only lowers the effective one.

/// One assigned seat as the node holds it.
type NodeSeat {
    id: String = "";
    engine: String = "";
    // the engine's JSON config, as assigned
    config: String = "{}";
    concurrency: Int = 1;
    // starting | fetching | up | down | disabled | paused | refused
    status: String = "starting";
    // why, for refused, paused and down; "" for none
    reason: String = "";
    in_flight: Int = 0;
    // a managed seat's fetch, in bytes, while there is one (fetch.hl)
    has_progress: Bool = false;
    done_bytes: Int = 0;
    total_bytes: Int = 0;
    // a managed seat's server, once it answers (run.hl), and the context
    // it serves (0 until it says)
    endpoint: String = "";
    context: Int = 0;
    // a managed seat the fetcher and runner say the state of (session.hl)
    managed: Bool = false;
}

/// The assignment as applied: its seats, its version and its cap.
type NodeSeats { items: bounded[NodeSeat; 16]; version: Int = -1; max_in_flight: Int = 0; }

/// Apply `assignment` (its JSON) within `capabilities` and `local`.
@bounded_by(assignment)
fn apply_assignment(assignment: String, capabilities: String, local: String) -> NodeSeats {
    let mut out = NodeSeats {
        version: std::json::find_int_field(assignment, "version"),
        max_in_flight: std::json::find_int_field(assignment, "max_in_flight"),
    };
    let paused = std::json::find_bool_field(local, "paused");
    let held = std::json::find_field_raw(local, "paused_seats");
    let mut it = std::json::array_first(std::json::find_field_raw(assignment, "seats"));
    while !it.done {
        let s = std::str::trim(it.element);
        let mut seat = NodeSeat {
            id: std::json::find_string_field(s, "id"),
            engine: std::json::find_string_field(s, "engine"),
            config: std::str::trim(std::json::find_field_raw(s, "config")),
            concurrency: if std::json::string_field(s, "concurrency").kind == "number" {
                std::json::find_int_field(s, "concurrency")
            } else {
                1
            }
        };
        let kind = engine_kind(capabilities, seat.engine);
        let enabled = std::json::string_field(s, "enabled").kind != "bool"
            || std::json::find_bool_field(s, "enabled");
        if len(kind) == 0 {
            seat.status = "refused";
            seat.reason = "this node offers no engine " + seat.engine;
        } else if kind != "static" && kind != "openai-compatible" && kind != "claude-cli"
            && kind != "managed"
        {
            seat.status = "refused";
            seat.reason = "engine " + seat.engine + " is of kind " + kind
                + ", which this build does not run";
        } else if len(seat_problem(kind, seat.config)) > 0 {
            seat.status = "refused";
            seat.reason = seat_problem(kind, seat.config);
        } else if !enabled {
            seat.status = "disabled";
        } else if paused || names_seat(held, seat.id) {
            seat.status = "paused";
            seat.reason = "held by a local control on the node";
        } else if kind == "managed" {
            // up only once its weights and runtime are fetched, verified
            // and running; until the fetcher says how far it is, waiting
            seat.status = "fetching";
            seat.reason = "waiting to fetch";
            seat.managed = true;
        } else {
            seat.status = "up";
        }
        push(out.items, seat) or discard;
        it = std::json::array_next(it);
    }
    return out;
}

/// The kind of the engine `id` the node declared, "" when it declared none.
fn engine_kind(capabilities: String, id: String) -> String {
    let mut it = std::json::array_first(std::json::find_field_raw(capabilities, "engines"));
    while !it.done {
        if std::json::find_string_field(it.element, "id") == id {
            return std::json::find_string_field(it.element, "kind");
        }
        it = std::json::array_next(it);
    }
    return "";
}

/// True when the JSON list of seat ids names `id`.
fn names_seat(list: String, id: String) -> Bool {
    let mut it = std::json::array_first(list);
    while !it.done {
        if std::str::trim(it.element) == "\"" + id + "\"" { return true; }
        it = std::json::array_next(it);
    }
    return false;
}

/// The seat `id`, or one with no id when it is not assigned.
fn seat_of(seats: NodeSeats, id: String) -> NodeSeat {
    for s in seats.items {
        if s.id == id { return s; }
    }
    return NodeSeat { };
}

/// The node's effective cap: the smallest of its declared cap, the
/// coordinator's and its local one.
fn node_cap(capabilities: String, assigned: Int, local: String) -> Int {
    let mut cap = effective_cap(capabilities, local);
    if assigned > 0 && assigned < cap { cap = assigned; }
    return cap;
}

/// The seats' states, as the node plane takes them (`SeatState`s); `busy`
/// is the seat serving a request, "" for none.
fn states_json(seats: NodeSeats, busy: String) -> String {
    let out = std::bytes::BytesBuilder { initial_cap: 1024 };
    let mut first = true;
    for s in seats.items {
        if !first { out.append_str(", "); }
        first = false;
        out.append_str(
            "{\"id\": " + q(s.id) + ", \"status\": " + q(s.status) + ", \"reason\": "
                + (if len(s.reason) > 0 { q(s.reason) } else { "null" }) + ", \"in_flight\": "
                + (if s.id == busy { "1" } else { "0" })
                + (if s.has_progress {
                    ", \"progress\": {\"done_bytes\": " + to_string(s.done_bytes)
                        + ", \"total_bytes\": "
                        + to_string(s.total_bytes) + "}"
                } else {
                    ""
                }) + (if s.context > 0 { ", \"context\": " + to_string(s.context) } else { "" })
                + "}",
        );
    }
    let b = out.snapshot() or b"";
    return "[" + std::str::from_bytes(b) + "]";
}

/// Why a seat's config is not one for an engine of this kind, "" when it is.
fn seat_problem(kind: String, config: String) -> String {
    if kind == "openai-compatible" { return compat_config(config).problem; }
    if kind == "claude-cli" { return claude_config(config).problem; }
    if kind == "managed" { return managed_problem(config); }
    return static_config(config).problem;
}
