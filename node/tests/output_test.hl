// When a seat began to generate: its first output event, by the event's own
// type, never by what its payload or the caller's metadata says.
import ".." as node;

fn main() {
    std::test::assert(
        node::is_output("{\"type\":\"response.output_text.delta\",\"delta\":\"hi\"}"),
        "text is output",
    );
    std::test::assert(
        node::is_output("{\"type\":\"response.function_call_arguments.delta\",\"delta\":\"{\"}"),
        "a tool call's arguments are output",
    );
    std::test::assert(
        node::is_output("{\"type\":\"response.refusal.delta\",\"delta\":\"no\"}"),
        "a refusal is output",
    );
    std::test::assert(
        !node::is_output(
            "{\"type\":\"response.created\",\"response\":{\"metadata\":{\"trace\":\"response.function_call_arguments.delta\"}}}",
        ),
        "the caller's metadata naming an output event is not output",
    );
    std::test::assert(
        !node::is_output("{\"type\":\"response.output_item.added\"}"),
        "an item added is not output",
    );
}
