// A project's limit as the organization ratified it: the practice's own
// grammar, the later of two ratified practices in force, and the forms
// the head and the contract are written in. Reading through a head is
// the end-to-end fixture's (api/tests/admin_limits.sh); enforcing it is
// serve_test's.
import ".." as api;

const TEXT: String = "The rate limit for the project personal: one name: value per line, from window_seconds (the window, in seconds), requests, input_tokens, output_tokens and concurrent, each a whole number alone after its name; a name left out is unlimited.\nwindow_seconds: 60\nrequests: 2";

fn main() {
    let l = api::parse_limit(TEXT);
    std::test::assert(l.window_seconds == 60 && l.has_requests && l.requests == 2, "the limit read from its text");
    std::test::assert(!l.has_input_tokens && !l.has_output_tokens && !l.has_concurrent, "a name left out is unlimited");
    let odd = api::parse_limit("requests: two\nrequests: -3\nwindow_seconds: 0\nconcurrent: 4\nrequests: 7 per minute");
    std::test::assert(!odd.has_requests && odd.window_seconds == 60 && odd.has_concurrent && odd.concurrent == 4, "only a whole number alone counts, and a window is at least a second");

    // a superseding practice before the old one's retirement lands: the
    // later one is in force
    let folded = api::PracticeLimits { };
    api::fold_limit(folded, api::PracticeLimit { project: "personal", limit: api::parse_limit("requests: 2") });
    api::fold_limit(folded, api::PracticeLimit { project: "work", limit: api::parse_limit("requests: 9") });
    api::fold_limit(folded, api::PracticeLimit { project: "personal", limit: api::parse_limit("requests: 5") });
    let first = folded.get(0) or api::PracticeLimit { };
    std::test::assert(folded.len() == 2 && first.project == "personal" && first.limit.requests == 5, "the later practice of a project replaces the earlier");

    std::test::assert_eq_str(api::form_encode("a&b+c%d e/f"), "a%26b%2Bc%25d%20e%2Ff", "a value is percent-encoded in a form or a query");
    std::test::assert_eq_str(api::duration(1), "1s", "one second");
    std::test::assert_eq_str(api::duration(360), "6m0s", "six minutes");
}
