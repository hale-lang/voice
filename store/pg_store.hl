            fail err;
        };
        self.lock.leave();
        return taken;
    }

    fn insert_key_locked(row: KeyRow, change: ChangeRow) -> Bool fallible(StoreError) {
        self.begin() or raise;
        self.room(
            "SELECT count(*) FROM api_key WHERE project = $1",
            single_value(row.project),
            64,
            "a project holds at most 64 keys",
        ) or raise;
        let n = self.step(
            "INSERT INTO api_key (id, project, name, prefix, secret_digest, models, accounts, status, created_at, expires_at, last_used_at, revoked_at, peek) VALUES ($1, $2, $3, $4, decode($5, 'hex'), "
                + restriction_param(6) + ", " + restriction_param(7)
                + ", $8, $9::timestamptz, $10::timestamptz, $11::timestamptz, $12::timestamptz, $13::boolean) ON CONFLICT (id) DO NOTHING",
            key_args(row),
        ) or raise;
        if n == 0 {
            self.rollback();
            return false;
        }
        self.key_limits(row) or raise;
        self.commit_with(change) or raise;
        return true;
    }

    fn update_key(row: KeyRow, change: ChangeRow) fallible(StoreError) {
