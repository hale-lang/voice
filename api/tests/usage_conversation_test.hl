// A request's usage record keeps the conversation it was a turn of: its
// `prompt_cache_key`, or `null` when it sent none.
import ".." as api;

fn row(body: String) -> String {
    let attempts = api::Attempts { };
    return api::usage_row(
        api::InferenceRequest { model: "m", body: body },
        "req_1",
        "p",
        "k",
        api::ServedBy { model: "m", node: "n", seat: "n/s", account: "a" },
        "served",
        1,
        1,
        0,
        "USD",
        "{\"wall_ms\": 1, \"queue_ms\": 0, \"load_ms\": 0}",
        attempts.items
    ).record;
}

fn main() {
    let turn = row("{\"model\": \"m\", \"input\": \"hi\", \"prompt_cache_key\": \"conv-7\"}");
    std::test::assert(
        std::str::contains(turn, "\"conversation\": \"conv-7\""),
        "a turn records its conversation: " + turn,
    );
    let r = api::record_of(turn, "req_1") or api::UsageRecord { };
    std::test::assert(r.has_conversation && r.conversation == "conv-7", "and reads back with it");
    let alone = row(
        "{\"model\": \"m\", \"input\": \"hi\", \"metadata\": {\"conversation\": \"x\"}}",
    );
    std::test::assert(
        std::str::contains(alone, "\"conversation\": null"),
        "a request of none records null, whatever its metadata says: " + alone,
    );
    let r2 = api::record_of(alone, "req_1") or api::UsageRecord { has_conversation: true };
    std::test::assert(!r2.has_conversation, "and reads back without one");
}
