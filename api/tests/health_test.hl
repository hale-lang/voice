// GET /healthz and GET /readyz: the Probes rows.
import ".." as api;
import "../../store" as st;

fn main() {
    let p = api::Probes { store: st::MemoryStore { } };
    let live = p.liveness();
    std::test::assert(live.status == api::HealthStatus::ok, "alive");
    std::test::assert(len(live.version) > 0, "a version");
    std::test::assert_eq_int(count(live.checks), 0, "liveness checks nothing");
    let wire = api::Health::api_encode(live);
    std::test::assert_eq_str(std::json::find_string_field(wire, "status"), "ok", "ok on the wire");
    std::test::assert(!std::str::contains(wire, "\"store\""), "liveness names no dependency");

    // a readiness failure is the class the transport answers 503 for, and
    // quotes the health it states
    let down = api::Health { status: api::HealthStatus::unavailable, version: "x" };
    let refused = api::CtlError::NotReady(down);
    std::test::assert_eq_str(api::ctl_class(refused), "unavailable", "not ready is unavailable");
    std::test::assert_eq_int(api::ctl_status(refused), 503, "503");

    // the handlers, called as their rows are
    let r = p.readiness() or api::Health { status: api::HealthStatus::unavailable };
    let store = at(r.checks, 0) or api::Check { status: api::HealthStatus::unavailable };
    std::test::assert_eq_str(
        std::json::find_string_field(api::Health::api_encode(r), "status"),
        "ok",
        "ready",
    );
    std::test::assert(
        count(r.checks) == 1 && store.name == "store" && store.status == api::HealthStatus::ok,
        "a memory store is always ready",
    );

    // `checks` is a map of values: each check its state alone, keyed by
    // its name, on the codec's wire
    let ready_wire = api::Health::api_encode(r);
    std::test::assert_eq_str(
        std::json::find_string_field(std::json::find_field_raw(ready_wire, "checks"), "store"),
        "ok",
        "the codec writes the check's state under its name: " + ready_wire,
    );
    let back = api::Health::api_decode(
        "{\"status\": \"unavailable\", \"checks\": {\"store\": \"unavailable\", \"nats\": \"ok\"}}",
    ) or api::Health { status: api::HealthStatus::ok };
    let first = at(back.checks, 0) or api::Check { status: api::HealthStatus::ok };
    let second = at(back.checks, 1) or api::Check { status: api::HealthStatus::unavailable };
    std::test::assert(
        count(back.checks) == 2
            && first.name == "store"
            && first.status == api::HealthStatus::unavailable
            && second.name == "nats"
            && second.status == api::HealthStatus::ok,
        "and reads each back, in order",
    );
    let twice = api::Health::api_decode(
        "{\"status\": \"ok\", \"checks\": {\"store\": \"ok\", \"store\": \"ok\"}}",
    ) or api::Health { status: api::HealthStatus::unavailable, version: "refused" };
    std::test::assert_eq_str(twice.version, "refused", "a check named twice is refused");
}
