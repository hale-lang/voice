// The brain against Postgres, when VOICE_TEST_DATABASE_URL names a database
// at the current schema (`api migrate`), which this test empties first:
// the one-brain lock, the reclaim of a dead api instance, node liveness and
// the route table read from the fleet as reported.
import ".." as brain;
import "../../store" as st;
import "../../lib/pond/pq" as pq;
import "../../lib/pond/db" as db;

fn connect(url: String) -> pq::PgConn {
    let d = st::parse_dsn(url);
    return pq::PgConn { host: d.host, port: d.port, user: d.user, password: d.password, database: d.database, sslmode: d.sslmode };
}

fn run(c: pq::PgConn, sql: String) {
    let r = c.exec(sql);
    std::test::assert(r.ok, sql + ": " + r.err.detail);
}

fn one(c: pq::PgConn, sql: String) -> String {
    let r = c.query_one(sql);
    return std::str::trim(r.data);
}

fn main() {
    if !std::env::var_exists("VOICE_TEST_DATABASE_URL") { return; }
    let url = std::env::var("VOICE_TEST_DATABASE_URL");
    let c = connect(url);
    std::test::assert(c.open().ok, "the test database answers");
    run(c, "SET TIME ZONE 'UTC'");
    run(c, "TRUNCATE usage, request, budget_state, limit_state, api_instance, change, quota_window, seat_state, node_state, seat, node, \"limit\", budget, api_key, project, account, catalog_model RESTART IDENTITY CASCADE");

    // the one brain
    let other = connect(url);
    other.open();
    std::test::assert_eq_str(one(c, brain::BRAIN_LOCK), "t", "the first brain takes the lock");
    std::test::assert_eq_str(one(other, brain::BRAIN_LOCK), "f", "a second stands by");
    c.close();
    std::test::assert_eq_str(one(other, brain::BRAIN_LOCK), "t", "and takes over when the first one's connection goes");
    other.close();
    let c2 = connect(url);
    c2.open();
    run(c2, "SET TIME ZONE 'UTC'");

    // a fleet: a model, an account, a node up with its seat up
    run(c2, "INSERT INTO catalog_model (id, kind) VALUES ('echo-1', 'local'), ('idle-1', 'local')");
    run(c2, "INSERT INTO account (id, name, billing) VALUES ('static', 'Static', 'none')");
    run(c2, "INSERT INTO project (id, name, owners) VALUES ('work', 'Work', '{}')");
    run(c2, "INSERT INTO api_key (id, project, name, prefix, secret_digest) VALUES ('k_1', 'work', 'ci', 'vk-0000', '\\x00')");
    run(c2, "INSERT INTO node (id, name, token_digest, assignment_version) VALUES ('laptop', 'Laptop', '\\x00', 2)");
    run(c2, "INSERT INTO seat (node, id, engine, account, serves, concurrency, config) VALUES ('laptop', 'static', 'static', 'static', '[{\"model\": \"echo-1\", \"as\": null}]', 4, '{\"text\": \"hi\"}')");
    run(c2, "INSERT INTO node_state (node, version, capabilities, local, registered_at, last_heartbeat_at, applied_version) VALUES ('laptop', '0.1.0', '{\"max_in_flight\": 4, \"engines\": []}', '{\"paused\": false, \"paused_seats\": []}', now(), now(), 2)");
    run(c2, "INSERT INTO seat_state (node, seat, status, in_flight, reported_at) VALUES ('laptop', 'static', 'up', 0, now())");

    // two api instances, one dead with a request in flight
    run(c2, "INSERT INTO api_instance (id, last_heartbeat_at) VALUES ('api-dead', now() - interval '1 minute'), ('api-live', now())");
    run(c2, "INSERT INTO \"limit\" (scope, project, window_seconds, requests, concurrent) VALUES ('project', 'work', 60, 10, 2)");
    run(c2, "INSERT INTO limit_state (limit_id, window_start, requests, input_tokens, output_tokens, concurrent) VALUES (1, date_bin(make_interval(secs => 60), now(), 'epoch'), 1, 5, 100, 1)");
    run(c2, "INSERT INTO budget (project, allowance_micros, period, period_anchor) VALUES ('work', 1000, 'month', date_trunc('month', now()))");
    run(c2, "INSERT INTO budget_state (project, period_start, reserved_micros) VALUES ('work', date_trunc('month', now()), 40)");
    run(c2, "INSERT INTO request (id, instance, project, key, requested_model, endpoint, data_class, reserved_input, reserved_output, reserved_micros, price, limits, period_start, metadata) VALUES ('resp_1', 'api-dead', 'work', 'k_1', 'echo-1', 'responses', 'internal', 5, 100, 40, '{\"currency\": \"USD\"}', '{1}', date_trunc('month', now()), '{\"k\": \"v\"}')");

    std::test::assert_eq_int(brain::reclaim(c2), 1, "the dead instance is reclaimed");
    std::test::assert_eq_str(one(c2, "SELECT status FROM request WHERE id = 'resp_1'"), "abandoned", "its request abandoned");
    std::test::assert_eq_str(one(c2, "SELECT status || ' ' || (record->>'endpoint') || ' ' || (record->'metadata'->>'k') FROM usage WHERE id = 'resp_1'"), "abandoned responses v", "and recorded in the ledger");
    std::test::assert_eq_str(one(c2, "SELECT concurrent || ' ' || input_tokens || ' ' || output_tokens || ' ' || requests FROM limit_state"), "0 0 0 1", "its reservation released; its request still counted");
    std::test::assert_eq_str(one(c2, "SELECT reserved_micros FROM budget_state"), "0", "and its budget");
    std::test::assert_eq_str(one(c2, "SELECT string_agg(id, ',' ORDER BY id) FROM api_instance"), "api-dead,api-live", "an instance a request still names stays");
    std::test::assert_eq_str(one(c2, "SELECT (reclaimed_at IS NOT NULL)::text FROM api_instance WHERE id = 'api-dead'"), "true", "marked reclaimed");
    std::test::assert_eq_int(brain::reclaim(c2), 0, "and is not reclaimed again");
    run(c2, "INSERT INTO api_instance (id, last_heartbeat_at) VALUES ('api-gone', now() - interval '1 minute')");
    std::test::assert_eq_int(brain::reclaim(c2), 1, "a dead instance that held nothing");
    std::test::assert_eq_str(one(c2, "SELECT count(*) FROM api_instance WHERE id = 'api-gone'"), "0", "goes");

    // liveness and the route table
    run(c2, brain::LIVENESS);
    std::test::assert_eq_str(one(c2, "SELECT status FROM node WHERE id = 'laptop'"), "up", "a node heartbeating is up");
    let table = brain::read_table(c2);
    std::test::assert(std::str::contains(table, "\"seat\": \"laptop/static\""), "its seat routes: " + table);
    std::test::assert(std::str::contains(table, "\"free\": 4"), "with its free slots");
    run(c2, "INSERT INTO quota_window (account, name, used_percent, resets_at, observed_at) VALUES ('static', 'five_hour', 100, now() + interval '1 hour', now())");
    let full = brain::read_table(c2);
    std::test::assert(!std::str::contains(full, "laptop/static"), "an exhausted account's seat does not route");
    std::test::assert(std::str::contains(full, "\"account\": \"static\", \"until\": "), "the account is listed exhausted");
    run(c2, "UPDATE node_state SET last_heartbeat_at = now() - interval '1 minute'");
    run(c2, brain::LIVENESS);
    std::test::assert_eq_str(one(c2, "SELECT status FROM node WHERE id = 'laptop'"), "down", "a silent node is down");
    c2.close();
}
