// The node's readings (main.hl, `readings`): what its habitat's senses
// scrape from another machine, on voice's fixed port, 9476. The runtime
// serves its own series there (memory, restarts, failures, pools); the
// session adds its seats', in the registry it holds (session.hl,
// `read_out`). Every label is a seat's id or its engine's, which the
// operator configures and of which a node holds at most 16.

/// A seat as it was read out: its labels.
type ReadSeat { id: String = ""; engine: String = ""; }

/// The seats last read out: a record, assigned whole.
type SeatIds { items: bounded[ReadSeat; 16]; }

/// True when `seat`'s labels, its id and its engine both, are still read
/// out: a seat whose engine changed is a new series, and the old one is
/// retired as a withdrawn seat's is.
fn still_read(ids: SeatIds, seat: ReadSeat) -> Bool {
    for x in ids.items {
        if x.id == seat.id && x.engine == seat.engine { return true; }
    }
    return false;
}

/// One seat reading, set to `value`.
fn seat_reading(reg: std::metrics::Registry, name: String, labels: std::metrics::Labels, value: Int) {
    std::metrics::gauge(reg, name, labels).set(std::math::int_to_float(value));
}
