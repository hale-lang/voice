/// The voice api. Every endpoint in ../spec/openapi.yaml is routed: the
/// ones with a row in the surface (surface.hl) by their handlers, over the
/// configuration store (store.hl); the rest answer their happy path with a
/// canned body from `canned/`, named by the endpoint's operationId, until
/// each is made real. See endpoints.hl.
locus Api {
    params {
        host: String = "127.0.0.1";
        port: Int = 8080;
        canned: String = "canned";
        nats: String = "nats://127.0.0.1:4222";
        node_nats: String = "";
        ui: String = "";
    }
    run() { serve(self.host, self.port, self.canned, self.nats, self.node_nats, self.ui); }
}

fn serve(host: String, port: Int, canned: String, nats: String, node_nats: String, ui: String) {
    println("voice api on http://", host, ":", port, "; configuration in memory (lost on restart); canned bodies from ", canned);
    println("voice api: nodes over NATS at ", nats, if len(node_nats) > 0 { " (" + node_nats + " from the nodes' side)" } else { "" });
    if len(ui) > 0 { println("voice api: serving the admin ui from ", ui); }
    let endpoints = Endpoints { canned: canned, ui: ui, link: NatsLink { url: nats, node_url: node_nats } };
    std::http::Server { host: host, port: port, handler: endpoints };
}

/// `api [--host H] [--port N] [--canned DIR] [--nats URL] [--node-nats URL]
/// [--ui DIR]`. The canned directory defaults to `canned` beside the
/// binary; with no `--ui` the app is not served. `--node-nats` is where
/// the nodes find NATS, when that differs from where the api does.
fn main() {
    let mut host = "127.0.0.1";
    let mut port = 8080;
    let mut canned = beside_binary("canned");
    let mut nats = "nats://127.0.0.1:4222";
    let mut node_nats = "";
    let mut ui = "";
    let mut i = 1;
    while i + 1 < std::env::args_count() {
        let flag = std::env::arg(i);
        let value = std::env::arg(i + 1);
        if flag == "--host" {
            host = value;
        } else if flag == "--port" {
            port = std::str::parse_int(value) or port;
        } else if flag == "--canned" {
            canned = value;
        } else if flag == "--nats" {
            nats = value;
        } else if flag == "--node-nats" {
            node_nats = value;
        } else if flag == "--ui" {
            ui = value;
        }
        i = i + 2;
    }
    Api { host: host, port: port, canned: canned, nats: nats, node_nats: node_nats, ui: ui };
}

/// `name` in the directory holding the running binary, or `name` as given
/// when the binary was started without a directory in its path.
fn beside_binary(name: String) -> String {
    let mut dir = "";
    let mut rest = std::env::arg(0);
    let mut at = std::str::index_of(rest, "/");
    while at >= 0 {
        dir = dir + rest[0..(at + 1)];
        rest = rest[(at + 1)..len(rest)];
        at = std::str::index_of(rest, "/");
    }
    return dir + name;
}
