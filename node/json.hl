/// A top-level member's raw value in a JSON object, or "" when absent.
fn top_value(json: String, key: String) -> String {
    let mut it = std::json::object_first(json);
    while !it.done {
        if std::json::obj_key_string(it, json) == key { return std::json::obj_value_raw(it, json); }
        it = std::json::object_next(it, json);
    }
    return "";
}

/// `base` with `patch`'s top-level members laid over it: a member in both
/// takes `patch`'s value, and new members are added. Nested objects are
/// replaced, not merged.
fn merge_objects(base: String, patch: String) -> String {
    let mut out = "{";
    let mut first = true;
    let mut it = std::json::object_first(base);
    while !it.done {
        let key = std::json::obj_key_string(it, base);
        let over = top_value(patch, key);
        let value = if len(over) > 0 { over } else { std::json::obj_value_raw(it, base) };
        if !first { out = out + ", "; }
        out = out + "\"" + std::json::escape_string(key) + "\": " + value;
        first = false;
        it = std::json::object_next(it, base);
    }
    let mut pt = std::json::object_first(patch);
    while !pt.done {
        let key = std::json::obj_key_string(pt, patch);
        if len(top_value(base, key)) == 0 {
            if !first { out = out + ", "; }
            out = out + "\"" + std::json::escape_string(key) + "\": " + std::json::obj_value_raw(pt, patch);
            first = false;
        }
        pt = std::json::object_next(pt, patch);
    }
    return out + "}";
}

fn json_response(status: Int, body: String) -> std::http::Response {
    return std::http::Response { status: status, content_type: "application/json", body: body };
}

fn error_response(status: Int, kind: String, code: String, message: String) -> std::http::Response {
    return json_response(status, "{\"error\": {\"message\": \"" + std::json::escape_string(message) + "\", \"type\": \"" + kind + "\", \"code\": \"" + code + "\"}}");
}
