// A tool's output that read a binary file carries JSON a model cannot take
// (a NUL, half a surrogate pair): the body is taken, those as U+FFFD, the
// rest as it was.
import ".." as api;

fn main() {
    std::test::assert_eq_str(
        api::model_text("{\"a\": \"hi\"}"),
        "{\"a\": \"hi\"}",
        "a body with none is as it was",
    );
    std::test::assert_eq_str(
        api::model_text("{\"a\": \"x\\u0000y\"}"),
        "{\"a\": \"x\\ufffdy\"}",
        "a NUL",
    );
    std::test::assert_eq_str(
        api::model_text("{\"a\": \"x\\ud800y\"}"),
        "{\"a\": \"x\\ufffdy\"}",
        "a high half alone",
    );
    std::test::assert_eq_str(
        api::model_text("{\"a\": \"x\\uDC00y\"}"),
        "{\"a\": \"x\\ufffdy\"}",
        "a low half alone",
    );
    std::test::assert_eq_str(
        api::model_text("{\"a\": \"\\ud800\\u0041\"}"),
        "{\"a\": \"\\ufffd\\u0041\"}",
        "a high half before another character",
    );
    std::test::assert_eq_str(
        api::model_text("{\"a\": \"\\ud83d\\ude00 \\u0000\"}"),
        "{\"a\": \"\\ud83d\\ude00 \\ufffd\"}",
        "a whole pair is kept",
    );
    std::test::assert_eq_str(
        api::model_text("{\"a\": \"\\\\u0000 is how you write it\"}"),
        "{\"a\": \"\\\\u0000 is how you write it\"}",
        "an escaped backslash before u0000 is text, not an escape",
    );
    std::test::assert_eq_str(
        api::model_text("{\"a\": \"\\u001b[31m\"}"),
        "{\"a\": \"\\u001b[31m\"}",
        "other escapes stay",
    );
    // a Responses request whose tool output read a binary file
    let body = "{\"model\": \"coder\", \"input\": [{\"type\": \"function_call_output\", \"call_id\": \"c1\", \"output\": \"\\u00cf\\u00fa\\u00ed\\u00fe\\u0007\\u0000\\u0000\\u0001\\ud800\"}]}";
    let r = api::read_inference(body, "responses") or api::InferenceRequest { model: "refused" };
    std::test::assert_eq_str(r.model, "coder", "is taken");
    std::test::assert(
        std::json::valid_object(r.body),
        "and what reaches the seat is JSON its reader takes",
    );
}
