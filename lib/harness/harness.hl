// A CLI recipe (../../harnesses/, spec/openapi.yaml `HarnessDefinition`): an
// agentic coding CLI as data. The api keeps them in its store, voice's own
// read from its files at start and the operator's made on the admin plane,
// and refuses one these rules refuse; it hands the one a seat runs to the
// node with each attempt, and the node holds it to the same rules before it
// runs anything. The node's wrapper is the same for every recipe
// (node/attempt.hl); only this changes from one to the next.
//
// The rules a recipe is held to:
//   - its backends, in order, are where the CLI may run: `container`, a
//     base image pinned by digest (`<name>@sha256:<64 hex>`) and the one
//     shell command that installs the CLI on it, pinned to a version where
//     the vendor publishes one; or `host`, the node's own machine, where an
//     argv prints the CLI's version (`detect`), read by a pattern whose
//     first group must be the recipe's pinned `version`, and an argv may
//     install that version into voice's own prefix (`install`), never
//     system-wide and never as another user (a check of the plain argv,
//     best effort: the prefix is the contract). A recipe with the older
//     `image` is one container backend;
//   - its command is a list of plain arguments: none empty, none holding a
//     newline, and none a flag that skips the CLI's own permissions
//     (`BYPASS`), which voice never passes (DIRECTION.md, "No bypass flags");
//   - the instruction goes in on stdin, as the last argument, or in a file
//     of /voice, which voice mounts read-only (the CLI's machine output it
//     writes to a file goes in /voice/out, which voice reads after the run);
//   - a model is named by a flag or an environment variable;
//   - the login reaches a run only through its environment (`env`, from a
//     vault entry; `voice`, a key voice mints for each attempt) or a
//     per-login directory (`home`), never its argv;
//   - its output is read by a reader voice knows (`READERS`);
//   - its egress is a list of host names (a leading dot: any under it);
//   - its model calls go to voice (`base_url_env`) exactly when its login
//     is voice's own key (`voice`), and speak a wire voice serves
//     (`PROTOCOLS`): the node hands it voice's address in that variable,
//     and lets the attempt reach exactly that host and port.
//
// Paths in a recipe are the container's (/work, /voice, /home/voice): a host
// run is handed the attempt's own directories in their place (node/attempt.hl).

/// The readers voice has for a harness's output.
const READERS: String = "text claude-stream-json codex-jsonl agy-stream-json vibe-streaming";

/// The wires voice serves a harness's model calls on, each at the api's
/// `/v1`: `openai-chat` (`/v1/chat/completions`) and `openai-responses`
/// (`/v1/responses`).
const PROTOCOLS: String = "openai-chat\nopenai-responses\n";

/// Flags and values that skip a CLI's own permissions. A definition whose
/// command holds one is refused, whatever the CLI.
const BYPASS: String = "--dangerously-skip-permissions\n--dangerously-bypass-approvals-and-sandbox\n--yolo\n--auto-approve\nauto-approve\nbypassPermissions\ndanger-full-access\n--allow-dangerously-skip-permissions\n";

/// The most backends a recipe lists.
const BACKENDS_MAX: Int = 4;

/// The variable a host backend's install is handed voice's prefix for the
/// recipe's version in (`<data>/clis/<recipe>/<version>`), and which voice
/// itself puts in its argv and environment where they name it, as
/// `$VOICE_CLI_PREFIX` or `${VOICE_CLI_PREFIX}` (no shell runs them).
const PREFIX_VAR: String = "VOICE_CLI_PREFIX";

/// Programs a host backend's detect or install never runs: a shell (its
/// argv runs as it is, with no shell), or one that takes another user's
/// privileges.
const HOST_SHELLS: String = "sh\nbash\nzsh\ndash\nksh\nmksh\nfish\ncsh\ntcsh\n";
const HOST_PRIVILEGED: String = "sudo\nsu\ndoas\npkexec\nrun0\n";

/// An installer's flags that write outside the prefix it is given.
const OUTSIDE_FLAGS: String = "--user\n--system\n--break-system-packages\n";

/// Variables a host install's own environment does not set: voice sets them.
const INSTALL_ENV_KEPT: String = "PATH\nHOME\nVOICE_CLI_PREFIX\n";

/// One place a recipe's CLI may run (`backends`).
type HarnessBackend {
    // container | host
    kind: String = "container";
    // container: the base image, pinned by digest, and the one shell
    // command that installs the CLI on it
    base: String = "";
    install: String = "";
    // host: the argv that prints the CLI's version, one argument a line,
    // and the pattern its version is read with; the argv that installs the
    // pinned version into voice's prefix ("" for none: detect only), and
    // the variables it runs with, `NAME=value` lines
    detect: String = "";
    detect_version: String = "";
    install_argv: String = "";
    install_env: String = "";
}

/// A recipe, read. Lists are one item a line; `env` is `NAME=value` lines.
type HarnessDef {
    id: String = "";
    name: String = "";
    version: String = "";
    // where it may run, in the recipe's order
    backends: bounded[HarnessBackend; 4];
    command: String = "";
    // stdin | argument | file
    via: String = "stdin";
    instruction_path: String = "";
    // files voice writes in /voice for the run, a JSON list of
    // `{"path", "text"}` ("" for none)
    files: String = "";
    model_flag: String = "";
    model_env: String = "";
    // env | home | voice
    login_kind: String = "env";
    login_env: String = "";
    login_mount: String = "";
    login_from: String = "";
    login_files: String = "";
    env: String = "";
    reader: String = "text";
    usage_file: String = "";
    commits: Bool = false;
    // the CLI sandboxes its own commands with user namespaces (bubblewrap),
    // which docker's default seccomp profile refuses a container
    nested_sandbox: Bool = false;
    preamble: String = "";
    egress: String = "";
    idle_seconds: Int = 1800;
    // the variable the node puts voice's base URL in, "" when the CLI's
    // model calls go to its vendor; and the wire they speak
    base_url_env: String = "";
    protocol: String = "";
}

/// Why a recipe is refused, and the field of it at fault (`login.env`,
/// `backends[1].detect.version`); "" for both when it is not.
type RecipeProblem { why: String = ""; field: String = ""; }

/// A JSON string member, "" when it is not one.
fn text_of(json: String, name: String) -> String {
    let f = std::json::string_field(json, name);
    return if f.kind == "string" { f.text } else { "" };
}

/// The strings of a JSON list, one a line; "!" first when it is not a list
/// of strings, or one of them is empty or holds a newline.
@bounded_by(raw)
fn lines_of(raw: String) -> String {
    let list = std::str::trim(raw);
    if !std::str::starts_with(list, "[") { return "!"; }
    let out = std::bytes::BytesBuilder { initial_cap: 256 };
    let mut it = std::json::array_first(list);
    while !it.done {
        let e = std::str::trim(it.element);
        if !std::str::starts_with(e, "\"") { return "!"; }
        let s = std::json::unescape_string(e[1..(len(e) - 1)]);
        if len(s) == 0 || std::str::contains(s, "\n") { return "!"; }
        out.append_str(s + "\n");
        it = std::json::array_next(it);
    }
    let b = out.snapshot() or b"";
    return std::str::from_bytes(b);
}

/// ^[a-z0-9][a-z0-9-]{0,62}$
fn slug(s: String) -> Bool {
    let v = std::str::bytes_view(s);
    let n = len(s);
    if n == 0 || n > 63 { return false; }
    let mut i = 0;
    while i < n {
        let b = std::str::byte_at(v, i);
        let ok = (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || (b == 45 && i > 0);
        if !ok { return false; }
        i = i + 1;
    }
    return true;
}

/// An environment variable's name: ^[A-Z_][A-Z0-9_]*$, at most 64.
fn env_name(s: String) -> Bool {
    let v = std::str::bytes_view(s);
    let n = len(s);
    if n == 0 || n > 64 { return false; }
    let mut i = 0;
    while i < n {
        let b = std::str::byte_at(v, i);
        let ok = (b >= 65 && b <= 90) || b == 95 || (b >= 48 && b <= 57 && i > 0);
        if !ok { return false; }
        i = i + 1;
    }
    return true;
}

/// An absolute path in the container, of plain parts: no `..`, no space.
fn container_path(s: String) -> Bool {
    if !std::str::starts_with(s, "/") || len(s) > 200 { return false; }
    if std::str::contains(s, "..") || std::str::contains(s, " ") || std::str::contains(s, "\n") {
        return false;
    }
    return !std::str::contains(s, ":") && !std::str::contains(s, ",");
}

/// A file directly in `dir` (which ends in `/`), of a plain name.
fn in_dir(path: String, dir: String) -> Bool {
    if !std::str::starts_with(path, dir) || !container_path(path) { return false; }
    let name = path[len(dir)..len(path)];
    return len(name) > 0 && !std::str::contains(name, "/");
}

/// A host name, or `.` and a domain for any under it: letters, digits,
/// dots and dashes.
fn host_pattern(s: String) -> Bool {
    let v = std::str::bytes_view(s);
    let n = len(s);
    if n == 0 || n > 253 { return false; }
    let mut i = 0;
    while i < n {
        let b = std::str::byte_at(v, i);
        let ok = (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45 || b == 46;
        if !ok { return false; }
        i = i + 1;
    }
    return std::str::contains(s, ".") && !std::str::ends_with(s, ".");
}

/// An image pinned by its digest: `<name>@sha256:<64 lowercase hex>`.
fn pinned_image(s: String) -> Bool {
    let at = std::str::index_of(s, "@sha256:");
    if at < 1 || len(s) != at + 8 + 64 { return false; }
    let v = std::str::bytes_view(s);
    let mut i = at + 8;
    while i < len(s) {
        let b = std::str::byte_at(v, i);
        if !((b >= 48 && b <= 57) || (b >= 97 && b <= 102)) { return false; }
        i = i + 1;
    }
    return !std::str::contains(s, " ") && !std::str::contains(s, "\n");
}

/// True when `word` is one of `list`'s lines.
@bounded_by(list)
fn listed(list: String, word: String) -> Bool {
    return std::str::starts_with(list, word + "\n") || std::str::contains(list, "\n" + word + "\n");
}

/// The first of `lines` (one a line) that skips a CLI's permissions, ""
/// for none: a bypass flag, or a value naming one.
@bounded_by(lines)
fn bypass_in(lines: String) -> String {
    let mut rest = lines;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let a = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let flag = if std::str::index_of(a, "=") > 0 {
            a[0..std::str::index_of(a, "=")]
        } else {
            a
        };
        if listed(BYPASS, flag) || listed(BYPASS, a) { return a; }
        if std::str::contains(a, "bypass_tool_permissions")
            || std::str::contains(a, "bypassPermissions")
        {
            return a;
        }
    }
    return "";
}

/// The last part of a path: what a program named by it is.
@bounded_by(a)
fn base_name(a: String) -> String {
    let v = std::str::bytes_view(a);
    let mut from = 0;
    let mut i = 0;
    while i < v.n {
        if std::str::byte_at(v, i) == 47 { from = i + 1; }
        i = i + 1;
    }
    return std::str::slice(v, from, v.n);
}

/// A refusal of the recipe's `field`, saying `why`.
fn refused(field: String, why: String) -> RecipeProblem {
    return RecipeProblem { why: why, field: field };
}

/// True when `s` names voice's prefix, as `$VOICE_CLI_PREFIX` or
/// `${VOICE_CLI_PREFIX}`.
fn names_prefix(s: String) -> Bool {
    return std::str::contains(s, "$" + PREFIX_VAR)
        || std::str::contains(s, "${" + PREFIX_VAR + "}");
}

/// `s` with voice's prefix put where it names it.
fn with_prefix(s: String, prefix: String) -> String {
    return std::str::replace(
        std::str::replace(s, "${" + PREFIX_VAR + "}", prefix),
        "$" + PREFIX_VAR,
        prefix,
    );
}

/// Why argument (or variable's value) `a` of an install writes outside
/// voice's prefix, as far as its text says; "" when it says nothing of the
/// kind. Best effort: a program may write where its argv does not say, so
/// the prefix it is handed is the contract.
fn outside_problem(a: String) -> String {
    let eq = std::str::index_of(a, "=");
    let flag = if eq > 0 { a[0..eq] } else { a };
    if listed(OUTSIDE_FLAGS, flag) {
        return "it writes outside voice's prefix (" + a
            + "): an install writes under $VOICE_CLI_PREFIX alone";
    }
    let value = if eq >= 0 { a[(eq + 1)..len(a)] } else { a };
    if std::str::starts_with(a, "/") || std::str::starts_with(a, "~")
        || std::str::starts_with(value, "/") || std::str::starts_with(value, "~")
    {
        return "it names a path outside voice's prefix (" + a
            + "): an install writes under $VOICE_CLI_PREFIX alone";
    }
    if std::str::contains(a, "..") {
        return "it names a path out of voice's prefix (" + a + ")";
    }
    return "";
}

/// Why a host backend's argv `lines` (one argument a line) is not one
/// voice runs, "" when it is: it runs no shell and takes no other user's
/// privileges, and an install's arguments name no path outside voice's
/// prefix.
@bounded_by(lines)
fn host_argv_problem(lines: String, install: Bool) -> String {
    let mut rest = lines;
    let mut i = 0;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let a = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let base = base_name(a);
        if listed(HOST_SHELLS, base) {
            return "it runs " + a + ": a host backend's argv runs as it is, with no shell";
        }
        if listed(HOST_PRIVILEGED, base) {
            return "it runs " + a
                + ": a host backend runs as the node's user, never with another user's privileges";
        }
        if install && i > 0 {
            let p = outside_problem(a);
            if len(p) > 0 { return p; }
        }
        i = i + 1;
    }
    return "";
}

/// Where a version pattern's first group opens and closes, at its top
/// level (in no other group or character class); whether it holds a `|`
/// at its top level; and why it is not a pattern voice reads, "" when it is.
type GroupSpan { open: Int = -1; close: Int = -1; alternation: Bool = false; problem: String = ""; }

/// `pattern`'s first group and how it is built.
@bounded_by(pattern)
fn group_span(pattern: String) -> GroupSpan {
    let v = std::str::bytes_view(pattern);
    let mut g = GroupSpan { };
    let mut depth = 0;
    let mut class = false;
    let mut i = 0;
    while i < v.n {
        let c = std::str::byte_at(v, i);
        if c == 92 {
            let x = std::str::byte_at(v, i + 1);
            if x < 0 { return GroupSpan { problem: "it ends in a `\\`" }; }
            let letter = (x >= 65 && x <= 90) || (x >= 97 && x <= 122) || (x >= 48 && x <= 57);
            if letter && x != 100 && x != 119 && x != 115 {
                return GroupSpan {
                    problem: "`\\" + std::str::slice(v, i + 1, i + 2)
                        + "` is not an escape voice reads (`\\d`, `\\w`, `\\s`, or a punctuation mark's)",
                };
            }
            i = i + 2;
            continue;
        }
        if class {
            if c == 93 { class = false; }
        } else if c == 91 {
            class = true;
        } else if c == 40 {
            depth = depth + 1;
            if depth == 1 && g.open < 0 { g.open = i; }
        } else if c == 41 {
            if depth == 0 { return GroupSpan { problem: "a `)` closes no group" }; }
            depth = depth - 1;
            if depth == 0 && g.open >= 0 && g.close < 0 { g.close = i; }
        } else if c == 124 && depth == 0 {
            g.alternation = true;
        }
        i = i + 1;
    }
    if depth != 0 { return GroupSpan { problem: "a group is not closed" }; }
    if class { return GroupSpan { problem: "a character class is not closed" }; }
    return g;
}

/// `pattern` as std::regex reads it: each escape a character class (a
/// punctuation mark's escape a class of it alone; `\d`, `\w`, `\s` their
/// classes), so the escapes a pattern is written with read as they mean.
@bounded_by(pattern)
fn std_pattern(pattern: String) -> String {
    let v = std::str::bytes_view(pattern);
    let out = std::bytes::BytesBuilder { initial_cap: 64 };
    let mut class = false;
    let mut i = 0;
    while i < v.n {
        let c = std::str::byte_at(v, i);
        if c == 92 && i + 1 < v.n {
            let x = std::str::slice(v, i + 1, i + 2);
            let named = if x == "d" {
                "0-9"
            } else if x == "w" {
                "A-Za-z0-9_"
            } else if x == "s" {
                " \t"
            } else {
                ""
            };
            if class {
                out.append_str(if len(named) > 0 { named } else { "\\" + x });
            } else {
                out.append_str("[" + (if len(named) > 0 { named } else { "\\" + x }) + "]");
            }
            i = i + 2;
            continue;
        }
        if class && c == 93 { class = false; } else if !class && c == 91 { class = true; }
        out.append_str(std::str::slice(v, i, i + 1));
        i = i + 1;
    }
    let b = out.snapshot() or b"";
    return std::str::from_bytes(b);
}

/// True when `text` is matched whole by `pattern` (std::regex's form): an
/// empty pattern matches only an empty text.
fn whole(pattern: String, text: String) -> Bool {
    if len(pattern) == 0 { return len(text) == 0; }
    return std::regex::matches(pattern, text);
}

/// Why `pattern` is not a host backend's version pattern for a CLI pinned
/// at `version`, "" when it is: one line, holding a group at its top level
/// (the first such is the version), no `|` outside a group, and a first
/// group that can read `version`.
@bounded_by(pattern)
fn version_pattern_problem(pattern: String, version: String) -> String {
    if len(pattern) == 0 || len(pattern) > 256 || std::str::contains(pattern, "\n") {
        return "detect's version is a pattern of one line, matched against a line of what detect prints";
    }
    let g = group_span(pattern);
    if len(g.problem) > 0 { return "detect's version is not a pattern voice reads: " + g.problem; }
    if g.open < 0 || g.close < 0 {
        return "detect's version pattern holds a group, `(...)`, which reads the version";
    }
    if g.alternation {
        return "detect's version pattern has no `|` outside a group, so its first group is the version wherever it matches";
    }
    let pre = std_pattern(pattern[0..g.open]);
    let grp = std_pattern(pattern[(g.open + 1)..g.close]);
    let suf = std_pattern(pattern[(g.close + 1)..len(pattern)]);
    if (len(pre) > 0 && !std::regex::valid(pre)) || !std::regex::valid(grp)
        || (len(suf) > 0 && !std::regex::valid(suf))
    {
        return "detect's version is not a pattern voice reads";
    }
    if !whole(grp, version) {
        return "detect's version pattern's first group cannot read the pinned version, "
            + version;
    }
    return "";
}

/// True when a line of `output` (what detect printed) is matched whole by
/// `pattern` with its first group exactly `version`: the CLI found is the
/// version the recipe pins. `pattern` is one `version_pattern_problem`
/// passed.
@unbounded
fn version_detected(pattern: String, version: String, output: String) -> Bool {
    if len(version) == 0 { return false; }
    let g = group_span(pattern);
    if len(g.problem) > 0 || g.open < 0 || g.close < 0 || g.alternation { return false; }
    let pre = std_pattern(pattern[0..g.open]);
    let grp = std_pattern(pattern[(g.open + 1)..g.close]);
    let suf = std_pattern(pattern[(g.close + 1)..len(pattern)]);
    if !whole(grp, version) { return false; }
    let mut rest = output;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = std::str::trim(if nl < 0 { rest } else { rest[0..nl] });
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        let mut at = std::str::index_of(line, version);
        while at >= 0 {
            if whole(pre, line[0..at]) && whole(suf, line[(at + len(version))..len(line)]) {
                return true;
            }
            at = std::str::index_of_from(line, version, at + 1);
        }
    }
    return false;
}

/// Why a container backend `b` (at `at` in the recipe) is not one voice
/// builds, as a refusal.
fn container_problem(b: String, at: String) -> RecipeProblem {
    if !pinned_image(text_of(b, "base")) {
        return refused(
            at + ".base",
            "a container's base is an image pinned by digest (`<image>@sha256:<64 hex>`)",
        );
    }
    let install = text_of(b, "install");
    if len(install) == 0 || std::str::contains(install, "\n") {
        return refused(at + ".install", "a container's install is one shell command");
    }
    return RecipeProblem { };
}

/// Why a host backend `b` (at `at` in the recipe, whose CLI is pinned at
/// `version`) is not one voice runs, as a refusal.
@unbounded
fn host_problem(b: String, at: String, version: String) -> RecipeProblem {
    let detect = std::str::trim(std::json::find_field_raw(b, "detect"));
    if !std::json::valid_object(detect) {
        return refused(
            at + ".detect",
            "a host backend detects its CLI: `{\"command\": [...], \"version\": \"<pattern>\"}`",
        );
    }
    let argv = lines_of(std::json::find_field_raw(detect, "command"));
    if std::str::starts_with(argv, "!") || len(argv) == 0 {
        return refused(
            at + ".detect.command",
            "a host backend's detect is a list of plain arguments, none empty and none holding a newline, that prints the CLI's version",
        );
    }
    let da = host_argv_problem(argv, false);
    if len(da) > 0 { return refused(at + ".detect.command", da); }
    if len(version) == 0 {
        return refused(
            "version",
            "a recipe with a host backend pins its CLI's `version`, which detect must find",
        );
    }
    let vp = version_pattern_problem(text_of(detect, "version"), version);
    if len(vp) > 0 { return refused(at + ".detect.version", vp); }
    let install = std::str::trim(std::json::find_field_raw(b, "install"));
    if len(install) == 0 || install == "null" { return RecipeProblem { }; }
    if !std::json::valid_object(install) {
        return refused(
            at + ".install",
            "a host backend's install is an object, `{\"command\": [...]}`, or left out to detect alone",
        );
    }
    let iargv = lines_of(std::json::find_field_raw(install, "command"));
    if std::str::starts_with(iargv, "!") || len(iargv) == 0 {
        return refused(
            at + ".install.command",
            "a host backend's install is a list of plain arguments, none empty and none holding a newline",
        );
    }
    let ia = host_argv_problem(iargv, true);
    if len(ia) > 0 { return refused(at + ".install.command", ia); }
    let mut named = names_prefix(iargv);
    let env = std::str::trim(std::json::find_field_raw(install, "env"));
    if len(env) > 0 && env != "null" {
        if !std::json::valid_object(env) {
            return refused(at + ".install.env", "an install's env is an object of strings");
        }
        let mut it = std::json::object_first(env);
        while !it.done {
            let key = std::json::obj_key_string(it, env);
            let v = std::str::trim(std::json::obj_value_raw(it, env));
            if !env_name(key) || !std::str::starts_with(v, "\"") {
                return refused(
                    at + ".install.env",
                    "an install's env is an object of strings, each named as a variable is",
                );
            }
            if listed(INSTALL_ENV_KEPT, key) {
                return refused(
                    at + ".install.env." + key,
                    key + " is voice's to set for an install",
                );
            }
            let s = std::json::obj_value_string(it, env);
            if std::str::contains(s, "\n") {
                return refused(at + ".install.env." + key, "a variable's value is one line");
            }
            let op = outside_problem(s);
            if len(op) > 0 { return refused(at + ".install.env." + key, op); }
            if names_prefix(s) { named = true; }
            it = std::json::object_next(it, env);
        }
    }
    if !named {
        return refused(
            at + ".install.command",
            "an install puts the CLI in voice's prefix, which it names as $VOICE_CLI_PREFIX: never system-wide",
        );
    }
    return RecipeProblem { };
}

/// The most files a recipe has voice write for a run, and the most text
/// in one.
const FILES_MAX: Int = 8;
const FILE_BYTES_MAX: Int = 65536;

/// The files of /voice voice writes itself, which a recipe's files are not.
const VOICE_OWN_FILES: String = "/voice/instruction.md\n/voice/message\n";

/// Why recipe `json`'s `files` are not ones voice writes for a run, as a
/// refusal: at most `FILES_MAX`, each a file directly in /voice (read-only
/// to the CLI, beside its instruction) and of at most `FILE_BYTES_MAX`.
@unbounded
fn files_problem(json: String) -> RecipeProblem {
    let raw = std::str::trim(std::json::find_field_raw(json, "files"));
    if len(raw) == 0 || raw == "null" { return RecipeProblem { }; }
    if !std::str::starts_with(raw, "[") {
        return refused("files", "its files are a list of `{\"path\", \"text\"}`");
    }
    let mut it = std::json::array_first(raw);
    let mut i = 0;
    let mut paths = "";
    while !it.done {
        let e = std::str::trim(it.element);
        let at = "files[" + to_string(i) + "]";
        if i >= FILES_MAX {
            return refused(
                "files",
                "a recipe has voice write at most " + to_string(FILES_MAX) + " files",
            );
        }
        let path = text_of(e, "path");
        if !in_dir(path, "/voice/") || listed(VOICE_OWN_FILES, path) || listed(paths, path) {
            return refused(
                at + ".path",
                "a file voice writes for the run is a file of /voice, read-only to the CLI, of a name its instruction does not have",
            );
        }
        let text = std::json::string_field(e, "text");
        if text.kind != "string" || len(text.text) > FILE_BYTES_MAX {
            return refused(at + ".text", "a file's text is a string of at most 64 KiB");
        }
        paths = paths + path + "\n";
        i = i + 1;
        it = std::json::array_next(it);
    }
    return RecipeProblem { };
}

/// Recipe `json`'s `files`, as its JSON list; "" for none.
fn files_of(json: String) -> String {
    let raw = std::str::trim(std::json::find_field_raw(json, "files"));
    return if std::str::starts_with(raw, "[") { raw } else { "" };
}

/// Why the backends of recipe `json` (its CLI pinned at `version`) are not
/// ones voice runs, as a refusal: a list of at most `BACKENDS_MAX`, or the
/// older `image`, which is one container backend.
@unbounded
fn backends_problem(json: String, version: String) -> RecipeProblem {
    let raw = std::str::trim(std::json::find_field_raw(json, "backends"));
    let image = std::str::trim(std::json::find_field_raw(json, "image"));
    let has_image = len(image) > 0 && image != "null";
    let has_backends = len(raw) > 0 && raw != "null";
    if has_image && has_backends {
        return refused("image", "a recipe lists its `backends`, or the older `image`, not both");
    }
    if has_image {
        if !std::json::valid_object(image) {
            return refused("image", "its image is an object, `{\"base\": ..., \"install\": ...}`");
        }
        return container_problem(image, "image");
    }
    if !has_backends {
        return refused(
            "backends",
            "a recipe lists where its CLI runs (`backends`): in a container, on the host, or either",
        );
    }
    if !std::str::starts_with(raw, "[") { return refused("backends", "its backends are a list"); }
    let mut it = std::json::array_first(raw);
    let mut i = 0;
    while !it.done {
        let e = std::str::trim(it.element);
        let at = "backends[" + to_string(i) + "]";
        if i >= BACKENDS_MAX {
            return refused(
                "backends",
                "a recipe lists at most " + to_string(BACKENDS_MAX) + " backends",
            );
        }
        if !std::json::valid_object(e) { return refused(at, "a backend is an object"); }
        let kind = text_of(e, "kind");
        if kind == "container" {
            let p = container_problem(e, at);
            if len(p.why) > 0 { return p; }
        } else if kind == "host" {
            let p = host_problem(e, at, version);
            if len(p.why) > 0 { return p; }
        } else {
            return refused(
                at + ".kind",
                "a backend is `container` (an image voice builds and runs it in) or `host` (the node's own machine)",
            );
        }
        i = i + 1;
        it = std::json::array_next(it);
    }
    if i == 0 { return refused("backends", "a recipe lists at least one backend"); }
    return RecipeProblem { };
}

/// Why `json` is not a recipe voice runs, "" when it is.
@unbounded
fn harness_problem(json: String) -> String {
    return recipe_problem(json).why;
}

/// Why `json` is not a recipe voice runs, and the field of it at fault;
/// none when it is one.
@unbounded
fn recipe_problem(json: String) -> RecipeProblem {
    if !std::json::valid_object(json) { return refused("", "a recipe is a JSON object"); }
    if !slug(text_of(json, "id")) {
        return refused(
            "id",
            "its id is a slug: lowercase letters, digits and dashes, starting with a letter or digit, at most 63",
        );
    }
    if len(text_of(json, "name")) == 0 { return refused("name", "it names the CLI (`name`)"); }
    let version = text_of(json, "version");
    if len(version) > 64 || std::str::contains(version, "\n") || std::str::contains(version, " ") {
        return refused("version", "its version is the CLI's, one word of at most 64 bytes");
    }
    let backends = backends_problem(json, version);
    if len(backends.why) > 0 { return backends; }
    let command = lines_of(std::json::find_field_raw(json, "command"));
    if std::str::starts_with(command, "!") || len(command) == 0 {
        return refused(
            "command",
            "its command is a list of plain arguments, none empty and none holding a newline",
        );
    }
    let bypass = bypass_in(command);
    if len(bypass) > 0 {
        return refused(
            "command",
            "its command skips the CLI's permissions (" + bypass
                + "): voice never passes a bypass flag",
        );
    }
    let instruction = std::json::find_field_raw(json, "instruction");
    let via = text_of(instruction, "via");
    if via != "stdin" && via != "argument" && via != "file" {
        return refused(
            "instruction.via",
            "its instruction goes in on stdin, as an argument, or in a file",
        );
    }
    if via == "file" && !in_dir(text_of(instruction, "path"), "/voice/") {
        return refused(
            "instruction.path",
            "an instruction in a file is a file of /voice, which voice mounts read-only",
        );
    }
    let files = files_problem(json);
    if len(files.why) > 0 { return files; }
    let model = std::json::find_field_raw(json, "model");
    let flag = text_of(model, "flag");
    let menv = text_of(model, "env");
    if (len(flag) == 0) == (len(menv) == 0) {
        return refused(
            "model",
            "a model is named by a flag or by an environment variable, one of them",
        );
    }
    if len(flag) > 0 && !std::str::starts_with(flag, "-") {
        return refused("model.flag", "the model's flag is a flag");
    }
    if len(menv) > 0 && !env_name(menv) {
        return refused("model.env", "the model's variable is a variable's name");
    }
    let login = std::json::find_field_raw(json, "login");
    let kind = text_of(login, "kind");
    if kind == "env" {
        if !env_name(text_of(login, "env")) {
            return refused(
                "login.env",
                "a login from the vault names the variable it is handed in",
            );
        }
    } else if kind == "home" {
        if !container_path(text_of(login, "mount")) {
            return refused(
                "login.mount",
                "a login directory names where it is mounted in the container",
            );
        }
        let lenv = text_of(login, "env");
        if len(lenv) > 0 && !env_name(lenv) {
            return refused("login.env", "the login's variable is a variable's name");
        }
        let files = lines_of(std::json::find_field_raw(login, "files"));
        if std::str::starts_with(files, "!") || len(files) == 0 {
            return refused("login.files", "a login directory lists the files of it a run is given");
        }
        if std::str::contains(files, "/") {
            return refused("login.files", "a login's files are names in its directory");
        }
        if std::str::contains(text_of(login, "from"), "..") {
            return refused("login.from", "a login's files are in its directory");
        }
    } else if kind == "voice" {
        if !env_name(text_of(login, "env")) {
            return refused(
                "login.env",
                "a key voice mints for the run names the variable it is handed in",
            );
        }
    } else {
        return refused(
            "login.kind",
            "its login is `env` (a vault entry, handed in a variable), `home` (a directory per login) or `voice` (a key voice mints for each attempt)",
        );
    }
    let env = std::str::trim(std::json::find_field_raw(json, "env"));
    if len(env) > 0 && !std::json::valid_object(env) {
        return refused("env", "its env is an object of strings");
    }
    let reader = text_of(json, "reader");
    if !listed(std::str::replace(READERS, " ", "\n") + "\n", reader) {
        return refused("reader", "its reader is one voice has (" + READERS + ")");
    }
    let usage = text_of(json, "usage_file");
    if len(usage) > 0 && !in_dir(usage, "/voice/out/") {
        return refused(
            "usage_file",
            "its usage file is a file of /voice/out, which voice reads after the run",
        );
    }
    let egress = lines_of(std::json::find_field_raw(json, "egress"));
    if std::str::starts_with(egress, "!") {
        return refused("egress", "its egress is a list of host names");
    }
    let mut rest = egress;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let h = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let host = if std::str::starts_with(h, ".") { h[1..len(h)] } else { h };
        if !host_pattern(host) { return refused("egress", "egress " + h + " is not a host name"); }
    }
    let route = text_of(json, "base_url_env");
    let wire = text_of(json, "protocol");
    if (len(route) > 0 || len(wire) > 0) != (kind == "voice") {
        return refused(
            "base_url_env",
            "a harness's model calls go to voice (`base_url_env`, `protocol`) exactly when it runs under voice's own key (`login.kind` `voice`)",
        );
    }
    if kind == "voice" {
        if !env_name(route) {
            return refused(
                "base_url_env",
                "a harness whose model calls go to voice names the variable voice's address is handed in (`base_url_env`)",
            );
        }
        if route == text_of(login, "env") {
            return refused(
                "base_url_env",
                "voice's address and its key go in variables of their own",
            );
        }
        if !listed(PROTOCOLS, wire) {
            return refused(
                "protocol",
                "its model calls speak a wire voice serves (`protocol`: "
                    + std::str::replace(std::str::trim(PROTOCOLS), "\n", ", ") + ")",
            );
        }
    }
    return RecipeProblem { };
}

/// The `NAME=value` lines of a JSON object of strings, those of a
/// variable's name and of one line.
@unbounded
fn env_lines(raw: String) -> String {
    let obj = std::str::trim(raw);
    if !std::json::valid_object(obj) { return ""; }
    let mut env = "";
    let mut it = std::json::object_first(obj);
    while !it.done {
        let key = std::json::obj_key_string(it, obj);
        let v = std::str::trim(std::json::obj_value_raw(it, obj));
        if std::str::starts_with(v, "\"") && env_name(key) {
            let s = std::json::obj_value_string(it, obj);
            if !std::str::contains(s, "\n") { env = env + key + "=" + s + "\n"; }
        }
        it = std::json::object_next(it, obj);
    }
    return env;
}

/// One backend of a recipe, read.
@unbounded
fn backend_of(e: String) -> HarnessBackend {
    let detect = std::json::find_field_raw(e, "detect");
    let install = std::str::trim(std::json::find_field_raw(e, "install"));
    let host_install = std::json::valid_object(install);
    return HarnessBackend {
        kind: text_of(e, "kind"),
        base: text_of(e, "base"),
        install: if host_install { "" } else { text_of(e, "install") },
        detect: lines_of(std::json::find_field_raw(detect, "command")),
        detect_version: text_of(detect, "version"),
        install_argv: if host_install {
            lines_of(std::json::find_field_raw(install, "command"))
        } else {
            ""
        },
        install_env: if host_install {
            env_lines(std::json::find_field_raw(install, "env"))
        } else {
            ""
        },
    };
}

/// True when recipe `json` has a backend of `kind` (`container` or
/// `host`): the older `image` is a container backend.
@unbounded
fn has_backend(json: String, kind: String) -> Bool {
    let image = std::str::trim(std::json::find_field_raw(json, "image"));
    if len(image) > 0 && image != "null" { return kind == "container"; }
    let raw = std::str::trim(std::json::find_field_raw(json, "backends"));
    if !std::str::starts_with(raw, "[") { return false; }
    let mut it = std::json::array_first(raw);
    while !it.done {
        if text_of(it.element, "kind") == kind { return true; }
        it = std::json::array_next(it);
    }
    return false;
}

/// `json`, a recipe `recipe_problem` passed, read.
@unbounded
fn harness_def(json: String) -> HarnessDef {
    let instruction = std::json::find_field_raw(json, "instruction");
    let model = std::json::find_field_raw(json, "model");
    let login = std::json::find_field_raw(json, "login");
    let idle = std::json::string_field(json, "idle_seconds");
    let mut d = HarnessDef {
        id: text_of(json, "id"),
        name: text_of(json, "name"),
        version: text_of(json, "version"),
        command: lines_of(std::json::find_field_raw(json, "command")),
        via: text_of(instruction, "via"),
        instruction_path: text_of(instruction, "path"),
        files: files_of(json),
        model_flag: text_of(model, "flag"),
        model_env: text_of(model, "env"),
        login_kind: text_of(login, "kind"),
        login_env: text_of(login, "env"),
        login_mount: text_of(login, "mount"),
        login_from: text_of(login, "from"),
        login_files: lines_of(std::json::find_field_raw(login, "files")),
        env: env_lines(std::json::find_field_raw(json, "env")),
        reader: text_of(json, "reader"),
        usage_file: text_of(json, "usage_file"),
        commits: std::json::find_bool_field(json, "commits"),
        nested_sandbox: std::json::find_bool_field(json, "nested_sandbox"),
        preamble: text_of(json, "preamble"),
        egress: lines_of(std::json::find_field_raw(json, "egress")),
        idle_seconds: if idle.kind == "number"
            && std::json::find_int_field(json, "idle_seconds") > 0
        {
            std::json::find_int_field(json, "idle_seconds")
        } else {
            1800
        },
        base_url_env: text_of(json, "base_url_env"),
        protocol: text_of(json, "protocol"),
    };
    let image = std::str::trim(std::json::find_field_raw(json, "image"));
    if len(image) > 0 && image != "null" {
        push(
            d.backends,
            HarnessBackend {
                kind: "container",
                base: text_of(image, "base"),
                install: text_of(image, "install"),
            },
        ) or discard;
        return d;
    }
    let raw = std::str::trim(std::json::find_field_raw(json, "backends"));
    if std::str::starts_with(raw, "[") {
        let mut it = std::json::array_first(raw);
        while !it.done {
            push(d.backends, backend_of(std::str::trim(it.element))) or discard;
            it = std::json::array_next(it);
        }
    }
    return d;
}

/// `s` cut to at most `n` bytes, never inside a UTF-8 character.
fn clip_utf8(s: String, n: Int) -> String {
    if len(s) <= n { return s; }
    let v = std::str::bytes_view(s);
    let mut end = n;
    while end > 0 && std::str::byte_at(v, end) >= 128 && std::str::byte_at(v, end) < 192 {
        end = end - 1;
    }
    return s[0..end];
}
