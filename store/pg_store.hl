        let n = self.step(
            "INSERT INTO node (id, name, token_digest, max_in_flight, status, assignment_version, created_at, revoked_at) VALUES ($1, $2, decode($3, 'hex'), $4::int, $5, $6::int, $7::timestamptz, $8::timestamptz) ON CONFLICT (id) DO NOTHING",
