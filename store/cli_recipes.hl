// CLI recipes (../spec/store.md, migration 43): the agentic coding CLIs voice
// runs coding attempts with, one `cli_recipe` row each, its body the recipe
// as lib/harness checked it. Voice's own are read from its files at each
// start (`shipped`), their bodies replaced and kept read-only; the
// operator's are made and edited on the admin plane (`operator`). Either
// may be disabled, after which its seats take no new attempt; one a seat
// names (its config's `harness`) is never removed, only disabled.

/// The most CLI recipes voice holds, its own and the operator's.
const CLI_RECIPES_MAX: Int = 64;

/// What a write that names CLI recipe `<id>` holds (`Store.hold`), as
/// its removal does: `cli-recipes/<id>`.
const CLI_RECIPE_HOLD: String = "cli-recipes/";

/// One `cli_recipe` row. `origin` is `shipped` (voice's own, from its
/// files) or `operator`.
type CliRecipeRow {
    id: String = "";
    body: String = "{}";
    origin: String = "operator";
    enabled: Bool = true;
    created_at: Time = `1970-01-01T00:00:00Z`;
    updated_at: Time = `1970-01-01T00:00:00Z`;
    present: Bool = false;
}

/// Every CLI recipe row, in the order of their ids.
type CliRecipeRows { rows: bounded[CliRecipeRow; 64]; }

/// True when seat config `config` names recipe `id` (`harness`).
fn names_cli_recipe(config: String, id: String) -> Bool {
    let f = std::json::string_field(config, "harness");
    return f.kind == "string" && f.text == id;
}

/// Voice's own recipes, `shipped` (a JSON list), as the rows a memory store
/// starts with: each enabled, voice's own, added `at`, in the order of their
/// ids.
@bounded_by(shipped)
fn shipped_cli_recipe_rows(shipped: String, at: Time) -> CliRecipeRows {
    let mut out = CliRecipeRows { };
    let mut it = std::json::array_first(shipped);
    while !it.done {
        let body = std::str::trim(it.element);
        let id = std::json::find_string_field(body, "id");
        let row = CliRecipeRow {
            id: id,
            body: body,
            origin: "shipped",
            enabled: true,
            created_at: at,
            updated_at: at,
            present: true,
        };
        let mut next = CliRecipeRows { };
        let mut placed = false;
        for r in out.rows {
            if !placed && id < r.id {
                push(next.rows, row) or discard;
                placed = true;
            }
            if r.id != id { push(next.rows, r) or discard; }
        }
        if !placed { push(next.rows, row) or discard; }
        out = next;
        it = std::json::array_next(it);
    }
    return out;
}
