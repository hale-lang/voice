// The runner looks at its servers twice a second for the node's life
// (run.hl `Runner.look`), so a look that changes nothing keeps nothing: the
// node's memory stays flat while its seats serve. A look that stored the
// runs whole kept every String of the ones it replaced, a seat's serving
// identity among them (its variant's whole file list), about 1 MB a minute
// on a node serving a model across two.
//
// A runner here, on its own thread as the node places it, holds one run
// that is up and said its context, its server this test's own process, its
// identity 1 MiB: each look kept was a MiB.
import ".." as node;

/// The process's resident memory now, in kB, as `ps` says it (on Linux
/// and macOS alike).
fn resident_kb() -> Int {
    return std::str::parse_int(
        std::str::trim(node::run_out("ps\n-o\nrss=\n-p\n" + to_string(std::process::pid()))),
    ) or 0;
}

main locus Looked {
    params {
        runner: node::Runner = node::Runner { };
        // the growth over a dozen looks, in kB
        grew: Int = -1;
    }
    placement {
        runner: pinned;
    }
    // its return drains the runner
    run() {
        // past the runner's first turn (what a node that stopped left,
        // stopped)
        std::time::sleep(1500ms);
        let before = resident_kb();
        std::test::assert(before > 0, "the resident memory is readable");
        // a dozen looks
        std::time::sleep(6000ms);
        self.grew = resident_kb() - before;
        std::test::assert(
            self.grew < 4096,
            "a dozen looks grew the node by " + to_string(self.grew)
                + " kB; a look that changes nothing keeps nothing",
        );
    }
}

fn main() {
    let data = "/tmp/voice-look-test-" + to_string(std::time::monotonic_ns());
    std::io::fs::mkdir(data) or discard;
    let mut runs = node::Runs { };
    push(
        runs.items,
        node::Run {
            seat: "s1",
            phase: "up",
            port: 47100,
            health: "http://127.0.0.1:47100/health",
            endpoint: "http://127.0.0.1:47100/v1",
            pid: std::process::pid(),
            log: data + "/run/s1.log",
            server: "tensorfold",
            context: 4096,
            asked: 1,
            identity: std::str::repeat("variant=", 131072),
            spans: true,
        },
    )
    or discard;
    Looked {
        runner: node::Runner {
            id: "look-test-" + to_string(std::process::pid()),
            data: data,
            runs: runs,
        },
    };
}
