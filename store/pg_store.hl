    fn insert_project_locked(row: ProjectRow, change: ChangeRow) -> Bool fallible(StoreError) {
        self.begin() or raise;
        self.room(
            "SELECT count(*) FROM project",
            db::Args { },
            64,
            "voice holds at most 64 projects",
        ) or raise;
        let n = self.step(
            "INSERT INTO project (id, name, status, owners, data_classes, models, accounts, position, created_at, archived_at, inherits, parent, peek) VALUES ($1, $2, $3, "
                + names_param(4) + ", " + names_param(5) + ", " + restriction_param(6) + ", "
                + restriction_param(7)
                + ", $8, $9::timestamptz, $10::timestamptz, $11::boolean, $12, $13::boolean) ON CONFLICT (id) DO NOTHING",
            project_args(row),
        ) or raise;
        if n == 0 {
            self.rollback();
            return false;
        }
        self.project_parts(row) or raise;
        self.commit_with(change) or raise;
        return true;
    }

    fn update_project(row: ProjectRow, change: ChangeRow) fallible(StoreError) {
        self.lock.enter();
        self.update_project_locked(row, change) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
    }

    fn update_project_locked(row: ProjectRow, change: ChangeRow) fallible(StoreError) {
        self.begin() or raise;
        self.step(
            "UPDATE project SET name = $2, status = $3, owners = " + names_param(4)
                + ", data_classes = " + names_param(5) + ", models = " + restriction_param(6)
                + ", accounts = " + restriction_param(7)
                + ", position = $8, created_at = $9::timestamptz, archived_at = $10::timestamptz, inherits = $11::boolean, parent = $12, peek = $13::boolean WHERE id = $1",
            project_args(row),
        ) or raise;
        self.project_parts(row) or raise;
        self.commit_with(change) or raise;
    }

    fn archive_project(
        row: ProjectRow,
        change: ChangeRow,
        revoked: Revocations
    ) fallible(StoreError) {
        self.lock.enter();
        self.archive_project_locked(row, change, revoked) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
    }

    fn archive_project_locked(
        row: ProjectRow,
        change: ChangeRow,
        revoked: Revocations
    ) fallible(StoreError) {
        self.begin() or raise;
        self.step(
            "UPDATE project SET name = $2, status = $3, owners = " + names_param(4)
                + ", data_classes = " + names_param(5) + ", models = " + restriction_param(6)
                + ", accounts = " + restriction_param(7)
                + ", position = $8, created_at = $9::timestamptz, archived_at = $10::timestamptz, inherits = $11::boolean, parent = $12, peek = $13::boolean WHERE id = $1",
            project_args(row),
        ) or raise;
        for k in revoked.keys {
            let a = db::Args { };
            a.add(k.id);
            a.add(std::time::iso8601(k.revoked_at));
            self.step(
                "UPDATE api_key SET status = 'revoked', revoked_at = $2::timestamptz WHERE id = $1",
                a,
            ) or raise;
        }
        for c in revoked.changes {
            self.record(c) or raise;
        }
        self.commit_with(change) or raise;
    }

    /// A project's budget and its project- and model-scope limits,
    /// replaced inside the transaction.
    fn project_parts(row: ProjectRow) fallible(StoreError) {
        let a = db::Args { };
        a.add(row.id);
        self.step("DELETE FROM budget WHERE project = $1", a) or raise;
        if row.budgeted {
            let b = db::Args { };
            b.add(row.id);
            b.add(to_string(row.budget.allowance_micros));
            b.add(row.budget.currency);
            b.add(period_name(row.budget.period));
            b.add(std::time::iso8601(row.budget.period_anchor));
            self.step(
                "INSERT INTO budget (project, allowance_micros, currency, period, period_anchor) VALUES ($1, $2::bigint, $3, $4, $5::timestamptz)",
                b,
            ) or raise;
        }
        let d = db::Args { };
        d.add(row.id);
        self.step(
            "DELETE FROM \"limit\" WHERE project = $1 AND key IS NULL AND scope IN ('project', 'model')",
            d,
        ) or raise;
        for l in row.limits.items {
            self.step(INSERT_LIMIT, limit_args(l, row.id, "", "")) or raise;
        }
    }

