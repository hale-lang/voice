// What a node has on disk, from what it reported its store holds, read
// against the recipes: a variant held whole, and the placement that uses
// it there now; one held in part, with how much, when it holds a file of
// its own, one no other variant lists; and the files no variant listed
// accounts for. The report itself is checked: each file by its sha256, in
// order, once.
import ".." as api;
import "../../store" as st;

fn h(c: String) -> String {
    return std::str::repeat(c, 64);
}

fn file(path: String, bytes: Int, sha: String) -> String {
    return "{\"path\": \"" + path + "\", \"bytes\": " + to_string(bytes) + ", \"sha256\": \"" + sha
        + "\"}";
}

/// Two recipes: `chat`'s two variants share a tokenizer; `coder`'s one is
/// a single file.
fn recipes() -> String {
    return "[{\"id\": \"chat\", \"variants\": [{\"id\": \"gguf-q4\", \"files\": ["
        + file("chat-q4.gguf", 4000, h("1")) + "]}, {\"id\": \"safetensors-bf16\", \"files\": ["
        + file("tokenizer.json", 10, h("2")) + ", " + file("model-1.safetensors", 5000, h("3"))
        + ", " + file("model-2.safetensors", 5000, h("4"))
        + "]}, {\"id\": \"safetensors-fp8\", \"files\": [" + file("tokenizer.json", 10, h("2"))
        + ", " + file("model.safetensors", 5000, h("5"))
        + "]}]}, {\"id\": \"coder\", \"variants\": [{\"id\": \"gguf-q8\", \"files\": ["
        + file("coder.gguf", 9000, h("6")) + "]}]}]";
}

fn placed(id: String, recipe: String, variant: String, leader: String) -> st::PlacementRow {
    return st::PlacementRow {
        id: id,
        body: "{\"id\": \"" + id + "\", \"recipe\": \"" + recipe + "\", \"variant\": \"" + variant
            + "\", \"nodes\": [\"" + leader + "\"], \"leader\": \"" + leader + "\"}",
        present: true,
    };
}

fn refused(body: String) -> String {
    api::read_inventory(body) or { return err.message; };
    return "";
}

fn main() {
    // ---- the report ------------------------------------------------------
    let ok = api::read_inventory(
        "{\"blobs\": [{\"sha256\": \"" + h("1") + "\", \"bytes\": 4000}, {\"sha256\": \"" + h("a")
            + "\", \"bytes\": 0}]}",
    ) or api::InventoryText { };
    std::test::assert_eq_str(
        ok.blobs,
        h("1") + " 4000\n" + h("a") + " 0\n",
        "kept a file a line, in the order reported",
    );
    std::test::assert(ok.files == 2 && ok.bytes == 4000, "with how many and their size");
    let empty = api::read_inventory("{\"blobs\": []}") or api::InventoryText { files: -1 };
    std::test::assert(empty.files == 0 && len(empty.blobs) == 0, "an empty store is a report");
    let two = "{\"sha256\": \"" + h("2") + "\", \"bytes\": 1}";
    let one = "{\"sha256\": \"" + h("1") + "\", \"bytes\": 1}";
    std::test::assert(
        std::str::contains(refused("{\"blobs\": [" + two + ", " + one + "]}"), "out of order"),
        "files out of order are refused",
    );
    std::test::assert(
        std::str::contains(refused("{\"blobs\": [" + one + ", " + one + "]}"), "listed twice"),
        "a file listed twice is refused",
    );
    std::test::assert(
        std::str::contains(
            refused("{\"blobs\": [{\"sha256\": \"" + h("A") + "\", \"bytes\": 1}]}"),
            "64 lowercase hex digits",
        ),
        "a sha256 in capitals is refused",
    );
    std::test::assert(
        std::str::contains(
            refused("{\"blobs\": [{\"sha256\": \"" + h("1") + "\", \"bytes\": -1}]}"),
            "0 or more",
        ),
        "a negative size is refused",
    );
    std::test::assert(
        std::str::contains(
            refused("{\"blobs\": [{\"sha256\": \"" + h("1") + "\", \"bytes\": 1.5}]}"),
            "whole number",
        ),
        "a fraction of a byte is refused",
    );
    std::test::assert(len(refused("{\"files\": []}")) > 0, "a report without blobs is refused");

    // ---- what it holds ---------------------------------------------------
    // chat's bf16 whole, of its fp8 only the tokenizer the two share (the
    // bf16's, so not the fp8's in part), nothing of its q4 or of coder,
    // and two files no variant lists
    let inv = st::InventoryRow {
        node: "spark",
        blobs: h("2") + " 10\n" + h("3") + " 5000\n" + h("4") + " 5000\n" + h("b") + " 700\n"
            + h("c")
            + " 300\n",
        files: 5,
        bytes: 11010,
        reported_at: `2026-11-07T00:00:00Z`,
        present: true,
    };
    let mut rows = st::PlacementRows { };
    push(rows.rows, placed("chat-on-spark", "chat", "safetensors-bf16", "spark")) or discard;
    let mut gone = placed("old", "chat", "safetensors-fp8", "spark");
    gone.removed = true;
    push(rows.rows, gone) or discard;
    let d = api::node_downloads("spark", inv, recipes(), rows);
    std::test::assert(
        d.node == "spark" && d.has_reported_at && d.files == 5 && d.bytes == 11010,
        "the node's store, as it reported it",
    );
    std::test::assert_eq_int(count(d.data), 1, "one variant on the node: the one held whole");
    let whole = at(d.data, 0) or api::NodeDownload { };
    std::test::assert(
        whole.recipe == "chat" && whole.variant == "safetensors-bf16" && whole.complete
            && whole.files_held == 3 && whole.files_total == 3 && whole.bytes == 10010
            && whole.bytes_held == 10010,
        "the variant held whole first",
    );
    std::test::assert(
        whole.has_placed && whole.placed == "chat-on-spark",
        "with the placement that uses it there now",
    );
    std::test::assert(
        d.other_files == 2 && d.other_bytes == 1000,
        "the files no variant lists, apart",
    );

    // the fp8's shard fetched too: both held whole, the tokenizer each's
    let mut fetching = inv;
    fetching.blobs = h("2") + " 10\n" + h("3") + " 5000\n" + h("4") + " 5000\n" + h("5")
        + " 5000\n";
    let fd = api::node_downloads("spark", fetching, recipes(), rows);
    std::test::assert_eq_int(count(fd.data), 2, "two variants held whole");
    let part = at(fd.data, 1) or api::NodeDownload { };
    std::test::assert(
        part.variant == "safetensors-fp8" && part.complete
            && part.files_held == 2 && part.files_total == 2,
        "a shard of its own and the shared tokenizer: whole",
    );
    std::test::assert(!part.has_placed, "a placement removed uses it no more");
    fetching.blobs = h("1") + " 4000\n" + h("3") + " 5000\n";
    let one_shard = api::node_downloads("spark", fetching, recipes(), rows);
    let shard = at(one_shard.data, 1) or api::NodeDownload { };
    std::test::assert(
        count(one_shard.data) == 2 && shard.variant == "safetensors-bf16" && !shard.complete
            && shard.files_held == 1 && shard.files_total == 3 && shard.bytes_held == 5000
            && shard.bytes == 10010,
        "one shard of its own held: held in part, with how much",
    );
    std::test::assert(shard.has_placed, "with the placement that uses it");

    // two fetches under way that share the tokenizer: each holds a shard of
    // its own, so each is held in part
    let pair = "[{\"id\": \"chat\", \"variants\": [{\"id\": \"bf16\", \"files\": ["
        + file("tokenizer.json", 10, h("2")) + ", " + file("model-1.safetensors", 5000, h("3"))
        + ", " + file("model-2.safetensors", 5000, h("4")) + "]}, {\"id\": \"fp8\", \"files\": ["
        + file("tokenizer.json", 10, h("2")) + ", " + file("model-1.safetensors", 2500, h("5"))
        + ", " + file("model-2.safetensors", 2500, h("6")) + "]}]}]";
    fetching.blobs = h("2") + " 10\n" + h("3") + " 5000\n" + h("5") + " 2500\n";
    let both = api::node_downloads("spark", fetching, pair, rows);
    let bf = at(both.data, 0) or api::NodeDownload { };
    let fp = at(both.data, 1) or api::NodeDownload { };
    std::test::assert(
        count(both.data) == 2 && bf.variant == "bf16" && !bf.complete && bf.files_held == 2
            && bf.bytes_held == 5010 && fp.variant == "fp8" && !fp.complete
            && fp.files_held == 2 && fp.bytes_held == 2510,
        "two in part sharing a file: each listed, the shared file in each",
    );
    // mid-fetch, the shared tokenizer and a shard of its own: only the
    // variant fetching, the tokenizer counted with it
    fetching.blobs = h("2") + " 10\n" + h("3") + " 5000\n";
    let mid = api::node_downloads("spark", fetching, recipes(), rows);
    let only_bf = at(mid.data, 0) or api::NodeDownload { };
    std::test::assert(
        count(mid.data) == 1 && only_bf.variant == "safetensors-bf16" && !only_bf.complete
            && only_bf.files_held == 2 && only_bf.bytes_held == 5010,
        "mid-fetch: the variant fetching alone, not the sibling sharing its tokenizer",
    );
    std::test::assert(mid.other_files == 0, "the tokenizer is the fetching variant's");

    // the tokenizer alone: no variant holds a file of its own, so none is
    // listed, and the tokenizer is other
    fetching.blobs = h("2") + " 10\n";
    let tok = api::node_downloads("spark", fetching, recipes(), rows);
    std::test::assert(
        count(tok.data) == 0 && tok.other_files == 1 && tok.other_bytes == 10,
        "a shared file alone: no variant, and other",
    );

    // one variant held whole beside its siblings and another model from the
    // same base, sharing only its tokenizer and config: none is held in part
    let family = "[{\"id\": \"style\", \"variants\": [{\"id\": \"mlx-bf16\", \"files\": ["
        + file("tokenizer.json", 11, h("2")) + ", " + file("config.json", 1, h("3")) + ", "
        + file("model.safetensors", 4000, h("4")) + "]}, {\"id\": \"mlx-4bit\", \"files\": ["
        + file("tokenizer.json", 11, h("2")) + ", " + file("config.json", 1, h("3")) + ", "
        + file("model.safetensors", 1000, h("5")) + "]}, {\"id\": \"gguf-q8\", \"files\": ["
        + file("style.gguf", 2000, h("6"))
        + "]}]}, {\"id\": \"distill\", \"variants\": [{\"id\": \"mlx-bf16\", \"files\": ["
        + file("tokenizer.json", 11, h("2")) + ", " + file("chat_template.jinja", 2, h("7"))
        + ", " + file("model.safetensors", 9000, h("8")) + "]}]}]";
    let mut mac = inv;
    mac.blobs = h("2") + " 11\n" + h("3") + " 1\n" + h("4") + " 4000\n" + h("c") + " 300\n";
    mac.files = 4;
    mac.bytes = 4312;
    let mut on_mac = st::PlacementRows { };
    push(on_mac.rows, placed("style-on-mac", "style", "mlx-bf16", "mac")) or discard;
    let m = api::node_downloads("mac", mac, family, on_mac);
    let mw = at(m.data, 0) or api::NodeDownload { };
    std::test::assert(
        count(m.data) == 1 && mw.recipe == "style" && mw.variant == "mlx-bf16" && mw.complete
            && mw.placed == "style-on-mac",
        "the one held whole alone: its siblings and kin share only small files",
    );
    std::test::assert(
        m.other_files == 1 && m.other_bytes == 300,
        "what no variant lists is other still",
    );

    // placed on another node, it is not placed here
    let mut elsewhere = st::PlacementRows { };
    push(elsewhere.rows, placed("chat-on-flare", "chat", "safetensors-bf16", "flare"))
    or discard;
    let e = api::node_downloads("spark", inv, recipes(), elsewhere);
    std::test::assert(
        !(at(e.data, 0) or api::NodeDownload { }).has_placed,
        "a placement on another node is not this node's",
    );

    // a node that never reported holds nothing known
    let none = api::node_downloads("flare", st::InventoryRow { }, recipes(), rows);
    std::test::assert(
        !none.has_reported_at && count(none.data) == 0 && none.files == 0,
        "nothing until the node reports",
    );

    // a recipe withdrawn: its files are the node's, and no variant's
    let only_coder = "[{\"id\": \"coder\", \"variants\": [{\"id\": \"gguf-q8\", \"files\": ["
        + file("coder.gguf", 9000, h("6")) + "]}]}]";
    let w = api::node_downloads("spark", inv, only_coder, rows);
    std::test::assert(
        count(w.data) == 0 && w.other_files == 5 && w.other_bytes == 11010,
        "what no recipe lists any more is other",
    );

    // a variant with file sets from other repositories: one listing its
    // files, one pinned by a manifest, which counts as its file; the files
    // the manifest lists are not named, so they are other; what its
    // prepare step makes is kept apart and not counted
    let sets = "[{\"id\": \"frontier\", \"variants\": [{\"id\": \"exl3-2.5bpw\", \"files\": ["
        + file("model.safetensors", 1000, h("7"))
        + "], \"file_sets\": [{\"name\": \"engram\", \"files\": ["
        + file("engram.bin", 200, h("8"))
        + "]}, {\"name\": \"kit\", \"manifest\": {\"path\": \"kit/MANIFEST\", \"bytes\": 30, \"sha256\": \""
        + h("9") + "\"}, \"bytes\": 900}], \"prepare\": \"dsv41-tp2\", \"prepared\": ["
        + file("cache/rank0.bin", 5000, h("d")) + "]}]}]";
    let fs_inv = st::InventoryRow {
        node: "spark",
        blobs: h("7") + " 1000\n" + h("8") + " 200\n" + h("9") + " 30\n" + h("e") + " 900\n",
        files: 4,
        bytes: 2130,
        present: true,
    };
    let fsd = api::node_downloads("spark", fs_inv, sets, st::PlacementRows { });
    let fv = at(fsd.data, 0) or api::NodeDownload { };
    std::test::assert(
        count(fsd.data) == 1 && fv.complete && fv.files_total == 3 && fv.bytes == 1230
            && fv.bytes_held == 1230,
        "a variant's file sets are its files, a manifest among them",
    );
    std::test::assert(
        fsd.other_files == 1 && fsd.other_bytes == 900,
        "what a manifest lists is other",
    );
    let mut no_set = fs_inv;
    no_set.blobs = h("7") + " 1000\n" + h("9") + " 30\n";
    let fsn = api::node_downloads("spark", no_set, sets, st::PlacementRows { });
    let fsp = at(fsn.data, 0) or api::NodeDownload { };
    std::test::assert(
        !fsp.complete && fsp.files_held == 2 && fsp.files_total == 3,
        "a set's file missing: the variant is held in part",
    );

    // the summary reads the totals alone
    let s = api::node_downloaded_of(inv);
    std::test::assert(s.files == 5 && s.bytes == 11010, "a node's summary: files and bytes");

    // a variant held whole, for a suggestion
    let held = api::HeldBlobs { };
    api::hold_blobs(held, inv.blobs);
    std::test::assert(
        api::variant_whole(
            "{\"files\": [" + file("a", 10, h("2")) + ", " + file("b", 5000, h("3")) + "]}",
            held,
        ),
        "every file held: whole",
    );
    std::test::assert(
        !api::variant_whole(
            "{\"files\": [" + file("a", 10, h("2")) + ", " + file("b", 5000, h("5")) + "]}",
            held,
        ),
        "one missing: not",
    );
    std::test::assert(!api::variant_whole("{}", held), "a variant that lists none is never whole");
}
