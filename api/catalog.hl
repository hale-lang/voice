// The catalog: configured on the admin plane (`Catalog`), read by callers
// through their key (`Models`).
//
// No seat can be configured yet (the seat endpoints are still canned), so
// a model has no seats, is not available, and carries no data class: the
// answers say what is configured, and nothing more.

locus Catalog {
    params { store: Store; }

    /// `listCatalogModels`: every model not removed.
    fn list() -> CatalogList fallible(ApiError) {
        let rows = self.store.models() or fail store_failed(err);
        let mut out = CatalogList { };
        for r in rows.rows {
            if !r.removed { push(out.data, catalog_view(r)) or discard; }
        }
        return out;
    }

    /// `createCatalogModel`.
    fn create(m: CatalogModelCreate) -> CatalogModel fallible(ApiError) {
        if len(m.id) == 0 || len(m.id) > 128 { fail invalid("`id` is 1 to 128 characters", "id"); }
        check_model_fields(m.kind, m.context_length, m.max_output_tokens) or raise;
        let row = ModelRow {
            id: m.id,
            owned_by: if len(m.owned_by) > 0 { m.owned_by } else { "local" },
            kind: m.kind,
            context_length: m.context_length,
            max_output_tokens: m.max_output_tokens,
            priced: m.priced,
            price: m.price,
            created_at: now_seconds()
        };
        let added = self.store.insert_model(row) or fail store_failed(err);
        if !added { fail conflict("model " + m.id + " exists; a model id is never reused"); }
        return catalog_view(row);
    }

    /// `getCatalogModel`.
    fn get(r: ModelRef) -> CatalogModel fallible(ApiError) {
        let row = self.live(r.model) or raise;
        return catalog_view(row);
    }

    /// `updateCatalogModel`: the fields the request sets.
    fn update(u: CatalogModelUpdate) -> CatalogModel fallible(ApiError) {
        let mut row = self.live(u.model) or raise;
        if u.set_owned_by { row.owned_by = u.owned_by; }
        if u.set_kind { row.kind = u.kind; }
        if u.set_context_length { row.context_length = u.context_length; }
        if u.set_max_output_tokens { row.max_output_tokens = u.max_output_tokens; }
        if u.set_price {
            row.priced = u.priced;
            row.price = u.price;
        }
        check_model_fields(row.kind, row.context_length, row.max_output_tokens) or raise;
        self.store.update_model(row) or fail store_failed(err);
        return catalog_view(row);
    }

    /// `removeCatalogModel`: callers naming it get `model_not_found`; the
    /// id stays taken.
    fn remove(r: ModelRef) -> CatalogModel fallible(ApiError) {
        let mut row = self.live(r.model) or raise;
        row.removed = true;
        row.removed_at = now_seconds();
        self.store.update_model(row) or fail store_failed(err);
        return catalog_view(row);
    }

    /// The model `id`, unless it is absent or removed.
    fn live(id: String) -> ModelRow fallible(ApiError) {
        let row = self.store.model(id) or fail store_failed(err);
        if !row.present || row.removed { fail not_found("no model " + id + " in the catalog"); }
        return row;
    }
}

/// The catalog as the key a caller presented sees it: the models its
/// project and the key itself are not restricted from.
locus Models {
    params { store: Store; }

    /// `listModels`.
    fn list(ctx: std::api::Context) -> ModelList fallible(ApiError) {
        let k = self.caller_key(ctx) or raise;
        let p = self.store.project(k.project) or fail store_failed(err);
        let rows = self.store.models() or fail store_failed(err);
        let mut out = ModelList { };
        for r in rows.rows {
            if !r.removed && visible(p, k, r.id) { push(out.data, model_view(r)) or discard; }
        }
        return out;
    }

    /// `getModel`. A model the key cannot see is answered as one that
    /// does not exist.
    fn get(r: ModelRef, ctx: std::api::Context) -> Model fallible(ApiError) {
        let k = self.caller_key(ctx) or raise;
        let p = self.store.project(k.project) or fail store_failed(err);
        let row = self.store.model(r.model) or fail store_failed(err);
        if !row.present || row.removed || !visible(p, k, r.model) {
            fail ApiError { status: 404, kind: "not_found", code: "model_not_found", message: "no model " + r.model, param: "model" };
        }
        return model_view(row);
    }

    /// The key the caller is, as the bearer source named it.
    fn caller_key(ctx: std::api::Context) -> KeyRow fallible(ApiError) {
        let k = self.store.key(ctx.caller.name) or fail store_failed(err);
        if !k.present { fail invalid_key(); }
        return k;
    }
}

/// True when the project and the key both let `model` through.
fn visible(p: ProjectRow, k: KeyRow, model: String) -> Bool {
    return allows(p.models, model) && allows(k.models, model);
}

/// True when `r` is no restriction or names `name`.
fn allows(r: Restriction, name: String) -> Bool {
    return r.any || has_name(r.names, name);
}

fn has_name(ns: Names, name: String) -> Bool {
    for n in ns.items {
        if n == name { return true; }
    }
    return false;
}

fn check_model_fields(kind: String, context_length: Int, max_output_tokens: Int) -> Bool fallible(ApiError) {
    if kind != "local" && kind != "hosted" { fail invalid("`kind` is local or hosted", "kind"); }
    if context_length < 0 { fail invalid("`context_length` is at least 1", "context_length"); }
    if max_output_tokens < 0 { fail invalid("`max_output_tokens` is at least 1", "max_output_tokens"); }
    return true;
}

/// The seats that serve a model: none yet, since no seat can be configured.
fn catalog_view(r: ModelRow) -> CatalogModel {
    return CatalogModel {
        id: r.id,
        owned_by: r.owned_by,
        kind: r.kind,
        context_length: r.context_length,
        max_output_tokens: r.max_output_tokens,
        priced: r.priced,
        price: r.price,
        available: false,
        created_at: r.created_at
    };
}

fn model_view(r: ModelRow) -> Model {
    return Model {
        id: r.id,
        created: std::time::unix(r.created_at),
        owned_by: r.owned_by,
        kind: r.kind,
        context_length: r.context_length,
        max_output_tokens: r.max_output_tokens,
        priced: r.priced,
        price: r.price,
        available: false
    };
}

// ---- errors ----------------------------------------------------------

fn invalid(message: String, param: String) -> ApiError {
    return ApiError { status: 400, kind: "invalid_request", code: "invalid_request", message: message, param: param };
}

fn unsupported(message: String, param: String) -> ApiError {
    return ApiError { status: 400, kind: "invalid_request", code: "unsupported", message: message, param: param };
}

fn not_found(message: String) -> ApiError {
    return ApiError { status: 404, kind: "not_found", code: "not_found", message: message };
}

fn conflict(message: String) -> ApiError {
    return ApiError { status: 409, kind: "invalid_request", code: "conflict", message: message };
}

fn invalid_key() -> ApiError {
    return ApiError { status: 401, kind: "authentication_error", code: "invalid_key", message: "a valid project key is required: Authorization: Bearer vk-..." };
}

/// A store that could not answer. A full list is the caller's to fix; a
/// store that is down is nobody's, and nothing is served until it is back.
fn store_failed(e: StoreError) -> ApiError {
    if e.kind == "full" { return invalid(e.message, ""); }
    return ApiError { status: 503, kind: "server_error", code: "metering_unavailable", message: "the store is unavailable: " + e.message };
}

/// Now, to the second: what every timestamp voice writes is.
fn now_seconds() -> Time {
    return std::time::time_from_unix(std::time::unix(std::time::current()));
}
