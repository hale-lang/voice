// Annotate: a request whose project or key annotates is answered as any
// request, then the annotators in force for it are asked about it, one
// decision request a stage (two when a response annotator reads the
// request's answers), as requests of its project's system key, whose usage
// is kept apart from the project's. Every answer is kept, a row each,
// naming its annotator and version, and searchable; rules pair them. A
// conversation's title is written by the project's text model. Annotators
// are data: made, versioned, conditioned, disabled; the built-in ones never
// removed. Annotate is refused with no decision model behind `decide`, and a
// request is not annotated, saying why, when that model goes. Recorded
// requests are annotated later from their recordings. A system key is no
// caller's.
import ".." as api;
import "../../node" as node;
import "../../store" as st;

/// The decision model's answers to the built-in annotators' questions, by
/// question id (`<annotator>.<question>`); any other question is answered
/// its first option, likely.
const CANNED: String = """
    {"request-basics.task": {"type": "choice", "choice": "code", "confidence": 0.8, "probabilities": {"code": 0.85, "debug": 0.05, "writing": 0.02, "research": 0.02, "analysis": 0.02, "planning": 0.02, "chat": 0.01, "other": 0.01}}, "request-basics.domain": {"type": "choice", "choice": "software", "confidence": 0.9, "probabilities": {"software": 0.9, "other": 0.1}}, "request-basics.multi_step": {"type": "noul", "noul": 0.8}, "request-basics.asks_for_code": {"type": "noul", "noul": 0.9}, "request-basics.sensitive": {"type": "noul", "noul": 0.1}, "request-basics.depends_on_context": {"type": "noul", "noul": 0.2}, "request-basics.difficulty": {"type": "score", "score": 1.9, "confidence": 0.5, "legend": {"0": "1", "1": "2", "2": "3", "3": "4", "4": "5"}, "probabilities": {"0": 0.1, "1": 0.2, "2": 0.4, "3": 0.2, "4": 0.1}}, "request-basics.size": {"type": "score", "score": 1.0, "confidence": 0.5, "legend": {"0": "1", "1": "2", "2": "3", "3": "4", "4": "5"}, "probabilities": {"0": 0.3, "1": 0.5, "2": 0.1, "3": 0.05, "4": 0.05}}, "response-basics.outcome": {"type": "choice", "choice": "answered", "confidence": 0.7, "probabilities": {"answered": 0.75, "partly_answered": 0.15, "refused": 0.02, "asked_back": 0.05, "error": 0.03}}, "response-basics.contains_code": {"type": "noul", "noul": 0.2}, "response-basics.followed_format": {"type": "noul", "noul": 0.95}, "response-basics.completeness": {"type": "score", "score": 2.6, "confidence": 0.6, "legend": {"0": "1", "1": "2", "2": "3", "3": "4"}, "probabilities": {"0": 0.05, "1": 0.1, "2": 0.15, "3": 0.7}}}
    """;

/// A link to one node, in process: a decision request is answered as a
/// decision server would, any other by the static engine. It keeps how many
/// decision requests it was offered, the last one's state, and the question
/// ids each asked, a line each.
locus Nodes {
    params {
        decisions: Int = 0;
        last_state: String = "";
        asked: String = "";
    }
    fn place() -> String { return "nats://nats.test:4222"; }
    fn root() -> String { return "voice"; }
    fn assign(node: String, body: String) -> Bool { return true; }
    @unbounded
    fn offer(to: String, reply_to: String, body: String) -> api::Offer {
        let id = std::json::find_string_field(body, "request_id");
        let model = std::json::find_string_field(body, "model");
        let sent = std::str::trim(std::json::find_field_raw(body, "body"));
        if std::json::find_string_field(body, "endpoint") == "decision" {
            self.decisions = self.decisions + 1;
            self.last_state = std::json::find_field_raw(sent, "state");
            let qs = std::str::trim(std::json::find_field_raw(sent, "questions"));
            let answers = st::JsonList { };
            let ids = std::bytes::BytesBuilder { };
            let mut it = std::json::object_first(qs);
            while !it.done {
                let qid = std::json::obj_key_string(it, qs);
                let q = std::json::obj_value_raw(it, qs);
                it = std::json::object_next(it, qs);
                ids.append_str(qid + " ");
                let canned = std::str::trim(std::json::find_field_raw(CANNED, qid));
                answers.add(
                    api::jq(qid) + ": " + (if len(canned) > 0 { canned } else { generic(q) }),
                );
            }
            self.asked = self.asked + std::str::clone(ids.text_view()) + "\n";
            let answer = "{\"model\": \"jev-2b\", \"answers\": {" + answers.text()
                + "}, \"usage\": {\"input_tokens\": 40, \"output_tokens\": 0}}";
            let run = node::StaticRun {
                script: node::decision_event(answer) + "\n",
                outcome: "served",
                model: model,
                input_tokens: 40,
            };
            return Scripted { script: run.script, result: node::result_message(id, run, 0, 0) };
        }
        let run = node::run_static(
            id,
            model,
            "echo",
            sent,
            node::static_config("{\"text\": \"hello from voice\", \"chunk_chars\": 8}"),
        );
        return Scripted { script: run.script, result: node::result_message(id, run, 0, 0) };
    }
}

/// A question answered as a decision server would: its first option likely.
fn generic(q: String) -> String {
    let t = std::json::find_string_field(q, "type");
    if t == "noul" { return "{\"type\": \"noul\", \"noul\": 0.8}"; }
    let crit = std::str::trim(std::json::find_field_raw(q, "criteria"));
    if t == "choice" {
        let mut it = std::json::object_first(crit);
        let first = std::json::obj_key_string(it, crit);
        let probs = st::JsonList { };
        let mut n = 0;
        while !it.done {
            probs.add(
                api::jq(std::json::obj_key_string(it, crit)) + ": "
                    + (if n == 0 { "0.9" } else { "0.05" }),
            );
            n = n + 1;
            it = std::json::object_next(it, crit);
        }
        return "{\"type\": \"choice\", \"choice\": " + api::jq(first)
            + ", \"confidence\": 0.9, \"probabilities\": {" + probs.text() + "}}";
    }
    let legend = st::JsonList { };
    let probs = st::JsonList { };
    let mut n = 0;
    let mut it = std::json::array_first(crit);
    while !it.done {
        legend.add(
            api::jq(to_string(n)) + ": "
                + api::jq(std::json::find_string_field(it.element, "label")),
        );
        probs.add(api::jq(to_string(n)) + ": " + (if n == 0 { "0.6" } else { "0.1" }));
        n = n + 1;
        it = std::json::array_next(it);
    }
    return "{\"type\": \"score\", \"score\": 0.5, \"confidence\": 0.5, \"legend\": {"
        + legend.text()
        + "}, \"probabilities\": {" + probs.text() + "}}";
}

/// One offer, scripted: its events, then its result.
locus Scripted {
    params {
        script: String = "";
        at: Int = 0;
        result: String = "";
        ended: Bool = false;
    }
    fn ack() -> api::ServeOutcome { return api::ServeOutcome { ack: "accepted" }; }
    @unbounded
    fn next(wait: Duration) -> api::LinkMsg {
        while self.at < len(self.script) {
            let rest = self.script[self.at..len(self.script)];
            let nl = std::str::index_of(rest, "\n");
            let line = if nl < 0 { rest } else { rest[0..nl] };
            self.at = self.at + (if nl < 0 { len(rest) } else { nl + 1 });
            if len(line) > 0 { return api::LinkMsg { kind: "event", json: line }; }
        }
        if !self.ended {
            self.ended = true;
            return api::LinkMsg { kind: "result", json: self.result };
        }
        std::time::sleep(wait);
        return api::LinkMsg { kind: "none" };
    }
    fn finish() { self.ended = true; }
}

fn ask(e: api::DataPlane, key: String, body: String) -> std::http::Response {
    return e.handle(
        std::http::Request {
            method: "POST",
            path: "/v1/responses",
            headers: "Authorization: Bearer " + key,
            body: body,
        },
    );
}

const CAPS: String = "{\"max_in_flight\": 4, \"engines\": [{\"id\": \"static\", \"kind\": \"static\", \"models\": null, \"config_schema\": {\"type\": \"object\", \"required\": [\"text\"]}}]}";
const LOCAL: String = "{\"paused\": false, \"paused_seats\": [], \"max_in_flight\": null, \"reason\": null}";

/// A node with one seat serving the chat model and the decision model, up.
fn bring_up(e: api::DataPlane) {
    let nodes = api::Nodes { store: e.store, link: e.link };
    let seats = api::Seats { store: e.store, link: e.link };
    let made = nodes.create(api::NodeCreate { id: "laptop" }) or api::Node {
        status: api::NodeStatus::pending,
    };
    let mut sc = api::SeatCreate {
        node: "laptop",
        id: "static",
        engine: "static",
        account: "static",
        config: std::json::Value::parse("{\"text\": \"hello from voice\"}")
        or std::json::Value::null(),
    };
    push(sc.serves, st::SeatModel { model: "echo-1", has_engine_name: true, engine_name: "echo" })
    or discard;
    push(sc.serves, st::SeatModel { model: "jev-2b" }) or discard;
    seats.create(sc) or {
        std::test::assert(false, "a seat: " + api::ctl_problem(err).message);
    };
    let reg = e.handle(
        std::http::Request {
            method: "POST",
            path: "/node/v1/register",
            headers: "Authorization: Bearer " + made.enrollment_token,
            body: "{\"protocol\": 2, \"version\": \"0.1.0\", \"capabilities\": " + CAPS
                + ", \"local\": " + LOCAL + "}",
        },
    );
    let version = std::json::find_int_field(
        std::json::find_field_raw(reg.body, "assignment"),
        "version",
    );
    let up = e.handle(
        std::http::Request {
            method: "POST",
            path: "/node/v1/seats",
            headers: "Authorization: Bearer " + made.enrollment_token,
            body: "{\"assignment_version\": " + to_string(version)
                + ", \"seats\": [{\"id\": \"static\", \"status\": \"up\", \"in_flight\": 0}]}",
        },
    );
    std::test::assert_eq_int(up.status, 204, "the seat is up: " + up.body);
}

/// Its annotation, read as the admin plane reads it.
fn read(annotations: api::Annotations, id: String) -> api::Annotation {
    return annotations.get(api::AnnotationRef { request_id: id }) or api::Annotation { };
}

/// One answer of an annotation.
fn answer_of(a: api::Annotation, annotator: String, question: String) -> api::AnnotationAnswer {
    for x in a.answers {
        if x.annotator == annotator && x.question == question { return x; }
    }
    return api::AnnotationAnswer { };
}

fn pair_of(a: api::Annotation, rule: String) -> api::AnnotationPair {
    for p in a.pairs {
        if p.rule == rule { return p; }
    }
    return api::AnnotationPair { };
}

fn refused(r: String, what: String, has: String) {
    std::test::assert(std::str::contains(r, has), what + ": " + r);
}

const CUSTOM: String = """
    [{"name": "language", "type": "choice", "instructions": "What language is the code in?",
      "options": [{"value": "python"}, {"value": "go", "description": "Go"}],
      "condition": {"annotator": "request-basics", "question": "task", "answer": "code", "min_probability": 0.7}},
     {"name": "debugged", "type": "noul", "instructions": "Did it find the fault?",
      "condition": {"annotator": "request-basics", "question": "task", "answer": "debug", "min_probability": 0.7}},
     {"name": "polish", "type": "score", "instructions": "How polished is it?",
      "options": [{"value": "1"}, {"value": "2"}, {"value": "3"}]}]
    """;

/// `n` yes-or-no questions, as JSON.
fn many_questions(n: Int) -> String {
    let out = st::JsonList { };
    let mut i = 0;
    while i < n {
        out.add(
            "{\"name\": \"q" + to_string(i)
                + "\", \"type\": \"noul\", \"instructions\": \"Question " + to_string(i) + "?\"}",
        );
        i = i + 1;
    }
    return "[" + out.text() + "]";
}

fn main() {
    let nodes = Nodes { };
    let e = api::DataPlane { link: nodes };
    let catalog = api::Catalog { store: e.store };
    let accounts = api::Accounts { store: e.store };
    let projects = api::Projects { store: e.store };
    let keys = api::Keys { store: e.store };
    let annotators = api::Annotators { store: e.store };
    let rules = api::AnnotationRules { store: e.store };
    let annotations = api::Annotations { store: e.store };
    catalog.create(api::CatalogModelCreate { id: "echo-1" }) or discard;
    catalog.create(
        api::CatalogModelCreate {
            id: "jev-2b",
            has_contract: true,
            contract: api::ModelContract::decision,
        },
    ) or discard;
    accounts.create(api::AccountCreate { id: "static", name: "Static" }) or discard;
    projects.create(api::ProjectCreate { id: "work", name: "Work", has_peek: true, peek: true })
    or discard;
    let key = (keys.create(api::KeyCreate { project: "work", name: "ci" }) or api::Key {
        status: api::KeyStatus::revoked,
    }).secret;
    bring_up(e);

    // voice ships its annotators and rules
    let shipped = annotators.list() or api::AnnotatorList { };
    std::test::assert_eq_int(count(shipped.data), 3, "three built-in annotators");
    for a in shipped.data {
        std::test::assert(
            a.builtin && a.version == 1 && a.enabled,
            "built in, at version 1: " + a.id,
        );
    }
    let titler = annotators.get(
        api::AnnotatorRef { annotator: "conversation-title" },
    ) or api::Annotator { };
    std::test::assert(
        titler.stage == api::AnnotatorStage::title && titler.has_title
            && titler.title.model == "general",
        "the title annotator, on the project's general model",
    );
    let shipped_rules = rules.list() or api::AnnotationRuleList { };
    std::test::assert_eq_int(count(shipped_rules.data), 4, "four built-in rules");

    // every project has its own system key, which no token names
    let held = keys.list(api::ProjectRef { project: "work" }) or api::KeyList { };
    let mut system = api::Key { status: api::KeyStatus::revoked };
    for k in held.data {
        if k.id == "work-system" { system = k; }
    }
    std::test::assert(system.internal && system.name == "work-system", "work's system key");
    let mut bad = "";
    keys.revoke(api::KeyRef { project: "work", key: "work-system" }) or {
        bad = api::ctl_problem(err).message;
        api::Key { status: api::KeyStatus::revoked }
    };
    refused(bad, "a system key is never revoked", "never revoked");
    bad = "";
    keys.update(
        api::KeyUpdate { project: "work", key: "work-system", has_name: true, name: "x" },
    ) or {
        bad = api::ctl_problem(err).message;
        api::Key { status: api::KeyStatus::revoked }
    };
    refused(bad, "nor renamed", "system key");
    bad = "";
    keys.create(api::KeyCreate { project: "work", name: "work-system" }) or {
        bad = api::ctl_problem(err).message;
        api::Key { status: api::KeyStatus::revoked }
    };
    refused(bad, "no other key takes its name", "system key");

    // annotate is refused with no decision model behind `decide`
    bad = "";
    projects.update(api::ProjectUpdate { project: "work", has_annotate: true, annotate: true }) or {
        bad = api::ctl_problem(err).message;
        api::Project { status: api::Lifecycle::archived }
    };
    refused(bad, "no decision model, no annotating", "names none `decide`");
    bad = "";
    let mut wrong = api::ProjectUpdate {
        project: "work",
        has_aliases: true,
        has_annotate: true,
        annotate: true,
    };
    push(wrong.aliases, api::ModelAlias { name: "decide", model: "echo-1" }) or discard;
    projects.update(wrong) or {
        bad = api::ctl_problem(err).message;
        api::Project { status: api::Lifecycle::archived }
    };
    refused(bad, "a generative model is never asked", "not a decision model");
    bad = "";
    keys.create(api::KeyCreate { project: "work", name: "annotating", annotate: true }) or {
        bad = api::ctl_problem(err).message;
        api::Key { status: api::KeyStatus::revoked }
    };
    refused(bad, "nor does a key annotate without one", "names none `decide`");
    std::test::assert_eq_int(nodes.decisions, 0, "nothing asked");

    // the project's decision model and text model: annotating
    let mut decide = api::ProjectUpdate {
        project: "work",
        has_aliases: true,
        has_annotate: true,
        annotate: true,
    };
    push(decide.aliases, api::ModelAlias { name: "decide", model: "jev-2b" }) or discard;
    push(decide.aliases, api::ModelAlias { name: "general", model: "echo-1" }) or discard;
    let on = projects.update(decide) or {
        std::test::assert(false, "annotate on: " + api::ctl_problem(err).message);
        api::Project { status: api::Lifecycle::archived }
    };
    std::test::assert(on.annotates, "it annotates");
    let r = ask(
        e,
        key,
        "{\"model\": \"echo-1\", \"prompt_cache_key\": \"conv-1\", \"instructions\": \"Answer in Python.\", \"input\": [{\"type\": \"message\", \"role\": \"user\", \"content\": \"write me a sort function\"}]}",
    );
    std::test::assert_eq_int(r.status, 200, "answered: " + r.body);
    let id = std::json::find_string_field(r.body, "id");
    let a = read(annotations, id);
    std::test::assert(a.status == api::AnnotationStatus::annotated, "annotated: " + a.reason);
    std::test::assert_eq_int(nodes.decisions, 2, "one decision request a stage");
    std::test::assert(a.has_conversation && a.conversation == "conv-1", "its conversation");
    std::test::assert(!a.clipped, "nothing cut");
    std::test::assert_eq_int(count(a.answers), 12, "every built-in question answered");
    std::test::assert_eq_int(a.input_tokens, 80, "what the questions read");
    std::test::assert(
        std::str::contains(nodes.last_state, "write me a sort function")
            && std::str::contains(nodes.last_state, "hello from voice"),
        "the response read beside the request: " + nodes.last_state,
    );
    // each run kept: the two stages, then the title
    std::test::assert_eq_int(count(a.runs), 3, "three runs");
    let stage1 = at(a.runs, 0) or api::AnnotationRun { };
    std::test::assert(
        stage1.stage == "request" && stage1.status == "annotated" && stage1.model == "jev-2b"
            && stage1.input_tokens == 40 && count(stage1.annotators) == 1,
        "the request stage's run: " + stage1.reason,
    );
    let titled = at(a.runs, 2) or api::AnnotationRun { };
    std::test::assert(
        titled.stage == "title" && titled.status == "annotated",
        "the title's run: " + titled.reason,
    );
    // the conversation's title
    std::test::assert(a.has_title && a.title == "hello from voice", "titled: " + a.title);
    let titles = annotations.titles(
        api::ConversationAsk { project: "work" },
    ) or api::ConversationTitleList { };
    let t1 = at(titles.data, 0) or api::ConversationTitle { };
    std::test::assert(
        count(titles.data) == 1 && t1.conversation == "conv-1" && t1.title == "hello from voice"
            && t1.task == "code" && t1.annotator == "conversation-title",
        "listed, with the task it was written under",
    );
    // the same task again: no new title
    let again = ask(
        e,
        key,
        "{\"model\": \"echo-1\", \"prompt_cache_key\": \"conv-1\", \"input\": \"and sort it backwards\"}",
    );
    let a_again = read(annotations, std::json::find_string_field(again.body, "id"));
    std::test::assert(
        count(a_again.runs) == 2 && !a_again.has_title,
        "a conversation's title is written once a task",
    );
    let task = answer_of(a, "request-basics", "task");
    std::test::assert(
        task.answer == "code" && task.probability == 0.85 && task.version == 1,
        "a choice, its probability, its version",
    );
    let code = answer_of(a, "request-basics", "asks_for_code");
    std::test::assert(
        code.answer == "true" && code.probability == 0.9,
        "a yes or no as true or false",
    );
    let hard = answer_of(a, "request-basics", "difficulty");
    std::test::assert(
        hard.answer == "3" && hard.has_score && hard.score > 2.99 && hard.score < 3.01,
        "a score by its level, and its expected level",
    );
    std::test::assert(!task.conditioned && !task.skipped, "independent, asked");
    // the rules, scored
    let gave = pair_of(a, "asked-for-code");
    std::test::assert(gave.applies && !gave.met, "asked for code, gave none: missed");
    std::test::assert(pair_of(a, "answered").met, "answered: met");
    // a built-in rule's condition is read, and a condition that does not hold
    // makes it not apply
    let shipped_code = rules.get(
        api::AnnotationRuleRef { rule: "asked-for-code" },
    ) or api::AnnotationRule { };
    std::test::assert(
        shipped_code.has_condition && shipped_code.condition.question == "asks_for_code",
        "the built-in rule's condition",
    );
    let mut strict = shipped_code.condition;
    strict.min_probability = 0.95;
    rules.update(
        api::AnnotationRuleUpdate {
            rule: "asked-for-code",
            has_condition: true,
            condition: strict,
        },
    ) or {
        std::test::assert(false, "the rule tightened: " + api::ctl_problem(err).message);
        api::AnnotationRule { }
    };
    std::test::assert(
        !pair_of(read(annotations, id), "asked-for-code").applies,
        "its condition not holding, it does not apply",
    );
    strict.min_probability = 0.5;
    rules.update(
        api::AnnotationRuleUpdate {
            rule: "asked-for-code",
            has_condition: true,
            condition: strict,
        },
    ) or discard;
    let steps = pair_of(a, "several-steps-complete");
    std::test::assert(
        steps.applies && steps.met && steps.probability > 0.84 && steps.probability < 0.86,
        "several steps, complete: levels 3 and 4 together",
    );

    // the system key's usage is kept apart from the project's
    let usage = api::Usage { store: e.store };
    let mine = usage.list(api::UsageAsk { project: "work" }) or api::UsageList { };
    std::test::assert_eq_int(
        count(mine.data),
        2,
        "the project's usage is its callers' requests alone",
    );
    let all = usage.list(
        api::UsageAsk { project: "work", include_internal: true },
    ) or api::UsageList { };
    std::test::assert_eq_int(count(all.data), 7, "and voice's five for it, asked for");
    let theirs = usage.list(api::UsageAsk { key: "work-system" }) or api::UsageList { };
    std::test::assert_eq_int(count(theirs.data), 5, "by its system key");
    std::test::assert((at(theirs.data, 0) or api::UsageRecord { }).internal, "marked internal");
    let both = usage.list(
        api::UsageAsk {
            metadata: "{\"annotates\": \"" + id + "\", \"side\": \"request\"}",
            include_internal: true,
        },
    ) or api::UsageList { };
    std::test::assert_eq_int(count(both.data), 1, "several metadata pairs, all matched");
    let summed = usage.summary(
        api::UsageSummaryAsk { group_by: "project" },
    ) or api::UsageSummary { };
    let g = at(summed.data, 0) or api::UsageGroupOut { };
    std::test::assert_eq_int(g.requests, 2, "the project's totals leave voice's out");
    // the account paid for both: its own line for voice's
    let paid = usage.summary(
        api::UsageSummaryAsk { group_by: "account,internal", include_internal: true },
    ) or api::UsageSummary { };
    let mut own = 0;
    let mut callers = 0;
    for x in paid.data {
        if std::str::contains(x.group.text, "\"internal\":\"true\"")
            || std::str::contains(x.group.text, "\"internal\": \"true\"")
        {
            own = own + x.requests;
        } else {
            callers = callers + x.requests;
        }
    }
    std::test::assert(
        own == 5 && callers == 2,
        "the account's spend, voice's own as its own line: " + to_string(own) + "/"
            + to_string(callers),
    );

    // its decision model gone: not annotated, saying why
    let mut gone = api::ProjectUpdate { project: "work", has_aliases: true };
    push(gone.aliases, api::ModelAlias { name: "decide", model: "echo-1" }) or discard;
    push(gone.aliases, api::ModelAlias { name: "general", model: "echo-1" }) or discard;
    projects.update(gone) or discard;
    let lost = ask(e, key, "{\"model\": \"echo-1\", \"input\": \"once more\"}");
    refused(
        read(annotations, std::json::find_string_field(lost.body, "id")).reason,
        "a generative model is never asked",
        "not a decision model",
    );
    projects.update(decide) or discard;
    let stats = annotators.stats(
        api::AnnotatorStatsAsk { annotator: "request-basics" },
    ) or api::AnnotatorStats { };
    std::test::assert(
        stats.runs == 2 && stats.annotated == 2 && stats.not_annotated == 1 && stats.has_last_error
            && std::str::contains(stats.last_error, "not a decision model"),
        "an annotator's runs, and why one was not made",
    );

    // searchable
    let coded = annotations.list(
        api::AnnotationAsk { answer: "request-basics.task=code" },
    ) or api::AnnotationList { };
    std::test::assert_eq_int(count(coded.data), 2, "by an answer");
    let likely = annotations.list(
        api::AnnotationAsk {
            answer: "{\"request-basics.task\": \"code\", \"response-basics.outcome\": \"answered\"}",
            min_probability: 0.9,
        },
    ) or api::AnnotationList { };
    std::test::assert_eq_int(count(likely.data), 0, "two answers, at a probability neither has");
    let in_conv = annotations.list(
        api::AnnotationAsk { conversation: "conv-1" },
    ) or api::AnnotationList { };
    std::test::assert_eq_int(count(in_conv.data), 2, "by conversation");
    let facets = annotations.facets(
        api::AnnotationFacetAsk { question: "response-basics.outcome" },
    ) or api::AnnotationFacets { };
    std::test::assert_eq_int(facets.total, 2, "each answer counted");
    let trend = annotations.trend(
        api::AnnotationTrendAsk { question: "request-basics.task", bucket: "hour" },
    ) or api::AnnotationTrend { };
    std::test::assert_eq_int(count(trend.points), 1, "by the hour");
    bad = "";
    annotations.list(api::AnnotationAsk { answer: "task=code" }) or {
        bad = api::ctl_problem(err).message;
        api::AnnotationList { }
    };
    refused(bad, "an answer names its annotator", "<annotator>.<question>");

    // an annotator of the operator's: conditioned questions, the request's answers read
    let made = annotators.create(
        api::AnnotatorCreate {
            id: "code-review",
            name: "Code review",
            stage: api::AnnotatorStage::response,
            questions: std::json::Value::parse(CUSTOM) or std::json::Value::null(),
            reads_request: true,
        },
    ) or {
        std::test::assert(false, "made: " + api::ctl_problem(err).message);
        api::Annotator { }
    };
    std::test::assert_eq_int(made.version, 1, "at version 1");
    let before_custom = nodes.decisions;
    let r2 = ask(e, key, "{\"model\": \"echo-1\", \"input\": \"write a parser\"}");
    let a2 = read(annotations, std::json::find_string_field(r2.body, "id"));
    std::test::assert_eq_int(
        nodes.decisions,
        before_custom + 3,
        "a stage for the request, two for the response: one reads the request's answers",
    );
    std::test::assert(
        std::str::contains(nodes.last_state, "request-basics.task: code"),
        "given the request's answers: " + nodes.last_state,
    );
    let lang = answer_of(a2, "code-review", "language");
    std::test::assert(
        lang.conditioned && !lang.skipped && lang.answer == "python",
        "asked, its condition holding; conditioned",
    );
    let debugged = answer_of(a2, "code-review", "debugged");
    std::test::assert(
        debugged.skipped && !debugged.has_answer,
        "not asked, its condition not holding: skipped",
    );
    std::test::assert(
        std::str::contains(nodes.asked, "code-review.language")
            && !std::str::contains(nodes.asked, "code-review.debugged"),
        "a skipped question is never asked",
    );

    // edited: a new version, the answers naming it
    let edited = annotators.update(
        api::AnnotatorUpdate { annotator: "code-review", has_name: true, name: "Code review v2" },
    ) or api::Annotator { };
    std::test::assert_eq_int(edited.version, 2, "a new version");
    let old = annotators.get(
        api::AnnotatorRef { annotator: "code-review", version: 1 },
    ) or api::Annotator { };
    std::test::assert(old.version == 1 && old.name == "Code review", "the old version, as it was");
    let r3 = ask(e, key, "{\"model\": \"echo-1\", \"input\": \"and a lexer\"}");
    std::test::assert_eq_int(
        answer_of(
            read(annotations, std::json::find_string_field(r3.body, "id")),
            "code-review",
            "polish",
        ).version,
        2,
        "answered by version 2",
    );

    // the limits a stage is held to
    bad = "";
    annotators.create(
        api::AnnotatorCreate {
            id: "too-many",
            name: "Too many",
            stage: api::AnnotatorStage::request,
            questions: std::json::Value::parse(many_questions(60)) or std::json::Value::null(),
        },
    ) or {
        bad = api::ctl_problem(err).message;
        api::Annotator { }
    };
    refused(bad, "64 questions a stage, across annotators", "at most 64 at once");
    bad = "";
    annotators.create(
        api::AnnotatorCreate {
            id: "early",
            name: "Early",
            stage: api::AnnotatorStage::request,
            questions: std::json::Value::parse(CUSTOM) or std::json::Value::null(),
        },
    ) or {
        bad = api::ctl_problem(err).message;
        api::Annotator { }
    };
    refused(
        bad,
        "a condition only at the response stage",
        "only a response question has a condition",
    );
    bad = "";
    annotators.update(api::AnnotatorUpdate { annotator: "code-review", has_stage: true }) or {
        bad = api::ctl_problem(err).message;
        api::Annotator { }
    };
    refused(bad, "a stage never changes", "stage never changes");

    // the built-ins: disabled, never removed
    bad = "";
    annotators.remove(api::AnnotatorRef { annotator: "response-basics" }) or {
        bad = api::ctl_problem(err).message;
        api::Annotator { }
    };
    refused(bad, "a built-in is never removed", "voice's own annotator");
    annotators.update(
        api::AnnotatorUpdate { annotator: "response-basics", has_enabled: true, enabled: false },
    ) or discard;
    nodes.asked = "";
    ask(e, key, "{\"model\": \"echo-1\", \"input\": \"hi\"}");
    std::test::assert(
        !std::str::contains(nodes.asked, "response-basics."),
        "a disabled annotator is not asked: " + nodes.asked,
    );
    annotators.remove(api::AnnotatorRef { annotator: "code-review" }) or discard;
    let after_removal = annotators.list() or api::AnnotatorList { };
    std::test::assert_eq_int(count(after_removal.data), 3, "an operator's annotator removed");
    annotators.update(
        api::AnnotatorUpdate { annotator: "response-basics", has_enabled: true, enabled: true },
    ) or discard;

    // a rule of the operator's, scored on annotations made before it
    let rule = rules.create(
        api::AnnotationRuleCreate {
            id: "hard-complete",
            name: "a hard one, wholly complete",
            has_condition: true,
            condition: api::AnnotationCondition {
                annotator: "request-basics",
                question: "difficulty",
                answer: "3",
                min_probability: 0.3,
            },
            expect: api::AnnotationExpect {
                annotator: "response-basics",
                question: "completeness",
                has_at_least: true,
                at_least: "4",
            },
        },
    ) or {
        std::test::assert(false, "a rule: " + api::ctl_problem(err).message);
        api::AnnotationRule { }
    };
    std::test::assert(rule.has_condition, "with its condition");
    std::test::assert(
        pair_of(read(annotations, id), "hard-complete").met,
        "scored on an annotation made before it",
    );
    bad = "";
    rules.create(
        api::AnnotationRuleCreate {
            id: "nonsense",
            name: "nonsense",
            expect: api::AnnotationExpect {
                annotator: "response-basics",
                question: "outcome",
                has_answer: true,
                answer: "maybe",
            },
        },
    ) or {
        bad = api::ctl_problem(err).message;
        api::AnnotationRule { }
    };
    refused(bad, "an answer a question cannot give", "has no answer maybe");

    // backfill: recorded requests asked by an annotator made since
    let fresh = annotators.create(
        api::AnnotatorCreate {
            id: "tone",
            name: "Tone",
            stage: api::AnnotatorStage::request,
            questions: std::json::Value::parse(
                "[{\"name\": \"polite\", \"type\": \"noul\", \"instructions\": \"Is it polite?\"}]",
            ) or std::json::Value::null(),
            enabled: false,
        },
    ) or api::Annotator { };
    std::test::assert(!fresh.enabled, "made disabled");
    let back = e.handle(
        std::http::Request {
            method: "POST",
            path: "/admin/v1/annotation-backfills",
            headers: "Authorization: Bearer " + (e.store.operator_token("va-annotate-test") or ""),
            body: "{\"annotator\": \"tone\", \"project\": \"work\"}",
        },
    );
    std::test::assert_eq_int(back.status, 202, "queued: " + back.body);
    std::test::assert(
        std::json::find_int_field(back.body, "queued") >= 1,
        "the recorded requests: " + back.body,
    );
    let after = read(annotations, id);
    let polite = answer_of(after, "tone", "polite");
    std::test::assert(polite.has_answer && polite.version == 1, "a past request asked by it");
    std::test::assert(
        answer_of(after, "request-basics", "task").answer == "code",
        "its other answers stay",
    );
    let nobody = e.handle(
        std::http::Request {
            method: "POST",
            path: "/admin/v1/annotation-backfills",
            body: "{\"annotator\": \"tone\"}",
        },
    );
    std::test::assert(
        nobody.status == 401 || nobody.status == 403,
        "backfill takes the operator token",
    );

    // a long request: read cut, and said so
    let long = std::str::repeat("lorem ipsum ", 3000);
    let r4 = ask(e, key, "{\"model\": \"echo-1\", \"input\": \"" + long + "\"}");
    std::test::assert(
        read(annotations, std::json::find_string_field(r4.body, "id")).clipped,
        "cut to fit, and said so",
    );
    std::test::assert(std::str::contains(nodes.last_state, "bytes left out"), "its middle marked");

    // the project's limits count its callers' requests, never voice's for it
    let mut capped = api::LimitsRequest { project: "work" };
    let cap = st::Limit {
        scope: st::LimitScope::project,
        window_seconds: 3600,
        has_requests: true,
        requests: 2,
    };
    push(capped.limits, cap) or discard;
    projects.set_limits(capped) or {
        std::test::assert(false, "capped: " + api::ctl_problem(err).message);
        api::LimitSet { }
    };
    let before_cap = nodes.decisions;
    let c1 = ask(e, key, "{\"model\": \"echo-1\", \"input\": \"one\"}");
    std::test::assert(nodes.decisions > before_cap, "annotated, by the system key");
    let c2 = ask(e, key, "{\"model\": \"echo-1\", \"input\": \"two\"}");
    std::test::assert(
        c1.status == 200 && c2.status == 200,
        "two of its own, past voice's: " + c2.body,
    );
    std::test::assert_eq_int(
        ask(e, key, "{\"model\": \"echo-1\", \"input\": \"three\"}").status,
        429,
        "its third is past its limit",
    );

    // a system key is no caller's, whatever a token says
    std::test::assert_eq_int(
        ask(e, "", "{\"model\": \"echo-1\", \"input\": \"x\"}").status,
        401,
        "no token, no caller",
    );
    let planted = e.store.key("work-system") or st::KeyRow { };
    std::test::assert(planted.internal && len(planted.digest) == 0, "its key holds no secret");
}
