// The api's front: one listener, one origin. The control plane (the probes
// and the admin plane) is the surface's rows, served by `http::Rest` from the
// routes they declare (surface.hl); every path no row serves goes to the
// data plane on the same listener and connection (endpoints.hl): the
// OpenAI-compatible inference wire, the node link, the admin event stream
// and the app. The exposure's gate (bearer, roles, `requires`) judges only
// the rows; the data plane authenticates its own callers.
//
// The front holds the store, the receivers of the rows and the data plane,
// so they share one pool and one store: fn main builds it over the store it
// was given.
locus Front {
    params {
        bind: String = "127.0.0.1:8080";
        ui: String = "";
        store: st::Store = st::MemoryStore { };
        link: Link = NatsLink { };
        held: HeldLimits = HeldLimits { };
        first_s: Int = 120;
        idle_s: Int = 30;
        pulse: Bool = false;
        governed: Bool = false;
        node_user: String = "";
        node_secret: std::secret::Credential = std::secret::Credential { };
        tokens: AdminBearer = AdminBearer { };
        grants: AdminRoles = AdminRoles { };
        probes: Probes = Probes { store: self.store };
        data_plane: Endpoints = Endpoints {
            ui: self.ui,
            store: self.store,
            link: self.link,
            held: self.held,
            node_user: self.node_user,
            node_secret: self.node_secret,
        };
        web: api::Exposure = api::serve(
            Voice,
            http::Rest {
                bind: self.bind,
                codec: json,
                principals: self.tokens,
                roles: self.grants,
                anonymous: "operator",
                fallback: self.data_plane,
            },
            as: "web",
            bound: 256,
            on_full: refuse
        );
    }
}
