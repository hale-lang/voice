// Budgets and limits, as configuration: the budget and limits rows of
// `Projects`, called on a receiver over a store; and the windows a budget
// counts in.
import ".." as api;
import "../../store" as st;

fn at(text: String) -> Time {
    return std::time::parse_time(text) or `1970-01-01T00:00:00Z`;
}

fn windows() {
    // a month counts from its anchor's day, and a short month ends on its last day
    let m = st::BudgetSet {
        allowance_micros: 5,
        period: st::Period::month,
        period_anchor: at("2026-01-31T00:00:00Z"),
    };
    let feb = api::budget_view(m, at("2026-02-15T12:00:00Z"));
    std::test::assert_eq_str(
        std::time::iso8601(feb.window_start),
        "2026-01-31T00:00:00Z",
        "the January window",
    );
    std::test::assert_eq_str(
        std::time::iso8601(feb.window_end),
        "2026-02-28T00:00:00Z",
        "ends on February's last day",
    );
    let mar = api::budget_view(m, at("2026-03-30T00:00:00Z"));
    std::test::assert_eq_str(
        std::time::iso8601(mar.window_start),
        "2026-02-28T00:00:00Z",
        "March's window starts on the 31st, not yet",
    );
    std::test::assert_eq_str(
        std::time::iso8601(mar.window_end),
        "2026-03-31T00:00:00Z",
        "so February's runs to it",
    );
    let dec = api::budget_view(m, at("2026-12-31T00:00:01Z"));
    std::test::assert_eq_str(
        std::time::iso8601(dec.window_start),
        "2026-12-31T00:00:00Z",
        "a year on",
    );
    std::test::assert_eq_str(
        std::time::iso8601(dec.window_end),
        "2027-01-31T00:00:00Z",
        "into the next year",
    );
    std::test::assert_eq_int(dec.remaining_micros, 5, "nothing is spent");

    let d = api::budget_view(
        st::BudgetSet {
            allowance_micros: 1,
            period: st::Period::day,
            period_anchor: at("2026-10-01T06:00:00Z"),
        },
        at("2026-10-17T05:00:00Z"),
    );
    std::test::assert_eq_str(
        std::time::iso8601(d.window_start),
        "2026-10-16T06:00:00Z",
        "a day counts from its anchor's hour",
    );
    let w = api::period_start(st::Period::week, at("2026-10-17T12:00:00Z"));
    std::test::assert_eq_str(
        std::time::iso8601(w),
        "2026-10-12T00:00:00Z",
        "a week starts on Monday",
    );
    std::test::assert_eq_str(
        std::time::iso8601(api::period_start(st::Period::month, at("2026-10-17T12:00:00Z"))),
        "2026-10-01T00:00:00Z",
        "a month on the 1st",
    );
    let n = api::budget_view(
        st::BudgetSet {
            allowance_micros: 1,
            period: st::Period::none,
            period_anchor: at("2026-01-01T00:00:00Z"),
        },
        at("2026-10-17T00:00:00Z"),
    );
    std::test::assert(!n.has_window_end, "a lifetime cap has no end");
    let early = api::budget_view(
        st::BudgetSet {
            allowance_micros: 1,
            period: st::Period::day,
            period_anchor: at("2026-11-01T06:00:00Z"),
        },
        at("2026-10-17T05:00:00Z"),
    );
    std::test::assert(
        early.has_window_end,
        "before its anchor, a day budget shows its first window",
    );
    std::test::assert_eq_str(
        std::time::iso8601(early.window_start),
        "2026-11-01T06:00:00Z",
        "which starts at the anchor",
    );
    std::test::assert_eq_str(
        std::time::iso8601(early.window_end),
        "2026-11-02T06:00:00Z",
        "and ends a day later",
    );
    let early_month = api::budget_view(
        st::BudgetSet {
            allowance_micros: 1,
            period: st::Period::month,
            period_anchor: at("2027-01-31T00:00:00Z"),
        },
        at("2026-10-17T05:00:00Z"),
    );
    std::test::assert_eq_str(
        std::time::iso8601(early_month.window_start),
        "2027-01-31T00:00:00Z",
        "a month's first window starts at its anchor",
    );
    std::test::assert_eq_str(
        std::time::iso8601(early_month.window_end),
        "2027-02-28T00:00:00Z",
        "and ends a month on",
    );
}

fn main() {
    windows();
    let store = st::MemoryStore { };
    let projects = api::Projects { store: store };
    let changes = api::Changes { store: store };
    projects.create(api::ProjectCreate { id: "work", name: "Work" }) or discard;
    let work = api::ProjectRef { project: "work" };

    let mut failed = "";
    projects.budget(work) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "no budget yet");
    failed = "";
    projects.budget(api::ProjectRef { project: "nope" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "an unknown project");
    let set = projects.set_budget(
        api::BudgetRequest {
            project: "work",
            allowance_micros: 50000000,
            period: st::Period::month,
        },
    ) or api::Budget { allowance_micros: -1 };
    std::test::assert_eq_str(set.currency, "USD", "currency defaults to USD");
    std::test::assert(
        std::str::ends_with(std::time::iso8601(set.period_anchor), "-01T00:00:00Z"),
        "a month counts from the 1st",
    );
    std::test::assert_eq_int(set.remaining_micros, 50000000, "all of it remains");
    std::test::assert_eq_int(set.spent_micros, 0, "nothing spent");
    let back = projects.budget(work) or api::Budget { allowance_micros: -1 };
    std::test::assert_eq_int(back.allowance_micros, 50000000, "read it back");
    let life = projects.set_budget(
        api::BudgetRequest {
            project: "work",
            allowance_micros: 10,
            period: st::Period::none,
            has_period_anchor: true,
            period_anchor: `2026-01-01T00:00:00Z`,
        },
    ) or api::Budget { allowance_micros: -1 };
    std::test::assert_eq_int(life.allowance_micros, 10, "a lifetime cap");
    std::test::assert(!life.has_window_end, "has no window end");
    let shown = projects.get(work) or api::Project { status: api::Lifecycle::archived };
    std::test::assert(shown.has_budget, "the project has a budget");
    std::test::assert_eq_int(shown.budget.allowance_micros, 10, "the project shows it");
    failed = "";
    projects.set_budget(
        api::BudgetRequest { project: "work", allowance_micros: -1, period: st::Period::day },
    ) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid allowance_micros", "an allowance is at least 0");
    failed = "";
    projects.set_budget(
        api::BudgetRequest { project: "nope", allowance_micros: 1, period: st::Period::day },
    ) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "a budget needs its project");
    let kept = projects.budget(work) or api::Budget { allowance_micros: -1 };
    std::test::assert_eq_int(kept.allowance_micros, 10, "a refused budget changed nothing");

    let none = projects.limits(work) or api::LimitSet { source: api::LimitSource::practice };
    std::test::assert_eq_int(count(none.limits), 0, "no limits yet");
    std::test::assert(none.source == api::LimitSource::stored, "none yet, as stored");
    std::test::assert(!none.has_practice, "from no practice");

    let mut put = api::LimitsRequest { project: "work" };
    push(
        put.limits,
        st::counted(
            st::Limit {
                scope: st::LimitScope::project,
                window_seconds: 60,
                requests: 600,
                output_tokens: 200000,
                concurrent: 16,
            },
        ),
    ) or discard;
    push(
        put.limits,
        st::counted(
            st::Limit {
                scope: st::LimitScope::model,
                model: "echo-1",
                window_seconds: 3600,
                requests: 200,
            },
        ),
    ) or discard;
    let limits = projects.set_limits(put) or api::LimitSet { source: api::LimitSource::practice };
    std::test::assert_eq_int(count(limits.limits), 2, "replace them");
    let mut first = true;
    for l in limits.limits {
        if first {
            std::test::assert_eq_int(l.requests, 600, "a count");
            std::test::assert(
                l.has_requests && l.has_output_tokens && l.has_concurrent,
                "counts set",
            );
            std::test::assert(!l.has_input_tokens, "a count left out is unlimited");
            std::test::assert_eq_int(l.concurrent, 16, "another count");
        }
        first = false;
    }
    let shown_limits = projects.get(work) or api::Project { status: api::Lifecycle::archived };
    let mut model_limit = false;
    for l in shown_limits.limits {
        if l.model == "echo-1" { model_limit = true; }
    }
    std::test::assert(model_limit, "the project shows them");
    let read = projects.limits(work) or api::LimitSet { source: api::LimitSource::practice };
    std::test::assert_eq_int(count(read.limits), 2, "and the row reads them back");

    let mut key_scope = api::LimitsRequest { project: "work" };
    push(key_scope.limits, st::Limit { scope: st::LimitScope::key, window_seconds: 60 }) or discard;
    failed = "";
    projects.set_limits(key_scope) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a key limit lives on its key");
    let mut no_model = api::LimitsRequest { project: "work" };
    push(
        no_model.limits,
        st::Limit { scope: st::LimitScope::model, window_seconds: 60 },
    ) or discard;
    failed = "";
    projects.set_limits(no_model) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a model limit names its model");
    let mut named = api::LimitsRequest { project: "work" };
    push(
        named.limits,
        st::Limit { scope: st::LimitScope::project, model: "echo-1", window_seconds: 60 },
    ) or discard;
    failed = "";
    projects.set_limits(named) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "only a model limit names a model");
    let mut instant = api::LimitsRequest { project: "work" };
    push(
        instant.limits,
        st::Limit { scope: st::LimitScope::project, window_seconds: 0 },
    ) or discard;
    failed = "";
    projects.set_limits(instant) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a window is at least a second");
    failed = "";
    projects.set_limits(api::LimitsRequest { project: "nope" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "limits need their project");
    let still = projects.limits(work) or api::LimitSet { source: api::LimitSource::practice };
    std::test::assert_eq_int(count(still.limits), 2, "refused limits changed nothing");

    let cleared = projects.set_limits(api::LimitsRequest { project: "work" }) or api::LimitSet {
        source: api::LimitSource::practice,
    };
    std::test::assert_eq_int(count(cleared.limits), 0, "an empty set clears them");
    std::test::assert(cleared.source == api::LimitSource::stored, "as stored");

    // each write is a change in the log, under its own target
    let log = changes.list(
        api::ChangeAsk { target: "projects/work/limits" },
    ) or api::ChangeList { };
    std::test::assert_eq_int(count(log.data), 2, "two limit writes logged");
    let budget_log = changes.list(
        api::ChangeAsk { target: "projects/work/budget" },
    ) or api::ChangeList { };
    std::test::assert_eq_int(count(budget_log.data), 2, "two budget writes logged");
}
