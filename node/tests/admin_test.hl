// The admin API's seat handling, in process, against a temporary data dir.
import ".." as node;

fn main() {
    // merge: patch wins, new keys are added, nested values are replaced whole
    std::test::assert_eq_str(node::merge_objects("{\"a\": 1, \"b\": {\"c\": 2}}", "{\"b\": {\"d\": 3}, \"e\": true}"), "{\"a\": 1, \"b\": {\"d\": 3}, \"e\": true}", "merge");
    std::test::assert_eq_str(node::top_value("{\"a\": [1, 2]}", "a"), "[1, 2]", "top_value");
    std::test::assert_eq_str(node::top_value("{\"a\": 1}", "b"), "", "top_value absent");

    std::test::assert(node::is_slug("claude-work"), "slug");
    std::test::assert(!node::is_slug("-x"), "slug cannot start with a dash");
    std::test::assert(!node::is_slug("Work"), "slug is lowercase");

    let good = "{\"id\": \"static\", \"engine\": \"static\", \"account\": \"static\", \"serves\": [{\"model\": \"echo-1\"}], \"config\": {\"text\": \"hi\"}}";
    std::test::assert_eq_str(node::seat_problem(good), "", "a valid seat");
    std::test::assert(len(node::seat_problem("{\"id\": \"s\", \"engine\": \"static\", \"account\": \"a\", \"serves\": [], \"config\": {\"text\": \"hi\"}}")) > 0, "empty serves");
    std::test::assert(len(node::seat_problem("{\"id\": \"s\", \"engine\": \"static\", \"account\": \"a\", \"serves\": [{\"model\": \"m\"}], \"config\": {}}")) > 0, "static needs text");

    let dir = "/tmp/voice-node-test-" + to_string(std::process::pid());
    std::io::fs::mkdir(dir) or discard;
    std::io::fs::mkdir(dir + "/seats") or discard;
    std::test::assert(std::io::fs::file_exists(dir + "/seats"), "temp dir");
    let api = node::AdminApi { id: "laptop", data: dir, seats: node::Seats { dir: dir + "/seats" } };
    std::test::assert_eq_int(api.handle(std::http::Request { method: "POST", path: "/node/v1/seats", body: good }).status, 201, "create");
    std::test::assert_eq_int(api.handle(std::http::Request { method: "POST", path: "/node/v1/seats", body: good }).status, 409, "duplicate");
    let patched = api.handle(std::http::Request { method: "PATCH", path: "/node/v1/seats/static", body: "{\"enabled\": false}" });
    std::test::assert_eq_str(std::json::find_string_field(patched.body, "status"), "disabled", "disable");
    std::test::assert_eq_int(api.handle(std::http::Request { method: "DELETE", path: "/node/v1/seats/static" }).status, 200, "remove");
    std::test::assert_eq_int(api.handle(std::http::Request { method: "GET", path: "/node/v1/seats/static" }).status, 404, "gone");
}
