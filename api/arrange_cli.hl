// `api arrange plan`: a plan for the fleet, asked of the live api with the
// operator token and printed (arranger.hl `plan_text`). It writes to
// stdout: the plan is its product. Nothing is carried out.

/// How long the api is given to plan.
const ARRANGE_WITHIN_S: Int = 60;

/// `api arrange plan --wants FILE [--api URL] [--token-file FILE]
/// [--database URL] [--state DIR]`: post the wants in FILE (an
/// `ArrangementWants`) to the api at URL (`http://127.0.0.1:8080` by
/// default) and print the plan. The operator token is FILE's
/// (`--token-file`), or else read as `api admin-token` reads it.
fn arrange() -> Int {
    let cli = ArrangeCli { };
    return cli.plan();
}

/// `api arrange`'s work, in a locus of its own so what one run makes is
/// the run's.
locus ArrangeCli {
    fn plan() -> Int {
        let a = arrange_args();
        if len(a.problem) > 0 {
            log_error(a.problem, "");
            return 2;
        }
        let wants = a.wants;
        let base = if std::str::ends_with(a.api, "/") { a.api[0..(len(a.api) - 1)] } else { a.api };
        let token_file = a.token_file;
        let database = a.database;
        let state = a.state;
        let body = std::io::fs::read_file(wants) or {
            log_error("arrange plan: no file " + wants, "");
            return 1;
        };
        let mut token = "";
        if len(token_file) > 0 {
            token = std::str::trim(std::io::fs::read_file(token_file) or "");
        } else if len(granted_operator_entry()) > 0 {
            log_error(
                "arrange plan: the habitat holds the operator token: give it with --token-file",
                "",
            );
            return 1;
        } else {
            token = operator_token_for(st::database_or_habitat(database), state) or {
                log_error("arrange plan: " + err.message, "");
                return 1;
            };
        }
        let got = exchange(
            base + "/admin/v1/arrangement-plans",
            ARRANGE_WITHIN_S * 1s,
            "POST",
            "Content-Type: application/json\r\nAuthorization: Bearer " + token,
            body,
        );
        if got.status == 0 {
            log_error("arrange plan: the api did not answer: " + got.why, "");
            return 1;
        }
        if got.status != 200 {
            let invalid = std::json::find_field_raw(got.body, "Invalid");
            let said = std::json::find_string_field(invalid, "message");
            log_error(
                "arrange plan: the api refused it (" + to_string(got.status) + "): "
                    + (if len(said) > 0 { said } else { got.body }),
                "",
            );
            return 1;
        }
        let plan = ArrangementPlan::api_decode(got.body) or {
            log_error("arrange plan: the api's answer is not a plan", "");
            return 1;
        };
        print(plan_text(plan));
        return 0;
    }
}

/// `api arrange`'s arguments as read: its flags' values, or why they are
/// refused.
type ArrangeArgs {
    wants: String = "";
    api: String = "http://127.0.0.1:8080";
    token_file: String = "";
    database: String = "";
    state: String = "";
    problem: String = "";
}

/// The program's arguments (`api arrange plan ...`), as `arrange` reads
/// them.
fn arrange_args() -> ArrangeArgs {
    let mut out = ArrangeArgs {
        database: if std::env::var_exists("VOICE_DATABASE_URL") {
            std::env::var("VOICE_DATABASE_URL")
        } else {
            ""
        },
    };
    if std::env::args_count() < 3 || std::env::arg(2) != "plan" {
        out.problem = "usage: api arrange plan --wants FILE [--api URL] [--token-file FILE]";
        return out;
    }
    let mut i = 3;
    while i < std::env::args_count() {
        let flag = std::env::arg(i);
        let value = if i + 1 < std::env::args_count() { std::env::arg(i + 1) } else { "" };
        if flag == "--wants" {
            out.wants = value;
        } else if flag == "--api" {
            out.api = value;
        } else if flag == "--token-file" {
            out.token_file = value;
        } else if flag == "--database" {
            out.database = value;
        } else if flag == "--state" {
            out.state = value;
        } else {
            out.problem = "arrange plan: no flag " + flag;
            return out;
        }
        i = i + 2;
    }
    if len(out.wants) == 0 {
        out.problem = "arrange plan: --wants names the file of what the fleet is for";
    }
    return out;
}
