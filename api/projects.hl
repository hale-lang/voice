// Projects and their keys, with their budgets and limits, configured on
// the admin plane, and the caller plane's bearer: the project key a
// request presents. Every write records its change.

locus Projects {
    params {
        store: st::Store;
        // under a head the limits are the organization's practice: the
        // admin plane reads them through the head and cannot set them
        governed: Bool = false;
        // the ratified limits as the reader last read them (governance.hl)
        held: HeldLimits = HeldLimits { };
        // serializes the store's use across requests (store/lock.hl): the admin plane takes turns, a row at a time
        gate: st::Lock = st::Lock { };
    }

    /// `listProjects`.
    fn list(q: ProjectQuery) -> ProjectList fallible(CtlError) {
        self.gate.enter();
        let gated = self.list_in_gate(q) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `list`, inside the gate.
    fn list_in_gate(q: ProjectQuery) -> ProjectList fallible(CtlError) {
        let rows = self.store.projects() or fail store_down(err);
        let mut out = ProjectList { };
        for r in rows.rows {
            if q.include_archived || !r.archived {
                let v = self.view(r) or raise;
                push(out.data, v) or discard;
            }
        }
        return out;
    }

    /// `createProject`, with its budget and limits when the body sets them.
    fn create(c: ProjectCreate) -> Project fallible(CtlError) {
        self.gate.enter();
        let gated = self.create_in_gate(c) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `create`, inside the gate.
    fn create_in_gate(c: ProjectCreate) -> Project fallible(CtlError) {
        if !is_project_id(c.id) {
            fail bad(
                "`id` is lowercase letters, digits and dashes, starting with a letter or digit, at most 127",
                "id"
            );
        }
        check_name(c.name) or raise;
        check_limits(c.limits, "project,model", "limits") or raise;
        let mut row = st::ProjectRow {
            id: c.id,
            name: c.name,
            models: restriction_of(c.has_models, c.models),
            accounts: accounts_restriction(c.has_accounts, c.accounts) or raise,
            created_at: now_seconds()
        };
        row.owners.items = c.owners;
        row.data_classes.items = c.data_classes;
        row.limits.items = c.limits;
        if c.has_budget {
            let set = budget_set_of(
                c.budget.allowance_micros,
                c.budget.currency,
                c.budget.period,
                c.budget.has_period_anchor,
                c.budget.period_anchor,
            );
            check_budget(set) or raise;
            row.budgeted = true;
            row.budget = set;
        }
        if count(row.data_classes.items) == 0 {
            push(row.data_classes.items, "internal") or discard;
        }
        if c.has_parent {
            self.check_parent(c.id, c.parent) or raise;
            row.parent = c.parent;
            // with no accounts of its own, it spends its parent's
            if !c.has_accounts {
                row.inherits = true;
                row.accounts = st::Restriction { any: false };
            }
        }
        let v = self.view(row) or raise;
        let added = self.store.insert_project(
            row,
            checked_change("create", "projects/" + c.id, "", project_json(v)) or raise,
        ) or fail store_down(err);
        if !added { fail clash("project " + c.id + " exists; a project id is never reused"); }
        return v;
    }

    /// `getProject`.
    fn get(r: ProjectRef) -> Project fallible(CtlError) {
        self.gate.enter();
        let gated = self.get_in_gate(r) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `get`, inside the gate.
    fn get_in_gate(r: ProjectRef) -> Project fallible(CtlError) {
        let row = self.known(r.project) or raise;
        return self.view(row) or raise;
    }

    /// `updateProject`: the fields the request sets.
    fn update(u: ProjectUpdate) -> Project fallible(CtlError) {
        self.gate.enter();
        let gated = self.update_in_gate(u) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `update`, inside the gate.
    fn update_in_gate(u: ProjectUpdate) -> Project fallible(CtlError) {
        if u.has_id { fail bad("a project's `id` cannot change", "id"); }
        if u.has_budget {
            fail no_support(
                "`budget` is not taken here: a budget has its own endpoint, PUT /admin/v1/projects/{project}/budget",
                "budget"
            );
        }
        if u.has_limits {
            fail no_support(
                "`limits` is not taken here: limits have their own endpoint, PUT /admin/v1/projects/{project}/limits",
                "limits"
            );
        }
        self.store.hold("projects/" + u.project) or fail store_down(err);
        let out = self.update_held(u) or {
            self.store.let_go();
            fail err;
        };
        self.store.let_go();
        return out;
    }

    /// `update`, holding the resource from its read to its write.
    fn update_held(u: ProjectUpdate) -> Project fallible(CtlError) {
        let mut row = self.known(u.project) or raise;
        let before = self.view(row) or raise;
        if u.has_name {
            check_name(u.name) or raise;
            row.name = u.name;
        }
        if u.has_owners { row.owners.items = u.owners; }
        if u.has_data_classes { row.data_classes.items = u.data_classes; }
        if u.has_models || u.clear_models { row.models = restriction_of(u.has_models, u.models); }
        // its parent first, so the same change may make it inherit
        if u.has_parent {
            self.check_parent(row.id, u.parent) or raise;
            row.parent = u.parent;
        } else if u.clear_parent && len(row.parent) > 0 {
            // made a project of its own, it keeps what it spent
            if row.inherits {
                let was = as_in_force(self.store, row) or fail store_down(err);
                row.accounts = was.accounts;
                row.inherits = false;
            }
            row.parent = "";
        }
        if u.has_accounts || u.clear_accounts {
            row.accounts = accounts_restriction(u.has_accounts, u.accounts) or raise;
            // a child given accounts of its own is narrowed: it no longer
            // inherits its parent's
            row.inherits = false;
        }
        if u.has_inherits {
            // a tenant from before the habitat named its callers is made its
            // child first
            if u.inherits && len(row.parent) == 0 {
                let h = ensure_habitat(self.store) or fail store_down(err);
                if len(h) > 0 && is_legacy_tenant(row, h) { row.parent = h; }
            }
            if u.inherits && len(row.parent) == 0 {
                fail bad(
                    "a project inherits its parent's accounts, and " + row.id + " has no parent",
                    "inherits"
                );
            }
            row.inherits = u.inherits;
            if u.inherits { row.accounts = st::Restriction { any: false }; }
        }
        // a child's keys are held to the accounts it spends: its parent's
        // when it inherits
        let spending = as_in_force(self.store, row) or fail store_down(err);
        self.keys_within(spending) or raise;
        let after = self.view(row) or raise;
        self.store.update_project(
            row,
            checked_change(
                "update",
                "projects/" + row.id,
                project_json(before),
                project_json(after),
            ) or raise,
        ) or fail store_down(err);
        return after;
    }

    /// Refused unless `parent` may be `id`'s: a project, not archived, not
    /// `id` itself, and of no parent of its own, with `id` a parent of none
    /// (one level: a habitat and its callers, a team and its projects).
    fn check_parent(id: String, parent: String) -> Bool fallible(CtlError) {
        if parent == id { fail bad("a project is not its own parent", "parent"); }
        let p = self.store.project(parent) or fail store_down(err);
        if !p.present { fail bad("no project " + parent, "parent"); }
        if p.archived { fail bad("project " + parent + " is archived", "parent"); }
        if len(p.parent) > 0 {
            fail bad(
                "project " + parent + " is itself a child of " + p.parent
                    + ": a parent is a project of its own",
                "parent"
            );
        }
        let all = self.store.projects() or fail store_down(err);
        for r in all.rows {
            if r.parent == id {
                fail bad(
                    "project " + id + " is the parent of " + r.id
                        + ": a parent is a project of its own",
                    "parent"
                );
            }
        }
        return true;
    }

    /// `archiveProject`: its keys are revoked and it refuses new requests;
    /// the id stays taken. Archiving an archived project changes nothing.
    fn archive(r: ProjectRef) -> Project fallible(CtlError) {
        self.gate.enter();
        let gated = self.archive_in_gate(r) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `archive`, inside the gate.
    fn archive_in_gate(r: ProjectRef) -> Project fallible(CtlError) {
        self.store.hold("projects/" + r.project) or fail store_down(err);
        let out = self.archive_held(r) or {
            self.store.let_go();
            fail err;
        };
        self.store.let_go();
        return out;
    }

    /// `archive`, holding the resource from its read to its write.
    fn archive_held(r: ProjectRef) -> Project fallible(CtlError) {
        let mut row = self.known(r.project) or raise;
        if row.archived { return self.view(row) or raise; }
        let before = self.view(row) or raise;
        row.archived = true;
        row.archived_at = now_seconds();
        let mut after = self.view(row) or raise;
        let keys = self.store.keys(row.id) or fail store_down(err);
        let mut revoked = st::Revocations { };
        for k in keys.rows {
            if !k.revoked {
                let was = key_view(k, row.archived_at);
                let mut gone = k;
                gone.revoked = true;
                gone.revoked_at = row.archived_at;
                push(
                    revoked.changes,
                    checked_change(
                        "revoke",
                        key_target(gone),
                        key_json(was),
                        key_json(key_view(gone, row.archived_at)),
                    ) or raise,
                ) or discard;
                push(revoked.keys, gone) or discard;
            }
        }
        self.store.archive_project(
            row,
            checked_change(
                "archive",
                "projects/" + row.id,
                project_json(before),
                project_json(after),
            ) or raise,
            revoked,
        ) or fail store_down(err);
        return after;
    }

    /// `getBudget`: the budget in its current window; 404 when the project
    /// has none.
    fn budget(r: ProjectRef) -> Budget fallible(CtlError) {
        self.gate.enter();
        let gated = self.budget_in_gate(r) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `budget`, inside the gate.
    fn budget_in_gate(r: ProjectRef) -> Budget fallible(CtlError) {
        let row = self.known(r.project) or raise;
        if !row.budgeted { fail missing("project " + r.project + " has no budget"); }
        return budget_view(row.budget, now_seconds());
    }

    /// `setBudget`: replaces the allowance and the period.
    fn set_budget(b: BudgetRequest) -> Budget fallible(CtlError) {
        self.gate.enter();
        let gated = self.set_budget_in_gate(b) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `set_budget`, inside the gate.
    fn set_budget_in_gate(b: BudgetRequest) -> Budget fallible(CtlError) {
        self.store.hold("projects/" + b.project) or fail store_down(err);
        let out = self.set_budget_held(b) or {
            self.store.let_go();
            fail err;
        };
        self.store.let_go();
        return out;
    }

    /// `set_budget`, holding the resource from its read to its write.
    fn set_budget_held(b: BudgetRequest) -> Budget fallible(CtlError) {
        let mut row = self.known(b.project) or raise;
        let set = budget_set_of(
            b.allowance_micros,
            b.currency,
            b.period,
            b.has_period_anchor,
            b.period_anchor,
        );
        check_budget(set) or raise;
        let now = now_seconds();
        let before = if row.budgeted { budget_json(budget_view(row.budget, now)) } else { "" };
        row.budgeted = true;
        row.budget = set;
        let after = budget_view(row.budget, now);
        self.store.update_project(
            row,
            checked_change(
                if len(before) > 0 { "update" } else { "create" },
                "projects/" + row.id + "/budget",
                before,
                budget_json(after),
            ) or raise,
        ) or fail store_down(err);
        return after;
    }

    /// `getLimits`: the project- and model-scope limits.
    fn limits(r: ProjectRef) -> LimitSet fallible(CtlError) {
        self.gate.enter();
        let gated = self.limits_in_gate(r) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `limits`, inside the gate.
    fn limits_in_gate(r: ProjectRef) -> LimitSet fallible(CtlError) {
        let row = self.known(r.project) or raise;
        if self.governed { return self.ratified(r.project) or raise; }
        let mut out = LimitSet { };
        out.limits = row.limits.items;
        return out;
    }

    /// `project`'s limits as the organization ratified them (under a head),
    /// as last read: its practice's limit, or none, and where it was read
    /// from.
    fn ratified(project: String) -> LimitSet fallible(CtlError) {
        if !limits_landed(self.held) { fail limits_unread(); }
        let pl = held_limit(self.held, project);
        if pl.closed { fail limit_unknown(pl); }
        let mut out = LimitSet { source: LimitSource::practice };
        if len(pl.project) > 0 {
            push(out.limits, pl.limit) or discard;
            out.has_practice = true;
            out.practice = PracticeRef { name: pl.name, id: pl.id };
        }
        return out;
    }

    /// `setLimits`: replaces them.
    fn set_limits(l: LimitsRequest) -> LimitSet fallible(CtlError) {
        self.gate.enter();
        let gated = self.set_limits_in_gate(l) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `set_limits`, inside the gate.
    fn set_limits_in_gate(l: LimitsRequest) -> LimitSet fallible(CtlError) {
        if self.governed {
            fail clash(
                "limits are the organization's practice: propose `operating/limits/" + l.project
                    + "` and the Board decides it"
            );
        }
        self.store.hold("projects/" + l.project) or fail store_down(err);
        let out = self.set_limits_held(l) or {
            self.store.let_go();
            fail err;
        };
        self.store.let_go();
        return out;
    }

    /// `set_limits`, holding the resource from its read to its write.
    fn set_limits_held(l: LimitsRequest) -> LimitSet fallible(CtlError) {
        let mut row = self.known(l.project) or raise;
        check_limits(l.limits, "project,model", "limits") or raise;
        let before = limits_json(row.limits.items);
        row.limits.items = l.limits;
        self.store.update_project(
            row,
            checked_change(
                "update",
                "projects/" + row.id + "/limits",
                "{\"limits\": " + before + "}",
                "{\"limits\": " + limits_json(row.limits.items) + "}",
            ) or raise,
        ) or fail store_down(err);
        let mut out = LimitSet { };
        out.limits = row.limits.items;
        return out;
    }

    fn known(id: String) -> st::ProjectRow fallible(CtlError) {
        let row = self.store.project(id) or fail store_down(err);
        if !row.present { fail missing("no project " + id); }
        return row;
    }

    /// A project's restrictions hold every key it has that is not revoked:
    /// narrowing them below what a key names is refused, naming the keys,
    /// so a key is never left wider than its project.
    fn keys_within(p: st::ProjectRow) -> Bool fallible(CtlError) {
        let keys = self.store.keys(p.id) or fail store_down(err);
        let mut models = "";
        let mut accounts = "";
        for k in keys.rows {
            if !k.revoked {
                let m = within(p.models, k.models, "models") or false;
                if !m { models = if len(models) == 0 { k.id } else { models + ", " + k.id }; }
                let a = within(p.accounts, k.accounts, "accounts") or false;
                if !a { accounts = if len(accounts) == 0 { k.id } else { accounts + ", " + k.id }; }
            }
        }
        if len(models) > 0 {
            fail bad(
                "`models` would leave out models that keys " + models
                    + " name; narrow those keys first",
                "models"
            );
        }
        if len(accounts) > 0 {
            fail bad(
                "`accounts` would leave out accounts that keys " + accounts
                    + " name; narrow those keys first",
                "accounts"
            );
        }
        return true;
    }

    fn view(r: st::ProjectRow) -> Project fallible(CtlError) {
        let keys = self.store.keys(r.id) or fail store_down(err);
        let mut v = Project {
            id: r.id,
            name: r.name,
            status: if r.archived { Lifecycle::archived } else { Lifecycle::active },
            has_models: !r.models.any,
            has_accounts: !r.accounts.any,
            has_budget: r.budgeted,
            budget: budget_view(r.budget, now_seconds()),
            key_count: count(keys.rows),
            has_position: len(r.position) > 0,
            position: r.position,
            created_at: r.created_at,
            has_archived_at: r.archived,
            archived_at: r.archived_at,
            has_parent: len(r.parent) > 0,
            parent: r.parent,
            inherits: r.inherits
        };
        v.models = r.models.names.items;
        v.accounts = r.accounts.names.items;
        v.owners = r.owners.items;
        v.data_classes = r.data_classes.items;
        v.limits = r.limits.items;
        return v;
    }
}

locus Keys {
    params {
        store: st::Store;
        // serializes the store's use across requests (store/lock.hl): the admin plane takes turns, a row at a time
        gate: st::Lock = st::Lock { };
    }

    /// `listKeys`. Secrets are never returned after creation.
    fn list(r: ProjectRef) -> KeyList fallible(CtlError) {
        self.gate.enter();
        let gated = self.list_in_gate(r) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `list`, inside the gate.
    fn list_in_gate(r: ProjectRef) -> KeyList fallible(CtlError) {
        self.project_of(r.project) or raise;
        let rows = self.store.keys(r.project) or fail store_down(err);
        let now = now_seconds();
        let mut out = KeyList { };
        for k in rows.rows {
            push(out.data, key_view(k, now)) or discard;
        }
        return out;
    }

    /// `createKey`: the secret is in this answer and nowhere else; the
    /// store keeps its digest.
    fn create(c: KeyCreate) -> Key fallible(CtlError) {
        self.gate.enter();
        let gated = self.create_in_gate(c) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `create`, inside the gate.
    fn create_in_gate(c: KeyCreate) -> Key fallible(CtlError) {
        self.store.hold("projects/" + c.project) or fail store_down(err);
        let out = self.create_held(c) or {
            self.store.let_go();
            fail err;
        };
        self.store.let_go();
        return out;
    }

    /// `create`, holding the resource from its read to its write.
    fn create_held(c: KeyCreate) -> Key fallible(CtlError) {
        let held = self.project_of(c.project) or raise;
        // a key is held within what its project spends: its parent's for an
        // inheriting child
        let p = as_in_force(self.store, held) or fail store_down(err);
        if p.archived {
            fail bad(
                "project " + c.project + " is archived, and an archived project takes no key",
                ""
            );
        }
        check_name(c.name) or raise;
        let models = restriction_of(c.has_models, c.models);
        let accounts = accounts_restriction(c.has_accounts, c.accounts) or raise;
        within(p.models, models, "models") or raise;
        within(p.accounts, accounts, "accounts") or raise;
        check_limits(c.limits, "key", "limits") or raise;
        let now = now_seconds();
        if c.has_expires_at && std::time::unix(c.expires_at) <= std::time::unix(now) {
            fail bad("`expires_at` is in the past", "expires_at");
        }
        let secret_hex = random_hex(20) or fail entropy_down(err.message);
        let id_hex = random_hex(8) or fail entropy_down(err.message);
        let secret = "vk-" + secret_hex;
        let id = "k_" + id_hex;
        let mut row = st::KeyRow {
            id: id,
            project: c.project,
            name: c.name,
            prefix: secret[0..7],
            digest: secret_digest(secret),
            models: models,
            accounts: accounts,
            created_at: now,
            expires: c.has_expires_at,
            expires_at: c.expires_at
        };
        row.limits.items = c.limits;
        let mut v = key_view(row, now);
        let added = self.store.insert_key(
            row,
            checked_change("create", key_target(row), "", key_json(v)) or raise,
        ) or fail store_down(err);
        if !added { fail entropy_down("key id " + id + " was drawn twice; ask again"); }
        v.has_secret = true;
        v.secret = secret;
        return v;
    }

    /// `getKey`.
    fn get(r: KeyRef) -> Key fallible(CtlError) {
        self.gate.enter();
        let gated = self.get_in_gate(r) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `get`, inside the gate.
    fn get_in_gate(r: KeyRef) -> Key fallible(CtlError) {
        let k = self.known(r.project, r.key) or raise;
        return key_view(k, now_seconds());
    }

    /// `updateKey`: the fields the request sets.
    fn update(u: KeyUpdate) -> Key fallible(CtlError) {
        self.gate.enter();
        let gated = self.update_in_gate(u) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `update`, inside the gate.
    fn update_in_gate(u: KeyUpdate) -> Key fallible(CtlError) {
        self.store.hold("projects/" + u.project) or fail store_down(err);
        let out = self.update_held(u) or {
            self.store.let_go();
            fail err;
        };
        self.store.let_go();
        return out;
    }

    /// `update`, holding the resource from its read to its write.
    fn update_held(u: KeyUpdate) -> Key fallible(CtlError) {
        let mut k = self.known(u.project, u.key) or raise;
        let held = self.project_of(u.project) or raise;
        // a key is held within what its project spends: its parent's for an
        // inheriting child
        let p = as_in_force(self.store, held) or fail store_down(err);
        let now = now_seconds();
        let before = key_view(k, now);
        if u.has_name {
            check_name(u.name) or raise;
            k.name = u.name;
        }
        if u.has_models || u.clear_models {
            let models = restriction_of(u.has_models, u.models);
            within(p.models, models, "models") or raise;
            k.models = models;
        }
        if u.has_accounts || u.clear_accounts {
            let accounts = accounts_restriction(u.has_accounts, u.accounts) or raise;
            within(p.accounts, accounts, "accounts") or raise;
            k.accounts = accounts;
        }
        if u.has_limits {
            check_limits(u.limits, "key", "limits") or raise;
            k.limits.items = u.limits;
        }
        if u.has_expires_at || u.clear_expires_at {
            k.expires = u.has_expires_at;
            k.expires_at = u.expires_at;
        }
        let after = key_view(k, now);
        self.store.update_key(
            k,
            checked_change("update", key_target(k), key_json(before), key_json(after)) or raise,
        ) or fail store_down(err);
        return after;
    }

    /// `revokeKey`: at once; revoking a revoked key changes nothing.
    fn revoke(r: KeyRef) -> Key fallible(CtlError) {
        self.gate.enter();
        let gated = self.revoke_in_gate(r) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `revoke`, inside the gate.
    fn revoke_in_gate(r: KeyRef) -> Key fallible(CtlError) {
        self.store.hold("projects/" + r.project) or fail store_down(err);
        let out = self.revoke_held(r) or {
            self.store.let_go();
            fail err;
        };
        self.store.let_go();
        return out;
    }

    /// `revoke`, holding the resource from its read to its write.
    fn revoke_held(r: KeyRef) -> Key fallible(CtlError) {
        let mut k = self.known(r.project, r.key) or raise;
        let now = now_seconds();
        if k.revoked { return key_view(k, now); }
        let before = key_view(k, now);
        k.revoked = true;
        k.revoked_at = now;
        let after = key_view(k, now);
        self.store.update_key(
            k,
            checked_change("revoke", key_target(k), key_json(before), key_json(after)) or raise,
        ) or fail store_down(err);
        return after;
    }

    fn project_of(id: String) -> st::ProjectRow fallible(CtlError) {
        let p = self.store.project(id) or fail store_down(err);
        if !p.present { fail missing("no project " + id); }
        return p;
    }

    /// The key `id` under `project`; a key of another project is not found.
    fn known(project: String, id: String) -> st::KeyRow fallible(CtlError) {
        self.project_of(project) or raise;
        let k = self.store.key(id) or fail store_down(err);
        if !k.present || k.project != project {
            fail missing("no key " + id + " in project " + project);
        }
        return k;
    }
}

/// The caller plane's bearer: an `Authorization: Bearer vk-...` header
/// names a key, which is the caller, as does a key the habitat drew for one
/// of its organisms (tenants.hl). A key that is revoked or expired, or
/// whose project is archived, names nobody.
locus KeyBearer {
    params { store: st::Store; }

    /// The caller a request's `Authorization` header names, as the
    /// handlers of the caller rows receive it. The key's `last_used_at` is
    /// written as it is used, at most once a minute, so a key making many
    /// requests does not write on each.
    fn context(authorization: String) -> std::api::Context fallible(ApiError) {
        if len(authorization) < 7 || std::str::lower(authorization[0..7]) != "bearer " {
            fail invalid_key();
        }
        let token = std::str::trim(authorization[7..len(authorization)]);
        if len(token) == 0 { fail invalid_key(); }
        let digest = secret_digest(token);
        let mut k = self.store.key_by_digest(digest) or fail metering_failed(err);
        if k.present && is_tenant_key(k) {
            // a tenant's key holds while the habitat's member is still it
            if !tenant_holds(tenant_label(k), token) { fail invalid_key(); }
        } else if !k.present {
            // a tenant calling for the first time, or with a rotated key
            // (tenants.hl); anything else is no key
            let label = tenant_of(token);
            if len(label) == 0 { fail invalid_key(); }
            k = tenant_key(self.store, label, digest) or raise;
        }
        if key_status(k, now_seconds()) != KeyStatus::active { fail invalid_key(); }
        let p = self.store.project(k.project) or fail metering_failed(err);
        if !p.present || p.archived { fail invalid_key(); }
        let now = now_seconds();
        if !k.used || std::time::unix(now) - std::time::unix(k.last_used_at) >= 60 {
            self.store.touch_key(k.id, now) or fail metering_failed(err);
        }
        let who = std::api::Principal { mode: "bearer", name: k.id, via: "http" };
        return std::api::Context { caller: who, role: "caller", via: "http" };
    }
}

/// Where a key is, under /admin/v1.
fn key_target(k: st::KeyRow) -> String {
    return "projects/" + k.project + "/keys/" + k.id;
}

fn key_status(k: st::KeyRow, now: Time) -> KeyStatus {
    if k.revoked { return KeyStatus::revoked; }
    if k.expires && std::time::unix(k.expires_at) <= std::time::unix(now) {
        return KeyStatus::expired;
    }
    return KeyStatus::active;
}

fn key_view(k: st::KeyRow, now: Time) -> Key {
    let mut v = Key {
        id: k.id,
        project: k.project,
        name: k.name,
        prefix: k.prefix,
        has_models: !k.models.any,
        has_accounts: !k.accounts.any,
        created_at: k.created_at,
        has_expires_at: k.expires,
        expires_at: k.expires_at,
        has_last_used_at: k.used,
        last_used_at: k.last_used_at,
        status: key_status(k, now),
        has_revoked_at: k.revoked,
        revoked_at: k.revoked_at
    };
    v.models = k.models.names.items;
    v.accounts = k.accounts.names.items;
    v.limits = k.limits.items;
    return v;
}

/// A key's restriction must sit within its project's: a project that is
/// restricted to some names admits a key that names only those.
fn within(
    project: st::Restriction,
    key: st::Restriction,
    field: String
) -> Bool fallible(CtlError) {
    if project.any { return true; }
    if key.any { return true; }
    for n in key.names.items {
        if !has_name(project.names.items, n) {
            fail bad(
                "`" + field + "` names " + n + ", which the project does not allow",
                field
            );
        }
    }
    return true;
}

fn check_name(name: String) -> Bool fallible(CtlError) {
    if len(name) == 0 || len(name) > 128 { fail bad("`name` is 1 to 128 characters", "name"); }
    return true;
}

/// `^[a-z0-9][a-z0-9-]{0,62}$`: a project, account or node id.
fn is_slug(s: String) -> Bool { return is_slug_within(s, 63); }

/// A project's id: a slug of up to 127, room for a habitat's caller,
/// `<habitat>-<caller>`, each a DNS label of up to 63 (tenants.hl).
fn is_project_id(s: String) -> Bool { return is_slug_within(s, 127); }

fn is_slug_within(s: String, most: Int) -> Bool {
    let n = len(s);
    if n == 0 || n > most { return false; }
    let v = std::str::bytes_view(s);
    let mut i = 0;
    while i < n {
        let b = std::str::byte_at(v, i);
        let lower = b >= 97 && b <= 122;
        let digit = b >= 48 && b <= 57;
        if !(lower || digit || (b == 45 && i > 0)) { return false; }
        i = i + 1;
    }
    return true;
}

/// The digest a key's secret is kept as: SHA-256, in hex.
/// An `accounts` restriction: its names are account ids
/// (`^[a-z0-9][a-z0-9-]{0,62}$`).
fn accounts_restriction(
    set: Bool,
    names: bounded[String; 32]
) -> st::Restriction fallible(CtlError) {
    for n in names {
        if set && !is_slug(n) {
            fail bad("`accounts` names account ids, and " + n + " is not one", "accounts");
        }
    }
    return restriction_of(set, names);
}

fn secret_digest(secret: String) -> String {
    return std::hex::encode(std::crypto::sha256(std::bytes::from_string(secret)));
}

type EntropyError { message: String = ""; }

/// `n` random bytes from the kernel, in hex.
fn random_hex(n: Int) -> String fallible(EntropyError) {
    let b = std::os::getrandom(n) or fail EntropyError { message: "no randomness from the kernel" };
    return std::hex::encode(b);
}

/// A failure inside the api itself.
fn entropy_failed(message: String) -> ApiError {
    return ApiError {
        status: 500,
        kind: "server_error",
        code: ErrorCode::internal_error,
        message: message,
    };
}
