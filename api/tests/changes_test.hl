// The change log: the Changes row (GET /admin/v1/changes), written by every
// admin write.
import ".." as api;
import "../../store" as st;

/// A failed call, as `class param`; "" when it succeeded.
fn why(err: api::CtlError) -> String {
    return api::ctl_class(err) + " " + api::ctl_problem(err).param;
}

fn nothing() -> api::Change {
    return api::Change { action: api::ChangeAction::delete };
}

fn nth(page: api::ChangeList, i: Int) -> api::Change {
    return at(page.data, i) or nothing();
}

/// A field of a change's `before` or `after`, which are free-form JSON.
fn text_of(v: std::json::Value, name: String) -> String {
    return std::json::find_string_field(v.text, name);
}

fn main() {
    let store = st::MemoryStore { };
    let projects = api::Projects { store: store };
    let keys = api::Keys { store: store };
    let nodes = api::Nodes { store: store, link: api::NatsLink { } };
    let changes = api::Changes { store: store };
    let start = changes.list(api::ChangeAsk { }) or api::ChangeList { has_next_cursor: true };
    std::test::assert(count(start.data) == 0 && !start.has_next_cursor, "nothing yet");

    projects.create(api::ProjectCreate { id: "work", name: "Work" }) or discard;
    let key = keys.create(api::KeyCreate { project: "work", name: "ci" }) or api::Key {
        status: api::KeyStatus::revoked,
    };
    std::test::assert(key.has_secret, "a key");
    projects.set_budget(
        api::BudgetRequest {
            project: "work",
            allowance_micros: 50000000,
            period: st::Period::month,
        },
    ) or discard;
    projects.set_budget(
        api::BudgetRequest {
            project: "work",
            allowance_micros: 75000000,
            period: st::Period::month,
        },
    ) or discard;
    projects.update(
        api::ProjectUpdate { project: "work", has_name: true, name: "The work" },
    ) or discard;
    let node = nodes.create(api::NodeCreate { id: "laptop" }) or api::Node {
        status: api::NodeStatus::revoked,
    };
    std::test::assert(node.has_enrollment_token, "a node");
    let mut failed = "";
    nodes.create(api::NodeCreate { id: "laptop" }) or { failed = why(err); };
    std::test::assert_eq_str(failed, "conflict ", "a refused write");

    let all = changes.list(api::ChangeAsk { }) or api::ChangeList { };
    let newest = nth(all, 0);
    std::test::assert_eq_str(newest.target, "nodes/laptop", "newest first");
    std::test::assert(newest.action == api::ChangeAction::create, "a create");
    std::test::assert(
        !newest.has_before && newest.before.text == "null",
        "nothing before a create",
    );
    std::test::assert(!newest.has_principal, "nobody: admin authentication is off");
    let mut text = "";
    for c in all.data {
        text = text + c.before.text + c.after.text;
    }
    std::test::assert(
        !std::str::contains(text, node.enrollment_token)
            && !std::str::contains(text, key.secret),
        "never a secret or a token",
    );
    std::test::assert(
        !std::str::contains(text, "enrollment_token") && !std::str::contains(text, "\"secret\""),
        "nor their fields",
    );
    std::test::assert(len(nth(all, 5).id) > 0, "six changes, the refused write none");
    std::test::assert_eq_int(count(all.data), 6, "and no seventh");

    let renamed = nth(all, 1);
    std::test::assert(renamed.action == api::ChangeAction::update, "an update");
    std::test::assert_eq_str(text_of(renamed.before, "name"), "Work", "the project as it was");
    std::test::assert_eq_str(text_of(renamed.after, "name"), "The work", "and as it became");
    let raised = nth(all, 2);
    std::test::assert_eq_str(raised.target, "projects/work/budget", "the budget's own target");
    std::test::assert_eq_int(
        std::json::find_int_field(raised.before.text, "allowance_micros"),
        50000000,
        "its allowance before",
    );
    std::test::assert_eq_int(
        std::json::find_int_field(raised.after.text, "allowance_micros"),
        75000000,
        "and after",
    );

    // filters and pages
    let under = changes.list(api::ChangeAsk { target: "projects/work" }) or api::ChangeList { };
    let mut targets = "";
    for c in under.data {
        targets = targets + c.target + " ";
    }
    std::test::assert(!std::str::contains(targets, "nodes/laptop"), "under a target");
    std::test::assert(std::str::contains(targets, "projects/work/keys/"), "its children included");
    let page = changes.list(api::ChangeAsk { limit: 2 }) or api::ChangeList { };
    std::test::assert(
        page.has_next_cursor && len(page.next_cursor) > 0,
        "a page that stops early names where to go on",
    );
    std::test::assert_eq_int(count(page.data), 2, "two to a page");
    let next = changes.list(
        api::ChangeAsk { limit: 2, cursor: page.next_cursor },
    ) or api::ChangeList { };
    std::test::assert_eq_str(
        nth(next, 0).target,
        "projects/work/budget",
        "the next page goes on from it",
    );
    let last = changes.list(
        api::ChangeAsk { limit: 10, cursor: page.next_cursor },
    ) or api::ChangeList {
        has_next_cursor: true,
    };
    std::test::assert(!last.has_next_cursor, "the last page names none");
    std::test::assert_eq_int(count(last.data), 4, "with the rest");
    let future = changes.list(api::ChangeAsk { from: "2099-01-01T00:00:00Z" }) or api::ChangeList {
        has_next_cursor: true,
    };
    std::test::assert(count(future.data) == 0 && !future.has_next_cursor, "from a time");
    failed = "";
    changes.list(api::ChangeAsk { limit: 0 }) or { failed = why(err); };
    std::test::assert_eq_str(failed, "invalid limit", "a limit is 1 to 1000");
    failed = "";
    changes.list(api::ChangeAsk { limit: 1001 }) or { failed = why(err); };
    std::test::assert_eq_str(failed, "invalid limit", "and at most 1000");
    failed = "";
    changes.list(api::ChangeAsk { to: "yesterday" }) or { failed = why(err); };
    std::test::assert_eq_str(failed, "invalid to", "a time is RFC 3339");
    let offset = changes.list(
        api::ChangeAsk { from: "2099-01-01T05:00:00+05:00" },
    ) or api::ChangeList {
        has_next_cursor: true,
    };
    std::test::assert(count(offset.data) == 0 && !offset.has_next_cursor, "with an offset");
    failed = "";
    changes.list(api::ChangeAsk { from: "2099-02-30T00:00:00Z" }) or { failed = why(err); };
    std::test::assert_eq_str(failed, "invalid from", "a day the month has");
    failed = "";
    changes.list(api::ChangeAsk { cursor: "chg_nothing" }) or { failed = why(err); };
    std::test::assert_eq_str(failed, "invalid cursor", "a cursor that names no change, by name");

    // a node's change holds the node, not its seats
    nodes.update(api::NodeUpdate { node: "laptop", has_name: true, name: "Laptop" }) or discard;
    let by_node = changes.list(api::ChangeAsk { target: "nodes/laptop" }) or api::ChangeList { };
    std::test::assert_eq_str(
        text_of(nth(by_node, 0).after, "name"),
        "Laptop",
        "the node as it became",
    );
    std::test::assert(
        !std::str::contains(nth(by_node, 0).after.text, "\"seats\""),
        "without its seats",
    );
}
