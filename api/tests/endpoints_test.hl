// The usage ledger answers from an empty store (the `Usage` rows), and the
// data plane, in process: the paths no row serves (the event stream, the
// route table, the chunked refusal, the ui helpers and the 404). A typo in a
// route or a missing body fails here rather than on the wire. The rows of
// the surface have tests of their own, one file per resource.
import ".." as api;
import "../../store" as st;

/// The operator token's header (operator.hl): the token `e`'s store keeps,
/// which the data plane's admin paths take.
fn admin(e: api::DataPlane) -> String {
    return "Authorization: Bearer " + (e.store.operator_token("va-test") or "");
}

fn expect(e: api::DataPlane, method: String, path: String, status: Int) {
    let resp = e.handle(
        std::http::Request {
            method: method,
            path: path,
            headers: admin(e) + "\r\nContent-Type: application/json",
        },
    );
    std::test::assert_eq_int(resp.status, status, method + " " + path);
    std::test::assert(len(resp.body) > 0, method + " " + path + " has a body");
}

fn main() {
    // usage is the ledger's: empty until a request is served (serve_test.hl)
    let usage = api::Usage { store: st::MemoryStore { } };
    let none = usage.list(api::UsageAsk { }) or api::UsageList { has_next_cursor: true };
    std::test::assert(count(none.data) == 0 && !none.has_next_cursor, "an empty ledger");
    let grouped = usage.summary(api::UsageSummaryAsk { group_by: "project" }) or api::UsageSummary {
        has_from: true,
    };
    std::test::assert(count(grouped.data) == 0 && !grouped.has_from, "and an empty summary");
    std::test::assert_eq_str(at(grouped.group_by, 0) or "", "project", "grouped by project");

    let mut failed = "";
    usage.summary(api::UsageSummaryAsk { }) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid group_by", "a summary names its grouping");
    failed = "";
    usage.summary(api::UsageSummaryAsk { group_by: "colour" }) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid group_by", "and a grouping the ledger has");
    failed = "";
    usage.get(api::UsageRef { request_id: "resp_none" }) or {
        failed = api::ctl_class(err) + " " + to_string(api::ctl_status(err));
    };
    std::test::assert_eq_str(failed, "not_found 404", "no such request");

    let e = api::DataPlane { };
    let chunked = e.handle(
        std::http::Request {
            method: "POST",
            path: "/v1/responses",
            headers: "Transfer-Encoding: chunked",
            body: "",
        },
    );
    std::test::assert_eq_int(chunked.status, 400, "a chunked request body is refused");
    std::test::assert(
        std::str::contains(
            chunked.body,
            "a chunked request body is not accepted: send it with Content-Length",
        ),
        "saying so: " + chunked.body,
    );

    let routes = e.handle(
        std::http::Request { method: "GET", path: "/admin/v1/routes", headers: admin(e) },
    );
    std::test::assert_eq_int(routes.status, 503, "no route table without NATS and a brain");

    expect(e, "GET", "/admin/v1/events", 200);
    expect(e, "GET", "/admin/v1/events?type=usage&type=node", 200);
    expect(e, "GET", "/admin/v1/events?type=other", 422);
    std::test::assert(api::is_ui_path("/nodes/laptop"), "an app route is the ui's");
    std::test::assert(!api::is_ui_path("/node/v1/assignment"), "the node plane is not");
    std::test::assert(api::has_extension("/assets/a.woff2"), "a file has an extension");
    std::test::assert(!api::has_extension("/nodes/laptop"), "a route has none");
    let missing = e.handle(std::http::Request { method: "GET", path: "/nope" });
    std::test::assert_eq_int(missing.status, 404, "unknown route");
    std::test::assert_eq_str(
        std::json::find_string_field(std::json::find_field_raw(missing.body, "error"), "code"),
        "not_found",
        "in the error envelope",
    );

    // a row answers from its handler: the catalog starts empty
    let catalog = api::Catalog { store: e.store };
    let models = catalog.list() or api::CatalogList { };
    std::test::assert_eq_int(count(models.data), 0, "the catalog starts empty");
}
