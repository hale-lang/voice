// A container runtime's image pull: a failure docker reports as a refused
// login (its words for it, or a 401 or 403), told from any other; the
// anonymous retry's argv, an empty config and a pull by digest; the
// registry an image names; and what the seat says when the retry pulled
// the image, and when it failed too.
import ".." as node;

const IMAGE: String = "ghcr.io/hale-lang/voice-decision@sha256:c113a7f30123456789abcdef0123456789abcdef0123456789abcdef01234567";

fn main() {
    // ---- a refused login -------------------------------------------------
    for refused in [
        "Error response from daemon: error from registry: denied",
        "Error response from daemon: pull access denied for x, repository does not exist or may require 'docker login'",
        "Error response from daemon: Head \"https://ghcr.io/v2/a/b/manifests/sha256:1\": unauthorized",
        "Error response from daemon: unauthorized: authentication required",
        "Error response from daemon: Authentication Required",
        "Error response from daemon: unexpected status code 403 Forbidden",
        "error: unexpected status: 401",
        "Error response from daemon: received unexpected HTTP status: 403",
    ] {
        std::test::assert(node::pull_refused(refused), "a refused login: " + refused);
    }
    for other in [
        "Error response from daemon: manifest unknown",
        "Error response from daemon: Get \"https://ghcr.io/v2/\": dial tcp: lookup ghcr.io: no such host",
        "Error response from daemon: manifest for x@sha256:a401b4030 not found",
        "docker could not be run",
        "",
    ] {
        std::test::assert(!node::pull_refused(other), "not a refused login: " + other);
    }

    // ---- the pulls -------------------------------------------------------
    std::test::assert_eq_str(
        node::pull_argv(IMAGE),
        "docker\npull\n" + IMAGE,
        "pulled by its digest",
    );
    std::test::assert_eq_str(
        node::anonymous_pull_argv("/tmp/voice-pull-abc123", IMAGE),
        "docker\n--config\n/tmp/voice-pull-abc123\npull\n" + IMAGE,
        "retried with an empty config, by the same digest",
    );

    std::test::assert_eq_str(
        node::anonymous_config("rootless"),
        "{\"auths\": {\"anonymous.invalid\": {}}, \"currentContext\": \"rootless\"}",
        "no login, no credential helper picked, the user's context",
    );
    std::test::assert_eq_str(
        node::anonymous_config("default"),
        "{\"auths\": {\"anonymous.invalid\": {}}}",
        "the default context, named by none",
    );
    std::test::assert_eq_str(
        node::anonymous_config(""),
        "{\"auths\": {\"anonymous.invalid\": {}}}",
        "a context docker did not say, named by none",
    );

    // ---- the registry ----------------------------------------------------
    std::test::assert_eq_str(node::image_registry(IMAGE), "ghcr.io", "ghcr.io");
    std::test::assert_eq_str(
        node::image_registry("registry.lab:5000/voice/x@sha256:1"),
        "registry.lab:5000",
        "a registry with a port",
    );
    std::test::assert_eq_str(
        node::image_registry("localhost/x@sha256:1"),
        "localhost",
        "localhost",
    );
    std::test::assert_eq_str(
        node::image_registry("vllm/vllm-openai@sha256:1"),
        "docker.io",
        "Docker Hub's, by its org",
    );
    std::test::assert_eq_str(
        node::image_registry("ubuntu@sha256:1"),
        "docker.io",
        "Docker Hub's, bare",
    );

    // ---- what the seat says ----------------------------------------------
    let note = node::pulled_anonymously_note("ghcr.io");
    std::test::assert_eq_str(
        note,
        "pulled anonymously: the node's saved docker login for ghcr.io was refused",
        "an anonymous pull, said",
    );
    std::test::assert_eq_str(
        node::starting_reason(note),
        "fetched and verified (pulled anonymously: the node's saved docker login for ghcr.io was refused); starting its server",
        "said once, as the seat starts",
    );
    std::test::assert_eq_str(
        node::starting_reason(""),
        "fetched and verified; starting its server",
        "a pull as usual says nothing of it",
    );
    std::test::assert_eq_str(
        node::pull_refused_reason(
            "ghcr.io",
            "gpu-box",
            "Error response from daemon: manifest unknown",
        ),
        "the image could not be pulled: a saved docker login for ghcr.io was refused, and anonymously too: Error response from daemon: manifest unknown. If the image is public, run `docker logout ghcr.io` as the node's user on gpu-box",
        "both refused: the cause and the fix",
    );
}
