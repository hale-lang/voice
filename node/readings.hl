// The node's readings (main.hl, `readings`): what its habitat's senses
// scrape from another machine, on voice's fixed port, 9476. The runtime
// serves its own series there (memory, restarts, failures, pools); the
// session adds its seats', in the registry it holds: each seat's state
// (session.hl, `read_out`) and what each run it served read, wrote and took
// (`read_run`): `voice_node_tokens_total{kind="input"|"output"}`, and
// `voice_node_generation_seconds` and `voice_node_first_output_seconds`,
// whose ratio to the tokens is the seat's throughput. Every label is a
// seat's id or its engine's, which the operator configures and of which a
// node holds at most 16, and the kind of token.

/// A seat as it was read out: its labels.
type ReadSeat { id: String = ""; engine: String = ""; }

/// The seats last read out: a record, assigned whole.
type SeatIds { items: bounded[ReadSeat; 16]; }

/// True when `seat`'s labels, its id and its engine both, are still read
/// out: a seat whose engine changed is a new series, and the old one is
/// retired as a withdrawn seat's is.
fn still_read(ids: SeatIds, seat: ReadSeat) -> Bool {
    for x in ids.items {
        if x.id == seat.id && x.engine == seat.engine { return true; }
    }
    return false;
}

/// One seat reading, set to `value`.
fn seat_reading(
    reg: std::metrics::Registry,
    name: String,
    labels: std::metrics::Labels,
    value: Int
) {
    std::metrics::gauge(reg, name, labels).set(std::math::int_to_float(value));
}

/// The buckets a run's times fall in, in seconds: a short answer to a
/// long generation.
const GENERATION_BOUNDS: String = "0.1 0.25 0.5 1 2.5 5 10 30 60 120 300 600";

/// A seat's tokens of `kind` (`input`, `output`), counted on.
fn seat_tokens(reg: std::metrics::Registry, labels: std::metrics::Labels, kind: String, n: Int) {
    if n <= 0 { return; }
    std::metrics::counter(
        reg,
        "tokens_total",
        std::metrics::labels_append(labels, "kind", kind),
    ).add(
        std::math::int_to_float(n),
    );
}
