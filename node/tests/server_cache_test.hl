// A vLLM seat's container keeps the caches its server fills as it starts
// (compiled graphs, FlashInfer's autotune) under the node's data directory,
// one directory per runtime, mounted over those two caches only; any other
// server mounts none.
import ".." as node;

fn main() {
    let data = "/tmp/voice-server-cache-" + to_string(std::time::monotonic_ns());
    std::io::fs::mkdir(data) or discard;

    let args = node::server_cache_args("vllm", data, "vllm-26.09");
    std::test::assert_eq_str(
        args,
        "-v\n" + data + "/cache/vllm-26.09/vllm:/root/.cache/vllm\n-v\n" + data
            + "/cache/vllm-26.09/flashinfer:/root/.cache/flashinfer\n",
        "a vLLM seat mounts its runtime's two caches",
    );
    std::test::assert(
        std::io::fs::file_exists(data + "/cache/vllm-26.09/vllm")
            && std::io::fs::file_exists(data + "/cache/vllm-26.09/flashinfer"),
        "made by the node, as its own, before docker would make them",
    );
    std::test::assert_eq_str(
        node::server_cache_args("vllm", data, "vllm-26.10"),
        "-v\n" + data + "/cache/vllm-26.10/vllm:/root/.cache/vllm\n-v\n" + data
            + "/cache/vllm-26.10/flashinfer:/root/.cache/flashinfer\n",
        "another runtime, another directory",
    );
    std::test::assert_eq_str(
        node::server_cache_args("llama-server", data, "llama-server-b11913-cuda"),
        "",
        "llama-server mounts none",
    );
    std::test::assert_eq_str(
        node::server_cache_args("decision", data, "decision-0.1.2-cuda"),
        "",
        "nor the decision server",
    );

    let argv = node::container_argv(
        "voice.n.s",
        "n",
        9000,
        "/m",
        "/b",
        "--gpus\nall\n",
        args,
        "img@sha256:x",
        "vllm\nserve\n/models",
    );
    std::test::assert(
        std::str::contains(
            argv,
            "--gpus\nall\n-v\n" + data + "/cache/vllm-26.09/vllm:/root/.cache/vllm\n",
        ),
        "the cache mounts sit with the run's options, before its image: " + argv,
    );
    std::test::assert(
        std::str::ends_with(argv, "img@sha256:x\nvllm\nserve\n/models"),
        "the image and its arguments last",
    );
}
