// The openai-compatible engine (protocol.yaml `OpenAICompatibleConfig`): a
// seat that proxies to a server speaking the chat-completions wire (Ollama,
// LM Studio, the llama.cpp server, or a hosted one). The request's input
// becomes `messages`; the upstream is asked for a stream; its chunks come
// back as the standard's events, the same ones the static engine emits.
//
// The upstream, http or https, is read off the stdlib client's
// `std::http::BodyReader` a piece at a time and framed here into events, so
// that what is not an event is seen too: a keep-alive comment (`: ...`) is
// the engine at work, though it sends nothing yet (TensorFold, holding a
// tool call back until it is whole), and the session tells the api so
// (`alive`, protocol.yaml). Each event is relayed as it arrives: published
// as soon as it is read.

/// A seat's openai-compatible config. `problem` is why it is not one, ""
/// when it is.
type CompatConfig {
    base_url: String = "";
    model: String = "";
    // the std::secret vault entry holding the API key; "" for none
    key_vault: String = "";
    // a managed seat's: the key its own server answers to (run.hl), drawn
    // by the node and held in its memory; "" for none
    engine_key: String = "";
    // a managed seat's: its server is voice's own, one of the pinned
    // engines, whose chat templates take an assistant turn's thinking back
    // (`reasoning_content`), as a hosted upstream's may not
    managed: Bool = false;
    // micros per million tokens, as a catalog model's price; 0 for local
    input_per_mtok_micros: Int = 0;
    output_per_mtok_micros: Int = 0;
    problem: String = "";
}

fn compat_config(config: String) -> CompatConfig {
    if !std::json::valid_object(config) {
        return CompatConfig { problem: "config is not an object" };
    }
    let base = std::json::string_field(config, "base_url");
    if base.kind != "string"
        || !(
            std::str::starts_with(base.text, "http://")
                || std::str::starts_with(base.text, "https://")
        )
    {
        return CompatConfig { problem: "config needs base_url, an http or https URL" };
    }
    let model = std::json::string_field(config, "model");
    if model.kind != "string" || len(model.text) == 0 {
        return CompatConfig { problem: "config needs model, a non-empty string" };
    }
    let mut c = CompatConfig { base_url: base.text, model: model.text };
    while std::str::ends_with(c.base_url, "/") {
        c.base_url = c.base_url[0..(len(c.base_url) - 1)];
    }
    let vault = std::json::string_field(config, "api_key_vault");
    if vault.kind == "string" {
        c.key_vault = vault.text;
    } else if vault.kind != "missing" && vault.kind != "null" {
        return CompatConfig { problem: "config api_key_vault is a vault entry name" };
    }
    if std::json::string_field(config, "input_per_mtok_micros").kind == "number" {
        c.input_per_mtok_micros = std::json::find_int_field(config, "input_per_mtok_micros");
    }
    if std::json::string_field(config, "output_per_mtok_micros").kind == "number" {
        c.output_per_mtok_micros = std::json::find_int_field(config, "output_per_mtok_micros");
    }
    if c.input_per_mtok_micros < 0 || c.output_per_mtok_micros < 0 {
        return CompatConfig { problem: "config prices are at least 0" };
    }
    return c;
}

/// A managed seat's config: its own server at `endpoint`, serving `model`,
/// asked with the `key` it answers to (run.hl `engine_key`).
fn managed_compat(endpoint: String, model: String, key: String) -> CompatConfig {
    let mut c = compat_config("{\"base_url\": " + q(endpoint) + ", \"model\": " + q(model) + "}");
    c.engine_key = key;
    c.managed = true;
    return c;
}

/// The text of a message's content: a string as it is, a list of parts as
/// their texts joined.
@unbounded
fn content_text(content: String) -> String {
    let raw = std::str::trim(content);
    if !std::str::starts_with(raw, "[") {
        return std::json::string_field("{\"c\":" + raw + "}", "c").text;
    }
    let mut out = "";
    let mut it = std::json::array_first(raw);
    while !it.done {
        let part = std::json::string_field(it.element, "text");
        if part.kind == "string" { out = out + part.text; }
        it = std::json::array_next(it);
    }
    return out;
}

fn chat_message(role: String, text: String) -> String {
    return "{\"role\":" + q(role) + ",\"content\":" + q(text) + "}";
}

/// Whether a standard request carries `tools`: only an engine that
/// speaks tool calls can take it.
fn request_has_tools(body: String) -> Bool {
    let tools = std::str::trim(std::json::find_field_raw(body, "tools"));
    if !std::str::starts_with(tools, "[") { return false; }
    return !std::json::array_first(tools).done;
}

/// A standard function tool as the chat-completions wire's, the schema
/// carried byte for byte.
fn chat_tool(t: String) -> String {
    let mut f = "{\"name\":" + q(std::json::find_string_field(t, "name"));
    if std::json::string_field(t, "description").kind == "string" {
        f = f + ",\"description\":" + q(std::json::find_string_field(t, "description"));
    }
    if std::json::string_field(t, "parameters").kind == "object" {
        f = f + ",\"parameters\":" + std::str::trim(std::json::find_field_raw(t, "parameters"));
    }
    if std::json::string_field(t, "strict").kind == "bool" {
        f = f + ",\"strict\":" + std::str::trim(std::json::find_field_raw(t, "strict"));
    }
    return "{\"type\":\"function\",\"function\":" + f + "}}";
}

/// The standard's `tools` as a chat-completions list.
@unbounded
fn chat_tools(tools: String) -> String {
    let mut out = "";
    let mut it = std::json::array_first(tools);
    while !it.done {
        let t = std::str::trim(it.element);
        if std::json::find_string_field(t, "type") == "function" {
            out = out + (if len(out) > 0 { "," } else { "" }) + chat_tool(t);
        }
        it = std::json::array_next(it);
    }
    return "[" + out + "]";
}

/// `tool_choice` on the chat wire: a mode as it is, a named function as
/// that wire names one.
fn chat_tool_choice(body: String) -> String {
    let kind = std::json::string_field(body, "tool_choice").kind;
    if kind == "string" { return q(std::json::find_string_field(body, "tool_choice")); }
    let name = std::json::find_string_field(std::json::find_field_raw(body, "tool_choice"), "name");
    return "{\"type\":\"function\",\"function\":{\"name\":" + q(name) + "}}";
}

fn add_message(messages: String, m: String) -> String {
    return messages + (if len(messages) > 0 { "," } else { "" }) + m;
}

/// The text of a `reasoning` input item: its `content` parts' texts
/// joined (the model's own thinking, as a reasoning item of voice's carries
/// it back); a summary is not the thinking, and is left out.
@unbounded
fn thought_text(item: String) -> String {
    let mut out = "";
    let mut it = std::json::array_first(std::str::trim(std::json::find_field_raw(item, "content")));
    while !it.done {
        let part = std::json::string_field(it.element, "text");
        if part.kind == "string" { out = out + part.text; }
        it = std::json::array_next(it);
    }
    return out;
}

/// A `function_call` input item's arguments as text: its string, or, from a
/// caller that sent them as an object, that object's text; "" for none.
fn call_arguments(item: String) -> String {
    let args = std::json::string_field(item, "arguments");
    if args.kind == "string" { return args.text; }
    if args.kind == "object" {
        return std::str::trim(std::json::find_field_raw(item, "arguments"));
    }
    return "";
}

/// One assistant turn as one chat message: what it said (`said`, `null`
/// when it only called tools), its thinking as `reasoning_content` when
/// `thinking` (a managed seat's server, whose template renders it back
/// where the model wrote it), and its tool calls; "" when the turn holds
/// nothing the message can carry.
fn assistant_turn(
    thought: String,
    said: String,
    spoke: Bool,
    calls: String,
    thinking: Bool
) -> String {
    let thought_kept = thinking && len(thought) > 0;
    if !spoke && len(calls) == 0 && !thought_kept { return ""; }
    return "{\"role\":\"assistant\",\"content\":"
        + (if spoke || len(calls) == 0 { q(said) } else { "null" })
        + (if thought_kept { ",\"reasoning_content\":" + q(thought) } else { "" })
        + (if len(calls) > 0 { ",\"tool_calls\":[" + calls + "]" } else { "" }) + "}";
}

/// The chat-completions request for a standard request body: its
/// `instructions` as a system message, its `input` (a text, or items with a
/// role and content, calls and their outputs) as the rest, its tools, and
/// the output cap. An assistant's turn is one message, as a chat template
/// renders one turn: its `reasoning` item, its message and the
/// `function_call`s after it together, the message's text as `content`,
/// the calls as `tool_calls`. Sent apart, a template that closes each
/// assistant message's thinking (DeepSeek-V4's, Qwen3's) renders the turn
/// as two, each with its own close of the thinking block and an end of
/// turn between them, and the model learns from its own history to write
/// a second close after its words. A `function_call_output` is a `tool`
/// message. Each past call's arguments are given as `history_args` makes
/// them (tool_args.hl): a template parses them again, and arguments it
/// cannot parse (a number no double holds, written by a model in an
/// earlier turn) would fail every later turn of the conversation; valid
/// ones are given byte for byte.
@unbounded
fn compat_request(body: String, c: CompatConfig) -> String {
    let mut messages = "";
    let instructions = std::json::string_field(body, "instructions");
    if instructions.kind == "string" && len(instructions.text) > 0 {
        messages = chat_message("system", instructions.text);
    }
    let input = std::json::string_field(body, "input");
    if input.kind == "string" {
        messages = add_message(messages, chat_message("user", input.text));
    } else {
        // the assistant's turn being gathered: its thinking, its words
        // (whether it said any), its calls
        let mut thought = "";
        let mut said = "";
        let mut spoke = false;
        let mut calls = "";
        let mut it = std::json::array_first(
            std::str::trim(std::json::find_field_raw(body, "input")),
        );
        while !it.done {
            let kind = std::json::find_string_field(it.element, "type");
            let role = std::json::string_field(it.element, "role");
            let assistant = role.kind == "string" && role.text == "assistant"
                && (kind == "message" || len(kind) == 0);
            // a turn's thinking or words after its calls begin the next turn
            if (kind == "reasoning" || assistant) && len(calls) > 0
                || kind == "reasoning" && spoke
            {
                let turn = assistant_turn(thought, said, spoke, calls, c.managed);
                if len(turn) > 0 { messages = add_message(messages, turn); }
                thought = "";
                said = "";
                spoke = false;
                calls = "";
            }
            if kind == "reasoning" {
                thought = thought + thought_text(it.element);
            } else if assistant {
                let text = content_text(std::json::find_field_raw(it.element, "content"));
                said = if spoke && len(said) > 0 && len(text) > 0 {
                    said + "\n\n" + text
                } else {
                    said + text
                };
                spoke = true;
            } else if kind == "function_call" {
                calls = calls + (if len(calls) > 0 { "," } else { "" }) + "{\"id\":"
                    + q(std::json::find_string_field(it.element, "call_id"))
                    + ",\"type\":\"function\",\"function\":{\"name\":"
                    + q(std::json::find_string_field(it.element, "name")) + ",\"arguments\":"
                    + q(history_args(call_arguments(it.element))) + "}}";
            } else {
                let turn = assistant_turn(thought, said, spoke, calls, c.managed);
                if len(turn) > 0 { messages = add_message(messages, turn); }
                thought = "";
                said = "";
                spoke = false;
                calls = "";
                if kind == "function_call_output" {
                    let out = std::json::string_field(it.element, "output");
                    let text = if out.kind == "string" {
                        out.text
                    } else {
                        content_text(std::json::find_field_raw(it.element, "output"))
                    };
                    messages = add_message(
                        messages,
                        "{\"role\":\"tool\",\"tool_call_id\":"
                            + q(std::json::find_string_field(it.element, "call_id"))
                            + ",\"content\":" + q(text) + "}",
                    );
                } else if role.kind == "string" {
                    let text = content_text(std::json::find_field_raw(it.element, "content"));
                    messages = add_message(messages, chat_message(role.text, text));
                }
            }
            it = std::json::array_next(it);
        }
        let turn = assistant_turn(thought, said, spoke, calls, c.managed);
        if len(turn) > 0 { messages = add_message(messages, turn); }
    }
    let mut out = "{\"model\":" + q(c.model) + ",\"messages\":[" + messages
        + "],\"stream\":true,\"stream_options\":{\"include_usage\":true}";
    if request_has_tools(body) {
        out = out + ",\"tools\":"
            + chat_tools(std::str::trim(std::json::find_field_raw(body, "tools")));
        if std::json::string_field(body, "tool_choice").kind != "missing"
            && std::json::string_field(body, "tool_choice").kind != "null"
        {
            out = out + ",\"tool_choice\":" + chat_tool_choice(body);
        }
        if std::json::string_field(body, "parallel_tool_calls").kind == "bool" {
            out = out + ",\"parallel_tool_calls\":"
                + std::str::trim(std::json::find_field_raw(body, "parallel_tool_calls"));
        }
    }
    if std::json::string_field(body, "max_output_tokens").kind == "number" {
        out = out + ",\"max_tokens\":"
            + to_string(std::json::find_int_field(body, "max_output_tokens"));
    }
    if std::json::string_field(body, "temperature").kind == "number" {
        out = out + ",\"temperature\":" + member_or(body, "temperature", "1");
    }
    if std::json::string_field(body, "top_p").kind == "number" {
        out = out + ",\"top_p\":" + member_or(body, "top_p", "1");
    }
    // no reasoning asked (`reasoning.effort` `none`): a reasoning model's
    // template told not to think, as llama-server's and vLLM's take it
    if std::json::find_string_field(
        std::json::find_field_raw(body, "reasoning"),
        "effort",
    ) == "none" {
        out = out + ",\"chat_template_kwargs\":{\"enable_thinking\":false}";
    }
    return out + "}";
}

/// Micros owed for a run: the tokens at the seat's per-million prices,
/// rounded up.
fn compat_cost(c: CompatConfig, input: Int, output: Int) -> Int {
    return (input * c.input_per_mtok_micros + output * c.output_per_mtok_micros + 999999) / 1000000;
}

/// How long an upstream may be silent mid-stream before its seat fails.
const COMPAT_IDLE_MS: Int = 120000;

/// A run that failed before any output: nothing is played, so the
/// coordinator's failover sees a clean seat failure.
fn compat_failed(c: CompatConfig, served: String, why: String) -> StaticRun {
    return StaticRun { outcome: "failed", failure: why, model: served };
}

/// One line of SSE text from a start: `found` when a line end closes it,
/// `end` where its text stops and `next` where the line after it begins. A
/// line ends at LF, CRLF or a lone CR. A CR that is the last byte held ends
/// its line: when the LF of a CRLF split across reads follows, it reads as
/// one more blank line, an event with no data, which is let go.
type SseLine { found: Bool = false; end: Int = 0; next: Int = 0; }

@unbounded
fn sse_line(v: std::str::ByteView, start: Int) -> SseLine {
    let mut i = start;
    while i < v.n {
        let c = std::str::byte_at(v, i);
        if c == 10 { return SseLine { found: true, end: i, next: i + 1 }; }
        if c == 13 {
            let crlf = i + 1 < v.n && std::str::byte_at(v, i + 1) == 10;
            return SseLine { found: true, end: i, next: if crlf { i + 2 } else { i + 1 } };
        }
        i = i + 1;
    }
    return SseLine { end: v.n, next: v.n };
}

/// The payload of one SSE event block: its `data:` lines joined by newlines.
@unbounded
fn sse_data(block: String) -> String {
    let v = std::str::bytes_view(block);
    let mut out = "";
    let mut start = 0;
    while start < v.n {
        let l = sse_line(v, start);
        let ln = std::str::slice(v, start, l.end);
        start = if l.found { l.next } else { v.n };
        if std::str::starts_with(ln, "data:") {
            let d = ln[5..len(ln)];
            out = out + (if len(out) > 0 { "\n" } else { "" })
                + (if std::str::starts_with(d, " ") { d[1..len(d)] } else { d });
        }
    }
    return out;
}

/// What a source of upstream events gave: an event's payload, or the end of
/// the stream, or why it failed.
type Datum {
    data: String = "";
    ended: Bool = false;
    // ended by the body closing, not by `[DONE]`: an end only when the
    // model said it finished (a finish reason), else a failure
    closed: Bool = false;
    // nothing arrived within the read window: the stream is open and quiet
    idle: Bool = false;
    // bytes arrived that are not an event yet: a keep-alive comment, or
    // part of an event; the upstream is at work
    alive: Bool = false;
    failure: String = "";
}

/// What the stream held framed: an event (`found`, `d`), or none yet,
/// `alive` when comments or blocks with no data were let go on the way.
type Framed { found: Bool = false; alive: Bool = false; d: Datum = Datum { }; }

/// The most of one event held while it arrives, as the stdlib reader's.
const COMPAT_EVENT_MAX: Int = 16777216;

/// The first event block of an SSE stream's text: `found` once a blank line
/// ends one (`used` its bytes, the blank line's too), `data` its `data:`
/// lines joined by newlines ("" for a comment or a block of other fields).
/// Lines end at LF, CRLF or CR, as SSE has them.
type SseBlock { found: Bool = false; used: Int = 0; data: String = ""; }

@unbounded
fn sse_block(text: String) -> SseBlock {
    let v = std::str::bytes_view(text);
    let mut start = 0;
    while start < v.n {
        let l = sse_line(v, start);
        if !l.found { return SseBlock { }; }
        let ln = std::str::slice(v, start, l.end);
        start = l.next;
        if len(ln) == 0 {
            return SseBlock {
                found: true,
                used: start,
                data: sse_data(std::str::slice(v, 0, start)),
            };
        }
    }
    return SseBlock { };
}

/// The whole run of an exchange is bounded, not each read: a model that
/// thinks for minutes is waited for, a hung one is not waited for for ever.
const COMPAT_TOTAL_MS: Int = 1800000;

/// How long one read of the upstream waits for an event. A quiet upstream
/// gives control back at this interval, so the session services a cancel, an
/// assignment or a refusal within about this long, whatever the upstream does
/// (the exchange's deadline above still ends the whole of it).
const COMPAT_READ_MS: Int = 1000;

/// The upstream's stream off the wire. Birth dials and reads the head.
locus HttpSse {
    params {
        url: String = "";
        request: String = "";
        vault: String = "";
        // a managed seat's own server's key (`CompatConfig.engine_key`)
        key: String = "";
        // the exchange, begun by `open`; until then a reader of a port nobody serves
        rd: std::http::BodyReader = std::http::BodyReader {
            req: std::http::ClientRequest {
                method: "GET",
                url: std::http::parse_url("http://127.0.0.1:1/") or std::http::Url { },
                body: b"",
            },
        };
        // the stream's bytes not yet framed into an event
        rx: std::bytes::BytesBuilder = std::bytes::BytesBuilder { initial_cap: 8192 };
        // a keyed upstream is read whole (see `open`)
        keyed: Bool = false;
        canned: CannedSse = CannedSse { };
    }

    /// The exchange with the upstream, begun.
    @unbounded
    fn open() {
        let parsed = std::http::parse_url(self.url + "/chat/completions") or std::http::Url { };
        let headers = "Content-Type: application/json"
            + (if len(self.key) > 0 { "\r\n" + engine_auth(self.key) } else { "" });
        if len(self.vault) > 0 {
            // KNOWN GAP (hale #1719): the checker does not yet take a reader's
            // request as a wire write, so a revealed key cannot be written into
            // an `SseReader`. A keyed upstream is read whole through
            // `std::http::request`, where it can, and relayed after it ends.
            self.keyed = true;
            let r = self.whole(parsed);
            self.canned = CannedSse {
                status: r.status,
                body: sse_lf(std::str::from_bytes(r.body)),
            };
            if r.status == 0 {
                self.canned = CannedSse { status: 0 };
            }
            return;
        }
        self.rd = std::http::BodyReader {
            req: std::http::ClientRequest {
                method: "POST",
                url: parsed,
                headers: headers + "\r\nAccept: text/event-stream",
                body: std::bytes::from_string(self.request),
            },
            timeout_ms: COMPAT_TOTAL_MS,
            // the opening (the response's head) is driven by the reads, a
            // window at a time, so the session services a cancel while the
            // upstream has not answered at all
            deferred: true,
        };
    }

    /// The keyed request through the stdlib client, whole.
    @unbounded
    fn whole(parsed: std::http::Url) -> std::http::ClientResponse {
        let credential = std::secret::Credential { vault: self.vault };
        return std::http::request(
            std::http::ClientRequest {
                method: "POST",
                url: parsed,
                headers: "Content-Type: application/json\r\nAccept: text/event-stream\r\nAuthorization: Bearer "
                    + credential.reveal_text(),
                body: std::bytes::from_string(self.request),
            },
        ) or std::http::ClientResponse { status: 0, body: b"" };
    }

    @unbounded
    fn next() -> Datum {
        if self.keyed {
            if self.canned.status == 0 {
                return Datum { failure: "the upstream at " + self.url + " could not be reached" };
            }
            return self.canned.next();
        }
        let opened = self.rd.open_within(COMPAT_READ_MS) or {
            return Datum { failure: "the upstream at " + self.url + " could not be reached" };
        };
        if !opened { return Datum { idle: true }; }
        if self.rd.status == 0 {
            return Datum { failure: "the upstream at " + self.url + " could not be reached" };
        }
        if self.rd.status < 200 || self.rd.status >= 300 {
            let text = std::bytes::BytesBuilder { initial_cap: 1024 };
            let mut reading = true;
            while reading {
                let piece = self.rd.chunk_within(COMPAT_READ_MS) or b"";
                if len(piece) == 0 { reading = false; } else { text.append(piece); }
            }
            let body = std::str::from_bytes(text.snapshot() or b"");
            return error_datum(self.rd.status, body);
        }
        // an event already read, else the next piece of the stream
        let held = self.framed();
        if held.found { return held.d; }
        if held.alive { return Datum { alive: true }; }
        let piece = self.rd.chunk_within(COMPAT_READ_MS) or {
            if err.kind == "idle" { return Datum { idle: true }; }
            // an unfinished last event is dropped, as a reader of SSE does
            if err.kind == "end" { return Datum { ended: true, closed: true }; }
            return Datum { failure: "the upstream ended its stream early" };
        };
        self.rx.append(piece);
        if self.rx.len() > COMPAT_EVENT_MAX {
            return Datum {
                failure: "the upstream sent an event over " + to_string(COMPAT_EVENT_MAX)
                    + " bytes",
            };
        }
        let more = self.framed();
        if more.found { return more.d; }
        // bytes, but no event yet: a keep-alive, or part of an event
        return Datum { alive: true };
    }

    /// The first event held whole, its bytes let go: `found` with its
    /// payload, or the end (`[DONE]`). Comments and blocks with no data
    /// before it are let go too, `alive` when there were any.
    @unbounded
    fn framed() -> Framed {
        let mut alive = false;
        while true {
            let text = std::str::from_bytes(self.rx.snapshot() or b"");
            let b = sse_block(text);
            if !b.found { break; }
            self.rx.shift_front(b.used);
            if b.data == "[DONE]" { return Framed { found: true, d: Datum { ended: true } }; }
            if len(b.data) > 0 { return Framed { found: true, d: Datum { data: b.data } }; }
            alive = true;
        }
        return Framed { alive: alive };
    }
}

/// An error answer's message, as the failure of the seat.
fn error_datum(status: Int, body: String) -> Datum {
    let e = std::json::find_field_raw(body, "error");
    let err = std::json::find_string_field(e, "message");
    // what kind of error it named, kept so the coordinator can tell one
    // the caller must fix (`context_length_exceeded`): its `code` when a
    // word, else its `type` (llama-server's `exceed_context_size_error`)
    let code = if std::json::string_field(e, "code").kind == "string" {
        std::json::find_string_field(e, "code")
    } else {
        ""
    };
    let kind = if len(code) > 0 { code } else { std::json::find_string_field(e, "type") };
    return Datum {
        failure: "the upstream answered " + to_string(status)
            + (if len(kind) > 0 { " (" + kind + ")" } else { "" })
            + (if len(err) > 0 { ": " + err } else { "" })
    };
}

/// SSE text with every line ending (CRLF, or a lone CR) made an LF.
fn sse_lf(text: String) -> String {
    return std::str::replace(std::str::replace(text, "\r\n", "\n"), "\r", "\n");
}

/// An answer already in hand: its status and its `text/event-stream` body.
locus CannedSse {
    params {
        status: Int = 200;
        body: String = "";
    }

    @unbounded
    fn next() -> Datum {
        if self.status < 200 || self.status >= 300 { return error_datum(self.status, self.body); }
        while true {
            let at = std::str::index_of(self.body, "\n\n");
            if at < 0 { break; }
            let d = sse_data(self.body[0..at]);
            self.body = self.body[(at + 2)..len(self.body)];
            if d == "[DONE]" { return Datum { ended: true }; }
            if len(d) > 0 { return Datum { data: d }; }
        }
        let d = sse_data(self.body);
        self.body = "";
        if d == "[DONE]" { return Datum { ended: true }; }
        if len(d) == 0 { return Datum { ended: true, closed: true }; }
        return Datum { data: d };
    }
}

/// One run on an upstream: the source of its events, the
/// stream read off it, and the events built from the stream so far. The
/// key is read from its vault slot into the request it is written into and
/// goes nowhere else: not a log line, not an event.
locus Upstream {
    params {
        url: String = "";
        vault: String = "";
        cfg: CompatConfig = CompatConfig { };
        id: String = "";
        model: String = "";
        req: String = "";
        // where the events come from: the wire, or an answer in hand
        use_wire: Bool = false;
        wire: HttpSse = HttpSse { };
        canned: CannedSse = CannedSse { };
        done: Bool = false;
        failure: String = "";
        // the last read brought no event but bytes: a keep-alive comment,
        // or part of an event; the engine is at work (`alive`, serve.hl)
        heard: Bool = false;
        // the events built
        item_id: String = "";
        created: Int = 0;
        seq: Int = 0;
        text: String = "";
        finish_reason: String = "";
        ran: String = "";
        input: Int = -1;
        output: Int = -1;
        // of the input, the tokens the engine's prompt cache held, as its
        // usage says (`prompt_tokens_details.cached_tokens`: vLLM's,
        // TensorFold's, llama-server's) or, apart, llama-server's
        // `timings.cache_n`; of the output, its thinking
        // (`completion_tokens_details.reasoning_tokens`); -1 while unsaid
        cached: Int = -1;
        cache_n: Int = -1;
        reasoning: Int = -1;
        began: Bool = false;
        // the message item (text) is open, and is closed, and its place
        text_open: Bool = false;
        text_closed: Bool = false;
        text_out: Int = 0;
        // the reasoning item: open, closed, its place, id and text so far
        // (llama-server's and vLLM's `reasoning_content`)
        thought_open: Bool = false;
        thought_closed: Bool = false;
        thought_out: Int = 0;
        thought_item: String = "";
        thought: String = "";
        // output items opened so far, and the finished ones as a list body
        nout: Int = 0;
        done_items: String = "";
        // the tool call being built: the upstream's index for it (-1 for
        // none), its item, call id, name and the arguments so far
        call_at: Int = -1;
        call_out: Int = 0;
        call_item: String = "";
        call_id: String = "";
        call_name: String = "";
        call_args: String = "";
        calls: Int = 0;
        args_len: Int = 0;
        // the call's arguments as the engine wrote them, their repair as
        // they come (tool_args.hl), how many of its fragments carried
        // any, and its events held back until a second one did: an
        // engine that sends a call whole (TensorFold) has sent nothing of
        // it the caller saw when its arguments prove not JSON, so the
        // attempt fails and another seat may serve the request
        call_raw: String = "";
        call_scan: ArgsScanner = ArgsScanner { };
        call_frags: Int = 0;
        call_held: String = "";
        // the calls whose arguments were repaired, each its call id, name
        // and arguments as the engine wrote them, as a list body
        repairs: String = "";
    }

    /// The next event's payload, "" when there is none (the caller asks
    /// again until `done`, which says the stream ended or failed). A quiet
    /// upstream returns "" after `COMPAT_READ_MS` with `done` still false:
    /// the caller services what has arrived for it, and asks again.
    fn next_data() -> String {
        if self.done { return ""; }
        let d = if self.use_wire { self.wire.next() } else { self.canned.next() };
        self.heard = d.alive;
        if len(d.failure) > 0 {
            self.failure = d.failure;
            self.done = true;
            return "";
        }
        if d.ended {
            self.done = true;
            // a body that closed before the model finished is a failed
            // stream, however cleanly the HTTP framing ended
            if d.closed && len(self.finish_reason) == 0 {
                self.failure = "the upstream closed its stream before the model finished";
            }
            return "";
        }
        return d.data;
    }

    /// The events for one chunk's payload, as script lines; a payload that
    /// cannot be one sets `failure`.
    @unbounded
    fn feed(data: String) -> String {
        if !std::json::valid_object(data) {
            self.failure = "the upstream sent a stream chunk that is not JSON";
            self.done = true;
            return "";
        }
        if std::json::string_field(data, "error").kind == "object" {
            self.failure = "the upstream failed mid-stream: "
                + std::json::find_string_field(std::json::find_field_raw(data, "error"), "message");
            self.done = true;
            return "";
        }
        let m = std::json::string_field(data, "model");
        if m.kind == "string" && len(m.text) > 0 { self.ran = m.text; }
        let usage = std::str::trim(std::json::find_field_raw(data, "usage"));
        if std::str::starts_with(usage, "{") {
            self.input = std::json::find_int_field(usage, "prompt_tokens");
            self.output = std::json::find_int_field(usage, "completion_tokens");
            let prompt = std::json::find_field_raw(usage, "prompt_tokens_details");
            if std::json::string_field(prompt, "cached_tokens").kind == "number" {
                self.cached = std::json::find_int_field(prompt, "cached_tokens");
            }
            let completion = std::json::find_field_raw(usage, "completion_tokens_details");
            if std::json::string_field(completion, "reasoning_tokens").kind == "number" {
                self.reasoning = std::json::find_int_field(completion, "reasoning_tokens");
            }
        }
        let timings = std::json::find_field_raw(data, "timings");
        if std::json::string_field(timings, "cache_n").kind == "number" {
            self.cache_n = std::json::find_int_field(timings, "cache_n");
        }
        let choice = std::json::array_first(
            std::str::trim(std::json::find_field_raw(data, "choices")),
        );
        if choice.done { return ""; }
        let fr = std::json::string_field(choice.element, "finish_reason");
        if fr.kind == "string" { self.finish_reason = fr.text; }
        let delta = std::json::find_field_raw(choice.element, "delta");
        let mut out = "";
        // a model's thinking, before its answer: a reasoning item
        let thinking = std::json::string_field(delta, "reasoning_content");
        let thinks = if thinking.kind == "string" {
            thinking
        } else {
            std::json::string_field(delta, "reasoning")
        };
        if thinks.kind == "string" && len(thinks.text) > 0 && !self.text_open && self.calls == 0 {
            out = self.preamble() + self.open_thought();
            self.thought = self.thought + thinks.text;
            out = out
                + line(
                    "{\"type\":\"response.reasoning_text.delta\",\"item_id\":"
                        + q(self.thought_item)
                        + ",\"output_index\":" + to_string(self.thought_out)
                        + ",\"content_index\":0,\"delta\":" + q(thinks.text)
                        + ",\"sequence_number\":"
                        + to_string(self.seq) + "}",
                );
            self.seq = self.seq + 1;
        }
        let piece = std::json::string_field(delta, "content");
        if piece.kind == "string" && len(piece.text) > 0 && self.calls == 0 {
            out = out + self.preamble() + self.close_thought() + self.open_text();
            self.text = self.text + piece.text;
            out = out
                + line(
                    "{\"type\":\"response.output_text.delta\",\"item_id\":" + q(self.item_id)
                        + ",\"output_index\":" + to_string(self.text_out)
                        + ",\"content_index\":0,\"delta\":" + q(piece.text)
                        + ",\"logprobs\":[],\"sequence_number\":" + to_string(self.seq) + "}",
                );
            self.seq = self.seq + 1;
        }
        let tcs = std::str::trim(std::json::find_field_raw(delta, "tool_calls"));
        if std::str::starts_with(tcs, "[") {
            let mut it = std::json::array_first(tcs);
            while !it.done && len(self.failure) == 0 {
                out = out + self.tool_fragment(std::str::trim(it.element));
                it = std::json::array_next(it);
            }
        }
        return out;
    }

    /// The events that begin the response, once.
    @unbounded
    fn preamble() -> String {
        if self.began { return ""; }
        self.began = true;
        self.created = std::time::unix(std::time::current());
        self.item_id = "msg_" + self.suffix();
        let pending = response_object(
            self.id,
            self.created,
            "in_progress",
            self.model,
            self.req,
            "",
            "null",
        );
        let out = line(
            "{\"type\":\"response.created\",\"response\":" + pending + ",\"sequence_number\":"
                + to_string(self.seq) + "}",
        )
            + line(
                "{\"type\":\"response.in_progress\",\"response\":" + pending
                    + ",\"sequence_number\":" + to_string(self.seq + 1) + "}",
            );
        self.seq = self.seq + 2;
        return out;
    }

    @unbounded
    fn suffix() -> String {
        return if std::str::starts_with(self.id, "resp_") {
            self.id[5..len(self.id)]
        } else {
            self.id
        };
    }

    /// The events that open the message item, once.
    @unbounded
    fn open_text() -> String {
        if self.text_open { return ""; }
        self.text_open = true;
        self.text_out = self.nout;
        self.nout = self.nout + 1;
        let at = to_string(self.text_out);
        let out = line(
            "{\"type\":\"response.output_item.added\",\"output_index\":" + at + ",\"item\":"
                + message_item(self.item_id, "in_progress", "", false) + ",\"sequence_number\":"
                + to_string(self.seq) + "}",
        )
            + line(
                "{\"type\":\"response.content_part.added\",\"item_id\":" + q(self.item_id)
                    + ",\"output_index\":" + at
                    + ",\"content_index\":0,\"part\":{\"type\":\"output_text\",\"text\":\"\",\"annotations\":[]},\"sequence_number\":"
                    + to_string(self.seq + 1) + "}",
            );
        self.seq = self.seq + 2;
        return out;
    }

    /// The events that open the reasoning item, once.
    @unbounded
    fn open_thought() -> String {
        if self.thought_open { return ""; }
        self.thought_open = true;
        self.thought_out = self.nout;
        self.nout = self.nout + 1;
        self.thought_item = "rs_" + self.suffix();
        let out = line(
            "{\"type\":\"response.output_item.added\",\"output_index\":"
                + to_string(self.thought_out)
                + ",\"item\":" + reasoning_item(self.thought_item, "") + ",\"sequence_number\":"
                + to_string(self.seq) + "}",
        );
        self.seq = self.seq + 1;
        return out;
    }

    /// The events that close the reasoning item, when it is open: before
    /// the answer or a tool call begins, or at the end.
    @unbounded
    fn close_thought() -> String {
        if !self.thought_open || self.thought_closed { return ""; }
        self.thought_closed = true;
        let item = reasoning_item(self.thought_item, self.thought);
        self.done_items = self.done_items + (if len(self.done_items) > 0 { "," } else { "" })
            + item;
        let at = to_string(self.thought_out);
        let out = line(
            "{\"type\":\"response.reasoning_text.done\",\"item_id\":" + q(self.thought_item)
                + ",\"output_index\":" + at + ",\"content_index\":0,\"text\":" + q(self.thought)
                + ",\"sequence_number\":" + to_string(self.seq) + "}",
        )
            + line(
                "{\"type\":\"response.output_item.done\",\"output_index\":" + at + ",\"item\":"
                    + item
                    + ",\"sequence_number\":" + to_string(self.seq + 1) + "}",
            );
        self.seq = self.seq + 2;
        return out;
    }

    /// The events that close the message item, when it is open.
    @unbounded
    fn close_text(state: String) -> String {
        if !self.text_open || self.text_closed { return ""; }
        self.text_closed = true;
        let item = message_item(self.item_id, state, self.text, true);
        self.done_items = self.done_items + (if len(self.done_items) > 0 { "," } else { "" })
            + item;
        let at = to_string(self.text_out);
        let out = line(
            "{\"type\":\"response.output_text.done\",\"item_id\":" + q(self.item_id)
                + ",\"output_index\":" + at + ",\"content_index\":0,\"text\":" + q(self.text)
                + ",\"logprobs\":[],\"sequence_number\":" + to_string(self.seq) + "}",
        )
            + line(
                "{\"type\":\"response.content_part.done\",\"item_id\":" + q(self.item_id)
                    + ",\"output_index\":" + at
                    + ",\"content_index\":0,\"part\":{\"type\":\"output_text\",\"text\":"
                    + q(self.text) + ",\"annotations\":[]},\"sequence_number\":"
                    + to_string(self.seq + 1) + "}",
            )
            + line(
                "{\"type\":\"response.output_item.done\",\"output_index\":" + at + ",\"item\":"
                    + item
                    + ",\"sequence_number\":" + to_string(self.seq + 2) + "}",
            );
        self.seq = self.seq + 3;
        return out;
    }

    /// The events that close the tool call being built, when there is one;
    /// `complete` unless the model was cut off by the output cap. Its
    /// arguments are checked whole (tool_args.hl), their repair as they
    /// came ended: as repaired when that makes them one JSON object, which
    /// every delta already carried. Arguments that are not one, from an
    /// answer the model finished: when nothing of the call has left the
    /// node (`call_frags` under 2), the run fails, so the attempt may go to
    /// another seat; when its deltas have, the call ends with its text kept
    /// as one (`unparsed_args`) if its tool takes members its parameters do
    /// not name, else the run fails, after output. A call the output cap
    /// cut off is `incomplete`, its arguments as far as they came.
    @unbounded
    fn close_call(complete: Bool) -> String {
        if self.call_at < 0 { return ""; }
        let tail = self.call_scan.flush();
        self.call_args = self.call_args + tail;
        let mut out = self.call_held;
        self.call_held = "";
        let mut status = "completed";
        if complete && blank_args(self.call_args) {
            // a call with no arguments at all: an empty object, as a call
            // of a tool that takes none is
            self.call_args = self.call_args + "{}";
            out = out + self.args_delta("{}");
        } else if len(tail) > 0 {
            out = out + self.args_delta(tail);
        }
        let verdict = args_verdict(self.call_args);
        if !complete && verdict == "bad" {
            status = "incomplete";
        } else if verdict == "bad" {
            if self.call_frags < 2 || !tool_takes_more(self.req, self.call_name) {
                self.failure = "the engine wrote the arguments of its call of `" + self.call_name
                    + "` as something other than a JSON object"
                    + (if self.call_frags < 2 {
                        ""
                    } else {
                        ", after they began to stream, and the tool takes no members its parameters do not name"
                    });
                self.done = true;
                self.call_at = -1;
                return "";
            }
            self.call_args = unparsed_args(self.call_raw);
        }
        if self.call_args != self.call_raw {
            self.repairs = self.repairs + (if len(self.repairs) > 0 { "," } else { "" })
                + "{\"call_id\":" + q(self.call_id) + ",\"name\":" + q(self.call_name)
                + ",\"arguments\":" + q(mended_utf8(self.call_raw)) + "}";
        }
        let item = function_call_item(
            self.call_item,
            self.call_id,
            self.call_name,
            self.call_args,
            status,
        );
        self.done_items = self.done_items + (if len(self.done_items) > 0 { "," } else { "" })
            + item;
        out = out
            + line(
                "{\"type\":\"response.function_call_arguments.done\",\"item_id\":"
                    + q(self.call_item) + ",\"output_index\":" + to_string(self.call_out)
                    + ",\"arguments\":" + q(self.call_args) + ",\"sequence_number\":"
                    + to_string(self.seq) + "}",
            )
            + line(
                "{\"type\":\"response.output_item.done\",\"output_index\":"
                    + to_string(self.call_out) + ",\"item\":" + item + ",\"sequence_number\":"
                    + to_string(self.seq + 1) + "}",
            );
        self.seq = self.seq + 2;
        self.call_at = -1;
        return out;
    }

    /// The delta event of `piece` of the call's arguments, numbered.
    fn args_delta(piece: String) -> String {
        let out = line(
            "{\"type\":\"response.function_call_arguments.delta\",\"item_id\":"
                + q(self.call_item) + ",\"output_index\":" + to_string(self.call_out)
                + ",\"delta\":" + q(piece) + ",\"sequence_number\":" + to_string(self.seq) + "}",
        );
        self.seq = self.seq + 1;
        return out;
    }

    /// One fragment of an upstream tool call: a new index opens a call (the
    /// one before it is whole), and its argument text is relayed as it
    /// arrives, repaired as it comes (`ArgsScanner`). The upstream sends
    /// calls in index order. A call's events are held back until a second
    /// of its fragments carries arguments (`close_call`).
    @unbounded
    fn tool_fragment(f: String) -> String {
        let at = std::json::string_field(f, "index");
        let idx = if at.kind == "number" {
            std::json::find_int_field(f, "index")
        } else {
            if self.call_at < 0 { 0 } else { self.call_at }
        };
        let fn_raw = std::str::trim(std::json::find_field_raw(f, "function"));
        let name = std::json::find_string_field(fn_raw, "name");
        let mut out = "";
        if idx != self.call_at {
            if idx < self.call_at {
                self.failure = "the upstream interleaved its tool calls";
                self.done = true;
                return "";
            }
            out = self.preamble() + self.close_thought() + self.close_text("completed")
                + self.close_call(true);
            if len(self.failure) > 0 { return out; }
            self.call_at = idx;
            self.call_out = self.nout;
            self.nout = self.nout + 1;
            self.calls = self.calls + 1;
            self.call_item = "fc_" + self.suffix() + "_" + to_string(idx);
            let given = std::json::find_string_field(f, "id");
            self.call_id = if len(given) > 0 {
                given
            } else {
                "call_" + self.suffix() + "_" + to_string(idx)
            };
            self.call_name = name;
            self.call_args = "";
            self.call_raw = "";
            self.call_frags = 0;
            self.call_scan.reset();
            self.call_held = line(
                "{\"type\":\"response.output_item.added\",\"output_index\":"
                    + to_string(self.call_out) + ",\"item\":"
                    + function_call_item(
                        self.call_item,
                        self.call_id,
                        self.call_name,
                        "",
                        "in_progress",
                    )
                    + ",\"sequence_number\":" + to_string(self.seq) + "}",
            );
            self.seq = self.seq + 1;
        } else if len(name) > 0 && len(self.call_name) == 0 {
            self.call_name = name;
        }
        // arguments are a JSON text in fragments; some servers send an object whole
        let akind = std::json::string_field(fn_raw, "arguments").kind;
        let args = if akind == "string" {
            std::json::find_string_field(fn_raw, "arguments")
        } else if akind == "object" || akind == "array" {
            std::str::trim(std::json::find_field_raw(fn_raw, "arguments"))
        } else {
            ""
        };
        if len(args) > 0 {
            self.call_raw = self.call_raw + args;
            self.args_len = self.args_len + len(args);
            self.call_frags = self.call_frags + 1;
            let piece = self.call_scan.feed(args);
            self.call_args = self.call_args + piece;
            let delta = if len(piece) > 0 { self.args_delta(piece) } else { "" };
            if self.call_frags < 2 {
                self.call_held = self.call_held + delta;
            } else {
                out = out + self.call_held + delta;
                self.call_held = "";
            }
        }
        return out;
    }

    /// Of `input` tokens, those the engine's prompt cache held: as its
    /// usage says, else as llama-server's timings say, else none.
    fn cached_of(input: Int) -> Int {
        let held = if self.cached >= 0 {
            self.cached
        } else if self.cache_n >= 0 {
            self.cache_n
        } else {
            0
        };
        return if held > input { input } else { held };
    }

    /// Of `output` tokens, the model's thinking: as the engine counts it,
    /// else its share of the output by the length of what it thought
    /// beside what it answered and called.
    fn reasoning_of(output: Int) -> Int {
        if self.reasoning >= 0 {
            return if self.reasoning > output { output } else { self.reasoning };
        }
        let thought = len(self.thought);
        if thought == 0 { return 0; }
        let all = thought + len(self.text) + self.args_len;
        return output * thought / all;
    }

    /// End the run: close the connection and say how it went, with the
    /// events that close the stream as the script.
    fn finish() -> StaticRun {
        let served = self.cfg.model;
        if len(self.failure) > 0 { return compat_failed(self.cfg, served, self.failure); }
        if !self.began { return compat_failed(self.cfg, served, "the upstream sent no output"); }
        let complete = self.finish_reason != "length";
        let state = if complete { "completed" } else { "incomplete" };
        // a call still open is whole now, and is checked: its arguments may
        // fail the run (a call open means the message and the thinking are
        // closed already, so this comes first in the script as it is)
        let call_tail = self.close_call(complete);
        if len(self.failure) > 0 { return compat_failed(self.cfg, served, self.failure); }
        let input = if self.input < 0 { tokens_of(input_chars(self.req)) } else { self.input };
        let output = if self.output < 0 {
            // thinking is output too, as the upstream counts it
            tokens_of(len(self.text) + len(self.thought) + self.args_len)
        } else {
            self.output
        };
        let cached = self.cached_of(input);
        let reasoning = self.reasoning_of(output);
        let tail = self.close_thought() + self.close_text(state) + call_tail;
        let end = line(
            "{\"type\":" + q(if complete { "response.completed" } else { "response.incomplete" })
                + ",\"response\":"
                + response_object(
                    self.id,
                    self.created,
                    state,
                    self.model,
                    self.req,
                    self.done_items,
                    usage_details(input, cached, output, reasoning),
                )
                + ",\"sequence_number\":" + to_string(self.seq) + "}",
        );
        return StaticRun {
            script: tail + end,
            outcome: if complete { "served" } else { "incomplete" },
            model: if len(self.ran) > 0 { self.ran } else { served },
            input_tokens: input,
            output_tokens: output,
            cost_micros: compat_cost(self.cfg, input, output),
            repairs: self.repairs
        };
    }
}

fn upstream_for(
    id: String,
    model: String,
    body: String,
    c: CompatConfig,
    status: Int,
    sse: String
) -> Upstream {
    return Upstream {
        cfg: c,
        id: id,
        model: model,
        req: body,
        canned: CannedSse { status: status, body: sse_lf(sse) },
    };
}

/// Run the stream to its end, collecting every event: the script of the
/// run, as `compat_play` and `run_compat` hand it back.
@unbounded
fn drain(up: Upstream) -> StaticRun {
    let script = std::bytes::BytesBuilder { initial_cap: 4096 };
    while !up.done {
        let d = up.next_data();
        if len(d) > 0 { script.append_str(up.feed(d)); }
    }
    let end = up.finish();
    if end.outcome == "failed" { return end; }
    script.append_str(end.script);
    let played = script.snapshot() or b"";
    return StaticRun {
        script: std::str::from_bytes(played),
        outcome: end.outcome,
        model: end.model,
        input_tokens: end.input_tokens,
        output_tokens: end.output_tokens,
        cost_micros: end.cost_micros,
        repairs: end.repairs,
    };
}

/// Play an upstream's whole answer as a run. `status` is the HTTP status
/// (0 when the upstream could not be reached), `sse` its body.
fn compat_play(
    id: String,
    model: String,
    served: String,
    body: String,
    c: CompatConfig,
    status: Int,
    sse: String
) -> StaticRun {
    if status == 0 {
        return compat_failed(c, served, "the upstream at " + c.base_url + " could not be reached");
    }
    let up = upstream_for(id, model, body, c, status, sse);
    return drain(up);
}

/// The upstream's events off the wire for `body`, http or https alike.
fn upstream_over_wire(id: String, model: String, body: String, c: CompatConfig) -> Upstream {
    let up = Upstream {
        cfg: c,
        id: id,
        model: model,
        req: body,
        use_wire: true,
        wire: HttpSse {
            url: c.base_url,
            vault: c.key_vault,
            key: c.engine_key,
            request: compat_request(body, c),
        },
    };
    up.wire.open();
    return up;
}

/// Answer one request on the upstream, collecting the events.
fn run_compat(id: String, model: String, body: String, c: CompatConfig) -> StaticRun {
    return drain(upstream_over_wire(id, model, body, c));
}

// ---- decision models ------------------------------------------------

/// The one event a decision model's run plays: its upstream's answer, whole
/// (protocol.yaml `DecisionAnswer`).
fn decision_event(answer: String) -> String {
    return "{\"type\":\"decision.answer\",\"answer\":" + one_line(answer) + "}";
}

/// JSON on one line: a run's script is an event a line, and an upstream may
/// lay its answer out over many. A line break in JSON is only ever space
/// between tokens (inside a string it is escaped), so each becomes a space.
fn one_line(json: String) -> String {
    let v = std::str::bytes_view(json);
    let b = std::bytes::BytesBuilder { initial_cap: v.n };
    let mut i = 0;
    while i < v.n {
        let c = std::str::byte_at(v, i);
        if c == 10 || c == 13 { b.append_str(" "); } else { b.append_u8(c); }
        i = i + 1;
    }
    return std::str::from_bytes(b.snapshot() or b"");
}

/// `body`, a systemone request, naming `model` for the upstream: any
/// `model` it carried is replaced, the rest kept as it was.
fn systemone_request(body: String, model: String) -> String {
    let b = std::str::trim(body);
    if !std::json::valid_object(b) { return b; }
    let inner = std::str::trim(b[1..(len(b) - 1)]);
    let mut kept = "";
    let mut it = std::json::object_first(b);
    while !it.done {
        if !std::json::obj_key_eq(it, b, "model") {
            kept = kept + (if len(kept) > 0 { "," } else { "" })
                + q(std::json::obj_key_string(it, b))
                + ":" + std::json::obj_value_raw(it, b);
        }
        it = std::json::object_next(it, b);
    }
    return "{\"model\":" + q(model)
        + (if len(inner) > 0 && len(kept) > 0 { "," + kept } else { "" }) + "}";
}

/// A decision model's request posted whole, keyed with the seat's API key
/// when it has one (a revealed key is written in the statement that reveals
/// it, as `HttpSse.whole` does), or a managed seat's with its own server's
/// `key`.
locus SystemOnePost {
    params {
        vault: String = "";
        key: String = "";
    }

    @unbounded
    fn post(url: std::http::Url, body: String) -> std::http::ClientResponse {
        if len(self.vault) == 0 {
            return std::http::request(
                std::http::ClientRequest {
                    method: "POST",
                    url: url,
                    headers: "Content-Type: application/json\r\nAccept: application/json"
                        + (if len(self.key) > 0 { "\r\n" + engine_auth(self.key) } else { "" }),
                    body: std::bytes::from_string(body),
                },
            ) or std::http::ClientResponse { status: 0, body: b"" };
        }
        let credential = std::secret::Credential { vault: self.vault };
        return std::http::request(
            std::http::ClientRequest {
                method: "POST",
                url: url,
                headers: "Content-Type: application/json\r\nAccept: application/json\r\nAuthorization: Bearer "
                    + credential.reveal_text(),
                body: std::bytes::from_string(body),
            },
        ) or std::http::ClientResponse { status: 0, body: b"" };
    }
}

/// A seat's run when the request is a decision model's (`endpoint:
/// decision`) or the seat is a decision server's: an openai-compatible seat,
/// whose upstream answers it, and a managed seat whose server is `decision`
/// (run.hl) serve a decision model's request; any other seat refuses one,
/// so the coordinator moves on, and a decision seat refuses everything
/// else. An outcome of "" is no decision here: the seat's usual run.
fn decision_dispatch(
    kind: String,
    config: String,
    msg: String,
    model: String,
    request: String,
    cc: CompatConfig
) -> StaticRun {
    let ep = std::json::string_field(msg, "endpoint");
    let decision = ep.kind == "string" && ep.text == "decision";
    let decider = kind == "managed"
        && std::json::find_string_field(std::json::find_field_raw(config, "runtime"), "server")
        == "decision";
    if !decision && !decider { return StaticRun { outcome: "" }; }
    if !decision {
        return StaticRun {
            outcome: "failed",
            failure: "this seat serves only a decision model's requests",
            model: model,
        };
    }
    if kind != "openai-compatible" && !decider {
        return StaticRun {
            outcome: "failed",
            failure: "this seat serves no decision model",
            model: model,
        };
    }
    let em = std::json::string_field(msg, "engine_model");
    let mut run = run_systemone(model, if em.kind == "string" { em.text } else { "" }, request, cc);
    // a managed decision server is voice's own, started to serve the catalog
    // model its placement names, but it answers with its weights' own name
    // (it takes no alias, as llama-server's `--alias` is): the model served
    // is the catalog's, as every other managed seat reports it
    if decider {
        let catalog = std::json::find_string_field(config, "model");
        if len(catalog) > 0 { run.model = catalog; }
    }
    return run;
}

/// A decision model's request (`serve` with `endpoint: decision`): the
/// body posted whole to `<base_url>/systemone`, the upstream's answer played
/// as one `decision.answer` event. A refused or unreachable upstream is a
/// failed run, with the upstream's own error, so the coordinator moves on.
@unbounded
fn run_systemone(model: String, engine_model: String, body: String, c: CompatConfig) -> StaticRun {
    let served = if len(engine_model) > 0 { engine_model } else { c.model };
    if len(c.problem) > 0 { return compat_failed(c, served, c.problem); }
    let parsed = std::http::parse_url(c.base_url + "/systemone") or {
        return compat_failed(c, served, "the upstream at " + c.base_url + " is no URL");
    };
    let r = SystemOnePost { vault: c.key_vault, key: c.engine_key }.post(
        parsed,
        systemone_request(body, served),
    );
    if r.status == 0 {
        return compat_failed(c, served, "the upstream at " + c.base_url + " could not be reached");
    }
    let text = std::str::trim(std::str::from_bytes(r.body));
    if r.status < 200 || r.status >= 300 {
        return compat_failed(c, served, error_datum(r.status, text).failure);
    }
    if !std::json::valid_object(text) || std::json::string_field(text, "answers").kind != "object" {
        return compat_failed(c, served, "the upstream's answer is not a systemone answer");
    }
    let ran = std::json::string_field(text, "model");
    let input = std::json::find_int_field(std::json::find_field_raw(text, "usage"), "input_tokens");
    return StaticRun {
        script: line(decision_event(text)),
        outcome: "served",
        model: if ran.kind == "string" && len(ran.text) > 0 { ran.text } else { served },
        input_tokens: if input > 0 { input } else { 0 },
        output_tokens: 0,
        cost_micros: compat_cost(c, if input > 0 { input } else { 0 }, 0)
    };
}
