// The api's link to the nodes: NATS, as ../spec/protocol.yaml says. The
// api publishes `assign` on a node's subject, and `serve` as a request
// whose answer is the node's ack; the node then streams the request's
// events and its result to the reply subject the api named. A queued
// request (queue.hl) is published instead as a ticket to the work stream,
// and its attempt answers the claims seats make on it: the one it grants
// (the `serve` message, body and all) then streams as an accepted `serve`
// does.
//
// Everything above reaches it through `Link`, so the tests serve through
// a node of their own, in process.

import "../lib/pond/realtime/nats" as nats;

/// How one `serve` went. `ack` is `accepted`, `refused` (with `reason`,
/// and `refusal`, its kind), `unanswered` (no ack in time: a seat failure)
/// or `lost` (the link is down). For an accepted request, `outcome` is the
/// result's (`served`, `incomplete`, `failed`, `cancelled`), or
/// `unfinished` when no result came before the wait ran out; `response` is the response object the
/// terminal event carried, as JSON.
type ServeOutcome {
    ack: String = "";
    reason: String = "";
    // for `refused`: `capacity` when the seat or its node serves its most
    // at once (`at_capacity`), `unavailable` for any other refusal
    refusal: String = "";
    outcome: String = "unfinished";
    // the result's `served.model`, and its timing
    model: String = "";
    first_output_ms: Int = 0;
    engine_ms: Int = 0;
    // for `failed`: the result's error
    error_code: String = "";
    error_message: String = "";
    retryable: Bool = false;
    response: String = "";
    // a decision model's answers (decision.hl), "" for any other
    decision: String = "";
    // whether output reached the api before the seat failed
    output: Bool = false;
    // the result's `tool_arguments_repaired`: the calls whose arguments the
    // node repaired, each its call id, name and arguments as the engine
    // wrote them, as a JSON list; "" for none
    repairs: String = "";
}

interface Link {
    /// Where NATS is, from a node's side: what registration tells it.
    fn place() -> String;
    /// The root every subject is under: `voice`, or the habitat broker's
    /// prefix (lib/broker).
    fn root() -> String;
    /// Publish `body` on `<root>.node.<node>.assign`; false when it could
    /// not be sent.
    fn assign(node: String, body: String) -> Bool;
    /// Offer `body` (the `serve` message of `request_id`, naming
    /// `reply_to`, as it goes on the wire) to the node: the offer, its own,
    /// so requests served at once each wait on theirs.
    fn offer(node: String, request_id: String, reply_to: String, body: Bytes) -> Offer;
    /// The work stream's incarnation as this instance last saw it
    /// (queue.hl `QueueKeeper`), 0 while it is not there: a request is
    /// queued only while it is.
    fn queues() -> Int;
    /// Attempt `attempt` of the queued request `request_id`: listening on
    /// `reply_to` for its claims and its seat's answer, its own, with no
    /// copy of its ticket published yet (`Offer.put`).
    fn queue(request_id: String, attempt: Int, reply_to: String) -> Offer;
}

/// One request's offer to one seat, from its ack to its finish.
interface Offer {
    /// The node's ack: `accepted`, `refused`, `unanswered` or `lost`, with
    /// `reason`. An accepted offer stays open for `next` until `finish`.
    fn ack() -> ServeOutcome;
    /// The offer's next message, waiting at most `wait`: an `event` (the
    /// standard event object), `alive` (the seat at work, though it sends
    /// no event yet), the `result`, `none` when the wait ran out, or `lost`.
    fn next(wait: Duration) -> LinkMsg;
    /// End the offer; one whose result has not come is sent `cancel`. A
    /// queued attempt whose copy is still in the work stream, no seat
    /// granted, leaves the claims on it to the instance's keeper, which
    /// declines them `gone` (queue.hl).
    fn finish();
    /// A queued attempt's copy of its ticket (`ticket`, its JSON) published
    /// to `subject` under its message id `msg_id`, waiting `ttl_ms` at
    /// most: "" once the work stream holds it; `full` when its partition
    /// holds its most; `no_stream` when no stream takes it; else `lost:`
    /// and why.
    fn put(subject: String, msg_id: String, ttl_ms: Int, ticket: String) -> String;
    /// Each copy published again under its own message id, each to wait
    /// `ttl_ms` at most: the work stream was made again. How many it took.
    fn republish(ttl_ms: Int) -> Int;
    /// A queued attempt's next claim before it is granted, waiting at most
    /// `wait`: `claim` (a claim it may grant), `none`, or `lost`.
    fn claim(wait: Duration) -> ClaimIn;
    /// Decline the claim `claim` gave last, for `reason`.
    fn decline(reason: String);
    /// Grant the claim `claim` gave last, by seat `seat` (`<node>/<seat>`)
    /// for its copy `copy`: `grant` is the `serve` message for that seat.
    /// The attempt is an accepted offer from then on; a claim it reads
    /// after is declined `taken`, or, the same seat and copy again, granted
    /// again.
    fn grant(grant: Bytes, seat: String, copy: String);
}

/// A claim on a queued attempt (`Offer.claim`): `kind` is `claim`, `none`
/// when the wait ran out, or `lost`.
type ClaimIn { kind: String = "none"; claim: work::Claim = work::Claim { }; }

/// One message of an open offer. `json` is the event object, or the result.
type LinkMsg { kind: String = "none"; json: String = ""; }

/// True when the seat refused only because it, or its node, serves its
/// most at once (protocol.yaml `ServeAck.refusal`): it has not failed, and
/// takes the request once a slot frees.
fn at_capacity(o: ServeOutcome) -> Bool {
    return o.ack == "refused" && o.refusal == "capacity";
}

/// Read an accepted offer to its result: the whole outcome, for an answer
/// that is not streamed. The seat has `first` from each message to the
/// next until its first output, and `idle` once output has come; `alive`
/// is a message, so a seat at work on what it sends at the end is waited
/// for while it says so.
fn read_over(
    offer: Offer,
    accepted: ServeOutcome,
    first: Duration,
    idle: Duration
) -> ServeOutcome {
    let mut out = accepted;
    let mut deadline = std::time::monotonic() + first;
    let mut done = false;
    while !done && std::time::monotonic() < deadline {
        let m = offer.next(1s);
        if m.kind == "event" {
            out = take_event(out, m.json);
        } else if m.kind == "result" {
            out = take_result(out, m.json);
            done = true;
        } else if m.kind == "lost" {
            done = true;
        }
        if m.kind == "event" || m.kind == "result" || m.kind == "alive" {
            deadline = std::time::monotonic() + (if out.output { idle } else { first });
        }
    }
    offer.finish();
    return out;
}

/// The link over core NATS. Each use opens a connection of its own and
/// closes it after: a client held for the api's life keeps part of every
/// message it frames (FRICTION.md), and a connection to NATS on the
/// private network costs a millisecond, against a request that holds the
/// api for as long as its seat takes.
locus NatsLink {
    params {
        // the address the api dials; "" for no NATS (nothing is sent)
        url: String = "";
        // the address nodes dial, when theirs differs
        node_url: String = "";
        // grafted, the habitat broker's account (its user, and the vault
        // entry of its password), the root of its subjects and where a
        // request's inbox is (lib/broker); standalone, none, `voice` and
        // NATS's own
        user: String = "";
        vault: String = "";
        subjects: String = "voice";
        inbox: String = "_INBOX";
        // the instance's book (queue.hl): the work stream as its keeper last
        // saw it, and the claims left over
        book: QueueBook = QueueBook { };
    }

    fn place() -> String { return if len(self.node_url) > 0 { self.node_url } else { self.url }; }

    fn root() -> String { return self.subjects; }

    fn assign(node: String, body: String) -> Bool {
        if len(self.url) == 0 { return false; }
        let c = nats::NatsClient {
            url: self.url,
            name: "voice-api",
            user: self.user,
            credential: std::secret::Credential { vault: self.vault },
        };
        if !c.open() {
            log_warn(
                "NATS unreachable",
                fields2(std::log::kv("nats", self.url), std::log::kv("error", c.last_error)),
            );
            return false;
        }
        let mut sent = true;
        c.pub_msg(
            self.subjects + ".node." + node + ".assign",
            "",
            std::bytes::from_string(body),
        ) or {
            sent = false;
        };
        c.flush() or { sent = false; };
        c.close();
        return sent;
    }

    /// Subscribe to the attempt's replies first, then offer it, so no
    /// event can arrive before the api listens. Each offer is an attempt
    /// of its own, with its own connection, held by the request that made
    /// it, so requests served at once never share one. (The data plane is a
    /// per-message handler of the Rest listener, so the analysis sees this
    /// allocation as one per request, as it is.)
    @unbounded
    fn offer(node: String, request_id: String, reply_to: String, body: Bytes) -> Offer {
        if len(self.url) == 0 {
            return NatsAttempt {
                outcome: ServeOutcome { ack: "lost", reason: "no NATS is configured" },
            };
        }
        let a = NatsAttempt {
            node: node,
            reply_to: reply_to,
            request_id: request_id,
            subjects: self.subjects,
            c: nats::NatsClient {
                name: "voice-api",
                user: self.user,
                credential: std::secret::Credential { vault: self.vault },
                inbox_prefix: self.inbox,
            },
        };
        a.send(self.url, body);
        return a;
    }

    fn queues() -> Int { return incarnation_in(self.book); }

    /// Listen on the attempt's replies first, then publish its copies
    /// (`put`), so no claim can come before the api listens. Each attempt
    /// has a connection of its own, as an offer does.
    @unbounded
    fn queue(request_id: String, attempt: Int, reply_to: String) -> Offer {
        if len(self.url) == 0 {
            return NatsAttempt {
                queued: true,
                outcome: ServeOutcome { ack: "lost", reason: "no NATS is configured" },
            };
        }
        let a = NatsAttempt {
            reply_to: reply_to,
            request_id: request_id,
            attempt: attempt,
            subjects: self.subjects,
            queued: true,
            book: self.book,
            c: nats::NatsClient {
                name: "voice-api",
                user: self.user,
                credential: std::secret::Credential { vault: self.vault },
                inbox_prefix: self.inbox,
            },
        };
        a.listen(self.url);
        return a;
    }
}

/// One offer over NATS, from its subscription to its finish. Only messages
/// that name its request count. A seat the api stops waiting for (no ack in
/// time, no result before `finish`, the connection lost) is sent `cancel`,
/// so it stops serving a request nobody reads.
locus NatsAttempt {
    params {
        node: String = "";
        reply_to: String = "";
        request_id: String = "";
        subjects: String = "voice";
        c: nats::NatsClient = nats::NatsClient { name: "voice-api" };
        open: Bool = false;
        finished: Bool = false;
        // the node's ack, once `send` has offered it
        outcome: ServeOutcome = ServeOutcome { ack: "lost" };
        // a queued attempt (queue.hl): its number, whether it listens on
        // its replies, the instance's book, its copies as published
        // (`<subject>\t<message id>\t<ticket>` a line) and the latest
        // their waits end at (Unix ms), the reply subject of the claim read
        // last, and the claim it granted with its grant, kept until its
        // seat first answers, should that claim come again
        queued: Bool = false;
        attempt: Int = 1;
        listening: Bool = false;
        book: QueueBook = QueueBook { };
        copies: String = "";
        until_ms: Int = 0;
        claim_reply: String = "";
        granted_seat: String = "";
        granted_copy: String = "";
        grant_body: Bytes = b"";
    }

    fn ack() -> ServeOutcome { return self.outcome; }

    /// Listen on the attempt's replies at `url`; its outcome `lost` when it
    /// cannot.
    fn listen(url: String) { self.outcome = self.listened(url); }

    fn listened(url: String) -> ServeOutcome {
        self.c.url = url;
        if !self.c.open() {
            return ServeOutcome {
                ack: "lost",
                reason: "NATS unreachable at " + url + ": " + self.c.last_error,
            };
        }
        let sid = self.c.sub_to(self.reply_to + ".>", "") or - 1;
        if sid < 0 {
            let why = self.c.last_error;
            self.c.close();
            return ServeOutcome { ack: "lost", reason: why };
        }
        self.listening = true;
        return ServeOutcome { };
    }

    @unbounded
    fn put(subject: String, msg_id: String, ttl_ms: Int, ticket: String) -> String {
        if !self.listening { return "lost: " + self.outcome.reason; }
        let headers = ticket_headers(msg_id, ttl_ms) or {
            return "lost: " + err.detail;
        };
        let mut e = nats::NatsError { };
        let stored = nats::js_publish_headers(
            self.c,
            subject,
            headers,
            std::bytes::from_string(ticket),
        ) or {
            e = err;
            nats::PubAck { }
        };
        if len(e.kind) > 0 {
            // a refusal by its own result, never the client's sticky
            // `last_error`: 10077, the partition at its most; no stream
            // takes the subject (no responder, or 10059)
            if e.kind == "jetstream" && e.code == 10077 { return "full"; }
            if e.kind == "jetstream" && (e.code == 0 || e.code == 10059) {
                // this instance queues nothing more until its keeper sees
                // the stream again
                note_incarnation(self.book, 0);
                return "no_stream";
            }
            return "lost: " + e.kind + ": " + e.detail;
        }
        self.copies = self.copies + subject + "\t" + msg_id + "\t" + ticket + "\n";
        let until = unix_ms() + ttl_ms;
        if until > self.until_ms { self.until_ms = until; }
        return "";
    }

    @unbounded
    fn republish(ttl_ms: Int) -> Int {
        if !self.listening { return 0; }
        let mut took = 0;
        let v = std::str::bytes_view(self.copies);
        let mut at = 0;
        while at < v.n {
            let rest = std::str::slice(v, at, v.n);
            let nl = std::str::index_of(rest, "\n");
            let end = if nl < 0 { v.n } else { at + nl };
            let line = std::str::slice(v, at, end);
            at = end + 1;
            let t1 = std::str::index_of(line, "\t");
            let tail = if t1 >= 0 { line[(t1 + 1)..len(line)] } else { "" };
            let t2 = std::str::index_of(tail, "\t");
            if t1 > 0 && t2 > 0 {
                let headers = ticket_headers(tail[0..t2], ttl_ms) or "";
                let mut ok = len(headers) > 0;
                if ok {
                    let stored = nats::js_publish_headers(
                        self.c,
                        line[0..t1],
                        headers,
                        std::bytes::from_string(tail[(t2 + 1)..len(tail)]),
                    ) or {
                        ok = false;
                        nats::PubAck { }
                    };
                }
                if ok { took = took + 1; }
            }
        }
        let until = unix_ms() + ttl_ms;
        if until > self.until_ms { self.until_ms = until; }
        return took;
    }

    @unbounded
    fn claim(wait: Duration) -> ClaimIn {
        if !self.listening { return ClaimIn { kind: "lost" }; }
        let deadline = std::time::monotonic() + wait;
        while std::time::monotonic() < deadline {
            if self.c.read_msg(deadline - std::time::monotonic()) {
                if self.c.last.subject == self.reply_to + ".claim"
                    && len(self.c.last.reply) > 0
                {
                    self.claim_reply = self.c.last.reply;
                    let c = work::claim_of(std::str::from_bytes(self.c.last.data)) or {
                        // not a claim: it cannot be judged, so the seat
                        // that sent it puts the ticket back for another
                        self.decline("ineligible");
                        work::Claim { request_id: "" }
                    };
                    if len(c.request_id) > 0 { return ClaimIn { kind: "claim", claim: c }; }
                }
            } else if !self.c.connected {
                return ClaimIn { kind: "lost" };
            }
        }
        return ClaimIn { kind: "none" };
    }

    fn decline(reason: String) { self.answer(std::bytes::from_string(work::decline_json(reason))); }

    fn grant(grant: Bytes, seat: String, copy: String) {
        self.answer(grant);
        self.granted_seat = seat;
        self.granted_copy = copy;
        self.grant_body = grant;
        let slash = std::str::index_of(seat, "/");
        self.node = if slash > 0 { seat[0..slash] } else { seat };
        self.outcome = ServeOutcome { ack: "accepted" };
        self.open = true;
    }

    /// The grant no longer kept: its seat has answered, so has it.
    // @unbounded: once an attempt, the first time its seat answers.
    @unbounded
    fn forget_grant() { self.grant_body = b""; }

    /// The claim read last answered with `body`.
    fn answer(body: Bytes) {
        if len(self.claim_reply) == 0 { return; }
        self.c.pub_msg(self.claim_reply, "", body) or discard;
        self.c.flush() or discard;
        self.claim_reply = "";
    }

    /// A claim read once the attempt is granted: its grant again for the
    /// granted claim itself, its answer lost (until the seat first answers,
    /// when the grant is no longer kept), `taken` for any other.
    @unbounded
    fn answer_late() {
        let c = work::claim_of(std::str::from_bytes(self.c.last.data)) or work::Claim { };
        self.claim_reply = self.c.last.reply;
        let v = claim_verdict(
            c,
            self.request_id,
            self.attempt,
            "",
            "",
            self.granted_seat,
            self.granted_copy,
        );
        if v == "again" && len(self.grant_body) > 0 {
            self.answer(self.grant_body);
        } else {
            self.decline(if v == "again" { "taken" } else { v });
        }
    }

    /// Offer `body` at `url`, its ack kept for `ack`.
    fn send(url: String, body: Bytes) { self.outcome = self.offered(url, body); }

    fn offered(url: String, body: Bytes) -> ServeOutcome {
        self.c.url = url;
        if !self.c.open() {
            return ServeOutcome {
                ack: "lost",
                reason: "NATS unreachable at " + url + ": " + self.c.last_error,
            };
        }
        let sid = self.c.sub_to(self.reply_to + ".>", "") or - 1;
        if sid < 0 {
            let why = self.c.last_error;
            self.c.close();
            return ServeOutcome { ack: "lost", reason: why };
        }
        let reply = self.c.request(
            self.subjects + ".node." + self.node + ".serve",
            body,
            5s,
        ) or nats::NatsMsg { };
        let ack = std::str::from_bytes(reply.data);
        let mut out = ServeOutcome { ack: std::json::find_string_field(ack, "outcome") };
        if len(ack) > 0 && std::json::find_string_field(ack, "request_id") != self.request_id {
            out.ack = "";
        }
        if out.ack != "accepted" {
            if len(ack) == 0 || out.ack != "refused" {
                // it may still take the request once it reads it
                let why = self.c.last_error;
                cancel(self.c, self.subjects, self.node, self.request_id);
                self.c.close();
                return ServeOutcome {
                    ack: "unanswered",
                    reason: "node " + self.node + " did not answer: " + why,
                };
            }
            self.c.close();
            out.reason = std::json::find_string_field(ack, "reason");
            out.refusal = std::json::find_string_field(ack, "refusal");
            return out;
        }
        self.open = true;
        return out;
    }

    fn next(wait: Duration) -> LinkMsg {
        if !self.open { return LinkMsg { kind: "lost" }; }
        let deadline = std::time::monotonic() + wait;
        while std::time::monotonic() < deadline {
            if self.c.read_msg(deadline - std::time::monotonic()) {
                if self.queued && self.c.last.subject == self.reply_to + ".claim" {
                    if len(self.c.last.reply) > 0 { self.answer_late(); }
                    continue;
                }
                let msg = std::str::from_bytes(self.c.last.data);
                // a message that names another request is not this one's
                if std::json::find_string_field(msg, "request_id") == self.request_id {
                    // the seat answers: it has its grant, kept no longer
                    if len(self.grant_body) > 0 { self.forget_grant(); }
                    if self.c.last.subject == self.reply_to + ".event" {
                        return LinkMsg {
                            kind: "event",
                            json: std::str::trim(std::json::find_field_raw(msg, "event")),
                        };
                    }
                    if self.c.last.subject == self.reply_to + ".alive" {
                        return LinkMsg { kind: "alive" };
                    }
                    if self.c.last.subject == self.reply_to + ".result" {
                        self.finished = true;
                        return LinkMsg { kind: "result", json: msg };
                    }
                }
            } else if !self.c.connected {
                return LinkMsg { kind: "lost" };
            }
        }
        return LinkMsg { kind: "none" };
    }

    fn finish() {
        if self.queued && self.listening && !self.open {
            // never granted: a copy still in the stream is claimed in vain,
            // which the keeper declines `gone` until its wait ends
            if len(self.copies) > 0 && self.until_ms > unix_ms() {
                leave_claims(self.book, self.reply_to, "gone", self.until_ms);
            }
            self.c.close();
            self.listening = false;
            return;
        }
        if !self.open { return; }
        if !self.finished && self.c.connected {
            cancel(self.c, self.subjects, self.node, self.request_id);
        }
        self.c.close();
        self.open = false;
        self.listening = false;
    }
}

/// `cancel` on the node's subject: the api stopped waiting for the
/// request, so the seat should stop serving it.
fn cancel(c: nats::NatsClient, subjects: String, node: String, request_id: String) {
    let msg = "{\"type\": \"cancel\", \"request_id\": " + jq(request_id)
        + ", \"reason\": \"abandoned\"}";
    c.pub_msg(subjects + ".node." + node + ".cancel", "", std::bytes::from_string(msg)) or discard;
    c.flush() or discard;
}

/// What an event tells the api: that output began, and the response the
/// terminal event carries.
fn take_event(o: ServeOutcome, event: String) -> ServeOutcome {
    let mut out = o;
    let kind = std::json::find_string_field(event, "type");
    if output_event(kind) { out.output = true; }
    if kind == "response.completed" || kind == "response.incomplete" || kind == "response.failed" {
        out.response = std::str::trim(std::json::find_field_raw(event, "response"));
    }
    // a decision model's whole answer (protocol.yaml): the standard response
    // made of it, its probabilities kept for the caller
    if kind == "decision.answer" {
        let answer = std::str::trim(std::json::find_field_raw(event, "answer"));
        out.output = true;
        out.response = decision_response(answer, "");
        out.decision = std::str::trim(std::json::find_field_raw(answer, "answers"));
    }
    return out;
}

fn take_result(o: ServeOutcome, result: String) -> ServeOutcome {
    let mut out = o;
    out.outcome = std::json::find_string_field(result, "outcome");
    out.model = std::json::find_string_field(std::json::find_field_raw(result, "served"), "model");
    let timing = std::json::find_field_raw(result, "timing");
    out.first_output_ms = std::json::find_int_field(timing, "first_output_ms");
    out.engine_ms = std::json::find_int_field(timing, "engine_ms");
    let e = std::json::find_field_raw(result, "error");
    out.error_code = std::json::find_string_field(e, "code");
    out.error_message = std::json::find_string_field(e, "message");
    out.retryable = std::json::find_bool_field(e, "retryable");
    let repaired = std::str::trim(std::json::find_field_raw(result, "tool_arguments_repaired"));
    out.repairs = if std::str::starts_with(repaired, "[") && repaired != "[]" {
        repaired
    } else {
        ""
    };
    return out;
}
