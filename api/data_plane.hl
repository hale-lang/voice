/// The data plane: every path of ../spec/openapi.yaml that is not a row of
/// the surface (surface.hl), served as the `fallback` of the same listener
/// that serves the rows (front.hl). It is a `std::http` handler of its own
/// and answers for its own callers: the exposure's bearer and roles judge
/// only the rows.
///
///   - the caller plane: the OpenAI-compatible inference wire
///     (`/v1/responses`, `/v1/chat/completions`, streamed), the models a key
///     sees and its capabilities, under the caller's project key. These are
///     the open standard's shapes and error envelope, which never move;
///   - the node link: `/node/v1/*`, under a node's enrollment token, the
///     registration answered on the node's own connection;
///   - the admin event stream (`/admin/v1/events`) and the route table
///     (`/admin/v1/routes`, the brain's JSON as stored), which no row
///     states, under the operator token (operator.hl);
///   - the app (`--ui`), the files of the admin ui.
///
/// `is_route` takes the first match in written order.
locus DataPlane {
    params {
        ui: String = "";
        // the configuration and the fleet as reported: in the process
        // unless the api is given a database (main.hl)
        store: st::Store = st::MemoryStore { };
        // the nodes, over NATS
        link: Link = NatsLink { };
        bearer: KeyBearer = KeyBearer { store: self.store };
        node_bearer: NodeBearer = NodeBearer { store: self.store };
        models: Models = Models { store: self.store };
        // the organization's ratified limits as its reader last read them,
        // under a head (governance.hl): the api's, shared with the reader
        held: HeldLimits = HeldLimits { };
        // seconds a seat may take to its first output, and may go silent
        // between events, before it has failed
        first_s: Int = 120;
        idle_s: Int = 30;
        // tell the organization each served request (events.hl)
        pulse: Bool = false;
        // the rate limits are the organization's ratified practices
        governed: Bool = false;
        // this api instance's id, kept on each request it admits
        instance: String = "";
        inference: Inference = Inference {
            instance: self.instance,
            store: self.store,
            link: self.link,
            held: self.held,
            first: self.first_s * 1s,
            idle: self.idle_s * 1s,
            pulse: self.pulse,
            governed: self.governed,
        };
        // asks a decision model about each request whose project or key
        // annotates, as requests of its project's system key (annotate.hl)
        annotator: AnnotationRunner = AnnotationRunner {
            store: self.store,
            inference: Inference {
                instance: self.instance,
                store: self.store,
                link: self.link,
                held: self.held,
                first: self.first_s * 1s,
                idle: self.idle_s * 1s,
                pulse: self.pulse,
                governed: self.governed,
            },
        };
        nodes: Nodes = Nodes { store: self.store, link: self.link };
        node_plane: NodePlane = NodePlane { store: self.store, link: self.link };
        // grafted, the nodes' account on the habitat's broker (lib/broker),
        // handed to a node in its registration's answer; "" standalone
        node_user: String = "";
        node_secret: std::secret::Credential = std::secret::Credential { };
        // the admin plane's bearer (ctl.hl): the event stream and the route
        // table take the operator token, as the rows do
        operator: AdminBearer = AdminBearer { store: self.store };
        // the port of the api's hub (hub.hl), which `GET /admin/v1/hub` tells
        hub_port: Int = 8085;
        // it carries the admin events (`AdminFeed`): an api with a database
        hub_admin: Bool = false;
        // the annotate queue (annotate.hl): each stage of a queued
        // annotation published to `<root>.annotate`, which every api
        // instance's conn (main.hl) takes in one queue group, so one reads
        // each; with no url (in process), each is read here at once
        publisher: CorePublisher = CorePublisher { };
        // the wire subject the conn hands over undecoded (`NatsInbound`)
        annotate_subject: String = "";
        // the stages being read on this instance now, at most
        // `ANNOTATE_WORKERS`: callers always come first
        reading: Int = 0;
    }

    bus {
        publish NodeObserved;
        subscribe nats::NatsInbound as on_inbound;
    }

    /// A node's report, recorded, told to the hub (hub.hl) as the node now
    /// is, as `listNodes` lists it: its seats without their configs, so a
    /// report fits a bus frame whatever its seats are placed with. A node
    /// that cannot be read is told nothing: its report stands.
    fn observed(ctx: std::api::Context, report: String) {
        let n = self.nodes.get_read(NodeRef { node: ctx.caller.name }) or {
            return;
        };
        let body = node_summary_json(n) or {
            return;
        };
        NodeObserved <- NodeObservation {
            node: n.id,
            report: report,
            at: now_seconds(),
            body: body,
        };
    }

    /// The registration's answer with the nodes' account in it, written
    /// by this method on the node's own connection: the password is
    /// revealed into that write alone (spec/semantics.md, "@sealed"), never
    /// into a value the server writes later, escaped as a JSON string in
    /// that same write.
    fn registered_with_account(req: std::http::Request, a: RegisteredRead) -> std::http::Response {
        let head = registered_head(a) + ", \"user\": " + jq(self.node_user) + ", \"password\": \"";
        let tail = "\"}, \"assignment\": " + assignment_json(a.assignment) + "}";
        std::io::tcp::send_fd(
            req.conn_fd,
            std::bytes::from_string(
                "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nContent-Length: "
                    + to_string(
                        len(head) + len(std::json::escape_string(self.node_secret.reveal_text()))
                            + len(tail),
                    )
                    + "\r\nConnection: close\r\n\r\n" + head
                    + std::json::escape_string(self.node_secret.reveal_text()) + tail,
            ),
        ) or discard;
        std::io::tcp::close_fd(req.conn_fd);
        return std::http::Response { status: 200, body: "", takeover_raw: true };
    }

    fn handle(req: std::http::Request) -> std::http::Response {
        return self.route(req) or failed(err);
    }

    fn route(req: std::http::Request) -> std::http::Response fallible(ApiError) {
        let c = std::http::build_context(req);
        whole_body(req) or raise;

        // caller plane
        if std::http::is_route(c, "POST", "/v1/responses") {
            return self.infer(req, "responses") or raise;
        }
        if std::http::is_route(c, "POST", "/v1/chat/completions") {
            return self.infer(req, "chat") or raise;
        }
        if std::http::is_route(c, "GET", "/v1/models") {
            let ctx = self.bearer.context(std::http::header(req, "Authorization")) or raise;
            let l = self.models.list(ctx) or raise;
            return caller_json(model_list_json(l));
        }
        if std::http::is_route(c, "GET", "/v1/models/:model") {
            let ctx = self.bearer.context(std::http::header(req, "Authorization")) or raise;
            let m = self.models.get(
                ModelRef { model: std::http::path_param(c.params, "model") },
                ctx,
            ) or raise;
            return caller_json(model_json(m));
        }
        if std::http::is_route(c, "GET", "/v1/capabilities") {
            let ctx = self.bearer.context(std::http::header(req, "Authorization")) or raise;
            let caps = self.models.capabilities(ctx) or raise;
            return caller_json(capabilities_json(caps));
        }

        // the hub: what the admin UI follows live (hub.hl), the admin events
        // among it when this api has a database (`AdminFeed`)
        if std::http::is_route(c, "GET", "/admin/v1/hub") {
            if !self.operator.admits(std::http::header(req, "Authorization")) {
                return operator_refusal();
            }
            return json_answer(
                200,
                "{\"port\": " + to_string(self.hub_port)
                    + ", \"topics\": [\"NodeObserved\", \"InstanceBeat\""
                    + (
                        if self.hub_admin {
                            ", \"UsageRecorded\", \"ChangeMade\", \"AnnotationKept\", \"AnnotationStepTaken\", \"NodeMoved\", \"RequestsInFlight\""
                        } else {
                            ""
                        }
                    ) + "]}",
            );
        }

        // routes
        if std::http::is_route(c, "GET", "/admin/v1/routes") {
            if !self.operator.admits(std::http::header(req, "Authorization")) {
                return operator_refusal();
            }
            // the brain's last table, from the store: no wait on NATS
            let table = self.store.route_table() or fail store_failed(err);
            if len(table) == 0 {
                fail ApiError {
                    status: 503,
                    kind: "server_error",
                    code: ErrorCode::route_table_unavailable,
                    message: "no route table yet: no brain has written one",
                };
            }
            return json_answer(200, table);
        }

        // node plane
        if std::http::is_route(c, "POST", "/node/v1/register") {
            let ctx = self.node_ctx(req) or raise;
            let r = read_registration(req.body) or raise;
            let answer = self.node_plane.register_read(r, ctx) or raise;
            self.observed(ctx, "register");
            if len(self.node_user) > 0 { return self.registered_with_account(req, answer); }
            return json_answer(200, registered_json(answer));
        }
        if std::http::is_route(c, "GET", "/node/v1/assignment") {
            let ctx = self.node_ctx(req) or raise;
            let a = self.node_plane.assignment_read(ctx) or raise;
            return json_answer(200, assignment_json(a));
        }
        if std::http::is_route(c, "POST", "/node/v1/heartbeat") {
            let ctx = self.node_ctx(req) or raise;
            let h = read_heartbeat(req.body) or raise;
            self.node_plane.heartbeat(h, ctx) or raise;
            self.observed(ctx, "heartbeat");
            return no_content();
        }
        if std::http::is_route(c, "POST", "/node/v1/seats") {
            let ctx = self.node_ctx(req) or raise;
            let st = read_seat_states(req.body) or raise;
            self.node_plane.seat_states(st, ctx) or raise;
            self.observed(ctx, "seats");
            return no_content();
        }
        if std::http::is_route(c, "PUT", "/node/v1/capabilities") {
            let ctx = self.node_ctx(req) or raise;
            let r = read_node_capabilities(req.body) or raise;
            self.node_plane.capabilities(r, ctx) or raise;
            self.observed(ctx, "capabilities");
            return no_content();
        }
        if std::http::is_route(c, "PUT", "/node/v1/local") {
            let ctx = self.node_ctx(req) or raise;
            object_body(req.body) or raise;
            let r = read_local(std::str::trim(req.body)) or raise;
            self.node_plane.local(r, ctx) or raise;
            self.observed(ctx, "local");
            return no_content();
        }
        if std::http::is_route(c, "PUT", "/node/v1/inventory") {
            let ctx = self.node_ctx(req) or raise;
            let i = read_inventory(req.body) or raise;
            self.node_plane.inventory(i, ctx) or raise;
            self.observed(ctx, "inventory");
            return no_content();
        }
        if std::http::is_route(c, "POST", "/node/v1/quota") {
            let ctx = self.node_ctx(req) or raise;
            let q = read_quota(req.body) or raise;
            self.node_plane.quota(q, ctx) or raise;
            return no_content();
        }
        if std::http::is_route(c, "POST", "/node/v1/link-checks") {
            let ctx = self.node_ctx(req) or raise;
            let r = read_link_check(req.body) or raise;
            self.node_plane.link_check(r, ctx) or raise;
            return no_content();
        }
        if std::http::is_route(c, "POST", "/node/v1/draining") {
            let ctx = self.node_ctx(req) or raise;
            let d = read_draining(req.body) or raise;
            self.node_plane.going_away(d, ctx) or raise;
            return no_content();
        }

        // annotations read now, one request or many (annotate.hl)
        if std::http::is_route(c, "POST", "/admin/v1/annotation-runs") {
            if !self.operator.admits(std::http::header(req, "Authorization")) {
                return operator_refusal();
            }
            return self.run_annotations(req, "") or raise;
        }
        if std::http::is_route(c, "POST", "/admin/v1/annotations/:request_id/run") {
            if !self.operator.admits(std::http::header(req, "Authorization")) {
                return operator_refusal();
            }
            return self.run_annotations(
                req,
                std::http::path_param(c.params, "request_id"),
            ) or raise;
        }

        // annotations of past requests, from their recordings (annotate.hl)
        if std::http::is_route(c, "POST", "/admin/v1/annotation-backfills") {
            if !self.operator.admits(std::http::header(req, "Authorization")) {
                return operator_refusal();
            }
            return self.backfill(req) or raise;
        }

        // events
        if std::http::is_route(c, "GET", "/admin/v1/events") {
            if !self.operator.admits(std::http::header(req, "Authorization")) {
                return operator_refusal();
            }
            let types = read_event_types(req.path) or {
                return ctl_response(err);
            };
            let events = AdminEvents {
                store: self.store,
                nodes: self.nodes,
                types: types,
            };
            return events.follow(
                EventStream { conn_fd: req.conn_fd },
                std::http::header(req, "Last-Event-ID"),
            );
        }

        if len(self.ui) > 0 && req.method == "GET" && is_ui_path(req.path) {
            return serve_static(self.ui, req);
        }
        return no_route(req);
    }

    /// An inference request: the caller's key, then the row's handler,
    /// which admits it and has a seat serve it. Requests are served at
    /// once, each a coroutine of the listener's: each waits on an offer of
    /// its own (link.hl), the store takes turns at its connection a
    /// statement at a time (store/pg_store.hl), and a request's limits are
    /// checked and counted with no wait between (`Inference.hold`).
    fn infer(req: std::http::Request, endpoint: String) -> std::http::Response fallible(ApiError) {
        let ctx = self.bearer.context(std::http::header(req, "Authorization")) or raise;
        let r = read_inference(req.body, endpoint) or raise;
        if r.stream {
            // the standard event stream, on this connection (stream.hl)
            let out = EventStream { conn_fd: req.conn_fd };
            let streamed = self.inference.stream(r, ctx, out) or raise;
            if !out.job.present { return streamed; }
            // annotated (annotate.hl): queued once the stream has ended;
            // read by whichever instance takes its stages, the caller
            // waiting for none of it
            if req.conn_fd >= 0 { out.close(); }
            self.queue_annotation(out.job, "", 0, "");
            return if req.conn_fd < 0 { streamed } else { taken_over() };
        }
        let s = if endpoint == "chat" {
            self.inference.chat(r, ctx) or raise
        } else {
            self.inference.respond(r, ctx) or raise
        };
        let answer = served_answer(
            s,
            if endpoint == "chat" { chat_completion_json(s) } else { response_json(s) },
        );
        if !s.job.present { return answer; }
        if req.conn_fd < 0 {
            self.queue_annotation(s.job, "", 0, "");
            return answer;
        }
        // annotated: the caller is answered, as the Server would (it closes
        // every connection after its answer), then the annotation queued
        let conn = std::io::tcp::Stream { conn_fd: req.conn_fd, owns_fd: false };
        std::http::write_response(conn, answer);
        std::io::tcp::close_fd(req.conn_fd);
        self.queue_annotation(s.job, "", 0, "");
        return taken_over();
    }

    /// `backfillAnnotations`: the recorded requests it keeps, counted and
    /// answered at once, then asked about one by one on this connection's
    /// own coroutine, as requests of each one's project's system key.
    fn backfill(req: std::http::Request) -> std::http::Response fallible(ApiError) {
        let b = AnnotationBackfill::api_decode(req.body) or {
            fail invalid(
                "the body is an AnnotationBackfill (`" + err.field + "` is " + err.kind + ")",
                err.field
            );
        };
        let a = if b.version > 0 {
            self.store.annotator_version(b.annotator, b.version) or fail metering_failed(err)
        } else {
            self.store.annotator(b.annotator) or fail metering_failed(err)
        };
        if !a.present || a.removed {
            fail ApiError {
                status: 404,
                kind: "not_found",
                code: ErrorCode::not_found,
                message: "no annotator " + b.annotator
                    + (if b.version > 0 { " at version " + to_string(b.version) } else { "" }),
                has_param: true,
                param: "annotator",
            };
        }
        let from = if len(b.from) > 0 {
            rfc3339(b.from) or fail invalid("`from` is an RFC 3339 time", "from")
        } else {
            now_seconds()
        };
        let to = if len(b.to) > 0 {
            rfc3339(b.to) or fail invalid("`to` is an RFC 3339 time", "to")
        } else {
            now_seconds()
        };
        // the slice chosen before the newest 200 of it are taken
        let kept = self.store.recorded(
            b.project,
            b.key,
            len(b.from) > 0,
            from,
            len(b.to) > 0,
            to,
            200,
        ) or fail metering_failed(err);
        let answer = std::http::Response {
            status: 202,
            content_type: "application/json",
            body: "{\"queued\": " + to_string(count(kept.rows)) + "}",
        };
        // answered first, the connection closed, as the Server would; with
        // no connection (in process), answered once asked
        if req.conn_fd >= 0 {
            let conn = std::io::tcp::Stream { conn_fd: req.conn_fd, owns_fd: false };
            std::http::write_response(conn, answer);
            std::io::tcp::close_fd(req.conn_fd);
        }
        for p in kept.rows {
            let whole = self.store.peek(p.request_id) or st::PeekRow { };
            if !whole.present { continue; }
            let u = self.store.usage(p.request_id) or st::UsageRow { };
            let dc = std::json::find_string_field(u.record, "data_class");
            self.queue_annotation(
                AnnotationJob {
                    request_id: whole.request_id,
                    project: whole.project,
                    key: whole.key,
                    conversation: std::json::find_string_field(u.record, "conversation"),
                    created_at: whole.created_at,
                    model: whole.model,
                    data_class: if len(dc) > 0 { dc } else { "internal" },
                    input: whole.input,
                    output: whole.output,
                    present: true,
                },
                a.id,
                a.version,
                "backfill of " + a.id,
            );
        }
        return if req.conn_fd >= 0 { taken_over() } else { answer };
    }

    /// `j` queued (annotate.hl), and each stage it owes asked: published
    /// on the annotate queue, or, in process (no queue), read here at once.
    @unbounded
    fn queue_annotation(j: AnnotationJob, only: String, version: Int, why: String) -> String {
        let stages = self.annotator.queue(j, only, version, why);
        // a request stage first: the stages that read its answers are
        // asked when it is read (`Worked.then`), never polled for
        let first = if std::str::contains(" " + stages + " ", " request ") {
            "request"
        } else {
            stages
        };
        self.ask_stages(j.request_id, first);
        return stages;
    }

    /// Each stage of `stages` (a space between) of a request asked.
    fn ask_stages(request_id: String, stages: String) {
        let mut rest = stages;
        while len(rest) > 0 {
            let sp = std::str::index_of(rest, " ");
            let stage = if sp < 0 { rest } else { rest[0..sp] };
            rest = if sp < 0 { "" } else { rest[(sp + 1)..len(rest)] };
            if len(stage) > 0 {
                self.ask_stage(AnnotateAsk { request_id: request_id, stage: stage, attempt: 0 });
            }
        }
    }

    /// One stage asked: on the annotate queue for whichever instance takes
    /// it; in process (no queue), read now, once, and the stages it hands
    /// on asked after it.
    @unbounded
    fn ask_stage(a: AnnotateAsk) {
        if len(self.publisher.url) == 0 {
            let w = self.annotator.work(a);
            if len(w.then) > 0 { self.ask_stages(a.request_id, w.then); }
            return;
        }
        self.publisher.send("annotate", std::bytes::from_string(AnnotateAsk::api_encode(a)));
    }

    /// A stage taken from the annotate queue: read when a reader is free;
    /// the stages it hands on asked; asked again after its wait when no
    /// seat was free (an attempt counted), or when what it reads is not
    /// given yet (none counted), until its deadline.
    @unbounded
    fn on_inbound(m: nats::Inbound) {
        if len(self.annotate_subject) == 0 || m.subject != self.annotate_subject { return; }
        let a = AnnotateAsk::api_decode(std::str::from_bytes(m.data)) or {
            log_warn("an annotate message is not one", std::log::kv("error", err.kind));
            return;
        };
        while self.reading >= ANNOTATE_WORKERS { std::time::sleep(250ms); }
        self.reading = self.reading + 1;
        let w = self.annotator.work(a);
        self.reading = self.reading - 1;
        if len(w.then) > 0 { self.ask_stages(a.request_id, w.then); }
        if !w.wait { return; }
        std::time::sleep(w.after_ms * 1ms);
        self.ask_stage(
            AnnotateAsk {
                request_id: a.request_id,
                stage: a.stage,
                attempt: if w.dependent { a.attempt } else { a.attempt + 1 },
            },
        );
    }

    /// `runAnnotations` (`POST /admin/v1/annotation-runs`) and
    /// `runAnnotation` (`POST /admin/v1/annotations/{request_id}/run`): each
    /// request named queued now, for every annotator in force or the one
    /// named, read from its held text, else its recording. Answered at
    /// once: each request queued, or refused and why.
    @unbounded
    fn run_annotations(
        req: std::http::Request,
        one: String
    ) -> std::http::Response fallible(ApiError) {
        let body = if len(std::str::trim(req.body)) == 0 { "{}" } else { req.body };
        let b = AnnotationRunAsk::api_decode(body) or {
            fail invalid(
                "the body is an AnnotationRunAsk (`" + err.field + "` is " + err.kind + ")",
                err.field
            );
        };
        let mut ids = AnnotationRunAsk { };
        if len(one) > 0 {
            if b.has_matching {
                fail invalid(
                    "the path names the request; `matching` is not taken here",
                    "matching"
                );
            }
            push(ids.request_ids, one) or discard;
        } else if b.has_matching {
            if count(b.request_ids) > 0 {
                fail invalid(
                    "name the requests in `request_ids` or match them with `matching`, not both",
                    "matching"
                );
            }
            let matched = self.matching_ids(b.matching) or raise;
            ids.request_ids = matched.request_ids;
        } else {
            ids.request_ids = b.request_ids;
        }
        if count(ids.request_ids) == 0 && !b.has_matching {
            fail invalid(
                "name at least one request in `request_ids`, or match them with `matching`",
                "request_ids"
            );
        }
        if len(b.annotator) > 0 {
            let a = if b.version > 0 {
                self.store.annotator_version(b.annotator, b.version) or fail metering_failed(err)
            } else {
                self.store.annotator(b.annotator) or fail metering_failed(err)
            };
            if !a.present || a.removed {
                fail ApiError {
                    status: 404,
                    kind: "not_found",
                    code: ErrorCode::not_found,
                    message: "no annotator " + b.annotator,
                    has_param: true,
                    param: "annotator",
                };
            }
        }
        let mut out = AnnotationRunList { };
        let mut queued = 0;
        for id in ids.request_ids {
            let r = self.run_one(id, b.annotator, b.version) or fail metering_failed(err);
            if r.queued { queued = queued + 1; }
            push(out.data, r) or discard;
        }
        // one request named: refused as itself
        if len(one) > 0 && queued == 0 {
            let r = at(out.data, 0) or AnnotationRunOutcome { };
            let unknown = r.reason == "unknown";
            fail ApiError {
                status: if unknown { 404 } else { 409 },
                kind: if unknown { "not_found" } else { "conflict" },
                code: if unknown { ErrorCode::not_found } else { ErrorCode::conflict },
                message: r.message,
            };
        }
        return std::http::Response {
            status: 202,
            content_type: "application/json",
            body: AnnotationRunList::api_encode(out),
        };
    }

    /// The newest `RUN_MAX` requests `m` matches, as `listUsage` filters
    /// them: the ids a run named by its filters annotates.
    fn matching_ids(m: UsageMatch) -> AnnotationRunAsk fallible(ApiError) {
        let mut q = usage_query_of(
            UsageAsk {
                project: m.project,
                key: m.key,
                model: m.model,
                account: m.account,
                conversation: m.conversation,
                metadata: if m.metadata.text == "null" { "" } else { m.metadata.text },
                from: m.from,
                to: m.to,
                include_internal: m.include_internal,
            },
            false,
        ) or {
            let p = ctl_problem(err);
            fail invalid(
                p.message,
                if len(p.param) > 0 { "matching." + p.param } else { "matching" }
            );
        };
        q.limit = RUN_MAX;
        let rows = self.store.usage_rows(q) or fail metering_failed(err);
        let mut out = AnnotationRunAsk { };
        for r in rows.rows {
            push(out.request_ids, r.id) or discard;
        }
        return out;
    }

    /// One request queued for annotation now, or why not.
    @unbounded
    fn run_one(
        id: String,
        annotator: String,
        version: Int
    ) -> AnnotationRunOutcome fallible(st::StoreError) {
        let u = self.store.usage(id) or raise;
        if !u.present {
            return AnnotationRunOutcome {
                request_id: id,
                reason: "unknown",
                message: "no request " + id,
            };
        }
        let project = std::json::find_string_field(u.record, "project");
        let key = std::json::find_string_field(u.record, "key");
        let p = self.store.project(project) or raise;
        let k = self.store.key(key) or raise;
        let annotating = (annotates(self.store, p) or false) || (k.annotate && !p.internal);
        if !annotating || k.internal {
            return AnnotationRunOutcome {
                request_id: id,
                reason: "not_annotating",
                message: "project " + project + " and its key do not annotate",
            };
        }
        let held = self.store.annotation_input(id) or raise;
        let whole = if held.present { st::PeekRow { } } else { self.store.peek(id) or raise };
        if !held.present && !whole.present {
            return AnnotationRunOutcome {
                request_id: id,
                reason: "no_text",
                message: "request " + id
                    + " has no recorded text to read: a request is recorded when its project or key peeks",
            };
        }
        let dc = std::json::find_string_field(u.record, "data_class");
        let stages = self.queue_annotation(
            AnnotationJob {
                request_id: id,
                project: project,
                key: key,
                conversation: std::json::find_string_field(u.record, "conversation"),
                created_at: u.created_at,
                model: if held.present { held.model } else { whole.model },
                data_class: if held.present {
                    held.data_class
                } else {
                    if len(dc) > 0 { dc } else { "internal" }
                },
                input: if held.present { held.input } else { whole.input },
                output: if held.present { held.output } else { whole.output },
                present: true,
            },
            annotator,
            version,
            if len(annotator) > 0 { "run of " + annotator } else { "run" },
        );
        if len(stages) == 0 {
            return AnnotationRunOutcome {
                request_id: id,
                reason: "no_annotator",
                message: "no annotator is in force for request " + id,
            };
        }
        return AnnotationRunOutcome { request_id: id, queued: true };
    }

    /// The node an enrollment token names.
    fn node_ctx(req: std::http::Request) -> std::api::Context fallible(ApiError) {
        return self.node_bearer.context(std::http::header(req, "Authorization")) or raise;
    }
}

/// What a handler returns when it has answered on its connection itself.
fn taken_over() -> std::http::Response {
    return std::http::Response { status: 200, body: "", takeover_raw: true };
}

/// A JSON answer.
fn json_answer(status: Int, body: String) -> std::http::Response {
    return std::http::Response { status: status, content_type: "application/json", body: body };
}

/// A caller-plane answer: JSON with the request's id. The rate-limit and
/// budget headers come with limits and budgets.
fn caller_json(body: String) -> std::http::Response {
    let id = random_hex(12) or "unnumbered";
    return std::http::Response {
        status: 200,
        content_type: "application/json",
        headers: "X-Request-Id: req_" + id,
        body: body,
    };
}

/// A served inference request, under its request id, with its rate-limit
/// headers.
fn served_answer(s: Served, body: String) -> std::http::Response {
    return std::http::Response {
        status: 200,
        content_type: "application/json",
        headers: "X-Request-Id: " + s.request_id
            + (if len(s.headers) > 0 { "\r\n" + s.headers } else { "" }),
        body: body,
    };
}

/// A row's failure, in the contract's envelope.
fn failed(e: ApiError) -> std::http::Response {
    if e.status == 401 {
        return std::http::Response {
            status: 401,
            content_type: "application/json",
            headers: "WWW-Authenticate: Bearer",
            body: error_json(e),
        };
    }
    if e.retry_after > 0 {
        return std::http::Response {
            status: e.status,
            content_type: "application/json",
            headers: "Retry-After: " + to_string(e.retry_after),
            body: error_json(e),
        };
    }
    return json_answer(e.status, error_json(e));
}

/// A request body comes with its `Content-Length`. hale's Server does not
/// read a chunked one (`Transfer-Encoding: chunked`; FRICTION.md), so the
/// handler would see it empty: it is refused for what it is, not as a body
/// that is not JSON.
fn whole_body(req: std::http::Request) -> Bool fallible(ApiError) {
    if std::str::contains(std::str::lower(std::http::header(req, "Transfer-Encoding")), "chunked") {
        fail invalid("a chunked request body is not accepted: send it with Content-Length", "");
    }
    return true;
}
