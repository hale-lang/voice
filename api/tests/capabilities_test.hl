// GET /v1/capabilities: what the presented key may do.
import ".." as api;
import "../../store" as st;

fn caps(e: api::DataPlane, key: String) -> std::http::Response {
    return e.handle(
        std::http::Request {
            method: "GET",
            path: "/v1/capabilities",
            headers: "Authorization: Bearer " + key,
        },
    );
}

fn raw(r: std::http::Response, name: String) -> String {
    return std::str::trim(std::json::find_field_raw(r.body, name));
}

/// A request limit of `n` per minute at `scope`.
fn per_minute(scope: st::LimitScope, n: Int) -> st::Limit {
    return st::Limit { scope: scope, window_seconds: 60, has_requests: true, requests: n };
}

fn main() {
    let e = api::DataPlane { };
    let catalog = api::Catalog { store: e.store };
    let accounts = api::Accounts { store: e.store };
    let projects = api::Projects { store: e.store };
    let keys = api::Keys { store: e.store };
    catalog.create(api::CatalogModelCreate { id: "echo-1" }) or discard;
    catalog.create(api::CatalogModelCreate { id: "other-1" }) or discard;
    let mut static_account = api::AccountCreate { id: "static", name: "Static" };
    let mut account_limit = per_minute(st::LimitScope::account, 5);
    push(static_account.limits, account_limit) or discard;
    accounts.create(static_account) or discard;
    let mut paid = api::AccountCreate { id: "paid", name: "Paid" };
    account_limit = per_minute(st::LimitScope::account, 7);
    push(paid.limits, account_limit) or discard;
    accounts.create(paid) or discard;
    let mut work = api::ProjectCreate { id: "work", name: "Work" };
    push(work.data_classes, "public") or discard;
    push(work.data_classes, "internal") or discard;
    push(work.limits, per_minute(st::LimitScope::project, 600)) or discard;
    projects.create(work) or discard;
    let made_open = keys.create(api::KeyCreate { project: "work", name: "ci" }) or {
        api::Key { status: api::KeyStatus::revoked }
    };
    let open = made_open.secret;
    let mut narrow_key = api::KeyCreate {
        project: "work",
        name: "narrow",
        has_models: true,
        has_accounts: true,
    };
    push(narrow_key.models, "echo-1") or discard;
    push(narrow_key.accounts, "static") or discard;
    push(narrow_key.limits, per_minute(st::LimitScope::key, 9)) or discard;
    let made_narrow = keys.create(narrow_key) or { api::Key { status: api::KeyStatus::revoked } };
    let narrow = made_narrow.secret;
    std::test::assert(made_open.has_secret && made_narrow.has_secret, "two keys");

    std::test::assert_eq_int(
        e.handle(std::http::Request { method: "GET", path: "/v1/capabilities" }).status,
        401,
        "a key first",
    );

    let c = caps(e, open);
    std::test::assert_eq_int(c.status, 200, "capabilities: " + c.body);
    std::test::assert(std::str::starts_with(c.headers, "X-Request-Id: req_"), "a request id");
    std::test::assert_eq_str(
        std::json::find_string_field(std::json::find_field_raw(c.body, "project"), "id"),
        "work",
        "its project",
    );
    std::test::assert_eq_str(
        std::json::find_string_field(std::json::find_field_raw(c.body, "key"), "name"),
        "ci",
        "its key",
    );
    std::test::assert_eq_str(
        raw(c, "data_classes"),
        "[\"public\", \"internal\"]",
        "the project's data classes",
    );
    std::test::assert_eq_str(raw(c, "models"), "[\"echo-1\", \"other-1\"]", "every model");
    std::test::assert_eq_str(raw(c, "accounts"), "null", "any account");
    std::test::assert_eq_str(raw(c, "budget"), "null", "no budget");
    let limits = raw(c, "limits");
    std::test::assert(
        std::str::contains(limits, "600")
            && std::str::contains(limits, "\"static\"")
            && std::str::contains(limits, "\"paid\""),
        "the project's limits and every account's",
    );

    let n = caps(e, narrow);
    std::test::assert_eq_str(raw(n, "models"), "[\"echo-1\"]", "the key's models");
    std::test::assert_eq_str(raw(n, "accounts"), "[\"static\"]", "the key's accounts");
    let nl = raw(n, "limits");
    std::test::assert(
        std::str::contains(nl, "\"key\"")
            && std::str::contains(nl, "\"static\"")
            && !std::str::contains(nl, "\"paid\""),
        "its own limit and its accounts' only",
    );

    accounts.archive(api::AccountRef { account: "paid" }) or discard;
    let after_archive = raw(caps(e, open), "limits");
    std::test::assert(
        std::str::contains(after_archive, "\"static\"")
            && !std::str::contains(after_archive, "\"paid\""),
        "an archived account's limits no longer apply",
    );

    projects.set_budget(
        api::BudgetRequest {
            project: "work",
            allowance_micros: 1000,
            period: st::Period::day,
        },
    ) or discard;
    std::test::assert_eq_int(
        std::json::find_int_field(raw(caps(e, open), "budget"), "remaining_micros"),
        1000,
        "the budget, with what remains",
    );
}
