// CLI recipes (spec/openapi.yaml, tag `cli-recipes`): the agentic coding CLIs
// coding attempts run (attempts.hl), each a recipe lib/harness checks, kept
// in the store (store/cli_recipes.hl). Voice's own are its `harnesses`
// directory, read at start (main.hl, `--harnesses`) and written to the store
// as `shipped` once this api reaches it: their bodies as the files say,
// read-only, disabled or duplicated into one of the operator's. The
// operator's are made, edited, enabled or disabled, and removed while no
// seat names them, on the admin plane, under the operator token
// (`/admin/v1/cli-recipes`, served by the data plane: data_plane.hl). Every
// recipe is held to the same rules whichever way it came, and a refusal
// names the field at fault (`error.param`), so the admin UI shows it there.
//
// A harness seat names a recipe by its id (its config's `harness`); a
// disabled recipe's seats take no new attempt, and a recipe a seat names is
// never removed (Seats, nodes.hl, says either among a seat's problems).

/// The largest recipe body, in bytes: its files (at most eight of 64 KiB)
/// and the rest.
const CLI_RECIPE_MAX_BYTES: Int = 655360;

/// What a seat config asks of its recipe's backends (`config.backend`):
/// `container` unless it opts in to `host`; "" when it names neither.
fn seat_backend(config: String) -> String {
    let f = std::json::string_field(config, "backend");
    if f.kind == "missing" || f.kind == "null" { return "container"; }
    return if f.kind == "string" && (f.text == "container" || f.text == "host") {
        f.text
    } else {
        ""
    };
}

/// The seats (`node/seat`) whose config names recipe `id`, as JSON strings.
fn seats_naming(seats: st::SeatRows, id: String) -> String {
    let out = st::JsonList { };
    for s in seats.rows {
        if st::names_cli_recipe(s.config, id) { out.add(jq(s.node + "/" + s.id)); }
    }
    return "[" + out.text() + "]";
}

/// `CliRecipe`: a recipe as voice holds it, with the seats that name it.
fn cli_recipe_json(r: st::CliRecipeRow, seats: st::SeatRows) -> String {
    return "{\"object\": \"cli_recipe\", \"id\": " + jq(r.id) + ", \"origin\": " + jq(r.origin)
        + ", \"enabled\": " + jbool(r.enabled) + ", \"created_at\": " + jtime(r.created_at)
        + ", \"updated_at\": " + jtime(r.updated_at) + ", \"seats\": " + seats_naming(seats, r.id)
        + ", \"recipe\": " + r.body + "}";
}

/// A recipe the rules refuse, as the caller's error, naming its field.
fn recipe_refused(p: harness::RecipeProblem) -> ApiError {
    let field = if len(p.field) > 0 { "recipe." + p.field } else { "recipe" };
    return invalid("the recipe is refused: " + p.why, field);
}

/// Voice's own recipes (`shipped`, a JSON list of recipes lib/harness
/// passed), written to `store`: each added, or its body replaced, never an
/// operator's of the same id. "" when they are all there, else why not.
@unbounded
fn put_shipped_cli_recipes(store: st::Store, shipped: String) -> String {
    let now = now_seconds();
    let mut it = std::json::array_first(shipped);
    while !it.done {
        let body = std::str::trim(it.element);
        let id = harness::text_of(body, "id");
        let mine = store.put_shipped_cli_recipe(
            st::CliRecipeRow { id: id, body: body, created_at: now, updated_at: now },
        ) or {
            log_error(
                "voice's own CLI recipes could not be written to the store",
                std::log::kv("error", err.message),
            );
            return err.message;
        };
        if !mine {
            log_error(
                "a shipped CLI recipe's id is one of the operator's, which is kept",
                std::log::kv("recipe", id),
            );
        }
        it = std::json::array_next(it);
    }
    return "";
}

locus CliRecipes {
    params {
        store: st::Store = st::MemoryStore { };
        // voice's own recipes, as its files read at start, a JSON list
        // (attempts.hl, `shipped_harnesses`)
        shipped: String = "[]";
        // whether voice's own are in the store yet: written as the api
        // starts (main.hl), or at the first use after when it could not be
        synced: Bool = false;
    }

    /// Voice's own recipes, written to the store as its files say, once:
    /// true when they are there. A store that could not be reached when
    /// the api started (main.hl) is tried again at the next use.
    fn sync() -> Bool {
        if self.synced { return true; }
        let problem = put_shipped_cli_recipes(self.store, self.shipped);
        if len(problem) > 0 { return false; }
        self.synced = true;
        return true;
    }

    /// The recipe `id`, voice's own written first; `present` false when
    /// there is none.
    fn row(id: String) -> st::CliRecipeRow fallible(st::StoreError) {
        self.sync();
        return self.store.cli_recipe(id) or raise;
    }

    /// Every recipe, voice's own written first.
    fn rows() -> st::CliRecipeRows fallible(st::StoreError) {
        self.sync();
        return self.store.cli_recipes() or raise;
    }

    /// `listCliRecipes`: every recipe, in the order of their ids.
    @unbounded
    fn list() -> std::http::Response fallible(ApiError) {
        let rows = self.rows() or fail store_failed(err);
        let seats = self.store.seats() or fail store_failed(err);
        let out = st::JsonList { };
        for r in rows.rows {
            out.add(cli_recipe_json(r, seats));
        }
        return json_answer(200, "{\"object\": \"list\", \"data\": [" + out.text() + "]}");
    }

    /// `getCliRecipe`.
    fn get(id: String) -> std::http::Response fallible(ApiError) {
        let r = self.known(id) or raise;
        let seats = self.store.seats() or fail store_failed(err);
        return json_answer(200, cli_recipe_json(r, seats));
    }

    /// `createCliRecipe`: one of the operator's, checked; 201.
    @unbounded
    fn create(body: String) -> std::http::Response fallible(ApiError) {
        let recipe = self.checked(body) or raise;
        let id = harness::text_of(recipe, "id");
        return self.add(id, recipe) or raise;
    }

    /// `duplicateCliRecipe`: a copy of recipe `id` (voice's own or the
    /// operator's), as one of the operator's under the id the body gives
    /// (and its `name`, when it gives one); 201.
    @unbounded
    fn duplicate(id: String, body: String) -> std::http::Response fallible(ApiError) {
        object_body(body) or raise;
        let from = self.known(id) or raise;
        let fresh = optional_string(body, "id") or raise;
        if !harness::slug(fresh) {
            fail invalid(
                "`id` is the copy's: lowercase letters, digits and dashes, starting with a letter or digit, at most 63",
                "id",
            );
        }
        let name = optional_string(body, "name") or raise;
        let mut copy = with_member(from.body, "id", jq(fresh));
        if len(name) > 0 { copy = with_member(copy, "name", jq(name)); }
        let p = harness::recipe_problem(copy);
        if len(p.why) > 0 { fail recipe_refused(p); }
        return self.add(fresh, copy) or raise;
    }

    /// `updateCliRecipe`: the operator's recipe `id`, replaced whole by the
    /// body, checked. Voice's own are read-only.
    @unbounded
    fn update(id: String, body: String) -> std::http::Response fallible(ApiError) {
        let before = self.known(id) or raise;
        if before.origin != "operator" {
            fail conflict(
                "CLI recipe " + id
                    + " is voice's own, read-only: duplicate it to make one of your own",
            );
        }
        let recipe = self.checked(body) or raise;
        if harness::text_of(recipe, "id") != id {
            fail invalid("a recipe keeps the id it was made with, " + id, "recipe.id");
        }
        let seats = self.store.seats() or fail store_failed(err);
        let mut after = before;
        after.body = recipe;
        after.updated_at = now_seconds();
        let done = self.store.update_cli_recipe(
            after,
            change(
                "update",
                "cli-recipes/" + id,
                cli_recipe_json(before, seats),
                cli_recipe_json(after, seats),
            ),
        ) or fail store_failed(err);
        if !done { fail not_found("no CLI recipe " + id + " of the operator's"); }
        return json_answer(200, cli_recipe_json(after, seats));
    }

    /// `setCliRecipeEnabled`: recipe `id` (voice's own or the operator's)
    /// enabled or disabled, as the body's `enabled` says. A disabled
    /// recipe's seats take no new attempt; one already running runs on.
    fn set_enabled(id: String, body: String) -> std::http::Response fallible(ApiError) {
        object_body(body) or raise;
        if kind_of(body, "enabled") != "bool" {
            fail invalid("`enabled` is true or false", "enabled");
        }
        let enabled = std::json::find_bool_field(body, "enabled");
        let before = self.known(id) or raise;
        let seats = self.store.seats() or fail store_failed(err);
        let mut after = before;
        after.enabled = enabled;
        after.updated_at = now_seconds();
        self.store.enable_cli_recipe(
            id,
            enabled,
            after.updated_at,
            change(
                "update",
                "cli-recipes/" + id,
                cli_recipe_json(before, seats),
                cli_recipe_json(after, seats),
            ),
        ) or fail store_failed(err);
        return json_answer(200, cli_recipe_json(after, seats));
    }

    /// `deleteCliRecipe`: the operator's recipe `id`, removed, when no seat
    /// names it.
    fn remove(id: String) -> std::http::Response fallible(ApiError) {
        let before = self.known(id) or raise;
        if before.origin != "operator" {
            fail conflict("CLI recipe " + id + " is voice's own: disable it instead");
        }
        let seats = self.store.seats() or fail store_failed(err);
        let naming = seats_naming(seats, id);
        if naming != "[]" {
            fail conflict(
                "CLI recipe " + id + " is named by seats " + naming
                    + ": disable it, or point them at another first",
            );
        }
        let gone = self.store.delete_cli_recipe(
            id,
            change("delete", "cli-recipes/" + id, cli_recipe_json(before, seats), ""),
        ) or fail store_failed(err);
        if !gone {
            fail conflict("CLI recipe " + id + " is named by a seat now: disable it instead");
        }
        return json_answer(200, cli_recipe_json(before, seats));
    }

    /// The recipe `id`, or a 404.
    fn known(id: String) -> st::CliRecipeRow fallible(ApiError) {
        let r = self.row(id) or fail store_failed(err);
        if !r.present { fail not_found("no CLI recipe " + id); }
        return r;
    }

    /// A request's recipe, checked: the body, trimmed.
    @unbounded
    fn checked(body: String) -> String fallible(ApiError) {
        let recipe = std::str::trim(body);
        if len(recipe) > CLI_RECIPE_MAX_BYTES {
            fail invalid("a recipe is at most 640 KiB", "recipe");
        }
        object_body(recipe) or raise;
        let p = harness::recipe_problem(recipe);
        if len(p.why) > 0 { fail recipe_refused(p); }
        return recipe;
    }

    /// Recipe `recipe` added as the operator's `id`; 201, or a 409 when the
    /// id is taken.
    fn add(id: String, recipe: String) -> std::http::Response fallible(ApiError) {
        let now = now_seconds();
        let row = st::CliRecipeRow {
            id: id,
            body: recipe,
            origin: "operator",
            enabled: true,
            created_at: now,
            updated_at: now,
            present: true,
        };
        let seats = self.store.seats() or fail store_failed(err);
        let added = self.store.insert_cli_recipe(
            row,
            change("create", "cli-recipes/" + id, "", cli_recipe_json(row, seats)),
        ) or fail store_failed(err);
        if !added {
            let held = self.store.cli_recipe(id) or fail store_failed(err);
            fail conflict(
                "voice has a CLI recipe " + id
                    + (if held.origin == "shipped" { ", its own" } else { "" })
                    + ": give this one another id",
            );
        }
        return json_answer(201, cli_recipe_json(row, seats));
    }
}
