// The usage ledger: one row per inference request, written where the
// request ends (inference.hl: `settled` and `unfinished`), read back by
// the admin plane (`GET /admin/v1/usage`, `/usage/{request_id}`,
// `/usage/summary`) and followed by the event stream (admin_events.hl).
// A row is the `UsageRecord` of ../spec/openapi.yaml, kept whole in the
// store (`UsageRow.record`) beside the columns a read filters and sums by.

/// The row for a request of `r` that ended as `status`: `by` is what
/// served it, `input` and `output` the tokens its seat reported. A
/// request the caller named `metadata` on keeps it, untouched.
fn usage_row(
    r: InferenceRequest,
    request_id: String,
    project: String,
    key: String,
    by: ServedBy,
    status: String,
    input: Int,
    output: Int,
    price_micros: Int,
    currency: String,
    wall_ms: Int,
    attempts: bounded[Attempt; 8]
) -> st::UsageRow {
    let at = now_seconds();
    let meta = std::str::trim(std::json::find_field_raw(r.body, "metadata"));
    let metadata = if std::json::valid_object(meta) { meta } else { "{}" };
    let served = served_by_json(by);
    let record = "{\"id\": " + jq(request_id) + ", \"created_at\": " + jtime(at)
        + ", \"project\": " + jq(project) + ", \"key\": " + jq(key)
        + ", \"requested_model\": " + jq(r.model) + ", \"requested_account\": "
        + jstring_or_null(len(r.account) > 0, r.account) + ", \"endpoint\": "
        + jq(endpoint_name(r)) + ", \"status\": " + jq(status) + ", \"served\": " + served
        + ", \"data_class\": " + jq(r.data_class) + ", \"input_tokens\": " + to_string(input)
        + ", \"cached_input_tokens\": 0, \"cache_write_input_tokens\": 0, \"output_tokens\": "
        + to_string(output) + ", \"reasoning_tokens\": 0, \"price_micros\": "
        + to_string(price_micros) + ", \"currency\": " + jq(currency)
        + ", \"timing\": {\"wall_ms\": " + to_string(wall_ms)
        + ", \"queue_ms\": 0, \"load_ms\": 0}, \"attempts\": " + attempts_json(attempts)
        + ", \"metadata\": " + metadata + "}";
    return st::UsageRow {
        id: request_id,
        created_at: at,
        project: project,
        key: key,
        account: by.account,
        requested_model: r.model,
        served_model: by.model,
        node: by.node,
        seat: by.seat,
        status: status,
        input_tokens: input,
        output_tokens: output,
        price_micros: price_micros,
        currency: currency,
        served: served,
        record: record
    };
}

/// A request a seat served, as its row.
fn served_usage(r: InferenceRequest, s: Served) -> st::UsageRow {
    let v = s.voice;
    return usage_row(
        r,
        s.request_id,
        v.project,
        v.key,
        v.served,
        if s.status == "incomplete" { "incomplete" } else { "served" },
        s.input_tokens,
        s.output_tokens,
        v.price_micros,
        v.currency,
        v.wall_ms,
        v.attempts
    );
}

/// A request seat `c` began and did not finish, as its row: nothing is
/// charged, and the seat reported no tokens.
fn unfinished_row(
    r: InferenceRequest,
    request_id: String,
    k: st::KeyRow,
    m: st::ModelRow,
    c: Candidate,
    status: String,
    wall_ms: Int,
    attempts: bounded[Attempt; 8]
) -> st::UsageRow {
    return usage_row(
        r,
        request_id,
        k.project,
        k.id,
        ServedBy {
            model: if len(c.engine_name) > 0 { c.engine_name } else { m.id },
            node: c.seat.node,
            seat: c.seat.ref,
            account: c.seat.account,
            engine: c.seat.engine,
        },
        status,
        0,
        0,
        0,
        if m.priced { m.price.currency } else { "USD" },
        wall_ms,
        attempts
    );
}

/// The ledger, read.
locus Usage {
    params { store: st::Store; }

    /// `listUsage`: newest first, as the JSON the contract describes.
    fn list_json(q: st::UsageQuery) -> String fallible(ApiError) {
        let rows = self.store.usage_rows(q) or fail store_failed(err);
        let records = st::JsonList { };
        let mut last = 0;
        for r in rows.rows {
            records.add(r.record);
            last = r.seq;
        }
        return "{\"data\": [" + records.text() + "], \"next_cursor\": "
            + jstring_or_null(rows.more, to_string(last)) + "}";
    }

    /// `getUsage`.
    fn get_json(id: String) -> String fallible(ApiError) {
        let r = self.store.usage(id) or fail store_failed(err);
        if !r.present { fail not_found("no usage record " + id); }
        return r.record;
    }

    /// `summarizeUsage`: totals over the matching rows, one per group.
    fn summary_json(by: st::Names, q: st::UsageQuery) -> String fallible(ApiError) {
        let groups = self.store.usage_summary(
            st::UsageSummaryQuery { by: by, q: q },
        ) or fail store_failed(err);
        let data = st::JsonList { };
        for g in groups.rows {
            data.add(
                "{\"group\": " + g.group + ", \"requests\": " + to_string(g.requests)
                    + ", \"input_tokens\": " + to_string(g.input_tokens)
                    + ", \"output_tokens\": " + to_string(g.output_tokens)
                    + ", \"price_micros\": " + to_string(g.price_micros) + ", \"currency\": "
                    + jq(g.currency) + "}",
            );
        }
        let mut out = "{\"group_by\": " + st::jnames(by.items);
        if q.has_from { out = out + ", \"from\": " + jtime(q.from); }
        if q.has_to { out = out + ", \"to\": " + jtime(q.to); }
        return out + ", \"data\": [" + data.text() + "]}";
    }
}

// ---- the wire ----------------------------------------------------------

/// The filters `GET /admin/v1/usage` and `/usage/summary` share. `path` is
/// the request's, query and all: `metadata` repeats, which a route's
/// parameters do not carry.
fn read_usage_query(
    p: std::http::RouteParams,
    path: String,
    paged: Bool
) -> st::UsageQuery fallible(ApiError) {
    let mut q = st::UsageQuery {
        project: std::http::query_param(p, "project"),
        key: std::http::query_param(p, "key"),
        model: std::http::query_param(p, "model"),
        account: std::http::query_param(p, "account"),
    };
    let from = std::http::query_param(p, "from");
    if len(from) > 0 {
        q.has_from = true;
        q.from = rfc3339(from) or fail invalid(
            "`from` is an RFC 3339 time, such as 2026-10-01T00:00:00Z",
            "from"
        );
    }
    let to = std::http::query_param(p, "to");
    if len(to) > 0 {
        q.has_to = true;
        q.to = rfc3339(to) or fail invalid(
            "`to` is an RFC 3339 time, such as 2026-10-01T00:00:00Z",
            "to"
        );
    }
    let pairs = query_all(path, "metadata").items;
    for pair in pairs {
        if std::str::index_of(pair, "=") < 1 {
            fail invalid("`metadata` is written name=value", "metadata");
        }
        push(q.metadata.items, pair) or fail invalid(
            "`metadata` names at most 32 pairs",
            "metadata"
        );
    }
    if paged {
        let limit = std::http::query_param(p, "limit");
        if len(limit) > 0 {
            let n = std::str::parse_int(limit) or 0;
            if !is_integer(limit) || n < 1 || n > 1000 {
                fail invalid("`limit` is 1 to 1000", "limit");
            }
            q.limit = n;
        }
        let cursor = std::http::query_param(p, "cursor");
        if len(cursor) > 0 {
            let n = std::str::parse_int(cursor) or 0;
            if !is_integer(cursor) || n < 1 {
                fail invalid(
                    "`cursor` names no usage record; pass a page's `next_cursor`",
                    "cursor"
                );
            }
            q.cursor = n;
        }
    }
    return q;
}

/// `group_by`: the fields a summary groups by, comma separated.
fn read_group_by(p: std::http::RouteParams) -> st::Names fallible(ApiError) {
    let raw = std::http::query_param(p, "group_by");
    if len(raw) == 0 { fail invalid("`group_by` is required", "group_by"); }
    let mut out = st::Names { };
    let mut rest = st::pct_decode(raw);
    while len(rest) > 0 {
        let comma = std::str::index_of(rest, ",");
        let f = if comma < 0 { rest } else { rest[0..comma] };
        rest = if comma < 0 { "" } else { rest[(comma + 1)..len(rest)] };
        if !st::valid_group(f) {
            fail invalid(
                "`group_by` is any of project, key, model, account, seat, node, day, hour",
                "group_by"
            );
        }
        push(out.items, f) or fail invalid("`group_by` names at most 32 fields", "group_by");
    }
    return out;
}

/// Every value `name` has in `path`'s query, in order, decoded: a repeated
/// parameter, which a route's parameters do not carry.
fn query_all(path: String, name: String) -> st::Names {
    let mut out = st::Names { };
    let qm = std::str::index_of(path, "?");
    let mut rest = if qm < 0 { "" } else { path[(qm + 1)..len(path)] };
    while len(rest) > 0 {
        let amp = std::str::index_of(rest, "&");
        let part = if amp < 0 { rest } else { rest[0..amp] };
        rest = if amp < 0 { "" } else { rest[(amp + 1)..len(rest)] };
        if std::str::starts_with(part, name + "=") {
            push(out.items, st::pct_decode(part[(len(name) + 1)..len(part)])) or discard;
        }
    }
    return out;
}
