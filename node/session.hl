// The node's session on NATS (../spec/protocol.yaml), on a thread of its
// own.
//
// It takes what registration gave the node from the plane (plane.hl):
// where NATS is, its subject, its assignment. Then it holds NATS on its
// subject: an `assign` replaces the assignment, a `serve` is answered at
// once (accepted or refused) and then served on its seat, the events and
// the result on the reply subject the request named, a `cancel` stops
// the request it names, and a `consume` is the brain's plan of which
// queues each seat pulls. Every time it is on NATS again it asks the plane
// to read the assignment, since an `assign` sent while it was not is lost.
//
// On the same connection each seat with a free slot pulls tickets from its
// queues on the work stream (pull.hl), and a ticket it pulled is handed to
// a free slot as a `serve` is, which claims its request and serves it once
// granted (serve.hl). One count, `busy`, covers both: a slot serving a
// `serve` is not pulled for, and a slot claiming a ticket refuses a
// `serve` as a busy one does.
//
// It makes no call to the api: those wait on the api, which serves its
// callers one at a time, and a session waiting there could not answer a
// `serve`. It hands each `serve` it accepts to a slot of its own
// (serve.hl), so the node serves several at once: each seat up to its
// concurrency (a placement's seat's, what its runtime is started with). A
// `serve` past it, or past the node's slots, is refused at once, so the
// coordinator offers the request elsewhere. The node has no cap of its own.
//
// What the admin API shows of it is in `<data>/session.json`.

import "../lib/pond/realtime/nats" as nats;

locus Session {
    params {
        id: String = "";
        data: String = "node-data";
        // the api the plane registers with, as the status shows it
        api: String = "";
        capabilities: String = "";
        joined: Bool = false;
        // the plane's side: connecting | registered | refused
        plane_state: String = "connecting";
        // NATS: connecting | connected
        nats_state: String = "connecting";
        last_error: String = "";
        connected_at: String = "";
        nats_url: String = "";
        subject: String = "";
        // the assignment as received, and as applied
        assignment: String = "";
        seats: NodeSeats = NodeSeats { };
        local: String = "";
        // each managed seat's fetch as the fetcher last told it (fetch.hl)
        fetches: FetchStates = FetchStates { };
        subscribed: Bool = false;
        // the requests being served, one a line: the slot, its seat and its
        // request id, tab-separated (serve.hl)
        busy: String = "";
        client: nats::NatsClient = nats::NatsClient { name: "voice-node" };
        // the root of the subjects it is under (`voice`, or a habitat's
        // broker's prefix), and its seats' pulls (pull.hl)
        root: String = "";
        pulls: Pulls = Pulls { };
        // the seats' readings, scraped with the runtime's (readings.hl)
        readings: std::metrics::Registry = std::metrics::Registry { namespace: "voice_node" };
        // the seats last read out, so one withdrawn reads as down
        read: SeatIds = SeatIds { };
    }

    bus {
        subscribe PlaneJoined as on_joined;
        subscribe AssignmentRead as on_assignment;
        subscribe LocalApplied as on_local;
        subscribe PlaneReport as on_plane;
        subscribe FetchUpdated as on_fetch;
        subscribe ServeDone as on_done;
        publish SeatsApplied;
        publish FetchWanted;
        publish ManagedAssigned;
        publish NatsConnected;
        publish LoadChanged;
        publish ServeJob;
        publish SessionStopped;
        publish ServeCancel;
        publish LinkChecksAssigned;
    }

    run() {
        // a stop (SIGTERM, `systemctl stop`) drains the node: each loop
        // returns, then its locus's `drain()` and `dissolve()` run
        while !self.draining {
            self.step();
        }
        // no ticket is pulled any more: the pulls' inboxes go, so the
        // server drops their open pulls
        if self.client.connected {
            self.pulls.close_all(self.client);
            self.client.flush() or discard;
        }
        // no hand-off follows: the slots may return once they hold nothing
        SessionStopped <- Stopping { at: std::time::monotonic_ns() };
    }

    /// One turn of the loop. A method, so each turn's memory is reclaimed;
    /// its sleep is where the plane's messages arrive.
    fn step() {
        if !self.joined {
            std::time::sleep(100ms);
            return;
        }
        if !self.client.connected || !self.subscribed { self.connect(); }
        if self.client.connected {
            // short, so a slot freed (on the bus) is told soon
            if self.client.read_msg(20ms) { self.on_message(); }
            if self.pulls.look(self.client, self.seats, self.busy, std::time::monotonic_ns()) {
                self.loaded();
            }
            std::time::sleep(1ms);
        } else {
            std::time::sleep(500ms);
        }
    }

    /// Registration's answer, from the plane: adopt its assignment.
    @unbounded
    fn on_joined(j: Joined) {
        // a new place, or a new account there (grafted: the nodes' user on
        // the habitat's broker, handed over at registration)
        if j.nats_url != self.nats_url
            || j.user != self.client.user
            || j.password != self.client.pass
        {
            self.nats_url = j.nats_url;
            self.client.close();
            self.client.url = j.nats_url;
            self.client.user = j.user;
            self.client.pass = j.password;
            self.subscribed = false;
        }
        if j.subject != self.subject { self.subscribed = false; }
        self.subject = j.subject;
        self.root = root_of(j.subject, self.id);
        self.client.inbox_prefix = inbox_of(self.root);
        self.pulls.place(self.client, self.id, self.root);
        self.local = j.local;
        self.joined = true;
        self.adopt(j.assignment);
    }

    /// An assignment the plane read: adopted when it is newer.
    fn on_assignment(a: AssignmentText) {
        if std::json::find_int_field(a.assignment, "version") > self.seats.version {
            self.adopt(a.assignment);
        }
    }

    /// New local controls: the assignment applied again within them.
    @unbounded
    fn on_local(l: LocalText) {
        self.local = l.local;
        self.seats = apply_assignment(self.assignment, self.capabilities, self.local);
        self.pulls.configure(self.client, self.seats, self.assignment, self.capabilities);
        // a managed seat the controls released is fetched now
        self.schedule();
        self.overlay();
        self.applied();
    }

    fn on_plane(p: PlaneState) {
        if len(p.state) > 0 { self.plane_state = p.state; }
        self.last_error = p.detail;
        self.report();
    }

    /// NATS, and the node's subject on it; once on, the plane reads the
    /// assignment.
    @unbounded
    fn connect() {
        if len(self.nats_url) == 0 { return; }
        if !self.client.connected {
            self.subscribed = false;
            // a new connection: the old one's pulls went with it
            self.pulls.reset();
            if !self.client.open() {
                self.nats_state = "connecting";
                self.last_error = "NATS unreachable at " + self.nats_url + ": "
                    + self.client.last_error;
                self.report();
                std::time::sleep(1s);
                return;
            }
        }
        let sid = self.client.sub_to(self.subject + ".>", "") or - 1;
        if sid < 0 {
            self.last_error = "could not subscribe to " + self.subject + ": "
                + self.client.last_error;
            self.report();
            return;
        }
        self.subscribed = true;
        self.nats_state = "connected";
        self.last_error = "";
        self.connected_at = std::time::iso8601(
            std::time::time_from_unix(std::time::unix(std::time::current())),
        );
        self.report();
        NatsConnected <- NatsState { connected: true };
    }

    /// Apply an assignment, and hand its seat states to the plane.
    @unbounded
    fn adopt(assignment: String) {
        self.assignment = assignment;
        // its link checks, to the checker (span.hl), which runs each once
        LinkChecksAssigned <- LinkCheckJobs {
            jobs: std::str::trim(std::json::find_field_raw(assignment, "link_checks")),
        };
        self.seats = apply_assignment(assignment, self.capabilities, self.local);
        self.pulls.configure(self.client, self.seats, assignment, self.capabilities);
        // the fetches kept are the assignment's seats' alone
        let mut kept = FetchStates { };
        for f in self.fetches.items {
            if self.assigned(f.seat) { push(kept.items, f) or discard; }
        }
        self.fetches = kept;
        self.schedule();
        self.overlay();
        self.applied();
    }

    /// Every managed seat that may run told to the fetcher, which fetches
    /// what it does not hold once, and to the runner, which stops the
    /// server of any other (a seat a local control holds waits).
    @unbounded
    fn schedule() {
        let mut managed = "";
        for s in self.seats.items {
            if s.managed {
                FetchWanted <- FetchJob { seat: s.id, config: s.config };
                managed = managed + s.id + "\n";
            }
        }
        ManagedAssigned <- ManagedSeats { ids: managed };
    }

    /// True when the assignment holds a managed seat `seat`.
    fn assigned(seat: String) -> Bool {
        for s in self.seats.items {
            if s.id == seat && engine_kind(self.capabilities, s.engine) == "managed" {
                return true;
            }
        }
        return false;
    }

    /// How far the fetcher says a managed seat is. Both records are
    /// stored whole, so what the message carried is copied as it is kept
    /// (FRICTION.md: a bounded field is never assigned whole).
    @bounded_by(self.fetches)
    fn on_fetch(f: FetchState) {
        // word of a seat the assignment no longer holds is dropped
        if !self.assigned(f.seat) { return; }
        let mut next = FetchStates { };
        let mut found = false;
        for held in self.fetches.items {
            if held.seat == f.seat {
                push(next.items, merged_fetch(held, f)) or discard;
                found = true;
            } else {
                push(next.items, held) or discard;
            }
        }
        if !found { push(next.items, f) or discard; }
        self.fetches = next;
        self.overlay();
        self.applied();
    }

    /// The fetcher's and the runner's word on each managed seat.
    fn overlay() {
        let mut i = 0;
        while i < count(self.seats.items) {
            let mut s = at(self.seats.items, i) or NodeSeat { };
            if s.managed {
                for f in self.fetches.items {
                    if f.seat == s.id {
                        s.status = f.status;
                        s.reason = f.reason;
                        s.has_progress = true;
                        if f.total > 0 {
                            s.done_bytes = f.done;
                            s.total_bytes = f.total;
                        }
                        s.endpoint = f.endpoint;
                        s.key = f.key;
                        s.context = f.context;
                    }
                }
                set(self.seats.items, i, s) or discard;
            }
            i = i + 1;
        }
    }

    fn applied() {
        SeatsApplied <- AppliedSeats {
            version: self.seats.version,
            states: states_json(self.seats, self.busy, self.pulls.seats),
        };
        self.report();
    }

    /// One message on the node's subject, or on a pull's inbox.
    fn on_message() {
        let puller = self.pulls.owner(self.client.last);
        if puller >= 0 {
            self.on_pulled(puller);
            return;
        }
        let subject = self.client.last.subject;
        let body = std::str::from_bytes(self.client.last.data);
        if subject == self.subject + ".consume" {
            self.on_plan(body);
        } else if subject == self.subject + ".assign" {
            let a = std::str::trim(std::json::find_field_raw(body, "assignment"));
            if std::json::find_int_field(a, "version") > self.seats.version { self.adopt(a); }
        } else if subject == self.subject + ".serve" {
            self.serve(body, self.client.last.reply);
        } else if subject == self.subject + ".cancel" {
            // to whichever slot serves it
            ServeCancel <- ServeStop {
                request_id: std::json::find_string_field(body, "request_id"),
            };
        }
    }

    /// Answer a `serve` at once: accepted, and handed to a free slot, or
    /// refused.
    @unbounded
    fn serve(msg: String, inbox: String) {
        let id = std::json::find_string_field(msg, "request_id");
        let reply_to = std::json::find_string_field(msg, "reply_to");
        let seat = seat_of(self.seats, std::json::find_string_field(msg, "seat"));
        let slots = SLOTS;
        let mut refusal = "";
        // a seat or node at its most at once refuses for capacity: a slot
        // frees when a request it serves ends, so the coordinator waits for
        // one rather than counting the seat as failed (protocol.yaml)
        let mut capacity = false;
        if len(seat.id) == 0 {
            refusal = "no seat " + std::json::find_string_field(msg, "seat")
                + " is assigned to this node";
        } else if seat.status != "up" {
            refusal = "seat " + seat.id + " is " + seat.status
                + (if len(seat.reason) > 0 { ": " + seat.reason } else { "" });
        } else if request_has_tools(std::str::trim(std::json::find_field_raw(msg, "body")))
            && !work::carries_tools(engine_kind(self.capabilities, seat.engine), seat.config)
        {
            refusal = "seat " + seat.id + " does not carry tools: its engine answers text only";
        } else if len(at_capacity(self.busy, seat, slots)) > 0 {
            refusal = at_capacity(self.busy, seat, slots);
            capacity = true;
        }
        let slot = if len(refusal) == 0 { free_slot(self.busy, slots) } else { -1 };
        if len(refusal) == 0 && slot < 0 {
            refusal = "the node has no free slot";
            capacity = true;
        }
        let ack = "{\"request_id\": " + q(id) + ", \"outcome\": "
            + (
                if len(refusal) > 0 {
                    "\"refused\", \"reason\": " + q(refusal) + ", \"refusal\": "
                        + (if capacity { "\"capacity\"" } else { "\"unavailable\"" })
                } else {
                    "\"accepted\", \"reason\": null, \"refusal\": null"
                }
            )
            + "}";
        self.client.pub_msg(inbox, "", std::bytes::from_string(ack)) or discard;
        if len(refusal) > 0 { return; }
        self.busy = self.busy + to_string(slot) + "\t" + seat.id + "\t" + id + "\n";
        ServeJob <- ServeWork {
            slot: slot,
            request_id: id,
            reply_to: reply_to,
            msg: msg,
            seat: seat.id,
            engine: seat.engine,
            kind: engine_kind(self.capabilities, seat.engine),
            config: seat.config,
            endpoint: seat.endpoint,
            key: seat.key,
            nats_url: self.client.url,
            nats_user: self.client.user,
            nats_pass: self.client.pass,
            inbox: self.client.inbox_prefix,
        };
        // a slot fewer to pull for
        self.pulls.dirty = true;
        self.loaded();
    }

    /// The brain's plan of which queues each seat consumes: taken when it
    /// is newer than the one held, and the pulls follow it.
    fn on_plan(body: String) {
        let p = work::consume_plan_of(body) or {
            log_warn("a plan that is not one was read past", std::log::kv("why", err.message));
            return;
        };
        if !self.pulls.adopt_plan(p) { return; }
        self.pulls.configure(self.client, self.seats, self.assignment, self.capabilities);
        log_info("the brain's plan taken", std::log::kv("version", to_string(p.version)));
        self.loaded();
    }

    /// What puller `i` was sent: a ticket for its seat, handed to a free
    /// slot to claim, or put back or dropped (pull.hl `verdict`); or word
    /// of its pull, which `Pulls` keeps.
    @unbounded
    fn on_pulled(i: Int) {
        let now = std::time::monotonic_ns();
        let got = self.pulls.take(i, self.client.last, now);
        if got.kind != "msg" { return; }
        let seat = seat_of(self.seats, self.pulls.seat_at(i));
        let consumed = self.pulls.consumed(i);
        let ticket = std::str::from_bytes(got.msg.data);
        let claimant = self.id + "/" + seat.id;
        let kind = engine_kind(self.capabilities, seat.engine);
        let v = verdict(
            ticket,
            claimant,
            len(pull_off_reason(seat)) == 0 && consumed,
            free_for(self.busy, seat, SLOTS),
            work::carries_tools(kind, seat.config),
            self.pulls.ineligible_for(seat.id, now),
            std::time::current(),
        );
        if v == "extra" {
            nats::js_nak(self.client, got.msg, 0) or discard;
            return;
        }
        if v == "avoid" {
            nats::js_nak(self.client, got.msg, AVOID_DELAY_MS) or discard;
            return;
        }
        if v != "claim" {
            // late, or malformed: its request is over, or it is none
            nats::js_ack(self.client, got.msg) or discard;
            return;
        }
        let slot = free_slot(self.busy, SLOTS);
        if slot < 0 {
            nats::js_nak(self.client, got.msg, 0) or discard;
            return;
        }
        let id = std::json::find_string_field(ticket, "request_id");
        self.busy = self.busy + to_string(slot) + "\t" + seat.id + "\t" + id + "\n";
        ServeJob <- ServeWork {
            slot: slot,
            request_id: id,
            reply_to: std::json::find_string_field(ticket, "reply_to"),
            ticket: ticket,
            ack: got.msg.reply,
            claimant: claimant,
            seat: seat.id,
            engine: seat.engine,
            kind: kind,
            config: seat.config,
            endpoint: seat.endpoint,
            key: seat.key,
            nats_url: self.client.url,
            nats_user: self.client.user,
            nats_pass: self.client.pass,
            inbox: self.client.inbox_prefix,
        };
        self.pulls.dirty = true;
        self.loaded();
    }

    /// A slot is free again: its request is read out, and the load told;
    /// its seat sweeps its queues again.
    @unbounded
    fn on_done(d: ServeReport) {
        self.busy = busy_without(self.busy, d.slot);
        self.pulls.freed(d.seat);
        if d.claim == "ineligible" {
            self.pulls.declined(d.seat, d.message_id, std::time::monotonic_ns());
        }
        if d.ok {
            self.read_run(
                d.seat,
                d.engine,
                d.input_tokens,
                d.output_tokens,
                d.first_ms,
                d.elapsed_ms,
            );
        }
        self.loaded();
    }

    /// A request began or ended: the plane's next heartbeat, and the
    /// status, say so.
    fn loaded() {
        LoadChanged <- Load {
            in_flight: busy_count(self.busy),
            states: states_json(self.seats, self.busy, self.pulls.seats),
        };
        self.report();
    }

    /// What the admin API shows: the connection, the assignment applied
    /// and every seat with its state.
    fn report() {
        let state = if self.plane_state == "refused" {
            "refused"
        } else if self.plane_state == "registered" && self.nats_state == "connected" {
            "connected"
        } else {
            "connecting"
        };
        let coordinator = "{\"url\": " + q(self.api) + ", \"state\": " + q(state)
            + ", \"connected_at\": "
            + (if len(self.connected_at) > 0 { q(self.connected_at) } else { "null" })
            + ", \"last_error\": "
            + (if len(self.last_error) > 0 { q(self.last_error) } else { "null" }) + "}";
        let body = "{\"coordinator\": " + coordinator + ", \"assignment_version\": "
            + (if self.seats.version >= 0 { to_string(self.seats.version) } else { "null" })
            + ", \"in_flight\": " + to_string(busy_count(self.busy)) + ", \"seats\": "
            + status_seats(self.assignment, self.seats, self.busy, self.pulls.seats) + "}";
        std::io::fs::write_file(self.data + "/session.json", body) or discard;
        self.read_out();
    }

    /// A run a seat finished, in its readings: the tokens it read and
    /// wrote, and how long it generated, from its first output to its end
    /// (readings.hl), so a seat's throughput is the one over the other.
    fn read_run(
        seat: String,
        engine: String,
        input: Int,
        output: Int,
        first_ms: Int,
        elapsed_ms: Int
    ) {
        let l = std::metrics::labels_two("seat", seat, "engine", engine);
        seat_tokens(self.readings, l, "input", input);
        // output is counted with the time it took, so the two cover the same
        // runs and their ratio is the seat's throughput
        if output > 0 && first_ms >= 0 && elapsed_ms >= first_ms {
            seat_tokens(self.readings, l, "output", output);
            std::metrics::histogram(
                self.readings,
                "generation_seconds",
                GENERATION_BOUNDS,
                l,
            ).observe(
                std::math::int_to_float(elapsed_ms - first_ms) / 1000.0,
            );
            std::metrics::histogram(
                self.readings,
                "first_output_seconds",
                GENERATION_BOUNDS,
                l,
            ).observe(
                std::math::int_to_float(first_ms) / 1000.0,
            );
        }
    }

    /// The seats' readings, as `report` says them: each seat up or not,
    /// what it serves at once, and a managed seat's fetch, labelled by its
    /// id and engine only, both configured and few. A seat no longer
    /// assigned, or no longer on the engine it was, reads 0 under its old
    /// labels, since a series cannot be retired.
    @bounded_by(self.seats)
    fn read_out() {
        let mut now = SeatIds { };
        for s in self.seats.items {
            push(now.items, ReadSeat { id: s.id, engine: s.engine }) or discard;
            let l = std::metrics::labels_two("seat", s.id, "engine", s.engine);
            seat_reading(self.readings, "seat_up", l, if s.status == "up" { 1 } else { 0 });
            seat_reading(self.readings, "seat_in_flight", l, seat_busy(self.busy, s.id));
            // the most it serves at once: a placement's seat's, its runtime's
            seat_reading(self.readings, "seat_concurrency", l, s.concurrency);
            if s.managed {
                seat_reading(self.readings, "seat_fetch_done_bytes", l, s.done_bytes);
                seat_reading(self.readings, "seat_fetch_total_bytes", l, s.total_bytes);
            }
        }
        for gone in self.read.items {
            if !still_read(now, gone) {
                let l = std::metrics::labels_two("seat", gone.id, "engine", gone.engine);
                seat_reading(self.readings, "seat_up", l, 0);
                seat_reading(self.readings, "seat_in_flight", l, 0);
                seat_reading(self.readings, "seat_concurrency", l, 0);
            }
        }
        self.read = now;
    }
}

/// The assigned seats, each with its state on this node (node.yaml
/// `NodeStatus.seats`).
fn status_seats(assignment: String, seats: NodeSeats, busy: String, pulls: SeatPulls) -> String {
    let out = std::bytes::BytesBuilder { initial_cap: 1024 };
    let mut any = false;
    let mut it = std::json::array_first(std::json::find_field_raw(assignment, "seats"));
    while !it.done {
        let s = std::str::trim(it.element);
        let st = seat_of(seats, std::json::find_string_field(s, "id"));
        if any { out.append_str(", "); }
        any = true;
        out.append_str(
            s[0..(len(s) - 1)] + ", \"status\": " + q(st.status) + ", \"reason\": "
                + (if len(st.reason) > 0 { q(st.reason) } else { "null" }) + ", \"in_flight\": "
                + to_string(seat_busy(busy, st.id)) + pull_field(pulls, st.id) + "}",
        );
        it = std::json::array_next(it);
    }
    let b = out.snapshot() or b"";
    return "[" + std::str::from_bytes(b) + "]";
}

/// True when `event` is output: by its own `type`, text, a tool call's
/// arguments or a refusal, as the api reads it too (api/stream.hl,
/// `output_event`), never by what its payload or the caller's metadata
/// says. The first is when the seat began to generate.
fn is_output(event: String) -> Bool {
    let kind = std::json::find_string_field(event, "type");
    return kind == "response.output_text.delta" || kind == "response.function_call_arguments.delta"
        || kind == "response.refusal.delta" || kind == "response.reasoning_text.delta"
    // a decision model's answer, whole: its first output and its last
        || kind == "decision.answer";
}

/// A managed seat's state as `f` says it, beside what was `held` of it.
/// A seat whose server is up stays up, its endpoint served, while the
/// fetcher fetches what it is assigned next (or cannot): only the runner,
/// which replaces the server once the new one is fetched, takes it
/// `starting` or `down`. What the fetch has done is kept, and why.
fn merged_fetch(held: FetchState, f: FetchState) -> FetchState {
    if f.by_runner || held.status != "up" { return f; }
    let mut out = held;
    out.done = f.done;
    out.total = f.total;
    out.reason = if f.status == "down" {
        "serving; what it is assigned next could not be fetched: " + f.reason
    } else if f.status == "fetching" {
        "serving while what it is assigned next is fetched"
    } else if std::str::starts_with(f.reason, "readying its inputs") {
        "serving while what it is assigned next readies its inputs"
    } else {
        ""
    };
    return out;
}
