/// What the api says to the organization that runs it: its events, each
/// on its own subject under `app.voice.`, published through pond's NATS
/// adapter when `--pulse` names the organization's prefix (main.hl). An
/// event is a signal: the organization records it and acts on nothing it
/// says; what it does to voice goes the other way, through this API.
///
/// Every event names itself with its own `id`. Delivery is at least
/// once, so the organization refuses an id it has recorded already.

/// One request's usage, as it settled: the ledger's `UsageRecord`
/// (spec/openapi.yaml), cut to what the organization reads — who asked,
/// for which model, how it ended, and what it cost. `id` is the request
/// id, the same as the record's.
type UsageEvent {
    id: String = "";
    created_at: String = "";
    project: String = "";
    key: String = "";
    requested_model: String = "";
    endpoint: String = "";
    status: String = "";
    input_tokens: Int = 0;
    output_tokens: Int = 0;
    price_micros: Int = 0;
    currency: String = "USD";
}

/// A request settled: its usage.
topic UsageRecorded { payload: UsageEvent; subject: "app.voice.usage.recorded"; }

/// The event read from a `UsageRecord` body.
fn usage_event(record: String) -> UsageEvent {
    return UsageEvent {
        id: std::json::find_string_field(record, "id"),
        created_at: std::json::find_string_field(record, "created_at"),
        project: std::json::find_string_field(record, "project"),
        key: std::json::find_string_field(record, "key"),
        requested_model: std::json::find_string_field(record, "requested_model"),
        endpoint: std::json::find_string_field(record, "endpoint"),
        status: std::json::find_string_field(record, "status"),
        input_tokens: std::json::find_int_field(record, "input_tokens"),
        output_tokens: std::json::find_int_field(record, "output_tokens"),
        price_micros: std::json::find_int_field(record, "price_micros"),
        currency: std::json::find_string_field(record, "currency")
    };
}

type CodecError { kind: String = ""; }

/// A JSON string literal (a codec is pure: no builder locus).
fn json_str(s: String) -> String {
    return "\"" + std::str::replace(std::str::replace(s, "\\", "\\\\"), "\"", "\\\"") + "\"";
}

/// A usage event on the wire: one JSON object, the fields as named above.
locus UsageJson {
    fn encode(u: UsageEvent) -> Bytes fallible(CodecError) {
        return std::bytes::from_string("{\"id\":" + json_str(u.id)
                + ",\"created_at\":" + json_str(u.created_at)
                + ",\"project\":" + json_str(u.project)
                + ",\"key\":" + json_str(u.key)
                + ",\"requested_model\":" + json_str(u.requested_model)
                + ",\"endpoint\":" + json_str(u.endpoint)
                + ",\"status\":" + json_str(u.status)
                + ",\"input_tokens\":" + to_string(u.input_tokens)
                + ",\"output_tokens\":" + to_string(u.output_tokens)
                + ",\"price_micros\":" + to_string(u.price_micros)
                + ",\"currency\":" + json_str(u.currency) + "}");
    }
    fn decode(b: Bytes) -> UsageEvent fallible(CodecError) {
        return usage_event(std::str::from_bytes(b));
    }
}
