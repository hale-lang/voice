// Keys on the admin plane: the rows of `Keys` (list, create, get, update,
// revoke) called on a receiver over a store, and the times a key's expiry
// is read from by the codec the transport uses.
import ".." as api;
import "../../store" as st;

fn names(xs: bounded[String; 32]) -> String {
    let mut out = "";
    for x in xs {
        out = out + (if len(out) > 0 { "," } else { "" }) + x;
    }
    return out;
}

fn blank() -> api::Key {
    return api::Key { status: api::KeyStatus::revoked };
}

/// The instant `rfc3339` (the reader of the query times) reads from `text`,
/// in UTC; "refused" when it reads none.
fn instant(text: String) -> String {
    let t = api::rfc3339(text) or `1970-01-01T00:00:00Z`;
    if t == `1970-01-01T00:00:00Z` { return "refused"; }
    return std::time::iso8601(t);
}

/// The expiry the codec (the transport's reader of a key's JSON) reads.
fn expiry(text: String) -> String {
    let c = api::KeyCreate::api_decode(
        "{\"project\": \"work\", \"name\": \"x\", \"expires_at\": \"" + text + "\"}",
    ) or api::KeyCreate { project: "refused", name: "" };
    if c.project == "refused" { return "refused"; }
    return std::time::iso8601(c.expires_at);
}

fn main() {
    let store = st::MemoryStore { };
    let projects = api::Projects { store: store };
    let keys = api::Keys { store: store };

    let mut w = api::ProjectCreate { id: "work", name: "Work", has_accounts: true };
    push(w.accounts, "claude-work") or discard;
    push(w.accounts, "static") or discard;
    projects.create(w) or discard;
    projects.create(api::ProjectCreate { id: "home", name: "Home" }) or discard;

    let mut failed = "";
    keys.create(api::KeyCreate { project: "nope", name: "ci" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "a key needs its project");

    let mut c = api::KeyCreate { project: "work", name: "ci", has_accounts: true };
    push(c.accounts, "claude-work") or discard;
    let made = keys.create(c) or blank();
    let id = made.id;
    let secret = made.secret;
    std::test::assert(std::str::starts_with(id, "k_"), "a key id");
    std::test::assert(
        made.has_secret && std::str::starts_with(secret, "vk-") && len(secret) == 43,
        "a secret, shown once",
    );
    std::test::assert_eq_str(made.prefix, secret[0..7], "the prefix is the secret's start");
    std::test::assert_eq_str(made.project, "work", "its project");
    std::test::assert(made.status == api::KeyStatus::active, "active");
    std::test::assert_eq_str(names(made.accounts), "claude-work", "its accounts");
    std::test::assert(!made.has_models, "the project's models");
    std::test::assert(!made.has_expires_at, "no expiry");
    std::test::assert(!made.has_last_used_at, "never used");

    let second = keys.create(api::KeyCreate { project: "work", name: "laptop" }) or blank();
    std::test::assert(
        len(second.secret) > 0 && second.secret != secret,
        "every key has its own secret",
    );

    let mut other = api::KeyCreate { project: "work", name: "x", has_accounts: true };
    push(other.accounts, "codex") or discard;
    failed = "";
    keys.create(other) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(
        failed,
        "invalid accounts",
        "a key's accounts sit within its project's",
    );
    failed = "";
    keys.create(api::KeyCreate { project: "work", name: "" }) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid name", "a name is required");
    failed = "";
    keys.create(
        api::KeyCreate {
            project: "work",
            name: "x",
            has_expires_at: true,
            expires_at: `2020-01-01T00:00:00Z`,
        },
    ) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid expires_at", "an expiry in the past");

    // the times an expiry is read from: the codec reads the `Z` form
    std::test::assert_eq_str(
        expiry("2099-01-01T00:00:00Z"),
        "2099-01-01T00:00:00Z",
        "the codec's time",
    );
    std::test::assert_eq_str(expiry("tomorrow"), "refused", "an expiry is a time");
    // and `rfc3339` (the query times' reader) reads the offset forms
    std::test::assert_eq_str(instant("tomorrow"), "refused", "an expiry is a time");
    std::test::assert_eq_str(
        instant("2099-01-01T02:30:00+02:30"),
        "2099-01-01T00:00:00Z",
        "an expiry with an offset, kept in UTC",
    );
    std::test::assert_eq_str(
        instant("2098-12-31t19:00:00-05:00"),
        "2099-01-01T00:00:00Z",
        "a lowercase t and a negative offset",
    );
    std::test::assert_eq_str(
        instant("2099-01-01t00:00:00.5z"),
        "2099-01-01T00:00:00.5Z",
        "a lowercase z, and a fraction",
    );
    std::test::assert_eq_str(
        instant("2099-01-01T00:00:00+25:00"),
        "refused",
        "an offset is a real one",
    );
    std::test::assert_eq_str(
        instant("2099-01-01T00:00:00+-1:00"),
        "refused",
        "an offset is two digits and two",
    );
    std::test::assert_eq_str(
        instant("2099-02-30T00:00:00Z"),
        "refused",
        "a day the month does not have",
    );
    std::test::assert_eq_str(
        instant("2099-13-01T00:00:00Z"),
        "refused",
        "a month the year does not have",
    );
    std::test::assert_eq_str(
        instant("2096-02-29T00:00:00Z"),
        "2096-02-29T00:00:00Z",
        "a leap day is a day",
    );

    let mut named = api::KeyCreate { project: "work", name: "x", has_accounts: true };
    push(named.accounts, "Claude Work") or discard;
    failed = "";
    keys.create(named) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a key's accounts are the project's account ids");

    let mut lim = api::KeyCreate { project: "work", name: "x" };
    push(
        lim.limits,
        st::counted(st::Limit { scope: st::LimitScope::key, window_seconds: 60, requests: 10 }),
    ) or discard;
    let limited = keys.create(lim) or blank();
    let mut requests = -1;
    for l in limited.limits {
        requests = l.requests;
    }
    std::test::assert_eq_int(requests, 10, "a key with its own limit, kept");
    let mut wide = api::KeyCreate { project: "work", name: "x" };
    push(wide.limits, st::Limit { scope: st::LimitScope::project, window_seconds: 60 }) or discard;
    failed = "";
    keys.create(wide) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid limits", "a key's limits are key-scope");
    let dated = keys.create(
        api::KeyCreate {
            project: "work",
            name: "temp",
            has_expires_at: true,
            expires_at: `2099-01-01T00:00:00Z`,
        },
    ) or blank();
    std::test::assert(dated.has_expires_at, "a key that expires");
    std::test::assert_eq_str(std::time::iso8601(dated.expires_at), "2099-01-01T00:00:00Z", "when");

    let listed = keys.list(api::ProjectRef { project: "work" }) or api::KeyList { };
    let mut seen = false;
    let mut with_secret = false;
    for k in listed.data {
        if k.id == id { seen = true; }
        if k.has_secret || len(k.secret) > 0 { with_secret = true; }
    }
    std::test::assert(seen, "the key is listed");
    std::test::assert(!with_secret, "never its secret");
    std::test::assert_eq_int(count(listed.data), 4, "the project's keys, listed");
    let counted = projects.get(api::ProjectRef { project: "work" }) or api::Project {
        status: api::Lifecycle::archived,
    };
    std::test::assert_eq_int(counted.key_count, 4, "the project counts its keys");
    let home = keys.list(api::ProjectRef { project: "home" }) or api::KeyList { };
    std::test::assert_eq_int(count(home.data), 0, "keys are per project");

    let got = keys.get(api::KeyRef { project: "work", key: id }) or blank();
    std::test::assert_eq_str(got.id, id, "get");
    std::test::assert(!got.has_secret && len(got.secret) == 0, "no secret after creation");
    failed = "";
    keys.get(api::KeyRef { project: "home", key: id }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "a key of another project is not found");
    failed = "";
    keys.get(api::KeyRef { project: "work", key: "k_nope" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "an unknown key");

    let mut patch = api::KeyUpdate {
        project: "work",
        key: id,
        has_name: true,
        name: "ci-2",
        has_models: true,
        has_expires_at: true,
        expires_at: `2099-06-01T00:00:00Z`,
    };
    push(patch.models, "echo-1") or discard;
    let changed = keys.update(patch) or blank();
    std::test::assert_eq_str(changed.name, "ci-2", "renamed");
    std::test::assert_eq_str(names(changed.models), "echo-1", "restricted");
    std::test::assert_eq_str(names(changed.accounts), "claude-work", "a field not set stays");
    std::test::assert(changed.has_expires_at, "an expiry set");
    let cleared = keys.update(
        api::KeyUpdate { project: "work", key: id, clear_expires_at: true },
    ) or blank();
    std::test::assert(!cleared.has_expires_at, "the expiry removed");
    let mut outside = api::KeyUpdate { project: "work", key: id, has_accounts: true };
    push(outside.accounts, "codex") or discard;
    failed = "";
    keys.update(outside) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "still within the project's accounts");

    let revoked = keys.revoke(api::KeyRef { project: "work", key: id }) or blank();
    std::test::assert(revoked.status == api::KeyStatus::revoked, "revoked");
    std::test::assert(
        revoked.has_revoked_at && std::str::ends_with(std::time::iso8601(revoked.revoked_at), "Z"),
        "when",
    );
    let again = keys.revoke(api::KeyRef { project: "work", key: id }) or blank();
    std::test::assert(
        again.status == api::KeyStatus::revoked && again.revoked_at == revoked.revoked_at,
        "revoking again changes nothing",
    );
}
