// The hub's admin events (admin_events.hl `AdminFeed`, hub.hl): a feed
// starts at the head, then publishes each row past its marks on its topic,
// whoever wrote it; the requests in flight go whole, and only when the set
// changes; the change log is read past its mark, so a look with nothing
// new tells nothing, and one far behind catches up a bounded page at a
// time; a `data` too large for a bus frame goes as `null`, `whole` false.
import ".." as api;
import "../../store" as st;

locus Watch {
    params {
        usage: Int = 0;
        usage_data: String = "";
        usage_whole: Bool = true;
        changes: Int = 0;
        change_ids: String = "";
        change_data: String = "";
        flights: Int = 0;
        flights_data: String = "";
        nodes: Int = 0;
        node_data: String = "";
        steps: Int = 0;
        step_data: String = "";
    }

    bus {
        subscribe api::UsageRecorded as on_usage;
        subscribe api::ChangeMade as on_change;
        subscribe api::RequestsInFlight as on_flights;
        subscribe api::NodeMoved as on_node;
        subscribe api::AnnotationStepTaken as on_step;
    }

    fn on_step(r: api::AdminRecord) {
        self.steps = self.steps + 1;
        self.step_data = r.data;
    }

    fn on_node(r: api::AdminRecord) {
        self.nodes = self.nodes + 1;
        self.node_data = r.data;
    }

    fn on_usage(r: api::AdminRecord) {
        self.usage = self.usage + 1;
        self.usage_data = r.data;
        self.usage_whole = r.whole;
    }

    fn on_change(r: api::AdminRecord) {
        self.changes = self.changes + 1;
        self.change_ids = self.change_ids + r.id + " ";
        self.change_data = r.data;
    }

    fn on_flights(r: api::AdminRecord) {
        self.flights = self.flights + 1;
        self.flights_data = r.data;
    }
}

fn usage_row(id: String, record: String) -> st::UsageRow {
    return st::UsageRow {
        id: id,
        project: "work",
        key: "k1",
        requested_model: "echo",
        status: "served",
        record: record,
        present: true,
    };
}

main locus App {
    params {
        watch: Watch = Watch { };
        feed: api::AdminFeed = api::AdminFeed { };
    }

    run() {
        // what was there before the feed started is not told
        self.feed.store.insert_usage(
            usage_row("resp_before", "{\"id\": \"resp_before\"}"),
        ) or discard;
        self.feed.tick(true);
        std::time::sleep(50ms);
        std::test::assert_eq_int(self.watch.usage, 0, "a feed starts at the head");

        // a request recorded (by any instance: the feed reads the rows)
        self.feed.store.insert_usage(
            usage_row("resp_1", "{\"id\": \"resp_1\", \"project\": \"work\"}"),
        ) or discard;
        self.feed.store.put_flight(
            st::FlightRow {
                request_id: "resp_2",
                project: "work",
                key: "k1",
                model: "echo",
                seat: "n1/s1",
                account: "a1",
                started_at: std::time::current(),
            },
        ) or discard;
        self.feed.tick(false);
        std::time::sleep(50ms);
        std::test::assert_eq_int(self.watch.usage, 1, "a usage row is published once");
        std::test::assert(
            std::str::contains(self.watch.usage_data, "\"resp_1\""),
            "with its record: " + self.watch.usage_data,
        );
        std::test::assert_eq_int(self.watch.flights, 1, "the requests in flight, whole");
        std::test::assert(
            std::str::contains(self.watch.flights_data, "\"resp_2\""),
            "naming the one in flight: " + self.watch.flights_data,
        );

        // nothing new: nothing told, the set unchanged is not told again
        self.feed.tick(false);
        std::time::sleep(50ms);
        std::test::assert_eq_int(self.watch.usage, 1, "a row is told once");
        std::test::assert_eq_int(self.watch.flights, 1, "an unchanged set is not told again");

        // the request settles: the set is told empty
        self.feed.store.drop_flight("resp_2") or discard;
        self.feed.tick(false);
        std::time::sleep(50ms);
        std::test::assert_eq_int(self.watch.flights, 2, "a changed set is told");
        std::test::assert_eq_str(self.watch.flights_data, "[]", "now empty");

        // a seat's state moves, reported through another instance, its
        // node's status unchanged: the node is told as it now is
        self.feed.store.insert_node(
            st::NodeRow { id: "n1", name: "n1", token_digest: "d", present: true },
            st::ChangeRow { id: "chg_n1", action: "create", target: "nodes/n1" },
        ) or discard;
        self.feed.store.insert_seat(
            st::SeatRow {
                ref: "n1/s1",
                node: "n1",
                id: "s1",
                engine: "static",
                account: "a1",
                present: true,
            },
            st::ChangeRow { id: "chg_s1", action: "create", target: "nodes/n1/seats/s1" },
        ) or discard;
        // registered and beating, its assignment applied: what it reports
        // of its seats stands
        self.feed.store.put_fleet(
            st::FleetRow {
                node: "n1",
                version: "0.1.0",
                capabilities: "{\"max_in_flight\": 1, \"engines\": []}",
                registered_at: std::time::current(),
                applied_version: 99,
                present: true,
            },
        ) or discard;
        self.feed.store.put_beat("n1", std::time::current(), 0) or discard;
        self.feed.tick(false);
        std::time::sleep(50ms);
        let after_create = self.watch.nodes;
        // beats alone, with what it reported unchanged, tell nothing
        self.feed.store.put_beat("n1", std::time::current(), 1) or discard;
        self.feed.tick(false);
        std::time::sleep(50ms);
        std::test::assert_eq_int(
            self.watch.nodes,
            after_create,
            "a node unchanged is not told again",
        );
        self.feed.store.put_seat_state(
            st::SeatStateRow {
                ref: "n1/s1",
                node: "n1",
                seat: "s1",
                status: "fetching",
                has_progress: true,
                done_bytes: 10,
                total_bytes: 100,
            },
        ) or discard;
        self.feed.tick(false);
        std::time::sleep(50ms);
        std::test::assert_eq_int(
            self.watch.nodes,
            after_create + 1,
            "a seat's state moved: its node is told",
        );
        std::test::assert(
            std::str::contains(self.watch.node_data, "\"fetching\""),
            "with the seat as it now is: " + self.watch.node_data,
        );
        self.feed.store.put_seat_state(
            st::SeatStateRow {
                ref: "n1/s1",
                node: "n1",
                seat: "s1",
                status: "fetching",
                has_progress: true,
                done_bytes: 60,
                total_bytes: 100,
            },
        ) or discard;
        self.feed.tick(false);
        std::time::sleep(50ms);
        std::test::assert_eq_int(self.watch.nodes, after_create + 2, "and its fetch progress");

        // an annotation's steps, each as it is taken, in order
        let now = std::time::current();
        self.feed.store.put_annotation_step(
            st::StepRow { request_id: "resp_1", project: "work", at: now, step: "queued" },
        ) or discard;
        self.feed.store.put_annotation_step(
            st::StepRow {
                request_id: "resp_1",
                project: "work",
                at: now,
                step: "waiting",
                stage: "request",
                reason: "waiting for a seat (attempt 1, next in 2s)",
            },
        ) or discard;
        self.feed.tick(false);
        std::time::sleep(50ms);
        std::test::assert_eq_int(self.watch.steps, 2, "each step told once");
        std::test::assert(
            std::str::contains(self.watch.step_data, "\"waiting\"")
                && std::str::contains(self.watch.step_data, "next in 2s"),
            "the last, last: " + self.watch.step_data,
        );
        self.feed.tick(false);
        std::time::sleep(50ms);
        std::test::assert_eq_int(self.watch.steps, 2, "a step is told once");

        // the change log, past the feed's mark: what was told is not told
        // again, and each change after it is, in order, whole
        self.feed.tick(false);
        std::time::sleep(50ms);
        let told = self.watch.changes;
        std::test::assert(told >= 2, "the node's and its seat's changes were told");
        let catalog = api::Catalog { store: self.feed.store };
        catalog.create(api::CatalogModelCreate { id: "m1" }) or discard;
        catalog.create(api::CatalogModelCreate { id: "m2" }) or discard;
        self.watch.change_ids = "";
        self.feed.tick(false);
        std::time::sleep(50ms);
        std::test::assert_eq_int(self.watch.changes, told + 2, "each new change told once");
        std::test::assert(
            std::str::starts_with(self.watch.change_ids, "change_")
                && std::str::contains(self.watch.change_data, "\"target\": \"models/m2\"")
                && std::str::contains(self.watch.change_data, "\"after\": {"),
            "oldest first, the last whole: " + self.watch.change_data,
        );
        self.feed.tick(false);
        std::time::sleep(50ms);
        std::test::assert_eq_int(self.watch.changes, told + 2, "nothing new: nothing told");
        // a feed far behind catches up a bounded page at a time
        let mut i = 1;
        while i <= 1200 {
            catalog.update(
                api::CatalogModelUpdate {
                    model: "m1",
                    has_context_length: true,
                    context_length: i,
                },
            ) or discard;
            i = i + 1;
        }
        self.feed.tick(false);
        std::time::sleep(200ms);
        let caught = self.watch.changes - told - 2;
        std::test::assert(
            caught > 0 && caught <= 1000,
            "a look tells at most a thousand: " + to_string(caught),
        );
        self.feed.tick(false);
        std::time::sleep(200ms);
        self.feed.tick(false);
        std::time::sleep(200ms);
        std::test::assert(
            self.watch.changes - told - 2 <= 1200,
            "none told twice: " + to_string(self.watch.changes - told - 2),
        );
        std::test::assert(
            std::str::contains(self.watch.change_data, "\"context_length\": 1200"),
            "the last change told last: " + self.watch.change_data,
        );

        // a record too large for one bus frame goes without its data
        let big = "{\"id\": \"resp_big\", \"pad\": \"" + std::str::repeat("x", 70000) + "\"}";
        self.feed.store.insert_usage(usage_row("resp_big", big)) or discard;
        self.feed.tick(false);
        std::time::sleep(50ms);
        std::test::assert_eq_int(self.watch.usage, 2, "a large record is still told");
        std::test::assert_eq_str(self.watch.usage_data, "null", "without its data");
        std::test::assert(!self.watch.usage_whole, "and says so");
    }
}

fn main() {
    App { };
}
