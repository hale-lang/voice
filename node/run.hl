// The managed engine's run: a managed seat whose weights and runtime the
// fetcher verified (fetch.hl) is started here, in voice's sandbox, and the
// seat is `up` once its server answers its health check and its first
// answers are right (smoke.hl); else `down`, with why. The session then
// serves the seat through the openai-compatible path, to the server's
// port on loopback (session.hl).
//
// Loopback is not the node's alone: any program on the machine, a web page
// in its browser among them, reaches it. So each server is started with a
// key of its own, drawn fresh as it starts (`engine_key`) and held in the
// node's memory alone, and answers only a request that presents it (each
// server's own check, `key_env`); the node presents it on every call it
// makes to the server, its health check, its context and the requests it
// serves. The key reaches the server in its environment, never on a
// command line.
//
// Voice decides how a runtime runs; nothing here is configured:
// - a container runtime runs under docker, its image by digest, the
//   weights mounted read-only, its port published on loopback only, and
//   the GPUs given to it when it runs on CUDA;
// - an archive runtime is unpacked once into `runtimes/<sha256>` and runs
//   under macOS's sandbox: it may write only its own directory, and reach
//   and listen on loopback only. On Linux voice runs runtimes as
//   containers, so an archive runtime there is refused.
//
// The weights are laid out under the names the recipe gives them, in
// `models/<seat>`, as links into the store, so a server finds a model of
// several files where it expects them. A server's port is the node's to
// pick. A server that ends takes its seat `down`, with what it said last;
// a seat that leaves the assignment has its server stopped. A server left
// running by a node that stopped is stopped when the node starts again.
//
// A seat's part of a placement across two nodes (its config's `cluster`,
// span.hl) runs vLLM's multi-node executor in the runtime's container on
// the host's network, its API on loopback alone. The leader's is `up` once
// its API answers, which it does only when both ranks have loaded; the
// follower's, headless, answers nothing, and is `up` while its server runs,
// joined or waiting for the leader to be there.

/// A managed seat to run, once its fetch verified.
type RunJob { seat: String = ""; config: String = ""; }

topic RunWanted { payload: RunJob; }

/// The managed seats the assignment holds, one a line: the runner stops
/// the server of any other.
type ManagedSeats { ids: String = ""; }

topic ManagedAssigned { payload: ManagedSeats; }

/// One running server.
type Run {
    seat: String = "";
    // starting until its health check answers, then up
    phase: String = "starting";
    port: Int = 0;
    // the server's health check, and its API's base, both on loopback
    health: String = "";
    endpoint: String = "";
    // the container's name, "" for an archive's process
    container: String = "";
    // the process, and the file it writes to
    pid: Int = 0;
    log: String = "";
    // the server (vllm or llama-server), and the context it took, read once
    // it answers
    server: String = "";
    context: Int = 0;
    // times it was asked for its context since it answered
    asked: Int = 0;
    // what it holds of the memory for models (`footprint`)
    footprint: Int = 0;
    // what it serves (`serving_identity`): a seat assigned again with
    // another is replaced, one with the same is left serving
    identity: String = "";
    // a part of a placement across two nodes
    spans: Bool = false;
    // the key its server answers to (`engine_key`), which every call to it
    // presents; never logged, never on a command line
    key: String = "";
    // the catalog model its server serves as, which the node's own calls
    // to it name (smoke.hl)
    model: String = "";
}

type Runs { items: bounded[Run; 16]; }

/// The label a node's containers carry, its id the value.
const OWNER_LABEL: String = "net.hale-lang.voice.node";

/// Where the node looks for ports for its servers.
const PORT_FROM: Int = 47100;

locus Runner {
    params {
        id: String = "";
        data: String = "node-data";
        // seats to start, one a line: the seat, a tab, its config escaped
        queue: String = "";
        runs: Runs = Runs { };
        cleaned: Bool = false;
        // the assignment's managed seats, one a line, once the session has
        // said them: a seat outside them is never started
        assigned: String = "";
        heard: Bool = false;
        // the memory the GPU gives a server (hardware.hl), 0 for none
        gpu_memory: Int = 0;
        // the memory the node gives models (hardware.hl `model_memory`):
        // the seats it runs hold at most this together, none when it is 0;
        // -1 for unknown
        model_memory: Int = -1;
        // the node's declared capabilities, whose links a part across two
        // nodes runs over (span.hl)
        capabilities: String = "";
    }

    bus {
        subscribe RunWanted as on_wanted;
        subscribe ManagedAssigned as on_assigned;
        publish FetchUpdated;
    }

    run() {
        // a stop (SIGTERM, `systemctl stop`) drains the node: each loop
        // returns, then its locus's `drain()` and `dissolve()` run
        while !self.draining {
            self.step();
        }
    }

    /// One turn: what a node that stopped left running is stopped, the
    /// next seat started, every server looked at, then a sleep, where
    /// asks arrive.
    @unbounded
    fn step() {
        if !self.cleaned {
            self.clean();
            self.cleaned = true;
        }
        if len(self.queue) > 0 {
            let nl = std::str::index_of(self.queue, "\n");
            let line = self.queue[0..nl];
            self.queue = self.queue[(nl + 1)..len(self.queue)];
            let tab = std::str::index_of(line, "\t");
            self.start(line[0..tab], std::json::unescape_string(line[(tab + 1)..len(line)]));
        }
        self.look();
        std::time::sleep(500ms);
    }

    /// A seat whose weights and runtime the fetcher verified, to run. A
    /// seat already served is left serving when it is assigned what it
    /// serves, and replaced when it is assigned another server (its
    /// runtime, its variant, what its server is started with): the old
    /// server served while the new one was fetched, and is stopped, all of
    /// it, before the new one starts, so the two never hold memory at once.
    @unbounded
    fn on_wanted(j: RunJob) {
        // a fetch that finished after its seat was withdrawn starts nothing
        if !self.holds(j.seat) { return; }
        // a start still waiting takes the config asked for last
        self.queue = queue_without(self.queue, j.seat);
        let mut next = Runs { };
        let mut replaced = false;
        for r in self.runs.items {
            if r.seat == j.seat {
                if wanted_action(r.identity, j.config) == "keep" {
                    // asked for again when an assignment changes: the
                    // fetcher just said `starting` of it, so it is told up
                    // again (one still starting says so when it answers)
                    if r.phase == "up" { self.tell_up(r); }
                    return;
                }
                self.tell(j.seat, "starting", "its server is replaced: it is assigned another", "");
                self.stop(r);
                replaced = true;
            } else {
                push(next.items, r) or discard;
            }
        }
        if replaced { self.runs = next; }
        self.queue = self.queue + j.seat + "\t" + std::json::escape_string(j.config) + "\n";
    }

    /// The assignment's managed seats: the server of any other is stopped.
    @unbounded
    fn on_assigned(m: ManagedSeats) {
        self.assigned = m.ids;
        self.heard = true;
        // seats waiting to start that the assignment no longer holds
        let mut queue = "";
        let qv = std::str::bytes_view(self.queue);
        let mut at_ = 0;
        while at_ < qv.n {
            let nl = line_end(qv, at_);
            let line = std::str::slice(qv, at_, nl);
            at_ = nl + 1;
            let tab = std::str::index_of(line, "\t");
            if tab > 0 && self.holds(line[0..tab]) { queue = queue + line + "\n"; }
        }
        self.queue = queue;
        let mut next = Runs { };
        for r in self.runs.items {
            if std::str::contains("\n" + m.ids, "\n" + r.seat + "\n") {
                push(next.items, r) or discard;
            } else {
                self.stop(r);
            }
        }
        self.runs = next;
    }

    /// True when the assignment holds managed seat `seat` (or the session
    /// has not said yet).
    fn holds(seat: String) -> Bool {
        return !self.heard || std::str::contains("\n" + self.assigned, "\n" + seat + "\n");
    }

    /// Start a seat's server: its weights laid out, its runtime ready, its
    /// process begun; the seat is `starting` until it answers.
    @unbounded
    fn start(seat: String, config: String) {
        if !self.holds(seat) { return; }
        let runtime = std::json::find_field_raw(config, "runtime");
        let artifact = std::json::find_field_raw(runtime, "artifact");
        let server = std::json::find_string_field(runtime, "server");
        let models = self.data + "/models/" + seat;
        let variant = std::json::find_field_raw(config, "variant");
        let first = self.lay_out(models, variant);
        if len(first) == 0 {
            self.tell(seat, "down", "its weights could not be laid out under " + models, "");
            return;
        }
        // its tokenizer, as its variant says it must be loaded
        let tokenizer = lay_out_tokenizer(models, variant);
        if len(tokenizer) > 0 {
            self.tell(seat, "down", tokenizer, "");
            return;
        }
        // a TensorFold seat's: its readied inputs beside its weights, and
        // its file sets, each a folder of its own (tensorfold.hl)
        let sets = self.data + "/sets/" + seat;
        let prepared = if server == "tensorfold" { prepared_dir(self.data, config) } else { "" };
        if server == "tensorfold" {
            if !std::io::fs::file_exists(prepared) {
                self.tell(seat, "down", "its inputs are not readied (" + prepared + ")", "");
                return;
            }
            let laid = self.lay_out_tensorfold(models, sets, prepared, variant, rank_of(config));
            if len(laid) > 0 {
                self.tell(seat, "down", laid, "");
                return;
            }
        }
        // what it holds once it runs (`footprint`): what the placement
        // reserved for it (its variant and its prompt cache), or, placed
        // before voice sized that, its variant's need, and its server's own.
        // It is started only beside what the node's other seats hold, never
        // past what the node gives models, as the placement judged it
        let reserved = std::json::find_int_field(config, "reserved_bytes");
        let need = footprint(
            if reserved > 0 {
                reserved
            } else {
                std::json::find_int_field(
                    std::json::find_field_raw(config, "variant"),
                    "memory_bytes",
                )
            },
        );
        let mut held = 0;
        for r in self.runs.items { held = held + r.footprint; }
        let refused = start_refusal(server, need, held, self.model_memory, self.gpu_memory);
        if len(refused) > 0 {
            self.tell(seat, "down", refused, "");
            return;
        }
        // its runtime's kernels built for this node's GPU
        let wrong_gpu = compute_refusal(runtime, self.capabilities);
        if len(wrong_gpu) > 0 {
            self.tell(seat, "down", wrong_gpu, "");
            return;
        }
        let share = gpu_share(need, self.gpu_memory);
        // its part across two nodes, over this node's link to the other
        let cluster = std::str::trim(std::json::find_field_raw(config, "cluster"));
        let spans = len(cluster) > 0;
        let mut env = "";
        if spans {
            let refused_part = self.part_refusal(server, artifact, cluster);
            if len(refused_part) > 0 {
                self.tell(seat, "down", refused_part, "");
                return;
            }
            let peer = std::json::find_string_field(cluster, "peer");
            let caps = with_sent_link(
                self.capabilities,
                std::json::find_field_raw(cluster, "link"),
            );
            env = if server == "tensorfold" { lanes_env(caps, peer) } else { link_env(caps, peer) };
        } else if server == "tensorfold" {
            self.tell(
                seat,
                "down",
                "a tensorfold runtime runs across two nodes, and this seat is not a part of one",
                "",
            );
            return;
        }
        let port = free_port(PORT_FROM + count(self.runs.items));
        if port < 0 {
            self.tell(seat, "down", "no free port on loopback for its server", "");
            return;
        }
        // the key its server answers to, fresh for this start
        let key = engine_key();
        if len(key) == 0 {
            self.tell(seat, "down", "no key could be drawn for its server", "");
            return;
        }
        // a container is handed it by name (`docker run -e NAME`), its
        // value from the environment docker is started with
        let key_flag = "-e\n" + key_env(server) + "\n";
        let mut r = Run {
            seat: seat,
            identity: serving_identity(config),
            server: server,
            port: port,
            footprint: need,
            health: "http://127.0.0.1:" + to_string(port) + health_path(server),
            endpoint: "http://127.0.0.1:" + to_string(port) + "/v1",
            spans: spans,
            key: key,
            model: std::json::find_string_field(config, "model"),
        };
        // a follower serves no API: nothing to ask, nowhere to serve
        if spans && std::json::find_int_field(cluster, "rank") > 0 {
            r.health = "";
            r.endpoint = "";
        }
        let mut argv = "";
        if std::json::find_string_field(artifact, "kind") == "container" {
            // named so no two nodes' seats meet (ids hold no dots), and
            // labelled with the node that owns it; one of that name that is
            // not this node's is not this node's to remove
            r.container = "voice." + self.id + "." + seat;
            let owner = std::str::trim(
                run_out(
                    "docker\ninspect\n-f\n{{index .Config.Labels \"" + OWNER_LABEL + "\"}}\n"
                        + r.container,
                ),
            );
            if len(run_out("docker\ninspect\n-f\n{{.Id}}\n" + r.container)) > 0
                && owner != self.id
            {
                self.tell(
                    seat,
                    "down",
                    "a container named " + r.container + " is there, and it is not this node's",
                    "",
                );
                return;
            }
            run_out("docker\nrm\n-f\n" + r.container);
            argv = if server == "tensorfold" {
                tensorfold_argv(
                    r.container,
                    self.id,
                    self.data,
                    models,
                    sets,
                    prepared,
                    unpack_archive(
                        self.data,
                        std::json::find_string_field(
                            std::json::find_field_raw(artifact, "archive"),
                            "sha256",
                        ),
                    ),
                    env + key_flag,
                    std::json::find_string_field(artifact, "image") + "@"
                        + std::json::find_string_field(artifact, "digest"),
                    rank_launch(
                        cluster,
                        link_hcas(
                            with_sent_link(
                                self.capabilities,
                                std::json::find_field_raw(cluster, "link"),
                            ),
                            std::json::find_string_field(cluster, "peer"),
                        ),
                        std::json::find_string_field(config, "model"),
                        port,
                        served_tokens_tensorfold(config),
                    ),
                )
            } else if spans {
                span_container_argv(
                    r.container,
                    self.id,
                    models,
                    self.data + "/blobs",
                    env + key_flag,
                    server_cache_args(
                        server,
                        self.data,
                        std::json::find_string_field(runtime, "id"),
                    ),
                    std::json::find_string_field(artifact, "image") + "@"
                        + std::json::find_string_field(artifact, "digest"),
                    server_args(
                        server,
                        "/models",
                        "/models/" + first,
                        port,
                        "127.0.0.1",
                        std::json::find_string_field(config, "model"), share,
                        served_tokens(config),
                        concurrency::placed(config),
                        load_format(runtime),
                        std::json::find_field_raw(config, "variant"),
                    ) + span_args(cluster),
                )
            } else {
                container_argv(
                    r.container,
                    self.id,
                    port,
                    models,
                    self.data + "/blobs",
                    gpu_args(std::json::find_string_field(runtime, "accelerator")),
                    key_flag,
                    server_cache_args(
                        server,
                        self.data,
                        std::json::find_string_field(runtime, "id"),
                    ),
                    std::json::find_string_field(artifact, "image") + "@"
                        + std::json::find_string_field(artifact, "digest"),
                    server_args(
                        server,
                        "/models",
                        "/models/" + first,
                        8080,
                        "0.0.0.0",
                        std::json::find_string_field(config, "model"), share,
                        served_tokens(config),
                        concurrency::placed(config),
                        load_format(runtime),
                        std::json::find_field_raw(config, "variant"),
                    ),
                )
            };
        } else {
            if os_of(run_out("uname\n-s")) != "darwin" {
                self.tell(
                    seat,
                    "down",
                    "an archive runtime runs only on macOS; on Linux voice runs runtimes as containers",
                    "",
                );
                return;
            }
            let dir = self.unpacked(std::json::find_string_field(artifact, "sha256"));
            let bin = archive_program(dir, server);
            if len(bin) == 0 {
                self.tell(
                    seat,
                    "down",
                    "its runtime's archive holds no " + server_program(server),
                    "",
                );
                return;
            }
            argv = "sandbox-exec\n-p\n" + sandbox_profile(dir) + "\n" + bin + "\n"
                + server_args(
                    server,
                    models,
                    models + "/" + first,
                    port,
                    "127.0.0.1",
                    std::json::find_string_field(config, "model"), share,
                    served_tokens(config),
                    concurrency::placed(config),
                    load_format(runtime),
                    std::json::find_field_raw(config, "variant"),
                );
        }
        std::io::fs::mkdir(self.data + "/run") or discard;
        r.log = self.data + "/run/" + seat + ".log";
        let pid = launch(self.data, r.log, argv, server, key);
        if pid <= 0 {
            self.tell(seat, "down", "its server could not be started", "");
            return;
        }
        r.pid = pid;
        if len(r.container) == 0 {
            let pidf = std::io::file::open(self.data + "/run/" + seat + ".pid", "w") or { return; };
            // the pid and when the process began: a pid alone is not this
            // process once it has ended and the number is given again
            pidf.write_line(to_string(pid) + "\t" + started_at(pid)) or discard;
        }
        push(self.runs.items, r) or discard;
        self.tell(seat, "starting", "its server is loading the model", "");
    }

    /// Every server looked at: one that ended taking its seat down, with
    /// what it wrote last, one that answers its health check taking it up.
    /// It runs twice a second for the node's life, so `self.runs` is
    /// changed in place, a run written back only when it changed or moved
    /// down over one that ended: a `Runs` stored whole keeps every String
    /// of the one it replaced in the runner's arena (FRICTION.md), a run's
    /// serving identity among them, its variant's whole file list.
    @unbounded
    fn look() {
        let mut kept = 0;
        let mut i = 0;
        while i < count(self.runs.items) {
            let mut r = at(self.runs.items, i) or Run { };
            i = i + 1;
            if !alive(r.pid) {
                std::io::fs::unlink(self.data + "/run/" + r.seat + ".pid") or discard;
                let wrote = last_of(std::io::fs::read_file(r.log) or "", 1500);
                self.tell(r.seat, "down", "its server ended: " + last_line(wrote), "");
                continue;
            }
            let mut changed = false;
            if r.phase == "starting" && len(r.health) == 0 {
                // a follower's part: up while its server runs
                r.phase = "up";
                changed = true;
                self.tell_up(r);
            } else if r.phase == "starting" && healthy(r.health, r.key) {
                // its first answers checked before it is up: a server that
                // loaded a model may still read or write text wrong
                // (smoke.hl), and one that does is stopped, its seat down
                // with why
                let wrong = smoke_problem(r.server, r.port, r.key, r.model);
                if len(wrong) > 0 {
                    self.stop(r);
                    self.tell(r.seat, "down", wrong, "");
                    continue;
                }
                r.phase = "up";
                r.context = served_context(r.server, r.port, r.key);
                r.asked = 1;
                changed = true;
                self.tell_up(r);
            } else if r.phase == "up" && r.context == 0 && r.asked < CONTEXT_ASKS {
                // one that answered before it could say its context is
                // asked again, for a while
                r.context = served_context(r.server, r.port, r.key);
                r.asked = r.asked + 1;
                changed = true;
                if r.context > 0 { self.tell_up(r); }
            }
            if changed || kept < i - 1 { set(self.runs.items, kept, r) or discard; }
            kept = kept + 1;
        }
        truncate(self.runs.items, kept);
    }

    /// Why a seat's part across two nodes (`cluster`) is not started here,
    /// "" when it is: it runs vLLM's container, over a link this node
    /// declares to the other, beside no other part across nodes (its ranks
    /// meet on the host's network, at one port).
    fn part_refusal(server: String, artifact: String, cluster: String) -> String {
        if (server != "vllm" && server != "tensorfold")
            || std::json::find_string_field(artifact, "kind") != "container"
        {
            return "a model across two nodes runs vLLM's or TensorFold's container, and its runtime is neither";
        }
        let peer = std::json::find_string_field(cluster, "peer");
        let caps = with_sent_link(self.capabilities, std::json::find_field_raw(cluster, "link"));
        if len(link_env(caps, peer)) == 0
            || (server == "tensorfold" && len(lanes_env(caps, peer)) == 0)
        {
            return "this node has no link to " + peer + ", which its part across the two runs over";
        }
        for r in self.runs.items {
            if r.spans {
                return "this node runs " + r.seat
                    + " across two nodes already, and takes part in one at a time";
            }
        }
        return "";
    }

    /// A server stopped (`stop_run`).
    fn stop(r: Run) {
        stop_run(self.data, r);
    }

    /// What a node that stopped left running, stopped (`stop_left`).
    fn clean() {
        stop_left(self.id, self.data);
    }

    /// The variant's files, linked under the names the recipe gives them in
    /// `dir`; the first a server loads (a GGUF's first file) or "" when
    /// they could not be laid out.
    @unbounded
    fn lay_out(dir: String, variant: String) -> String {
        run_out("rm\n-rf\n" + dir);
        run_out("mkdir\n-p\n" + dir);
        let layout = variant_layout(variant);
        if len(link_files(self.data, dir, layout)) > 0 { return ""; }
        let mut first = "";
        let mut it = std::json::array_first(std::json::find_field_raw(variant, "files"));
        while !it.done {
            let path = std::json::find_string_field(it.element, "path");
            if len(first) == 0 && std::str::ends_with(path, ".gguf") { first = path; }
            it = std::json::array_next(it);
        }
        return if len(first) > 0 { first } else { "." };
    }

    /// A TensorFold seat's layout beside its weights (`models`, laid out):
    /// the model folder's readied files linked into it from `prepared`, and
    /// each file set a folder under `sets`; "" when all are there, else why.
    @unbounded
    fn lay_out_tensorfold(
        models: String,
        sets: String,
        prepared: String,
        variant: String,
        rank: Int
    ) -> String {
        let files = prepared_files(variant, rank);
        let v = std::str::bytes_view(files);
        let mut from = 0;
        while from < v.n {
            let nl = line_end(v, from);
            let path = tab_field(std::str::slice(v, from, nl), 0);
            from = nl + 1;
            if std::str::starts_with(path, "model/") {
                let name = path[6..len(path)];
                run_out("ln\n-sfn\n" + prepared + "/" + path + "\n" + models + "/" + name);
                if !std::io::fs::file_exists(models + "/" + name) {
                    return "its readied " + name + " is not in " + prepared;
                }
            }
        }
        run_out("rm\n-rf\n" + sets);
        let blobs = self.data + "/blobs";
        let mut it = std::json::array_first(std::json::find_field_raw(variant, "file_sets"));
        while !it.done {
            let name = std::json::find_string_field(it.element, "name");
            run_out("mkdir\n-p\n" + sets + "/" + name);
            let layout = set_layout(blobs, it.element);
            if len(layout) == 0 { return "its file set " + name + " is not held"; }
            let missing = link_files(self.data, sets + "/" + name, layout);
            if len(missing) > 0 {
                return "its file set " + name + "'s " + missing + " could not be laid out";
            }
            it = std::json::array_next(it);
        }
        return "";
    }

    /// An archive runtime unpacked, once, into `runtimes/<sha256>`.
    @unbounded
    fn unpacked(sha: String) -> String {
        return unpack_archive(self.data, sha);
    }

    /// A seat's server answers: where, and the context it took.
    fn tell_up(r: Run) {
        FetchUpdated <- FetchState {
            seat: r.seat,
            status: "up",
            reason: "",
            endpoint: r.endpoint,
            key: r.key,
            context: r.context,
            by_runner: true,
        };
    }

    fn tell(seat: String, status: String, reason: String, endpoint: String) {
        FetchUpdated <- FetchState {
            seat: seat,
            status: status,
            reason: reason,
            endpoint: endpoint,
            by_runner: true,
        };
    }
}

/// A variant's own files as its server reads them, `path\tsha256` a line.
@bounded_by(variant)
fn variant_layout(variant: String) -> String {
    let out = std::bytes::BytesBuilder { };
    let mut it = std::json::array_first(std::json::find_field_raw(variant, "files"));
    while !it.done {
        out.append_str(
            std::json::find_string_field(it.element, "path") + "\t"
                + std::json::find_string_field(it.element, "sha256")
                + "\n",
        );
        it = std::json::array_next(it);
    }
    return std::str::clone(out.text_view());
}

/// Each file of `layout` (`path\tsha256` a line) linked under `dir` to its
/// place in the store, in the folders its path names; "" when every one is
/// there, else the first path that is not.
@unbounded
fn link_files(data: String, dir: String, layout: String) -> String {
    let v = std::str::bytes_view(layout);
    let mut from = 0;
    while from < v.n {
        let nl = line_end(v, from);
        let line = std::str::slice(v, from, nl);
        from = nl + 1;
        if len(line) == 0 { continue; }
        let path = tab_field(line, 0);
        let slash = last_slash(path);
        if slash > 0 { run_out("mkdir\n-p\n" + dir + "/" + path[0..slash]); }
        run_out("ln\n-sfn\n" + data + "/blobs/" + tab_field(line, 1) + "\n" + dir + "/" + path);
        if !std::io::fs::file_exists(dir + "/" + path) { return path; }
    }
    return "";
}

/// An archive (`blobs/<sha256>`) unpacked, once, into `runtimes/<sha256>`:
/// an archive runtime, or the engine archive a container runs.
@unbounded
fn unpack_archive(data: String, sha: String) -> String {
    let dir = data + "/runtimes/" + sha;
    if std::io::fs::file_exists(dir) { return dir; }
    std::io::fs::mkdir(data + "/runtimes") or discard;
    let tmp = dir + ".part";
    run_out("rm\n-rf\n" + tmp);
    run_out("mkdir\n-p\n" + tmp);
    run_out("tar\nxzf\n" + data + "/blobs/" + sha + "\n-C\n" + tmp);
    std::io::fs::rename(tmp, dir) or discard;
    return dir;
}

/// The context a TensorFold seat serves a request: the model's own
/// (`context_length`), which its window holds with room for its other
/// streams (`TF_WINDOW`).
fn served_tokens_tensorfold(config: String) -> Int {
    let native = std::json::find_int_field(config, "context_length");
    return if native > 0 && native < TF_WINDOW { native } else { TF_WINDOW };
}

/// Why a runtime built for some GPUs (`RuntimeCreate.compute_capabilities`)
/// is not started on a node of `capabilities`, "" when it is: one of the
/// node's GPUs declares one of them. A runtime that names none runs on any.
@unbounded
fn compute_refusal(runtime: String, capabilities: String) -> String {
    let wanted = std::json::find_field_raw(runtime, "compute_capabilities");
    if std::json::array_first(wanted).done { return ""; }
    let mut have = "";
    let mut it = std::json::array_first(
        std::json::find_field_raw(
            std::json::find_field_raw(capabilities, "hardware"),
            "accelerators",
        ),
    );
    while !it.done {
        let cap = std::json::find_string_field(it.element, "compute_capability");
        if len(cap) > 0 {
            let mut w = std::json::array_first(wanted);
            while !w.done {
                if std::str::trim(w.element) == "\"" + cap + "\"" { return ""; }
                w = std::json::array_next(w);
            }
            have = if len(have) > 0 { have + ", " + cap } else { cap };
        }
        it = std::json::array_next(it);
    }
    let mut built = "";
    let mut w = std::json::array_first(wanted);
    while !w.done {
        let one = std::str::replace(std::str::trim(w.element), "\"", "");
        built = if len(built) > 0 { built + " or " + one } else { one };
        w = std::json::array_next(w);
    }
    return "its runtime's kernels are built for compute capability " + built
        + (
            if len(have) > 0 {
                ", and this node's GPU is " + have
            } else {
                ", and this node's GPU does not say its own"
            }
        );
}

/// What a seat's server takes beside what its placement reserved (its
/// weights and prompt cache): the process, its GPU context, its compute
/// buffers and activations; the api counts the same (placements.hl).
const SEAT_OVERHEAD_BYTES: Int = 2147483648;

/// What a seat holds of the memory for models once it runs: what was
/// reserved for it and its server's own.
fn footprint(reserved: Int) -> Int {
    return reserved + SEAT_OVERHEAD_BYTES;
}

/// Why a seat of `server` that holds `need` is not started on a node whose
/// running seats hold `held` of the `memory` it gives models (-1 for
/// unknown), its GPU giving a server `gpu` (0 for unknown); "" when it is
/// started. vLLM takes
/// nine tenths of the GPU's memory unless given a share of it, so with no
/// share to give it (the GPU's memory unknown) it is not started.
fn start_refusal(server: String, need: Int, held: Int, memory: Int, gpu: Int) -> String {
    let over = misfit(need, held, memory);
    if len(over) > 0 { return over; }
    if server == "vllm" && len(gpu_share(need, gpu)) == 0 {
        return "its GPU's memory is not known, so vLLM's share of it cannot be held to the seat's";
    }
    return "";
}

/// Why a seat that holds `need` is not started beside seats that hold
/// `held` on a node that gives models `memory` (-1 for unknown; 0 is none
/// at all, as an operator may say); "" when it fits. A node whose placements were made before it kept room for its
/// system may hold more than it can: the seats past it stay down, saying
/// so, and none is stopped for them.
fn misfit(need: Int, held: Int, memory: Int) -> String {
    if memory < 0 || held + need <= memory { return ""; }
    let free = if memory > held { memory - held } else { 0 };
    return "it does not fit: it needs " + gib(need) + ", and " + gib(free) + " of the "
        + gib(memory)
        + " this node gives models is free beside its other seats";
}

/// The share of a GPU's `gpu` bytes vLLM is given for a seat that holds
/// `need` (`footprint`): rounded up to a hundredth, from 0.01 to 0.90; ""
/// when the GPU's memory is not known. It is what the seat was counted at,
/// so it is never more than a hundredth of the GPU past it.
fn gpu_share(need: Int, gpu: Int) -> String {
    if gpu <= 0 { return ""; }
    let mut pct = (need * 100 + gpu - 1) / gpu;
    if pct < 1 { pct = 1; }
    if pct > 90 { pct = 90; }
    return if pct < 10 { "0.0" + to_string(pct) } else { "0." + to_string(pct) };
}

/// The path a server answers its health on: the decision server's `/healthz` (200
/// once its model is loaded), TensorFold's `/v1/models` (which it answers
/// once both ranks have joined and loaded), the others' `/health`.
fn health_path(server: String) -> String {
    if server == "tensorfold" { return "/v1/models"; }
    return if server == "decision" { "/healthz" } else { "/health" };
}

/// The program a server is (`RuntimeCreate.server`).
fn server_program(server: String) -> String {
    if server == "decision" { return "voice-decide"; }
    if server == "tensorfold" { return "tensorfold-native"; }
    return if server == "vllm" { "vllm" } else { "llama-server" };
}

/// The server program in an unpacked archive, "" for none. A decision
/// archive built before the decision server had its name (an operator's
/// runtime that migration 22 renamed from `jev-style`) holds its launcher
/// as `jev-style-serve`, which takes the same arguments.
fn archive_program(dir: String, server: String) -> String {
    let bin = find_program(dir, server_program(server));
    if len(bin) > 0 || server != "decision" { return bin; }
    return find_program(dir, "jev-style-serve");
}

/// A server's arguments, one a line: the model it serves (a GGUF's first
/// file, or the directory of a model of several), where it listens, the
/// catalog model it goes by, the requests it serves at once (`slots`, its
/// seat's concurrency, lib/concurrency), how it reads the weights (`load`,
/// the runtime's `load_format`; "" for the server's default), and what its
/// `variant` says vLLM must serve the weights with (`kv_cache_dtype`,
/// `reasoning_parser`, `tool_call_parser`).
fn server_args(
    server: String,
    dir: String,
    first: String,
    port: Int,
    host: String,
    name: String,
    share: String,
    tokens: Int,
    slots: Int,
    load: String,
    variant: String
) -> String {
    // the decision server: the placed weights (a release's files in
    // its own layout) and where it listens; the launcher in the runtime's
    // archive pairs them with the runtime file it pins
    if server == "decision" {
        return "--weights\n" + dir + "\n--host\n" + host + "\n--port\n" + to_string(port);
    }
    if server == "vllm" {
        // vLLM takes the share of the GPU's memory it is given, all of it
        // but a tenth by default: on a machine that shares its memory
        // with the GPU, that would starve the machine. Within the share,
        // the context it serves is fitted to what is left after the
        // weights (`auto`), not the model's whole context, whose cache
        // alone may not fit the share
        return "vllm\nserve\n" + dir + "\n--host\n" + host + "\n--port\n" + to_string(port)
            + "\n--served-model-name\n" + name
        // the sequences it batches at once, the seat's concurrency: its
        // cache is paged, so a sequence holds only what its tokens fill
            + "\n--max-num-seqs\n" + to_string(if slots >= 1 { slots } else { 1 })
        // the prompt its prefix cache held (on by default), counted in each
        // answer's usage (`prompt_tokens_details.cached_tokens`), which vLLM
        // leaves out unless asked
            + "\n--enable-prompt-tokens-details"
            + (
                if len(share) > 0 {
                    "\n--gpu-memory-utilization\n" + share + "\n--max-model-len\nauto"
                } else {
                    ""
                }
            )
        // the loader its image ships, read straight to the GPU, where
        // vLLM's default maps the files and reads them a page at a time
            + (if len(load) > 0 { "\n--load-format\n" + load } else { "" })
        // the cache the weights must be served from, the parser that
        // takes the model's thinking out of its answer, and the one that
        // reads its tool calls, when the variant says
            + vllm_flag("--kv-cache-dtype", kv_cache_dtype(variant))
            + vllm_flag("--reasoning-parser", reasoning_parser(variant))
            + tool_flags(tool_call_parser(variant));
    }
    // llama-server keeps one prompt cache of `tokens` (served_tokens): left
    // to itself it would size it for the model's whole context. Its slots,
    // the seat's concurrency, are given (`--parallel`), so it divides the
    // cache among them, and each holds at least the context the placement
    // promises a request (lib/concurrency `llama_slots`)
    return "-m\n" + first + "\n--host\n" + host + "\n--port\n" + to_string(port) + "\n--alias\n"
        + name + "\n-c\n" + to_string(tokens) + "\n--parallel\n"
        + to_string(if slots >= 1 { slots } else { 1 });
}

/// How a runtime's server reads the weights, as its runtime says
/// (`RuntimeCreate.load_format`): `fastsafetensors` for a vLLM runtime whose
/// image ships it, "" otherwise, so a runtime that does not say, or a server
/// that has no such loader, starts as it always did.
fn load_format(runtime: String) -> String {
    if std::json::find_string_field(runtime, "server") != "vllm" { return ""; }
    let load = std::json::find_string_field(runtime, "load_format");
    return if load == "fastsafetensors" { load } else { "" };
}

/// The KV cache dtype a seat's server keeps, as its variant says
/// (`RecipeVariant.kv_cache_dtype`): `fp8`, which vLLM serves DeepSeek-V4's
/// fp8 weights from and no other cache; "" otherwise, so a variant that
/// does not say keeps its server's default, and no other value reaches a
/// server's arguments. llama-server is never given it (`server_args`).
fn kv_cache_dtype(variant: String) -> String {
    let dtype = std::json::find_string_field(variant, "kv_cache_dtype");
    return if dtype == "fp8" { dtype } else { "" };
}

/// The parser vLLM takes a model's thinking out of its answer with, as the
/// seat's variant says (`RecipeVariant.reasoning_parser`): `deepseek_v4`,
/// or `deepseek_r1` for DeepSeek-R1's distills; "" otherwise, so a variant
/// that does not say keeps vLLM's default, and no other value reaches a
/// server's arguments. llama-server is never given it.
fn reasoning_parser(variant: String) -> String {
    let parser = std::json::find_string_field(variant, "reasoning_parser");
    return if parser == "deepseek_v4" || parser == "deepseek_r1" { parser } else { "" };
}

/// The class a seat's tokenizer is loaded as, as its variant says
/// (`RecipeVariant.tokenizer_class`): `PreTrainedTokenizerFast`,
/// transformers' generic fast tokenizer, which reads the variant's
/// tokenizer.json as it is; "" otherwise, so a variant that does not say
/// is laid out as it was pinned, and no other value reaches a file.
fn tokenizer_class(variant: String) -> String {
    let class = std::json::find_string_field(variant, "tokenizer_class");
    return if class == "PreTrainedTokenizerFast" { class } else { "" };
}

/// A seat's tokenizer laid out as its variant says it must be loaded
/// (`tokenizer_class`), in `dir`, where its files are laid out: its
/// tokenizer_config.json, a link into the store, replaced by a file of its
/// own, the pinned file with that class (`with_tokenizer_class`). The file
/// in the store is never written: the link is removed, not followed. ""
/// when it is laid out, or the variant names no class; else why not.
@unbounded
fn lay_out_tokenizer(dir: String, variant: String) -> String {
    let class = tokenizer_class(variant);
    if len(class) == 0 { return ""; }
    let path = dir + "/tokenizer_config.json";
    let pinned = std::io::fs::read_file(path) or {
        return "its tokenizer_config.json, whose tokenizer_class its variant sets, is not laid out under "
            + dir;
    };
    let text = with_tokenizer_class(pinned, class);
    if len(text) == 0 { return "its tokenizer_config.json is not a JSON object"; }
    std::io::fs::unlink(path) or {
        return "its tokenizer_config.json could not be replaced under " + dir;
    };
    std::io::fs::write_file(path, text) or {
        return "its tokenizer_config.json could not be written under " + dir;
    };
    return "";
}

/// A tokenizer_config.json (`config`) with its `tokenizer_class` set to
/// `class`: every other member as it was, in its place, and the class where
/// the file named one, else last. "" when `config` is not a JSON object.
@bounded_by(config)
fn with_tokenizer_class(config: String, class: String) -> String {
    let c = std::str::trim(config);
    if !std::json::valid_object(c) { return ""; }
    let out = std::bytes::BytesBuilder { };
    let mut set = false;
    let mut first = true;
    let mut it = std::json::object_first(c);
    while !it.done {
        if !first { out.append_str(",\n  "); }
        first = false;
        if std::json::obj_key_eq(it, c, "tokenizer_class") {
            out.append_str("\"tokenizer_class\": " + q(class));
            set = true;
        } else {
            out.append_str(
                q(std::json::obj_key_string(it, c)) + ": "
                    + std::str::trim(std::json::obj_value_raw(it, c)),
            );
        }
        it = std::json::object_next(it, c);
    }
    if !set {
        if !first { out.append_str(",\n  "); }
        out.append_str("\"tokenizer_class\": " + q(class));
    }
    return "{\n  " + std::str::clone(out.text_view()) + "\n}\n";
}

/// The parser vLLM reads a model's tool calls out of its answer with, as
/// the seat's variant says (`RecipeVariant.tool_call_parser`): one of the
/// names vLLM v0.29.0 registers that voice's recipes use; "" otherwise, so
/// a variant that does not say is started without one (and its seat
/// carries no `tools`, capabilities.hl `seat_carries_tools`), and no other
/// value reaches a server's arguments. llama-server is never given it.
fn tool_call_parser(variant: String) -> String {
    let parser = std::json::find_string_field(variant, "tool_call_parser");
    let known = parser == "deepseek_v4"
        || parser == "openai"
        || parser == "glm47"
        || parser == "qwen3_coder"
        || parser == "granite4"
        || parser == "hermes";
    return if known { parser } else { "" };
}

/// vLLM's flags for a tool-call parser: the model may call a tool when it
/// judges one is needed (`--enable-auto-tool-choice`, which vLLM requires
/// for `tool_choice: auto`), its calls read with `parser`; "" for none.
fn tool_flags(parser: String) -> String {
    return if len(parser) > 0 {
        "\n--enable-auto-tool-choice" + vllm_flag("--tool-call-parser", parser)
    } else {
        ""
    };
}

/// `\n<flag>\n<value>`, or "" when there is no value.
fn vllm_flag(flag: String, value: String) -> String {
    return if len(value) > 0 { "\n" + flag + "\n" + value } else { "" };
}

/// The prompt cache, in tokens, a llama-server seat keeps, divided among
/// its slots: what its placement sized (`cache_tokens`), or, placed before
/// voice sized it, the context a placement promises a request
/// (lib/concurrency `promised_context`: 32768, less for a model made for
/// less), in one slot.
fn served_tokens(config: String) -> Int {
    return concurrency::llama_cache(
        std::json::find_int_field(config, "cache_tokens"),
        std::json::find_int_field(config, "context_length"),
    );
}

/// The context, in tokens, a server that answers took: llama-server's
/// `n_ctx` (`/props`), vLLM's and TensorFold's `max_model_len`
/// (`/v1/models`); 0 when it does not say. Asked with its `key`.
fn served_context(server: String, port: Int, key: String) -> Int {
    let base = "http://127.0.0.1:" + to_string(port);
    if server == "vllm" || server == "tensorfold" {
        let r = keyed_get(base + "/v1/models", key) or { return 0; };
        if r.status != 200 { return 0; }
        let first = std::json::array_first(
            std::json::find_field_raw(std::str::from_bytes(r.body), "data"),
        );
        if first.done { return 0; }
        return std::json::find_int_field(first.element, "max_model_len");
    }
    let r = keyed_get(base + "/props", key) or { return 0; };
    if r.status != 200 { return 0; }
    let body = std::str::from_bytes(r.body);
    let settings = std::json::find_field_raw(body, "default_generation_settings");
    let n = std::json::find_int_field(settings, "n_ctx");
    return if n > 0 { n } else { std::json::find_int_field(body, "n_ctx") };
}

/// How many turns (half a second each) a server that answered is asked for
/// its context before the seat goes without one.
const CONTEXT_ASKS: Int = 20;

/// `docker run` for a container runtime: its port on loopback only, the
/// weights and the store they link into mounted read-only at the paths the
/// links name, its accelerator's devices (`gpu_args`), and its key, by
/// name (`key`, `-e` and the variable `key_env` names).
fn container_argv(
    name: String,
    owner: String,
    port: Int,
    models: String,
    blobs: String,
    gpu: String,
    key: String,
    cache: String,
    image: String,
    args: String
) -> String {
    // `--init`: the container's first process passes a stop signal on to
    // the server rather than holding it, as a server run as PID 1 may
    return "docker\nrun\n--rm\n--init\n--name\n" + name + "\n--label\n" + OWNER_LABEL + "=" + owner
        + "\n-p\n127.0.0.1:" + to_string(port)
        + ":8080\n-v\n" + models
        + ":/models:ro\n-v\n" + blobs + ":" + blobs + ":ro\n"
    // offline: a server reads the weights it was given and nothing from
    // the hub; and room in shared memory, which vLLM's workers need
        + "-e\nHF_HUB_OFFLINE=1\n-e\nTRANSFORMERS_OFFLINE=1\n--shm-size\n8g\n"
        + gpu
        + key
        + cache
        + image + "\n" + args;
}

/// The caches a vLLM server fills as it starts, kept between its starts so
/// a seat started again skips that work: its compiled graphs
/// (`torch.compile`, under `vllm/`) and FlashInfer's kernel autotune (under
/// `flashinfer/`), which were most of a restart's time. They are the node's
/// own, under its data directory (`cache/<runtime>/`), one directory per
/// runtime, so a server of another version never reads them; vLLM keys its
/// compile cache by the model and its settings, and FlashInfer its autotune
/// by version and GPU, so seats of one runtime share them safely. Only those
/// two are mounted: the rest of the image's `/root/.cache` (a tokenizer's
/// files, which a model needs offline) stays the image's. A tens-of-megabytes
/// store, removed with the node's data. "" for any other server.
fn server_cache_args(server: String, data: String, runtime_id: String) -> String {
    if server != "vllm" || len(runtime_id) == 0 { return ""; }
    let root = data + "/cache/" + runtime_id;
    std::io::fs::mkdir(data + "/cache") or discard;
    std::io::fs::mkdir(root) or discard;
    std::io::fs::mkdir(root + "/vllm") or discard;
    std::io::fs::mkdir(root + "/flashinfer") or discard;
    return "-v\n" + root + "/vllm:/root/.cache/vllm\n-v\n" + root
        + "/flashinfer:/root/.cache/flashinfer\n";
}

/// What `docker run` needs to hand a container its runtime's accelerator,
/// one argument a line: every NVIDIA GPU for CUDA; ROCm's compute device and
/// the render devices for ROCm, the render devices for Vulkan, each with the
/// groups that own them on this machine (their ids differ between machines).
fn gpu_args(accelerator: String) -> String {
    if accelerator == "cuda" { return "--gpus\nall\n"; }
    if accelerator != "rocm" && accelerator != "vulkan" { return ""; }
    let render = std::str::trim(
        run_out("sh\n-c\nstat -c %g /dev/dri/renderD* 2>/dev/null | head -n 1"),
    );
    let mut out = "--device\n/dev/dri\n";
    if accelerator == "rocm" {
        out = out + "--device\n/dev/kfd\n";
        let kfd = std::str::trim(run_out("stat\n-c\n%g\n/dev/kfd"));
        if len(kfd) > 0 && kfd != render { out = out + "--group-add\n" + kfd + "\n"; }
    }
    if len(render) > 0 { out = out + "--group-add\n" + render + "\n"; }
    return out;
}

/// macOS's sandbox for an archive runtime: it writes only `dir` and the
/// system's temporary folders, and reaches and listens on loopback only.
fn sandbox_profile(dir: String) -> String {
    return "(version 1)(allow default)(deny file-write* (subpath \"/\"))(allow file-write* (subpath \""
        + dir + "\") (literal \"/dev/null\") (regex #\"^/private/var/folders/\"))"
        + "(deny network-outbound)(allow network-outbound (remote ip \"localhost:*\"))"
        + "(deny network-bind)(allow network-bind (local ip \"localhost:*\"))";
}

/// `program` at the top of `dir` or one directory down, "" for none.
@bounded_by(dir)
fn find_program(dir: String, program: String) -> String {
    if std::io::fs::file_exists(dir + "/" + program) { return dir + "/" + program; }
    let n = std::io::fs::list_dir_count(dir) or 0;
    let mut i = 0;
    while i < n {
        let sub = dir + "/" + (std::io::fs::list_dir_at(dir, i) or "");
        i = i + 1;
        if std::io::fs::file_exists(sub + "/" + program) { return sub + "/" + program; }
    }
    return "";
}

/// What a managed seat's config has its server serve, as one text: its
/// runtime (the server, the accelerator, the artifact it is pinned to), its
/// variant (the files and what they are), and what its server is started
/// with (the model it goes by, the context and cache it takes, the memory
/// reserved for it, its part across two nodes). Two configs with the same are served by the same
/// server; anything else in a config (its placement's id, a field voice
/// adds later) never restarts one.
@unbounded
fn serving_identity(config: String) -> String {
    let b = std::bytes::BytesBuilder { };
    for key in [
        "runtime",
        "variant",
        "model",
        "context_length",
        "cache_tokens",
        "reserved_bytes",
        "cluster",
    ] {
        b.append_str(key);
        b.append_str("=");
        b.append_str(std::str::trim(std::json::find_field_raw(config, key)));
        b.append_str("\n");
    }
    return std::str::clone(b.text_view());
}

/// What a running seat does when it is asked for with `config`: "keep" it
/// serving when it serves the same (`serving_identity`), else "replace" it.
fn wanted_action(identity: String, config: String) -> String {
    return if identity == serving_identity(config) { "keep" } else { "replace" };
}

/// A queue of seats (a line each: the seat, a tab, its config) without
/// `seat`'s line.
@unbounded
fn queue_without(queue: String, seat: String) -> String {
    let out = std::bytes::BytesBuilder { };
    let v = std::str::bytes_view(queue);
    let mut at_ = 0;
    while at_ < v.n {
        let nl = line_end(v, at_);
        let line = std::str::slice(v, at_, nl);
        at_ = nl + 1;
        let tab = std::str::index_of(line, "\t");
        if tab > 0 && line[0..tab] != seat {
            out.append_str(line);
            out.append_str("\n");
        }
    }
    return std::str::clone(out.text_view());
}

/// A server stopped, all of it: its container removed, or its process
/// ended (`end_process`) and its pid file gone. It returns once the server
/// holds nothing, so what replaces it never runs beside it.
@unbounded
fn stop_run(data: String, r: Run) {
    if len(r.container) > 0 {
        run_out("docker\nrm\n-f\n" + r.container);
    } else {
        if r.pid > 0 { end_process(r.pid); }
        std::io::fs::unlink(data + "/run/" + r.seat + ".pid") or discard;
    }
}

/// A process ended: asked to stop (TERM), then, if it is still there after
/// five seconds, killed: a server that holds the signal never holds up its
/// node's stop for the service manager's whole timeout. Called once for
/// each of a node's pid files, its wait at most fifty looks.
@unbounded
fn end_process(pid: Int) {
    run_out("kill\n" + to_string(pid));
    let mut i = 0;
    while i < 50 && alive(pid) {
        std::time::sleep(100ms);
        i = i + 1;
    }
    if alive(pid) { run_out("kill\n-9\n" + to_string(pid)); }
}

/// When process `pid` began, as `ps` says it; "" for none. Called once
/// for each of a node's pid files, at most one a seat.
@unbounded
fn started_at(pid: Int) -> String {
    return std::str::trim(run_out("ps\n-o\nlstart=\n-p\n" + to_string(pid)));
}

/// True while process `pid` runs: there, and not a zombie left to reap.
/// Looked at once a server each turn, and at most fifty times a process
/// ending.
@unbounded
fn alive(pid: Int) -> Bool {
    let state = std::str::trim(run_out("ps\n-o\nstat=\n-p\n" + to_string(pid)));
    return len(state) > 0 && !std::str::starts_with(state, "Z");
}

/// The servers a node started, stopped: its containers by the label that
/// names it, its processes by the pids it wrote (each only if it is the
/// process it started). Run when the node starts, for what a node that
/// stopped left running, as the node drains (`Node.drain`), and once
/// its service has stopped (`voice-node stop-seats`, the unit's
/// `ExecStopPost`), so nothing of its is left in the service's group.
@unbounded
fn stop_left(id: String, data: String) {
    let names = run_out("docker\nps\n-aq\n--filter\nlabel=" + OWNER_LABEL + "=" + id);
    let v = std::str::bytes_view(names);
    let mut start = 0;
    while start < v.n {
        let nl = line_end(v, start);
        let c = std::str::trim(std::str::slice(v, start, nl));
        start = nl + 1;
        if len(c) > 0 { run_out("docker\nrm\n-f\n" + c); }
    }
    // the pid files' names first, then each: one removed would move the
    // others' places in the directory
    let dir = data + "/run";
    let n = std::io::fs::list_dir_count(dir) or 0;
    let found = std::bytes::BytesBuilder { };
    let mut i = 0;
    while i < n {
        let name = std::io::fs::list_dir_at(dir, i) or "";
        i = i + 1;
        if std::str::ends_with(name, ".pid") {
            found.append_str(name);
            found.append_str("\n");
        }
    }
    let names_v = std::str::clone(found.text_view());
    let it = std::iter::Lines { };
    let mut from = 0;
    while from >= 0 {
        let name = it.line_at(names_v, from);
        from = it.next_idx(names_v, from);
        if len(name) > 0 {
            let line = std::str::trim(std::io::fs::read_file(dir + "/" + name) or "");
            let tab = std::str::index_of(line, "\t");
            if tab > 0 {
                let pid = line[0..tab];
                let began = line[(tab + 1)..len(line)];
                // only the process this node started: the same pid, begun when it was
                let p = std::str::parse_int(pid) or 0;
                if p > 0 && len(began) > 0 && started_at(p) == began {
                    end_process(p);
                }
            }
            std::io::fs::unlink(dir + "/" + name) or discard;
        }
    }
}

/// A server's command (`argv`, one argument a line) started apart from the
/// node, in `data`, its output to `log`: sh starts it in the background and
/// says its pid, the command handed to sh as its arguments, never as text
/// it reads. Its `key` is in the environment sh starts it with, as the
/// variable `server` reads (`key_env`; a container's docker hands it on),
/// never among its arguments. Its pid, 0 when it could not be started.
@unbounded
fn launch(data: String, log: String, argv: String, server: String, key: String) -> Int {
    let started = std::process::run_with(
        "sh\n-c\n\"$@\" > \"$0\" 2>&1 & echo $!\n" + log + "\n" + argv,
        std::process::SpawnOptions { cwd: data, env: key_env(server) + "=" + key },
    ) or std::process::ProcessOutput { code: 1, signal: 0, stdout: "", stderr: "" };
    let pid = std::str::parse_int(std::str::trim(started.stdout)) or 0;
    return if started.code == 0 { pid } else { 0 };
}

/// True when a server's health check answers 200, asked with its `key`.
fn healthy(url: String, key: String) -> Bool {
    let r = keyed_get(url, key) or { return false; };
    return r.status == 200;
}

/// A GET of `url` on a seat's server, presenting its `key`.
fn keyed_get(url: String, key: String) -> std::http::ClientResponse fallible(std::http::HttpError) {
    let parsed = std::http::parse_url(url) or raise;
    return std::http::request(
        std::http::ClientRequest {
            method: "GET",
            url: parsed,
            headers: engine_auth(key),
            body: b"",
        },
    ) or raise;
}

/// A seat server's key: 32 random bytes from the kernel, in hex; "" when
/// the kernel gives none.
@unbounded
fn engine_key() -> String {
    let b = std::os::getrandom(32) or { return ""; };
    return std::hex::encode(b);
}

/// The environment variable a server reads its key from, which it then
/// requires of every request but its health check: llama-server's
/// `LLAMA_API_KEY`, vLLM's `VLLM_API_KEY` (which it requires of its `/v1`
/// routes), TensorFold's `TENSORFOLD_API_KEY`, and the decision server's
/// `VOICE_DECIDE_API_KEY` (decide/, and the MLX build's launcher).
fn key_env(server: String) -> String {
    if server == "vllm" { return "VLLM_API_KEY"; }
    if server == "tensorfold" { return "TENSORFOLD_API_KEY"; }
    if server == "decision" { return "VOICE_DECIDE_API_KEY"; }
    return "LLAMA_API_KEY";
}

/// The header a call to a seat's server presents its `key` in, "" for no
/// key.
fn engine_auth(key: String) -> String {
    return if len(key) > 0 { "Authorization: Bearer " + key } else { "" };
}

/// A port on loopback no one listens on, from `from`; -1 for none.
fn free_port(from: Int) -> Int {
    let mut port = from;
    while port < from + 200 {
        let fd = std::io::tcp::__listen_socket("127.0.0.1", port);
        if fd >= 0 {
            std::io::tcp::__close_fd(fd);
            return port;
        }
        port = port + 1;
    }
    return -1;
}

/// The last `n` bytes of `s`.
fn last_of(s: String, n: Int) -> String {
    return if len(s) > n { s[(len(s) - n)..len(s)] } else { s };
}

/// The last line of `s` that says something.
@bounded_by(s)
fn last_line(s: String) -> String {
    let t = std::str::trim(s);
    let mut i = len(t) - 1;
    while i > 0 {
        if t[i..(i + 1)] == "\n" { return t[(i + 1)..len(t)]; }
        i = i - 1;
    }
    return t;
}

/// The place of the last `/` in `path`, -1 for none.
@bounded_by(path)
fn last_slash(path: String) -> Int {
    let mut i = len(path) - 1;
    while i >= 0 {
        if path[i..(i + 1)] == "/" { return i; }
        i = i - 1;
    }
    return -1;
}
