// The admin event stream, `GET /admin/v1/events` (spec/openapi.yaml,
// `AdminEvent`): what happens, to a subscriber that follows it. A
// subscriber that connects with no place sees only what follows; one that
// reconnects with `Last-Event-ID` is told everything past that place, from
// the rows (nothing is held by the api between connections).
//
// Every event is read from a row the store holds, so it comes from the
// place it happened and from any api instance alike: a request served is
// its ledger row (`usage`, the whole record), a key, project, account,
// model, node or seat changed is its change row (`change`), and a node
// registered, lost, drained or revoked is its status moving (`node`, the
// node as `GET /admin/v1/nodes` lists it), and a request
// annotated is its annotation kept (`annotation`: its answers, its runs,
// and the conversation's title when it wrote one). A place is the marks
// of those rows: the last ledger row, change and annotation told, and each
// node's status. A stream is held open, looking at the rows again every
// `FOLLOW_EVERY`. The same looks feed the api's hub (`AdminFeed`, hub.hl):
// each event on its topic, for the admin UI.

/// How often a held stream, and the hub's feed, look at the rows.
const FOLLOW_EVERY: Duration = 500ms;

/// What a node reported that a view shows, past its overall status: its
/// seats as they stand (each one's state, reason and fetch), what it
/// declared and which assignment it applied. Its heartbeat time and load,
/// which move with every beat, are left out, so a node is told when what it
/// reported changed, through whichever api instance it reported.
fn node_shape(n: NodeRead) -> String {
    let mut q = n;
    q.has_last_heartbeat_at = false;
    q.last_heartbeat_at = `1970-01-01T00:00:00Z`;
    q.in_flight = 0;
    return node_json(q);
}

/// The `type`s a subscriber may ask for.
const EVENT_TYPES: String = "node usage change request annotation annotation_step";

/// A node's place in the stream: its id and what it reported (`node_shape`),
/// as a number. The nodes' marks are numbers so that a subscriber holds no
/// text between looks.
fn node_mark(id: String, status: String) -> Int {
    let v = std::str::bytes_view(id + "=" + status);
    let mut h = 7;
    let mut i = 0;
    while i < v.n {
        h = (h * 31 + std::str::byte_at(v, i)) % 1000000007;
        i = i + 1;
    }
    return h;
}

/// One look at the rows, for one subscriber: what is past its marks is
/// told to `out`, and the marks move on. A locus of its own so that what
/// a look allocates is reclaimed when it ends, not held for as long as the
/// subscriber stays.
locus EventTick {
    params {
        store: st::Store;
        nodes: Nodes;
        types: st::Names = st::Names { };
        out: EventStream;
        // look only to take the marks (the head of the stream), telling nothing
        quiet: Bool = false;
        usage_mark: Int = 0;
        change_mark: Int = 0;
        // the last annotation told; -1 not known (a place from before
        // annotations were told), taken at the head without telling
        annotation_mark: Int = 0;
        // the last annotation step told; -1 not known (a place from before
        // steps were told), taken at the head without telling
        step_mark: Int = 0;
        // the last request in flight told (not in the stream's place: one
        // that resumes is told what is in flight then)
        flight_mark: Int = 0;
        node_marks: NodeMarks = NodeMarks { };
        // publish each event to its hub topic (hub.hl) instead of telling
        // `out` (`AdminFeed`), the requests in flight told whole, as a set
        feed: Bool = false;
        // the set of requests in flight last told (their seqs), in a feed
        flight_set: String = "";
        // why the rows could not be read, "" when they were: its owner says
        failure: String = "";
    }

    bus {
        publish UsageRecorded;
        publish ChangeMade;
        publish AnnotationKept;
        publish AnnotationStepTaken;
        publish NodeMoved;
        publish RequestsInFlight;
    }

    birth() {
        self.look() or { self.failure = CtlError::api_encode(err); };
    }

    /// True when the subscriber wants events of type `t`.
    fn wants(t: String) -> Bool {
        let asked = self.types.items;
        if count(asked) == 0 { return true; }
        for w in asked {
            if w == t { return true; }
        }
        return false;
    }

    fn look() fallible(CtlError) {
        if self.quiet {
            let u = self.store.usage_rows(st::UsageQuery { limit: 1 }) or fail store_down(err);
            self.usage_mark = (at(u.rows, 0) or st::UsageRow { }).seq;
            let c = self.store.changes(
                st::ChangeQuery { limit: 1, bodies: false },
            ) or fail store_down(err);
            self.change_mark = (at(c.rows, 0) or st::ChangeRow { }).seq;
            self.annotation_head() or raise;
            self.step_head() or raise;
            let mut f = self.store.flights_after(self.flight_mark, 100) or fail store_down(err);
            while count(f.rows) > 0 {
                self.flight_mark = (at(f.rows, count(f.rows) - 1) or st::FlightRow { }).seq;
                f = self.store.flights_after(self.flight_mark, 100) or fail store_down(err);
            }
        } else {
            if self.wants("usage") {
                let rows = self.store.usage_after(self.usage_mark, 100) or fail store_down(err);
                for r in rows.rows {
                    self.usage_mark = r.seq;
                    self.tell("usage", "usage_" + to_string(r.seq), r.created_at, r.record);
                }
            }
            if self.annotation_mark < 0 { self.annotation_head() or raise; }
            if self.wants("annotation") {
                let rows = self.store.annotations_after(
                    self.annotation_mark,
                    100,
                ) or fail store_down(err);
                for r in rows.rows {
                    self.annotation_mark = r.seq;
                    let answers = self.store.answers(r.request_id) or fail store_down(err);
                    self.tell(
                        "annotation",
                        "annotation_" + to_string(r.seq),
                        r.created_at,
                        annotation_event_json(r, answers),
                    );
                }
            }
            if self.step_mark < 0 { self.step_head() or raise; }
            if self.wants("annotation_step") {
                let rows = self.store.annotation_steps_after(
                    self.step_mark,
                    200,
                ) or fail store_down(err);
                for r in rows.rows {
                    self.step_mark = r.seq;
                    self.tell(
                        "annotation_step",
                        "step_" + to_string(r.seq),
                        r.at,
                        AnnotationStep::api_encode(step_view(r)),
                    );
                }
            }
            // a request offered to a seat, for as long as it runs: a live
            // view lights it until its usage is told
            if self.feed {
                self.flights_whole() or raise;
            } else if self.wants("request") {
                let rows = self.store.flights_after(self.flight_mark, 100) or fail store_down(err);
                for f in rows.rows {
                    self.flight_mark = f.seq;
                    self.tell(
                        "request",
                        "request_" + to_string(f.seq),
                        f.started_at,
                        flight_json(f),
                    );
                }
            }
            if self.wants("change") {
                // the changes past the place, oldest first: nothing read
                // when nothing changed, and at most `CHANGES_A_LOOK`, a
                // page at a time; one further behind is told the rest on
                // the looks that follow
                let mut pages = 0;
                let mut full = true;
                while full && pages < CHANGES_A_LOOK / CHANGE_PAGE {
                    let rows = self.store.changes_after(
                        self.change_mark,
                        CHANGE_PAGE,
                    ) or fail store_down(err);
                    for c in rows.rows {
                        self.change_mark = c.seq;
                        self.tell(
                            "change",
                            "change_" + to_string(c.seq),
                            c.at,
                            change_json(change_read_of(c)),
                        );
                    }
                    full = count(rows.rows) == CHANGE_PAGE;
                    pages = pages + 1;
                }
            }
        }
        let l = self.nodes.list_read() or raise;
        let mut fresh = NodeMarks { };
        for n in l.data {
            let m = node_mark(n.id, node_state_name(n.status) + "|" + node_shape(n));
            push(fresh.items, m) or discard;
            if !self.quiet && self.wants("node") && !has_mark(self.node_marks, m) {
                // told as `listNodes` lists it, its seats without their configs
                self.tell(
                    "node",
                    "node_" + to_string(std::time::monotonic_ns()),
                    now_seconds(),
                    node_summary_json(n) or raise,
                );
            }
        }
        self.node_marks = fresh;
    }

    /// The newest annotation's place, told nothing of what came before.
    fn annotation_head() fallible(CtlError) {
        let mut mark = if self.annotation_mark < 0 { 0 } else { self.annotation_mark };
        let mut rows = self.store.annotations_after(mark, 200) or fail store_down(err);
        while count(rows.rows) > 0 {
            mark = (at(rows.rows, count(rows.rows) - 1) or st::AnnotationRow { }).seq;
            rows = self.store.annotations_after(mark, 200) or fail store_down(err);
        }
        self.annotation_mark = mark;
    }

    /// The newest annotation step's place, told nothing of what came before.
    fn step_head() fallible(CtlError) {
        let mut mark = if self.step_mark < 0 { 0 } else { self.step_mark };
        let mut rows = self.store.annotation_steps_after(mark, 200) or fail store_down(err);
        while count(rows.rows) > 0 {
            mark = (at(rows.rows, count(rows.rows) - 1) or st::StepRow { }).seq;
            rows = self.store.annotation_steps_after(mark, 200) or fail store_down(err);
        }
        self.step_mark = mark;
    }

    /// The requests in flight, told whole to the hub when the set is not
    /// the one last told: at most `FLIGHTS_TOLD`, `whole` false past them.
    fn flights_whole() fallible(CtlError) {
        let rows = self.store.flights_after(0, FLIGHTS_TOLD + 1) or fail store_down(err);
        let set = std::bytes::BytesBuilder { };
        let data = st::JsonList { };
        let mut n = 0;
        for f in rows.rows {
            set.append_str(to_string(f.seq) + ",");
            n = n + 1;
            if n <= FLIGHTS_TOLD { data.add(flight_json(f)); }
        }
        let now = std::str::clone(set.text_view());
        if now == self.flight_set { return; }
        self.flight_set = now;
        self.publish(
            "requests",
            AdminRecord {
                id: "requests_" + to_string(std::time::monotonic_ns()),
                at: now_seconds(),
                data: "[" + data.text() + "]",
                whole: n <= FLIGHTS_TOLD,
            },
        );
    }

    /// One event on the stream, or on its hub topic in a feed.
    fn tell(t: String, id: String, when: Time, data: String) {
        if self.feed {
            self.publish(t, AdminRecord { id: id, at: when, data: data });
            return;
        }
        self.out.send_with(
            t,
            id,
            "{\"id\": " + jq(id) + ", \"at\": " + jtime(when) + ", \"type\": " + jq(t)
                + ", \"data\": " + data + "}",
        );
    }

    /// `r` on the topic of events of type `t`: its `data` as it is, or
    /// `null` with `whole` false when it would not fit one bus frame.
    fn publish(t: String, r: AdminRecord) {
        let rec = if len(r.data) > FRAME_DATA_MAX {
            AdminRecord { id: r.id, at: r.at, data: "null", whole: false }
        } else {
            r
        };
        if t == "usage" {
            UsageRecorded <- rec;
        } else if t == "change" {
            ChangeMade <- rec;
        } else if t == "annotation" {
            AnnotationKept <- rec;
        } else if t == "annotation_step" {
            AnnotationStepTaken <- rec;
        } else if t == "node" {
            NodeMoved <- rec;
        } else if t == "requests" {
            RequestsInFlight <- rec;
        }
    }
}

/// The changes a look reads at a time, oldest first, past its place.
const CHANGE_PAGE: Int = 100;
/// The most changes one look tells: a subscriber further behind is told
/// the rest on the looks that follow.
const CHANGES_A_LOOK: Int = 1000;

/// The most requests in flight a hub event tells: one fewer than a read of
/// them returns (the store's 100), so a full read says there may be more.
const FLIGHTS_TOLD: Int = 99;
/// The most `data` one hub event carries: a bus frame is 64 KiB, its
/// header and the record's other fields included.
const FRAME_DATA_MAX: Int = 60000;

/// The nodes' marks, as many as the store holds nodes.
type NodeMarks { items: bounded[Int; 64]; }

fn has_mark(marks: NodeMarks, m: Int) -> Bool {
    for x in marks.items {
        if x == m { return true; }
    }
    return false;
}

/// One subscriber's place in the stream.
locus AdminEvents {
    params {
        store: st::Store;
        nodes: Nodes;
        // the `type`s asked for; none means all
        types: st::Names = st::Names { };
        // the last ledger row, change and annotation told, and each node's place
        usage_mark: Int = 0;
        change_mark: Int = 0;
        annotation_mark: Int = 0;
        step_mark: Int = 0;
        flight_mark: Int = 0;
        node_marks: NodeMarks = NodeMarks { };
    }

    /// One look, quiet or telling `out`; the marks move on.
    fn look(out: EventStream, quiet: Bool) {
        let t = EventTick {
            store: self.store,
            nodes: self.nodes,
            types: self.types,
            out: out,
            quiet: quiet,
            usage_mark: self.usage_mark,
            change_mark: self.change_mark,
            annotation_mark: self.annotation_mark,
            step_mark: self.step_mark,
            flight_mark: self.flight_mark,
            node_marks: self.node_marks,
        };
        self.usage_mark = t.usage_mark;
        self.change_mark = t.change_mark;
        self.annotation_mark = t.annotation_mark;
        self.step_mark = t.step_mark;
        self.flight_mark = t.flight_mark;
        self.node_marks = t.node_marks;
        if len(t.failure) > 0 {
            log_error("the admin event stream could not be read", std::log::kv("error", t.failure));
        }
    }

    /// The place the stream has reached, as an event id: the last ledger
    /// row and change told, and each node's mark.
    fn place() -> String {
        let mut nodes = "";
        let marks = self.node_marks.items;
        for m in marks {
            nodes = nodes + (if len(nodes) > 0 { "," } else { "" }) + to_string(m);
        }
        return "u" + to_string(self.usage_mark) + ".c" + to_string(self.change_mark) + ".a"
            + to_string(self.annotation_mark) + ".s" + to_string(self.step_mark) + ".n" + nodes;
    }

    /// Take the marks from an event id `place` wrote; false when it is
    /// not one.
    fn resume(id: String) -> Bool {
        let dc = std::str::index_of(id, ".c");
        let dn = std::str::index_of(id, ".n");
        if !std::str::starts_with(id, "u") || dc < 0 || dn < dc { return false; }
        // `.a<n>` between them: the annotation told last; a place from
        // before annotations were told has none, and starts at their head
        let da = std::str::index_of(id, ".a");
        let ends = if da > dc && da < dn { da } else { dn };
        self.usage_mark = std::str::parse_int(id[1..dc]) or - 1;
        self.change_mark = std::str::parse_int(id[(dc + 2)..ends]) or - 1;
        if self.usage_mark < 0 || self.change_mark < 0 { return false; }
        // `.s<n>` after it: the step told last; a place from before steps
        // were told has none, and starts at their head
        let ds = std::str::index_of(id, ".s");
        let has_steps = ends == da && ds > da && ds < dn;
        self.annotation_mark = if ends == da {
            std::str::parse_int(id[(da + 2)..(if has_steps { ds } else { dn })]) or - 1
        } else {
                -1
        };
        self.step_mark = if has_steps { std::str::parse_int(id[(ds + 2)..dn]) or - 1 } else { -1 };
        let mut rest = id[(dn + 2)..len(id)];
        let mut marks = NodeMarks { };
        while len(rest) > 0 {
            let comma = std::str::index_of(rest, ",");
            let one = if comma < 0 { rest } else { rest[0..comma] };
            rest = if comma < 0 { "" } else { rest[(comma + 1)..len(rest)] };
            push(marks.items, std::str::parse_int(one) or 0) or discard;
        }
        self.node_marks = marks;
        return true;
    }

    /// The stream, held open: what happened past the subscriber's place,
    /// then, every `FOLLOW_EVERY`, what has happened since, each place sent
    /// as the id the browser sends back as `Last-Event-ID` should it
    /// reconnect (`retry` says how soon), with a keep-alive when it is
    /// quiet. The front serves each connection on a coroutine of its own
    /// (front.hl), so a held stream holds no other request off; it ends when
    /// its subscriber goes. Answered in process (a test, no connection), it
    /// is the one look. A subscriber with no place is at the head: it is
    /// told nothing of what came before.
    fn follow(out: EventStream, last: String) -> std::http::Response {
        out.raw("retry: 2000\n\n");
        if self.resume(last) {
            self.look(out, false);
        } else {
            self.look(out, true);
        }
        out.send_with("", self.place(), "");
        if out.conn_fd < 0 { return out.end(); }
        let mut told = self.place();
        while !out.gone {
            std::time::sleep(FOLLOW_EVERY);
            self.look(out, false);
            let now = self.place();
            if now != told {
                out.send_with("", now, "");
                told = now;
            }
            out.keep_alive(15s, "", "");
        }
        return out.end();
    }
}

/// The `type` filter of a subscription, refusing a type the stream does
/// not carry.
fn read_event_types(path: String) -> st::Names fallible(CtlError) {
    let asked = query_all(path, "type");
    let wanted = asked.items;
    for t in wanted {
        if !std::str::contains(" " + EVENT_TYPES + " ", " " + t + " ") {
            fail bad("`type` is any of " + EVENT_TYPES, "type");
        }
    }
    return asked;
}

/// A request in flight as the `request` event carries it: what it is, the
/// model it asked for and the catalog model it is routed as (its usage
/// record's `requested_model` and `resolved_model`), the seat it is on, and
/// the conversation it is a turn of.
fn flight_json(f: st::FlightRow) -> String {
    let asked = if len(f.alias) > 0 { f.alias } else { f.model };
    return "{\"id\": " + jq(f.request_id) + ", \"project\": " + jq(f.project) + ", \"key\": "
        + jq(f.key) + ", \"requested_model\": " + jq(asked) + ", \"resolved_model\": "
        + jq(f.model) + ", \"seat\": " + jq(f.seat)
        + ", \"account\": " + jq(f.account) + ", \"started_at\": " + jtime(f.started_at)
        + ", \"instance\": " + jstring_or_null(len(f.instance) > 0, f.instance)
        + ", \"conversation\": " + jstring_or_null(len(f.conversation) > 0, f.conversation)
        + "}";
}

/// An annotation as the `annotation` event carries it: the request, its
/// status, each answer given (not those skipped), its runs, and the
/// conversation's title when it wrote one.
@unbounded
fn annotation_event_json(r: st::AnnotationRow, answers: st::AnswerRows) -> String {
    let given = st::JsonList { };
    for a in answers.rows {
        if a.skipped { continue; }
        given.add(
            "{\"annotator\": " + jq(a.annotator) + ", \"stage\": " + jq(a.stage)
                + ", \"question\": " + jq(a.question) + ", \"answer\": " + jq(a.answer)
                + ", \"probability\": " + to_string(a.probability) + "}",
        );
    }
    let title = std::json::find_string_field(r.body, "title");
    let runs = std::str::trim(std::json::find_field_raw(r.body, "runs"));
    return "{\"request_id\": " + jq(r.request_id) + ", \"project\": " + jq(r.project)
        + ", \"key\": " + jq(r.key) + ", \"conversation\": "
        + jstring_or_null(len(r.conversation) > 0, r.conversation) + ", \"status\": "
        + jq(r.status) + ", \"reason\": " + jq(r.reason) + ", \"title\": "
        + jstring_or_null(len(title) > 0, title) + ", \"answers\": [" + given.text()
        + "], \"runs\": " + (if std::str::starts_with(runs, "[") { runs } else { "[]" }) + "}";
}

/// The admin plane's events on the api's hub (hub.hl): every
/// `FOLLOW_EVERY`, one look at the store's rows past its marks, each event
/// published to its topic, the requests in flight whole when they change.
/// Every instance runs one, over its own connection to the store, so each
/// instance's hub tells what any instance (or the brain) recorded. It
/// starts at the head: a UI reads what is there when it connects. Pinned
/// (main.hl): its looks wait on Postgres on a thread of their own.
locus AdminFeed {
    params {
        store: st::Store = st::MemoryStore { };
        // with no database there is no row another instance wrote: the
        // feed tells nothing, and `GET /admin/v1/hub` sends the UI to the
        // event stream instead
        live: Bool = false;
        nodes: Nodes = Nodes { store: self.store, link: NatsLink { } };
        usage_mark: Int = 0;
        change_mark: Int = 0;
        annotation_mark: Int = 0;
        step_mark: Int = 0;
        flight_mark: Int = 0;
        flight_set: String = "";
        node_marks: NodeMarks = NodeMarks { };
        // the last failure was said; said again only after a look succeeds
        failing: Bool = false;
    }

    run() {
        if !self.live { return; }
        self.tick(true);
        while true {
            std::time::sleep(FOLLOW_EVERY);
            self.tick(false);
        }
    }

    /// One look, quiet (to the head) or publishing; the marks move on.
    fn tick(quiet: Bool) {
        let t = EventTick {
            store: self.store,
            nodes: self.nodes,
            out: EventStream { },
            quiet: quiet,
            feed: true,
            usage_mark: self.usage_mark,
            change_mark: self.change_mark,
            annotation_mark: self.annotation_mark,
            step_mark: self.step_mark,
            flight_mark: self.flight_mark,
            flight_set: self.flight_set,
            node_marks: self.node_marks,
        };
        self.usage_mark = t.usage_mark;
        self.change_mark = t.change_mark;
        self.annotation_mark = t.annotation_mark;
        self.step_mark = t.step_mark;
        self.flight_mark = t.flight_mark;
        self.flight_set = t.flight_set;
        self.node_marks = t.node_marks;
        if len(t.failure) > 0 {
            if !self.failing {
                log_error(
                    "the hub's admin events could not be read",
                    std::log::kv("error", t.failure),
                );
            }
            self.failing = true;
        } else if self.failing {
            log_info("the hub's admin events are read again", "");
            self.failing = false;
        }
    }
}
