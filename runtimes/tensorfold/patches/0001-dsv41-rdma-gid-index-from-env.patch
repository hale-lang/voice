 pub const Error = error{ VerbsFailed, PostFailed, BadInfo, TooLarge, Failed, NoHostRegister } || cuda.Error || fabric.verbs.Error || std.posix.MMapError || std.Thread.SpawnError;
 
+/// The GID index the ring opens on each device (port 1): TF_RDMA_GID_INDEX, 5 when unset. A link whose RoCE v2
+/// address sits at another index names it here; a value that is not a whole number from 0 to 255 stops the start.
+pub fn gidIndex() error{BadGidIndex}!u8 {
+    const raw = std.c.getenv("TF_RDMA_GID_INDEX");
+    return parseGidIndex(if (raw) |v| std.mem.span(v) else null);
+}
+
+pub fn parseGidIndex(value: ?[]const u8) error{BadGidIndex}!u8 {
+    const raw = value orelse return 5;
+    if (raw.len == 0 or raw.len > 3) return error.BadGidIndex;
+    for (raw) |c| if (c < '0' or c > '9') return error.BadGidIndex;
+    if (raw.len > 1 and raw[0] == '0') return error.BadGidIndex;
+    return std.fmt.parseInt(u8, raw, 10) catch error.BadGidIndex;
+}
+
 /// The Python build's switches, with their defaults (TF_RDMA_SLOTS, TF_RDMA_STAGE_BLOCKS, ..., TF_RDMA_PDL as served).
 pub const Settings = struct {
     slots: u32 = 4,
@@ -546,3 +561,15 @@ test "a failed neighbor stage releases both local stages' device waits" {
     try std.testing.expectEqual(@as(u64, 1), first.abortWord().*);
     try std.testing.expectEqual(@as(u64, 1), second.abortWord().*);
 }
+
+test "TF_RDMA_GID_INDEX: unset is 5, a number is that index, anything else is refused" {
+    try std.testing.expectEqual(@as(u8, 5), try parseGidIndex(null));
+    try std.testing.expectEqual(@as(u8, 3), try parseGidIndex("3"));
+    try std.testing.expectEqual(@as(u8, 0), try parseGidIndex("0"));
+    try std.testing.expectEqual(@as(u8, 255), try parseGidIndex("255"));
+    try std.testing.expectError(error.BadGidIndex, parseGidIndex(""));
+    try std.testing.expectError(error.BadGidIndex, parseGidIndex("256"));
+    try std.testing.expectError(error.BadGidIndex, parseGidIndex("-1"));
+    try std.testing.expectError(error.BadGidIndex, parseGidIndex("3 "));
+    try std.testing.expectError(error.BadGidIndex, parseGidIndex("03"));
+}
