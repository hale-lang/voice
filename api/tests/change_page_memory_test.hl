// A full page of the change log is built in memory linear in its size: a
// page of 1000 changes, each a project as it was and as it became, grows the
// process's peak by about two megabytes. The transport's codec writes a list
// of records by `+`, which keeps every prefix it made: a page of 1000
// changes (about a megabyte of JSON) peaks about 800 MB when it is written,
// a page of the default 100 about 8 MB. The test holds the default page to
// linear and says what the full one costs (hale: the codec's list encoder).
import ".." as api;
import "../../store" as st;

/// The process's peak resident memory so far, in kB (`VmHWM`).
fn peak_kb() -> Int {
    let status = std::io::fs::read_file("/proc/self/status") or "";
    let at = std::str::index_of(status, "VmHWM:");
    if at < 0 { return 0; }
    let rest = std::str::trim(status[at + 6..len(status)]);
    let end = std::str::index_of(rest, " ");
    return std::str::parse_int(rest[0..end]) or 0;
}

fn main() {
    let store = st::MemoryStore { };
    let projects = api::Projects { store: store };
    let changes = api::Changes { store: store };
    let long = "a project whose name is long enough that each of its changes carries a few hundred bytes of JSON, before and after";
    projects.create(api::ProjectCreate { id: "work", name: long }) or discard;
    let mut i = 1;
    while i < 1000 {
        let mut renamed = "";
        projects.update(
            api::ProjectUpdate {
                project: "work",
                has_name: true,
                name: long + " " + to_string(i),
            },
        ) or {
            renamed = api::ctl_problem(err).message;
        };
        std::test::assert_eq_str(renamed, "", "rename " + to_string(i));
        i = i + 1;
    }

    let before = peak_kb();
    std::test::assert(before > 0, "the peak is readable from /proc/self/status");
    let page = changes.list(api::ChangeAsk { limit: 1000 }) or api::ChangeList { };
    let built = peak_kb();
    std::test::assert_eq_int(count(page.data), 1000, "a page");
    std::test::assert(
        !page.has_next_cursor && std::str::contains(
            (at(page.data, 0) or api::Change { action: api::ChangeAction::create }).after.text,
            long + " 999",
        ),
        "all of them, newest first, on one page",
    );
    let first = changes.list(api::ChangeAsk { }) or api::ChangeList { };
    std::test::assert_eq_int(count(first.data), 100, "the default page is 100");
    let body = api::ChangeList::api_encode(first);
    let after = peak_kb();
    std::test::assert(
        len(body) > 40000,
        "100 changes of a few hundred bytes each: " + to_string(len(body)),
    );
    std::test::assert(
        built - before < 32768,
        "building the page grew the peak by " + to_string(built - before)
            + " kB; under 32 MB is linear",
    );
    std::test::assert(
        after - built < 32768,
        "encoding the page (the transport's codec) grew the peak by " + to_string(after - built)
            + " kB; under 32 MB is linear",
    );
}
