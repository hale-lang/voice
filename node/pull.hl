// The node's pulls (docs/design/queue-routing.md; spec/protocol.yaml,
// "Pulling: protocol 3"). Each seat that may serve pulls tickets from the
// queues it consumes on the work stream, only while it has a free slot by
// the node's own count (`busy`, session.hl), and a slot claims each ticket's
// request from the api instance that holds its caller (serve.hl).
//
// What a seat consumes is its part of the brain's last `ConsumePlan`
// (`<root>.node.<node>.consume`), or, with none, every queue its assignment
// makes it eligible for (`eligible_queues`): its own queue, then, for each
// model it serves and data class it carries, the `m` partition and the `p`
// one under its own provider account, `any`, and `tools` when it carries
// them. A queue a seat may not serve from is declined `ineligible` at the
// claim; the subject routes, the claim decides.
//
// How a seat pulls (`pulls_due`): with free slots it sweeps its queues in
// order, one `no_wait` pull at a time for as many tickets as it has free
// slots, so a backlog is taken in its plan's order and never beyond them;
// once every queue was found empty it holds a standing pull of one ticket
// on each, waiting `STAND_MS`, and the first ticket to arrive is served.
// Standing pulls may bring more tickets than the seat has free slots: the
// extras are put back at once (`js_nak`, no delay). A pair's follower, a
// seat not up and a seat its plan holds pull nothing.
//
// The pulls are pond's `JsPuller`s on the session's own connection, each a
// queue of one seat, so a pull never holds a thread: what the server sends
// back arrives through the session's read loop.

import "../lib/work" as work;
import "../lib/pond/realtime/nats" as nats;

/// The most queues the node pulls from at once, across its seats: the
/// pullers it holds. A seat's own queue and its first partitions come
/// first; past it a queue is not pulled, and the node says so.
const PULLS_MAX: Int = 128;
/// How long a standing pull waits for a ticket before it is made again:
/// long, so a node with nothing to do costs a pull per queue this often.
const STAND_MS: Int = 30000;
/// A ticket that avoids the seat that pulled it, or one the api declined it
/// as ineligible for and it pulled again, goes back with this delay, for
/// another seat to take meanwhile.
const AVOID_DELAY_MS: Int = 1000;
/// After a pull the server refused (no consumer, as for a queue in the
/// shape the brain did not choose, or no stream): the first wait before
/// the next, doubled each time, to the most, so a consumer the brain makes
/// is pulled from within seconds.
const RETRY_MIN_MS: Int = 1000;
const REFUSED_MAX_MS: Int = 5000;
/// After a pull the server never answered (a permission the node lacks, a
/// server gone): the same, to a longer most.
const SILENT_MAX_MS: Int = 30000;
/// How often the pulls are looked at with nothing new to say: what an
/// expired wait or a refusal's retry needs.
const LOOK_MS: Int = 250;

/// One queue one seat consumes, pulled by the puller of the same index.
/// `seat` "" is a puller nothing uses.
type PullSlot {
    seat: String = "";
    subject: String = "";
    // its place in the seat's queues
    order: Int = 0;
    // a pull open on it: "" none, "sweep" (no_wait) or "stand" (it waits)
    open: String = "";
    // found empty since the seat's sweep began
    empty: Bool = false;
    // no pull before this (monotonic ns), after refusals in a row
    retry_at: Int = 0;
    refusals: Int = 0;
}

type PullSlots { items: bounded[PullSlot; 128]; }

/// What one seat consumes, and how its pulls go (spec/protocol.yaml
/// `SeatPull`).
type SeatPull {
    seat: String = "";
    // the queues it consumes, in order
    queues: bounded[String; 64];
    // the plan it follows: its version, -1 for none (its own eligibility)
    plan_version: Int = -1;
    // held by its plan, why
    hold: String = "";
    // pulling | waiting | full | held | off, and why for held and off
    state: String = "off";
    reason: String = "";
    // a ticket the api declined `ineligible` for this seat, and until
    // when (monotonic ns) pulling it again puts it back with a delay
    ineligible: String = "";
    ineligible_until: Int = 0;
    // the conversations its engine holds, as far as the node knows: those
    // of the tickets it was granted, the newest first, at most what its
    // runtime holds (lib/concurrency `conversations_held`)
    held: Held = Held { };
    // its engine's measured prefill rate, input not cached read a second
    // (`prefill_with`); 0 until measured
    prefill: Int = 0;
}

/// The fewest input tokens not cached a request must have for its time to
/// first output to measure the seat's prefill rate: below it, the time is
/// mostly the engine's fixed cost, not reading.
const PREFILL_MIN_TOKENS: Int = 256;

/// A seat's prefill rate (`rate`, input not cached read a second, 0 for
/// none yet) once a request it served had `uncached` input tokens its
/// engine's prompt cache did not hold and reached its first output in
/// `first_ms`: the request's own rate, averaged with the recent ones (a
/// quarter its own, so one slow turn moves it little). A request with
/// fewer than `PREFILL_MIN_TOKENS` such tokens, or no output, leaves it.
fn prefill_with(rate: Int, uncached: Int, first_ms: Int) -> Int {
    if uncached < PREFILL_MIN_TOKENS || first_ms <= 0 { return rate; }
    let sample = uncached * 1000 / first_ms;
    if sample <= 0 { return rate; }
    return if rate <= 0 { sample } else { (rate * 3 + sample) / 4 };
}

/// A seat's conversations, each 32 hex digits of a hash of its key
/// (protocol.yaml `Ticket.conversation`), the newest first.
type Held { items: bounded[String; 128]; }

type SeatPulls { items: bounded[SeatPull; 16]; }

/// `h` with `conversation` its newest, kept once, at most `most` of them
/// (and at most 128): the oldest goes first.
fn held_with(h: Held, conversation: String, most: Int) -> Held {
    let mut out = Held { };
    if most <= 0 { return out; }
    push(out.items, conversation) or discard;
    for c in h.items {
        if c != conversation && count(out.items) < most { push(out.items, c) or discard; }
    }
    return out;
}

/// A seat's conversations as the heartbeat says them (protocol.yaml
/// `SeatState.conversations`).
fn held_json(h: Held) -> String {
    let mut out = "[";
    let mut first = true;
    for c in h.items {
        out = out + (if first { "" } else { ", " }) + q(c);
        first = false;
    }
    return out + "]";
}

/// A pull to open: on the puller `slot`, standing for one ticket, or a
/// sweep for `batch`.
type PullOrder { slot: Int = -1; batch: Int = 0; stand: Bool = false; }

type PullOrders { items: bounded[PullOrder; 64]; }

// ---- what a seat consumes -------------------------------------------------

/// The root of the subjects under which `subject`, the node `node`'s own
/// (`<root>.node.<node>`), is; "" when it is not one.
fn root_of(subject: String, node: String) -> String {
    let tail = ".node." + node;
    if len(subject) <= len(tail) || !std::str::ends_with(subject, tail) { return ""; }
    return subject[0..(len(subject) - len(tail))];
}

/// The inbox prefix the node's requests and pulls answer on: NATS's own
/// under voice's own root; under a habitat's broker, under its root, the
/// only place the nodes' account may receive.
fn inbox_of(root: String) -> String {
    return if len(root) == 0 || root == work::DEFAULT_ROOT { "_INBOX" } else { root + "._INBOX" };
}

/// A JSON string's text, "" for anything else.
fn json_text(raw: String) -> String {
    let e = std::str::trim(raw);
    if len(e) < 2 || !std::str::starts_with(e, "\"") || !std::str::ends_with(e, "\"") {
        return "";
    }
    return std::json::unescape_string(e[1..(len(e) - 1)]);
}

/// `subject` added to `out` once, while it holds fewer than 64.
fn add_queue(out: work::Subjects, subject: String) -> work::Subjects {
    for s in out.items {
        if s == subject { return out; }
    }
    let mut next = out;
    push(next.items, subject) or discard;
    return next;
}

/// The queues the seat `seat` (its assignment's JSON) of node `node`
/// consumes under `root` with no plan, `kind` its engine's kind: its own
/// queue, then, for each model it serves and data class it carries (by
/// default `internal`), the `m` partition and the `p` one under its own
/// provider account, `any`, and `tools` too when it carries them; at most
/// 64, each once. Both shapes, since only the brain knows a model's.
@bounded_by(seat)
fn eligible_queues(root: String, node: String, seat: String, kind: String) -> work::Subjects {
    let id = std::json::find_string_field(seat, "id");
    let account = std::json::find_string_field(seat, "account");
    let config = std::str::trim(std::json::find_field_raw(seat, "config"));
    let tools = work::carries_tools(kind, config);
    let mut classes = std::str::trim(std::json::find_field_raw(seat, "data_classes"));
    if !std::str::starts_with(classes, "[") { classes = "[\"internal\"]"; }
    let mut out = work::Subjects { };
    out = add_queue(out, work::seat_subject(root, node, id));
    let mut m = std::json::array_first(std::json::find_field_raw(seat, "serves"));
    while !m.done {
        let model = std::json::find_string_field(std::str::trim(m.element), "model");
        let mut c = std::json::array_first(classes);
        while len(model) > 0 && !c.done {
            let class = json_text(c.element);
            if len(class) > 0 {
                out = add_queue(out, work::model_subject(root, model, class, "any"));
                if tools { out = add_queue(out, work::model_subject(root, model, class, "tools")); }
                if len(account) > 0 {
                    out = add_queue(
                        out,
                        work::provider_subject(root, model, account, class, "any"),
                    );
                    if tools {
                        out = add_queue(
                            out,
                            work::provider_subject(root, model, account, class, "tools"),
                        );
                    }
                }
            }
            c = std::json::array_next(c);
        }
        m = std::json::array_next(m);
    }
    return out;
}

/// What seat `seat` (its assignment's JSON) consumes: its part of `plan`
/// when the node has one (`planned`) that names it, held or its queues in
/// order; else its own eligibility (`eligible_queues`).
fn seat_pull_of(
    root: String,
    node: String,
    seat: String,
    kind: String,
    plan: work::ConsumePlan,
    planned: Bool
) -> SeatPull {
    let id = std::json::find_string_field(seat, "id");
    if planned {
        for p in plan.seats {
            if p.seat == id {
                return SeatPull {
                    seat: id,
                    queues: p.consume,
                    plan_version: plan.version,
                    hold: p.hold,
                };
            }
        }
    }
    let q = eligible_queues(root, node, seat, kind);
    return SeatPull { seat: id, queues: q.items };
}

// ---- whether, and how much, a seat pulls ----------------------------------

/// Why seat `s` pulls nothing whatever its slots, "" when it may pull: it
/// is not up (paused, fetching, starting, down...), or it is a pair's
/// follower, whose leader (rank 0) serves the pair and pulls for it.
fn pull_off_reason(s: NodeSeat) -> String {
    if len(s.id) == 0 { return "not assigned"; }
    if s.status != "up" { return "the seat is " + s.status; }
    if rank_of(s.config) != 0 { return "the follower of a pair: its leader pulls"; }
    return "";
}

/// How many more requests seat `s` may take: its concurrency less what it
/// serves and claims (`busy`), within what the node's `slots` have free.
fn free_for(busy: String, s: NodeSeat, slots: Int) -> Int {
    let node_free = slots - busy_count(busy);
    let seat_free = s.concurrency - seat_busy(busy, s.id);
    let free = if node_free < seat_free { node_free } else { seat_free };
    return if free > 0 { free } else { 0 };
}

/// The pulls seat `seat` opens now, with `free` slots, among `slots` (the
/// node's pulls) at monotonic `now`: none without a free slot, or while a
/// sweep of its is open; else a sweep of the first of its queues in order
/// not found empty, with no pull open and not waiting out a refusal, for
/// `free` tickets; else, every queue found empty, a standing pull of one
/// ticket on each that has no pull open.
fn pulls_due(slots: PullSlots, seat: String, free: Int, now: Int) -> PullOrders {
    let mut out = PullOrders { };
    if free <= 0 { return out; }
    let mut sweep = -1;
    let mut sweep_order = 0;
    let mut i = 0;
    for p in slots.items {
        if p.seat == seat {
            if p.open == "sweep" { return out; }
            if len(p.open) == 0 && !p.empty && p.retry_at <= now
                && (sweep < 0 || p.order < sweep_order)
            {
                sweep = i;
                sweep_order = p.order;
            }
        }
        i = i + 1;
    }
    if sweep >= 0 {
        push(out.items, PullOrder { slot: sweep, batch: free }) or discard;
        return out;
    }
    i = 0;
    for p in slots.items {
        if p.seat == seat && len(p.open) == 0 && p.empty && p.retry_at <= now {
            push(out.items, PullOrder { slot: i, batch: 1, stand: true }) or discard;
        }
        i = i + 1;
    }
    return out;
}

/// Whether seat `seat` found its queues empty and holds a standing pull on
/// each, at `now`: a queue whose pulls are refused (no consumer, in the
/// shape the brain did not choose) is passed over, tried again or not.
fn waits_on_all(slots: PullSlots, seat: String, now: Int) -> Bool {
    let mut any = false;
    for p in slots.items {
        if p.seat == seat {
            if p.open == "stand" {
                any = true;
            } else if p.refusals == 0 && (len(p.open) > 0 || p.retry_at <= now) {
                return false;
            }
        }
    }
    return any;
}

/// How long to wait after `refusals` refusals in a row, in ms: from
/// `RETRY_MIN_MS`, doubled each time, to `most`.
fn retry_ms(refusals: Int, most: Int) -> Int {
    let mut ms = RETRY_MIN_MS;
    let mut k = 1;
    while k < refusals && ms < most {
        ms = ms * 2;
        k = k + 1;
    }
    return if ms < most { ms } else { most };
}

/// What the node does with `ticket` (its JSON), pulled for the seat `claimant`
/// (`<node>/<seat>`) with `free` slots, which may pull (`may`) and carries
/// tools or not (`tools`), at `now`; `ineligible` the message id of a
/// ticket the api last declined this seat as ineligible for, still
/// remembered:
/// - "claim": a slot claims it;
/// - "extra": no free slot, or a seat that pulls no more: put back at once;
/// - "avoid": it avoids this seat, or the seat is ineligible for it: put
///   back after `AVOID_DELAY_MS`;
/// - "late": past its wait: acked and dropped, its request over;
/// - "malformed": not a ticket: acked and dropped.
fn verdict(
    ticket: String,
    claimant: String,
    may: Bool,
    free: Int,
    tools: Bool,
    ineligible: String,
    now: Time
) -> String {
    let t = work::ticket_of(ticket) or { return "malformed"; };
    if !may || free <= 0 { return "extra"; }
    if std::time::nanos(t.wait_until) <= std::time::nanos(now) { return "late"; }
    for a in t.avoid {
        if a == claimant { return "avoid"; }
    }
    if t.need == "tools" && !tools { return "avoid"; }
    if len(ineligible) > 0 && work::message_id(t.request_id, t.attempt, t.copy) == ineligible {
        return "avoid";
    }
    return "claim";
}

// ---- what the status and the heartbeat say --------------------------------

/// A list of strings as JSON.
fn strings_json(items: bounded[String; 64]) -> String {
    let mut out = "[";
    let mut first = true;
    for s in items {
        out = out + (if first { "" } else { ", " }) + q(s);
        first = false;
    }
    return out + "]";
}

/// A seat's pulls as the heartbeat and the status say them
/// (protocol.yaml `SeatPull`).
fn seat_pull_json(p: SeatPull) -> String {
    return "{\"state\": " + q(p.state) + ", \"reason\": "
        + (if len(p.reason) > 0 { q(p.reason) } else { "null" }) + ", \"plan_version\": "
        + (if p.plan_version >= 0 { to_string(p.plan_version) } else { "null" })
        + ", \"queues\": " + strings_json(p.queues) + "}";
}

/// `, "pull": {...}, "conversations": [...]` and, once measured,
/// `"prefill_rate": n` for seat `id` when `pulls` holds it, "" when not.
fn pull_field(pulls: SeatPulls, id: String) -> String {
    for p in pulls.items {
        if p.seat == id {
            return ", \"pull\": " + seat_pull_json(p) + ", \"conversations\": " + held_json(p.held)
                + (if p.prefill > 0 { ", \"prefill_rate\": " + to_string(p.prefill) } else { "" });
        }
    }
    return "";
}

// ---- the pullers ----------------------------------------------------------

/// The node's pulls: a pool of pond's `JsPuller`s, each pulling one queue
/// of one seat on the session's connection, and what each seat consumes.
/// Held by the session (session.hl), on its thread: it reads what the
/// pullers are sent and hands each ticket to a slot.
locus Pulls {
    params {
        ps: [nats::JsPuller; 128] = [
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
