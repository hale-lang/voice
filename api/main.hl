/// The voice api, stubbed. Every endpoint in ../spec/openapi.yaml answers its
/// happy path with a canned body from `canned/`, named by the endpoint's
/// operationId. Each route is replaced by its real handler as the MVP is
/// built; see endpoints.hl.
///
/// Its events (events.hl) travel over NATS: the usage event is bound to
/// pond's adapter, and a pinned connection writes it and waits for the
/// stream that takes its subject to acknowledge it. Nothing is published
/// until `--pulse` names the prefix an organization reads voice's
/// subjects under.
import "lib/pond/realtime/nats" as nats;

main locus Api {
    params {
        host: String = "127.0.0.1";
        port: Int = 8080;
        canned: String = "canned";
        ui: String = "";
        pulse: Bool = false;
        nerves: nats::NatsConn = nats::NatsConn { };
    }
    placement { nerves: pinned; }
    bindings { UsageRecorded: nats::NatsAdapter { } codec(UsageJson { }); }
    // An event the stream did not acknowledge in time: the connection is
    // gone, and the api keeps answering without it.
    on_failure(c: nats::NatsConn, err: ClosureViolation) {
        eprintln("voice api: events stopped: ", c.last_error);
    }
    run() { serve(self.host, self.port, self.canned, self.nerves.url, self.ui, self.pulse); }
}

fn serve(host: String, port: Int, canned: String, nats: String, ui: String, pulse: Bool) {
    println("voice api (stub) on http://", host, ":", port, ", canned bodies from ", canned);
    if pulse { println("voice api: events on ", nats); } else { println("voice api: no events (no --pulse)"); }
    if len(ui) > 0 { println("voice api: serving the admin ui from ", ui); }
    let endpoints = Endpoints { canned: canned, ui: ui, pulse: pulse };
    std::http::Server { host: host, port: port, handler: endpoints };
}

/// `api [--host H] [--port N] [--canned DIR] [--nats URL] [--pulse PREFIX]
/// [--ui DIR]`. The canned directory defaults to `canned` beside the
/// binary; with no `--ui` the app is not served. `--pulse` publishes the
/// api's events under PREFIX (an organization's token and a dot, as the
/// organization names it) on the NATS server `--nats` names.
fn main() {
    let mut host = "127.0.0.1";
    let mut port = 8080;
    let mut canned = beside_binary("canned");
    let mut nats = "nats://127.0.0.1:4222";
    let mut ui = "";
    let mut pulse = "";
    let mut i = 1;
    while i + 1 < std::env::args_count() {
        let flag = std::env::arg(i);
        let value = std::env::arg(i + 1);
        if flag == "--host" {
            host = value;
        } else if flag == "--port" {
            port = std::str::parse_int(value) or port;
        } else if flag == "--canned" {
            canned = value;
        } else if flag == "--nats" {
            nats = value;
        } else if flag == "--pulse" {
            pulse = value;
        } else if flag == "--ui" {
            ui = value;
        }
        i = i + 2;
    }
    Api {
        host: host,
        port: port,
        canned: canned,
        ui: ui,
        pulse: len(pulse) > 0,
        nerves: nats::NatsConn { url: nats, name: "voice-api", subject_prefix: pulse, jetstream: true }
    };
}

/// `name` in the directory holding the running binary, or `name` as given
/// when the binary was started without a directory in its path.
fn beside_binary(name: String) -> String {
    let mut dir = "";
    let mut rest = std::env::arg(0);
    let mut at = std::str::index_of(rest, "/");
    while at >= 0 {
        dir = dir + rest[0..(at + 1)];
        rest = rest[(at + 1)..len(rest)];
        at = std::str::index_of(rest, "/");
    }
    return dir + name;
}
