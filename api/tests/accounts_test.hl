// Accounts on the admin plane: the rows of `Accounts` (list, create, get,
// update, archive), called on a receiver over a store.
import ".." as api;
import "../../store" as st;

fn blank() -> api::Account {
    return api::Account { billing: api::Billing::none, status: api::Lifecycle::archived };
}

fn ids(l: api::AccountList) -> String {
    let mut out = ",";
    for a in l.data {
        out = out + a.id + ",";
    }
    return out;
}

fn main() {
    let store = st::MemoryStore { };
    let accounts = api::Accounts { store: store };

    let none = accounts.list(api::AccountQuery { }) or api::AccountList { };
    std::test::assert_eq_int(count(none.data), 0, "none yet");

    let mut c = api::AccountCreate {
        id: "claude-work",
        name: "Claude (work)",
        has_provider: true,
        provider: "anthropic",
        has_billing: true,
        billing: api::Billing::subscription,
    };
    push(
        c.limits,
        st::counted(
            st::Limit { scope: st::LimitScope::account, window_seconds: 18000, requests: 900 },
        ),
    ) or discard;
    let work = accounts.create(c) or blank();
    std::test::assert(work.status == api::Lifecycle::active, "active");
    std::test::assert(work.has_provider, "it has a provider");
    std::test::assert_eq_str(work.provider, "anthropic", "its provider");
    std::test::assert(work.billing == api::Billing::subscription, "its billing");
    std::test::assert_eq_int(count(work.seats), 0, "no seat spends it yet");
    std::test::assert_eq_int(count(work.windows), 0, "no window reported");
    std::test::assert(!work.has_exhausted_until, "not exhausted");
    let mut named = "";
    for l in work.limits {
        named = l.account;
    }
    std::test::assert_eq_str(named, "claude-work", "an account limit names the account");

    let local = accounts.create(api::AccountCreate { id: "static", name: "Static" }) or blank();
    std::test::assert_eq_str(local.id, "static", "a local account");
    std::test::assert(local.billing == api::Billing::none, "billing defaults to none");
    std::test::assert(!local.has_provider, "no provider");

    let mut failed = "";
    accounts.create(api::AccountCreate { id: "static", name: "Again" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "an id is taken once");
    failed = "";
    accounts.create(api::AccountCreate { id: "X", name: "X" }) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid id", "an id is a slug");
    let mut project_scope = api::AccountCreate { id: "x", name: "X" };
    push(
        project_scope.limits,
        st::Limit { scope: st::LimitScope::project, window_seconds: 60 },
    ) or discard;
    failed = "";
    accounts.create(project_scope) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid limits", "an account's limits are account-scope");
    let mut other = api::AccountCreate { id: "x", name: "X" };
    push(
        other.limits,
        st::Limit { scope: st::LimitScope::account, account: "other", window_seconds: 60 },
    ) or discard;
    failed = "";
    accounts.create(other) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid limits", "and name it");
    failed = "";
    accounts.get(api::AccountRef { account: "x" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "a refused create made nothing");

    let got = accounts.get(api::AccountRef { account: "claude-work" }) or blank();
    std::test::assert_eq_str(got.id, "claude-work", "get");
    failed = "";
    accounts.get(api::AccountRef { account: "nope" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "an unknown account");
    let changed = accounts.update(
        api::AccountUpdate {
            account: "claude-work",
            has_name: true,
            name: "Claude",
            has_billing: true,
            billing: api::Billing::metered,
            clear_provider: true,
        },
    ) or blank();
    std::test::assert_eq_str(changed.name, "Claude", "renamed");
    std::test::assert(changed.billing == api::Billing::metered, "billing changed");
    std::test::assert(!changed.has_provider, "provider cleared");
    let mut requests = -1;
    for l in changed.limits {
        requests = l.requests;
    }
    std::test::assert_eq_int(requests, 900, "a field not set stays");
    failed = "";
    accounts.update(api::AccountUpdate { account: "claude-work", has_id: true, id: "x" }) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid id", "an id never changes");

    let gone = accounts.archive(api::AccountRef { account: "static" }) or blank();
    std::test::assert(gone.status == api::Lifecycle::archived, "archived");
    std::test::assert(gone.has_archived_at, "when");
    let again = accounts.archive(api::AccountRef { account: "static" }) or blank();
    std::test::assert(
        again.status == api::Lifecycle::archived && again.archived_at == gone.archived_at,
        "archiving again changes nothing",
    );
    failed = "";
    accounts.create(api::AccountCreate { id: "static", name: "Static" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "its id is never reused");
    let listed = accounts.list(api::AccountQuery { }) or api::AccountList { };
    std::test::assert_eq_str(ids(listed), ",claude-work,", "the list leaves it out");
    let all = accounts.list(api::AccountQuery { include_archived: true }) or api::AccountList { };
    std::test::assert(std::str::contains(ids(all), ",static,"), "unless asked");
}
