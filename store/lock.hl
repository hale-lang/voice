// A turn at something that one conversation at a time may use.
//
// A Postgres connection is one conversation: a query sent, its rows read. The
// listener runs each connection as a coroutine on one pool, and a coroutine
// waiting for the database lets another run, which would send its own query
// on the same connection and read the first one's rows. The store takes turns
// at its connection with this (pg_store.hl), and the api takes turns at the
// admin plane's store and at the inference path (front.hl).
//
// The wait is a short sleep, which parks only the waiting coroutine.
locus Lock {
    params { busy: Bool = false; }

    @unbounded
    fn enter() {
        while self.busy { std::time::sleep(1ms); }
        self.busy = true;
    }

    fn leave() { self.busy = false; }
}
