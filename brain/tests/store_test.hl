// The brain against Postgres, when VOICE_TEST_DATABASE_URL names a database
// at the current schema (`api migrate`), which this test empties first:
// the one-brain lock, the reclaim of a dead api instance, node liveness and
// the route table read from the fleet as reported, and the board. With
// VOICE_TEST_NATS_URL naming a JetStream-enabled NATS too, the controller
// ticks as the working brain does (`controller`): a backlog on one model's
// queue moves a seat that serves two to it within a few ticks, and back
// once it drains, and an exhausted account's seats are held, each change
// published in the node's plan. (In this one file, since the brain's test
// files run side by side and this database is theirs.)
import ".." as brain;
import "../../api" as api;
import "../../store" as st;
import "../../lib/pond/pq" as pq;
import "../../lib/pond/db" as db;
import "../../lib/work" as work;
import "../../lib/pond/realtime/nats" as nats;

fn connect(url: String) -> pq::PgConn {
    let d = st::parse_dsn(url);
    return pq::PgConn {
        host: d.host,
        port: d.port,
        user: d.user,
        password: d.password,
        database: d.database,
        sslmode: d.sslmode,
    };
}

fn run(c: pq::PgConn, sql: String) {
    let r = c.exec(sql);
    std::test::assert(r.ok, sql + ": " + r.err.detail);
}

fn one(c: pq::PgConn, sql: String) -> String {
    let r = c.query_one(sql);
    return std::str::trim(r.data);
}

fn main() {
    if !std::env::var_exists("VOICE_TEST_DATABASE_URL") { return; }
    let url = std::env::var("VOICE_TEST_DATABASE_URL");
    let c = connect(url);
    std::test::assert(c.open().ok, "the test database answers");
    run(c, "SET TIME ZONE 'UTC'");
    run(
        c,
        "TRUNCATE route_table, board, usage, request, budget_state, limit_state, api_instance, change, quota_window, seat_state, node_state, seat, node, \"limit\", budget, api_key, project, account, catalog_model, recipe, placement, runtime RESTART IDENTITY CASCADE",
    );

    // the one brain
    let other = connect(url);
    other.open();
    std::test::assert_eq_str(one(c, brain::BRAIN_LOCK), "t", "the first brain takes the lock");
    std::test::assert_eq_str(one(other, brain::BRAIN_LOCK), "f", "a second stands by");
    let first = one(c, "SELECT pg_backend_pid()");
    c.close();
    // the server ends the first one's session, and its lock with it, a
    // moment after its connection goes, not as the close returns
    let held = "SELECT count(*) FROM pg_locks WHERE locktype = 'advisory' AND pid = " + first;
    let until = std::time::monotonic() + 10s;
    let mut locks = one(other, held);
    while locks != "0" && std::time::monotonic() < until {
        std::time::sleep(20ms);
        locks = one(other, held);
    }
    std::test::assert_eq_str(locks, "0", "the first one's session ends with its connection");
    std::test::assert_eq_str(
        one(other, brain::BRAIN_LOCK),
        "t",
        "and takes over when the first one's connection goes",
    );
    other.close();
    let c2 = connect(url);
    c2.open();
    run(c2, "SET TIME ZONE 'UTC'");

    // a fleet: a model, an account, a node up with its seat up
    run(c2, "INSERT INTO catalog_model (id, kind) VALUES ('echo-1', 'local'), ('idle-1', 'local')");
    run(c2, "INSERT INTO account (id, name, billing) VALUES ('static', 'Static', 'none')");
    run(c2, "INSERT INTO project (id, name, owners) VALUES ('work', 'Work', '{}')");
    run(
        c2,
        "INSERT INTO api_key (id, project, name, prefix, secret_digest) VALUES ('k_1', 'work', 'ci', 'vk-0000', '\\x00')",
    );
    run(
        c2,
        "INSERT INTO node (id, name, token_digest, assignment_version) VALUES ('laptop', 'Laptop', '\\x00', 2)",
    );
    run(
        c2,
        "INSERT INTO seat (node, id, engine, account, serves, concurrency, config) VALUES ('laptop', 'static', 'static', 'static', '[{\"model\": \"echo-1\", \"as\": null}]', 4, '{\"text\": \"hi\"}')",
    );
    run(
        c2,
        "INSERT INTO node_state (node, version, capabilities, local, registered_at, last_heartbeat_at, applied_version) VALUES ('laptop', '0.1.0', '{\"engines\": []}', '{\"paused\": false, \"paused_seats\": []}', now(), now(), 2)",
    );
    run(
        c2,
        "INSERT INTO seat_state (node, seat, status, in_flight, reported_at) VALUES ('laptop', 'static', 'up', 0, now())",
    );

    // two api instances, one dead with a request in flight
    run(
        c2,
        "INSERT INTO api_instance (id, last_heartbeat_at) VALUES ('api-dead', now() - interval '1 minute'), ('api-live', now())",
    );
    run(
        c2,
        "INSERT INTO \"limit\" (scope, project, window_seconds, requests, concurrent) VALUES ('project', 'work', 60, 10, 2)",
    );
    run(
        c2,
        "INSERT INTO limit_state (limit_id, window_start, requests, input_tokens, output_tokens, concurrent) VALUES (1, date_bin(make_interval(secs => 60), now(), 'epoch'), 1, 5, 100, 1)",
    );
    run(
        c2,
        "INSERT INTO budget (project, allowance_micros, period, period_anchor) VALUES ('work', 1000, 'month', date_trunc('month', now()))",
    );
    run(
        c2,
        "INSERT INTO budget_state (project, period_start, reserved_micros) VALUES ('work', date_trunc('month', now()), 40)",
    );
    run(
        c2,
        "INSERT INTO request (id, instance, project, key, requested_model, endpoint, data_class, reserved_input, reserved_output, reserved_micros, price, limits, period_start, metadata) VALUES ('resp_1', 'api-dead', 'work', 'k_1', 'echo-1', 'responses', 'internal', 5, 100, 40, '{\"currency\": \"USD\"}', '{1}', date_trunc('month', now()), '{\"k\": \"v\"}')",
    );

    std::test::assert_eq_int(brain::reclaim(c2), 1, "the dead instance is reclaimed");
    std::test::assert_eq_str(
        one(c2, "SELECT status FROM request WHERE id = 'resp_1'"),
        "abandoned",
        "its request abandoned",
    );
    std::test::assert_eq_str(
        one(
            c2,
            "SELECT status || ' ' || (record->>'endpoint') || ' ' || (record->'metadata'->>'k') FROM usage WHERE id = 'resp_1'",
        ),
        "abandoned responses v",
        "and recorded in the ledger",
    );
    std::test::assert_eq_str(
        one(
            c2,
            "SELECT concurrent || ' ' || input_tokens || ' ' || output_tokens || ' ' || requests FROM limit_state",
        ),
        "0 0 0 1",
        "its reservation released; its request still counted",
    );
    std::test::assert_eq_str(
        one(c2, "SELECT reserved_micros FROM budget_state"),
        "0",
        "and its budget",
    );
    std::test::assert_eq_str(
        one(c2, "SELECT string_agg(id, ',' ORDER BY id) FROM api_instance"),
        "api-dead,api-live",
        "an instance a request still names stays",
    );
    std::test::assert_eq_str(
        one(c2, "SELECT (reclaimed_at IS NOT NULL)::text FROM api_instance WHERE id = 'api-dead'"),
        "true",
        "marked reclaimed",
    );
    std::test::assert_eq_int(brain::reclaim(c2), 0, "and is not reclaimed again");

    // an instance that beats again between the read and its reclaim keeps
    // what it holds
    run(c2, "INSERT INTO api_instance (id, last_heartbeat_at) VALUES ('api-slow', now())");
    run(
        c2,
        "INSERT INTO request (id, instance, project, key, requested_model, endpoint, data_class, reserved_input, reserved_output, reserved_micros, price, limits, period_start, metadata) VALUES ('resp_2', 'api-slow', 'work', 'k_1', 'echo-1', 'responses', 'internal', 1, 1, 1, '{\"currency\": \"USD\"}', '{}', date_trunc('month', now()), '{}')",
    );
    std::test::assert_eq_int(
        brain::reclaim_one(c2, "api-slow"),
        0,
        "an instance alive by the time its reclaim runs is not reclaimed",
    );
    std::test::assert_eq_str(
        one(c2, "SELECT status FROM request WHERE id = 'resp_2'"),
        "in_flight",
        "its request stays in flight",
    );
    std::test::assert_eq_str(
        one(c2, "SELECT (reclaimed_at IS NULL)::text FROM api_instance WHERE id = 'api-slow'"),
        "true",
        "and it is not marked",
    );

    // a reclaim that fails is left for the next tick, and the tick goes on
    run(
        c2,
        "UPDATE api_instance SET last_heartbeat_at = now() - interval '1 minute' WHERE id = 'api-slow'",
    );
    run(
        c2,
        "CREATE FUNCTION refuse_usage() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'refused for the test'; END $$",
    );
    run(
        c2,
        "CREATE TRIGGER refuse_usage BEFORE INSERT ON usage FOR EACH ROW EXECUTE FUNCTION refuse_usage()",
    );
    std::test::assert_eq_int(
        brain::reclaim(c2),
        0,
        "a reclaim whose statement fails reclaims nothing",
    );
    std::test::assert_eq_str(
        one(c2, "SELECT status FROM request WHERE id = 'resp_2'"),
        "in_flight",
        "and is rolled back",
    );
    let after_failure = brain::write_tick(c2, "voice", "", "");
    std::test::assert(
        after_failure.version > 0,
        "the route table is still written: " + after_failure.detail,
    );
    run(c2, "DROP TRIGGER refuse_usage ON usage");
    run(c2, "DROP FUNCTION refuse_usage()");
    std::test::assert_eq_int(brain::reclaim(c2), 1, "and the next tick reclaims it");
    run(
        c2,
        "INSERT INTO api_instance (id, last_heartbeat_at) VALUES ('api-gone', now() - interval '1 minute')",
    );
    std::test::assert_eq_int(brain::reclaim(c2), 1, "a dead instance that held nothing");
    std::test::assert_eq_str(
        one(c2, "SELECT count(*) FROM api_instance WHERE id = 'api-gone'"),
        "0",
        "goes",
    );

    // liveness and the route table
    run(c2, brain::LIVENESS);
    std::test::assert_eq_str(
        one(c2, "SELECT status FROM node WHERE id = 'laptop'"),
        "up",
        "a node heartbeating is up",
    );
    let w = brain::write_tick(c2, "voice", "", "");
    let table = one(c2, "SELECT body::text FROM route_table");
    std::test::assert(
        std::str::contains(table, "\"seat\": \"laptop/static\""),
        "its seat routes: " + table,
    );
    std::test::assert(std::str::contains(table, "\"free\": 4"), "with its free slots");
    let store = st::PgStore { url: url };
    let read = store.route_table() or "";
    std::test::assert_eq_int(
        std::json::find_int_field(read, "version"),
        w.version,
        "the api reads the table with its version",
    );
    std::test::assert(
        std::str::ends_with(std::json::find_string_field(read, "at"), "Z")
            && std::str::contains(read, "laptop/static"),
        "its time and its routes",
    );
    // the board, in the same transaction: its version from the store's
    // clock, the seat not held and consuming its own queue and its model's,
    // and the node's plan handed over with it
    std::test::assert(
        w.board.version > 0 && w.board.worked,
        "the board is written: " + w.board.step + " " + w.board.detail,
    );
    std::test::assert_eq_str(
        one(c2, "SELECT version::text FROM board"),
        to_string(w.board.version),
        "the board's row is at the version handed over",
    );
    let seat_row = one(
        c2,
        "SELECT s::text FROM board, jsonb_array_elements(body->'seats') s WHERE s->>'seat' = 'laptop/static'",
    );
    std::test::assert(
        std::str::contains(seat_row, "\"hold\": null")
            && std::str::contains(
                seat_row,
                "\"consume\": [\"voice.work.s.laptop.static\", \"voice.work.m.echo-1.internal.any\", \"voice.work.p.echo-1.static.internal.any\"]",
            ),
        "its seat consumes its own queue, then its model's: " + seat_row,
    );
    std::test::assert(
        std::str::starts_with(w.board.plans, "laptop\t[{\"seat\": \"static\"")
            && std::str::contains(w.board.subjects, "voice.work.s.laptop.static\n"),
        "the node's plan and the queues, handed over: " + w.board.plans,
    );
    std::test::assert(
        std::str::ends_with(std::json::find_string_field(store.board() or "", "at"), "Z"),
        "the api reads the board with its time",
    );
    // the ledger's last minute: a model's service time, its seat's
    // `engine_ms`, else the wall time less the queue's; a value that is no
    // number counts as none, and an old request not at all
    run(
        c2,
        "INSERT INTO usage (id, created_at, project, key, account, requested_model, status, served, record) VALUES ('resp_a', now(), 'work', 'k_1', 'static', 'echo-1', 'served', '{\"seat\": \"laptop/static\"}', '{\"resolved_model\": \"echo-1\", \"timing\": {\"wall_ms\": 900, \"queue_ms\": 100, \"engine_ms\": 700}}'), ('resp_b', now(), 'work', 'k_1', 'static', 'echo-1', 'served', '{\"seat\": \"laptop/static\"}', '{\"resolved_model\": \"echo-1\", \"timing\": {\"wall_ms\": 600, \"queue_ms\": 100, \"engine_ms\": \"x\"}}'), ('resp_c', now() - interval '5 minutes', 'work', 'k_1', 'static', 'echo-1', 'served', '{\"seat\": \"laptop/static\"}', '{\"resolved_model\": \"echo-1\", \"timing\": {\"wall_ms\": 90000, \"queue_ms\": 0, \"engine_ms\": 90000}}')",
    );
    let services = c2.query_params(brain::SERVICE_READ, db::Args { });
    std::test::assert(services.ok, "the service times are read: " + services.err.detail);
    std::test::assert(
        std::json::find_string_field(std::str::trim(services.csv), "model") == "echo-1"
            && std::json::find_int_field(std::str::trim(services.csv), "n") == 2
            && std::json::find_int_field(std::str::trim(services.csv), "service_ms") == 600,
        "echo-1's last minute: two requests, 700 and 500 ms: " + services.csv,
    );
    let boarded = brain::write_tick(c2, "voice", "", "");
    std::test::assert(
        std::str::contains(
            one(
                c2,
                "SELECT q::text FROM board, jsonb_array_elements(body->'queues') q WHERE q->>'subject' = 'voice.work.m.echo-1.internal.any'",
            ),
            "\"service_ms\": 600",
        ) && boarded.board.version > w.board.version,
        "the board's queue carries its model's service time, at a later version",
    );
    run(c2, "DELETE FROM usage WHERE id IN ('resp_a', 'resp_b', 'resp_c')");
    // a placement's seat as a store from before holds it (its row's
    // concurrency 1): free up to what its runtime is started with
    run(
        c2,
        "INSERT INTO seat (node, id, engine, account, serves, concurrency, config) VALUES ('laptop', 'tf', 'managed', 'static', '[{\"model\": \"echo-1\", \"as\": null}]', 1, '{\"placement\": \"tf\", \"model\": \"echo-1\", \"context_length\": 1048576, \"cache_tokens\": 7340032, \"runtime\": {\"id\": \"tensorfold-0.7.5\", \"server\": \"tensorfold\"}}')",
    );
    run(
        c2,
        "INSERT INTO seat_state (node, seat, status, in_flight, reported_at) VALUES ('laptop', 'tf', 'up', 1, now())",
    );
    brain::write_tick(c2, "voice", "", "");
    let placed = one(c2, "SELECT body::text FROM route_table");
    std::test::assert(
        std::str::contains(placed, "\"seat\": \"laptop/tf\"")
            && std::str::contains(placed, "\"free\": 31"),
        "a TensorFold seat has 31 of its 32 free: " + placed,
    );
    // the version goes on past the stored one, whatever the clock says
    run(c2, "UPDATE route_table SET version = 9000000000000");
    std::test::assert_eq_int(
        brain::write_tick(c2, "voice", "", "").version,
        9000000000001,
        "a version is never below the one before it",
    );
    // a use just under 100%, written back as the api writes a quota report,
    // leaves the account headroom: its seat still routes
    let near = api::read_window(
        "{\"name\": \"five_hour\", \"used_percent\": 99.999995, \"observed_at\": \"2026-10-17T00:00:00Z\", \"resets_at\": \"2099-01-01T00:00:00Z\"}",
    ) or api::QuotaWindow { name: "", used_percent: 0.0, observed_at: `1970-01-01T00:00:00Z` };
    let mut report = api::QuotaWindows { };
    push(report.items, near) or discard;
    store.put_windows(
        "static",
        api::windows_json(report.items),
    ) or std::test::assert(false, "the windows are written");
    std::test::assert_eq_str(
        one(c2, "SELECT used_percent::text FROM quota_window WHERE account = 'static'"),
        "99.999995",
        "the use as reported",
    );
    brain::write_tick(c2, "voice", "", "");
    std::test::assert(
        std::str::contains(one(c2, "SELECT body::text FROM route_table"), "laptop/static"),
        "a seat whose account is at 99.999995% still routes",
    );
    run(c2, "DELETE FROM quota_window WHERE account = 'static'");
    run(
        c2,
        "INSERT INTO quota_window (account, name, used_percent, resets_at, observed_at) VALUES ('static', 'five_hour', 100, now() + interval '1 hour', now())",
    );
    brain::write_tick(c2, "voice", "", "");
    let full = one(c2, "SELECT body::text FROM route_table");
    std::test::assert(
        !std::str::contains(full, "laptop/static"),
        "an exhausted account's seat does not route",
    );
    let echo = std::json::array_first(std::json::find_field_raw(full, "models")).element;
    let gone = std::json::array_first(std::json::find_field_raw(echo, "exhausted")).element;
    std::test::assert(
        std::json::find_string_field(gone, "account") == "static"
            && len(std::json::find_string_field(gone, "until")) > 0,
        "the account is listed exhausted, with its reset: " + full,
    );
    run(c2, "UPDATE node_state SET last_heartbeat_at = now() - interval '1 minute'");
    run(c2, brain::LIVENESS);
    std::test::assert_eq_str(
        one(c2, "SELECT status FROM node WHERE id = 'laptop'"),
        "down",
        "a silent node is down",
    );

    // the queues the seats configured to serve make (work.hl): a silent
    // node's seats still make theirs, its engines' kinds undeclared so
    // neither carries tools; a seat on a node that declares its engine
    // carries them as its config says; a disabled seat, a pair's follower, a revoked
    // node's seat and a model the catalog no longer holds make none
    run(c2, "UPDATE catalog_model SET removed_at = now() WHERE id = 'idle-1'");
    run(
        c2,
        "INSERT INTO node (id, name, token_digest, assignment_version, status) VALUES ('spark', 'Spark', '\\x00', 1, 'up'), ('old', 'Old', '\\x00', 1, 'revoked')",
    );
    run(
        c2,
        "INSERT INTO node_state (node, version, capabilities, local, registered_at, last_heartbeat_at, applied_version) VALUES ('spark', '0.1.0', '{\"engines\": [{\"id\": \"llama\", \"kind\": \"managed\"}]}', '{\"paused\": false, \"paused_seats\": []}', now(), now(), 1)",
    );
    run(
        c2,
        "INSERT INTO seat (node, id, engine, account, serves, data_classes, enabled, config) VALUES ('spark', 'coder', 'llama', 'static', '[{\"model\": \"echo-1\", \"as\": \"e\"}, {\"model\": \"idle-1\", \"as\": null}]', '{internal,public}', true, '{\"runtime\": {\"server\": \"llama-server\"}, \"variant\": {\"files\": []}}'), ('spark', 'off', 'llama', 'static', '[{\"model\": \"echo-1\", \"as\": null}]', '{secret}', false, '{}'), ('spark', 'follower', 'llama', 'static', '[{\"model\": \"echo-1\", \"as\": null}]', '{secret}', true, '{\"cluster\": {\"rank\": 1, \"peer\": \"laptop\"}}'), ('old', 'gone', 'llama', 'static', '[{\"model\": \"echo-1\", \"as\": null}]', '{secret}', true, '{}')",
    );
    let seats = c2.query_params(brain::WORK_READ, db::Args { });
    std::test::assert(seats.ok, "the seats' queues are read: " + seats.err.detail);
    std::test::assert_eq_str(
        brain::partitions("voice", seats.csv),
        "voice.work.s.laptop.static\nvoice.work.m.echo-1.internal.any\nvoice.work.s.laptop.tf\nvoice.work.s.spark.coder\nvoice.work.m.echo-1.internal.tools\nvoice.work.m.echo-1.public.any\nvoice.work.m.echo-1.public.tools\n",
        "the queues of the seats configured to serve, whether up or not",
    );
    c2.close();
    if std::env::var_exists("VOICE_TEST_NATS_URL") {
        controller(url, std::env::var("VOICE_TEST_NATS_URL"));
    }
}

/// What a tick leaves for the next: the keeper's readings and the seats'
/// orders; and the plan of node `n` it published, "" for none.
type Ticked { readings: String = ""; orders: String = ""; plan: String = ""; version: Int = 0; }

/// One tick of the working brain, as `Brain.tick` and its keeper's pass
/// make it, under `root`: the board written, the stream and consumers
/// kept, the plans published (`sent`), the queues read back; node `n`'s
/// plan as `listener` heard it.
@unbounded
fn tick(
    c: pq::PgConn,
    nc: nats::NatsClient,
    listener: nats::NatsClient,
    root: String,
    sent: brain::SentPlans,
    was: Ticked
) -> Ticked {
    let w = brain::write_tick(c, root, was.readings, was.orders);
    std::test::assert(
        w.version > 0 && w.board.version > 0,
        "a tick writes the board: " + w.step + w.board.step + " " + w.detail + w.board.detail,
    );
    let u = brain::upkeep(nc, root, w.board.subjects, false);
    std::test::assert(len(u.step) == 0, "the stream is kept: " + u.detail);
    let e = brain::publish_plans(
        nc,
        root,
        w.board.plans,
        w.board.version,
        1,
        sent,
        std::time::monotonic_ns() / 1000000,
    );
    std::test::assert(len(e.kind) == 0, "the plans are published: " + e.detail);
    let r = brain::read_queues(
        nc,
        root,
        w.board.subjects,
        std::time::nanos(std::time::current()) / 1000000,
    );
    std::test::assert(len(r.step) == 0, "the queues are read: " + r.detail);
    let mut plan = "";
    while listener.read_msg(200ms) {
        plan = std::str::from_bytes(listener.last.data);
    }
    return Ticked {
        readings: r.lines,
        orders: w.board.orders,
        plan: plan,
        version: w.board.version,
    };
}

/// Seat `id`'s queues in `plan` (a `ConsumePlan`), space-separated, or
/// `held: <why>`; "?" when the plan does not name it.
fn consumes(plan: String, id: String) -> String {
    let p = work::consume_plan_of(plan) or { return "?"; };
    for s in p.seats {
        if s.seat == id {
            if len(s.hold) > 0 { return "held: " + s.hold; }
            let mut out = "";
            for q in s.consume {
                out = if len(out) == 0 { q } else { out + " " + q };
            }
            return out;
        }
    }
    return "?";
}

/// The controller over Postgres and a JetStream-enabled NATS, a root of its
/// own: node `n`'s seat `multi` serves two models, `solo` one.
@unbounded
fn controller(url: String, nats_url: String) {
    let c = connect(url);
    std::test::assert(c.open().ok, "the test database answers");
    run(c, "SET TIME ZONE 'UTC'");
    run(
        c,
        "TRUNCATE route_table, board, usage, request, api_instance, quota_window, seat_state, node_state, seat, node, api_key, project, account, catalog_model RESTART IDENTITY CASCADE",
    );
    run(c, "INSERT INTO catalog_model (id, kind) VALUES ('echo-1', 'local'), ('late', 'local')");
    run(c, "INSERT INTO account (id, name, billing) VALUES ('local', 'Local', 'none')");
    run(
        c,
        "INSERT INTO node (id, name, token_digest, assignment_version, status) VALUES ('n', 'N', '\\x00', 1, 'up')",
    );
    run(
        c,
        "INSERT INTO node_state (node, version, capabilities, local, registered_at, last_heartbeat_at, applied_version) VALUES ('n', '0.1.0', '{\"engines\": [{\"id\": \"static\", \"kind\": \"static\"}]}', '{\"paused\": false, \"paused_seats\": []}', now(), now(), 1)",
    );
    run(
        c,
        "INSERT INTO seat (node, id, engine, account, serves, concurrency, config) VALUES ('n', 'multi', 'static', 'local', '[{\"model\": \"echo-1\", \"as\": null}, {\"model\": \"late\", \"as\": null}]', 1, '{\"text\": \"hi\"}'), ('n', 'solo', 'static', 'local', '[{\"model\": \"echo-1\", \"as\": null}]', 1, '{\"text\": \"hi\"}')",
    );
    run(
        c,
        "INSERT INTO seat_state (node, seat, status, in_flight, reported_at) VALUES ('n', 'multi', 'up', 0, now()), ('n', 'solo', 'up', 0, now())",
    );
    let nc = nats::NatsClient { url: nats_url, name: "controller-test", timeout: 2s };
    std::test::assert(nc.open(), "the test NATS answers: " + nc.last_error);
    let listener = nats::NatsClient { url: nats_url, name: "controller-listener", timeout: 2s };
    std::test::assert(listener.open(), "and takes a second connection");
    let rand = std::os::getrandom(6) or std::bytes::from_string("fixed");
    let root = "test.e1" + std::hex::encode(rand);
    listener.sub_to(work::consume_subject(root, "n"), "") or {
        std::test::assert(false, "the listener subscribes: " + err.detail);
        return;
    };
    listener.flush() or discard;
    let sent = brain::SentPlans { };
    let echo = root + ".work.m.echo-1.internal.any";
    let late = root + ".work.m.late.internal.any";
    let own = root + ".work.s.n.multi";
    // last, each partition in the other shape, as a node with no plan
    // consumes both
    let leftovers = " " + root + ".work.p.echo-1.local.internal.any " + root
        + ".work.p.late.local.internal.any";
    let base = own + " " + echo + " " + late + leftovers;

    // the first tick: each seat its own queue, then configuration's order
    let mut t = tick(c, nc, listener, root, sent, Ticked { });
    std::test::assert_eq_str(consumes(t.plan, "multi"), base, "multi in configuration's order");
    std::test::assert_eq_str(
        consumes(t.plan, "solo"),
        root + ".work.s.n.solo " + echo + " " + root + ".work.p.echo-1.local.internal.any",
        "solo its own, then echo-1's",
    );
    std::test::assert_eq_int(
        std::json::find_int_field(t.plan, "version"),
        t.version,
        "the plan's version is the board's",
    );
    let first_version = t.version;
    t = tick(c, nc, listener, root, sent, t);
    std::test::assert_eq_str(t.plan, "", "an unchanged plan is not published again at once");

    // late's queue backs up: three ticks of its pressure after the keeper
    // read it, and multi takes it first
    let mut i = 0;
    while i < 5 {
        nats::js_publish(nc, late, b"{}") or {
            std::test::assert(false, "a ticket on late's queue: " + err.detail);
        };
        i = i + 1;
    }
    std::time::sleep(200ms);
    let mut ticks = 0;
    let mut moved = "";
    while ticks < 6 && len(moved) == 0 {
        t = tick(c, nc, listener, root, sent, t);
        ticks = ticks + 1;
        if len(t.plan) > 0 { moved = consumes(t.plan, "multi"); }
    }
    std::test::assert_eq_str(
        moved,
        own + " " + late + " " + echo + leftovers,
        "a backlog on late's queue moves multi to it, after its own",
    );
    std::test::assert(
        ticks >= 3 && ticks <= 4,
        "within the hysteresis's three ticks of the backlog being read: " + to_string(ticks),
    );
    std::test::assert(
        std::json::find_int_field(t.plan, "version") > first_version,
        "in a plan at a newer board's version",
    );
    let board = one(
        c,
        "SELECT q::text FROM board, jsonb_array_elements(body->'queues') q WHERE q->>'subject' = '"
            + late + "'",
    );
    std::test::assert(
        std::json::find_int_field(board, "depth") == 5
            && std::json::find_int_field(board, "oldest_age_ms") >= 200
            && std::str::contains(board, "\"seats\": [\"n/multi\"]"),
        "the board reads late's backlog and its oldest's age: " + board,
    );
    std::test::assert_eq_str(
        consumes(t.plan, "solo"),
        root + ".work.s.n.solo " + echo + " " + root + ".work.p.echo-1.local.internal.any",
        "solo keeps its order",
    );

    // drained: back to configuration's order, three ticks after
    nats::js_call(
        nc,
        "$JS.API.STREAM.PURGE." + work::stream_name(root),
        "{\"filter\": \"" + late + "\"}",
    )
    or { std::test::assert(false, "late's queue drained: " + err.detail); };
    ticks = 0;
    moved = "";
    while ticks < 6 && len(moved) == 0 {
        t = tick(c, nc, listener, root, sent, t);
        ticks = ticks + 1;
        if len(t.plan) > 0 { moved = consumes(t.plan, "multi"); }
    }
    std::test::assert_eq_str(moved, base, "back to configuration's order once it drains");
    std::test::assert(ticks >= 3 && ticks <= 4, "within as many ticks: " + to_string(ticks));

    // an exhausted account: its seats held, why in the plan; and let go
    run(
        c,
        "INSERT INTO quota_window (account, name, used_percent, resets_at, observed_at) VALUES ('local', 'five_hour', 100, now() + interval '1 hour', now())",
    );
    t = tick(c, nc, listener, root, sent, t);
    std::test::assert(
        std::str::starts_with(
            consumes(t.plan, "multi"),
            "held: its account local is exhausted until ",
        )
            && std::str::starts_with(
                consumes(t.plan, "solo"),
                "held: its account local is exhausted",
            ),
        "an exhausted account's seats are held, pulling nothing: " + t.plan,
    );
    run(c, "DELETE FROM quota_window");
    t = tick(c, nc, listener, root, sent, t);
    std::test::assert_eq_str(consumes(t.plan, "multi"), base, "and let go once it has headroom");

    nats::js_stream_delete(nc, work::stream_name(root)) or discard;
    listener.close();
    nc.close();
    c.close();
}
