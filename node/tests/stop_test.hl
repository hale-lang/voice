// What a node started is stopped when its service stops (run.hl
// `stop_left`, the unit's `ExecStop` by `voice-node stop-seats`), as when a
// node starts it stops what one that stopped left: each process by the pid
// file it wrote, only if it is the process that began then, and the file
// gone. A server here is started as a seat's is, in the background by a
// shell that says its pid.
import ".." as node;

fn main() {
    let data = "/tmp/voice-stop-test-" + to_string(std::time::monotonic_ns());
    std::io::fs::mkdir(data) or discard;
    std::io::fs::mkdir(data + "/run") or discard;
    let o = std::process::run(
        "sh\n-c\n\"$@\" > \"$0\" 2>&1 & echo $!\n" + data + "/server.log\nsleep\n300",
    )
    or std::process::ProcessOutput { code: 1, signal: 0, stdout: "", stderr: "" };
    let pid = std::str::parse_int(std::str::trim(o.stdout)) or 0;
    std::test::assert(pid > 0 && node::alive(pid), "a server running: " + o.stdout);
    std::io::fs::write_file(
        data + "/run/s1.pid",
        to_string(pid) + "\t" + node::started_at(pid) + "\n",
    )
    or discard;
    // a pid file for a process long gone, whose number now names another
    std::io::fs::write_file(data + "/run/s2.pid", "1\tnot when it began\n") or discard;

    node::stop_left("stop-test", data);

    let mut i = 0;
    while i < 80 && node::alive(pid) {
        std::time::sleep(100ms);
        i = i + 1;
    }
    std::test::assert(
        !node::alive(pid),
        "the server the node started is stopped, killed once it held the signal",
    );
    std::test::assert(node::alive(1), "a process the node did not start is left alone");
    std::test::assert(
        !std::io::fs::file_exists(data + "/run/s1.pid")
            && !std::io::fs::file_exists(data + "/run/s2.pid"),
        "and every pid file is gone",
    );
}
