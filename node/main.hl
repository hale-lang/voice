/// The voice node: runs the seats configured on this machine and serves
/// them to the coordinator. See ../node.yaml (its admin API) and
/// ../protocol.yaml (its connection to the coordinator).
///
/// `Admin` serves the admin API and `Session` holds the coordinator
/// connection, each on its own thread. They share state through the data
/// directory: seats are files under `seats/`, and the session writes its
/// state to `session.json`.
main locus Node {
    params {
        id: String = "";
        data: String = "node-data";
        admin: Admin = Admin { };
        session: Session = Session { };
    }
    placement {
        admin: pinned;
        session: pinned;
    }
    birth() {
        println("voice node ", self.id, ": data in ", self.data);
    }
}

const NODE_VERSION: String = "0.1.0-dev";

/// `node --id ID [--coordinator URL] [--token T] [--data DIR] [--host H] [--port N]`
fn main() {
    let mut id = "";
    let mut coordinator = "ws://127.0.0.1:8080/node/v1/connect";
    let mut token = std::env::var("VOICE_ENROLLMENT_TOKEN");
    let mut data = "node-data";
    let mut host = "127.0.0.1";
    let mut port = 8081;
    let mut i = 1;
    while i + 1 < std::env::args_count() {
        let flag = std::env::arg(i);
        let value = std::env::arg(i + 1);
        if flag == "--id" {
            id = value;
        } else if flag == "--coordinator" {
            coordinator = value;
        } else if flag == "--token" {
            token = value;
        } else if flag == "--data" {
            data = value;
        } else if flag == "--host" {
            host = value;
        } else if flag == "--port" {
            port = std::str::parse_int(value) or port;
        }
        i = i + 2;
    }
    if len(id) == 0 {
        println("usage: node --id ID [--coordinator URL] [--token T] [--data DIR] [--host H] [--port N]");
        std::process::exit(2);
    }
    ensure_data_dir(data);
    Node {
        id: id,
        data: data,
        admin: Admin { id: id, data: data, host: host, port: port },
        session: Session { id: id, data: data, coordinator: coordinator, token: token }
    };
}

fn ensure_data_dir(data: String) {
    if !std::io::fs::file_exists(data) {
        std::io::fs::mkdir(data) or discard;
    }
    if !std::io::fs::file_exists(data + "/seats") {
        std::io::fs::mkdir(data + "/seats") or discard;
    }
}
