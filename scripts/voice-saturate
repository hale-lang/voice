#!/usr/bin/env python3
"""Saturate a running voice with requests and report what it did.

  voice-saturate -d 10 coder-med:4 coder-big:4 # each model sent 4 requests a second for 10 s
  voice-saturate --sweep 1,2,4,8,16 -d 60 --csv curve.csv coder-big coder-med
                                               # each model alone, at 1, 2, 4, 8 and 16 in flight:
                                               # its concurrency / tokens-per-second curve
  voice-saturate coder qwen3-0.6b              # one 60 s round, 4-32 in flight
  voice-saturate -r 4 coder                    # four rounds, each at its own concurrency
  voice-saturate -c 16 -d 120 coder            # 16 in flight for 120 s
  voice-saturate -c 4-32 -r 3 -n 512 coder     # 3 rounds, 4..32 in flight, 512 tokens each
  voice-saturate --local                       # the voice on this machine, every chat model
  VOICE_API=http://voice.example:8080 voice-saturate coder

A model named as `model:RATE` is sent RATE new requests a second for the
round's duration, whether or not the earlier ones have finished (a fixed
arrival rate: what the model cannot keep up with shows as latency, queueing
and refusals); each model at its own rate, all at once, never more than
--max-inflight open. Named without a rate, the round instead keeps N
requests in flight (a new one starts as soon as one ends), cycling through
the models; with -c MIN-MAX each round draws its N between MIN and MAX. The
two are not mixed in one run. Every request streams, so time to first token
is measured. With no models named, every chat model the key may use (never
a decision model: those answer schemas). Each request asks one of a set of
coding prompts (or --prompt), with `/no_think` added.

A decision model (one whose contract is `decision`) is loaded only when
named, alone or beside chat models, in either mode: each request is one
coding question with a choice or yes/no answer schema (--prompt asks a
yes/no question instead), answered whole, so its row reports decisions a
second and how many answers came back without a decision, in place of
tokens.

Per round and per model it prints: requests ok and failed (by status and
voice's error code: 429 no_capacity, 502, 413, ...), latency and time to
first token (p50 / p95 / max), output tokens per second, per request and in
aggregate, and how many ok requests were cut at max tokens (finish
`length`). --sweep prints one row per model and concurrency instead.

Environment:
  VOICE_API        voice's address, e.g. http://voice.example:8080
                   (required unless --local)
  VOICE_API_KEY    a project key (vk-...)
  VOICE_KEY_FILE   else, a file holding the key: the key alone, or a curl
                   header line `Authorization: Bearer vk-...`
"""
import argparse
import json
import os
import random
import statistics
import sys
import threading
import time
import urllib.error
import urllib.request
from collections import defaultdict

LOCAL_API = "http://127.0.0.1:8080"

# questions a decision model answers: the text and its choices ("" asks
# yes or no)
DECISIONS = [
    ("How risky is merging a schema migration on a Friday afternoon?", "low,medium,high"),
    ("Is a mutex or a channel the better fit for a counter several goroutines bump?", "mutex,channel"),
    ("Should a 400-line function that parses, validates and writes a file be split?", ""),
    ("Which review comment matters most: a missing test, a typo, or a slow loop?", "missing test,typo,slow loop"),
    ("Does an unbounded retry loop on a 500 need a backoff?", ""),
    ("Which belongs in a commit message: what changed, why, or the ticket number?", "what changed,why,ticket number"),
]
# decision models among those served, by id (main fills it)
DECIDES = set()

PROMPTS = [
    "Write a Python function that parses an ISO 8601 duration like 'PT1H30M5S' into seconds, with tests.",
    "Implement an LRU cache in Go with Get and Put in O(1). Explain the data structures you chose.",
    "This Rust code fails the borrow checker: `let first = &v[0]; v.push(4); println!(\"{}\", first);`. Explain why and fix it.",
    "Write a SQL query that returns each customer's three most recent orders from orders(id, customer_id, created_at, total).",
    "Refactor this JavaScript to async/await and handle errors: `fetch(url).then(r => r.json()).then(d => render(d)).catch(console.log)`.",
    "Write a bash script that finds the ten largest files under a directory, skipping .git, and prints sizes in human-readable form.",
    "Implement binary search in TypeScript over a sorted array of numbers, returning the insertion index when the value is absent.",
    "Explain what a race condition is in this Python code and fix it: two threads doing `counter += 1` on a shared global.",
    "Write a Python generator that reads a large CSV file in chunks and yields rows where the 'status' column is 'failed'.",
    "Design a REST API for a todo app: list the endpoints, request and response JSON, and status codes for errors.",
    "Write a C function that reverses a singly linked list in place, and walk through it on a three-node list.",
    "Given a Dockerfile that copies the whole repo before `pip install -r requirements.txt`, explain why rebuilds are slow and rewrite it.",
    "Write a regular expression that matches IPv4 addresses with each octet 0-255, and explain each part.",
    "Implement a token-bucket rate limiter in Python that is safe to call from several threads.",
    "Write unit tests with pytest for a function `slugify(title: str) -> str` that lowercases, trims and joins words with dashes.",
    "Explain the difference between a mutex and a semaphore with a short Go example of each.",
]


def parse_args():
    p = argparse.ArgumentParser(
        description="Send a running voice requests for a while, open-loop (model:RATE) or N in flight, and report.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__.split("\n\n", 1)[1],
    )
    p.add_argument("models", nargs="*", help="model, or model:RATE in requests a second (default: every chat model)")
    p.add_argument("--local", action="store_true", help=f"use the voice on this machine, {LOCAL_API} (otherwise VOICE_API names it)")
    p.add_argument("-c", "--concurrency", default="4-32", help="without rates: N in flight, or MIN-MAX drawn per round (default 4-32)")
    p.add_argument("-d", "--duration", type=float, default=60, help="seconds per round (default 60)")
    p.add_argument("-r", "--rounds", type=int, default=1, help="rounds (default 1)")
    p.add_argument("-n", "--max-tokens", type=int, default=2048, help="max output tokens per request (default 2048; one that reaches it ends `length`, which voice shows as incomplete)")
    p.add_argument("--timeout", type=float, default=300, help="seconds before one request is given up (default 300)")
    p.add_argument("--prompt", help="ask this every time instead of the built-in prompts")
    p.add_argument("--sweep", help="N,N,...: each model alone at each concurrency in turn, -d seconds a step; prints the curve")
    p.add_argument("--csv", help="with --sweep: also write the curve to this CSV file")
    p.add_argument("--max-inflight", type=int, default=512, help="with rates: never more than this many open at once; the rest are counted as shed (default 512)")
    return p.parse_args()


def endpoint(args):
    """voice's address: --local, else VOICE_API; never a default of our own."""
    if args.local:
        return LOCAL_API
    api = os.environ.get("VOICE_API", "").strip()
    if not api:
        print("voice-saturate: set VOICE_API to voice's address (e.g. VOICE_API=http://voice.example:8080), "
              f"or pass --local for {LOCAL_API}", file=sys.stderr)
        sys.exit(2)
    return api.rstrip("/")


def key_header():
    """The Authorization header's value, from VOICE_API_KEY, else the file
    VOICE_KEY_FILE names (the key alone, or `Authorization: Bearer vk-...`).
    The key itself is never printed."""
    key = os.environ.get("VOICE_API_KEY", "").strip()
    path = os.environ.get("VOICE_KEY_FILE", "")
    if not key and path:
        try:
            lines = [ln.strip() for ln in open(path).read().splitlines() if ln.strip()]
        except OSError as e:
            sys.exit(f"voice-saturate: cannot read VOICE_KEY_FILE ({path}): {e.strerror}")
        line = lines[0] if lines else ""
        name, sep, value = line.partition(":")
        if sep and name.strip().lower() == "authorization":
            line = value.strip()
        if line.lower().startswith("bearer "):
            line = line[7:].strip()
        key = line
        if not key:
            sys.exit(f"voice-saturate: VOICE_KEY_FILE ({path}) holds no key")
    if not key:
        sys.exit("voice-saturate: no key: set VOICE_API_KEY, or VOICE_KEY_FILE to a file holding it")
    if any(c.isspace() for c in key):
        sys.exit("voice-saturate: the key holds characters a key does not")
    return "Bearer " + key


def get_json(url, auth, timeout=10):
    req = urllib.request.Request(url, headers={"Authorization": auth})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def concurrency_range(spec):
    lo, _, hi = spec.partition("-")
    lo, hi = int(lo), int(hi or lo)
    if lo < 1 or hi < lo:
        sys.exit(f"voice-saturate: -c {spec}: want N or MIN-MAX with 1 <= MIN <= MAX")
    return lo, hi


class Result:
    __slots__ = ("model", "ok", "status", "code", "ttft", "latency", "tokens", "finish", "undecided")

    def __init__(self, model):
        self.model, self.ok, self.status, self.code = model, False, 0, ""
        self.ttft = self.latency = None
        self.tokens = 0
        self.finish = ""
        self.undecided = False


def one_decision(api, auth, model, prompt, timeout):
    res = Result(model)
    text, choices = (prompt, "") if prompt else random.choice(DECISIONS)
    if choices:
        answer = {"type": "string", "enum": choices.split(","), "description": text}
    else:
        answer = {"type": "boolean", "description": text}
    body = json.dumps({
        "model": model,
        "messages": [{"role": "user", "content": text}],
        "response_format": {"type": "json_schema", "json_schema": {
            "name": "decide",
            "schema": {"type": "object", "properties": {"answer": answer}, "required": ["answer"]},
        }},
    }).encode()
    req = urllib.request.Request(
        api + "/v1/chat/completions", data=body, method="POST",
        headers={"Authorization": auth, "Content-Type": "application/json"},
    )
    start = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            res.status = r.status
            reply = json.loads(r.read().decode("utf-8", "replace"))
        res.ttft = time.monotonic() - start  # answered whole: its first byte is its last
        res.ok = True
        # an answer without voice's decision is a reply, not a decision
        res.undecided = not ((reply.get("voice") or {}).get("decision") or {}).get("answer")
        res.tokens = (reply.get("usage") or {}).get("completion_tokens") or 0
    except urllib.error.HTTPError as e:
        res.status = e.code
        try:
            err = json.loads(e.read().decode("utf-8", "replace"))
            err = err.get("error") or err.get("refusal") or {}
            res.code = str(err.get("code") or err.get("kind") or err.get("type") or "")
        except Exception:
            pass
    except Exception as e:  # a reset, a timeout, voice gone
        res.code = type(e).__name__
    res.latency = time.monotonic() - start
    return res


def one_request(api, auth, model, prompt, max_tokens, timeout):
    if model in DECIDES:
        # a coding prompt is the chat models'; --prompt is asked yes or no
        return one_decision(api, auth, model, "" if prompt in PROMPTS else prompt, timeout)
    res = Result(model)
    body = json.dumps({
        "model": model,
        "stream": True,
        "stream_options": {"include_usage": True},
        "max_tokens": max_tokens,
        "messages": [{"role": "user", "content": prompt + " /no_think"}],
    }).encode()
    req = urllib.request.Request(
        api + "/v1/chat/completions", data=body, method="POST",
        headers={"Authorization": auth, "Content-Type": "application/json"},
    )
    start = time.monotonic()
    chunks = 0
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            res.status = r.status
            for raw in r:
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    ev = json.loads(data)
                except ValueError:
                    continue
                if ev.get("error"):
                    res.code = str(ev["error"].get("code") or ev["error"].get("type") or "stream_error")
                    break
                choices = ev.get("choices") or []
                delta = (choices[0].get("delta") or {}) if choices else {}
                # a thinking model streams its reasoning first: a token either way
                if delta.get("content") or delta.get("reasoning_content") or delta.get("reasoning"):
                    if res.ttft is None:
                        res.ttft = time.monotonic() - start
                    chunks += 1
                if choices and choices[0].get("finish_reason"):
                    res.finish = choices[0]["finish_reason"]
                usage = ev.get("usage")
                if usage and usage.get("completion_tokens"):
                    res.tokens = usage["completion_tokens"]
            res.ok = not res.code
    except urllib.error.HTTPError as e:
        res.status = e.code
        try:
            err = json.loads(e.read().decode("utf-8", "replace"))
            err = err.get("error") or err.get("refusal") or {}
            res.code = str(err.get("code") or err.get("kind") or err.get("type") or "")
        except Exception:
            pass
    except Exception as e:  # a reset, a timeout, voice gone
        res.code = type(e).__name__
    res.latency = time.monotonic() - start
    if res.ok and not res.tokens:
        res.tokens = chunks  # no usage in the stream: a chunk is about a token
    return res


def pct(xs, p):
    if not xs:
        return None
    xs = sorted(xs)
    return xs[min(len(xs) - 1, int(round(p / 100 * (len(xs) - 1))))]


def fmt_s(x):
    return "-" if x is None else f"{x:.2f}s"


def run_round(api, auth, models, n, duration, args):
    results, lock = [], threading.Lock()
    deadline = time.monotonic() + duration
    turn = [random.randrange(len(models))]

    def worker():
        while time.monotonic() < deadline:
            with lock:
                model = models[turn[0] % len(models)]
                turn[0] += 1
            prompt = args.prompt or random.choice(PROMPTS)
            r = one_request(api, auth, model, prompt, args.max_tokens, args.timeout)
            with lock:
                results.append(r)

    started = time.monotonic()
    threads = [threading.Thread(target=worker, daemon=True) for _ in range(n)]
    for t in threads:
        t.start()
    tty = sys.stdout.isatty()
    while any(t.is_alive() for t in threads):
        time.sleep(1)
        if not tty:
            continue
        with lock:
            done = len(results)
            okc = sum(r.ok for r in results)
        left = deadline - time.monotonic()
        state = f"{left:4.0f}s left" if left > 0 else "finishing the last requests"
        print(f"\r  {n} in flight · {done} done ({okc} ok) · {state}   ", end="", flush=True)
    wall = time.monotonic() - started
    if tty:
        print("\r" + " " * 78 + "\r", end="")
    return results, wall


def run_rates(api, auth, rates, duration, args):
    """Each (model, rate) sent `rate` requests a second for `duration`,
    open-loop; then every request still open is waited for."""
    results, lock = [], threading.Lock()
    inflight, peak, shed, sent = [0], [0], defaultdict(int), defaultdict(int)
    threads = []

    def fire(model):
        prompt = args.prompt or random.choice(PROMPTS)
        r = one_request(api, auth, model, prompt, args.max_tokens, args.timeout)
        with lock:
            results.append(r)
            inflight[0] -= 1

    def pacer(model, rate):
        interval = 1.0 / rate
        start = time.monotonic()
        k = 0
        while True:
            at = start + k * interval
            if at - start >= duration:
                return
            now = time.monotonic()
            if at > now:
                time.sleep(at - now)
            with lock:
                if inflight[0] >= args.max_inflight:
                    shed[model] += 1
                    k += 1
                    continue
                inflight[0] += 1
                peak[0] = max(peak[0], inflight[0])
                sent[model] += 1
            t = threading.Thread(target=fire, args=(model,), daemon=True)
            t.start()
            with lock:
                threads.append(t)
            k += 1

    started = time.monotonic()
    pacers = [threading.Thread(target=pacer, args=(m, r), daemon=True) for m, r in rates]
    for t in pacers:
        t.start()
    tty = sys.stdout.isatty()
    while any(t.is_alive() for t in pacers) or inflight[0] > 0:
        time.sleep(1)
        if not tty:
            continue
        with lock:
            done, okc, open_ = len(results), sum(r.ok for r in results), inflight[0]
        left = duration - (time.monotonic() - started)
        state = f"{left:4.0f}s left" if left > 0 else "finishing the open requests"
        print(f"\r  {done} done ({okc} ok) · {open_} open · {state}   ", end="", flush=True)
    wall = time.monotonic() - started
    if tty:
        print("\r" + " " * 78 + "\r", end="")
    for m, r in rates:
        line = f"  {m}: offered {r:g}/s, sent {sent[m]} ({sent[m] / duration:.2f}/s)"
        if shed[m]:
            line += f", {shed[m]} shed at {args.max_inflight} open"
        print(line)
    print(f"  most open at once: {peak[0]}")
    return results, wall


def curve_row(results, wall):
    ok = [r for r in results if r.ok]
    lat = [r.latency for r in ok]
    ttft = [r.ttft for r in ok if r.ttft is not None]
    per_req = [r.tokens / (r.latency - (r.ttft or 0)) for r in ok if r.tokens and r.latency > (r.ttft or 0)]
    return {
        "ok": len(ok), "fail": len(results) - len(ok),
        "cut": sum(1 for r in ok if r.finish == "length"),
        "tok_s_req": statistics.median(per_req) if per_req else 0.0,
        "tok_s_all": sum(r.tokens for r in ok) / wall if wall else 0.0,
        "ttft_p50": pct(ttft, 50), "ttft_p95": pct(ttft, 95),
        "lat_p50": pct(lat, 50), "req_per_min": len(ok) / wall * 60 if wall else 0.0,
    }


def sweep(api, auth, models, levels, args):
    rows = []
    for m in models:
        print(f"{m}")
        print(f"  {'in flight':>9} {'ok':>4} {'fail':>4} {'cut':>4} {'tok/s per req':>13} {'tok/s total':>11} {'ttft p50/p95':>14} {'latency p50':>11} {'req/min':>8}")
        for n in levels:
            results, wall = run_round(api, auth, [m], n, args.duration, args)
            c = curve_row(results, wall)
            rows.append((m, n, c))
            print(
                f"  {n:>9} {c['ok']:>4} {c['fail']:>4} {c['cut']:>4} {c['tok_s_req']:>13.1f} {c['tok_s_all']:>11.1f} "
                f"{fmt_s(c['ttft_p50']) + '/' + fmt_s(c['ttft_p95']):>14} {fmt_s(c['lat_p50']):>11} {c['req_per_min']:>8.1f}"
            )
    if args.csv:
        with open(args.csv, "w") as f:
            f.write("model,in_flight,ok,fail,cut,tok_s_per_request,tok_s_total,ttft_p50,ttft_p95,latency_p50,req_per_min\n")
            for m, n, c in rows:
                f.write(f"{m},{n},{c['ok']},{c['fail']},{c['cut']},{c['tok_s_req']:.2f},{c['tok_s_all']:.2f},"
                        f"{c['ttft_p50'] or ''},{c['ttft_p95'] or ''},{c['lat_p50'] or ''},{c['req_per_min']:.2f}\n")
        print(f"curve written to {args.csv}")


def report(results, wall, models):
    by_model = defaultdict(list)
    for r in results:
        by_model[r.model].append(r)
    print(f"  {'model':<34} {'ok':>5} {'fail':>5}  {'latency p50/p95/max':<24} {'ttft p50/p95':<16} {'tok/s req':>9} {'tok/s all':>9}")
    for m in models:
        rs = by_model.get(m, [])
        ok = [r for r in rs if r.ok]
        lat = [r.latency for r in ok]
        ttft = [r.ttft for r in ok if r.ttft is not None]
        per_req = [r.tokens / (r.latency - (r.ttft or 0)) for r in ok if r.tokens and r.latency > (r.ttft or 0)]
        agg = sum(r.tokens for r in ok) / wall if wall else 0
        if m in DECIDES:
            print(
                f"  {m:<34} {len(ok):>5} {len(rs) - len(ok):>5}  "
                f"{fmt_s(pct(lat, 50)) + '/' + fmt_s(pct(lat, 95)) + '/' + fmt_s(max(lat) if lat else None):<24} "
                f"{'(answered whole)':<16}{len(ok) / wall if wall else 0:>9.1f} decisions/s"
            )
            undecided = sum(1 for r in ok if r.undecided)
            if undecided:
                print(f"      {undecided} of {len(ok)} ok came back without a decision (no voice.decision.answer)")
            fails = defaultdict(int)
            for r in rs:
                if not r.ok:
                    fails[f"{r.status or '-'} {r.code or 'error'}"] += 1
            for why, k in sorted(fails.items(), key=lambda kv: -kv[1]):
                print(f"      {k} × {why}")
            continue
        print(
            f"  {m:<34} {len(ok):>5} {len(rs) - len(ok):>5}  "
            f"{fmt_s(pct(lat, 50)) + '/' + fmt_s(pct(lat, 95)) + '/' + fmt_s(max(lat) if lat else None):<24} "
            f"{fmt_s(pct(ttft, 50)) + '/' + fmt_s(pct(ttft, 95)):<16}"
            f"{(statistics.median(per_req) if per_req else 0):>9.1f} {agg:>9.1f}"
        )
        cut = sum(1 for r in ok if r.finish == "length")
        if cut:
            print(f"      {cut} of {len(ok)} ok cut at max tokens (finish `length`: voice shows them incomplete; raise -n)")
        fails = defaultdict(int)
        for r in rs:
            if not r.ok:
                fails[f"{r.status or '-'} {r.code or 'error'}"] += 1
        for why, k in sorted(fails.items(), key=lambda kv: -kv[1]):
            print(f"      {k} × {why}")
    total_ok = sum(r.ok for r in results)
    print(f"  all: {total_ok}/{len(results)} ok in {wall:.0f}s, {sum(r.tokens for r in results if r.ok) / wall:.1f} output tok/s")


def main():
    args = parse_args()
    api = endpoint(args)
    auth = key_header()
    lo, hi = concurrency_range(args.concurrency)
    try:
        served = get_json(api + "/v1/models", auth)["data"]
    except Exception as e:
        sys.exit(f"voice-saturate: {api}/v1/models did not answer: {e}")
    chat = [m["id"] for m in served if (m.get("voice") or {}).get("contract") != "decision"]
    DECIDES.update(m["id"] for m in served if (m.get("voice") or {}).get("contract") == "decision")
    rates = []
    for spec in args.models:
        name, sep, rate = spec.rpartition(":")
        if sep and name:
            try:
                rate = float(rate)
            except ValueError:
                sys.exit(f"voice-saturate: {spec}: a rate is requests a second, e.g. {name}:4")
            if rate <= 0:
                sys.exit(f"voice-saturate: {spec}: the rate must be above 0")
            rates.append((name, rate))
    if rates and len(rates) != len(args.models):
        sys.exit("voice-saturate: name every model with a rate (model:RATE) or none of them")
    models = [m for m, _ in rates] or args.models or chat
    unknown = [m for m in models if m not in {s["id"] for s in served}]
    if unknown:
        sys.exit(f"voice-saturate: not served to this key: {', '.join(unknown)} (served: {', '.join(s['id'] for s in served)})")
    if not models:
        sys.exit(f"voice-saturate: {api} serves this key no chat model yet")
    if args.sweep:
        if rates:
            sys.exit("voice-saturate: --sweep holds a number in flight; name models without a rate")
        try:
            levels = [int(x) for x in args.sweep.split(",") if x.strip()]
        except ValueError:
            sys.exit(f"voice-saturate: --sweep {args.sweep}: want numbers, e.g. 1,2,4,8,16")
        print(f"voice at {api}: sweep {', '.join(models)} alone at {levels} in flight · {args.duration:.0f}s a step · {args.max_tokens} tokens max")
        sweep(api, auth, models, levels, args)
        return
    load = ", ".join(f"{m} at {r:g}/s" for m, r in rates) if rates else f"{', '.join(models)} · {args.concurrency} in flight"
    print(f"voice at {api}: {load} · {args.rounds} round(s) of {args.duration:.0f}s · {args.max_tokens} tokens max")
    everything, total_wall = [], 0.0
    for i in range(args.rounds):
        if rates:
            print(f"round {i + 1}/{args.rounds}")
            results, wall = run_rates(api, auth, rates, args.duration, args)
        else:
            n = random.randint(lo, hi)
            print(f"round {i + 1}/{args.rounds}: {n} in flight")
            results, wall = run_round(api, auth, models, n, args.duration, args)
        report(results, wall, models)
        everything += results
        total_wall += wall
    if args.rounds > 1:
        print("overall")
        report(everything, total_wall, models)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit("\nvoice-saturate: stopped")
