// A slot of the node's: one request served on its seat at a time, while the
// node's other slots serve theirs (session.hl hands each accepted `serve`,
// and each ticket a seat pulled, to a free slot; the slot claims a ticket's
// request first). The node runs `SLOTS` of them, each its own thread
// (main.hl), so two seats, or two requests on one seat of concurrency 2,
// are served at once: enough for a seat whose runtime batches (TensorFold's
// and vLLM's 32, lib/concurrency) beside others. A slot publishes the request's events and result on
// NATS with a client of its own; a `cancel` for it reaches it from the
// session, on the bus.

import "../lib/pond/realtime/nats" as nats;

/// The slots a node serves on: the most requests it serves at once, its
/// threads (main.hl's `servers` replicas, which must match), not a cap any
/// operator sets: one batching seat's 32 (lib/concurrency) beside the 8 a
/// node had before. Each is a thread pinned to a core, so there are no more
/// than that. A node's capacity is its seats' concurrency.
const SLOTS: Int = 40;

/// A request handed to a slot: the `serve` message, or a ticket to claim
/// first (pull.hl), what the session knows of its seat, and the broker to
/// answer on.
type ServeWork {
    slot: Int = 0;
    request_id: String = "";
    reply_to: String = "";
    msg: String = "";
    // a ticket the seat pulled, to claim (its JSON; "" for a `serve`), the
    // subject it is acknowledged on (`$JS.ACK.…`), and the seat that
    // claims it, `<node>/<seat>`
    ticket: String = "";
    ack: String = "";
    claimant: String = "";
    // a ticket's request, granted: `msg` is the grant, served as a `serve`,
    // and the conversation the ticket named ("" for none)
    granted: Bool = false;
    conversation: String = "";
    seat: String = "";
    engine: String = "";
    // the seat's engine kind, config and (managed) server's endpoint, and
    // the key that server answers to (run.hl)
    kind: String = "";
    config: String = "{}";
    endpoint: String = "";
    key: String = "";
    nats_url: String = "";
    nats_user: String = "";
    nats_pass: String = "";
    // where a claim's answer comes (pull.hl `inbox_of`)
    inbox: String = "_INBOX";
}

topic ServeJob { payload: ServeWork; keyed_by slot; }

/// A `cancel` the session read, for whichever slot serves it.
type ServeStop { request_id: String = ""; }

topic ServeCancel { payload: ServeStop; }

/// The session has stopped taking requests as the node drains: no
/// hand-off follows it. Published after the session's last `ServeJob`,
/// on the same thread, so a slot sees every hand-off before this.
type Stopping { at: Int = 0; }

topic SessionStopped { payload: Stopping; }

/// A slot is free again: what it served, and how it went, for the
/// session's readings and its load.
type ServeReport {
    slot: Int = 0;
    request_id: String = "";
    seat: String = "";
    engine: String = "";
    // served (or incomplete), not failed or cancelled
    ok: Bool = false;
    input_tokens: Int = 0;
    output_tokens: Int = 0;
    first_ms: Int = -1;
    elapsed_ms: Int = 0;
    // a ticket's claim: granted, a decline's reason (taken, gone, avoided,
    // ineligible), no_responders, or unanswered; "" for a `serve`. And the
    // ticket's copy's message id.
    claim: String = "";
    message_id: String = "";
    // a granted ticket's conversation ("" for none), which its seat's engine
    // holds now
    conversation: String = "";
}

topic ServeDone { payload: ServeReport; }

locus Server {
    params {
        client: nats::NatsClient = nats::NatsClient { name: "voice-node-slot" };
        // the request handed it, waiting or being served
        work: ServeWork = ServeWork { };
        waiting: Bool = false;
        serving: String = "";
        cancelled: Bool = false;
        // monotonic ns of the last look at the bus while serving
        looked: Int = 0;
        // the session has stopped taking requests: no hand-off follows
        handoffs_over: Bool = false;
    }

    bus {
        subscribe ServeJob as on_job where key == replica;
        subscribe ServeCancel as on_cancel;
        subscribe SessionStopped as on_session_stopped;
        publish ServeDone;
    }

    run() {
        while !self.draining {
            self.step();
        }
    }

    // A stop (SIGTERM, `systemctl stop`) drains the node: the session stops
    // taking requests and says so (`SessionStopped`), and a slot serves what
    // it was handed, waiting or arriving before that, then lets go. The hooks
    // run once every locus's run() has returned, the session's last word
    // told by then.
    drain() {
        while !(self.handoffs_over && !self.waiting) {
            self.step();
        }
    }

    /// No hand-off follows: once the node drains, the slot may return when
    /// it holds nothing.
    fn on_session_stopped(s: Stopping) {
        self.handoffs_over = true;
    }

    /// One turn: a request handed it is served; else its connection
    /// tended and a sleep, where the next arrives.
    fn step() {
        if self.waiting {
            self.waiting = false;
            if len(self.work.ticket) > 0 { self.claim(self.work); } else { self.serve(self.work); }
        } else {
            self.tend();
            std::time::sleep(5ms);
        }
    }

    /// Read what the broker sent: its PINGs answered (the client answers
    /// only while read), a connection it closed found closed.
    fn tend() {
        if !self.client.connected { return; }
        let mut n = 0;
        while n < 8 && self.client.read_msg(1ms) { n = n + 1; }
    }

    /// Publish on the request's broker, connected again and sent once more
    /// when the connection is gone.
    fn send(subject: String, reply: String, data: Bytes) {
        self.client.pub_msg(subject, reply, data) or {
            self.client.close();
            if self.reach(self.work) {
                self.client.pub_msg(subject, reply, data) or {
                    log_error(
                        "a slot could not publish its request's answer",
                        fields2(
                            std::log::kv("subject", subject),
                            std::log::kv("why", err.kind + ": " + err.detail),
                        ),
                    );
                };
            }
        };
    }

    fn on_job(w: ServeWork) {
        self.work = w;
        self.waiting = true;
    }

    fn on_cancel(c: ServeStop) {
        if len(self.serving) > 0 && c.request_id == self.serving { self.cancelled = true; }
    }

    /// The broker `w` names, connected to (again, when it changed).
    fn reach(w: ServeWork) -> Bool {
        // a connection the broker closed while the slot was idle is found so
        self.tend();
        // where a claim's answer comes: read for each request, not at a dial
        self.client.inbox_prefix = w.inbox;
        if self.client.connected
            && self.client.url == w.nats_url
            && self.client.user == w.nats_user
            && self.client.pass == w.nats_pass
        {
            return true;
        }
        self.client.close();
        self.client.url = w.nats_url;
        self.client.user = w.nats_user;
        self.client.pass = w.nats_pass;
        return self.client.open();
    }

    /// Claim the request of the ticket `w` holds from the api instance that
    /// holds its caller (`<reply_to>.claim`), and serve it once granted:
    /// the ticket acknowledged at the grant, before any output, then served
    /// as a `serve` is. A decline acknowledges it (`taken`, `gone`), or puts
    /// it back for another seat: at once when the seat is `ineligible`,
    /// after a delay when it is `avoided`. A claim nothing answers (no
    /// responders) is the caller's instance gone: acknowledged and dropped.
    /// One unanswered within the claim's wait, twice, goes back at once.
    @unbounded
    fn claim(w: ServeWork) {
        self.serving = w.request_id;
        self.cancelled = false;
        let mut done = ServeReport {
            slot: w.slot,
            request_id: w.request_id,
            seat: w.seat,
            engine: w.engine,
            claim: "unanswered",
        };
        if !self.reach(w) {
            log_error(
                "a slot could not reach NATS to claim a ticket",
                fields2(
                    std::log::kv("request", w.request_id),
                    std::log::kv("why", self.client.last_error),
                ),
            );
            self.serving = "";
            ServeDone <- done;
            return;
        }
        let ticket = nats::NatsMsg { reply: w.ack };
        let t = work::ticket_of(w.ticket) or {
            // the session read it before handing it over: not reached
            nats::js_ack(self.client, ticket) or discard;
            self.serving = "";
            ServeDone <- done;
            return;
        };
        done.message_id = work::message_id(t.request_id, t.attempt, t.copy);
        let body = std::bytes::from_string(
            work::claim_json(
                work::Claim {
                    request_id: t.request_id,
                    attempt: t.attempt,
                    copy: t.copy,
                    seat: w.claimant,
                },
            ),
        );
        let subject = work::claim_subject(t.reply_to);
        let mut answer = "";
        let mut why = "timeout";
        let mut tries = 0;
        while tries < 2 && why == "timeout" {
            why = "";
            let r = self.client.request(subject, body, work::CLAIM_WAIT_MS * 1ms) or {
                why = err.kind;
                nats::NatsMsg { }
            };
            if len(why) == 0 { answer = std::str::from_bytes(r.data); }
            tries = tries + 1;
        }
        if why == "no_responders" {
            // the caller's instance is gone: nobody can be served the answer
            done.claim = "no_responders";
            nats::js_ack(self.client, ticket) or discard;
        } else if len(why) > 0 {
            // for another seat, at once: the api grants an attempt once,
            // whichever seat claims it
            log_warn(
                "a claim went unanswered: its ticket is put back",
                fields2(std::log::kv("request", t.request_id), std::log::kv("why", why)),
            );
            nats::js_nak(self.client, ticket, 0) or discard;
        } else {
            let a = work::answer_of(answer) or {
                log_warn(
                    "a claim's answer is neither a grant nor a decline: its ticket is put back",
                    fields2(
                        std::log::kv("request", t.request_id),
                        std::log::kv("why", err.message),
                    ),
                );
                nats::js_nak(self.client, ticket, 0) or discard;
                self.serving = "";
                ServeDone <- done;
                return;
            };
            if a.granted {
                // accepted: acknowledged before any output, then served
                nats::js_ack(self.client, ticket) or {
                    log_warn(
                        "a granted ticket could not be acknowledged: it comes back, and is declined as taken",
                        fields2(
                            std::log::kv("request", t.request_id),
                            std::log::kv("why", err.kind + ": " + err.detail),
                        ),
                    );
                };
                // served on the slot's next turn, as a `serve` is
                let mut g = w;
                g.msg = a.serve;
                let id = std::json::find_string_field(a.serve, "request_id");
                if len(id) > 0 { g.request_id = id; }
                let reply_to = std::json::find_string_field(a.serve, "reply_to");
                g.reply_to = if len(reply_to) > 0 { reply_to } else { t.reply_to };
                g.ticket = "";
                g.granted = true;
                g.conversation = t.conversation;
                self.work = g;
                self.waiting = true;
                return;
            }
            done.claim = a.reason;
            if a.reason == "ineligible" {
                nats::js_nak(self.client, ticket, 0) or discard;
            } else if a.reason == "avoided" {
                nats::js_nak(self.client, ticket, AVOID_DELAY_MS) or discard;
            } else {
                nats::js_ack(self.client, ticket) or discard;
            }
        }
        self.serving = "";
        self.cancelled = false;
        ServeDone <- done;
    }

    /// A look at the bus, where a `cancel` for this request arrives.
    fn look() {
        self.looked = std::time::monotonic_ns();
        self.tend();
        std::time::sleep(1ms);
    }

    /// Wait `ms`, in short slices that look at the bus, until the request
    /// is cancelled.
    fn pause(ms: Int) {
        let until = std::time::monotonic_ns() + ms * 1000000;
        while !self.cancelled && std::time::monotonic_ns() < until {
            let left = (until - std::time::monotonic_ns()) / 1000000;
            std::time::sleep((if left > 50 { 50 } else if left > 0 { left } else { 0 }) * 1ms);
        }
    }

    /// Serve `w` on its seat: its events and its result on the reply
    /// subject, then the session told the slot is free.
    @unbounded
    fn serve(w: ServeWork) {
        let id = w.request_id;
        let reply_to = w.reply_to;
        self.serving = id;
        self.cancelled = false;
        self.looked = std::time::monotonic_ns();
        let mut done = ServeReport {
            slot: w.slot,
            request_id: id,
            seat: w.seat,
            engine: w.engine,
            claim: if w.granted { "granted" } else { "" },
            conversation: w.conversation,
        };
        if !self.reach(w) {
            log_error(
                "a slot could not reach NATS to answer a request",
                fields2(std::log::kv("request", id), std::log::kv("why", self.client.last_error)),
            );
            self.serving = "";
            ServeDone <- done;
            return;
        }
        let t0 = std::time::monotonic_ns();
        let model = std::json::find_string_field(w.msg, "model");
        let request = std::str::trim(std::json::find_field_raw(w.msg, "body"));
        let mut first = -1;
        let kind = w.kind;
        let compat = kind == "openai-compatible" || kind == "managed";
        // a managed seat is served by its own server, on loopback, with
        // the key it answers to (run.hl)
        let cc = if kind == "managed" {
            managed_compat(w.endpoint, std::json::find_string_field(w.config, "model"), w.key)
        } else {
            compat_config(w.config)
        };
        // a decision model's request, or any request to a decision seat
        // (`decision_dispatch`): its run, or none to decide here
        let mut run = decision_dispatch(kind, w.config, w.msg, model, request, cc);
        let decided = len(run.outcome) > 0;
        if len(run.outcome) == 0 { run = StaticRun { }; }
        if decided == true {
            // a decision model's answer, or a refusal
        } else if compat {
            // the upstream, http or https, is relayed as it arrives: each
            // event leaves as soon as it is read
            let up = upstream_over_wire(id, model, request, cc);
            // monotonic ns of the last `alive` sent (0: none)
            let mut told_alive = 0;
            while !up.done && !self.cancelled {
                let d = up.next_data();
                // the engine at work but sending nothing yet (a keep-alive
                // comment): the api told, at most once a second, so its
                // idle span runs from here
                if up.heard && std::time::monotonic_ns() - told_alive >= 1000000000 {
                    told_alive = std::time::monotonic_ns();
                    self.send(reply_to + ".alive", "", std::bytes::from_string(alive_message(id)));
                }
                if len(d) > 0 {
                    let lines = up.feed(d);
                    let lv = std::str::bytes_view(lines);
                    let mut at = 0;
                    while at < lv.n {
                        let e = line_end(lv, at);
                        let ev = std::str::slice(lv, at, e);
                        at = e + 1;
                        if first < 0 && is_output(ev) {
                            first = (std::time::monotonic_ns() - t0) / 1000000;
                        }
                        self.send(
                            reply_to + ".event",
                            "",
                            std::bytes::from_string(
                                "{\"type\":\"event\",\"request_id\":" + q(id) + ",\"event\":" + ev
                                    + "}",
                            ),
                        );
                    }
                }
                if std::time::monotonic_ns() - self.looked > 50000000 { self.look(); }
            }
            run = up.finish();
        } else {
            let engine_model = std::json::string_field(w.msg, "engine_model");
            run = run_static(
                id,
                model,
                if engine_model.kind == "string" { engine_model.text } else { model },
                request,
                static_config(w.config),
            );
        }
        let v = std::str::bytes_view(run.script);
        let mut start = 0;
        while start < v.n && !self.cancelled {
            let at = line_end(v, start);
            let line = std::str::slice(v, start, at);
            start = at + 1;
            if std::str::starts_with(line, "pause ") {
                self.pause(std::str::parse_int(line[6..len(line)]) or 0);
            } else {
                if first < 0 && is_output(line) {
                    first = (std::time::monotonic_ns() - t0) / 1000000;
                }
                self.send(
                    reply_to + ".event",
                    "",
                    std::bytes::from_string(
                        "{\"type\":\"event\",\"request_id\":" + q(id) + ",\"event\":" + line + "}",
                    ),
                );
                // a look costs up to a millisecond when nothing waits, so
                // a run of events looks every 50 ms, not after each
                if std::time::monotonic_ns() - self.looked > 50000000 { self.look(); }
            }
        }
        let elapsed = (std::time::monotonic_ns() - t0) / 1000000;
        let result = if self.cancelled {
            cancelled_result(id)
        } else if run.outcome == "failed" {
            failed_result(id, "engine_failed", run.failure, true)
        } else {
            result_message(id, run, if first < 0 { 0 } else { first }, elapsed)
        };
        self.send(reply_to + ".result", "", std::bytes::from_string(result));
        done.ok = !self.cancelled && run.outcome != "failed";
        done.input_tokens = run.input_tokens;
        done.output_tokens = run.output_tokens;
        done.first_ms = first;
        done.elapsed_ms = elapsed;
        self.serving = "";
        self.cancelled = false;
        ServeDone <- done;
    }
}
