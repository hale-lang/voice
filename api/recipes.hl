// Recipes: where a local model's weights come from, pinned, as the operator
// allows them. Voice ships some in recipes/, read at start and never
// changed; the operator allows more on the admin plane, kept in the store.
// A catalog model may name only a recipe one of the two holds (catalog.hl).
//
// An id the operator has held, live or withdrawn, is the operator's for
// good: a release that later ships a recipe of that id does not replace
// the one a model names, nor bring a withdrawn one back; the shipped one
// is not offered.
//
// Every recipe is held to the same rules, whichever way it came: one
// revision (a commit) of one source, every file listed with its digest,
// each file a kind that holds tensors, a tokenizer or settings, never a
// pickle or code. The body kept is rebuilt from the fields checked, so
// nothing unchecked is stored.

type RecipeRef { recipe: String; }

/// A recipe's or a runtime's `license`.
type License { name: String = ""; url: String = ""; }

/// `RecipeCreate`: what the operator allows, and a shipped file's form.
/// `variants` is free-form JSON, checked here field by field.
type RecipeCreate {
    id: String;
    license: License;
    // the longest context, in tokens, the model is made for (its config's
    // max_position_embeddings); left out when not known
    has_context_length: Bool = false;
    context_length: Int = 0;
    // what one more token of context costs in KV cache, in bytes at 16
    // bits, past any sliding window; left out when not known
    has_kv_bytes_per_token: Bool = false;
    kv_bytes_per_token: Int = 0;
    variants: std::json::Value = std::json::Value::null();
    // what a model made from it answers (decision.hl); left out, generative
    has_contract: Bool = false;
    contract: ModelContract = ModelContract::generative;
}

/// Where a recipe or a runtime came from (`Recipe.origin`, `Runtime.origin`).
type Origin = enum { shipped, operator };

fn origin_name(v: Origin) -> String {
    return match v {
        Origin::shipped -> "shipped",
        Origin::operator -> "operator"
    };
}

/// `Recipe`. A shipped recipe has no `created_at`.
type Recipe {
    id: String = "";
    license: License = License { };
    has_context_length: Bool = false;
    context_length: Int = 0;
    // what one more token of context costs in KV cache, in bytes at 16
    // bits, past any sliding window; left out when not known
    has_kv_bytes_per_token: Bool = false;
    kv_bytes_per_token: Int = 0;
    variants: std::json::Value = std::json::Value::null();
    contract: ModelContract = ModelContract::generative;
    origin: Origin = Origin::operator;
    has_created_at: Bool = false;
    created_at: Time = `1970-01-01T00:00:00Z`;
}

/// `RecipeVariantSummary`: a variant as `listRecipes` lists it, its files
/// counted, not listed.
type RecipeVariantSummary {
    id: String = "";
    format: ModelFormat = ModelFormat::gguf;
    quantization: String = "";
    // its files, together
    file_count: Int = 0;
    total_bytes: Int = 0;
    memory_bytes: Int = 0;
}

/// `RecipeSummary`: a recipe as `listRecipes` lists it, each variant
/// without its files (`getRecipe` has them).
type RecipeSummary {
    id: String = "";
    license: License = License { };
    has_context_length: Bool = false;
    context_length: Int = 0;
    has_kv_bytes_per_token: Bool = false;
    kv_bytes_per_token: Int = 0;
    contract: ModelContract = ModelContract::generative;
    origin: Origin = Origin::operator;
    has_created_at: Bool = false;
    created_at: Time = `1970-01-01T00:00:00Z`;
    variants: bounded[RecipeVariantSummary; 8];
}

/// A page of recipes, at most `RECIPE_PAGE_MAX`: voice's own, then the
/// operator's; `next_cursor` is `null` on the last.
type RecipeList {
    data: bounded[RecipeSummary; 32];
    has_next_cursor: Bool = false;
    next_cursor: String = "";
}

/// The most recipes a page lists, and the page it lists unasked: a
/// recipe's summary is about 500 bytes (the ones voice ships, 20 of them,
/// are 10 KiB together), so a page is under 20 KiB.
const RECIPE_PAGE_MAX: Int = 32;

/// `listRecipes`' query: a page's size, and the `next_cursor` it follows.
type RecipeAsk { limit: Int = -1; cursor: String = ""; }

/// The most recipes voice ships.
const SHIPPED_MAX: Int = 64;

/// The most a recipe's body may be: a change holds it whole, and the change
/// log reads a change back as a JSON value of at most 64 KiB.
const RECIPE_MAX: Int = 49152;

/// The most files a variant lists: a frontier model ships 160–250 shards.
const VARIANT_FILES_MAX: Int = 300;

/// The most a variant may be, as JSON: a placed seat's config carries the
/// variant whole beside its runtime (placements.hl, `managed_config`; a
/// runtime is under 2 KiB at its bounds), and a seat's config is at most
/// 48 KiB (nodes.hl, `SEAT_CONFIG_MAX`), so every variant can be placed.
const VARIANT_MAX: Int = 46080;

locus Recipes {
    params {
        store: st::Store;
        // serializes the store's use across requests (store/lock.hl): the admin plane takes turns, a row at a time
        gate: st::Lock = st::Lock { };
        // the shipped recipes' bodies, checked, one a line (`shipped_recipes`)
        shipped: String = "";
    }

    /// `listRecipes`: voice's own, then the operator's not removed, a page
    /// at a time, each recipe's variants without their files.
    fn list(a: RecipeAsk) -> RecipeList fallible(CtlError) {
        self.gate.enter();
        let gated = self.list_in_gate(a) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn list_in_gate(a: RecipeAsk) -> RecipeList fallible(CtlError) {
        let mut limit = RECIPE_PAGE_MAX;
        if a.limit != -1 {
            if a.limit < 1 || a.limit > RECIPE_PAGE_MAX {
                fail bad("`limit` is 1 to " + to_string(RECIPE_PAGE_MAX), "limit");
            }
            limit = a.limit;
        }
        let mut out = RecipeList { };
        // past the cursor's recipe, in the order they are listed
        let mut started = len(a.cursor) == 0;
        let rows = self.store.recipes() or fail store_down(err);
        let v = std::str::bytes_view(self.shipped);
        let mut start = 0;
        while start < v.n {
            let nl = st::line_end(v, start);
            let line = std::str::slice(v, start, nl);
            start = nl + 1;
            let id = std::json::find_string_field(line, "id");
            if len(line) == 0 || held(rows, id) { continue; }
            if !started {
                started = id == a.cursor;
                continue;
            }
            if count(out.data) >= limit {
                out.has_next_cursor = true;
                return out;
            }
            push(
                out.data,
                recipe_summary(line, Origin::shipped, false, `1970-01-01T00:00:00Z`),
            ) or discard;
            out.next_cursor = id;
        }
        for row in rows.rows {
            if row.removed { continue; }
            if !started {
                started = row.id == a.cursor;
                continue;
            }
            if count(out.data) >= limit {
                out.has_next_cursor = true;
                return out;
            }
            push(
                out.data,
                recipe_summary(row.body, Origin::operator, true, row.created_at),
            ) or discard;
            out.next_cursor = row.id;
        }
        if !started {
            fail bad("`cursor` names no recipe; pass a page's `next_cursor`", "cursor");
        }
        out.next_cursor = "";
        return out;
    }

    /// `createRecipe`.
    fn create(c: RecipeCreate) -> Recipe fallible(CtlError) {
        self.gate.enter();
        let gated = self.create_in_gate(c) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn create_in_gate(c: RecipeCreate) -> Recipe fallible(CtlError) {
        let body = recipe_body(
            c.id,
            c.license,
            if c.has_context_length { c.context_length } else { 0 },
            if c.has_kv_bytes_per_token { c.kv_bytes_per_token } else { 0 },
            if c.has_contract { model_contract_name(c.contract) } else { "" },
            c.variants.text,
        );
        if std::str::starts_with(body, "!") {
            fail bad(refusal_message(body), recipe_param(body));
        }
        if len(self.shipped_body(c.id)) > 0 {
            fail clash("voice ships recipe " + c.id + "; another is another id");
        }
        let row = st::RecipeRow { id: c.id, body: body, created_at: now_seconds() };
        let v = recipe_view(body, Origin::operator, true, row.created_at) or raise;
        let added = self.store.insert_recipe(
            row,
            checked_change("create", "recipes/" + c.id, "", recipe_json(v)) or raise,
        ) or fail store_down(err);
        if !added { fail clash("recipe " + c.id + " exists; a recipe id is never reused"); }
        return v;
    }

    /// `getRecipe`.
    fn get(r: RecipeRef) -> Recipe fallible(CtlError) {
        self.gate.enter();
        let gated = self.get_in_gate(r.recipe) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn get_in_gate(id: String) -> Recipe fallible(CtlError) {
        let row = self.store.recipe(id) or fail store_down(err);
        if row.present {
            if row.removed { fail missing("no recipe " + id + "; it was withdrawn"); }
            return recipe_view(row.body, Origin::operator, true, row.created_at) or raise;
        }
        let shipped = self.shipped_body(id);
        if len(shipped) == 0 { fail missing("no recipe " + id); }
        return recipe_view(shipped, Origin::shipped, false, `1970-01-01T00:00:00Z`) or raise;
    }

    /// `removeRecipe`: an operator's recipe no model in the catalog names.
    fn remove(r: RecipeRef) -> Recipe fallible(CtlError) {
        self.gate.enter();
        let gated = self.remove_in_gate(r.recipe) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn remove_in_gate(id: String) -> Recipe fallible(CtlError) {
        let v = self.get_in_gate(id) or raise;
        if v.origin == Origin::shipped {
            fail clash("voice ships recipe " + id + "; it cannot be removed");
        }
        let models = self.store.models() or fail store_down(err);
        for m in models.rows {
            if !m.removed && m.recipe == id {
                fail clash("model " + m.id + " names recipe " + id);
            }
        }
        self.store.remove_recipe(
            st::RecipeRow { id: id, removed: true, removed_at: now_seconds() },
            checked_change("delete", "recipes/" + id, recipe_json(v), "") or raise,
        ) or fail store_down(err);
        return v;
    }

    /// True when a catalog model may name `id`: shipped, or allowed and not
    /// removed. Called inside the gate (catalog.hl).
    fn known_in_gate(id: String) -> Bool fallible(CtlError) {
        let row = self.store.recipe(id) or fail store_down(err);
        if row.present { return !row.removed; }
        return len(self.shipped_body(id)) > 0;
    }

    /// The shipped recipe `id`'s body, "" for none.
    fn shipped_body(id: String) -> String {
        let v = std::str::bytes_view(self.shipped);
        let mut start = 0;
        while start < v.n {
            let nl = st::line_end(v, start);
            let line = std::str::slice(v, start, nl);
            start = nl + 1;
            if len(line) > 0 && std::json::find_string_field(line, "id") == id { return line; }
        }
        return "";
    }
}

/// True when the store holds a row for `id`, live or withdrawn.
fn held(rows: st::RecipeRows, id: String) -> Bool {
    for r in rows.rows {
        if r.id == id { return true; }
    }
    return false;
}

/// A body as the surface's `Recipe`.
fn recipe_view(
    body: String,
    origin: Origin,
    dated: Bool,
    at: Time
) -> Recipe fallible(CtlError) {
    let lic = std::json::find_field_raw(body, "license");
    return Recipe {
        id: std::json::find_string_field(body, "id"),
        license: License {
            name: std::json::find_string_field(lic, "name"),
            url: std::json::find_string_field(lic, "url"),
        },
        has_context_length: std::json::find_int_field(body, "context_length") > 0,
        context_length: std::json::find_int_field(body, "context_length"),
        has_kv_bytes_per_token: std::json::find_int_field(body, "kv_bytes_per_token") > 0,
        kv_bytes_per_token: std::json::find_int_field(body, "kv_bytes_per_token"),
        contract: model_contract_of(std::json::find_string_field(body, "contract")),
        variants: stored_value(
            std::json::find_field_raw(body, "variants"),
            "a recipe's variants",
        ) or raise,
        origin: origin,
        has_created_at: dated,
        created_at: at
    };
}

/// A body as `listRecipes` lists it: each variant's files counted.
@bounded_by(body)
fn recipe_summary(body: String, origin: Origin, dated: Bool, at: Time) -> RecipeSummary {
    let lic = std::json::find_field_raw(body, "license");
    let mut out = RecipeSummary {
        id: std::json::find_string_field(body, "id"),
        license: License {
            name: std::json::find_string_field(lic, "name"),
            url: std::json::find_string_field(lic, "url"),
        },
        has_context_length: std::json::find_int_field(body, "context_length") > 0,
        context_length: std::json::find_int_field(body, "context_length"),
        has_kv_bytes_per_token: std::json::find_int_field(body, "kv_bytes_per_token") > 0,
        kv_bytes_per_token: std::json::find_int_field(body, "kv_bytes_per_token"),
        contract: model_contract_of(std::json::find_string_field(body, "contract")),
        origin: origin,
        has_created_at: dated,
        created_at: at
    };
    let mut it = std::json::array_first(std::json::find_field_raw(body, "variants"));
    while !it.done {
        push(out.variants, variant_summary(it.element)) or discard;
        it = std::json::array_next(it);
    }
    return out;
}

/// A variant's body as `listRecipes` lists it: its files counted, not
/// listed, its file sets' among them.
@bounded_by(v)
fn variant_summary(v: String) -> RecipeVariantSummary {
    let format = text_of(v, "format");
    let mut out = RecipeVariantSummary {
        id: text_of(v, "id"),
        format: if format == "safetensors" {
            ModelFormat::safetensors
        } else if format == "mlx" {
            ModelFormat::mlx
        } else if format == "exl3" {
            ModelFormat::exl3
        } else {
            ModelFormat::gguf
        },
        quantization: text_of(v, "quantization"),
        memory_bytes: count_of(v, "memory_bytes"),
    };
    let mut it = std::json::array_first(std::json::find_field_raw(v, "files"));
    while !it.done {
        out.file_count = out.file_count + 1;
        out.total_bytes = out.total_bytes + count_of(it.element, "bytes");
        it = std::json::array_next(it);
    }
    // its file sets': each listed file, or a manifest and what it lists
    let mut sets = std::json::array_first(std::json::find_field_raw(v, "file_sets"));
    while !sets.done {
        let m = std::json::find_field_raw(sets.element, "manifest");
        if len(m) > 0 {
            out.file_count = out.file_count + 1;
            out.total_bytes = out.total_bytes + count_of(m, "bytes")
                + count_of(sets.element, "bytes");
        } else {
            let mut f = std::json::array_first(std::json::find_field_raw(sets.element, "files"));
            while !f.done {
                out.file_count = out.file_count + 1;
                out.total_bytes = out.total_bytes + count_of(f.element, "bytes");
                f = std::json::array_next(f);
            }
        }
        sets = std::json::array_next(sets);
    }
    return out;
}

/// The change log's JSON for `r`: the `Recipe` the api answers.
fn recipe_json(r: Recipe) -> String {
    return "{\"id\": " + jq(r.id) + ", \"license\": {\"name\": " + jq(r.license.name)
        + ", \"url\": "
        + jq(r.license.url) + "}" + context_field(r.has_context_length, r.context_length)
        + kv_field(r.has_kv_bytes_per_token, r.kv_bytes_per_token)
        + ", \"contract\": " + jq(model_contract_name(r.contract))
        + ", \"variants\": " + r.variants.text + ", \"origin\": "
        + jq(origin_name(r.origin)) + ", \"created_at\": "
        + jtime_or_null(r.has_created_at, r.created_at) + "}";
}

// ---- the rules --------------------------------------------------------
//
// `recipe_body` answers the body to keep, rebuilt from the fields it
// checked, or `!<param>\t<problem>` (the param is the field at fault).

@bounded_by(variants)
fn recipe_body(
    id: String,
    license: License,
    context_length: Int,
    kv_bytes_per_token: Int,
    contract: String,
    variants: String
) -> String {
    let head = id_and_license(id, license);
    if len(head) > 0 { return head; }
    if len(contract) > 0 && contract != "generative" && contract != "decision" {
        return "!contract\t`contract` is generative or decision";
    }
    if context_length < 0 || context_length > CONTEXT_MAX {
        return "!context_length\t`context_length` is 1 to 16777216 tokens";
    }
    if kv_bytes_per_token < 0 || kv_bytes_per_token > KV_PER_TOKEN_MAX {
        return "!kv_bytes_per_token\t`kv_bytes_per_token` is 1 to 16777216 bytes";
    }
    if std::json::string_field("{\"v\": " + variants + "}", "v").kind != "array" {
        return "!variants\t`variants` is a list";
    }
    let out = st::JsonList { };
    let mut seen = "\n";
    let mut n = 0;
    let mut it = std::json::array_first(variants);
    while !it.done {
        n = n + 1;
        if n > 8 { return "!variants\ta recipe has at most 8 variants"; }
        let v = variant_body(it.element, n);
        if std::str::starts_with(v, "!") { return v; }
        if len(v) > VARIANT_MAX {
            return "!variants\tvariants[" + to_string(n - 1) + "] is at most 45 KiB ("
                + to_string(len(v))
                + " bytes), which a placed seat's config carries whole";
        }
        let vid = std::json::find_string_field(v, "id");
        if std::str::contains(seen, "\n" + vid + "\n") {
            return "!variants\ttwo variants are named " + vid;
        }
        seen = seen + vid + "\n";
        out.add(v);
        it = std::json::array_next(it);
    }
    if n == 0 { return "!variants\ta recipe has at least one variant"; }
    let body = "{\"id\": " + jq(id) + ", \"license\": {\"name\": " + jq(license.name)
        + ", \"url\": "
        + jq(license.url) + "}" + context_field(context_length > 0, context_length)
        + kv_field(kv_bytes_per_token > 0, kv_bytes_per_token)
    // a generative recipe's body is as it always was
        + (if contract == "decision" { ", \"contract\": \"decision\"" } else { "" })
        + ", \"variants\": [" + out.text() + "]}";
    if len(body) > RECIPE_MAX {
        return "!variants\ta recipe is at most 48 KiB (" + to_string(len(body)) + " bytes)";
    }
    return body;
}

/// The most context a recipe may say a model has: 16M tokens.
const CONTEXT_MAX: Int = 16777216;

/// The most a token of context may cost in KV cache: 16 MiB.
const KV_PER_TOKEN_MAX: Int = 16777216;

/// `, "kv_bytes_per_token": n` when it is known, "" when not.
fn kv_field(known: Bool, n: Int) -> String {
    if !known { return ""; }
    return ", \"kv_bytes_per_token\": " + to_string(n);
}

/// `, "context_length": n` when it is known, "" when not.
fn context_field(known: Bool, n: Int) -> String {
    if !known { return ""; }
    return ", \"context_length\": " + to_string(n);
}

/// A curated id and license refused, as `!<param>\t<problem>`; "" when both
/// are well formed. Recipes' and runtimes' alike.
fn id_and_license(id: String, license: License) -> String {
    if !slug(id, ".-", true) {
        return "!id\t`id` is lowercase letters, digits, dots and dashes, starting with a letter or digit, at most 63";
    }
    if len(license.name) < 1 || len(license.name) > 64 {
        return "!license\t`license.name` is 1 to 64 characters";
    }
    if !(
        std::str::starts_with(license.url, "https://")
            || std::str::starts_with(license.url, "http://")
    )
        || len(license.url) > 512
    {
        return "!license\t`license.url` is an http or https URL, at most 512 characters";
    }
    return "";
}

/// The problem of a refused body, without its param.
fn refusal_message(refused: String) -> String {
    let tab = std::str::index_of(refused, "\t");
    return if tab > 0 { refused[(tab + 1)..len(refused)] } else { refused };
}

/// The param and the problem of a refused body.
fn recipe_param(refused: String) -> String {
    let tab = std::str::index_of(refused, "\t");
    return if tab > 1 { refused[1..tab] } else { "" };
}

@bounded_by(v)
fn variant_body(v: String, n: Int) -> String {
    let at = "variants[" + to_string(n - 1) + "]";
    let keys = only_keys(
        v,
        ",id,format,quantization,source,files,memory_bytes,kv_cache_dtype,kv_bytes_per_token,reasoning_parser,tool_call_parser,file_sets,prepare,prepared,",
    );
    if len(keys) > 0 { return "!variants\t" + at + " has no field " + keys; }
    let id = text_of(v, "id");
    if !slug(id, "_.-", true) {
        return "!variants\t" + at
            + ".id is lowercase letters, digits, dots, dashes and underscores, at most 63";
    }
    let format = text_of(v, "format");
    if format != "safetensors" && format != "gguf" && format != "mlx" && format != "exl3" {
        return "!variants\t" + at + ".format is safetensors, gguf, mlx or exl3";
    }
    let q = text_of(v, "quantization");
    if len(q) < 1 || len(q) > 64 {
        return "!variants\t" + at + ".quantization is 1 to 64 characters";
    }
    let source = source_body(std::json::find_field_raw(v, "source"), at + ".source");
    if std::str::starts_with(source, "!") { return source; }
    let memory = count_of(v, "memory_bytes");
    if memory < 1 { return "!variants\t" + at + ".memory_bytes is at least 1"; }
    // the KV cache its server must keep, a fact of the weights (vLLM serves
    // DeepSeek-V4's fp8 weights from an fp8 cache alone), from a closed set:
    // it reaches a server's arguments (node/run.hl `server_args`)
    let dtype_given = len(std::json::find_field_raw(v, "kv_cache_dtype")) > 0;
    let dtype = text_of(v, "kv_cache_dtype");
    if dtype_given && !kv_cache_dtype_known(dtype) {
        return "!variants\t" + at + ".kv_cache_dtype is fp8";
    }
    if dtype_given && format != "safetensors" {
        return "!variants\t" + at + ".kv_cache_dtype is a safetensors variant's, which vLLM serves";
    }
    // what a token of context costs its seat in that cache, as its server
    // counts it
    let kv_given = len(std::json::find_field_raw(v, "kv_bytes_per_token")) > 0;
    let kv = count_of(v, "kv_bytes_per_token");
    if kv_given && (kv < 1 || kv > KV_PER_TOKEN_MAX) {
        return "!variants\t" + at + ".kv_bytes_per_token is 1 to 16777216 bytes";
    }
    // the parser vLLM takes the model's thinking out of its answer with, a
    // fact of the model as vLLM names it, from a closed set as well
    let parser_given = len(std::json::find_field_raw(v, "reasoning_parser")) > 0;
    let parser = text_of(v, "reasoning_parser");
    if parser_given && !reasoning_parser_known(parser) {
        return "!variants\t" + at + ".reasoning_parser is deepseek_v4";
    }
    if parser_given && format != "safetensors" {
        return "!variants\t" + at
            + ".reasoning_parser is a safetensors variant's, which vLLM serves";
    }
    // the parser vLLM reads the model's tool calls out of its answer with,
    // a fact of the model as vLLM names it, from a closed set too: a seat
    // whose variant names one carries `tools` (catalog.hl `seat_tools`)
    let tools_given = len(std::json::find_field_raw(v, "tool_call_parser")) > 0;
    let tools = text_of(v, "tool_call_parser");
    if tools_given && !tool_call_parser_known(tools) {
        return "!variants\t" + at + ".tool_call_parser is " + TOOL_CALL_PARSERS;
    }
    if tools_given && format != "safetensors" {
        return "!variants\t" + at
            + ".tool_call_parser is a safetensors variant's, which vLLM serves";
    }
    let files = files_body(std::json::find_field_raw(v, "files"), at + ".files", true);
    if std::str::starts_with(files, "!") { return files; }
    // what an EXL3 variant's server needs beside its weights, each pinned:
    // more files from other repositories (`file_sets`), and the inputs its
    // node readies from them before it starts (`prepare`, `prepared`)
    let sets_given = len(std::json::find_field_raw(v, "file_sets")) > 0;
    let prepare_given = len(std::json::find_field_raw(v, "prepare")) > 0;
    let prepared_given = len(std::json::find_field_raw(v, "prepared")) > 0;
    if (sets_given || prepare_given || prepared_given) && format != "exl3" {
        return "!variants\t" + at
            + "'s file_sets, prepare and prepared are an exl3 variant's, which tensorfold serves";
    }
    let sets = if sets_given {
        file_sets_body(std::json::find_field_raw(v, "file_sets"), at + ".file_sets")
    } else {
        ""
    };
    if std::str::starts_with(sets, "!") { return sets; }
    let prepare = text_of(v, "prepare");
    if prepare_given && prepare != "dsv41-tp2" {
        return "!variants\t" + at + ".prepare is dsv41-tp2";
    }
    if prepare_given != prepared_given {
        return "!variants\t" + at + " names its prepare step and what it makes (prepared) together";
    }
    let prepared = if prepared_given {
        prepared_body(std::json::find_field_raw(v, "prepared"), at + ".prepared")
    } else {
        ""
    };
    if std::str::starts_with(prepared, "!") { return prepared; }
    return "{\"id\": " + jq(id) + ", \"format\": " + jq(format) + ", \"quantization\": " + jq(q)
        + ", \"source\": " + source + ", \"files\": [" + files + "], \"memory_bytes\": "
        + to_string(memory) + (if dtype_given { ", \"kv_cache_dtype\": " + jq(dtype) } else { "" })
        + kv_field(kv_given, kv)
        + (if parser_given { ", \"reasoning_parser\": " + jq(parser) } else { "" })
        + (if tools_given { ", \"tool_call_parser\": " + jq(tools) } else { "" })
        + (if sets_given { ", \"file_sets\": [" + sets + "]" } else { "" })
        + (if prepare_given { ", \"prepare\": " + jq(prepare) } else { "" })
        + (if prepared_given { ", \"prepared\": [" + prepared + "]" } else { "" }) + "}";
}

/// A variant's or a file set's `source`, checked, as the body keeps it; or
/// `!variants\t<problem>`, `at` naming it.
fn source_body(src: String, at: String) -> String {
    let skeys = only_keys(src, ",hub,repo,revision,");
    if len(skeys) > 0 { return "!variants\t" + at + " has no field " + skeys; }
    if text_of(src, "hub") != "huggingface" { return "!variants\t" + at + ".hub is huggingface"; }
    let repo = text_of(src, "repo");
    let slash = std::str::index_of(repo, "/");
    if len(repo) > 128
        || slash < 1
        || !slug(repo[0..slash], "._-", false)
        || !slug(repo[(slash + 1)..len(repo)], "._-", false)
    {
        return "!variants\t" + at + ".repo is owner/name";
    }
    let revision = text_of(src, "revision");
    if !hex(revision, 40) {
        return "!variants\t" + at
            + ".revision is a commit (40 hex digits), never a branch or a tag";
    }
    return "{\"hub\": \"huggingface\", \"repo\": " + jq(repo) + ", \"revision\": " + jq(revision)
        + "}";
}

/// A list of pinned files (`path`, `bytes`, `sha256`), checked, as the
/// members the body keeps; or `!variants\t<problem>`. Each holds tensors, a
/// tokenizer or settings when `weights` (`safe_path`); else any relative path.
@bounded_by(files)
fn files_body(files: String, at: String, weights: Bool) -> String {
    let fout = st::JsonList { };
    let mut k = 0;
    let mut it = std::json::array_first(files);
    while !it.done {
        k = k + 1;
        if k > VARIANT_FILES_MAX {
            return "!variants\t" + at + " lists at most " + to_string(VARIANT_FILES_MAX) + " files";
        }
        let f = it.element;
        let fat = at + "[" + to_string(k - 1) + "]";
        let fkeys = only_keys(f, ",path,bytes,sha256,");
        if len(fkeys) > 0 { return "!variants\t" + fat + " has no field " + fkeys; }
        let path = text_of(f, "path");
        if weights && !safe_path(path) {
            return "!variants\t" + fat
                + ".path is a relative path to tensors, a tokenizer or settings "
                + "(.safetensors, .gguf, .json, .txt, .model, .tiktoken, .jinja), never a pickle or code";
        }
        if !weights && !plain_path(path) {
            return "!variants\t" + fat + ".path is a relative path of letters, digits and ._/-";
        }
        let bytes = count_of(f, "bytes");
        if bytes < 1 { return "!variants\t" + fat + ".bytes is at least 1"; }
        let sha = text_of(f, "sha256");
        if !hex(sha, 64) { return "!variants\t" + fat + ".sha256 is 64 hex digits"; }
        fout.add(
            "{\"path\": " + jq(path) + ", \"bytes\": " + to_string(bytes) + ", \"sha256\": "
                + jq(sha) + "}",
        );
        it = std::json::array_next(it);
    }
    if k == 0 { return "!variants\t" + at + " lists at least one file"; }
    return fout.text();
}

/// The names a file set may have, each where its server reads it
/// (`RecipeVariant.file_sets`): `engram`, a DeepSeek-V4.1 checkpoint's
/// Engram tables; `kit`, TensorFold's kernel kit for the model.
fn file_set_known(name: String) -> Bool {
    return name == "engram" || name == "kit";
}

/// A variant's `file_sets`, checked, as the members the body keeps; or
/// `!variants\t<problem>`. Each set is named once, from its own source,
/// pinned by its files or by one manifest file that pins them (its sha256,
/// and the bytes of every file it lists, together).
@bounded_by(sets)
fn file_sets_body(sets: String, at: String) -> String {
    if std::json::string_field("{\"v\": " + sets + "}", "v").kind != "array" {
        return "!variants\t" + at + " is a list";
    }
    let out = st::JsonList { };
    let mut seen = "\n";
    let mut k = 0;
    let mut it = std::json::array_first(sets);
    while !it.done {
        k = k + 1;
        if k > 4 { return "!variants\t" + at + " has at most 4 sets"; }
        let s = it.element;
        let sat = at + "[" + to_string(k - 1) + "]";
        let keys = only_keys(s, ",name,source,files,manifest,bytes,");
        if len(keys) > 0 { return "!variants\t" + sat + " has no field " + keys; }
        let name = text_of(s, "name");
        if !file_set_known(name) { return "!variants\t" + sat + ".name is engram or kit"; }
        if std::str::contains(seen, "\n" + name + "\n") {
            return "!variants\t" + at + " names " + name + " twice";
        }
        seen = seen + name + "\n";
        let source = source_body(std::json::find_field_raw(s, "source"), sat + ".source");
        if std::str::starts_with(source, "!") { return source; }
        let has_files = len(std::json::find_field_raw(s, "files")) > 0;
        let has_manifest = len(std::json::find_field_raw(s, "manifest")) > 0;
        if has_files == has_manifest {
            return "!variants\t" + sat + " is pinned by its files or by a manifest, one of the two";
        }
        if has_files {
            let files = files_body(std::json::find_field_raw(s, "files"), sat + ".files", true);
            if std::str::starts_with(files, "!") { return files; }
            if len(std::json::find_field_raw(s, "bytes")) > 0 {
                return "!variants\t" + sat + ".bytes is a manifest's; its files say their own";
            }
            out.add(
                "{\"name\": " + jq(name) + ", \"source\": " + source + ", \"files\": [" + files
                    + "]}",
            );
        } else {
            let m = std::json::find_field_raw(s, "manifest");
            let one = files_body("[" + m + "]", sat + ".manifest", false);
            if std::str::starts_with(one, "!") {
                return std::str::replace(one, ".manifest[0]", ".manifest");
            }
            let bytes = count_of(s, "bytes");
            if bytes < 1 {
                return "!variants\t" + sat + ".bytes, every file its manifest lists, is at least 1";
            }
            out.add(
                "{\"name\": " + jq(name) + ", \"source\": " + source + ", \"manifest\": " + one
                    + ", \"bytes\": "
                    + to_string(bytes) + "}",
            );
        }
        it = std::json::array_next(it);
    }
    if k == 0 { return "!variants\t" + at + " lists at least one set"; }
    return out.text();
}

/// A variant's `prepared`, checked, as the members the body keeps; or
/// `!variants\t<problem>`: each file its node's prepare step makes, under
/// `model/` (beside the weights) or `cache/` (its server's own inputs),
/// pinned by its size and sha256; a file one rank alone makes says which
/// (`rank`).
@bounded_by(prepared)
fn prepared_body(prepared: String, at: String) -> String {
    let out = st::JsonList { };
    let mut k = 0;
    let mut it = std::json::array_first(prepared);
    while !it.done {
        k = k + 1;
        if k > 16 { return "!variants\t" + at + " lists at most 16 files"; }
        let f = it.element;
        let fat = at + "[" + to_string(k - 1) + "]";
        let keys = only_keys(f, ",path,bytes,sha256,rank,");
        if len(keys) > 0 { return "!variants\t" + fat + " has no field " + keys; }
        let path = text_of(f, "path");
        if !plain_path(path)
            || !(std::str::starts_with(path, "model/") || std::str::starts_with(path, "cache/"))
        {
            return "!variants\t" + fat + ".path is under model/ or cache/";
        }
        let bytes = count_of(f, "bytes");
        if bytes < 1 { return "!variants\t" + fat + ".bytes is at least 1"; }
        let sha = text_of(f, "sha256");
        if !hex(sha, 64) { return "!variants\t" + fat + ".sha256 is 64 hex digits"; }
        let ranked = len(std::json::find_field_raw(f, "rank")) > 0;
        let rank_raw = std::str::trim(std::json::find_field_raw(f, "rank"));
        if ranked && rank_raw != "0" && rank_raw != "1" {
            return "!variants\t" + fat + ".rank is 0 or 1";
        }
        out.add(
            "{\"path\": " + jq(path) + ", \"bytes\": " + to_string(bytes) + ", \"sha256\": "
                + jq(sha)
                + (if ranked { ", \"rank\": " + rank_raw } else { "" }) + "}",
        );
        it = std::json::array_next(it);
    }
    if k == 0 { return "!variants\t" + at + " lists at least one file"; }
    return out.text();
}

/// A relative path that does not climb, of letters, digits and `._/-`.
@bounded_by(p)
fn plain_path(p: String) -> Bool {
    let n = len(p);
    if n == 0 || n > 256 || std::str::starts_with(p, "/") { return false; }
    if p == ".." || std::str::starts_with(p, "../") || std::str::ends_with(p, "/..")
        || std::str::contains(p, "/../")
    {
        return false;
    }
    let v = std::str::bytes_view(p);
    let mut i = 0;
    while i < n {
        let b = std::str::byte_at(v, i);
        let ok = (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57)
            || b == 46 || b == 95 || b == 47 || b == 45;
        if !ok { return false; }
        i = i + 1;
    }
    return true;
}

/// The tool-call parsers a variant may name (`RecipeVariant.tool_call_parser`),
/// as vLLM v0.29.0 names them (`vllm/tool_parsers/__init__.py`), for the
/// models voice ships that make tool calls: DeepSeek-V4's, gpt-oss's
/// (`openai`), GLM-4.7's, Qwen3-Coder's, Granite 4.0's, and Qwen3's
/// (`hermes`).
const TOOL_CALL_PARSERS: String = "deepseek_v4, openai, glm47, qwen3_coder, granite4 or hermes";

/// A tool-call parser a variant may name, one of `TOOL_CALL_PARSERS`.
fn tool_call_parser_known(parser: String) -> Bool {
    return parser == "deepseek_v4"
        || parser == "openai"
        || parser == "glm47"
        || parser == "qwen3_coder"
        || parser == "granite4"
        || parser == "hermes";
}

/// A reasoning parser a variant may name (`RecipeVariant.reasoning_parser`),
/// as vLLM names it.
fn reasoning_parser_known(parser: String) -> Bool {
    return parser == "deepseek_v4";
}

/// A KV cache dtype a variant may name (`RecipeVariant.kv_cache_dtype`):
/// `fp8`, vLLM's own name for it.
fn kv_cache_dtype_known(dtype: String) -> Bool {
    return dtype == "fp8";
}

/// A string member's text; "" when it is absent or not a string.
fn text_of(obj: String, name: String) -> String {
    let f = std::json::string_field(obj, name);
    return if f.kind == "string" { f.text } else { "" };
}

/// A whole-number member at least 1; 0 when it is anything else.
fn count_of(obj: String, name: String) -> Int {
    if std::json::string_field(obj, name).kind != "number" { return 0; }
    let raw = std::str::trim(std::json::find_field_raw(obj, name));
    if std::str::contains(raw, ".")
        || std::str::contains(raw, "e")
        || std::str::contains(raw, "E")
    {
        return 0;
    }
    return std::str::parse_int(raw) or 0;
}

/// The first member of `obj` that `allowed` (",a,b,") does not name; "" when
/// none, or when `obj` is not an object.
@bounded_by(obj)
fn only_keys(obj: String, allowed: String) -> String {
    let mut it = std::json::object_first(obj);
    while !it.done {
        let k = std::json::obj_key_string(it, obj);
        if !std::str::contains(allowed, "," + k + ",") { return k; }
        it = std::json::object_next(it, obj);
    }
    return "";
}

/// 1 to 63 letters, digits and `extra`, starting with a letter or digit;
/// lowercase only when `lower`.
@bounded_by(s)
fn slug(s: String, extra: String, lower: Bool) -> Bool {
    let n = len(s);
    if n == 0 || n > 63 { return false; }
    let v = std::str::bytes_view(s);
    let mut i = 0;
    while i < n {
        let b = std::str::byte_at(v, i);
        let alnum = (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || (!lower && b >= 65 && b <= 90);
        if !alnum && (i == 0 || !std::str::contains(extra, s[i..(i + 1)])) { return false; }
        i = i + 1;
    }
    return true;
}

/// Exactly `n` lowercase hex digits.
@bounded_by(s)
fn hex(s: String, n: Int) -> Bool {
    if len(s) != n { return false; }
    let v = std::str::bytes_view(s);
    let mut i = 0;
    while i < n {
        let b = std::str::byte_at(v, i);
        if !((b >= 48 && b <= 57) || (b >= 97 && b <= 102)) { return false; }
        i = i + 1;
    }
    return true;
}

/// A relative path that does not climb, of letters, digits and `._/-`,
/// ending in a kind of file that holds no code.
fn safe_path(p: String) -> Bool {
    if !plain_path(p) { return false; }
    return std::str::ends_with(p, ".safetensors") || std::str::ends_with(p, ".gguf")
        || std::str::ends_with(p, ".json") || std::str::ends_with(p, ".txt")
        || std::str::ends_with(p, ".model") || std::str::ends_with(p, ".tiktoken")
        || std::str::ends_with(p, ".jinja");
}
