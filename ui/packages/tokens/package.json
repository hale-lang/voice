{
  "name": "@hale/tokens",
  "version": "0.0.1",
  "private": true,
  "description": "Design tokens for hale's laboratory instrument: a JSON source of truth compiled to CSS custom properties, its themes, and the arithmetic that keeps a custom accent legible. Framework-free.",
  "type": "module",
  "main": "tokens.css",
  "style": "tokens.css",
  "files": [
    "tokens.json",
    "tokens.css",
    "themes.js",
    "fonts.css",
    "color.js",
    "complete.js",
    "theme.js",
    "theme.d.ts",
    "boot.js",
    "boot.d.ts"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test theme.test.mjs"
  },
  "exports": {
    ".": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./tokens.json": "./tokens.json",
    "./theme": {
      "types": "./theme.d.ts",
      "default": "./theme.js"
    },
    "./boot": {
      "types": "./boot.d.ts",
      "default": "./boot.js"
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5",
    "@fontsource/ibm-plex-sans": "^5"
  }
}
