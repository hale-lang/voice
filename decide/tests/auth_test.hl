// voice-decide started with a key (`VOICE_DECIDE_API_KEY`, as a node starts
// it) answers every route but its health check only to the key, presented
// as a bearer; started with none, it answers any. The test runs itself
// again with a key in its environment, where the server reads it as it
// starts.
import ".." as decide;

fn status(d: decide::Decider, path: String, headers: String) -> Int {
    return d.handle(std::http::Request { method: "GET", path: path, headers: headers }).status;
}

/// Run with the key `k-right` in the environment.
fn keyed() {
    let d = decide::Decider { };
    std::test::assert_eq_int(status(d, "/v1/models", ""), 401, "a call without the key");
    std::test::assert_eq_int(
        status(d, "/v1/models", "Authorization: Bearer k-wrong"),
        401,
        "a call with another",
    );
    std::test::assert_eq_int(
        status(d, "/v1/models", "Authorization: Bearer k-right"),
        200,
        "a call with it",
    );
    std::test::assert_eq_int(
        d.handle(
            std::http::Request {
                method: "POST",
                path: "/v1/systemone",
                body: "{}",
            },
        ).status,
        401,
        "a decision without the key, before its body is read",
    );
    let health = d.handle(std::http::Request { method: "GET", path: "/healthz" });
    std::test::assert_eq_int(health.status, 200, "its health check takes none");
    std::test::assert(std::str::contains(health.body, "\"auth\": true"), "and says it is keyed");
    std::test::assert(!std::str::contains(health.body, "k-right"), "never the key");
}

fn main() {
    if std::env::var_exists("VOICE_DECIDE_API_KEY") {
        keyed();
        return;
    }
    // started with no key, it answers any
    let open = decide::Decider { };
    std::test::assert_eq_int(status(open, "/v1/models", ""), 200, "no key, no check");
    std::test::assert(
        std::str::contains(
            open.handle(std::http::Request { method: "GET", path: "/healthz" }).body,
            "\"auth\": false",
        ),
        "and its health says so",
    );
    let again = std::process::run_with(
        std::env::arg(0),
        std::process::SpawnOptions { env: "VOICE_DECIDE_API_KEY=k-right" },
    ) or std::process::ProcessOutput { code: 1, signal: 0, stdout: "", stderr: "" };
    std::test::assert_eq_int(again.code, 0, "keyed: " + again.stdout + again.stderr);
}
