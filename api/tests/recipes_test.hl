// Recipes on the admin plane: the shipped ones as the api reads them, and
// the operator's (list, create, get, remove), called on a receiver over a
// store. The fixtures are the contract check's (spec/validate/recipes):
// the api takes what it takes, and refuses every one it refuses.
import ".." as api;
import "../../store" as st;

fn fixtures(sub: String) -> String {
    let here = "spec/validate/recipes/" + sub;
    return if std::io::fs::file_exists(here) { here } else { "../" + here };
}

fn blank() -> api::Recipe { return api::Recipe { id: "refused" }; }

fn variants(path: String, revision: String) -> std::json::Value {
    let text = "[{\"id\": \"q4\", \"format\": \"gguf\", \"quantization\": \"q4_k_m\", \"source\": {\"hub\": \"huggingface\", \"repo\": \"o/m\", \"revision\": \""
        + revision + "\"}, \"files\": [{\"path\": \"" + path + "\", \"bytes\": 1, \"sha256\": \""
        + std::str::repeat("a", 64) + "\"}], \"memory_bytes\": 2}]";
    return std::json::Value::parse(text) or std::json::Value::null();
}

fn license() -> api::License {
    return api::License { name: "mit", url: "https://opensource.org/license/mit" };
}

fn main() {
    let every = api::shipped_recipes(fixtures("ok"));
    std::test::assert(
        std::str::contains(every, "\"id\": \"frontier-300\""),
        "a frontier model's variant of 300 files is taken",
    );
    variant_bounds();
    context_length();
    kv_cache();
    tool_call_parser();
    // what follows holds one shipped recipe, fixture-1
    let shipped = line_with(every, "\"id\": \"fixture-1\"");
    std::test::assert(
        std::str::contains(shipped, "\"id\": \"fixture-1\""),
        "the shipped fixture is read",
    );
    std::test::assert_eq_str(
        api::shipped_recipes(fixtures("refused")),
        "",
        "every recipe the contract refuses, the api refuses",
    );
    std::test::assert_eq_str(
        api::shipped_recipes("no/such/dir"),
        "",
        "a missing directory ships none",
    );

    let store = st::MemoryStore { };
    let recipes = api::Recipes { store: store, shipped: shipped };
    let revision = "0123456789abcdef0123456789abcdef01234567";

    let made = recipes.create(
        api::RecipeCreate {
            id: "mine-1",
            license: license(),
            variants: variants("m.gguf", revision),
        },
    ) or blank();
    std::test::assert_eq_str(made.id, "mine-1", "the operator allows a recipe");
    std::test::assert(
        made.origin == api::Origin::operator && made.has_created_at,
        "as the operator's",
    );
    std::test::assert(
        std::str::contains(made.variants.text, "\"sha256\": \"" + std::str::repeat("a", 64) + "\""),
        "its files as written",
    );

    let listed = recipes.list(api::RecipeAsk { }) or api::RecipeList { };
    std::test::assert_eq_int(count(listed.data), 2, "voice's and the operator's");
    let first = at(listed.data, 0) or api::RecipeSummary { id: "refused" };
    std::test::assert(
        first.id == "fixture-1"
            && first.origin == api::Origin::shipped
            && !first.has_created_at,
        "a shipped one has no time",
    );
    // listed, a variant's files are counted, not listed; the recipe whole
    // has them
    let mine = at(listed.data, 1) or api::RecipeSummary { id: "refused" };
    let v0 = at(mine.variants, 0) or api::RecipeVariantSummary { };
    std::test::assert(
        mine.id == "mine-1" && mine.origin == api::Origin::operator && mine.has_created_at
            && count(mine.variants) == 1 && v0.id == "q4" && v0.format == api::ModelFormat::gguf
            && v0.quantization == "q4_k_m" && v0.file_count == 1 && v0.total_bytes == 1
            && v0.memory_bytes == 2,
        "a variant summarized: its format, its files counted and summed, its memory",
    );
    let page_json = api::RecipeList::api_encode(listed);
    std::test::assert(
        !std::str::contains(page_json, "sha256") && !std::str::contains(page_json, "m.gguf")
            && !std::str::contains(page_json, "\"files\""),
        "no file is listed: " + page_json,
    );
    let whole = recipes.get(api::RecipeRef { recipe: "mine-1" }) or blank();
    std::test::assert(
        std::str::contains(whole.variants.text, "m.gguf"),
        "the recipe by its id lists them",
    );
    // a page at a time
    let one = recipes.list(api::RecipeAsk { limit: 1 }) or api::RecipeList { };
    std::test::assert(
        count(one.data) == 1 && one.has_next_cursor && one.next_cursor == "fixture-1",
        "a page of one names the next",
    );
    let rest = recipes.list(
        api::RecipeAsk { limit: 1, cursor: one.next_cursor },
    ) or api::RecipeList {
        has_next_cursor: true,
    };
    std::test::assert(
        count(rest.data) == 1 && !rest.has_next_cursor
            && (at(rest.data, 0) or api::RecipeSummary { }).id == "mine-1",
        "the next goes on from it, the operator's after voice's, to the last",
    );
    let mut bounded = "";
    recipes.list(api::RecipeAsk { limit: api::RECIPE_PAGE_MAX + 1 }) or {
        bounded = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(bounded, "invalid limit", "a page is bounded");
    bounded = "";
    recipes.list(api::RecipeAsk { cursor: "nope" }) or {
        bounded = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(bounded, "invalid cursor", "a cursor names a recipe");

    let mut failed = "";
    recipes.create(
        api::RecipeCreate {
            id: "mine-1",
            license: license(),
            variants: variants("m.gguf", revision),
        },
    ) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "an id is taken once");
    failed = "";
    recipes.create(
        api::RecipeCreate {
            id: "fixture-1",
            license: license(),
            variants: variants("m.gguf", revision),
        },
    ) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "and a shipped id is taken");
    failed = "";
    recipes.create(
        api::RecipeCreate {
            id: "mine-2",
            license: license(),
            variants: variants("model.py", revision),
        },
    ) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "code is never listed");
    failed = "";
    recipes.create(
        api::RecipeCreate {
            id: "mine-2",
            license: license(),
            variants: variants("m.gguf", "main"),
        },
    ) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a branch is not a revision");

    // a model that names a recipe holds it
    let catalog = api::Catalog { store: store, recipes: recipes };
    catalog.create(api::CatalogModelCreate { id: "mine", has_recipe: true, recipe: "mine-1" }) or {
        failed = "the operator's recipe could not be named";
    };
    std::test::assert(
        failed != "the operator's recipe could not be named",
        "a model names the operator's recipe",
    );
    failed = "";
    recipes.remove(api::RecipeRef { recipe: "mine-1" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "a recipe a model names stays");
    failed = "";
    recipes.remove(api::RecipeRef { recipe: "fixture-1" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "a shipped one cannot be removed");

    catalog.remove(api::ModelRef { model: "mine" }) or discard;
    let gone = recipes.remove(api::RecipeRef { recipe: "mine-1" }) or blank();
    std::test::assert_eq_str(gone.id, "mine-1", "with no model naming it, it is withdrawn");
    failed = "";
    recipes.get(api::RecipeRef { recipe: "mine-1" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "and gone");
    failed = "";
    recipes.create(
        api::RecipeCreate {
            id: "mine-1",
            license: license(),
            variants: variants("m.gguf", revision),
        },
    ) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "its id is never reused");
    failed = "";
    catalog.create(api::CatalogModelCreate { id: "late", has_recipe: true, recipe: "mine-1" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "nor named again");

    // a release that ships an id the operator holds replaces nothing: the
    // operator's stays what the model names, and a withdrawn one stays gone
    let held = st::MemoryStore { };
    let before = api::Recipes { store: held };
    before.create(
        api::RecipeCreate {
            id: "fixture-1",
            license: license(),
            variants: variants("theirs.gguf", revision),
        },
    ) or discard;
    let after = api::Recipes { store: held, shipped: shipped };
    let theirs = after.get(api::RecipeRef { recipe: "fixture-1" }) or blank();
    std::test::assert(
        theirs.origin == api::Origin::operator
            && std::str::contains(theirs.variants.text, "theirs.gguf"),
        "a shipped id the operator holds is the operator's",
    );
    let both = after.list(api::RecipeAsk { }) or api::RecipeList { };
    std::test::assert_eq_int(count(both.data), 1, "listed once, as the operator's");
    before.remove(api::RecipeRef { recipe: "fixture-1" }) or discard;
    failed = "";
    after.get(api::RecipeRef { recipe: "fixture-1" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(
        failed,
        "not_found",
        "a withdrawn id is not brought back by a release",
    );
    let none = after.list(api::RecipeAsk { }) or api::RecipeList { };
    std::test::assert_eq_int(count(none.data), 0, "nor listed");
    failed = "";
    api::Catalog { store: held, recipes: after }.create(
        api::CatalogModelCreate { id: "again", has_recipe: true, recipe: "fixture-1" },
    ) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "nor named again");
}

/// The line of `lines` (one shipped recipe a line) that holds `text`.
fn line_with(lines: String, text: String) -> String {
    let mut rest = lines;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        if std::str::contains(line, text) { return line + "\n"; }
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
    }
    return "";
}

/// A variant is held to what a placed seat's config can carry: at most 300
/// A recipe keeps the context its model is made for, and refuses one out of
/// range; one that does not say has none.
fn context_length() {
    let v = variants("m.gguf", "0123456789abcdef0123456789abcdef01234567").text;
    let kept = api::recipe_body("ctx", license(), 40960, 0, "", v);
    std::test::assert(
        std::str::contains(kept, "\"context_length\": 40960"),
        "a recipe keeps its context_length: " + kept,
    );
    std::test::assert(
        !std::str::contains(api::recipe_body("ctx", license(), 0, 0, "", v), "context_length"),
        "a recipe that does not say has no context_length",
    );
    // a decision recipe says so; a generative one's body is as it always was
    std::test::assert(
        std::str::contains(
            api::recipe_body("ctx", license(), 0, 0, "decision", v),
            "\"contract\": \"decision\"",
        ),
        "a decision recipe keeps its contract",
    );
    std::test::assert(
        !std::str::contains(api::recipe_body("ctx", license(), 0, 0, "generative", v), "contract"),
        "a generative recipe's body is unchanged",
    );
    std::test::assert(
        std::str::starts_with(api::recipe_body("ctx", license(), 0, 0, "oracle", v), "!contract"),
        "a contract voice does not know is refused",
    );
    let refused = api::recipe_body("ctx", license(), 16777217, 0, "", v);
    std::test::assert(
        std::str::starts_with(refused, "!context_length"),
        "a context_length past 16M is refused: " + refused,
    );
    std::test::assert(
        std::str::contains(
            api::recipe_body("ctx", license(), 0, 24576, "", v),
            "\"kv_bytes_per_token\": 24576",
        ),
        "a recipe keeps its kv_bytes_per_token",
    );
    std::test::assert(
        std::str::starts_with(
            api::recipe_body("ctx", license(), 0, -1, "", v),
            "!kv_bytes_per_token",
        ),
        "a negative kv_bytes_per_token is refused",
    );
}

/// A variant says the KV cache its server must keep (`kv_cache_dtype`) and
/// the parser that takes its thinking out of its answer (`reasoning_parser`),
/// each from a closed set and for safetensors alone, and what a token costs
/// its seat's cache (`kv_bytes_per_token`); one that says none has none.
fn kv_cache() {
    let head = "[{\"id\": \"safetensors-fp8\", \"format\": \"FORMAT\", \"quantization\": \"fp8\", \"source\": {\"hub\": \"huggingface\", \"repo\": \"o/m\", \"revision\": \"0123456789abcdef0123456789abcdef01234567\"}, \"files\": [{\"path\": \"m.safetensors\", \"bytes\": 1, \"sha256\": \""
        + std::str::repeat("a", 64) + "\"}], \"memory_bytes\": 2";
    let st = std::str::replace(head, "FORMAT", "safetensors");
    let kept = api::recipe_body(
        "kv",
        license(),
        0,
        88064,
        "",
        st
            + ", \"reasoning_parser\": \"deepseek_v4\", \"kv_bytes_per_token\": 17200, \"kv_cache_dtype\": \"fp8\"}]",
    );
    std::test::assert(
        std::str::contains(
            kept,
            "\"memory_bytes\": 2, \"kv_cache_dtype\": \"fp8\", \"kv_bytes_per_token\": 17200, \"reasoning_parser\": \"deepseek_v4\"}]",
        )
            && std::str::contains(kept, "}, \"kv_bytes_per_token\": 88064, \"variants\""),
        "a variant keeps its cache dtype, its own cost a token beside the recipe's, and its reasoning parser: "
            + kept,
    );
    let plain = api::recipe_body("kv", license(), 0, 0, "", st + "}]");
    std::test::assert(
        !std::str::contains(plain, "kv_cache_dtype") && !std::str::contains(plain, "kv_bytes")
            && !std::str::contains(plain, "reasoning_parser"),
        "a variant that says none has none: " + plain,
    );
    for bad in ["\"qwen3\"", "\"deepseek_v4\\n--trust-remote-code\"", "true", "\"\""] {
        std::test::assert_eq_str(
            api::recipe_body(
                "kv",
                license(),
                0,
                0,
                "",
                st + ", \"reasoning_parser\": " + bad + "}]",
            ),
            "!variants\tvariants[0].reasoning_parser is deepseek_v4",
            "a reasoning parser voice does not name is refused: " + bad,
        );
    }
    std::test::assert(
        std::str::starts_with(
            api::recipe_body(
                "kv",
                license(),
                0,
                0,
                "",
                std::str::replace(head, "FORMAT", "gguf")
                    + ", \"reasoning_parser\": \"deepseek_v4\"}]",
            ),
            "!variants\tvariants[0].reasoning_parser is a safetensors",
        ),
        "a GGUF variant names no reasoning parser: llama-server parses its own",
    );
    for bad in [
        "\"auto\"",
        "\"fp8_e5m2\"",
        "\"FP8\"",
        "\"fp8\\n--trust-remote-code\"",
        "8",
        "null",
        "\"\"",
    ] {
        let refused = api::recipe_body(
            "kv",
            license(),
            0,
            0,
            "",
            st + ", \"kv_cache_dtype\": " + bad + "}]",
        );
        std::test::assert_eq_str(
            refused,
            "!variants\tvariants[0].kv_cache_dtype is fp8",
            "a cache dtype voice does not name is refused: " + bad,
        );
    }
    let gguf = api::recipe_body(
        "kv",
        license(),
        0,
        0,
        "",
        std::str::replace(head, "FORMAT", "gguf") + ", \"kv_cache_dtype\": \"fp8\"}]",
    );
    std::test::assert(
        std::str::starts_with(gguf, "!variants\tvariants[0].kv_cache_dtype is a safetensors"),
        "a GGUF variant names none: llama-server is not given one: " + gguf,
    );
    for bad in ["0", "-1", "16777217", "1.5", "\"3915\""] {
        let refused = api::recipe_body(
            "kv",
            license(),
            0,
            0,
            "",
            st + ", \"kv_bytes_per_token\": " + bad + "}]",
        );
        std::test::assert_eq_str(
            refused,
            "!variants\tvariants[0].kv_bytes_per_token is 1 to 16777216 bytes",
            "a variant's cost a token out of range is refused: " + bad,
        );
    }
}

/// A variant names the parser vLLM reads its model's tool calls with
/// (`tool_call_parser`), from a closed set and for safetensors alone; one
/// that names none has none. Every shipped recipe that names one is taken.
fn tool_call_parser() {
    let head = "[{\"id\": \"safetensors-fp8\", \"format\": \"FORMAT\", \"quantization\": \"fp8\", \"source\": {\"hub\": \"huggingface\", \"repo\": \"o/m\", \"revision\": \"0123456789abcdef0123456789abcdef01234567\"}, \"files\": [{\"path\": \"m.safetensors\", \"bytes\": 1, \"sha256\": \""
        + std::str::repeat("a", 64) + "\"}], \"memory_bytes\": 2";
    let st = std::str::replace(head, "FORMAT", "safetensors");
    for name in ["deepseek_v4", "openai", "glm47", "qwen3_coder", "granite4", "hermes"] {
        let kept = api::recipe_body(
            "tools",
            license(),
            0,
            0,
            "",
            st + ", \"tool_call_parser\": \"" + name + "\"}]",
        );
        std::test::assert(
            std::str::contains(
                kept,
                "\"memory_bytes\": 2, \"tool_call_parser\": \"" + name + "\"}]",
            ),
            "a variant keeps its tool-call parser " + name + ": " + kept,
        );
    }
    let all = api::recipe_body(
        "tools",
        license(),
        0,
        0,
        "",
        st
            + ", \"tool_call_parser\": \"deepseek_v4\", \"reasoning_parser\": \"deepseek_v4\", \"kv_cache_dtype\": \"fp8\"}]",
    );
    std::test::assert(
        std::str::contains(
            all,
            "\"kv_cache_dtype\": \"fp8\", \"reasoning_parser\": \"deepseek_v4\", \"tool_call_parser\": \"deepseek_v4\"}]",
        ),
        "beside the variant's other serving facts: " + all,
    );
    std::test::assert(
        !std::str::contains(api::recipe_body("tools", license(), 0, 0, "", st + "}]"), "tool_call"),
        "a variant that names none has none",
    );
    for bad in [
        "\"qwen3_xml\"",
        "\"pythonic\"",
        "\"Hermes\"",
        "\"hermes\\n--trust-remote-code\"",
        "\"hermes --chat-template /etc/passwd\"",
        "true",
        "null",
        "\"\"",
    ] {
        std::test::assert_eq_str(
            api::recipe_body(
                "tools",
                license(),
                0,
                0,
                "",
                st + ", \"tool_call_parser\": " + bad + "}]",
            ),
            "!variants\tvariants[0].tool_call_parser is deepseek_v4, openai, glm47, qwen3_coder, granite4 or hermes",
            "a tool-call parser voice does not name is refused: " + bad,
        );
    }
    std::test::assert(
        std::str::starts_with(
            api::recipe_body(
                "tools",
                license(),
                0,
                0,
                "",
                std::str::replace(head, "FORMAT", "gguf") + ", \"tool_call_parser\": \"hermes\"}]",
            ),
            "!variants\tvariants[0].tool_call_parser is a safetensors",
        ),
        "a GGUF variant names none: llama-server applies the model's chat template",
    );
    // the recipes voice ships, each taken, with the parser its model writes
    // its calls for
    let shipped = api::shipped_recipes(fixtures("../../../recipes"));
    for want in [
        "deepseek-v4-flash-0731\tdeepseek_v4",
        "gpt-oss-120b\topenai",
        "gpt-oss-20b\topenai",
        "glm-4.7-flash\tglm47",
        "qwen3-coder-30b-a3b-instruct\tqwen3_coder",
        "qwen3-coder-next\tqwen3_coder",
        "granite-4.0-350m\tgranite4",
        "qwen3-0.6b\thermes",
    ] {
        let tab = std::str::index_of(want, "\t");
        let line = line_with(shipped, "{\"id\": \"" + want[0..tab] + "\"");
        std::test::assert(
            std::str::contains(
                line,
                "\"tool_call_parser\": \"" + want[(tab + 1)..len(want)] + "\"",
            ),
            "the shipped " + want[0..tab] + " is taken with its tool-call parser",
        );
    }
}

/// files, and at most 45 KiB as JSON however few its files.
fn variant_bounds() {
    let revision = "0123456789abcdef0123456789abcdef01234567";
    let long = std::str::repeat("p", 180);
    let mut files = "";
    let mut i = 0;
    while i < 200 {
        files = files + (if i > 0 { ", " } else { "" }) + "{\"path\": \"" + long + to_string(i)
            + ".safetensors\", \"bytes\": 1, \"sha256\": \"" + std::str::repeat("a", 64) + "\"}";
        i = i + 1;
    }
    let v = "[{\"id\": \"big\", \"format\": \"safetensors\", \"quantization\": \"bf16\", \"source\": {\"hub\": \"huggingface\", \"repo\": \"o/m\", \"revision\": \""
        + revision + "\"}, \"files\": [" + files + "], \"memory_bytes\": 2}]";
    let refused = api::recipe_body("big", license(), 0, 0, "", v);
    std::test::assert(
        std::str::starts_with(refused, "!variants")
            && std::str::contains(refused, "at most 45 KiB"),
        "a variant over 45 KiB is refused, though its files are fewer than 300: " + refused,
    );
}
