// TensorFold (`server: tensorfold`): a runtime is a CUDA image and the
// engine's archive, spanning two nodes as TensorFold pairs its ranks
// (`multi_node: lanes`), reading EXL3 alone; an EXL3 variant names the file
// sets its server reads beside the weights (each pinned, from its own
// repository, by its files or a manifest) and the inputs its node readies
// (`prepare`, `prepared`). The fit places it across two Sparks only, each
// node's disk counted with what it keeps, and refuses it beside other seats.
import ".." as api;

const H: String = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";

fn tensorfold() -> api::RuntimeCreate {
    let mut c = api::RuntimeCreate {
        id: "tensorfold-0.7.5",
        license: api::License {
            name: "apache-2.0",
            url: "https://github.com/bertholomus/TensorFold",
        },
        server: "tensorfold",
        accelerator: api::RuntimeAccelerator::cuda,
        artifact: api::RuntimeArtifact {
            kind: api::ArtifactKind::container,
            has_image: true,
            image: "nvcr.io/nvidia/pytorch",
            has_digest: true,
            digest: "sha256:" + H,
            has_archive: true,
            archive: api::EngineArchive {
                url: "https://example.com/tf.tar.gz",
                sha256: H,
                bytes: 9,
            },
        },
        has_multi_node: true,
        multi_node: api::MultiNode::lanes,
    };
    push(c.formats, api::ModelFormat::exl3) or discard;
    push(
        c.platforms,
        api::RuntimePlatform { os: api::HostOs::linux, arch: api::HostArch::arm64 },
    ) or discard;
    return c;
}

fn view(c: api::RuntimeCreate) -> api::Runtime {
    let mut r = api::Runtime {
        id: c.id,
        server: c.server,
        accelerator: c.accelerator,
        artifact: c.artifact,
        has_multi_node: c.has_multi_node,
        multi_node: c.multi_node,
    };
    for f in c.formats {
        push(r.formats, f) or discard;
    }
    for p in c.platforms {
        push(r.platforms, p) or discard;
    }
    return r;
}

const GB10: String = "{\"os\": \"linux\", \"arch\": \"arm64\", \"accelerators\": [{\"kind\": \"cuda\", \"name\": \"NVIDIA GB10\", \"memory_bytes\": 130661072896, \"unified\": true}], \"model_memory_bytes\": 122494755840, \"disk_free_bytes\": 1000000000000}";

fn src(repo: String) -> String {
    return "{\"hub\": \"huggingface\", \"repo\": \"" + repo + "\", \"revision\": \"" + H[0..40]
        + "\"}";
}

/// DeepSeek-V4.1-Flash-1017's shape: 184.7 GB of EXL3 weights, two Engram
/// shards of 101.5 GB, the kit by its manifest, and a weight file of 93 GB
/// a rank.
fn exl3() -> String {
    return "{\"id\": \"exl3-2.5bpw\", \"format\": \"exl3\", \"quantization\": \"2.5bpw\", \"source\": "
        + src("o/w")
        + ", \"files\": [{\"path\": \"model-00001-of-00001.safetensors\", \"bytes\": 184720354763, \"sha256\": \""
        + H
        + "\"}], \"memory_bytes\": 217000000000, \"file_sets\": [{\"name\": \"engram\", \"source\": "
        + src("o/orig")
        + ", \"files\": [{\"path\": \"model-00047-of-00048.safetensors\", \"bytes\": 101535150936, \"sha256\": \""
        + H
        + "\"}, {\"path\": \"model-00048-of-00048.safetensors\", \"bytes\": 101537926640, \"sha256\": \""
        + H + "\"}]}, {\"name\": \"kit\", \"source\": " + src("o/kit")
        + ", \"manifest\": {\"path\": \"kit/MANIFEST\", \"bytes\": 65046, \"sha256\": \"" + H
        + "\"}, \"bytes\": 720379156}], \"prepare\": \"dsv41-tp2\", \"prepared\": [{\"path\": \"model/serving-1017.safetensors\", \"bytes\": 132711008, \"sha256\": \""
        + H
        + "\"}, {\"path\": \"cache/rank-cache/rank0of2-993f2e3eefa9d95965c2.bin\", \"bytes\": 93039271545, \"sha256\": \""
        + H
        + "\", \"rank\": 0}, {\"path\": \"cache/rank-cache/rank1of2-d3e682794d090d0f1480.bin\", \"bytes\": 93039698730, \"sha256\": \""
        + H + "\", \"rank\": 1}]}";
}

fn refused(v: String, problem: String) {
    let body = api::recipe_body(
        "r",
        api::License { name: "mit", url: "https://x.org/l" },
        0,
        0,
        "",
        "[" + v + "]",
    );
    std::test::assert(
        std::str::starts_with(body, "!variants") && std::str::contains(body, problem),
        "refused (" + problem + "): " + body,
    );
}

fn main() {
    // ---- the runtime ------------------------------------------------------------
    let body = api::runtime_body(tensorfold());
    std::test::assert(!std::str::starts_with(body, "!"), "a tensorfold runtime is taken: " + body);
    std::test::assert(
        std::str::contains(
            body,
            "\"artifact\": {\"kind\": \"container\", \"image\": \"nvcr.io/nvidia/pytorch\", \"digest\": \"sha256:"
                + H
                + "\", \"archive\": {\"url\": \"https://example.com/tf.tar.gz\", \"sha256\": \"" + H
                + "\", \"bytes\": 9}}, \"multi_node\": \"lanes\"",
        ),
        "kept with its archive and its mode: " + body,
    );
    let mut no_archive = tensorfold();
    no_archive.artifact.has_archive = false;
    let mut mp = tensorfold();
    mp.multi_node = api::MultiNode::mp;
    let mut one = tensorfold();
    one.has_multi_node = false;
    let mut vulkan = tensorfold();
    vulkan.accelerator = api::RuntimeAccelerator::vulkan;
    let mut gguf = tensorfold();
    push(gguf.formats, api::ModelFormat::gguf) or discard;
    let mut vllm_lanes = tensorfold();
    vllm_lanes.server = "vllm";
    vllm_lanes.artifact.has_archive = false;
    let mut vllm_archive = tensorfold();
    vllm_archive.server = "vllm";
    vllm_archive.multi_node = api::MultiNode::mp;
    let mut llama_exl3 = tensorfold();
    llama_exl3.server = "llama-server";
    llama_exl3.artifact.has_archive = false;
    llama_exl3.has_multi_node = false;
    let mut bad_url = tensorfold();
    bad_url.artifact.archive.url = "http://example.com/tf.tar.gz";
    std::test::assert_eq_str(
        api::runtime_body(no_archive),
        "!artifact\ta tensorfold runtime is an image and its engine's archive",
        "no engine archive",
    );
    std::test::assert_eq_str(
        api::runtime_body(mp),
        "!multi_node\t`mp` is vllm's, as a container",
        "not vLLM's mode",
    );
    std::test::assert_eq_str(
        api::runtime_body(one),
        "!multi_node\ta tensorfold runtime runs across two nodes: `lanes`",
        "not on one node",
    );
    std::test::assert_eq_str(
        api::runtime_body(vulkan),
        "!accelerator\ta tensorfold runtime runs on cuda",
        "on CUDA alone",
    );
    std::test::assert_eq_str(
        api::runtime_body(gguf),
        "!formats\ta tensorfold runtime reads exl3 alone",
        "EXL3 alone",
    );
    std::test::assert_eq_str(
        api::runtime_body(vllm_lanes),
        "!multi_node\t`lanes` is tensorfold's",
        "lanes is TensorFold's",
    );
    std::test::assert_eq_str(
        api::runtime_body(vllm_archive),
        "!artifact\tonly a tensorfold runtime runs an engine's archive in its image",
        "an engine archive is TensorFold's",
    );
    std::test::assert_eq_str(
        api::runtime_body(llama_exl3),
        "!formats\texl3 is read by tensorfold alone",
        "EXL3 is TensorFold's",
    );
    std::test::assert_eq_str(
        api::runtime_body(bad_url),
        "!artifact\t`artifact.archive.url` is an https URL, at most 512 characters",
        "its archive over https",
    );

    // ---- the variant ------------------------------------------------------------
    let v = exl3();
    let kept = api::recipe_body(
        "deepseek-v4.1-flash-1017",
        api::License { name: "mit", url: "https://x.org/l" },
        1048576,
        0,
        "",
        "[" + v + "]",
    );
    std::test::assert(!std::str::starts_with(kept, "!"), "an EXL3 variant is taken: " + kept);
    for part in [
        "\"format\": \"exl3\"",
        "\"file_sets\": [{\"name\": \"engram\", \"source\": {\"hub\": \"huggingface\", \"repo\": \"o/orig\"",
        "{\"name\": \"kit\", \"source\": {\"hub\": \"huggingface\", \"repo\": \"o/kit\", \"revision\": \""
            + H[0..40]
            + "\"}, \"manifest\": {\"path\": \"kit/MANIFEST\", \"bytes\": 65046, \"sha256\": \"" + H
            + "\"}, \"bytes\": 720379156}",
        "\"prepare\": \"dsv41-tp2\"",
        "\"bytes\": 93039698730, \"sha256\": \"" + H + "\", \"rank\": 1}",
    ] {
        std::test::assert(std::str::contains(kept, part), "kept: " + part);
    }
    std::test::assert_eq_str(
        api::recipe_body(
            "deepseek-v4.1-flash-1017",
            api::License { name: "mit", url: "https://x.org/l" },
            1048576,
            0,
            "",
            std::json::find_field_raw(kept, "variants"),
        ),
        kept,
        "its kept body is taken again as it is",
    );
    refused(
        std::str::replace(v, "\"format\": \"exl3\"", "\"format\": \"safetensors\""),
        "an exl3 variant's",
    );
    refused(
        std::str::replace(v, "\"name\": \"kit\"", "\"name\": \"tools\""),
        ".name is engram or kit",
    );
    refused(
        std::str::replace(v, "\"name\": \"kit\"", "\"name\": \"engram\""),
        "names engram twice",
    );
    refused(std::str::replace(v, "\"prepare\": \"dsv41-tp2\", ", ""), "together");
    refused(
        std::str::replace(v, "\"prepare\": \"dsv41-tp2\"", "\"prepare\": \"convert\""),
        ".prepare is dsv41-tp2",
    );
    refused(std::str::replace(v, "\"rank\": 1}", "\"rank\": 2}"), ".rank is 0 or 1");
    refused(
        std::str::replace(v, "model/serving-1017", "etc/serving-1017"),
        "under model/ or cache/",
    );
    refused(std::str::replace(v, ", \"bytes\": 720379156}", "}"), "every file its manifest lists");
    refused(
        std::str::replace(v, "\"path\": \"kit/MANIFEST\"", "\"path\": \"../MANIFEST\""),
        "relative path",
    );
    refused(
        std::str::replace(
            v,
            "\"bytes\": 101537926640, \"sha256\": \"" + H + "\"}]}",
            "\"bytes\": 101537926640, \"sha256\": \"" + H + "\"}], \"bytes\": 3}",
        ),
        "a manifest's",
    );
    refused(
        std::str::replace(v, "model-00047-of-00048.safetensors", "engram.py"),
        "never a pickle or code",
    );

    let summary = api::variant_summary(v);
    std::test::assert(
        summary.format == api::ModelFormat::exl3 && summary.file_count == 4
            && summary.total_bytes == 184720354763 + 101535150936 + 101537926640 + 65046
            + 720379156,
        "listed with its sets' files and bytes: " + to_string(summary.file_count) + " "
            + to_string(summary.total_bytes),
    );

    // ---- the fit ----------------------------------------------------------------
    let mut rts = api::RuntimeList { };
    push(rts.data, view(tensorfold())) or discard;
    let alone = api::judge_recipe("[" + v + "]", GB10, rts, 122494755840, 0, false);
    let first = at(alone.fit, 0) or api::VariantFit { };
    std::test::assert(
        alone.best < 0 && std::str::starts_with(first.reason, "no runtime reads exl3"),
        "never on one node: " + first.reason,
    );
    let pair = api::judging_add(
        api::judging_add(api::Judging { }, "spark", GB10, 0),
        "flare",
        GB10,
        0,
    );
    let both = api::judge_on("[" + v + "]", pair, rts, false);
    let fits = at(both.fit, 0) or api::VariantFit { };
    std::test::assert(
        both.best == 0 && fits.runtime == "tensorfold-0.7.5",
        "across two Sparks: " + fits.reason,
    );
    std::test::assert(
        std::str::contains(fits.reason, "122.2 GB of 122.5 GB free for models"),
        "each node's share is about all it gives models: " + fits.reason,
    );
    std::test::assert(
        api::disk_need(v, 0) == 184720354763 + 101535150936 + 101537926640 + 65046 + 720379156
            + 132711008 + 93039271545
            && api::disk_need(v, 1) == 184720354763 + 101535150936 + 101537926640 + 65046
            + 720379156 + 132711008 + 93039698730,
        "each node keeps every file, the shared inputs and its own rank's",
    );
    let held = api::judging_add(
        api::judging_add(api::Judging { }, "spark", GB10, 3147483648),
        "flare",
        GB10,
        0,
    );
    let crowded = api::judge_on("[" + v + "]", held, rts, false);
    let beside = at(crowded.fit, 0) or api::VariantFit { };
    std::test::assert(
        !beside.fits && std::str::contains(beside.reason, "needs"),
        "refused beside another seat: " + beside.reason,
    );
    std::test::assert(
        !api::serves_on(view(tensorfold()), 1) && api::serves_on(view(tensorfold()), 2),
        "a lanes runtime serves two nodes alone",
    );
    std::test::assert(
        api::managed_tools("{\"runtime\": {\"server\": \"tensorfold\"}, \"variant\": {}}"),
        "a TensorFold seat carries tools",
    );

    // ---- what voice ships -------------------------------------------------------
    let recipes = api::shipped_recipes(here("recipes"));
    let runtimes = api::shipped_runtimes(here("runtimes"));
    let shipped_recipe = api::shipped_line(recipes, "deepseek-v4.1-flash-1017");
    let shipped_runtime = api::shipped_line(runtimes, "tensorfold-0.7.5");
    std::test::assert(len(shipped_recipe) > 0, "the recipe is read");
    std::test::assert(len(shipped_runtime) > 0, "the runtime is read");
    let mut shipped = api::RuntimeList { };
    let made = api::runtime_view(
        shipped_runtime,
        api::Origin::shipped,
        false,
        `1970-01-01T00:00:00Z`,
    ) or api::Runtime { };
    push(shipped.data, made) or discard;
    let variants = std::json::find_field_raw(shipped_recipe, "variants");
    let placed = api::judge_on(variants, pair, shipped, false);
    let chosen = at(placed.fit, 0) or api::VariantFit { };
    std::test::assert(
        placed.best == 0 && chosen.runtime == "tensorfold-0.7.5",
        "DeepSeek-V4.1-Flash-1017 fits two Sparks on TensorFold: " + chosen.reason,
    );
    let one = api::judge_recipe(variants, GB10, shipped, 122494755840, 0, false);
    std::test::assert(one.best < 0, "and no Spark alone");

    // ---- a link's check runs in vLLM's image still --------------------------------
    let mut both = api::RuntimeList { };
    push(both.data, made) or discard;
    let vllm = api::runtime_view(
        api::shipped_line(runtimes, "vllm-26.09"),
        api::Origin::shipped,
        false,
        `1970-01-01T00:00:00Z`,
    ) or api::Runtime { };
    push(both.data, vllm) or discard;
    std::test::assert(
        std::str::starts_with(api::spanning_image(both, GB10), "nvcr.io/nvidia/vllm@"),
        "a link check runs in vLLM's image, listed after TensorFold's: "
            + api::spanning_image(both, GB10),
    );
    std::test::assert(
        std::str::starts_with(api::spanning_image(shipped, GB10), "nvcr.io/nvidia/pytorch@"),
        "and in TensorFold's when it is the one that spans nodes",
    );
}

fn here(path: String) -> String {
    return if std::io::fs::file_exists(path) { path } else { "../" + path };
}
