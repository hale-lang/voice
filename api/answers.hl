/// A report received: `204`, no body.
fn no_content() -> std::http::Response {
    return std::http::Response { status: 204, body: "" };
}

/// A route that does not exist, in the spec's error envelope.
fn no_route(req: std::http::Request) -> std::http::Response {
    return error_response(
        404,
        "not_found",
        "not_found",
        "no such endpoint: " + req.method + " " + req.path,
    );
}

fn error_response(status: Int, kind: String, code: String, message: String) -> std::http::Response {
    let body = "{\"error\": {\"message\": \"" + std::json::escape_string(message)
        + "\", \"type\": \"" + kind + "\", \"code\": \"" + code + "\"}}";
    return std::http::Response { status: status, content_type: "application/json", body: body };
}
