// Placements: a local model put on nodes, by the operator. The coordinator
// picks the form of its weights (a variant of the model's recipe) and the
// runtime that serves it (runtimes.hl): a runtime that reads the variant's
// format on the nodes' platform and accelerator, a variant that fits them
// as they declared their hardware (protocol.yaml `Hardware`). It keeps
// why, for every variant. A placement
// creates the seat that serves it on its leader, on the leader's managed
// engine, its config the chosen variant and runtime, pinned
// (protocol.yaml `ManagedConfig`); the node fetches and verifies them.
//
// A placement is on one node, its leader, which holds the seat; or on two
// cabled to each other (links.hl), the model split by tensor parallelism
// across their GPUs: the leader's seat serves it, and a seat of the same id
// on the follower runs the other half (protocol.yaml `ClusterPart`). The fit
// is judged on each node, which holds its share.

type PlacementRef { placement: String; }

/// `PlacementCreate`. With no `variant` the coordinator picks.
type PlacementCreate {
    id: String;
    model: String;
    account: String = "";
    nodes: bounded[String; 2];
    has_variant: Bool = false;
    variant: String = "";
    has_runtime: Bool = false;
    runtime: String = "";
}

/// Who chose a placement's variant (`Placement.chosen_by`).
type PlacementChooser = enum { coordinator, operator };

fn placement_chooser_name(v: PlacementChooser) -> String {
    return match v {
        PlacementChooser::coordinator -> "coordinator",
        PlacementChooser::operator -> "operator"
    };
}

/// `VariantFit`: one variant, judged against the nodes.
type VariantFit {
    variant: String = "";
    // the runtime that would serve it there, left out when none runs it
    has_runtime: Bool = false;
    runtime: String = "";
    fits: Bool = false;
    reason: String = "";
}

/// `Placement`.
type Placement {
    id: String = "";
    model: String = "";
    account: String = "";
    nodes: bounded[String; 2];
    recipe: String = "";
    variant: String = "";
    runtime: String = "";
    chosen_by: PlacementChooser = PlacementChooser::coordinator;
    leader: String = "";
    seat: String = "";
    // across two nodes, the seat on its follower
    has_follower_seat: Bool = false;
    follower_seat: String = "";
    fit: bounded[VariantFit; 8];
    // the prompt cache its seat keeps, in tokens, and what the placement
    // holds of its node's memory for models: its variant and that cache.
    // Left out of a placement made before voice sized them.
    has_cache_tokens: Bool = false;
    cache_tokens: Int = 0;
    has_reserved_bytes: Bool = false;
    reserved_bytes: Int = 0;
    // what its seat holds of each of its nodes' memory for models once it
    // runs (`footprint`): told, never kept, so it follows the footprint
    has_held_bytes: Bool = false;
    held_bytes: Int = 0;
    created_at: Time = `1970-01-01T00:00:00Z`;
}

type PlacementList { data: bounded[Placement; 256]; }

locus Placements {
    params {
        store: st::Store;
        // serializes the store's use across requests (store/lock.hl): the admin plane takes turns, a row at a time
        gate: st::Lock = st::Lock { };
        // the recipes a model's weights come from (recipes.hl), and the
        // runtimes that serve them (runtimes.hl), behind the same gate
        recipes: Recipes = Recipes { store: self.store, gate: self.gate };
        runtimes: Runtimes = Runtimes { store: self.store, gate: self.gate };
        // the seats a placement creates and removes (nodes.hl): the api's
        // own, which tell the node its assignment, behind the same gate
        seats: Seats;
        // voice's default picks (suggestions.hl): catalog/picks.json, read
        // at start, "" when none was found
        picks: String = "";
        // voice's role data (catalog/roles.json, arranger.hl `roles_of`),
        // read at start; none when it was refused or not found
        roles: ArrangementRoles = ArrangementRoles { };
        // what applying an arrangement writes beside placements: a catalog
        // model for a recipe the catalog has none of, a project's aliases;
        // behind the same gate
        catalog: Catalog = Catalog { store: self.store, gate: self.gate, recipes: self.recipes };
        projects: Projects = Projects { store: self.store, gate: self.gate };
    }

    /// `listNodeDownloads`: what node `r` has on disk of the models voice
    /// knows, by variant (downloads.hl).
    fn downloads(r: NodeRef) -> NodeDownloads fallible(CtlError) {
        self.gate.enter();
        let gated = self.downloads_in_gate(r.node) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn downloads_in_gate(node: String) -> NodeDownloads fallible(CtlError) {
        let n = self.store.node(node) or fail store_down(err);
        if !n.present { fail missing("no node " + node); }
        let inv = self.store.inventory(node) or fail store_down(err);
        let rows = self.store.placements() or fail store_down(err);
        let recipes = self.recipes.bodies_in_gate() or raise;
        return node_downloads(node, inv, recipes, rows);
    }

    /// `listRecipeFits`: a page of recipes, each variant judged on every
    /// node and pair of the fleet, now and with nothing placed (fits.hl).
    fn fits(a: RecipeAsk) -> RecipeFits fallible(CtlError) {
        self.gate.enter();
        let gated = self.fits_in_gate(a) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    @unbounded
    fn fits_in_gate(a: RecipeAsk) -> RecipeFits fallible(CtlError) {
        let page = self.recipes.list_in_gate(a) or raise;
        let mut out = RecipeFits {
            has_next_cursor: page.has_next_cursor,
            next_cursor: page.next_cursor,
        };
        let mut recipes = FitRecipes { };
        for s in page.data {
            push(recipes.items, self.recipes.get_in_gate(s.id) or raise) or discard;
        }
        let nodes = self.fleet_nodes_in_gate() or raise;
        let placed = self.placed_now_in_gate() or raise;
        let usable = self.runtimes.usable_in_gate() or raise;
        let checks = self.store.link_checks() or fail store_down(err);
        let now = now_seconds();
        // each node, and what its store holds whole of the page's variants
        let mut held = FitHeld { };
        for n in nodes.items {
            push(out.nodes, fit_node(n, held_on(placed, n.id))) or discard;
            let blobs = HeldBlobs { };
            hold_blobs(blobs, (self.store.inventory(n.id) or fail store_down(err)).blobs);
            push(held.nodes, n.id) or discard;
            push(held.held, held_variants(recipes, blobs)) or discard;
        }
        // the sets judged on: each node a model can be placed on, then each
        // pair cabled to each other that can take one together
        let mut sets = "";
        for n in nodes.items {
            if len(n.problem) == 0 { sets = sets + n.id + "\n"; }
        }
        let mut i = 0;
        while i < count(nodes.items) {
            let x = at(nodes.items, i) or ArrangeNode { };
            let mut j = i + 1;
            while j < count(nodes.items) {
                let y = at(nodes.items, j) or ArrangeNode { };
                j = j + 1;
                if len(link_ports(x.capabilities, y.id)) == 0
                    && len(link_ports(y.capabilities, x.id)) == 0
                {
                    continue;
                }
                let mut problem = x.problem;
                if len(problem) == 0 { problem = y.problem; }
                if len(problem) == 0 {
                    problem = pair_problem(
                        x.id,
                        x.capabilities,
                        x.hw,
                        y.id,
                        y.capabilities,
                        y.hw,
                        checks,
                        now,
                    );
                }
                let mut pair = FitPair { has_problem: len(problem) > 0, problem: problem };
                push(pair.nodes, x.id) or discard;
                push(pair.nodes, y.id) or discard;
                push(out.pairs, pair) or discard;
                if len(problem) == 0 { sets = sets + x.id + "\t" + y.id + "\n"; }
            }
            i = i + 1;
        }
        let mut k = 0;
        for s in page.data {
            let recipe = at(recipes.items, k) or Recipe { };
            k = k + 1;
            let mut rf = RecipeFit { recipe: s };
            let mut it = std::json::array_first(recipe.variants.text);
            while !it.done {
                let v = std::str::trim(it.element);
                it = std::json::array_next(it);
                let mut vf = VariantFits { variant: std::json::find_string_field(v, "id") };
                let mut rest = sets;
                while len(rest) > 0 {
                    let nl = std::str::index_of(rest, "\n");
                    let set = set_nodes(rest[0..nl]);
                    rest = rest[(nl + 1)..len(rest)];
                    push(vf.on, target_fit(recipe, v, set, nodes, placed, usable, held)) or discard;
                }
                push(rf.variants, vf) or discard;
            }
            push(out.data, rf) or discard;
        }
        return out;
    }

    /// `s` with `downloaded` set when every node of `held` holds its
    /// variant whole.
    fn on_disk(
        s: NodeSuggestion,
        held: HeldBlobs,
        peer: HeldBlobs,
        pair: Bool
    ) -> NodeSuggestion fallible(CtlError) {
        if !s.has_recipe || !s.has_variant { return s; }
        let recipe = self.recipes.get_in_gate(s.recipe) or { return s; };
        let v = variant_body_of(recipe.variants.text, s.variant);
        let mut out = s;
        out.downloaded = variant_whole(v, held) && (!pair || variant_whole(v, peer));
        return out;
    }

    /// `suggestNodeModels`: for each category voice ships, the model it
    /// would place on node `r` (suggestions.hl).
    fn suggest(r: NodeRef) -> NodeSuggestions fallible(CtlError) {
        self.gate.enter();
        let gated = self.suggest_in_gate(r.node) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn suggest_in_gate(node: String) -> NodeSuggestions fallible(CtlError) {
        let n = self.store.node(node) or fail store_down(err);
        if !n.present || n.revoked { fail missing("no node " + node); }
        let mut out = NodeSuggestions { node: node };
        let cats = pick_categories(self.picks);
        // what its store holds, so a suggestion it holds whole says so
        let blobs = HeldBlobs { };
        hold_blobs(blobs, (self.store.inventory(node) or fail store_down(err)).blobs);
        let f = self.store.fleet(node) or fail store_down(err);
        let caps = linked(self.store, node, f.capabilities) or fail store_down(err);
        let hw = std::str::trim(std::json::find_field_raw(f.capabilities, "hardware"));
        let declared = len(hw) > 0 && std::json::valid_object(hw);
        let os = if declared { std::json::find_string_field(hw, "os") } else { "" };
        let tier = if declared {
            node_tier(std::json::find_int_field(hw, "memory_bytes"))
        } else {
            0
        };
        if declared {
            out.has_os = true;
            out.os = os;
            if tier > 0 {
                out.has_tier_gb = true;
                out.tier_gb = tier;
            }
        }
        // what the node's placements hold of its memory for models, and
        // the recipe each serves there, `<recipe>\t<placement>` a line
        let existing = self.store.placements() or fail store_down(err);
        let mut held = 0;
        let mut serving = "\n";
        for p in existing.rows {
            if !p.removed && places_on(p.body, node) {
                held = held + (self.held_by(p) or raise);
                serving = serving + std::json::find_string_field(p.body, "recipe") + "\t" + p.id
                    + "\n";
            }
        }
        let usable = self.runtimes.usable_in_gate() or raise;
        let mut rest = cats;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let cat = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            if !declared {
                push(
                    out.data,
                    NodeSuggestion {
                        category: cat,
                        reason: "node " + node
                            + " has declared no hardware, so nothing can be judged to fit it",
                    },
                ) or discard;
                continue;
            }
            let judged = self.suggest_one(
                cat,
                os,
                tier,
                0,
                judging_add(Judging { }, node, hw, held),
                usable,
                serving,
            ) or raise;
            let s = self.on_disk(judged, blobs, blobs, false) or raise;
            push(out.data, s) or discard;
        }
        if declared {
            out = self.suggest_pair(
                out,
                node,
                caps,
                hw,
                held,
                usable,
                cats,
                blobs,
            ) or raise;
        }
        return out;
    }

    /// `out` with what voice would place across node `node` and the first
    /// node it is cabled to that could take a model with it (each declares
    /// the link, of the same platform and accelerators, the link's latest
    /// check passed), a model per category: the picks of the pair's tier
    /// (their memory together) above the node's own, judged on the two as
    /// a placement across them is, by a runtime that spans nodes. Each
    /// peer tried has its store read; the first that could take a model
    /// ends the loop.
    @unbounded
    fn suggest_pair(
        out: NodeSuggestions,
        node: String,
        capabilities: String,
        hw: String,
        held: Int,
        usable: RuntimeList,
        cats: String,
        blobs: HeldBlobs
    ) -> NodeSuggestions fallible(CtlError) {
        let mut next = out;
        let checks = self.store.link_checks() or fail store_down(err);
        let existing = self.store.placements() or fail store_down(err);
        let mut spanning = RuntimeList { };
        for r in usable.data {
            if r.has_multi_node { push(spanning.data, r) or discard; }
        }
        let mut peers = link_peers(capabilities);
        while len(peers) > 0 {
            let nl = std::str::index_of(peers, "\n");
            let peer = peers[0..nl];
            peers = peers[(nl + 1)..len(peers)];
            let pn = self.store.node(peer) or fail store_down(err);
            if !pn.present || pn.revoked { continue; }
            let pf = self.store.fleet(peer) or fail store_down(err);
            let phw = std::str::trim(std::json::find_field_raw(pf.capabilities, "hardware"));
            if len(phw) == 0 || !std::json::valid_object(phw) { continue; }
            if len(
                pair_problem(
                    node,
                    capabilities,
                    hw,
                    peer,
                    linked(self.store, peer, pf.capabilities) or fail store_down(err),
                    phw,
                    checks,
                    now_seconds(),
                ),
            )
                > 0
            {
                continue;
            }
            // what the peer's placements hold, and what is placed across
            // the two already
            let mut held_p = 0;
            let mut serving = "\n";
            for p in existing.rows {
                if p.removed { continue; }
                if places_on(p.body, peer) { held_p = held_p + (self.held_by(p) or raise); }
                if places_on(p.body, node) && places_on(p.body, peer) {
                    serving = serving + std::json::find_string_field(p.body, "recipe") + "\t"
                        + p.id + "\n";
                }
            }
            let own = node_tier(std::json::find_int_field(hw, "memory_bytes"));
            let tier = node_tier(
                std::json::find_int_field(hw, "memory_bytes")
                    + std::json::find_int_field(phw, "memory_bytes"),
            );
            let judging = judging_add(judging_add(Judging { }, node, hw, held), peer, phw, held_p);
            // what the peer's store holds: a model across the two is held
            // whole on each
            let peer_blobs = HeldBlobs { };
            hold_blobs(peer_blobs, (self.store.inventory(peer) or fail store_down(err)).blobs);
            let mut pair = PairSuggestions { peer: peer, has_tier_gb: tier > 0, tier_gb: tier };
            let mut rest = cats;
            while len(rest) > 0 {
                let cnl = std::str::index_of(rest, "\n");
                let cat = rest[0..cnl];
                rest = rest[(cnl + 1)..len(rest)];
                let s = self.suggest_one(
                    cat,
                    std::json::find_string_field(hw, "os"),
                    tier,
                    own,
                    judging,
                    spanning,
                    serving,
                ) or raise;
                push(pair.data, self.on_disk(s, blobs, peer_blobs, true) or raise) or discard;
            }
            next.has_pair = true;
            next.pair = pair;
            return next;
        }
        return next;
    }

    /// Category `cat`'s suggestion for nodes of `os` at `tier`: the first
    /// of its picks, from that tier down to the one above `above`, that is
    /// placed there already, or that the operator has and that fits what
    /// is left on the nodes of `judging`.
    fn suggest_one(
        cat: String,
        os: String,
        tier: Int,
        above: Int,
        judging: Judging,
        usable: RuntimeList,
        serving: String
    ) -> NodeSuggestion fallible(CtlError) {
        let mut s = NodeSuggestion { category: cat };
        let picks = picks_above(picks_down(self.picks, os, cat, tier), above);
        if len(picks) == 0 {
            s.reason = "voice suggests no " + cat + " model for a " + os + " machine of "
                + to_string(tier) + " GB yet";
            return s;
        }
        let mut why = "";
        let mut rest = picks;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let tab = std::str::index_of(line, "\t");
            let t = std::str::parse_int(line[0..tab]) or 0;
            let id = line[(tab + 1)..len(line)];
            let at_serving = std::str::index_of(serving, "\n" + id + "\t");
            if at_serving >= 0 {
                let from = at_serving + len(id) + 2;
                let after = serving[from..len(serving)];
                s.has_recipe = true;
                s.recipe = id;
                s.has_tier_gb = true;
                s.tier_gb = t;
                s.has_placed = true;
                s.placed = after[0..std::str::index_of(after, "\n")];
                s.reason = "placed here as " + s.placed;
                return s;
            }
            let recipe = self.recipes.get_in_gate(id) or Recipe { };
            if len(recipe.id) == 0 {
                if len(why) == 0 {
                    why = "recipe " + id + " is not one voice ships or the operator allows";
                }
                continue;
            }
            let judged = judge_on(
                recipe.variants.text,
                judging,
                usable,
                recipe.contract == ModelContract::decision,
            );
            if judged.best < 0 {
                why = id + ": " + reasons(judged.fit);
                continue;
            }
            let chosen = at(judged.fit, judged.best) or VariantFit { };
            s.has_recipe = true;
            s.recipe = id;
            s.has_variant = true;
            s.variant = chosen.variant;
            s.has_runtime = chosen.has_runtime;
            s.runtime = chosen.runtime;
            s.has_tier_gb = true;
            s.tier_gb = t;
            s.reason = chosen.reason;
            return s;
        }
        s.reason = "nothing voice suggests fits: " + why;
        return s;
    }

    /// What placement `r` holds of its node's memory for models: its seat's
    /// footprint (`footprint`) on what it reserved, or, made before voice
    /// sized that, on its variant's need.
    fn held_by(r: st::PlacementRow) -> Int fallible(CtlError) {
        let reserved = std::json::find_int_field(r.body, "reserved_bytes");
        if reserved > 0 { return footprint(reserved); }
        let recipe = self.recipes.get_in_gate(std::json::find_string_field(r.body, "recipe")) or {
            return footprint(0);
        };
        let v = variant_body_of(
            recipe.variants.text,
            std::json::find_string_field(r.body, "variant"),
        );
        return footprint(std::json::find_int_field(v, "memory_bytes"));
    }

    /// `listPlacements`: those not withdrawn.
    fn list() -> PlacementList fallible(CtlError) {
        self.gate.enter();
        let gated = self.list_in_gate() or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn list_in_gate() -> PlacementList fallible(CtlError) {
        let rows = self.store.placements() or fail store_down(err);
        let mut out = PlacementList { };
        for r in rows.rows {
            if !r.removed {
                let v = placement_of(r) or raise;
                push(out.data, v) or discard;
            }
        }
        return out;
    }

    /// `createPlacement`.
    fn create(c: PlacementCreate) -> Placement fallible(CtlError) {
        self.gate.enter();
        let gated = self.create_in_gate(c) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn create_in_gate(c: PlacementCreate) -> Placement fallible(CtlError) {
        if !is_slug(c.id) {
            fail bad(
                "`id` is lowercase letters, digits and dashes, starting with a letter or digit, at most 63",
                "id"
            );
        }
        let parts = count(c.nodes);
        if parts < 1 {
            fail bad("`nodes` names its leader, and a follower to split the model across", "nodes");
        }
        let m = self.store.model(c.model) or fail store_down(err);
        if !m.present || m.removed { fail bad("no model " + c.model + " in the catalog", "model"); }
        if len(m.recipe) == 0 {
            fail bad(
                "model " + c.model + " names no recipe, so there are no weights to place",
                "model"
            );
        }
        let recipe = self.recipes.get_in_gate(m.recipe) or raise;
        let leader = at(c.nodes, 0) or "";
        let follower = if parts == 2 { at(c.nodes, 1) or "" } else { "" };
        if parts == 2 && follower == leader {
            fail bad("`nodes` names node " + leader + " twice", "nodes");
        }
        let lead = self.placeable(leader) or raise;
        let follow = if parts == 2 { self.placeable(follower) or raise } else { Placeable { } };
        if len(c.account) == 0 {
            fail bad("`account` names the account the seat spends", "account");
        }
        let hw = self.hardware_of(leader, lead) or raise;
        let hw_f = if parts == 2 { self.hardware_of(follower, follow) or raise } else { "" };
        let where = if parts == 2 {
            "nodes " + leader + " and " + follower
        } else {
            "node " + leader
        };
        let existing = self.store.placements() or fail store_down(err);
        // what each node's other placements hold of its memory for models
        let mut held = 0;
        let mut held_f = 0;
        for r in existing.rows {
            if r.removed { continue; }
            let on_l = places_on(r.body, leader);
            let on_f = parts == 2 && places_on(r.body, follower);
            if !on_l && !on_f { continue; }
            let beside = beside_problem(
                c.model,
                parts,
                r.id,
                r.model,
                spans(r.body),
                if on_l { leader } else { follower },
            );
            if len(beside) > 0 { fail clash(beside); }
            if on_l { held = held + (self.held_by(r) or raise); }
            if on_f { held_f = held_f + (self.held_by(r) or raise); }
        }
        if parts == 2 {
            let checks = self.store.link_checks() or fail store_down(err);
            let problem = pair_problem(
                leader,
                lead.capabilities,
                hw,
                follower,
                follow.capabilities,
                hw_f,
                checks,
                now_seconds(),
            );
            if len(problem) > 0 { fail bad(problem, "nodes"); }
        }
        let mut judging = judging_add(Judging { }, leader, hw, held);
        if parts == 2 { judging = judging_add(judging, follower, hw_f, held_f); }

        let mut out = Placement {
            id: c.id,
            model: c.model,
            account: c.account,
            recipe: m.recipe,
            leader: leader,
            created_at: now_seconds()
        };
        push(out.nodes, leader) or discard;
        if parts == 2 { push(out.nodes, follower) or discard; }
        let all = self.runtimes.usable_in_gate() or raise;
        let mut usable = RuntimeList { };
        let mut named_any = false;
        for r in all.data {
            if !c.has_runtime || r.id == c.runtime {
                named_any = true;
                // across two nodes, only a runtime whose server spans them;
                // on one, none that runs only across two
                if serves_on(r, parts) { push(usable.data, r) or discard; }
            }
        }
        if c.has_runtime && !named_any {
            fail bad(
                "no runtime " + c.runtime + ": voice ships none, nor has the operator allowed one",
                "runtime"
            );
        }
        if c.has_runtime && count(usable.data) == 0 {
            fail bad(
                if parts == 2 {
                    "runtime " + c.runtime + " does not span nodes"
                } else {
                    "runtime " + c.runtime + " runs only across two nodes"
                },
                "runtime"
            );
        }
        let mut fitted = fit_recipe(
            recipe,
            judging,
            usable,
            // the model's own contract, which may differ from its recipe's
            // default: it is what its requests are served as
            m.contract == "decision",
        );
        out.fit = fitted.judged.fit;
        let best = fitted.judged.best;
        let mut named = -1;
        let mut i = 0;
        for f in out.fit {
            if c.has_variant && f.variant == c.variant { named = i; }
            i = i + 1;
        }
        if c.has_variant {
            if named < 0 {
                fail bad("recipe " + m.recipe + " has no variant " + c.variant, "variant");
            }
            let chosen = at(out.fit, named) or VariantFit { };
            if !chosen.fits {
                fail bad(
                    "variant " + c.variant + " does not fit " + where + ": " + chosen.reason,
                    "variant"
                );
            }
            out.variant = c.variant;
            out.runtime = chosen.runtime;
            out.chosen_by = PlacementChooser::operator;
            fitted = reserve(fitted, recipe, c.variant, chosen.runtime, judging, usable);
        } else {
            if best < 0 {
                fail bad(
                    "no variant of recipe " + m.recipe + " fits " + where + ": " + reasons(out.fit),
                    "nodes",
                );
            }
            let chosen = at(out.fit, best) or VariantFit { };
            out.variant = chosen.variant;
            out.runtime = chosen.runtime;
            if c.has_runtime { out.chosen_by = PlacementChooser::operator; }
        }

        out.has_cache_tokens = true;
        out.cache_tokens = fitted.cache_tokens;
        out.has_reserved_bytes = true;
        out.reserved_bytes = fitted.reserved_bytes;
        out.has_held_bytes = true;
        out.held_bytes = footprint(fitted.reserved_bytes);

        // the seats first: their own checks (the account, the node's room)
        // refuse before anything is kept; across two nodes, the leader's
        // and then the follower's, each told its part
        let master = if parts == 2 {
            first_address(link_ports(lead.capabilities, follower))
        } else {
            ""
        };
        let lead_link = if parts == 2 { link_to(lead.capabilities, follower) } else { "" };
        let follow_link = if parts == 2 { link_to(follow.capabilities, leader) } else { "" };
        out.seat = leader + "/" + c.id;
        self.make_seat(
            c,
            leader,
            lead.managed,
            out,
            recipe,
            all,
            if parts == 2 { cluster_json(0, follower, master, lead_link) } else { "" },
        ) or raise;
        if parts == 2 {
            out.has_follower_seat = true;
            out.follower_seat = follower + "/" + c.id;
            self.make_seat(
                c,
                follower,
                follow.managed,
                out,
                recipe,
                all,
                cluster_json(1, leader, master, follow_link),
            ) or {
                self.seats.remove_read(SeatRef { node: leader, seat: c.id }) or discard;
                fail err;
            };
        }
        let body = placement_json(out);
        let added = self.store.insert_placement(
            st::PlacementRow { id: c.id, model: c.model, body: body, created_at: out.created_at },
            checked_change("create", "placements/" + c.id, "", body) or raise,
        ) or {
            self.unmake_seats(out);
            fail store_down(err);
        };
        if !added {
            self.unmake_seats(out);
            fail clash("placement " + c.id + " exists; a placement id is never reused");
        }
        // another api may have placed on a node since its placements were
        // read: what they hold now, this one counted, is read again, and
        // this one withdrawn if together they overfill one, or if another
        // placement across nodes takes part on one of its nodes too (a node
        // runs one at a time). Of two placed at once, the one that reads
        // last sees both, and withdraws; both may, never neither.
        let now = self.store.placements() or fail store_down(err);
        let rival = if parts == 2 { spanning_rival(now, c.id, leader, follower) } else { "" };
        if len(rival) > 0 {
            self.remove_in_gate(c.id) or discard;
            fail clash(rival);
        }
        for n in out.nodes {
            let mut total = 0;
            for r in now.rows {
                if !r.removed && places_on(r.body, n) {
                    total = total + (self.held_by(r) or raise);
                }
            }
            let memory = models_memory(
                if n == leader { hw } else { hw_f },
                runtime_on(all, out.runtime),
            );
            if total > memory {
                self.remove_in_gate(c.id) or discard;
                fail clash(
                    "node " + n + " filled while this was placed: its placements would hold "
                        + gb(total) + " of " + gb(memory) + " for models; place it again",
                );
            }
        }
        return out;
    }

    /// Node `id`, as a placement may be put on it: there, not revoked, and
    /// offering a managed engine.
    fn placeable(id: String) -> Placeable fallible(CtlError) {
        let n = self.store.node(id) or fail store_down(err);
        if !n.present || n.revoked { fail bad("no node " + id, "nodes"); }
        let f = self.store.fleet(id) or fail store_down(err);
        let managed = managed_engine(f.capabilities);
        if len(managed) == 0 {
            fail bad(
                "node " + id + " offers no managed engine, so no model can be placed on it",
                "nodes"
            );
        }
        // its links as the coordinator uses them: declared, or found from its
        // cabled ports (cabling.hl)
        return Placeable {
            capabilities: linked(self.store, id, f.capabilities) or fail store_down(err),
            managed: managed,
        };
    }

    /// The hardware node `id` declared (`p`'s capabilities), as JSON.
    fn hardware_of(id: String, p: Placeable) -> String fallible(CtlError) {
        let hw = std::str::trim(std::json::find_field_raw(p.capabilities, "hardware"));
        if len(hw) == 0 || !std::json::valid_object(hw) {
            fail bad(
                "node " + id + " has declared no hardware, so nothing can be judged to fit it",
                "nodes"
            );
        }
        return hw;
    }

    /// Placement `out`'s seat on `node`, on its managed engine `engine`, its
    /// config its variant and runtime pinned and, across two nodes, its part
    /// (`cluster`, "" for none).
    fn make_seat(
        c: PlacementCreate,
        node: String,
        engine: String,
        out: Placement,
        recipe: Recipe,
        all: RuntimeList,
        cluster: String
    ) -> Bool fallible(CtlError) {
        let mut seat = SeatCreate {
            node: node,
            id: c.id,
            engine: engine,
            account: c.account,
            config: std::json::Value::parse(
                managed_config(
                    c.id,
                    c.model,
                    recipe.context_length,
                    out.cache_tokens,
                    out.reserved_bytes,
                    variant_body_of(recipe.variants.text, out.variant),
                    runtime_body_of(all, out.runtime),
                    cluster,
                ),
            ) or fail bad("the placement's seat config is too large to keep", "model"),
        };
        push(seat.serves, st::SeatModel { model: c.model }) or discard;
        self.seats.create_read(seat) or raise;
        return true;
    }

    /// The seats placement `p` made, removed.
    fn unmake_seats(p: Placement) {
        self.seats.remove_read(SeatRef { node: p.leader, seat: p.id }) or discard;
        if p.has_follower_seat {
            let follower = at(p.nodes, 1) or "";
            self.seats.remove_read(SeatRef { node: follower, seat: p.id }) or discard;
        }
    }

    /// `getPlacement`.
    fn get(r: PlacementRef) -> Placement fallible(CtlError) {
        self.gate.enter();
        let gated = self.get_in_gate(r.placement) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn get_in_gate(id: String) -> Placement fallible(CtlError) {
        let row = self.store.placement(id) or fail store_down(err);
        if !row.present || row.removed { fail missing("no placement " + id); }
        return placement_of(row) or raise;
    }

    /// `removePlacement`.
    fn remove(r: PlacementRef) -> Placement fallible(CtlError) {
        self.gate.enter();
        let gated = self.remove_in_gate(r.placement) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn remove_in_gate(id: String) -> Placement fallible(CtlError) {
        let v = self.get_in_gate(id) or raise;
        // only the seat it made: a placement from before placements made
        // seats records none, and a seat of that id is someone else's
        if v.seat == v.leader + "/" + v.id {
            self.seats.remove_read(SeatRef { node: v.leader, seat: v.id }) or discard;
        }
        let follower = at(v.nodes, 1) or "";
        if v.has_follower_seat && v.follower_seat == follower + "/" + v.id {
            self.seats.remove_read(SeatRef { node: follower, seat: v.id }) or discard;
        }
        self.store.remove_placement(
            st::PlacementRow { id: id, removed: true, removed_at: now_seconds() },
            checked_change("delete", "placements/" + id, placement_json(v), "") or raise,
        ) or fail store_down(err);
        return v;
    }

    // ---- arrangements (arranger.hl): the methods are the placements', as
    // what a plan proposes is placements

    /// `listArrangementRoles`: voice's role data.
    fn arrangement_roles() -> ArrangementRoles fallible(CtlError) {
        return self.roles;
    }

    /// `planArrangement`: the plan for wants `w`, written nowhere.
    fn plan_arrangement(w: ArrangementWants) -> ArrangementPlan fallible(CtlError) {
        self.gate.enter();
        let gated = self.plan_in_gate(w) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn plan_in_gate(w: ArrangementWants) -> ArrangementPlan fallible(CtlError) {
        let planned = self.planned_in_gate(w) or raise;
        return planned.plan;
    }

    /// The plan for wants `w`, and the digest of the fleet it was made
    /// from (`fleet_basis`), one read of the fleet for both.
    fn planned_in_gate(w: ArrangementWants) -> Planned fallible(CtlError) {
        let f = self.arrangement_fleet_in_gate(w) or raise;
        let problem = check_wants(f, w, self.roles);
        if len(problem) > 0 { fail bad(problem, "wants"); }
        let basis = fleet_basis(f.nodes, f.placed, f.checks, f.now);
        let plan = plan_fleet(f, w, self.roles);
        // each add under an id no placement has held, since an id is never
        // reused: its model and leader, or with `-2`, `-3`…
        let rows = self.store.placements() or fail store_down(err);
        let mut taken = "\n";
        for r in rows.rows {
            taken = taken + r.id + "\n";
        }
        let mut out = plan;
        let mut i = 0;
        for a in plan.add {
            // the store holds at most PLACEMENTS_MAX, so among the base and
            // its suffixes to one past that, one is free
            let mut id = a.placement;
            let mut n = 2;
            while std::str::contains(taken, "\n" + id + "\n") && n <= PLACEMENTS_MAX + 2 {
                id = a.placement + "-" + to_string(n);
                n = n + 1;
            }
            if std::str::contains(taken, "\n" + id + "\n") || !is_slug(id) {
                fail clash("no free placement id for " + a.model + " on " + names_said(a.nodes));
            }
            taken = taken + id + "\n";
            let mut fresh = a;
            fresh.placement = id;
            set(out.add, i, fresh) or discard;
            i = i + 1;
        }
        return Planned { plan: out, basis: basis };
    }

    /// `listArrangements`.
    fn list_arrangements() -> ArrangementList fallible(CtlError) {
        self.gate.enter();
        let gated = self.list_arrangements_in_gate() or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn list_arrangements_in_gate() -> ArrangementList fallible(CtlError) {
        let rows = self.store.arrangements() or fail store_down(err);
        let basis = self.basis_in_gate() or raise;
        let mut out = ArrangementList { };
        for r in rows.rows {
            push(out.data, arrangement_of(r, basis)) or discard;
        }
        return out;
    }

    /// `getArrangement`.
    fn get_arrangement(r: ArrangementRef) -> Arrangement fallible(CtlError) {
        self.gate.enter();
        let gated = self.get_arrangement_in_gate(r.arrangement) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn get_arrangement_in_gate(id: String) -> Arrangement fallible(CtlError) {
        let row = self.store.arrangement(id) or fail store_down(err);
        if !row.present { fail missing("no arrangement " + id); }
        let basis = self.basis_in_gate() or raise;
        return arrangement_of(row, basis);
    }

    /// `putArrangement`: wants kept as arrangement `p.arrangement`, checked
    /// as a plan checks them; a plan is not made.
    fn put_arrangement(p: ArrangementPut) -> Arrangement fallible(CtlError) {
        self.gate.enter();
        let gated = self.put_arrangement_in_gate(p) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn put_arrangement_in_gate(p: ArrangementPut) -> Arrangement fallible(CtlError) {
        if !is_slug(p.arrangement) {
            fail bad(
                "an arrangement's id is lowercase letters, digits and dashes, starting with a letter or digit, at most 63",
                "arrangement"
            );
        }
        if len(p.name) > 200 { fail bad("`name` is at most 200 characters", "name"); }
        let f = self.arrangement_fleet_in_gate(p.wants) or raise;
        let problem = check_wants(f, p.wants, self.roles);
        if len(problem) > 0 { fail bad(problem, "wants"); }
        let before = self.store.arrangement(p.arrangement) or fail store_down(err);
        let now = now_seconds();
        let row = st::ArrangementRow {
            id: p.arrangement,
            name: if len(p.name) > 0 { p.name } else { p.arrangement },
            body: ArrangementWants::api_encode(p.wants),
            created_at: if before.present { before.created_at } else { now },
            updated_at: now,
            // a new revision with every save: a plan of the wants before
            // does not mark these planned (`plan_arrangement_at`)
            revision: st::random_id(12),
        };
        let after = Arrangement::api_encode(arrangement_of(row, ""));
        self.store.put_arrangement(
            row,
            checked_change(
                if before.present { "update" } else { "create" },
                "arrangements/" + p.arrangement,
                if before.present {
                    Arrangement::api_encode(arrangement_of(before, ""))
                } else {
                    ""
                },
                after,
            ) or raise,
        ) or fail store_down(err);
        let kept = self.store.arrangement(p.arrangement) or fail store_down(err);
        return arrangement_of(kept, "");
    }

    /// `removeArrangement`.
    fn remove_arrangement(r: ArrangementRef) -> Arrangement fallible(CtlError) {
        self.gate.enter();
        let gated = self.remove_arrangement_in_gate(r.arrangement) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn remove_arrangement_in_gate(id: String) -> Arrangement fallible(CtlError) {
        let row = self.store.arrangement(id) or fail store_down(err);
        if !row.present { fail missing("no arrangement " + id); }
        let v = arrangement_of(row, "");
        self.store.delete_arrangement(
            id,
            checked_change("delete", "arrangements/" + id, Arrangement::api_encode(v), "") or raise,
        ) or fail store_down(err);
        return v;
    }

    /// `planSavedArrangement`: arrangement `r`'s wants planned against the
    /// fleet now, as `planArrangement` plans them; the plan's time and the
    /// fleet it was made against recorded. Asked for, never on its own.
    fn plan_saved_arrangement(r: ArrangementRef) -> ArrangementPlan fallible(CtlError) {
        self.gate.enter();
        let gated = self.plan_saved_in_gate(r.arrangement) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn plan_saved_in_gate(id: String) -> ArrangementPlan fallible(CtlError) {
        let row = self.store.arrangement(id) or fail store_down(err);
        if !row.present { fail missing("no arrangement " + id); }
        let wants = ArrangementWants::api_decode(row.body) or ArrangementWants { };
        // recorded against the fleet the plan was made from, and only on
        // the revision it planned: wants saved again meanwhile, on any
        // instance, stay unplanned
        let planned = self.planned_in_gate(wants) or raise;
        self.store.plan_arrangement_at(id, row.revision, now_seconds(), planned.basis)
        or fail store_down(err);
        return planned.plan;
    }

    /// The fleet now as a plan depends on it (`fleet_basis`).
    fn basis_in_gate() -> String fallible(CtlError) {
        let f = self.arrangement_fleet_in_gate(ArrangementWants { }) or raise;
        return fleet_basis(f.nodes, f.placed, f.checks, f.now);
    }

    /// `applyArrangement`: plan `a` carried out, as ordinary placements, in
    /// a safe order (arranger.hl, "carrying a plan out"); refused with the
    /// fresh plan when it is no longer the plan the fleet would get.
    fn apply_arrangement(a: ArrangementApply) -> ArrangementApplied fallible(CtlError) {
        self.gate.enter();
        let gated = self.apply_in_gate(a) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn apply_in_gate(a: ArrangementApply) -> ArrangementApplied fallible(CtlError) {
        if count(a.plan.add) > 0 && len(a.account) == 0 {
            fail bad("`account` names the account the seats it adds spend", "account");
        }
        if count(a.plan.aliases) > 0 {
            if len(a.project) == 0 {
                fail bad("`project` names the project whose aliases the plan points", "project");
            }
            let p = self.store.project(a.project) or fail store_down(err);
            if !p.present { fail bad("no project " + a.project, "project"); }
        }
        let fresh = self.plan_in_gate(a.wants) or raise;
        if plan_key(fresh) != plan_key(a.plan) {
            return ArrangementApplied {
                outcome: ApplyOutcome::drifted,
                advice: "the fleet has changed since this plan was made, and nothing was done: here is the plan for it now; apply that one",
                has_plan: true,
                plan: fresh,
            };
        }
        let mut out = apply_steps(fresh, a.project);
        let mut i = 0;
        let mut failed = false;
        while i < count(out.steps) {
            let s = at(out.steps, i) or ApplyStep { };
            if failed { break; }
            let why = self.apply_step(s, fresh, a) or {
                ctl_message(err)
            };
            failed = len(why) > 0;
            // the step as it came out, a new value rather than a written copy
            set(
                out.steps,
                i,
                ApplyStep {
                    action: s.action,
                    target: s.target,
                    detail: s.detail,
                    state: if failed { ApplyStepState::failed } else { ApplyStepState::done },
                    reason: if failed { why } else { s.reason },
                },
            ) or discard;
            i = i + 1;
        }
        if failed {
            out.outcome = ApplyOutcome::failed;
            out.advice = apply_advice(out);
        } else {
            out.advice = "every step was done; each placement's seats come up as their nodes fetch what they name";
        }
        return out;
    }

    /// Step `s` of plan `p` done; "" when it was, else why not.
    fn apply_step(
        s: ApplyStep,
        p: ArrangementPlan,
        a: ArrangementApply
    ) -> String fallible(CtlError) {
        if s.action == ApplyAction::remove {
            self.remove_in_gate(s.target) or raise;
            return "";
        }
        if s.action == ApplyAction::catalog {
            let mut recipe = "";
            for x in p.add {
                if x.model == s.target { recipe = x.recipe; }
            }
            self.catalog.create_in_gate(
                CatalogModelCreate { id: s.target, has_recipe: true, recipe: recipe },
            ) or raise;
            return "";
        }
        if s.action == ApplyAction::add {
            let add = plan_add(p, s.target);
            // the variant and runtime the plan approved, pinned: placing it
            // does not choose again from what the node reports, which the
            // plan's earlier adds have not filled yet; refused, before any
            // seat is made, when they no longer fit
            let mut c = PlacementCreate {
                id: add.placement,
                model: add.model,
                account: a.account,
                has_variant: true,
                variant: add.variant,
                has_runtime: true,
                runtime: add.runtime,
            };
            for n in add.nodes {
                push(c.nodes, n) or discard;
            }
            self.create_in_gate(c) or raise;
            return "";
        }
        if s.action == ApplyAction::alias {
            let alias = plan_alias(p, s.target);
            self.projects.set_alias_in_gate(a.project, alias.alias, alias.model) or raise;
            return "";
        }
        return "no step " + apply_action_name(s.action);
    }

    /// The nodes not revoked, in the order of their ids, so what is judged
    /// against them does not depend on when each enrolled: each with its
    /// links as the coordinator uses them (cabling.hl), its hardware, and
    /// why no model can be placed on it.
    fn fleet_nodes_in_gate() -> ArrangeNodes fallible(CtlError) {
        let mut out = ArrangeNodes { };
        let nodes = self.store.nodes() or fail store_down(err);
        let mut ids = "\n";
        for n in nodes.rows {
            if !n.revoked { ids = ids + n.id + "\n"; }
        }
        while len(ids) > 1 {
            let mut next = "";
            for n in nodes.rows {
                if std::str::contains(ids, "\n" + n.id + "\n") && (len(next) == 0 || n.id < next) {
                    next = n.id;
                }
            }
            ids = std::str::replace(ids, "\n" + next + "\n", "\n");
            let fl = self.store.fleet(next) or fail store_down(err);
            let hw = std::str::trim(std::json::find_field_raw(fl.capabilities, "hardware"));
            push(
                out.items,
                ArrangeNode {
                    id: next,
                    capabilities: linked(self.store, next, fl.capabilities) or fail store_down(err),
                    hw: if len(hw) > 0 { hw } else { "{}" },
                    problem: placeable_problem(next, fl.capabilities),
                },
            ) or discard;
        }
        return out;
    }

    /// What is placed now, each placement with what it holds of each of
    /// its nodes' memory for models (`held_by`).
    fn placed_now_in_gate() -> ArrangePlacedList fallible(CtlError) {
        let mut out = ArrangePlacedList { };
        let catalog = self.store.models() or fail store_down(err);
        let rows = self.store.placements() or fail store_down(err);
        for r in rows.rows {
            if !r.removed {
                let p = placement_of(r) or raise;
                let mut decision = false;
                for m in catalog.rows {
                    if m.id == p.model { decision = m.contract == "decision"; }
                }
                push(
                    out.items,
                    ArrangePlaced {
                        id: p.id,
                        model: p.model,
                        recipe: p.recipe,
                        variant: p.variant,
                        nodes: node_set(p.nodes),
                        held: self.held_by(r) or raise,
                        decision: decision,
                    },
                ) or discard;
            }
        }
        return out;
    }

    /// The fleet as the store holds it now: its nodes in the order of
    /// their ids, so a plan does not depend on when each enrolled; what is
    /// placed; and the models wants `w` may be filled with.
    fn arrangement_fleet_in_gate(w: ArrangementWants) -> ArrangeFleet fallible(CtlError) {
        let mut f = ArrangeFleet {
            now: now_seconds(),
            usable: self.runtimes.usable_in_gate() or raise,
            checks: self.store.link_checks() or fail store_down(err),
            nodes: self.fleet_nodes_in_gate() or raise,
            placed: self.placed_now_in_gate() or raise,
        };
        let catalog = self.store.models() or fail store_down(err);
        // the models a want may be filled with: each pin's, and each wanted
        // role's candidates, the strongest first
        let mut wanted = "";
        for p in w.pins {
            wanted = wanted + p.model + "\n";
        }
        for r in w.roles {
            let role = role_named(self.roles, r.role);
            for c in role.candidates {
                wanted = wanted + c + "\n";
            }
        }
        while len(wanted) > 0 {
            let nl = std::str::index_of(wanted, "\n");
            let id = wanted[0..nl];
            wanted = wanted[(nl + 1)..len(wanted)];
            // a catalog model named is loaded as itself, though a model of
            // its recipe is loaded already; a recipe, once
            let mut named = false;
            for row in catalog.rows {
                if !row.removed && row.id == id && len(row.recipe) > 0 { named = true; }
            }
            let loaded = if named { model_exact(f, id) } else { model_index(f, id) };
            if loaded < 0 {
                let m = self.arrangement_model(catalog, id) or raise;
                if len(m.model) > 0 { push(f.models.items, m) or discard; }
            }
        }
        f.holdings = self.holdings_in_gate(f) or raise;
        return f;
    }

    /// What each node of `f` holds whole of the variants of `f`'s models,
    /// from what it last reported its store holds (downloads.hl
    /// `variant_whole`): a variant held whole is not fetched again.
    fn holdings_in_gate(f: ArrangeFleet) -> NodeHoldings fallible(CtlError) {
        let mut out = NodeHoldings { };
        for n in f.nodes.items {
            let held = self.holdings_on(n.id, f.models) or raise;
            for h in held.items {
                push(out.items, h) or discard;
            }
        }
        return out;
    }

    /// What node `node` holds whole of the variants of `models`.
    fn holdings_on(node: String, models: ArrangeModels) -> NodeHoldings fallible(CtlError) {
        let mut out = NodeHoldings { };
        let blobs = HeldBlobs { };
        hold_blobs(blobs, (self.store.inventory(node) or fail store_down(err)).blobs);
        for m in models.items {
            let mut it = std::json::array_first(m.recipe.variants.text);
            while !it.done {
                if variant_whole(it.element, blobs) {
                    push(
                        out.items,
                        NodeHolding {
                            node: node,
                            recipe: m.recipe.id,
                            variant: std::json::find_string_field(it.element, "id"),
                        },
                    ) or discard;
                }
                it = std::json::array_next(it);
            }
        }
        return out;
    }

    /// Model `id`: the catalog's model of that id, or else recipe `id`, as
    /// the catalog's first model that names it or as itself when none does;
    /// `model` "" when voice has neither.
    fn arrangement_model(catalog: st::ModelRows, id: String) -> ArrangeModel fallible(CtlError) {
        for row in catalog.rows {
            if !row.removed && row.id == id && len(row.recipe) > 0 {
                let recipe = self.recipes.get_in_gate(row.recipe) or Recipe { };
                if len(recipe.id) == 0 { return ArrangeModel { }; }
                return ArrangeModel {
                    model: row.id,
                    in_catalog: true,
                    decision: row.contract == "decision",
                    recipe: recipe,
                };
            }
        }
        let recipe = self.recipes.get_in_gate(id) or Recipe { };
        if len(recipe.id) == 0 { return ArrangeModel { }; }
        for row in catalog.rows {
            if !row.removed && row.recipe == id {
                return ArrangeModel {
                    model: row.id,
                    in_catalog: true,
                    decision: row.contract == "decision",
                    recipe: recipe,
                };
            }
        }
        return ArrangeModel {
            model: id,
            decision: recipe.contract == ModelContract::decision,
            recipe: recipe,
        };
    }
}

/// A row as the surface's `Placement`. The body is what `create` decided.
fn placement_of(r: st::PlacementRow) -> Placement fallible(CtlError) {
    let b = r.body;
    let mut out = Placement {
        id: r.id,
        model: r.model,
        account: std::json::find_string_field(b, "account"),
        recipe: std::json::find_string_field(b, "recipe"),
        variant: std::json::find_string_field(b, "variant"),
        runtime: std::json::find_string_field(b, "runtime"),
        chosen_by: if std::json::find_string_field(b, "chosen_by") == "operator" {
            PlacementChooser::operator
        } else {
            PlacementChooser::coordinator
        },
        leader: std::json::find_string_field(b, "leader"),
        seat: std::json::find_string_field(b, "seat"),
        has_follower_seat: len(std::json::find_string_field(b, "follower_seat")) > 0,
        follower_seat: std::json::find_string_field(b, "follower_seat"),
        has_cache_tokens: std::json::find_int_field(b, "cache_tokens") > 0,
        cache_tokens: std::json::find_int_field(b, "cache_tokens"),
        has_reserved_bytes: std::json::find_int_field(b, "reserved_bytes") > 0,
        reserved_bytes: std::json::find_int_field(b, "reserved_bytes"),
        has_held_bytes: std::json::find_int_field(b, "reserved_bytes") > 0,
        held_bytes: footprint(std::json::find_int_field(b, "reserved_bytes")),
        created_at: r.created_at
    };
    let mut nodes = std::json::array_first(std::json::find_field_raw(b, "nodes"));
    while !nodes.done {
        push(
            out.nodes,
            std::json::string_field("{\"n\": " + nodes.element + "}", "n").text,
        ) or discard;
        nodes = std::json::array_next(nodes);
    }
    let mut it = std::json::array_first(std::json::find_field_raw(b, "fit"));
    while !it.done {
        push(
            out.fit,
            VariantFit {
                variant: std::json::find_string_field(it.element, "variant"),
                has_runtime: std::json::string_field(it.element, "runtime").kind == "string",
                runtime: std::json::find_string_field(it.element, "runtime"),
                fits: std::json::find_bool_field(it.element, "fits"),
                reason: std::json::find_string_field(it.element, "reason"),
            },
        ) or discard;
        it = std::json::array_next(it);
    }
    return out;
}

/// The change log's JSON for `p`, and the body kept: the `Placement` the api answers.
@bounded_by(p)
fn placement_json(p: Placement) -> String {
    let nodes = st::JsonList { };
    for n in p.nodes {
        nodes.add(jq(n));
    }
    let fits = st::JsonList { };
    for f in p.fit {
        fits.add(
            "{\"variant\": " + jq(f.variant) + ", \"runtime\": "
                + (if f.has_runtime { jq(f.runtime) } else { "null" }) + ", \"fits\": "
                + (if f.fits { "true" } else { "false" })
                + ", \"reason\": " + jq(f.reason) + "}",
        );
    }
    return "{\"id\": " + jq(p.id) + ", \"model\": " + jq(p.model) + ", \"account\": "
        + jq(p.account)
        + ", \"nodes\": [" + nodes.text()
        + "]"
        + ", \"recipe\": " + jq(p.recipe) + ", \"variant\": " + jq(p.variant) + ", \"runtime\": "
        + jq(p.runtime) + ", \"chosen_by\": "
        + jq(placement_chooser_name(p.chosen_by)) + ", \"leader\": " + jq(p.leader) + ", \"seat\": "
        + jq(p.seat)
        + (if p.has_follower_seat { ", \"follower_seat\": " + jq(p.follower_seat) } else { "" })
        + ", \"fit\": ["
        + fits.text() + "]"
        + (if p.has_cache_tokens { ", \"cache_tokens\": " + to_string(p.cache_tokens) } else { "" })
        + (
            if p.has_reserved_bytes {
                ", \"reserved_bytes\": " + to_string(p.reserved_bytes)
            } else {
                ""
            }
        )
        + ", \"created_at\": " + jtime(p.created_at) + "}";
}

// ---- the fit rules a placement and the arranger share --------------------

/// Why placement `other` (of `other_model`, across two nodes when
/// `other_spans`, on node `on`) keeps a placement of `model` on `parts`
/// nodes off `on`, "" when it does not: a node serves a model once, and
/// takes part in one placement across nodes at a time (its ranks meet on
/// the host's network, at voice's one rendezvous port).
fn beside_problem(
    model: String,
    parts: Int,
    other: String,
    other_model: String,
    other_spans: Bool,
    on: String
) -> String {
    if other_model == model {
        return "model " + model + " is placed on node " + on + " by " + other;
    }
    if parts == 2 && other_spans {
        return "node " + on + " takes part in placement " + other
            + " across nodes already, and a node takes part in one at a time";
    }
    return "";
}

/// Why `leader` and `follower` (each its capabilities and hardware) cannot
/// take a model across them, "" when they can: one platform and the same
/// accelerators, each declaring its link to the other, and the link's
/// latest check (`checks`, at `now`) passed.
fn pair_problem(
    leader: String,
    caps_l: String,
    hw_l: String,
    follower: String,
    caps_f: String,
    hw_f: String,
    checks: st::LinkCheckRows,
    now: Time
) -> String {
    let unlike = pair_hardware_problem(leader, hw_l, follower, hw_f);
    if len(unlike) > 0 { return unlike; }
    if len(link_ports(caps_l, follower)) == 0 {
        return "node " + leader + " has no link to " + follower;
    }
    if len(link_ports(caps_f, leader)) == 0 {
        return "node " + follower + " has no link to " + leader;
    }
    return pair_link_problem(checks, leader, follower, now);
}

/// Why no model can be placed on node `id` (its `capabilities`), "" when
/// one can: it offers a managed engine and has declared its hardware.
@bounded_by(capabilities)
fn placeable_problem(id: String, capabilities: String) -> String {
    if len(managed_engine(capabilities)) == 0 {
        return "node " + id + " offers no managed engine, so no model can be placed on it";
    }
    let hw = std::str::trim(std::json::find_field_raw(capabilities, "hardware"));
    if len(hw) == 0 || !std::json::valid_object(hw) {
        return "node " + id + " has declared no hardware, so nothing can be judged to fit it";
    }
    return "";
}

/// A recipe's fit on the nodes of `j`: every variant judged (`judge_on`),
/// the one voice picks, the runtime that serves it, and what it holds of
/// each node (`reserve`). No variant picked when none fits
/// (`judged.best` -1).
type PlacementFit {
    judged: Judged = Judged { };
    variant: String = "";
    runtime: String = "";
    cache_tokens: Int = 0;
    reserved_bytes: Int = 0;
}

/// Recipe `recipe` judged on the nodes of `j` for the runtimes of `usable`,
/// its requests served as a decision model's when `decision`; with the
/// variant voice picks reserved there.
fn fit_recipe(recipe: Recipe, j: Judging, usable: RuntimeList, decision: Bool) -> PlacementFit {
    let judged = judge_on(recipe.variants.text, j, usable, decision);
    let out = PlacementFit { judged: judged };
    if judged.best < 0 { return out; }
    let chosen = at(judged.fit, judged.best) or VariantFit { };
    return reserve(out, recipe, chosen.variant, chosen.runtime, j, usable);
}

/// `f` with variant `variant` of `recipe`, served by `runtime`, reserved
/// on the nodes of `j`: its seat's prompt cache, room for CACHED
/// conversations of the model's context (at most CONVERSATION_MAX), from
/// at most half the room the variant leaves on the node with the least
/// (`least_room`, where `runtime`, among `rts`, runs), never less than the
/// context it was fitted with; and what each node reserves, its share of
/// the variant and the whole cache (`part_need`).
fn reserve(
    f: PlacementFit,
    recipe: Recipe,
    variant: String,
    runtime: String,
    j: Judging,
    rts: RuntimeList
) -> PlacementFit {
    let mut out = f;
    let v = variant_body_of(recipe.variants.text, variant);
    let need = part_need(v, count(j.hw));
    let per_token = kv_per_token(v, recipe.kv_bytes_per_token);
    let room = least_room(j, runtime_on(rts, runtime));
    let pool = cache_pool(room - footprint(need), per_token, recipe.context_length, need);
    out.variant = variant;
    out.runtime = runtime;
    out.cache_tokens = pool;
    out.reserved_bytes = need + (pool - fitted_context(recipe.context_length)) * per_token;
    return out;
}

// ---- what a seat takes ------------------------------------------------

/// What a seat's server takes beside what its placement reserved (its
/// weights and prompt cache): the process, its GPU context, its compute
/// buffers and activations. The node gives vLLM a share of the GPU's memory
/// on the same sum (node/run.hl `gpu_share`).
const SEAT_OVERHEAD_BYTES: Int = 2147483648;

/// What a seat holds of its node's memory once it runs, all of it from the
/// moment it is placed: what was reserved for it (`reserved`) and its
/// server's own (`SEAT_OVERHEAD_BYTES`).
fn footprint(reserved: Int) -> Int {
    return reserved + SEAT_OVERHEAD_BYTES;
}

// ---- the prompt cache --------------------------------------------------

/// The context a recipe's `memory_bytes` provides for
/// (scripts/catalog-recipes.py, CONTEXT), for a model made for at least so
/// much: what a placement promises a request (lib/concurrency).
const FITTED_CONTEXT: Int = concurrency::PROMISED_CONTEXT;

/// The context a variant's `memory_bytes` provides for: `FITTED_CONTEXT`,
/// or the model's own when it is made for less (catalog-recipes.py fits
/// `min(CONTEXT, max_position_embeddings)`).
fn fitted_context(native: Int) -> Int {
    return if native > 0 && native < FITTED_CONTEXT { native } else { FITTED_CONTEXT };
}

/// The conversations a seat's prompt cache holds at once, each returned to
/// what it said when it comes back: at most llama-server's slots, which
/// it is started with as many of as the cache holds requests of the
/// promised context (lib/concurrency `llama_slots`).
const CACHED: Int = concurrency::LLAMA_SLOTS_MAX;

/// The most context a cached conversation is given room for.
const CONVERSATION_MAX: Int = 131072;

/// A seat's prompt cache, in tokens: room for `CACHED` conversations of the
/// model's context (`native`, at most `CONVERSATION_MAX`), from at most half
/// of `spare`, the memory its variant leaves, and never more than `need`,
/// the variant's own, past what that provides (a cache no larger than the
/// model it serves); never less than
/// the context the variant's memory provides (`fitted_context`). With no
/// per-token cost known, that.
fn cache_pool(spare: Int, per_token: Int, native: Int, need: Int) -> Int {
    let base = fitted_context(native);
    if per_token <= 0 || spare <= 0 { return base; }
    let conversation = if native > 0 && native < CONVERSATION_MAX {
        native
    } else {
        CONVERSATION_MAX
    };
    let want = CACHED * conversation;
    if want <= base { return base; }
    let budget = if spare / 2 < need { spare / 2 } else { need };
    let afford = base + budget / per_token;
    let pool = if afford < want { afford } else { want };
    // llama.cpp allocates its cache in steps of `CACHE_STEP`, rounding up:
    // a cache past its fitted context is rounded down to one, so what is
    // reserved is what it allocates
    let stepped = (pool / CACHE_STEP) * CACHE_STEP;
    return if stepped > base { stepped } else { base };
}

/// What one more token of context costs variant `v`'s seat in KV cache:
/// the variant's own figure (`RecipeVariant.kv_bytes_per_token`), in the
/// cache its server keeps for it (its `kv_cache_dtype`, as the server lays
/// it out), or else its recipe's (`recipe`, at 16 bits, which no narrower
/// cache exceeds); 0 when neither says.
@bounded_by(v)
fn kv_per_token(v: String, recipe: Int) -> Int {
    let own = std::json::find_int_field(v, "kv_bytes_per_token");
    return if own > 0 { own } else { recipe };
}

/// The step llama.cpp allocates a cache in (llama-context.cpp: n_ctx is
/// rounded up to a multiple of 256).
const CACHE_STEP: Int = 256;

// ---- the seat ---------------------------------------------------------

/// The id of the engine of kind `managed` a node's capabilities declare,
/// "" for none.
@bounded_by(capabilities)
fn managed_engine(capabilities: String) -> String {
    let mut it = std::json::array_first(std::json::find_field_raw(capabilities, "engines"));
    while !it.done {
        if std::json::find_string_field(it.element, "kind") == "managed" {
            return std::json::find_string_field(it.element, "id");
        }
        it = std::json::array_next(it);
    }
    return "";
}

/// The variant `id` of a recipe's `variants`, as JSON.
@bounded_by(variants)
fn variant_body_of(variants: String, id: String) -> String {
    let mut it = std::json::array_first(variants);
    while !it.done {
        if std::json::find_string_field(it.element, "id") == id {
            return std::str::trim(it.element);
        }
        it = std::json::array_next(it);
    }
    return "{}";
}

/// The runtime `id` among `rts`, as its `RuntimeCreate` JSON.
@bounded_by(rts)
fn runtime_body_of(rts: RuntimeList, id: String) -> String {
    for r in rts.data {
        if r.id == id { return runtime_create_json(r, r.formats, r.platforms); }
    }
    return "{}";
}

/// A managed seat's config (protocol.yaml `ManagedConfig`).
fn managed_config(
    placement: String,
    model: String,
    context_length: Int,
    cache_tokens: Int,
    reserved_bytes: Int,
    variant: String,
    runtime: String,
    cluster: String
) -> String {
    // the most context the model is made for, which a server is not
    // started past (node/run.hl); left out when the recipe does not say
    return "{\"placement\": " + jq(placement) + ", \"model\": " + jq(model)
        + (
            if context_length > 0 {
                ", \"context_length\": " + to_string(context_length)
            } else {
                ""
            }
        )
    // the prompt cache its server keeps, in tokens, and the memory it
    // may take (node/run.hl)
        + ", \"cache_tokens\": " + to_string(cache_tokens) + ", \"reserved_bytes\": "
        + to_string(reserved_bytes)
        + ", \"variant\": "
        + variant
        + ", \"runtime\": " + runtime
    // across two nodes, its part (protocol.yaml `ClusterPart`)
        + (if len(cluster) > 0 { ", \"cluster\": " + cluster } else { "" }) + "}";
}

/// A seat's part of a placement across two nodes (`ClusterPart`): its rank,
/// the other node, where the ranks meet, the leader's address on the link
/// (`master`) as this node reaches it at voice's rendezvous port (links.hl
/// `SPAN_PORT`), and this node's end of the link (`link`, its `Link` JSON;
/// cabling.hl `reached_from`).
fn cluster_json(rank: Int, peer: String, master: String, link: String) -> String {
    return "{\"size\": 2, \"rank\": " + to_string(rank) + ", \"peer\": " + jq(peer)
        + ", \"master_addr\": " + jq(reached_from(master, link)) + ", \"master_port\": "
        + to_string(SPAN_PORT) + (if len(link) > 0 { ", \"link\": " + link } else { "" }) + "}";
}

/// The node a placement is on, of those it names: its leader, and across
/// two nodes its follower too (`body` its row's body).
@bounded_by(body)
fn places_on(body: String, node: String) -> Bool {
    if std::json::find_string_field(body, "leader") == node { return true; }
    let mut it = std::json::array_first(std::json::find_field_raw(body, "nodes"));
    while !it.done {
        if std::str::trim(it.element) == jq(node) { return true; }
        it = std::json::array_next(it);
    }
    return false;
}

/// Why placement `id` across `leader` and `follower` withdraws, reading
/// `rows` after it was kept: another placement across nodes takes part on
/// one of its nodes, kept meanwhile by another api ("" when none does).
@bounded_by(rows)
fn spanning_rival(rows: st::PlacementRows, id: String, leader: String, follower: String) -> String {
    for r in rows.rows {
        if !r.removed && r.id != id && spans(r.body) {
            let on = if places_on(r.body, leader) {
                leader
            } else if places_on(r.body, follower) {
                follower
            } else {
                ""
            };
            if len(on) > 0 {
                return "placement " + r.id + " was placed across " + on
                    + " while this was, and a node takes part in one at a time; place it again";
            }
        }
    }
    return "";
}

/// True when a placement (`body` its row's body) spans two nodes.
@bounded_by(body)
fn spans(body: String) -> Bool {
    let mut n = 0;
    let mut it = std::json::array_first(std::json::find_field_raw(body, "nodes"));
    while !it.done {
        n = n + 1;
        it = std::json::array_next(it);
    }
    return n > 1;
}

/// A node a placement may be put on: its capabilities as declared, and its
/// managed engine.
type Placeable { capabilities: String = ""; managed: String = ""; }

// ---- the fit ----------------------------------------------------------

/// How a runtime's accelerator ranks on a machine that has it, lower first:
/// a GPU through its native API (CUDA, ROCm, Metal), then through Vulkan,
/// then the processors.
fn accelerator_rank(on: String) -> Int {
    if on == "cpu" { return 2; }
    if on == "vulkan" { return 1; }
    return 0;
}

/// The runtime among `rts` that reads `format` on a machine, as its
/// hardware says: one for its platform, on the best of its accelerators it
/// runs on (`accelerator_rank`), its processors last; "" when none does.
@bounded_by(rts)
fn runtime_for(format: String, hw: String, rts: RuntimeList, decision: Bool) -> String {
    let os = std::json::find_string_field(hw, "os");
    let arch = std::json::find_string_field(hw, "arch");
    let accel = accelerator_kinds(hw);
    let mut best = "";
    let mut best_rank = 3;
    for r in rts.data {
        // a decision model's server serves decision models, and only it does
        if (r.server == "decision") != decision { continue; }
        let mut reads = false;
        for f in r.formats {
            if model_format_name(f) == format { reads = true; }
        }
        let mut here = false;
        for p in r.platforms {
            if host_os_name(p.os) == os && host_arch_name(p.arch) == arch { here = true; }
        }
        // its kernels built for the machine's GPU, when it says which
        if reads && here && (!r.has_compute_capabilities || computes_on(r, hw)) {
            let on = runtime_accelerator_name(r.accelerator);
            let rank = accelerator_rank(on);
            if (on == "cpu" || std::str::contains(accel, "," + on + ",")) && rank < best_rank {
                best = r.id;
                best_rank = rank;
            }
        }
    }
    return best;
}

/// True when one of the machine's GPUs (its `hw`) declares a compute
/// capability runtime `r` is built for (`RuntimeCreate.compute_capabilities`).
@bounded_by(hw)
fn computes_on(r: Runtime, hw: String) -> Bool {
    let mut it = std::json::array_first(std::json::find_field_raw(hw, "accelerators"));
    while !it.done {
        let cap = std::json::find_string_field(it.element, "compute_capability");
        for cc in r.compute_capabilities {
            if len(cap) > 0 && cc == cap { return true; }
        }
        it = std::json::array_next(it);
    }
    return false;
}

/// Which of the nodes of `j` has no GPU runtime `rt` (among `rts`) is
/// built for (`RuntimeCreate.compute_capabilities`), as a reason says it;
/// "" when every one has.
@bounded_by(rts)
fn other_gpu(rts: RuntimeList, rt: String, j: Judging) -> String {
    for r in rts.data {
        if r.id == rt && r.has_compute_capabilities {
            let mut i = 0;
            while i < count(j.hw) {
                if !computes_on(r, at(j.hw, i) or "{}") {
                    let built = st::JsonList { };
                    for cc in r.compute_capabilities {
                        built.add(cc);
                    }
                    return "its kernels are built for compute capability "
                        + std::str::replace(built.text(), ", ", " or ")
                        + (
                            if count(j.hw) > 1 {
                                ", and node " + (at(j.names, i) or "") + "'s GPU is not"
                            } else {
                                ", and the node's GPU is not"
                            }
                        );
                }
                i = i + 1;
            }
        }
    }
    return "";
}

/// True when the runtime `id` runs on processors, not an accelerator.
fn runs_on_cpu(rts: RuntimeList, id: String) -> Bool {
    for r in rts.data {
        if r.id == id { return r.accelerator == RuntimeAccelerator::cpu; }
    }
    return false;
}

/// The accelerator the runtime `id` runs on, by name.
fn runtime_on(rts: RuntimeList, id: String) -> String {
    for r in rts.data {
        if r.id == id { return runtime_accelerator_name(r.accelerator); }
    }
    return "";
}

/// A model this small (its largest variant's weights, in bytes: about 4B
/// parameters at 16 bits) is served on CUDA from its GGUF, by llama-server,
/// before its safetensors by vLLM: llama-server is up in seconds, where
/// vLLM's warm-up (its kernels compiled and tuned, its graphs captured)
/// takes a minute or two, for a throughput a small model does not need.
const SMALL_MODEL_BYTES: Int = 8589934592;

/// Whether a recipe's model is small (`SMALL_MODEL_BYTES`): its largest
/// variant's files together, the weights at their most faithful.
@bounded_by(variants)
fn small_model(variants: String) -> Bool {
    let mut most = 0;
    let mut it = std::json::array_first(variants);
    while !it.done {
        let mut bytes = 0;
        let mut f = std::json::array_first(std::json::find_field_raw(it.element, "files"));
        while !f.done {
            bytes = bytes + std::json::find_int_field(f.element, "bytes");
            f = std::json::array_next(f);
        }
        if bytes > most { most = bytes; }
        it = std::json::array_next(it);
    }
    return most > 0 && most < SMALL_MODEL_BYTES;
}

/// A format's place in the machine's preference, lower first: the form
/// made for the accelerator before the one that runs anywhere. On CUDA a
/// small model (`small`) takes its GGUF first (`SMALL_MODEL_BYTES`).
fn format_rank(format: String, hw: String, small: Bool) -> Int {
    let accel = accelerator_kinds(hw);
    if std::str::contains(accel, ",metal,") { return if format == "mlx" { 0 } else { 1 }; }
    if std::str::contains(accel, ",cuda,") {
        if small { return if format == "gguf" { 0 } else { 1 }; }
        // the GPU's own forms: safetensors under vLLM, EXL3 under TensorFold
        return if format == "safetensors" || format == "exl3" { 0 } else { 1 };
    }
    // an AMD or Intel GPU is served by llama.cpp: its own format first
    if std::str::contains(accel, ",rocm,") || std::str::contains(accel, ",vulkan,") {
        return if format == "gguf" { 0 } else { 1 };
    }
    return 0;
}

/// The kinds of the machine's accelerators, as `,cuda,metal,`.
@bounded_by(hw)
fn accelerator_kinds(hw: String) -> String {
    let out = std::bytes::BytesBuilder { initial_cap: 32 };
    out.append_str(",");
    let mut it = std::json::array_first(std::json::find_field_raw(hw, "accelerators"));
    while !it.done {
        out.append_str(std::json::find_string_field(it.element, "kind") + ",");
        it = std::json::array_next(it);
    }
    let b = out.snapshot() or b",";
    return std::str::from_bytes(b);
}

// ---- the room for models ----------------------------------------------

/// What a model served on accelerator `on` (a runtime's, `cpu` for the
/// processors) may hold of a machine of hardware `hw`, before its other
/// placements: the machine's memory for models (`model_memory_bytes`, as
/// the node offers it), and on a GPU with memory of its own (not unified,
/// `gpu_memory`) no more than that GPU's. A runtime on a GPU that shares
/// the machine's memory (a GB10's, Apple silicon's) and one on the
/// processors draw on the machine's. Every fit counts a node's room by
/// this: a placement's, a suggestion's, the arranger's.
@bounded_by(hw)
fn models_memory(hw: String, on: String) -> Int {
    let model = std::json::find_int_field(hw, "model_memory_bytes");
    let gpu = gpu_memory(hw, on);
    return if gpu >= 0 && gpu < model { gpu } else { model };
}

/// The memory of a machine's GPU a runtime on accelerator `on` runs on,
/// when the GPU has its own: the first of the machine's accelerators of
/// that kind (an AMD card is listed twice, as `rocm` and as `vulkan`; the
/// first is the one a seat's server is given, node/hardware.hl
/// `gpu_memory_of`); -1 on the processors, on a GPU that shares the
/// machine's memory (`unified`), or when it does not say.
@bounded_by(hw)
fn gpu_memory(hw: String, on: String) -> Int {
    if on == "cpu" { return -1; }
    let mut it = std::json::array_first(std::json::find_field_raw(hw, "accelerators"));
    while !it.done {
        if std::json::find_string_field(it.element, "kind") == on {
            if std::json::find_bool_field(it.element, "unified") { return -1; }
            let memory = std::json::find_int_field(it.element, "memory_bytes");
            return if memory > 0 { memory } else { -1 };
        }
        it = std::json::array_next(it);
    }
    return -1;
}

/// The nodes a variant is judged against: one, or a pair it is split
/// across, each with its name (for a reason), its hardware, the memory it
/// has left for models (on its processors, or a GPU that shares it:
/// `room_on` counts a GPU's own) and what its other placements hold of it.
type Judging {
    names: bounded[String; 2];
    hw: bounded[String; 2];
    room: bounded[Int; 2];
    held: bounded[Int; 2];
    // the disk each has free: what it declared, less what a plan has
    // already put there (arranger.hl)
    disk: bounded[Int; 2];
}

/// `j` with node `name` added: its hardware `hw`, and `held` of its memory
/// for models held by its other placements.
fn judging_add(j: Judging, name: String, hw: String, held: Int) -> Judging {
    let mut out = j;
    push(out.names, name) or discard;
    push(out.hw, hw) or discard;
    push(out.room, std::json::find_int_field(hw, "model_memory_bytes") - held) or discard;
    push(out.held, held) or discard;
    push(out.disk, std::json::find_int_field(hw, "disk_free_bytes")) or discard;
    return out;
}

/// The room node `i` of `j` has left for a model served on accelerator
/// `on`: its room for models, less what that falls short of on a GPU with
/// memory of its own (`models_memory`).
fn room_on(j: Judging, i: Int, on: String) -> Int {
    let hw = at(j.hw, i) or "{}";
    let short = std::json::find_int_field(hw, "model_memory_bytes") - models_memory(hw, on);
    return (at(j.room, i) or 0) - short;
}

/// The least room for a model served on accelerator `on` any of `j`'s
/// nodes has left (`room_on`).
fn least_room(j: Judging, on: String) -> Int {
    let mut least = -1;
    let mut i = 0;
    while i < count(j.hw) {
        let r = room_on(j, i, on);
        if i == 0 || r < least { least = r; }
        i = i + 1;
    }
    return least;
}

/// What each of `parts` nodes holds of a variant `v` split across them by
/// tensor parallelism: its share of the weights and their buffers (5%, as
/// scripts/catalog-recipes.py counts them in `memory_bytes`), and the whole
/// cache for the context the variant is fitted to, which vLLM keeps whole
/// on every rank of a latent-attention model and voice counts whole for
/// any. On one node, the variant's `memory_bytes`.
@bounded_by(v)
fn part_need(v: String, parts: Int) -> Int {
    let need = std::json::find_int_field(v, "memory_bytes");
    if parts <= 1 { return need; }
    let mut weights = 0;
    let mut it = std::json::array_first(std::json::find_field_raw(v, "files"));
    while !it.done {
        weights = weights + std::json::find_int_field(it.element, "bytes");
        it = std::json::array_next(it);
    }
    let buffered = weights * 105 / 100;
    if buffered >= need { return (need + parts - 1) / parts; }
    return need - buffered + (buffered + parts - 1) / parts;
}

/// Every variant of a recipe judged against a machine (`judge_variant`),
/// and the one a placement takes when none is named: of those that fit, the
/// format the machine serves best (`format_rank`), off the CPU, then the
/// biggest, the most faithful weights it has room for; -1 when none fits.
type Judged { fit: bounded[VariantFit; 8]; best: Int = -1; }

/// A recipe judged against one machine of hardware `hw`, `room` left of its
/// memory for models and `held` of it held by its other placements.
@bounded_by(variants)
fn judge_recipe(
    variants: String,
    hw: String,
    rts: RuntimeList,
    room: Int,
    held: Int,
    decision: Bool
) -> Judged {
    let mut j = judging_add(Judging { }, "", hw, held);
    set(j.room, 0, room) or discard;
    return judge_on(variants, j, rts, decision);
}

/// True when runtime `r` may serve a placement on `parts` nodes: across two,
/// one whose server spans them (`multi_node`); on one, any but a server that
/// runs only across two (`lanes`).
fn serves_on(r: Runtime, parts: Int) -> Bool {
    if parts > 1 { return r.has_multi_node; }
    return !(r.has_multi_node && r.multi_node == MultiNode::lanes);
}

/// A recipe judged against the nodes of `j`.
@bounded_by(variants)
fn judge_on(variants: String, j: Judging, all: RuntimeList, decision: Bool) -> Judged {
    let mut out = Judged { };
    let mut rts = RuntimeList { };
    for r in all.data {
        if serves_on(r, count(j.hw)) { push(rts.data, r) or discard; }
    }
    let hw = at(j.hw, 0) or "{}";
    let small = small_model(variants);
    let mut best_rank = 0;
    let mut best_memory = 0;
    let mut i = 0;
    let mut it = std::json::array_first(variants);
    while !it.done {
        let v = it.element;
        let judged = judge_variant(v, j, rts, decision);
        push(out.fit, judged) or discard;
        let rank = format_rank(std::json::find_string_field(v, "format"), hw, small)
            + (if judged.has_runtime && runs_on_cpu(rts, judged.runtime) { 10 } else { 0 });
        let memory = std::json::find_int_field(v, "memory_bytes");
        if judged.fits
            && (out.best < 0 || rank < best_rank || (rank == best_rank && memory > best_memory))
        {
            out.best = i;
            best_rank = rank;
            best_memory = memory;
        }
        i = i + 1;
        it = std::json::array_next(it);
    }
    return out;
}

/// One variant judged against the nodes of `j` and the runtimes that may
/// serve it: a runtime reads its format there, each node's share of it
/// (`part_need`) fits what models may use of its memory, and its files fit
/// each node's disk (every rank reads the files whole). A decision recipe's
/// (`decision`) is served only by a decision server (`decision`), and a
/// generative one never. Across two nodes, `rts` holds only runtimes that
/// span nodes, and each node is named in the reason.
@bounded_by(v)
fn judge_variant(v: String, j: Judging, rts: RuntimeList, decision: Bool) -> VariantFit {
    let parts = count(j.hw);
    let hw = at(j.hw, 0) or "{}";
    let id = std::json::find_string_field(v, "id");
    let format = std::json::find_string_field(v, "format");
    let rt = runtime_for(format, hw, rts, decision);
    if len(rt) == 0 {
        return VariantFit {
            variant: id,
            fits: false,
            reason: (
                if decision {
                    "no decision runtime (a decision model's server)"
                } else if parts > 1 {
                    "no runtime that spans nodes"
                } else {
                    "no runtime"
                }
            )
                + " reads " + format + " on " + std::json::find_string_field(hw, "os")
                + "/"
                + std::json::find_string_field(hw, "arch") + " with " + accelerators_said(hw),
        };
    }
    let runs = rt + " runs " + format + " on " + runtime_on(rts, rt)
        + (if parts > 1 { " across " + to_string(parts) + " nodes" } else { "" });
    // across two nodes, the follower's GPU as well as the leader's
    let gpu_short = other_gpu(rts, rt, j);
    if len(gpu_short) > 0 {
        return VariantFit {
            variant: id,
            has_runtime: true,
            runtime: rt,
            fits: false,
            reason: runs + "; " + gpu_short,
        };
    }
    // what its seat takes on each node, its server's own beside its share,
    // in the room its runtime has there: a GPU's own memory, or the
    // machine's (`models_memory`)
    let need = footprint(part_need(v, parts));
    let on = runtime_on(rts, rt);
    let mut memory = "";
    let mut disk = "";
    let mut short = false;
    let mut full = false;
    let mut i = 0;
    while i < parts {
        let node_hw = at(j.hw, i) or "{}";
        let room = room_on(j, i, on);
        let held = at(j.held, i) or 0;
        let name = if parts > 1 { (at(j.names, i) or "") + ": " } else { "" };
        let bound = models_memory(node_hw, on);
        let said = name + gb(need) + " of " + gb(if room > 0 { room } else { 0 })
            + (
                if bound < std::json::find_int_field(node_hw, "model_memory_bytes") {
                    " free of its GPU's " + gb(bound)
                } else {
                    " free for models"
                }
            )
            + (if held > 0 { " (" + gb(held) + " held by its other placements)" } else { "" });
        memory = if i == 0 { said } else { memory + "; " + said };
        if need > room { short = true; }
        let free = at(j.disk, i) or 0;
        let size = disk_need(v, i);
        let on_disk = name + gb(size) + " of " + gb(free) + " free";
        disk = if i == 0 { on_disk } else { disk + "; " + on_disk };
        if size > free { full = true; }
        i = i + 1;
    }
    if short {
        return VariantFit {
            variant: id,
            has_runtime: true,
            runtime: rt,
            fits: false,
            reason: runs + "; needs " + memory,
        };
    }
    if full {
        return VariantFit {
            variant: id,
            has_runtime: true,
            runtime: rt,
            fits: false,
            reason: runs + "; " + memory + "; needs " + disk,
        };
    }
    return VariantFit {
        variant: id,
        has_runtime: true,
        runtime: rt,
        fits: true,
        reason: runs + "; " + memory + "; " + disk,
    };
}

/// A machine's accelerators, as a reason says them.
fn accelerators_said(hw: String) -> String {
    let kinds = accelerator_kinds(hw);
    if kinds == "," { return "no accelerator"; }
    return std::str::replace(kinds[1..(len(kinds) - 1)], ",", " and ");
}

/// What variant `v` keeps on the disk of the node that runs its rank
/// `rank`: every file it fetches (`fetched_bytes`), and what that node's
/// prepare step makes (`prepared`: each file every rank makes, and its own
/// rank's).
@bounded_by(v)
fn disk_need(v: String, rank: Int) -> Int {
    let mut size = fetched_bytes(v);
    let mut p = std::json::array_first(std::json::find_field_raw(v, "prepared"));
    while !p.done {
        let ranked = len(std::json::find_field_raw(p.element, "rank")) > 0;
        if !ranked || std::json::find_int_field(p.element, "rank") == rank {
            size = size + std::json::find_int_field(p.element, "bytes");
        }
        p = std::json::array_next(p);
    }
    return size;
}

/// What a node fetches of variant `v`: its own files, and its file sets'
/// (a set pinned by a manifest at the bytes it says).
@bounded_by(v)
fn fetched_bytes(v: String) -> Int {
    let mut size = files_bytes(std::json::find_field_raw(v, "files"));
    let mut it = std::json::array_first(std::json::find_field_raw(v, "file_sets"));
    while !it.done {
        let m = std::json::find_field_raw(it.element, "manifest");
        size = size
            + (
                if len(m) > 0 {
                    std::json::find_int_field(m, "bytes")
                        + std::json::find_int_field(it.element, "bytes")
                } else {
                    files_bytes(std::json::find_field_raw(it.element, "files"))
                }
            );
        it = std::json::array_next(it);
    }
    return size;
}

/// The bytes of a list of files, together.
@bounded_by(files)
fn files_bytes(files: String) -> Int {
    let mut size = 0;
    let mut f = std::json::array_first(files);
    while !f.done {
        size = size + std::json::find_int_field(f.element, "bytes");
        f = std::json::array_next(f);
    }
    return size;
}

/// Every variant's reason, for a refusal.
@bounded_by(fit)
fn reasons(fit: bounded[VariantFit; 8]) -> String {
    let out = st::JsonList { };
    for f in fit {
        out.add(f.variant + ": " + f.reason);
    }
    return std::str::replace(out.text(), ", ", "; ");
}

/// Bytes as gigabytes (10^9) to a tenth, terabytes past 1000 GB, or
/// megabytes under 1 GB.
fn gb(n: Int) -> String {
    if n < 1000000000 {
        let m = (n + 50000) / 100000;
        return to_string(m / 10) + "." + to_string(m % 10) + " MB";
    }
    if n >= 1000000000000 {
        let t = (n + 50000000000) / 100000000000;
        return to_string(t / 10) + "." + to_string(t % 10) + " TB";
    }
    let t = (n + 50000000) / 100000000;
    return to_string(t / 10) + "." + to_string(t % 10) + " GB";
}
