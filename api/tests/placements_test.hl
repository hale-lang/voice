// Placements on the admin plane: a local model put on a node, the variant
// and the runtime chosen by what the node declared it has and the runtimes
// there are, and refused when none fits.
import ".." as api;
import "../../store" as st;

fn fixtures(sub: String) -> String {
    let here = "spec/validate/" + sub;
    return if std::io::fs::file_exists(here) { here } else { "../" + here };
}

fn blank() -> api::Placement { return api::Placement { id: "refused" }; }

/// A node that registered, declaring `hardware`.
fn node(store: st::Store, id: String, hardware: String) {
    store.insert_node(
        st::NodeRow { id: id, name: id, max_in_flight: 4, created_at: api::now_seconds() },
        api::change("create", "nodes/" + id, "", "{}"),
    ) or discard;
    store.put_fleet(
        st::FleetRow {
            node: id,
            capabilities: "{\"max_in_flight\": 4, \"engines\": [{\"id\": \"managed\", \"kind\": \"managed\", \"config_schema\": {}}], \"hardware\": "
                + hardware + "}",
            present: true,
        },
    ) or discard;
}

fn hardware(accel: String, model_memory: Int, disk: Int) -> String {
    return "{\"os\": \"linux\", \"arch\": \"arm64\", \"memory_bytes\": 137438953472, \"model_memory_bytes\": "
        + to_string(model_memory) + ", \"accelerators\": " + accel + ", \"disk_free_bytes\": "
        + to_string(disk) + "}";
}

/// A seat's prompt cache: four conversations of the model's context (at
/// most 128k), from at most half the spare memory and no more than the
/// model's own, never less than the fitted 32k.
fn cache_pool() {
    let big = 100000000000;
    std::test::assert_eq_int(
        api::cache_pool(big, 0, 262144, big),
        32768,
        "no per-token cost, the fitted context",
    );
    std::test::assert_eq_int(
        api::cache_pool(big, 24576, 262144, big),
        524288,
        "room to spare: four of 128k",
    );
    std::test::assert_eq_int(
        api::cache_pool(big, 24576, 40960, big),
        163840,
        "four of a smaller model's own",
    );
    std::test::assert_eq_int(
        api::cache_pool(2000000000, 24576, 262144, big),
        32768 + 1000000000 / 24576,
        "half the spare, when that is less",
    );
    std::test::assert_eq_int(
        api::cache_pool(0, 24576, 262144, big),
        32768,
        "none to spare, the fitted context",
    );
    std::test::assert_eq_int(
        api::cache_pool(big, 24576, 4096, big),
        32768,
        "never less than the fitted context",
    );
    std::test::assert_eq_int(
        api::cache_pool(big, 114688, 40960, 1500000000),
        32768 + 1500000000 / 114688,
        "a cache no larger than the model it serves",
    );
}

/// A node's room for a placement is what its others leave.
fn held_room(store: st::Store, catalog: api::Catalog, placements: api::Placements, gb10: String) {
    node(store, "tight", hardware(gb10, 10000000000, 3500000000000));
    catalog.create(
        api::CatalogModelCreate { id: "fixture-a", has_recipe: true, recipe: "fixture-1" },
    ) or discard;
    catalog.create(
        api::CatalogModelCreate { id: "fixture-b", has_recipe: true, recipe: "fixture-1" },
    ) or discard;
    let mut first = api::PlacementCreate { id: "tight-a", model: "fixture-a", account: "local" };
    push(first.nodes, "tight") or discard;
    let mut first_why = "";
    let a = placements.create(first) or {
        first_why = api::ctl_message(err);
        blank()
    };
    std::test::assert_eq_str(a.id, "tight-a", "the first fits: " + first_why);
    let mut second = api::PlacementCreate { id: "tight-b", model: "fixture-b", account: "local" };
    push(second.nodes, "tight") or discard;
    let mut why = "";
    placements.create(second) or {
        why = api::ctl_message(err);
    };
    std::test::assert(
        std::str::contains(
            why,
            "needs 5.6 GB of 4.4 GB for models (5.6 GB held by its other placements)",
        ),
        "the second does not, beside it: " + why,
    );
}

fn main() {
    let store = st::MemoryStore { };
    let recipes = api::Recipes {
        store: store,
        shipped: api::shipped_recipes(fixtures("recipes/ok")),
    };
    let catalog = api::Catalog { store: store, recipes: recipes };
    let runtimes = api::Runtimes {
        store: store,
        shipped: api::shipped_runtimes(fixtures("runtimes/ok")),
    };
    let seats = api::Seats { store: store, link: api::NatsLink { } };
    let placements = api::Placements {
        store: store,
        recipes: recipes,
        runtimes: runtimes,
        seats: seats,
    };
    api::Accounts { store: store }.create(
        api::AccountCreate { id: "local", name: "Local" },
    ) or discard;
    let gb10 = "[{\"kind\": \"cuda\", \"name\": \"NVIDIA GB10\", \"memory_bytes\": 128000000000, \"unified\": true}]";

    catalog.create(
        api::CatalogModelCreate { id: "fixture", has_recipe: true, recipe: "fixture-1" },
    ) or discard;
    catalog.create(api::CatalogModelCreate { id: "bare" }) or discard;
    node(store, "spark", hardware(gb10, 128000000000, 3500000000000));
    node(store, "small", hardware(gb10, 4000000000, 3500000000000));
    node(store, "bare-cpu", hardware("[]", 128000000000, 3500000000000));
    node(store, "full", hardware(gb10, 128000000000, 1000000000));
    store.insert_node(
        st::NodeRow {
            id: "unmeasured",
            name: "unmeasured",
            max_in_flight: 4,
            created_at: api::now_seconds(),
        },
        api::change("create", "nodes/unmeasured", "", "{}"),
    ) or discard;

    let mut one = api::PlacementCreate { id: "on-spark", model: "fixture", account: "local" };
    push(one.nodes, "spark") or discard;
    let p = placements.create(one) or blank();
    std::test::assert_eq_str(p.id, "on-spark", "a model is placed");
    std::test::assert_eq_str(p.variant, "gguf-q4_k_m", "on the variant that fits");
    std::test::assert_eq_str(
        p.runtime,
        "fixture-runtime",
        "served by the runtime that reads it there",
    );
    std::test::assert(
        p.chosen_by == api::PlacementChooser::coordinator,
        "chosen by the coordinator",
    );
    std::test::assert_eq_str(p.leader, "spark", "led by its node");
    std::test::assert_eq_str(p.seat, "spark/on-spark", "and holds its seat there");
    let seat = store.seat("spark", "on-spark") or st::SeatRow { };
    std::test::assert(
        seat.present && seat.engine == "managed" && seat.account == "local",
        "on the managed engine",
    );
    std::test::assert(
        std::str::contains(seat.config, "\"placement\": \"on-spark\"")
            && std::str::contains(seat.config, "\"runtime\": {\"id\": \"fixture-runtime\""),
        "its config the variant and runtime, pinned",
    );
    let fit = at(p.fit, 0) or api::VariantFit { };
    std::test::assert(
        fit.fits && std::str::contains(fit.reason, "fixture-runtime runs gguf on cuda"),
        "and says why: " + fit.reason,
    );
    let read = placements.get(api::PlacementRef { placement: "on-spark" }) or blank();
    std::test::assert(read.variant == p.variant && count(read.fit) == 1, "it reads back");
    // the fixture recipe does not say what a token costs: the context its
    // memory was fitted for, and the variant's need, held
    std::test::assert_eq_int(p.cache_tokens, 32768, "a cache of the fitted context");
    std::test::assert_eq_int(p.reserved_bytes, 5600000000, "it holds its variant's need");
    std::test::assert_eq_int(read.reserved_bytes, p.reserved_bytes, "and reads back what it holds");
    std::test::assert(
        std::str::contains(seat.config, "\"cache_tokens\": 32768"),
        "its seat is told its cache",
    );
    cache_pool();

    let mut failed = "";
    let mut again = api::PlacementCreate { id: "twice", model: "fixture", account: "local" };
    push(again.nodes, "spark") or discard;
    placements.create(again) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "a model is placed once on a node");

    let mut small = api::PlacementCreate { id: "on-small", model: "fixture", account: "local" };
    push(small.nodes, "small") or discard;
    let mut why = "";
    placements.create(small) or {
        why = api::ctl_message(err);
    };
    std::test::assert(
        std::str::contains(why, "needs 5.6 GB of 4.0 GB for models"),
        "too little memory: " + why,
    );
    let mut full = api::PlacementCreate { id: "on-full", model: "fixture", account: "local" };
    push(full.nodes, "full") or discard;
    why = "";
    placements.create(full) or {
        why = api::ctl_message(err);
    };
    std::test::assert(
        std::str::contains(why, "needs 4.9 GB of 1.0 GB free"),
        "too little disk: " + why,
    );

    let mut named = api::PlacementCreate {
        id: "named",
        model: "fixture",
        account: "local",
        has_variant: true,
        variant: "nope",
    };
    push(named.nodes, "full") or discard;
    failed = "";
    placements.create(named) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a variant the recipe has not");
    let mut unmeasured = api::PlacementCreate { id: "blind", model: "fixture", account: "local" };
    push(unmeasured.nodes, "unmeasured") or discard;
    failed = "";
    placements.create(unmeasured) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a node that declared no hardware");
    let mut bare = api::PlacementCreate { id: "bare", model: "bare", account: "local" };
    push(bare.nodes, "spark") or discard;
    failed = "";
    placements.create(bare) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a model with no recipe has no weights to place");

    let mut cpu = api::PlacementCreate { id: "on-cpu", model: "fixture", account: "local" };
    push(cpu.nodes, "bare-cpu") or discard;
    why = "";
    placements.create(cpu) or {
        why = api::ctl_message(err);
    };
    std::test::assert(
        std::str::contains(why, "no runtime reads gguf on linux/arm64 with no accelerator"),
        "no runtime runs it there: " + why,
    );
    let mut unknown = api::PlacementCreate {
        id: "unknown-rt",
        model: "fixture",
        account: "local",
        has_runtime: true,
        runtime: "nope",
    };
    push(unknown.nodes, "full") or discard;
    failed = "";
    placements.create(unknown) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a runtime there is not");
    let mut mac = api::PlacementCreate {
        id: "wrong-rt",
        model: "fixture",
        account: "local",
        has_runtime: true,
        runtime: "fixture-archive",
    };
    push(mac.nodes, "small") or discard;
    why = "";
    placements.create(mac) or {
        why = api::ctl_message(err);
    };
    std::test::assert(
        std::str::contains(why, "no runtime reads gguf"),
        "a runtime for another platform: " + why,
    );
    failed = "";
    runtimes.remove(api::RuntimeRef { runtime: "fixture-runtime" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "a shipped runtime stays");

    failed = "";
    catalog.remove(api::ModelRef { model: "fixture" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "a placed model stays in the catalog");
    let gone = placements.remove(api::PlacementRef { placement: "on-spark" }) or blank();
    std::test::assert_eq_str(gone.id, "on-spark", "a placement is withdrawn");
    std::test::assert(
        !(store.seat("spark", "on-spark") or st::SeatRow { }).present,
        "and its seat with it",
    );
    // a placement from before placements made seats records none: its
    // withdrawal leaves a seat of its id alone
    store.insert_placement(
        st::PlacementRow {
            id: "legacy",
            model: "fixture",
            body: "{\"id\": \"legacy\", \"model\": \"fixture\", \"leader\": \"spark\", \"variant\": \"gguf-q4_k_m\"}",
        },
        api::change("create", "placements/legacy", "", "{}"),
    ) or discard;
    let mut own = api::SeatCreate {
        node: "spark",
        id: "legacy",
        engine: "managed",
        account: "local",
    };
    push(own.serves, st::SeatModel { model: "fixture" }) or discard;
    seats.create(own) or discard;
    placements.remove(api::PlacementRef { placement: "legacy" }) or discard;
    std::test::assert(
        (store.seat("spark", "legacy") or st::SeatRow { }).present,
        "a seat it did not make stays",
    );
    let listed = placements.list() or api::PlacementList { };
    std::test::assert_eq_int(count(listed.data), 0, "and no longer listed");
    let removed = catalog.remove(api::ModelRef { model: "fixture" }) or api::CatalogModel {
        kind: api::ModelKind::local,
    };
    std::test::assert_eq_str(removed.id, "fixture", "then the model can go");
    held_room(store, catalog, placements, gb10);
}
