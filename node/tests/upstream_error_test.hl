// An upstream's error, as the node reports it: its status, the kind of
// error it named (an OpenAI `code`, or llama-server's `type`) and its
// message, so the coordinator can tell a request too long for the seat.
import ".." as node;

fn main() {
    let openai = node::error_datum(
        400,
        "{\"error\": {\"code\": \"context_length_exceeded\", \"message\": \"Input is too long.\", \"type\": \"invalid_request_error\"}}",
    );
    std::test::assert_eq_str(
        openai.failure,
        "the upstream answered 400 (context_length_exceeded): Input is too long.",
        "an OpenAI upstream's code is kept",
    );
    let llama = node::error_datum(
        400,
        "{\"error\": {\"code\": 400, \"message\": \"request (33482 tokens) exceeds the available context size (32768 tokens), try increasing it\", \"type\": \"exceed_context_size_error\"}}",
    );
    std::test::assert(
        std::str::starts_with(
            llama.failure,
            "the upstream answered 400 (exceed_context_size_error): request (33482 tokens)",
        ),
        "llama-server's type, when its code is a number: " + llama.failure,
    );
    std::test::assert_eq_str(
        node::error_datum(502, "bad gateway").failure,
        "the upstream answered 502",
        "an error with no body to read says its status",
    );
}
