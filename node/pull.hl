            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
            nats::JsPuller { },
        ];
        // each puller's queue, by the same index
        slots: PullSlots = PullSlots { };
        // what each seat consumes, and how its pulls go
        seats: SeatPulls = SeatPulls { };
        node: String = "";
        root: String = "";
        stream: String = "";
        // the last plan, once there is one
        plan: work::ConsumePlan = work::ConsumePlan { };
        planned: Bool = false;
        // something changed since the last look; and when that was
        // (monotonic ns)
        dirty: Bool = true;
        looked: Int = 0;
        // the queues past the pool when last said, so it is said once
        over: Int = 0;
    }

    /// The node `node` under `root`: every pull let go when either changed,
    /// its queues under the old root being no longer its own.
    fn place(c: nats::NatsClient, node: String, root: String) {
        if node == self.node && root == self.root { return; }
        self.close_all(c);
        self.node = node;
        self.root = root;
        self.stream = work::stream_name(root);
        self.slots = PullSlots { };
        self.dirty = true;
    }

    /// A plan from the brain, taken when it is newer than the one held;
    /// true when it was.
    fn adopt_plan(p: work::ConsumePlan) -> Bool {
        if self.planned && p.version <= self.plan.version { return false; }
        self.plan = p;
        self.planned = true;
        return true;
    }

    /// What each of `seats` (as applied from `assignment`, within
    /// `capabilities`) consumes, worked out again, and the pullers given to
    /// its queues: a queue kept keeps its puller and its pull; one no seat
    /// consumes any more has its puller let go.
    @unbounded
    fn configure(c: nats::NatsClient, seats: NodeSeats, assignment: String, capabilities: String) {
        if len(self.root) == 0 { return; }
        let mut next = SeatPulls { };
        let mut it = std::json::array_first(std::json::find_field_raw(assignment, "seats"));
        while !it.done {
            let s = std::str::trim(it.element);
            let id = std::json::find_string_field(s, "id");
            let applied = seat_of(seats, id);
            if len(applied.id) > 0 {
                let mut p = seat_pull_of(
                    self.root,
                    self.node,
                    s,
                    engine_kind(capabilities, applied.engine),
                    self.plan,
                    self.planned,
                );
                // what the seat was doing, and a decline it remembers
                for held in self.seats.items {
                    if held.seat == id {
                        p.state = held.state;
                        p.reason = held.reason;
                        p.ineligible = held.ineligible;
                        p.ineligible_until = held.ineligible_until;
                        p.held = held.held;
                        p.prefill = held.prefill;
                    }
                }
                push(next.items, p) or discard;
            }
            it = std::json::array_next(it);
        }
        self.seats = next;
        self.allot(c);
        self.dirty = true;
    }

    /// The pullers given to the seats' queues, in rounds: each seat's first
    /// queue (its own), then each one's second, and so on, so a seat past
    /// the pool loses its last queues, not its first.
    @unbounded
    fn allot(c: nats::NatsClient) {
        // pullers whose queue no seat consumes any more are let go
        let mut i = 0;
        while i < count(self.slots.items) {
            let p = at(self.slots.items, i) or PullSlot { };
            if len(p.seat) > 0 && self.order_of(p.seat, p.subject) < 0 {
                let q: nats::JsPuller = self.ps[i];
                q.close(c);
                set(self.slots.items, i, PullSlot { }) or discard;
            }
            i = i + 1;
        }
        while count(self.slots.items) < PULLS_MAX {
            push(self.slots.items, PullSlot { }) or discard;
        }
        let mut wanted = 0;
        let mut placed = 0;
        let mut k = 0;
        while k < work::CONSUME_MAX {
            for s in self.seats.items {
                if len(s.hold) == 0 && k < count(s.queues) {
                    let subject = at(s.queues, k) or "";
                    wanted = wanted + 1;
                    if self.place_queue(c, s.seat, subject, k) { placed = placed + 1; }
                }
            }
            k = k + 1;
        }
        if wanted > placed && wanted != self.over {
            log_warn(
                "the node's seats consume more queues than it pulls at once: the last are not pulled",
                fields2(
                    std::log::kv("queues", to_string(wanted)),
                    std::log::kv("pulled", to_string(placed)),
                ),
            );
        }
        self.over = if wanted > placed { wanted } else { 0 };
    }

    /// The place of `subject` among seat `seat`'s queues, -1 when the seat
    /// does not consume it (or its plan holds it).
    fn order_of(seat: String, subject: String) -> Int {
        for s in self.seats.items {
            if s.seat == seat {
                if len(s.hold) > 0 { return -1; }
                let mut k = 0;
                for q in s.queues {
                    if q == subject { return k; }
                    k = k + 1;
                }
            }
        }
        return -1;
    }

    /// Seat `seat`'s queue `subject`, `order`th of its queues, on a puller:
    /// the one it has, or a free one; false when none is free.
    @unbounded
    fn place_queue(c: nats::NatsClient, seat: String, subject: String, order: Int) -> Bool {
        let mut free = -1;
        let mut i = 0;
        while i < count(self.slots.items) {
            let p = at(self.slots.items, i) or PullSlot { };
            if p.seat == seat && p.subject == subject {
                let mut kept = p;
                kept.order = order;
                set(self.slots.items, i, kept) or discard;
                return true;
            }
            if free < 0 && len(p.seat) == 0 { free = i; }
            i = i + 1;
        }
        if free < 0 { return false; }
        self.ps[free].stream = self.stream;
        self.ps[free].consumer = work::consumer_name(subject);
        set(
            self.slots.items,
            free,
            PullSlot { seat: seat, subject: subject, order: order },
        ) or discard;
        return true;
    }

    /// The connection is new: every pull of the old one is gone, its
    /// inbox with it, so each queue is swept again.
    fn reset() {
        let mut i = 0;
        while i < PULLS_MAX {
            self.ps[i].sid = 0;
            self.ps[i].pulling = false;
            i = i + 1;
        }
        i = 0;
        while i < count(self.slots.items) {
            let mut p = at(self.slots.items, i) or PullSlot { };
            p.open = "";
            p.empty = false;
            p.retry_at = 0;
            p.refusals = 0;
            set(self.slots.items, i, p) or discard;
            i = i + 1;
        }
        self.dirty = true;
    }

    /// Every pull let go: the pullers' inboxes unsubscribed, so the server
    /// drops their open pulls and delivers them nothing more.
    fn close_all(c: nats::NatsClient) {
        let mut i = 0;
        while i < PULLS_MAX {
            let q: nats::JsPuller = self.ps[i];
            if q.sid > 0 { q.close(c); }
            i = i + 1;
        }
    }

    /// Seat `seat` has a slot free again: its queues are swept again, a
    /// backlog having maybe built up while it was full.
    fn freed(seat: String) {
        self.sweep_again(seat);
        self.dirty = true;
    }

    fn sweep_again(seat: String) {
        let mut i = 0;
        while i < count(self.slots.items) {
            let mut p = at(self.slots.items, i) or PullSlot { };
            if p.seat == seat && p.empty {
                p.empty = false;
                set(self.slots.items, i, p) or discard;
            }
            i = i + 1;
        }
    }

    /// The api declined seat `seat` as ineligible for the ticket
    /// `message_id`: pulled again soon, it goes back with a delay, so the
    /// seat does not claim it over and over while another could take it.
    /// Seat `seat` was granted a turn of `conversation`: its engine holds
    /// it now, the newest of the `most` it holds.
    fn held(seat: String, conversation: String, most: Int) {
        let mut i = 0;
        while i < count(self.seats.items) {
            let mut s = at(self.seats.items, i) or SeatPull { };
            if s.seat == seat {
                s.held = held_with(s.held, conversation, most);
                set(self.seats.items, i, s) or discard;
            }
            i = i + 1;
        }
        self.dirty = true;
    }

    /// Seat `seat` served a request with `uncached` input tokens not in
    /// its engine's prompt cache, its first output after `first_ms`: its
    /// prefill rate (`prefill_with`).
    fn read_prefill(seat: String, uncached: Int, first_ms: Int) {
        let mut i = 0;
        while i < count(self.seats.items) {
            let mut s = at(self.seats.items, i) or SeatPull { };
            if s.seat == seat {
                let rate = prefill_with(s.prefill, uncached, first_ms);
                if rate != s.prefill {
                    s.prefill = rate;
                    set(self.seats.items, i, s) or discard;
                    self.dirty = true;
                }
            }
            i = i + 1;
        }
    }

    fn declined(seat: String, message_id: String, now: Int) {
        let mut i = 0;
        while i < count(self.seats.items) {
            let mut s = at(self.seats.items, i) or SeatPull { };
            if s.seat == seat {
                s.ineligible = message_id;
                s.ineligible_until = now + 10 * AVOID_DELAY_MS * 1000000;
                set(self.seats.items, i, s) or discard;
            }
            i = i + 1;
        }
    }

    /// The ticket seat `seat` was declined `ineligible` for, still
    /// remembered at `now`, "" for none.
    fn ineligible_for(seat: String, now: Int) -> String {
        for s in self.seats.items {
            if s.seat == seat && s.ineligible_until > now { return s.ineligible; }
        }
        return "";
    }

    /// The puller `m` arrived on, -1 when it is none of them.
    fn owner(m: nats::NatsMsg) -> Int {
        if m.sid <= 0 { return -1; }
        let mut i = 0;
        while i < PULLS_MAX {
            let q: nats::JsPuller = self.ps[i];
            if q.owns(m) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// The seat puller `i` pulls for, "" for none.
    fn seat_at(i: Int) -> String {
        let p = at(self.slots.items, i) or PullSlot { };
        return p.seat;
    }

    /// Whether puller `i`'s queue is still one its seat consumes: a ticket
    /// a pull opened before a plan changed it is put back.
    fn consumed(i: Int) -> Bool {
        let p = at(self.slots.items, i) or PullSlot { };
        return len(p.seat) > 0 && self.order_of(p.seat, p.subject) >= 0;
    }

    /// What `m`, arrived on puller `i`, is, with that queue's pulls brought
    /// up to date: a pull that ended leaves its queue free to pull again,
    /// found empty, or waiting out a refusal.
    fn take(i: Int, m: nats::NatsMsg, now: Int) -> nats::JsPulled {
        let q: nats::JsPuller = self.ps[i];
        let got = q.take(m);
        let mut p = at(self.slots.items, i) or PullSlot { };
        if got.kind == "msg" {
            p.refusals = 0;
            // a ticket on a standing pull: the queues are swept again, in order
            if p.open == "stand" { self.sweep_again(p.seat); }
            if !self.ps[i].pulling { p.open = ""; }
            p.empty = false;
        } else if got.kind == "no_messages" {
            p.open = "";
            p.empty = true;
            p.refusals = 0;
        } else if got.kind == "expired" {
            p.open = "";
            p.refusals = 0;
        } else if got.kind == "gone" || got.kind == "conflict" || got.kind == "status" {
            p.open = "";
            p.refusals = p.refusals + 1;
            p.retry_at = now + retry_ms(p.refusals, REFUSED_MAX_MS) * 1000000;
        }
        set(self.slots.items, i, p) or discard;
        self.dirty = true;
        return got;
    }

    /// Open the pulls due, for each seat as `seats` and `busy` say, at
    /// monotonic `now`, when anything changed or a look is due anyway;
    /// true when a seat's state changed, for the status and the heartbeat.
    @unbounded
    fn look(c: nats::NatsClient, seats: NodeSeats, busy: String, now: Int) -> Bool {
        if !self.dirty && now - self.looked < LOOK_MS * 1000000 { return false; }
        self.dirty = false;
        self.looked = now;
        // a pull past its expiry with no word from the server: refused in
        // silence (a permission it lacks, a server gone), tried again later
        let mut i = 0;
        while i < count(self.slots.items) {
            let mut p = at(self.slots.items, i) or PullSlot { };
            let q: nats::JsPuller = self.ps[i];
            if len(p.open) > 0 && q.wants_pull() {
                p.open = "";
                p.refusals = p.refusals + 1;
                p.retry_at = now + retry_ms(p.refusals, SILENT_MAX_MS) * 1000000;
                set(self.slots.items, i, p) or discard;
            }
            i = i + 1;
        }
        let mut changed = false;
        let mut j = 0;
        while j < count(self.seats.items) {
            let mut sp = at(self.seats.items, j) or SeatPull { };
            let s = seat_of(seats, sp.seat);
            let off = pull_off_reason(s);
            let free = free_for(busy, s, SLOTS);
            let mut state = "pulling";
            let mut reason = "";
            if len(sp.hold) > 0 {
                state = "held";
                reason = sp.hold;
            } else if len(off) > 0 {
                state = "off";
                reason = off;
            } else if free <= 0 {
                state = "full";
            } else if c.connected {
                let due = pulls_due(self.slots, sp.seat, free, now);
                for o in due.items {
                    self.open_pull(c, o, now);
                }
                if waits_on_all(self.slots, sp.seat, now) { state = "waiting"; }
            } else {
                state = "off";
                reason = "not on NATS";
            }
            if state != sp.state || reason != sp.reason {
                sp.state = state;
                sp.reason = reason;
                set(self.seats.items, j, sp) or discard;
                changed = true;
            }
            j = j + 1;
        }
        return changed;
    }

    /// Open the pull `o`: a sweep for its batch that takes what is there,
    /// or a standing pull of one ticket that waits `STAND_MS`.
    fn open_pull(c: nats::NatsClient, o: PullOrder, now: Int) {
        let mut p = at(self.slots.items, o.slot) or PullSlot { };
        let mut failed = false;
        let q: nats::JsPuller = self.ps[o.slot];
        if o.stand {
            q.fetch(c, 1, STAND_MS, false) or { failed = true; };
        } else {
            q.fetch(c, o.batch, 0, true) or { failed = true; };
        }
        if failed {
            // the connection is failing: the session finds it so and dials
            // again, and every pull is made anew then
            p.refusals = p.refusals + 1;
            p.retry_at = now + retry_ms(p.refusals, SILENT_MAX_MS) * 1000000;
        } else {
            p.open = if o.stand { "stand" } else { "sweep" };
        }
        set(self.slots.items, o.slot, p) or discard;
    }
}
