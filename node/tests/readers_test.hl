// The readers of a harness's output (readers.hl), over lines in the shapes
// each CLI's machine output takes (Claude Code 2.1, Codex CLI 0.166,
// Antigravity CLI 1.5, Mistral Vibe 3.0, as they wrote them for a run on a
// scratch repository, their paths and ids made neutral): the transcript's
// events, the run's summary, its usage as the CLI reported it, and a run the
// CLI says failed.
import ".." as node;

/// `lines` (one a line) read by `reader`: the events, one a line.
@unbounded
fn read(r: node::HarnessReader, lines: String) -> String {
    let mut out = "";
    let mut rest = lines;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let l = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        out = out + r.feed(l);
    }
    return out;
}

fn has(events: String, kind: String, text: String) -> Bool {
    return std::str::contains(events, "{\"kind\": \"" + kind + "\", \"text\": \"" + text);
}

const CLAUDE: String = "{\"type\":\"system\",\"subtype\":\"init\",\"cwd\":\"/work\",\"model\":\"claude-test-1\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-test-1\",\"content\":[{\"type\":\"text\",\"text\":\"I'll create the file.\"}]}}\n{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_1\",\"name\":\"Write\",\"input\":{\"file_path\":\"/work/hello.txt\",\"content\":\"hi\"}}]}}\n{\"type\":\"user\",\"message\":{\"content\":[{\"tool_use_id\":\"toolu_1\",\"type\":\"tool_result\",\"content\":\"File created\"}]}}\n{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"allowed\"}}\n{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"Created hello.txt and committed it.\"}]}}\n{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"Created hello.txt and committed it.\",\"stop_reason\":\"end_turn\",\"usage\":{\"input_tokens\":17,\"cache_creation_input_tokens\":100,\"cache_read_input_tokens\":1000,\"output_tokens\":40}}\n";

const CODEX: String = "{\"type\":\"thread.started\",\"thread_id\":\"t-1\"}\n{\"type\":\"turn.started\"}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_0\",\"type\":\"agent_message\",\"text\":\"I'll create hello.txt.\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_1\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'ls'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_1\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'ls'\",\"aggregated_output\":\"README.md\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_2\",\"type\":\"file_change\",\"changes\":[{\"path\":\"/work/hello.txt\",\"kind\":\"add\"}],\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_3\",\"type\":\"agent_message\",\"text\":\"Created hello.txt.\"}}\n{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":4000,\"cached_input_tokens\":3000,\"output_tokens\":100,\"reasoning_output_tokens\":0}}\n";

const AGY: String = "{\"event\":\"init\",\"conversation_id\":\"c-1\",\"init\":{\"cwd\":\"/work\"}}\n{\"event\":\"step_update\",\"step_update\":{\"step_index\":1,\"state\":\"DONE\",\"step_type\":\"agent_response\",\"usage\":{\"input_tokens\":9000,\"output_tokens\":160}}}\n{\"event\":\"step_update\",\"step_update\":{\"step_index\":2,\"state\":\"ACTIVE\",\"step_type\":\"tool\",\"tool_name\":\"write_file\",\"tool_info\":{\"name\":\"write_file\",\"parameters\":{\"Path\":\"/work/hello.txt\"}}}}\n{\"event\":\"step_update\",\"step_update\":{\"step_index\":2,\"state\":\"DONE\",\"step_type\":\"tool\",\"tool_name\":\"write_file\"}}\n{\"event\":\"step_update\",\"step_update\":{\"step_index\":3,\"state\":\"ACTIVE\",\"step_type\":\"agent_response\",\"text_delta\":\"Created \"}}\n{\"event\":\"step_update\",\"step_update\":{\"step_index\":3,\"state\":\"ACTIVE\",\"step_type\":\"agent_response\",\"text_delta\":\"hello.txt.\"}}\n{\"event\":\"step_update\",\"step_update\":{\"step_index\":3,\"state\":\"DONE\",\"step_type\":\"agent_response\",\"text_delta\":\"\\n\"}}\n{\"event\":\"result\",\"result\":{\"conversation_id\":\"c-1\",\"status\":\"SUCCESS\",\"response\":\"Created hello.txt.\\n\",\"num_turns\":1,\"usage\":{\"input_tokens\":20000,\"output_tokens\":1200,\"thinking_tokens\":900,\"cache_read_tokens\":30000,\"total_tokens\":21200}}}\n";

const VIBE: String = "{\"id\":\"user-turn-1\",\"type\":\"message\",\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Create hello.txt\"}]}\n{\"id\":\"reasoning-1\",\"type\":\"reasoning\",\"text\":\"Simple task.\"}\n{\"id\":\"assistant-1\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"I'll create hello.txt.\"}]}\n{\"id\":\"effect-1\",\"type\":\"effect\",\"title\":\"file_system.write_file\",\"detail\":{\"toolName\":\"file_system.write_file\",\"display\":{\"summary\":\"Writing hello.txt\"}},\"state\":{\"status\":\"completed\"}}\n{\"id\":\"approval-1\",\"type\":\"callback\",\"title\":\"Approve file_system.bash\",\"detail\":{\"kind\":\"approval\"},\"state\":{\"status\":\"answered\",\"output\":{\"type\":\"approval\",\"decision\":{\"type\":\"deny\"}}}}\n{\"id\":\"assistant-2\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Created hello.txt, left uncommitted.\"}]}\n";

const VIBE_EXPORT: String = "{\"outcome\": \"finished\", \"stop_reason\": null, \"error\": null, \"usage\": {\"input_tokens\": 7565, \"output_tokens\": 14, \"cached_input_tokens\": 7488, \"total_tokens\": 7579}, \"steps\": 1}";

fn main() {
    // claude: text, tool use, the result's summary and usage (cache tokens
    // counted as input)
    let c = node::HarnessReader { reader: "claude-stream-json" };
    let ce = read(c, CLAUDE);
    std::test::assert(
        has(ce, "note", "claude started, model claude-test-1"),
        "claude's start: " + ce,
    );
    std::test::assert(has(ce, "text", "I'll create the file."), "claude's text");
    std::test::assert(has(ce, "tool", "Write {"), "claude's tool use");
    std::test::assert_eq_str(
        c.final_summary(),
        "Created hello.txt and committed it.",
        "claude's summary",
    );
    std::test::assert(c.has_usage, "claude reports usage");
    std::test::assert_eq_int(c.input_tokens, 1117, "claude's input, with its cache");
    std::test::assert_eq_int(c.output_tokens, 40, "claude's output");
    std::test::assert_eq_str(c.failure, "", "claude's run went");
    let cf = node::HarnessReader { reader: "claude-stream-json" };
    read(cf, "{\"type\":\"result\",\"is_error\":true,\"result\":\"Invalid API key\"}\n");
    std::test::assert(
        std::str::contains(cf.failure, "Invalid API key"),
        "claude's error: " + cf.failure,
    );

    // codex: messages, commands, file changes, and each turn's usage summed
    let x = node::HarnessReader { reader: "codex-jsonl" };
    let xe = read(
        x,
        CODEX
            + "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":1000,\"output_tokens\":10}}\n",
    );
    std::test::assert(has(xe, "tool", "$ /bin/bash -lc 'ls'"), "codex's command: " + xe);
    std::test::assert(has(xe, "tool", "edited /work/hello.txt"), "codex's file change");
    std::test::assert(!std::str::contains(xe, "exit 0"), "a command that passed says nothing more");
    std::test::assert_eq_str(
        x.final_summary(),
        "Created hello.txt.",
        "codex's summary: its last message",
    );
    std::test::assert_eq_int(x.input_tokens, 5000, "codex's input, its turns summed");
    std::test::assert_eq_int(x.output_tokens, 110, "codex's output");
    let xf = node::HarnessReader { reader: "codex-jsonl" };
    read(xf, "{\"type\":\"turn.failed\",\"error\":{\"message\":\"usage limit reached\"}}\n");
    std::test::assert(
        std::str::contains(xf.failure, "usage limit reached"),
        "codex's error: " + xf.failure,
    );

    // agy: tools, the response's text as one event, the result's usage
    let g = node::HarnessReader { reader: "agy-stream-json" };
    let ge = read(g, AGY);
    std::test::assert(has(ge, "tool", "write_file {"), "agy's tool: " + ge);
    std::test::assert(has(ge, "text", "Created hello.txt."), "agy's text, whole");
    std::test::assert_eq_str(g.final_summary(), "Created hello.txt.", "agy's summary");
    std::test::assert_eq_int(g.input_tokens, 50000, "agy's input, with its cache");
    std::test::assert_eq_int(g.output_tokens, 1200, "agy's output");
    let gf = node::HarnessReader { reader: "agy-stream-json" };
    read(gf, "{\"event\":\"result\",\"result\":{\"status\":\"ERROR\",\"response\":\"\"}}\n");
    std::test::assert_eq_str(gf.failure, "agy ended ERROR", "agy's error");

    // vibe: messages and effects; a refused call; its usage from its export
    let v = node::HarnessReader { reader: "vibe-streaming" };
    let ve = read(v, VIBE);
    std::test::assert(
        has(ve, "tool", "file_system.write_file: Writing hello.txt"),
        "vibe's effect: " + ve,
    );
    std::test::assert(
        has(ve, "tool", "refused by its policy: Approve file_system.bash"),
        "vibe's policy refusal",
    );
    std::test::assert(
        !has(ve, "text", "Create hello.txt"),
        "the user's turn is not the harness's text",
    );
    std::test::assert(!v.has_usage, "vibe's stream reports no usage");
    v.read_usage_file(VIBE_EXPORT);
    std::test::assert(v.has_usage, "its export does");
    std::test::assert_eq_int(v.input_tokens, 7565, "vibe's input");
    std::test::assert_eq_int(v.output_tokens, 14, "vibe's output");
    std::test::assert_eq_str(
        v.final_summary(),
        "Created hello.txt, left uncommitted.",
        "vibe's summary",
    );

    // text: any CLI, line by line, its last line the summary, no usage
    let t = node::HarnessReader { reader: "text" };
    let te = read(t, "working\n\nAdded FAKE.md\n");
    std::test::assert(has(te, "text", "working"), "a line is an event");
    std::test::assert_eq_str(t.final_summary(), "Added FAKE.md", "the last line");
    std::test::assert(!t.has_usage, "nothing invented");
}
