// A node whose GPU has memory of its own: the room a model served on it
// has is that GPU's, not the machine's. The case of lin1, an AMD Radeon
// RX 9070 (17.1 GB of its own, listed as `rocm` and as `vulkan`) in a
// machine of 32.7 GB that also hosts the habitat, so it offers models
// 28.5 GB. granite-4.0-h-tiny's Q8_0 held 12.1 GB of it, and a decision
// model's f16, 7 GB with its server, was judged to fit the 28.5 GB beside
// it: on the card it did not, and its server's context init failed.
// Now a runtime on the card has the card's memory, less what the node's
// other placements hold; one on the processors has the machine's, and a
// GPU that shares the machine's memory (a GB10's) the machine's too.
// Placement, the node's suggestions and the arranger judge it alike.
import ".." as api;
import "../../store" as st;

fn shipped(dir: String) -> String {
    return if std::io::fs::file_exists(dir) { dir } else { "../" + dir };
}

/// lin1's hardware, as its node reports it.
const LIN1: String = "{\"os\": \"linux\", \"arch\": \"x86_64\", \"memory_bytes\": 32700000000, \"model_memory_bytes\": 28500000000, \"accelerators\": [{\"kind\": \"rocm\", \"name\": \"AMD Radeon RX 9070\", \"memory_bytes\": 17100000000, \"unified\": false}, {\"kind\": \"vulkan\", \"name\": \"AMD Radeon RX 9070\", \"memory_bytes\": 17100000000, \"unified\": false}], \"disk_free_bytes\": 500000000000}";

/// A DGX Spark's: its GB10 shares the machine's memory.
const SPARK: String = "{\"os\": \"linux\", \"arch\": \"arm64\", \"memory_bytes\": 130661072896, \"model_memory_bytes\": 122494755840, \"accelerators\": [{\"kind\": \"cuda\", \"name\": \"NVIDIA GB10\", \"memory_bytes\": 130661072896, \"unified\": true, \"compute_capability\": \"12.1\"}], \"disk_free_bytes\": 3500000000000}";

/// What granite-4.0-h-tiny's Q8_0 reserved on lin1.
const GRANITE_RESERVED: Int = 12100000000;

fn add_node(store: st::Store, id: String, hardware: String) {
    store.insert_node(
        st::NodeRow { id: id, name: id, max_in_flight: 4, created_at: api::now_seconds() },
        api::change("create", "nodes/" + id, "", "{}"),
    ) or discard;
    store.put_fleet(
        st::FleetRow {
            node: id,
            capabilities: "{\"max_in_flight\": 4, \"engines\": [{\"id\": \"managed\", \"kind\": \"managed\", \"config_schema\": {}}], \"hardware\": "
                + hardware + "}",
            present: true,
        },
    ) or discard;
    store.put_beat(id, api::now_seconds(), 0) or discard;
}

/// The runtimes of `all` named in `ids`.
fn only(all: api::RuntimeList, ids: String) -> api::RuntimeList {
    let mut out = api::RuntimeList { };
    for r in all.data {
        if std::str::contains(ids, "," + r.id + ",") { push(out.data, r) or discard; }
    }
    return out;
}

/// Variant `id` of a recipe's `variants`, alone, as a list.
fn variant(recipe: api::Recipe, id: String) -> String {
    return "[" + api::variant_body_of(recipe.variants.text, id) + "]";
}

fn main() {
    let store = st::MemoryStore { };
    let recipes = api::Recipes { store: store, shipped: api::shipped_recipes(shipped("recipes")) };
    let catalog = api::Catalog { store: store, recipes: recipes };
    let runtimes = api::Runtimes {
        store: store,
        shipped: api::shipped_runtimes(shipped("runtimes")),
    };
    let roles = api::roles_of(std::io::fs::read_file(shipped("catalog") + "/roles.json") or "");
    let placements = api::Placements {
        store: store,
        recipes: recipes,
        runtimes: runtimes,
        seats: api::Seats { store: store, link: api::NatsLink { } },
        picks: std::io::fs::read_file(shipped("catalog") + "/picks.json") or "",
        roles: roles.roles,
    };
    api::Accounts { store: store }.create(
        api::AccountCreate { id: "local", name: "Local" },
    ) or discard;
    let usable = runtimes.usable_in_gate() or api::RuntimeList { };
    let decider = recipes.get_in_gate("jev-style-2b-decision-v3") or api::Recipe { };
    std::test::assert_eq_str(decider.id, "jev-style-2b-decision-v3", "voice ships the decider");
    let f16 = variant(decider, "gguf-f16");

    // ---- the rule --------------------------------------------------------
    std::test::assert_eq_int(
        api::models_memory(LIN1, "rocm"),
        17100000000,
        "on lin1's card, ROCm has the card's memory",
    );
    std::test::assert_eq_int(
        api::models_memory(LIN1, "vulkan"),
        17100000000,
        "Vulkan the same card's",
    );
    std::test::assert_eq_int(
        api::models_memory(LIN1, "cpu"),
        28500000000,
        "the processors the machine's",
    );
    std::test::assert_eq_int(
        api::models_memory(SPARK, "cuda"),
        122494755840,
        "a GB10 shares the machine's: what it offers models",
    );
    std::test::assert_eq_int(
        api::models_memory(
            "{\"model_memory_bytes\": 10000000000, \"accelerators\": [{\"kind\": \"cuda\", \"memory_bytes\": 24000000000, \"unified\": false}]}",
            "cuda",
        ),
        10000000000,
        "a card bigger than what the machine offers models: the less of the two",
    );

    // ---- judged: lin1 with granite held ----------------------------------
    let held = api::footprint(GRANITE_RESERVED);
    let lin1 = api::judging_add(api::Judging { }, "lin1", LIN1, held);
    let on_gpu = api::judge_on(f16, lin1, usable, true);
    let refused = at(on_gpu.fit, 0) or api::VariantFit { };
    std::test::assert(
        on_gpu.best < 0 && refused.runtime == "decision-0.1.2-rocm",
        "the f16 on ROCm does not fit beside granite: " + refused.reason,
    );
    std::test::assert(
        std::str::contains(
            refused.reason,
            "needs 7.0 GB of 2.9 GB free of its GPU's 17.1 GB (14.2 GB held by its other placements)",
        ),
        "and says the GPU's numbers: " + refused.reason,
    );
    let on_cpu = api::judge_on(f16, lin1, only(usable, ",decision-0.1.2-cpu,"), true);
    let cpu = at(on_cpu.fit, 0) or api::VariantFit { };
    std::test::assert(
        on_cpu.best == 0 && cpu.runtime == "decision-0.1.2-cpu"
            && std::str::contains(cpu.reason, "7.0 GB of 14.3 GB free for models"),
        "on the processors it has the machine's memory: " + cpu.reason,
    );
    let spark = api::judging_add(api::Judging { }, "spark", SPARK, held);
    let unified = at(api::judge_on(f16, spark, usable, true).fit, 0) or api::VariantFit { };
    std::test::assert(
        unified.fits && std::str::contains(unified.reason, "7.0 GB of 108.2 GB free for models"),
        "a GB10 is judged on the machine's, as before: " + unified.reason,
    );
    // the prompt cache a placement reserves comes from the same room
    let tiny = recipes.get_in_gate("granite-4.0-h-tiny") or api::Recipe { };
    let fresh = api::judging_add(api::Judging { }, "lin1", LIN1, 0);
    let sized = api::fit_recipe(tiny, fresh, usable, false);
    std::test::assert(
        sized.runtime == "llama-server-b11913-rocm"
            && api::footprint(sized.reserved_bytes) <= 17100000000,
        "granite sized afresh on lin1 is held to the card: "
            + to_string(sized.reserved_bytes) + " on " + sized.runtime,
    );

    // ---- placed: lin1 refuses it, and says why ---------------------------
    add_node(store, "lin1", LIN1);
    catalog.create(
        api::CatalogModelCreate {
            id: "granite-4.0-h-tiny",
            has_recipe: true,
            recipe: "granite-4.0-h-tiny",
        },
    ) or discard;
    catalog.create(
        api::CatalogModelCreate {
            id: "jev-style-2b-decision-v3",
            has_recipe: true,
            recipe: "jev-style-2b-decision-v3",
        },
    ) or discard;
    let mut granite = api::Placement {
        id: "granite",
        model: "granite-4.0-h-tiny",
        account: "local",
        recipe: "granite-4.0-h-tiny",
        variant: "gguf-q8_0",
        runtime: "llama-server-b11913-rocm",
        leader: "lin1",
        seat: "lin1/granite",
        has_reserved_bytes: true,
        reserved_bytes: GRANITE_RESERVED,
        created_at: api::now_seconds()
    };
    push(granite.nodes, "lin1") or discard;
    let body = api::placement_json(granite);
    store.insert_placement(
        st::PlacementRow {
            id: "granite",
            model: "granite-4.0-h-tiny",
            body: body,
            created_at: granite.created_at,
        },
        api::change("create", "placements/granite", "", body),
    ) or discard;
    let mut c = api::PlacementCreate {
        id: "decide",
        model: "jev-style-2b-decision-v3",
        account: "local",
        has_variant: true,
        variant: "gguf-f16",
    };
    push(c.nodes, "lin1") or discard;
    let mut why = "";
    placements.create(c) or {
        why = api::ctl_message(err);
    };
    std::test::assert(
        std::str::starts_with(why, "variant gguf-f16 does not fit node lin1: ")
            && std::str::contains(why, "free of its GPU's 17.1 GB"),
        "placing it on lin1 is refused, saying the GPU's memory: " + why,
    );

    // ---- suggested: the node's suggestions agree --------------------------
    let suggested = placements.suggest(api::NodeRef { node: "lin1" }) or api::NodeSuggestions { };
    let mut decide = api::NodeSuggestion { };
    for s in suggested.data {
        if s.category == "decide" { decide = s; }
    }
    std::test::assert(
        !decide.has_recipe && std::str::contains(decide.reason, "free of its GPU's 17.1 GB"),
        "nothing to decide with is suggested for lin1, for the card's memory: " + decide.reason,
    );

    // ---- arranged: the arranger agrees ------------------------------------
    let mut w = api::ArrangementWants { };
    push(w.pins, api::ArrangementPin { model: "granite-4.0-h-tiny", count: 1 }) or discard;
    push(w.roles, api::ArrangementRoleWant { role: "decider", priority: 1 }) or discard;
    let plan = placements.plan_arrangement(w) or {
        std::test::assert(false, "planned: " + api::ctl_message(err));
        return;
    };
    let mut decider_added = false;
    for a in plan.add {
        if a.recipe == "jev-style-2b-decision-v3" { decider_added = true; }
    }
    let mut kept = false;
    for k in plan.keep {
        if k.placement == "granite" { kept = true; }
    }
    let mut unmet = "";
    for u in plan.unmet {
        unmet = unmet + u.reason + "\n";
    }
    std::test::assert(
        kept && !decider_added && std::str::contains(unmet, "free of its GPU's 17.1 GB"),
        "the arranger keeps granite and finds no room for the decider on the card: "
            + api::plan_text(plan),
    );
}
