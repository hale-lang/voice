// A seat's refusal for a request's length is told from its other failures,
// as llama-server, vLLM and an OpenAI upstream each word it, so the caller
// gets 400 context_length_exceeded and compacts rather than retries.
import ".." as api;

fn main() {
    std::test::assert(
        api::context_overflow(
            "failed (engine_failed): upstream 400: request (33482 tokens) exceeds the available context size (32768 tokens), try increasing it",
        ),
        "llama-server's",
    );
    std::test::assert(
        api::context_overflow(
            "upstream 400: This model's maximum context length is 32768 tokens. However, you requested 33482 tokens",
        ),
        "vLLM's",
    );
    std::test::assert(
        api::context_overflow("upstream 400: {\"error\": {\"code\": \"context_length_exceeded\"}}"),
        "OpenAI's",
    );
    std::test::assert(
        !api::context_overflow("failed (engine_failed): upstream 500: out of memory"),
        "not another failure",
    );
    std::test::assert(!api::context_overflow("refused: seat s is down"), "nor a refusal");
    let e = api::too_long("n/s: failed", api::ErrorVoice { });
    std::test::assert(
        e.status == 400
            && e.code == api::ErrorCode::context_length_exceeded
            && e.kind == "invalid_request_error",
        "a client's error, 400 context_length_exceeded",
    );
}
