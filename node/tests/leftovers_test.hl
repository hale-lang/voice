// What coding attempts left on a node from before is removed as it starts
// (leftovers.hl): its `attempts` and `clis` directories, and nothing else
// of its data; a node where they never ran is left as it is.
import ".." as node;

fn main() {
    let data = "/tmp/voice-leftovers-test-" + to_string(std::time::monotonic_ns());
    node::run_out(
        "mkdir\n-p\n" + data + "/attempts/att_0000stray/work\n" + data + "/clis/pi/1.5.2\n" + data
            + "/blobs",
    );
    std::io::fs::write_file(data + "/capabilities.json", "{\"engines\": []}") or discard;

    node::remove_attempt_leftovers("leftovers-test", data);
    std::test::assert(
        !std::io::fs::file_exists(data + "/attempts") && !std::io::fs::file_exists(data + "/clis"),
        "the attempts' directories are gone",
    );
    std::test::assert(
        std::io::fs::file_exists(data + "/blobs")
            && std::io::fs::file_exists(data + "/capabilities.json"),
        "and the rest of the node's data is kept",
    );

    // again, with nothing left: nothing changes
    node::remove_attempt_leftovers("leftovers-test", data);
    std::test::assert(
        std::io::fs::file_exists(data + "/blobs") && !std::io::fs::file_exists(data + "/attempts"),
        "a node with nothing left keeps what it has",
    );
    node::run_out("rm\n-rf\n" + data);
}
