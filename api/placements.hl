// Placements: a local model put on nodes, by the operator. The coordinator
// picks the form of its weights (a variant of the model's recipe) and the
// runtime that serves it (runtimes.hl): a runtime that reads the variant's
// format on the nodes' platform and accelerator, a variant that fits them
// as they declared their hardware (protocol.yaml `Hardware`). It keeps
// why, for every variant. A placement
// creates the seat that serves it on its leader, on the leader's managed
// engine, its config the chosen variant and runtime, pinned
// (protocol.yaml `ManagedConfig`); the node fetches and verifies them.
//
// One node today, the leader, which holds the seat; the fit is judged on
// the set, so a model split across nodes changes the judging, not the
// shape.

type PlacementRef { placement: String; }

/// `PlacementCreate`. With no `variant` the coordinator picks.
type PlacementCreate {
    id: String;
    model: String;
    account: String = "";
    nodes: bounded[String; 1];
    has_variant: Bool = false;
    variant: String = "";
    has_runtime: Bool = false;
    runtime: String = "";
}

/// Who chose a placement's variant (`Placement.chosen_by`).
type PlacementChooser = enum { coordinator, operator };

fn placement_chooser_name(v: PlacementChooser) -> String {
    return match v {
        PlacementChooser::coordinator -> "coordinator",
        PlacementChooser::operator -> "operator"
    };
}

/// `VariantFit`: one variant, judged against the nodes.
type VariantFit {
    variant: String = "";
    // the runtime that would serve it there, left out when none runs it
    has_runtime: Bool = false;
    runtime: String = "";
    fits: Bool = false;
    reason: String = "";
}

/// `Placement`.
type Placement {
    id: String = "";
    model: String = "";
    account: String = "";
    nodes: bounded[String; 1];
    recipe: String = "";
    variant: String = "";
    runtime: String = "";
    chosen_by: PlacementChooser = PlacementChooser::coordinator;
    leader: String = "";
    seat: String = "";
    fit: bounded[VariantFit; 8];
    // the prompt cache its seat keeps, in tokens, and what the placement
    // holds of its node's memory for models: its variant and that cache.
    // Left out of a placement made before voice sized them.
    has_cache_tokens: Bool = false;
    cache_tokens: Int = 0;
    has_reserved_bytes: Bool = false;
    reserved_bytes: Int = 0;
    created_at: Time = `1970-01-01T00:00:00Z`;
}

type PlacementList { data: bounded[Placement; 256]; }

locus Placements {
    params {
        store: st::Store;
        // serializes the store's use across requests (store/lock.hl): the admin plane takes turns, a row at a time
        gate: st::Lock = st::Lock { };
        // the recipes a model's weights come from (recipes.hl), and the
        // runtimes that serve them (runtimes.hl), behind the same gate
        recipes: Recipes = Recipes { store: self.store, gate: self.gate };
        runtimes: Runtimes = Runtimes { store: self.store, gate: self.gate };
        // the seats a placement creates and removes (nodes.hl): the api's
        // own, which tell the node its assignment, behind the same gate
        seats: Seats;
        // voice's default picks (suggestions.hl): catalog/picks.json, read
        // at start, "" when none was found
        picks: String = "";
    }

    /// `suggestNodeModels`: for each category voice ships, the model it
    /// would place on node `r` (suggestions.hl).
    fn suggest(r: NodeRef) -> NodeSuggestions fallible(CtlError) {
        self.gate.enter();
        let gated = self.suggest_in_gate(r.node) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn suggest_in_gate(node: String) -> NodeSuggestions fallible(CtlError) {
        let n = self.store.node(node) or fail store_down(err);
        if !n.present || n.revoked { fail missing("no node " + node); }
        let mut out = NodeSuggestions { node: node };
        let cats = pick_categories(self.picks);
        let f = self.store.fleet(node) or fail store_down(err);
        let hw = std::str::trim(std::json::find_field_raw(f.capabilities, "hardware"));
        let declared = len(hw) > 0 && std::json::valid_object(hw);
        let os = if declared { std::json::find_string_field(hw, "os") } else { "" };
        let tier = if declared {
            node_tier(std::json::find_int_field(hw, "memory_bytes"))
        } else {
            0
        };
        if declared {
            out.has_os = true;
            out.os = os;
            if tier > 0 {
                out.has_tier_gb = true;
                out.tier_gb = tier;
            }
        }
        // what the node's placements hold of its memory for models, and
        // the recipe each serves there, `<recipe>\t<placement>` a line
        let existing = self.store.placements() or fail store_down(err);
        let mut held = 0;
        let mut serving = "\n";
        for p in existing.rows {
            if !p.removed && std::json::find_string_field(p.body, "leader") == node {
                held = held + (self.held_by(p) or raise);
                serving = serving + std::json::find_string_field(p.body, "recipe") + "\t" + p.id
                    + "\n";
            }
        }
        let room = if declared {
            std::json::find_int_field(hw, "model_memory_bytes") - held
        } else {
            0
        };
        let usable = self.runtimes.usable_in_gate() or raise;
        let mut rest = cats;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let cat = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let mut s = NodeSuggestion { category: cat };
            if !declared {
                s.reason = "node " + node
                    + " has declared no hardware, so nothing can be judged to fit it";
            } else {
                s = self.suggest_one(cat, os, tier, hw, usable, room, held, serving) or raise;
            }
            push(out.data, s) or discard;
        }
        return out;
    }

    /// Category `cat`'s suggestion for a machine of `os` at `tier`: the
    /// first of its picks, from that tier down, that is placed there
    /// already, or that the operator has and that fits what is left.
    fn suggest_one(
        cat: String,
        os: String,
        tier: Int,
        hw: String,
        usable: RuntimeList,
        room: Int,
        held: Int,
        serving: String
    ) -> NodeSuggestion fallible(CtlError) {
        let mut s = NodeSuggestion { category: cat };
        let picks = picks_down(self.picks, os, cat, tier);
        if len(picks) == 0 {
            s.reason = "voice suggests no " + cat + " model for a " + os + " machine of "
                + to_string(tier) + " GB yet";
            return s;
        }
        let mut why = "";
        let mut rest = picks;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            let tab = std::str::index_of(line, "\t");
            let t = std::str::parse_int(line[0..tab]) or 0;
            let id = line[(tab + 1)..len(line)];
            let at_serving = std::str::index_of(serving, "\n" + id + "\t");
            if at_serving >= 0 {
                let from = at_serving + len(id) + 2;
                let after = serving[from..len(serving)];
                s.has_recipe = true;
                s.recipe = id;
                s.has_tier_gb = true;
                s.tier_gb = t;
                s.has_placed = true;
                s.placed = after[0..std::str::index_of(after, "\n")];
                s.reason = "placed here as " + s.placed;
                return s;
            }
            let recipe = self.recipes.get_in_gate(id) or Recipe { };
            if len(recipe.id) == 0 {
                if len(why) == 0 {
                    why = "recipe " + id + " is not one voice ships or the operator allows";
                }
                continue;
            }
            let judged = judge_recipe(recipe.variants.text, hw, usable, room, held);
            if judged.best < 0 {
                why = id + ": " + reasons(judged.fit);
                continue;
            }
            let chosen = at(judged.fit, judged.best) or VariantFit { };
            s.has_recipe = true;
            s.recipe = id;
            s.has_variant = true;
            s.variant = chosen.variant;
            s.has_runtime = chosen.has_runtime;
            s.runtime = chosen.runtime;
            s.has_tier_gb = true;
            s.tier_gb = t;
            s.reason = chosen.reason;
            return s;
        }
        s.reason = "nothing voice suggests fits: " + why;
        return s;
    }

    /// What placement `r` holds of its node's memory for models: what it
    /// reserved, or, made before voice sized it, its variant's need.
    fn held_by(r: st::PlacementRow) -> Int fallible(CtlError) {
        let reserved = std::json::find_int_field(r.body, "reserved_bytes");
        if reserved > 0 { return reserved; }
        let recipe = self.recipes.get_in_gate(std::json::find_string_field(r.body, "recipe")) or {
            return 0;
        };
        let v = variant_body_of(
            recipe.variants.text,
            std::json::find_string_field(r.body, "variant"),
        );
        return std::json::find_int_field(v, "memory_bytes");
    }

    /// `listPlacements`: those not withdrawn.
    fn list() -> PlacementList fallible(CtlError) {
        self.gate.enter();
        let gated = self.list_in_gate() or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn list_in_gate() -> PlacementList fallible(CtlError) {
        let rows = self.store.placements() or fail store_down(err);
        let mut out = PlacementList { };
        for r in rows.rows {
            if !r.removed {
                let v = placement_of(r) or raise;
                push(out.data, v) or discard;
            }
        }
        return out;
    }

    /// `createPlacement`.
    fn create(c: PlacementCreate) -> Placement fallible(CtlError) {
        self.gate.enter();
        let gated = self.create_in_gate(c) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn create_in_gate(c: PlacementCreate) -> Placement fallible(CtlError) {
        if !is_slug(c.id) {
            fail bad(
                "`id` is lowercase letters, digits and dashes, starting with a letter or digit, at most 63",
                "id"
            );
        }
        if count(c.nodes) != 1 { fail bad("`nodes` names one node, its leader", "nodes"); }
        let m = self.store.model(c.model) or fail store_down(err);
        if !m.present || m.removed { fail bad("no model " + c.model + " in the catalog", "model"); }
        if len(m.recipe) == 0 {
            fail bad(
                "model " + c.model + " names no recipe, so there are no weights to place",
                "model"
            );
        }
        let recipe = self.recipes.get_in_gate(m.recipe) or raise;
        let leader = at(c.nodes, 0) or "";
        let n = self.store.node(leader) or fail store_down(err);
        if !n.present || n.revoked { fail bad("no node " + leader, "nodes"); }
        let f = self.store.fleet(leader) or fail store_down(err);
        let managed = managed_engine(f.capabilities);
        if len(managed) == 0 {
            fail bad(
                "node " + leader + " offers no managed engine, so no model can be placed on it",
                "nodes"
            );
        }
        if len(c.account) == 0 {
            fail bad("`account` names the account the seat spends", "account");
        }
        let hw = std::str::trim(std::json::find_field_raw(f.capabilities, "hardware"));
        if len(hw) == 0 || !std::json::valid_object(hw) {
            fail bad(
                "node " + leader + " has declared no hardware, so nothing can be judged to fit it",
                "nodes"
            );
        }
        let existing = self.store.placements() or fail store_down(err);
        // what the node's other placements hold of its memory for models
        let mut held = 0;
        for r in existing.rows {
            if !r.removed && std::json::find_string_field(r.body, "leader") == leader {
                if r.model == c.model {
                    fail clash("model " + c.model + " is placed on node " + leader + " by " + r.id);
                }
                held = held + (self.held_by(r) or raise);
            }
        }
        let room = std::json::find_int_field(hw, "model_memory_bytes") - held;

        let mut out = Placement {
            id: c.id,
            model: c.model,
            account: c.account,
            recipe: m.recipe,
            leader: leader,
            created_at: now_seconds()
        };
        push(out.nodes, leader) or discard;
        let all = self.runtimes.usable_in_gate() or raise;
        let mut usable = RuntimeList { };
        for r in all.data {
            if !c.has_runtime || r.id == c.runtime { push(usable.data, r) or discard; }
        }
        if c.has_runtime && count(usable.data) == 0 {
            fail bad(
                "no runtime " + c.runtime + ": voice ships none, nor has the operator allowed one",
                "runtime"
            );
        }
        let judged = judge_recipe(recipe.variants.text, hw, usable, room, held);
        out.fit = judged.fit;
        let best = judged.best;
        let mut named = -1;
        let mut i = 0;
        for f in out.fit {
            if c.has_variant && f.variant == c.variant { named = i; }
            i = i + 1;
        }
        if c.has_variant {
            if named < 0 {
                fail bad("recipe " + m.recipe + " has no variant " + c.variant, "variant");
            }
            let chosen = at(out.fit, named) or VariantFit { };
            if !chosen.fits {
                fail bad(
                    "variant " + c.variant + " does not fit node " + leader + ": " + chosen.reason,
                    "variant"
                );
            }
            out.variant = c.variant;
            out.runtime = chosen.runtime;
            out.chosen_by = PlacementChooser::operator;
        } else {
            if best < 0 {
                fail bad(
                    "no variant of recipe " + m.recipe + " fits node " + leader + ": "
                        + reasons(out.fit),
                    "nodes",
                );
            }
            let chosen = at(out.fit, best) or VariantFit { };
            out.variant = chosen.variant;
            out.runtime = chosen.runtime;
            if c.has_runtime { out.chosen_by = PlacementChooser::operator; }
        }

        // its seat's prompt cache: room for CACHED conversations of the
        // model's context (at most CONVERSATION_MAX), from at most half the
        // room the variant leaves, never less than the context it was
        // fitted with
        let variant = variant_body_of(recipe.variants.text, out.variant);
        let need = std::json::find_int_field(variant, "memory_bytes");
        let pool = cache_pool(room - need, recipe.kv_bytes_per_token, recipe.context_length, need);
        out.has_cache_tokens = true;
        out.cache_tokens = pool;
        out.has_reserved_bytes = true;
        out.reserved_bytes = need
            + (pool - fitted_context(recipe.context_length)) * recipe.kv_bytes_per_token;

        // the seat first: its own checks (the account, the node's room)
        // refuse before anything is kept
        out.seat = leader + "/" + c.id;
        let mut seat = SeatCreate {
            node: leader,
            id: c.id,
            engine: managed,
            account: c.account,
            config: std::json::Value::parse(
                managed_config(
                    c.id,
                    c.model,
                    recipe.context_length,
                    out.cache_tokens,
                    out.reserved_bytes,
                    variant_body_of(recipe.variants.text, out.variant),
                    runtime_body_of(all, out.runtime),
                ),
            ) or fail bad("the placement's seat config is too large to keep", "model"),
        };
        push(seat.serves, st::SeatModel { model: c.model }) or discard;
        self.seats.create_read(seat) or raise;
        let body = placement_json(out);
        let added = self.store.insert_placement(
            st::PlacementRow { id: c.id, model: c.model, body: body, created_at: out.created_at },
            checked_change("create", "placements/" + c.id, "", body) or raise,
        ) or {
            self.seats.remove_read(SeatRef { node: leader, seat: c.id }) or discard;
            fail store_down(err);
        };
        if !added {
            self.seats.remove_read(SeatRef { node: leader, seat: c.id }) or discard;
            fail clash("placement " + c.id + " exists; a placement id is never reused");
        }
        // another api may have placed on the node since its placements were
        // read: what they hold now, this one counted, is read again, and
        // this one withdrawn if together they overfill it. Of two placed at
        // once, the one that reads last sees both.
        let now = self.store.placements() or fail store_down(err);
        let mut total = 0;
        for r in now.rows {
            if !r.removed && std::json::find_string_field(r.body, "leader") == leader {
                total = total + (self.held_by(r) or raise);
            }
        }
        let memory = std::json::find_int_field(hw, "model_memory_bytes");
        if total > memory {
            self.remove_in_gate(c.id) or discard;
            fail clash(
                "node " + leader + " filled while this was placed: its placements would hold "
                    + gb(total) + " of " + gb(memory) + " for models; place it again",
            );
        }
        return out;
    }

    /// `getPlacement`.
    fn get(r: PlacementRef) -> Placement fallible(CtlError) {
        self.gate.enter();
        let gated = self.get_in_gate(r.placement) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn get_in_gate(id: String) -> Placement fallible(CtlError) {
        let row = self.store.placement(id) or fail store_down(err);
        if !row.present || row.removed { fail missing("no placement " + id); }
        return placement_of(row) or raise;
    }

    /// `removePlacement`.
    fn remove(r: PlacementRef) -> Placement fallible(CtlError) {
        self.gate.enter();
        let gated = self.remove_in_gate(r.placement) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    fn remove_in_gate(id: String) -> Placement fallible(CtlError) {
        let v = self.get_in_gate(id) or raise;
        // only the seat it made: a placement from before placements made
        // seats records none, and a seat of that id is someone else's
        if v.seat == v.leader + "/" + v.id {
            self.seats.remove_read(SeatRef { node: v.leader, seat: v.id }) or discard;
        }
        self.store.remove_placement(
            st::PlacementRow { id: id, removed: true, removed_at: now_seconds() },
            checked_change("delete", "placements/" + id, placement_json(v), "") or raise,
        ) or fail store_down(err);
        return v;
    }
}

/// A row as the surface's `Placement`. The body is what `create` decided.
fn placement_of(r: st::PlacementRow) -> Placement fallible(CtlError) {
    let b = r.body;
    let mut out = Placement {
        id: r.id,
        model: r.model,
        account: std::json::find_string_field(b, "account"),
        recipe: std::json::find_string_field(b, "recipe"),
        variant: std::json::find_string_field(b, "variant"),
        runtime: std::json::find_string_field(b, "runtime"),
        chosen_by: if std::json::find_string_field(b, "chosen_by") == "operator" {
            PlacementChooser::operator
        } else {
            PlacementChooser::coordinator
        },
        leader: std::json::find_string_field(b, "leader"),
        seat: std::json::find_string_field(b, "seat"),
        has_cache_tokens: std::json::find_int_field(b, "cache_tokens") > 0,
        cache_tokens: std::json::find_int_field(b, "cache_tokens"),
        has_reserved_bytes: std::json::find_int_field(b, "reserved_bytes") > 0,
        reserved_bytes: std::json::find_int_field(b, "reserved_bytes"),
        created_at: r.created_at
    };
    let mut nodes = std::json::array_first(std::json::find_field_raw(b, "nodes"));
    while !nodes.done {
        push(
            out.nodes,
            std::json::string_field("{\"n\": " + nodes.element + "}", "n").text,
        ) or discard;
        nodes = std::json::array_next(nodes);
    }
    let mut it = std::json::array_first(std::json::find_field_raw(b, "fit"));
    while !it.done {
        push(
            out.fit,
            VariantFit {
                variant: std::json::find_string_field(it.element, "variant"),
                has_runtime: std::json::string_field(it.element, "runtime").kind == "string",
                runtime: std::json::find_string_field(it.element, "runtime"),
                fits: std::json::find_bool_field(it.element, "fits"),
                reason: std::json::find_string_field(it.element, "reason"),
            },
        ) or discard;
        it = std::json::array_next(it);
    }
    return out;
}

/// The change log's JSON for `p`, and the body kept: the `Placement` the api answers.
@bounded_by(p)
fn placement_json(p: Placement) -> String {
    let nodes = st::JsonList { };
    for n in p.nodes {
        nodes.add(jq(n));
    }
    let fits = st::JsonList { };
    for f in p.fit {
        fits.add(
            "{\"variant\": " + jq(f.variant) + ", \"runtime\": "
                + (if f.has_runtime { jq(f.runtime) } else { "null" }) + ", \"fits\": "
                + (if f.fits { "true" } else { "false" })
                + ", \"reason\": " + jq(f.reason) + "}",
        );
    }
    return "{\"id\": " + jq(p.id) + ", \"model\": " + jq(p.model) + ", \"account\": "
        + jq(p.account)
        + ", \"nodes\": [" + nodes.text()
        + "]"
        + ", \"recipe\": " + jq(p.recipe) + ", \"variant\": " + jq(p.variant) + ", \"runtime\": "
        + jq(p.runtime) + ", \"chosen_by\": "
        + jq(placement_chooser_name(p.chosen_by)) + ", \"leader\": " + jq(p.leader) + ", \"seat\": "
        + jq(p.seat) + ", \"fit\": ["
        + fits.text() + "]"
        + (if p.has_cache_tokens { ", \"cache_tokens\": " + to_string(p.cache_tokens) } else { "" })
        + (
            if p.has_reserved_bytes {
                ", \"reserved_bytes\": " + to_string(p.reserved_bytes)
            } else {
                ""
            }
        )
        + ", \"created_at\": " + jtime(p.created_at) + "}";
}

// ---- the prompt cache --------------------------------------------------

/// The context a recipe's `memory_bytes` provides for
/// (scripts/catalog-recipes.py, CONTEXT), for a model made for at least so
/// much.
const FITTED_CONTEXT: Int = 32768;

/// The context a variant's `memory_bytes` provides for: `FITTED_CONTEXT`,
/// or the model's own when it is made for less (catalog-recipes.py fits
/// `min(CONTEXT, max_position_embeddings)`).
fn fitted_context(native: Int) -> Int {
    return if native > 0 && native < FITTED_CONTEXT { native } else { FITTED_CONTEXT };
}

/// The conversations a seat's prompt cache holds at once, each returned to
/// what it said when it comes back (llama-server's slots).
const CACHED: Int = 4;

/// The most context a cached conversation is given room for.
const CONVERSATION_MAX: Int = 131072;

/// A seat's prompt cache, in tokens: room for `CACHED` conversations of the
/// model's context (`native`, at most `CONVERSATION_MAX`), from at most half
/// of `spare`, the memory its variant leaves, and never more than `need`,
/// the variant's own, past what that provides (a cache no larger than the
/// model it serves); never less than
/// the context the variant's memory provides (`fitted_context`). With no
/// per-token cost known, that.
fn cache_pool(spare: Int, per_token: Int, native: Int, need: Int) -> Int {
    let base = fitted_context(native);
    if per_token <= 0 || spare <= 0 { return base; }
    let conversation = if native > 0 && native < CONVERSATION_MAX {
        native
    } else {
        CONVERSATION_MAX
    };
    let want = CACHED * conversation;
    if want <= base { return base; }
    let budget = if spare / 2 < need { spare / 2 } else { need };
    let afford = base + budget / per_token;
    let pool = if afford < want { afford } else { want };
    // llama.cpp allocates its cache in steps of `CACHE_STEP`, rounding up:
    // a cache past its fitted context is rounded down to one, so what is
    // reserved is what it allocates
    let stepped = (pool / CACHE_STEP) * CACHE_STEP;
    return if stepped > base { stepped } else { base };
}

/// The step llama.cpp allocates a cache in (llama-context.cpp: n_ctx is
/// rounded up to a multiple of 256).
const CACHE_STEP: Int = 256;

// ---- the seat ---------------------------------------------------------

/// The id of the engine of kind `managed` a node's capabilities declare,
/// "" for none.
@bounded_by(capabilities)
fn managed_engine(capabilities: String) -> String {
    let mut it = std::json::array_first(std::json::find_field_raw(capabilities, "engines"));
    while !it.done {
        if std::json::find_string_field(it.element, "kind") == "managed" {
            return std::json::find_string_field(it.element, "id");
        }
        it = std::json::array_next(it);
    }
    return "";
}

/// The variant `id` of a recipe's `variants`, as JSON.
@bounded_by(variants)
fn variant_body_of(variants: String, id: String) -> String {
    let mut it = std::json::array_first(variants);
    while !it.done {
        if std::json::find_string_field(it.element, "id") == id {
            return std::str::trim(it.element);
        }
        it = std::json::array_next(it);
    }
    return "{}";
}

/// The runtime `id` among `rts`, as its `RuntimeCreate` JSON.
@bounded_by(rts)
fn runtime_body_of(rts: RuntimeList, id: String) -> String {
    for r in rts.data {
        if r.id == id { return runtime_create_json(r, r.formats, r.platforms); }
    }
    return "{}";
}

/// A managed seat's config (protocol.yaml `ManagedConfig`).
fn managed_config(
    placement: String,
    model: String,
    context_length: Int,
    cache_tokens: Int,
    reserved_bytes: Int,
    variant: String,
    runtime: String
) -> String {
    // the most context the model is made for, which a server is not
    // started past (node/run.hl); left out when the recipe does not say
    return "{\"placement\": " + jq(placement) + ", \"model\": " + jq(model)
        + (
            if context_length > 0 {
                ", \"context_length\": " + to_string(context_length)
            } else {
                ""
            }
        )
    // the prompt cache its server keeps, in tokens, and the memory it
    // may take (node/run.hl)
        + ", \"cache_tokens\": " + to_string(cache_tokens) + ", \"reserved_bytes\": "
        + to_string(reserved_bytes)
        + ", \"variant\": "
        + variant
        + ", \"runtime\": " + runtime + "}";
}

// ---- the fit ----------------------------------------------------------

/// The runtime among `rts` that reads `format` on a machine, as its
/// hardware says: one for its platform, on one of its accelerators before
/// one on its processors; "" when none does.
@bounded_by(rts)
fn runtime_for(format: String, hw: String, rts: RuntimeList) -> String {
    let os = std::json::find_string_field(hw, "os");
    let arch = std::json::find_string_field(hw, "arch");
    let accel = accelerator_kinds(hw);
    let mut cpu = "";
    for r in rts.data {
        let mut reads = false;
        for f in r.formats {
            if model_format_name(f) == format { reads = true; }
        }
        let mut here = false;
        for p in r.platforms {
            if host_os_name(p.os) == os && host_arch_name(p.arch) == arch { here = true; }
        }
        if reads && here {
            let on = runtime_accelerator_name(r.accelerator);
            if on == "cpu" {
                if len(cpu) == 0 { cpu = r.id; }
            } else if std::str::contains(accel, "," + on + ",") {
                return r.id;
            }
        }
    }
    return cpu;
}

/// True when the runtime `id` runs on processors, not an accelerator.
fn runs_on_cpu(rts: RuntimeList, id: String) -> Bool {
    for r in rts.data {
        if r.id == id { return r.accelerator == RuntimeAccelerator::cpu; }
    }
    return false;
}

/// The accelerator the runtime `id` runs on, by name.
fn runtime_on(rts: RuntimeList, id: String) -> String {
    for r in rts.data {
        if r.id == id { return runtime_accelerator_name(r.accelerator); }
    }
    return "";
}

/// A format's place in the machine's preference, lower first: the form
/// made for the accelerator before the one that runs anywhere.
fn format_rank(format: String, hw: String) -> Int {
    let accel = accelerator_kinds(hw);
    if std::str::contains(accel, ",metal,") { return if format == "mlx" { 0 } else { 1 }; }
    if std::str::contains(accel, ",cuda,") { return if format == "safetensors" { 0 } else { 1 }; }
    return 0;
}

/// The kinds of the machine's accelerators, as `,cuda,metal,`.
@bounded_by(hw)
fn accelerator_kinds(hw: String) -> String {
    let out = std::bytes::BytesBuilder { initial_cap: 32 };
    out.append_str(",");
    let mut it = std::json::array_first(std::json::find_field_raw(hw, "accelerators"));
    while !it.done {
        out.append_str(std::json::find_string_field(it.element, "kind") + ",");
        it = std::json::array_next(it);
    }
    let b = out.snapshot() or b",";
    return std::str::from_bytes(b);
}

/// Every variant of a recipe judged against a machine (`judge_variant`),
/// and the one a placement takes when none is named: of those that fit, the
/// format the machine serves best (`format_rank`), off the CPU, then the
/// biggest, the most faithful weights it has room for; -1 when none fits.
type Judged { fit: bounded[VariantFit; 8]; best: Int = -1; }

@bounded_by(variants)
fn judge_recipe(variants: String, hw: String, rts: RuntimeList, room: Int, held: Int) -> Judged {
    let mut out = Judged { };
    let mut best_rank = 0;
    let mut best_memory = 0;
    let mut i = 0;
    let mut it = std::json::array_first(variants);
    while !it.done {
        let v = it.element;
        let judged = judge_variant(v, hw, rts, room, held);
        push(out.fit, judged) or discard;
        let rank = format_rank(std::json::find_string_field(v, "format"), hw)
            + (if judged.has_runtime && runs_on_cpu(rts, judged.runtime) { 10 } else { 0 });
        let memory = std::json::find_int_field(v, "memory_bytes");
        if judged.fits
            && (out.best < 0 || rank < best_rank || (rank == best_rank && memory > best_memory))
        {
            out.best = i;
            best_rank = rank;
            best_memory = memory;
        }
        i = i + 1;
        it = std::json::array_next(it);
    }
    return out;
}

/// One variant judged against a machine's hardware and the runtimes that
/// may serve it: a runtime reads its format there, it fits what models may
/// use of the memory, and its files fit the disk.
@bounded_by(v)
fn judge_variant(v: String, hw: String, rts: RuntimeList, room: Int, held: Int) -> VariantFit {
    let id = std::json::find_string_field(v, "id");
    let format = std::json::find_string_field(v, "format");
    let rt = runtime_for(format, hw, rts);
    if len(rt) == 0 {
        return VariantFit {
            variant: id,
            fits: false,
            reason: "no runtime reads " + format + " on " + std::json::find_string_field(hw, "os")
                + "/"
                + std::json::find_string_field(hw, "arch") + " with " + accelerators_said(hw),
        };
    }
    let runs = rt + " runs " + format + " on " + runtime_on(rts, rt);
    let need = std::json::find_int_field(v, "memory_bytes");
    let memory = gb(need) + " of " + gb(room) + " for models"
        + (if held > 0 { " (" + gb(held) + " held by its other placements)" } else { "" });
    if need > room {
        return VariantFit {
            variant: id,
            has_runtime: true,
            runtime: rt,
            fits: false,
            reason: runs + "; needs " + memory,
        };
    }
    let mut size = 0;
    let mut it = std::json::array_first(std::json::find_field_raw(v, "files"));
    while !it.done {
        size = size + std::json::find_int_field(it.element, "bytes");
        it = std::json::array_next(it);
    }
    let free = std::json::find_int_field(hw, "disk_free_bytes");
    let disk = gb(size) + " of " + gb(free) + " free";
    if size > free {
        return VariantFit {
            variant: id,
            has_runtime: true,
            runtime: rt,
            fits: false,
            reason: runs + "; " + memory + "; needs " + disk,
        };
    }
    return VariantFit {
        variant: id,
        has_runtime: true,
        runtime: rt,
        fits: true,
        reason: runs + "; " + memory + "; " + disk,
    };
}

/// A machine's accelerators, as a reason says them.
fn accelerators_said(hw: String) -> String {
    let kinds = accelerator_kinds(hw);
    if kinds == "," { return "no accelerator"; }
    return std::str::replace(kinds[1..(len(kinds) - 1)], ",", " and ");
}

/// Every variant's reason, for a refusal.
@bounded_by(fit)
fn reasons(fit: bounded[VariantFit; 8]) -> String {
    let out = st::JsonList { };
    for f in fit {
        out.add(f.variant + ": " + f.reason);
    }
    return std::str::replace(out.text(), ", ", "; ");
}

/// Bytes as gigabytes (10^9) to a tenth, terabytes past 1000 GB, or
/// megabytes under 1 GB.
fn gb(n: Int) -> String {
    if n < 1000000000 {
        let m = (n + 50000) / 100000;
        return to_string(m / 10) + "." + to_string(m % 10) + " MB";
    }
    if n >= 1000000000000 {
        let t = (n + 50000000000) / 100000000000;
        return to_string(t / 10) + "." + to_string(t % 10) + " TB";
    }
    let t = (n + 50000000) / 100000000;
    return to_string(t / 10) + "." + to_string(t % 10) + " GB";
}
