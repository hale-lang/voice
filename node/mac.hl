// A Mac joins as a voice node, under launchd (docs/node-on-a-mac.md).
//
// `node install` finds the seats this Mac has, writes the capabilities file
// they need, records the node, its seats, a local account and a default
// project on the api as real rows, and installs a launchd user agent that
// runs the node; `node uninstall` removes the agent. The seats are
// whatever the machine offers: each model a local Ollama has, the claude
// CLI when it is on PATH and holds a login, and the static seat when
// neither is there. Every seat is free (a model with no price) and spends a
// local account that bills nothing; a default project holds a key whose
// secret is printed once.
//
// The pieces that need no Mac are functions of their inputs: discovery
// takes the PATH it looks on, the plist is a string, and the provisioning
// goes through `AdminCalls`, which the install binds to HTTP and a test to
// the api in process.

/// One seat this machine offers: the seat's id, the engine of the node's
/// capabilities it runs on, the model callers name, the engine's name for
/// it, and the seat's config as JSON.
type Offer {
    seat: String = "";
    engine: String = "";
    model: String = "";
    config: String = "{}";
}

/// At most 32 seats are offered, as many as an api's node may hold.
type Offers { items: bounded[Offer; 32]; }

/// What the machine has. `path` is the PATH looked on ("" = the process's
/// own); `claude_login` is whether the node holds the claude CLI's token
/// (the vault entry `claude_vault`), which is what the claude-cli engine runs under.
type Discovery {
    node: String = "";
    path: String = "";
    claude_login: Bool = false;
    claude_vault: String = "";
}

/// `argv` run with `path` as PATH when it is not "".
@unbounded
fn on_path(path: String, argv: String) -> std::process::ProcessOutput {
    let prefix = if len(path) > 0 { "env\nPATH=" + path + "\n" } else { "" };
    return std::process::run(prefix + argv) or std::process::ProcessOutput {
        code: 127,
        signal: 0,
        stdout: "",
        stderr: "",
    };
}

/// True when `program` is on `path`.
@unbounded
fn found(path: String, program: String) -> Bool {
    return on_path(path, "sh\n-c\ncommand -v \"$1\"\nsh\n" + program).code == 0;
}

/// The first word of a line.
@unbounded
fn first_word(line: String) -> String {
    let t = std::str::trim(line);
    let mut end = 0;
    let v = std::str::bytes_view(t);
    while end < v.n && std::str::byte_at(v, end) != 32 && std::str::byte_at(v, end) != 9 {
        end = end + 1;
    }
    return t[0..end];
}

/// The model names `ollama list` prints: its table's first column, after
/// the header line.
@unbounded
fn ollama_models(listing: String) -> Names32 {
    let mut out = Names32 { };
    let mut rest = listing;
    let mut header = true;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if header {
            header = false;
            continue;
        }
        let name = first_word(line);
        if len(name) > 0 { push(out.items, name) or discard; }
    }
    return out;
}

type Names32 { items: bounded[String; 32]; }

/// A seat id from a model name: lowercase letters and digits, the rest
/// dashes.
@unbounded
fn slug(name: String) -> String {
    let t = std::str::lower(name);
    let v = std::str::bytes_view(t);
    let mut out = "";
    let mut i = 0;
    while i < v.n && len(out) < 48 {
        let b = std::str::byte_at(v, i);
        let ok = (b >= 97 && b <= 122) || (b >= 48 && b <= 57);
        out = out
            + (
                if ok {
                    t[i..(i + 1)]
                } else if len(out) > 0 && !std::str::ends_with(out, "-") {
                    "-"
                } else {
                    ""
                }
            );
        i = i + 1;
    }
    return out;
}

/// The seats this machine offers.
@unbounded
fn discover(d: Discovery) -> Offers {
    let mut out = Offers { };
    if found(d.path, "ollama") {
        let listed = on_path(d.path, "ollama\nlist");
        if listed.code == 0 {
            let models = ollama_models(listed.stdout).items;
            for m in models {
                push(
                    out.items,
                    Offer {
                        seat: "ollama-" + slug(m),
                        engine: "ollama",
                        model: m,
                        config: "{\"base_url\": \"http://127.0.0.1:11434/v1\", \"model\": "
                            + quote(m) + "}"
                    },
                ) or discard;
            }
        }
    }
    if found(d.path, "claude") && d.claude_login {
        push(
            out.items,
            Offer {
                seat: "claude",
                engine: "claude",
                model: "claude-" + d.node,
                config: "{\"token_vault\": " + quote(d.claude_vault) + "}"
            },
        ) or discard;
    }
    if count(out.items) == 0 {
        push(
            out.items,
            Offer {
                seat: "static",
                engine: "static",
                model: "static-" + d.node,
                config: "{\"text\": \"hello from " + std::json::escape_string(d.node) + "\"}"
            },
        ) or discard;
    }
    return out;
}

@unbounded
fn quote(s: String) -> String { return "\"" + std::json::escape_string(s) + "\""; }

/// The capabilities file for `offers`: one engine for each kind of seat
/// offered, and a cap of two requests in flight.
@unbounded
fn capabilities_for(offers: Offers) -> String {
    let items = offers.items;
    let mut engines = "";
    let mut seen = "\n";
    for o in items {
        if std::str::contains(seen, "\n" + o.engine + "\n") { continue; }
        seen = seen + o.engine + "\n";
        let kind = if o.engine == "ollama" {
            "openai-compatible"
        } else if o.engine == "claude" {
            "claude-cli"
        } else {
            "static"
        };
        engines = engines + (if len(engines) > 0 { ", " } else { "" }) + "{\"id\": "
            + quote(o.engine)
            + ", \"kind\": " + quote(kind) + "}";
    }
    return "{\"max_in_flight\": 2, \"engines\": [" + engines + "]}";
}

// ---- launchd -------------------------------------------------------------

/// How the agent runs the node.
type Agent {
    label: String = "";
    node_bin: String = "";
    id: String = "";
    api: String = "";
    token_vault: String = "";
    data: String = "";
    capabilities: String = "";
    port: Int = 8081;
    vault_dir: String = "";
    path: String = "";
    log: String = "";
}

fn plist_string(s: String) -> String {
    return "<string>" + xml(s) + "</string>";
}

@unbounded
fn xml(s: String) -> String {
    return std::str::replace(
        std::str::replace(std::str::replace(s, "&", "&amp;"), "<", "&lt;"),
        ">",
        "&gt;",
    );
}

/// The launchd user agent's plist: the node, its flags, the vault and PATH
/// it needs (PATH must reach `ollama` and `claude`), kept alive from the
/// login, its output in `log`.
@unbounded
fn launchd_plist(a: Agent) -> String {
    return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
        + "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
        + "<plist version=\"1.0\"><dict>\n  <key>Label</key>" + plist_string(a.label)
        + "\n  <key>ProgramArguments</key><array>\n    " + plist_string(a.node_bin)
        + "\n    <string>--id</string>" + plist_string(a.id)
        + "\n    <string>--api</string>" + plist_string(a.api)
        + "\n    <string>--token-vault</string>" + plist_string(a.token_vault)
        + "\n    <string>--data</string>" + plist_string(a.data)
        + "\n    <string>--capabilities</string>" + plist_string(a.capabilities)
        + "\n    <string>--port</string>" + plist_string(to_string(a.port))
        + "\n  </array>\n  <key>EnvironmentVariables</key><dict>\n    <key>HALE_VAULT_DIR</key>"
        + plist_string(a.vault_dir) + "\n    <key>PATH</key>" + plist_string(a.path)
        + "\n  </dict>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>StandardOutPath</key>"
        + plist_string(a.log) + "\n  <key>StandardErrorPath</key>" + plist_string(a.log)
        + "\n</dict></plist>\n";
}

// ---- the api's rows ------------------------------------------------------

type Reply { status: Int = 0; body: String = ""; }

/// The admin calls provisioning makes: the install binds it to HTTP, a
/// test to the api in process.
interface AdminCalls {
    fn send(method: String, path: String, body: String) -> Reply;
}

/// What provisioning did and what the operator must be told once.
type Provisioned {
    ok: Bool = false;
    why: String = "";
    // the node's enrollment token, "" when the node already held one
    token: String = "";
    // the default project's key, "" when a key was issued before
    key: String = "";
    project: String = "";
    account: String = "";
    lines: String = "";
}

fn made(r: Reply) -> Bool { return r.status == 201 || r.status == 409; }

/// Record the node, its local account, its models, its seats and the
/// default project and key on the api. Creating what is there is not an
/// error, so installing again changes nothing; a model has no price (it is
/// free) and the account bills nothing.
@unbounded
fn provision(admin: AdminCalls, node: String, offers: Offers, token_known: Bool) -> Provisioned {
    let mut out = Provisioned { account: "local-" + node, project: "local-" + node };
    let n = admin.send("POST", "/admin/v1/nodes", "{\"id\": " + quote(node) + "}");
    if !made(n) { return Provisioned { why: "the node was not recorded: " + n.body }; }
    if n.status == 201 {
        out.token = std::json::find_string_field(n.body, "enrollment_token");
    } else if !token_known {
        let t = admin.send("POST", "/admin/v1/nodes/" + node + "/token", "");
        if t.status != 200 {
            return Provisioned { why: "the node's token was not renewed: " + t.body };
        }
        out.token = std::json::find_string_field(t.body, "enrollment_token");
    }
    let a = admin.send(
        "POST",
        "/admin/v1/accounts",
        "{\"id\": " + quote(out.account) + ", \"name\": " + quote("Local (" + node + ")")
            + ", \"billing\": \"none\"}",
    );
    if !made(a) { return Provisioned { why: "the local account was not recorded: " + a.body }; }
    let items = offers.items;
    let mut models = "";
    for o in items {
        let m = admin.send(
            "POST",
            "/admin/v1/models",
            "{\"id\": " + quote(o.model) + ", \"price\": null}",
        );
        if !made(m) {
            return Provisioned { why: "model " + o.model + " was not recorded: " + m.body };
        }
        models = models + (if len(models) > 0 { ", " } else { "" }) + quote(o.model);
        let s = admin.send(
            "POST",
            "/admin/v1/nodes/" + node + "/seats",
            "{\"id\": " + quote(o.seat) + ", \"engine\": " + quote(o.engine) + ", \"account\": "
                + quote(out.account) + ", \"serves\": [{\"model\": " + quote(o.model)
                + ", \"as\": " + quote(o.model) + "}], \"concurrency\": 1, \"config\": " + o.config
                + "}",
        );
        if !made(s) {
            return Provisioned { why: "seat " + o.seat + " was not recorded: " + s.body };
        }
        out.lines = out.lines + "seat " + node + "/" + o.seat + " serves " + o.model + "\n";
    }
    let p = admin.send(
        "POST",
        "/admin/v1/projects",
        "{\"id\": " + quote(out.project) + ", \"name\": " + quote("Local (" + node + ")")
            + ", \"models\": [" + models + "], \"accounts\": [" + quote(out.account) + "]}",
    );
    if !made(p) { return Provisioned { why: "the default project was not recorded: " + p.body }; }
    if p.status == 201 {
        let k = admin.send(
            "POST",
            "/admin/v1/projects/" + out.project + "/keys",
            "{\"name\": " + quote(node) + "}",
        );
        if k.status != 201 { return Provisioned { why: "the key was not issued: " + k.body }; }
        out.key = std::json::find_string_field(k.body, "secret");
    }
    out.ok = true;
    return out;
}
