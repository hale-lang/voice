// Liveness and readiness, for supervisors and load balancers. No
// credential.

/// What `version` says: the api's own version, not the contract's.
const VERSION: String = "0.1.0";

locus Probes {
    params {
        store: st::Store;
        // serializes the store's use across requests (gate.hl)
        gate: st::Lock = st::Lock { };
    }

    /// `getLiveness`: the process serves HTTP at all.
    fn liveness() -> Health {
        return Health { status: HealthStatus::ok, version: VERSION };
    }

    /// `getReadiness`: the store answers. Having no seats up is not
    /// unreadiness.
    fn readiness() -> Health fallible(CtlError) {
        self.gate.enter();
        let gated = self.readiness_in_gate() or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `readiness`, inside the gate.
    fn readiness_in_gate() -> Health fallible(CtlError) {
        let state = if self.store.ready() { HealthStatus::ok } else { HealthStatus::unavailable };
        let mut h = Health { status: state, version: VERSION };
        push(h.checks, Check { name: "store", status: state }) or discard;
        if state != HealthStatus::ok { fail CtlError::NotReady(h); }
        return h;
    }
}
