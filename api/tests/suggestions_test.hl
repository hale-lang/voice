// A node's tier is the biggest it has the memory of, within a tenth; its
// picks run from that tier down, the biggest first, for its platform and
// the category only; the categories come in the picks' order.
import ".." as api;

const PICKS: String = "{\"categories\": [\"general\", \"coding\", \"decide\"], \"picks\": [{\"os\": \"linux\", \"tier_gb\": 64, \"category\": \"coding\", \"recipe\": \"small-coder\"}, {\"os\": \"linux\", \"tier_gb\": 128, \"category\": \"coding\", \"recipe\": \"big-coder\"}, {\"os\": \"darwin\", \"tier_gb\": 128, \"category\": \"coding\", \"recipe\": \"mac-coder\"}, {\"os\": \"linux\", \"tier_gb\": 128, \"category\": \"general\", \"recipe\": \"chat\"}]}";

fn main() {
    let gib = 1073741824;
    std::test::assert_eq_int(api::node_tier(128 * gib), 128, "128 GiB is the 128 tier");
    std::test::assert_eq_int(api::node_tier(122 * gib), 128, "a Spark's 122 GiB is too");
    std::test::assert_eq_int(api::node_tier(96 * gib), 64, "96 GiB is the 64 tier");
    std::test::assert_eq_int(api::node_tier(3 * gib), 0, "below the smallest, none");
    std::test::assert_eq_str(
        api::pick_categories(PICKS),
        "general\ncoding\ndecide\n",
        "the categories, in order",
    );
    std::test::assert_eq_str(
        api::picks_down(PICKS, "linux", "coding", 128),
        "128\tbig-coder\n64\tsmall-coder\n",
        "from the tier down, the biggest first",
    );
    std::test::assert_eq_str(
        api::picks_down(PICKS, "linux", "coding", 64),
        "64\tsmall-coder\n",
        "none above the node's tier",
    );
    std::test::assert_eq_str(
        api::picks_down(PICKS, "darwin", "coding", 256),
        "128\tmac-coder\n",
        "its platform's only",
    );
    std::test::assert_eq_str(
        api::picks_down(PICKS, "linux", "decide", 128),
        "",
        "a category with none",
    );
}
