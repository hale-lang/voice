// Peek: a project or key that peeks has each request it sends recorded
// whole, its standard request as it was served and its final response
// (reasoning and all), for the operator to read here. Off unless set on the
// project or the key (`peek`); kept seven days (store `PEEK_DAYS`). A
// recording's request and response are the JSON documents they were, as
// text: they may be far larger than a JSON value here holds.

/// `listPeeks`: a project's, a key's, a model's (the catalog model each
/// was routed as), all when none; a page's size, and the `next_cursor` it
/// follows.
type PeekAsk {
    project: String = "";
    key: String = "";
    model: String = "";
    limit: Int = -1;
    cursor: String = "";
}

/// A recorded request, listed: its bodies are read with `getPeek`.
type PeekSummary {
    request_id: String = "";
    project: String = "";
    key: String = "";
    model: String = "";
    created_at: Time = `1970-01-01T00:00:00Z`;
}

/// A page of recordings; `next_cursor` is `null` on the last.
type PeekList {
    data: bounded[PeekSummary; 200];
    has_next_cursor: Bool = false;
    next_cursor: String = "";
}

/// The most recordings a page lists: a recording's summary is about 200
/// bytes, so a page is about 40 KiB. It lists `PEEK_PAGE_DEFAULT` unasked.
const PEEK_PAGE_MAX: Int = 200;
const PEEK_PAGE_DEFAULT: Int = 50;

type PeekRef { request_id: String; }

/// `Peek`: a recorded request whole.
type Peek {
    request_id: String = "";
    project: String = "";
    key: String = "";
    model: String = "";
    created_at: Time = `1970-01-01T00:00:00Z`;
    // the standard request as it was served, and the final response, each
    // a JSON document as text
    input: String = "";
    output: String = "";
}

locus Peeks {
    params {
        store: st::Store;
        // serializes the store's use across requests (store/lock.hl): the admin plane takes turns, a row at a time
        gate: st::Lock = st::Lock { };
    }

    /// `listPeeks`: newest first, a page at a time.
    fn list(a: PeekAsk) -> PeekList fallible(CtlError) {
        let mut q = st::PeekQuery {
            project: a.project,
            key: a.key,
            model: a.model,
            cursor: a.cursor,
            limit: PEEK_PAGE_DEFAULT,
        };
        if a.limit != -1 {
            if a.limit < 1 || a.limit > PEEK_PAGE_MAX {
                fail bad("`limit` is 1 to " + to_string(PEEK_PAGE_MAX), "limit");
            }
            q.limit = a.limit;
        }
        self.gate.enter();
        let rows = self.store.peeks(q) or {
            self.gate.leave();
            fail store_down(err);
        };
        self.gate.leave();
        if !rows.cursor_known {
            fail bad(
                "`cursor` names no recording; pass a page's `next_cursor`",
                "cursor"
            );
        }
        let mut out = PeekList { };
        let mut last = "";
        for r in rows.rows {
            push(
                out.data,
                PeekSummary {
                    request_id: r.request_id,
                    project: r.project,
                    key: r.key,
                    model: r.model,
                    created_at: r.created_at,
                },
            ) or discard;
            last = r.request_id;
        }
        if rows.more {
            out.has_next_cursor = true;
            out.next_cursor = last;
        }
        return out;
    }

    /// `getPeek`.
    fn get(r: PeekRef) -> Peek fallible(CtlError) {
        self.gate.enter();
        let row = self.store.peek(r.request_id) or {
            self.gate.leave();
            fail store_down(err);
        };
        self.gate.leave();
        if !row.present {
            fail missing(
                "no recording of request " + r.request_id
                    + ": it was not peeked, or is past seven days"
            );
        }
        return Peek {
            request_id: row.request_id,
            project: row.project,
            key: row.key,
            model: row.model,
            created_at: row.created_at,
            input: row.input,
            output: row.output,
        };
    }
}
