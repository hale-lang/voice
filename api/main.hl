/// The voice api, stubbed. Every endpoint in ../spec/openapi.yaml answers its
/// happy path with a canned body from `canned/`, named by the endpoint's
/// operationId. Each route is replaced by its real handler as the MVP is
/// built; see endpoints.hl.
locus Api {
    params {
        host: String = "127.0.0.1";
        port: Int = 8080;
        canned: String = "canned";
        nats: String = "nats://127.0.0.1:4222";
        ui: String = "";
        limits: Limits = Limits { };
    }
    run() { serve(self.host, self.port, self.canned, self.nats, self.ui, self.limits); }
}

fn serve(host: String, port: Int, canned: String, nats: String, ui: String, limits: Limits) {
    println("voice api (stub) on http://", host, ":", port, ", canned bodies from ", canned);
    println("voice api: request topics on ", nats, " (stub; not connected)");
    if len(ui) > 0 { println("voice api: serving the admin ui from ", ui); }
    if len(limits.head) > 0 { println("voice api: rate limits as ", limits.head, " says the organization ratified them, read as ", limits.client, " every ", limits.every, "s"); }
    let endpoints = Endpoints { canned: canned, ui: ui, limits: limits };
    std::http::Server { host: host, port: port, handler: endpoints };
}

/// `api [--host H] [--port N] [--canned DIR] [--nats URL] [--ui DIR]
/// [--head URL --issuer URL --client ID [--keys FILE] [--limits-every S]]`.
/// The canned directory defaults to `canned` beside the binary; with no
/// `--ui` the app is not served. With `--head`, the rate limits are the
/// ones the organization ratified, read through its head as the service
/// `--client` (its secret in VOICE_SERVICE_SECRET); `--keys` names each
/// project key's project, `<key>=<project>` per line.
fn main() {
    let mut host = "127.0.0.1";
    let mut port = 8080;
    let mut canned = beside_binary("canned");
    let mut nats = "nats://127.0.0.1:4222";
    let mut ui = "";
    let mut head = "";
    let mut issuer = "";
    let mut client = "";
    let mut keys = "";
    let mut every = 30;
    let mut i = 1;
    while i + 1 < std::env::args_count() {
        let flag = std::env::arg(i);
        let value = std::env::arg(i + 1);
        if flag == "--host" {
            host = value;
        } else if flag == "--port" {
            port = std::str::parse_int(value) or port;
        } else if flag == "--canned" {
            canned = value;
        } else if flag == "--nats" {
            nats = value;
        } else if flag == "--ui" {
            ui = value;
        } else if flag == "--head" {
            head = value;
        } else if flag == "--issuer" {
            issuer = value;
        } else if flag == "--client" {
            client = value;
        } else if flag == "--keys" {
            keys = std::io::fs::read_file(value) or "";
        } else if flag == "--limits-every" {
            every = std::str::parse_int(value) or every;
        }
        i = i + 2;
    }
    // ratified limits, or none: a half-configured reader fails at start
    if len(head) > 0 {
        let missing = if len(issuer) == 0 { "--issuer" } else if len(client) == 0 { "--client" } else if len(std::env::var("VOICE_SERVICE_SECRET")) == 0 { "VOICE_SERVICE_SECRET" } else if len(keys) == 0 { "--keys (a readable file naming each key's project)" } else { "" };
        if len(missing) > 0 {
            eprintln("voice api: --head reads the ratified rate limits as a service, and needs ", missing);
            std::process::exit(2);
        }
    }
    Api { host: host, port: port, canned: canned, nats: nats, ui: ui, limits: Limits { head: head, issuer: issuer, client: client, keys: keys, every: every } };
}

/// `name` in the directory holding the running binary, or `name` as given
/// when the binary was started without a directory in its path.
fn beside_binary(name: String) -> String {
    let mut dir = "";
    let mut rest = std::env::arg(0);
    let mut at = std::str::index_of(rest, "/");
    while at >= 0 {
        dir = dir + rest[0..(at + 1)];
        rest = rest[(at + 1)..len(rest)];
        at = std::str::index_of(rest, "/");
    }
    return dir + name;
}
