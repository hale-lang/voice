// The `serve` message carries the standard request: a Responses body is
// kept as it came, and its members the coordinator keeps (`voice`,
// `stream`, `stream_options`, `background`) are left out only where the
// message is written, the rest byte for byte as the caller wrote it.
import ".." as api;
import "../../store" as st;

fn sent(raw: String) -> String {
    let r = api::read_inference(raw, "responses") or api::InferenceRequest { };
    let c = api::Candidate { seat: st::SeatRow { id: "static" } };
    let m = std::str::from_bytes(api::serve_message("resp_1", "voice.reply.resp_1.1", c, r));
    return std::str::trim(std::json::find_field_raw(m, "body"));
}

fn main() {
    let plain = "{\"model\": \"echo-1\",  \"input\": \"hi\"}";
    std::test::assert_eq_str(sent(plain), plain, "a body with none is sent as it came");
    std::test::assert_eq_str(
        sent(
            "{\"stream\": true, \"model\": \"echo-1\", \"voice\": {\"data_class\": \"internal\"}, \"input\":  \"hi\", \"stream_options\": {}, \"background\": false}"
        ),
        "{\"model\": \"echo-1\", \"input\":  \"hi\"}",
        "a body with them is sent without them",
    );
    let r = api::read_inference(
        "{\"model\": \"echo-1\", \"stream\": true, \"input\": \"hi\"}",
        "responses",
    ) or api::InferenceRequest { };
    std::test::assert(r.stream, "the coordinator still reads `stream`");
    std::test::assert_eq_str(
        api::standard_body(r.body),
        "{\"model\": \"echo-1\", \"input\": \"hi\"}",
        "what records the request records it as it was served",
    );
    let m = std::str::from_bytes(
        api::serve_message(
            "resp_1",
            "voice.reply.resp_1.1",
            api::Candidate { seat: st::SeatRow { id: "static" } },
            r,
        ),
    );
    std::test::assert_eq_str(std::json::find_string_field(m, "request_id"), "resp_1", "its id");
    std::test::assert_eq_str(std::json::find_string_field(m, "seat"), "static", "its seat");
}
