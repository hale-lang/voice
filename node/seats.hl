/// This node's seats, one JSON file each under `dir`, named by seat id.
locus Seats {
    params {
        dir: String = "node-data/seats";
    }
    fn path(id: String) -> String { return self.dir + "/" + id + ".json"; }
    fn has(id: String) -> Bool { return is_slug(id) && std::io::fs::file_exists(self.path(id)); }
    fn read(id: String) -> String { return std::io::fs::read_file(self.path(id)) or ""; }
    fn write(id: String, seat: String) { std::io::fs::write_file(self.path(id), seat) or discard; }
    fn remove(id: String) { std::io::fs::unlink(self.path(id)) or discard; }
    fn count() -> Int { return std::io::fs::list_dir_count(self.dir) or 0; }
    /// The id of the i-th seat file, in directory order.
    fn id_at(i: Int) -> String {
        let name = std::io::fs::list_dir_at(self.dir, i) or "";
        if !std::str::ends_with(name, ".json") { return ""; }
        return name[0..(len(name) - 5)];
    }
}
