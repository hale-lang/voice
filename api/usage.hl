// The usage ledger: one row per inference request, written where the
// request ends (inference.hl: `settled` and `unfinished`), read back by
// the admin plane (`GET /admin/v1/usage`, `/usage/{request_id}`,
// `/usage/summary`) and followed by the event stream (admin_events.hl).
// A row is the `UsageRecord` of ../spec/openapi.yaml, kept whole in the
// store (`UsageRow.record`) beside the columns a read filters and sums by.

/// The row for a request of `r` that ended as `status`: `by` is what
/// served it, `input` and `output` the tokens its seat reported. A
/// request the caller named `metadata` on keeps it, untouched.
fn usage_row(
    r: InferenceRequest,
    request_id: String,
    project: String,
    key: String,
    by: ServedBy,
    status: String,
    input: Int,
    output: Int,
    price_micros: Int,
    currency: String,
    wall_ms: Int,
    attempts: bounded[Attempt; 8]
) -> st::UsageRow {
    let at = now_seconds();
    let meta = std::str::trim(std::json::find_field_raw(r.body, "metadata"));
    let metadata = if std::json::valid_object(meta) { meta } else { "{}" };
    let served = served_by_json(by);
    let record = "{\"id\": " + jq(request_id) + ", \"created_at\": " + jtime(at)
        + ", \"project\": " + jq(project) + ", \"key\": " + jq(key)
        + ", \"requested_model\": " + jq(r.model) + ", \"requested_account\": "
        + jstring_or_null(len(r.account) > 0, r.account) + ", \"endpoint\": "
        + jq(endpoint_name(r)) + ", \"status\": " + jq(status) + ", \"served\": " + served
        + ", \"data_class\": " + jq(r.data_class) + ", \"input_tokens\": " + to_string(input)
        + ", \"cached_input_tokens\": 0, \"cache_write_input_tokens\": 0, \"output_tokens\": "
        + to_string(output) + ", \"reasoning_tokens\": 0, \"price_micros\": "
        + to_string(price_micros) + ", \"currency\": " + jq(currency)
        + ", \"timing\": {\"wall_ms\": " + to_string(wall_ms)
        + ", \"queue_ms\": 0, \"load_ms\": 0}, \"attempts\": " + attempts_json(attempts)
        + ", \"metadata\": " + metadata + "}";
    return st::UsageRow {
        id: request_id,
        created_at: at,
        project: project,
        key: key,
        account: by.account,
        requested_model: r.model,
        served_model: by.model,
        node: by.node,
        seat: by.seat,
        status: status,
        input_tokens: input,
        output_tokens: output,
        price_micros: price_micros,
        currency: currency,
        served: served,
        record: record
    };
}

/// A request a seat served, as its row.
fn served_usage(r: InferenceRequest, s: Served) -> st::UsageRow {
    let v = s.voice;
    return usage_row(
        r,
        s.request_id,
        v.project,
        v.key,
        v.served,
        if s.status == "incomplete" { "incomplete" } else { "served" },
        s.input_tokens,
        s.output_tokens,
        v.price_micros,
        v.currency,
        v.wall_ms,
        v.attempts
    );
}

/// A request seat `c` began and did not finish, as its row: nothing is
/// charged, and the seat reported no tokens.
fn unfinished_row(
    r: InferenceRequest,
    request_id: String,
    k: st::KeyRow,
    m: st::ModelRow,
    c: Candidate,
    status: String,
    wall_ms: Int,
    attempts: bounded[Attempt; 8]
) -> st::UsageRow {
    return usage_row(
        r,
        request_id,
        k.project,
        k.id,
        ServedBy {
            model: if len(c.engine_name) > 0 { c.engine_name } else { m.id },
            node: c.seat.node,
            seat: c.seat.ref,
            account: c.seat.account,
            engine: c.seat.engine,
        },
        status,
        0,
        0,
        0,
        if m.priced { m.price.currency } else { "USD" },
        wall_ms,
        attempts
    );
}

// ---- the ledger, as rows ---------------------------------------------

/// How long a request took, in `UsageRecord.timing`.
type UsageTiming { wall_ms: Int = 0; queue_ms: Int = 0; load_ms: Int = 0; }

/// `UsageRecord`: one request, as the ledger holds it. A row is read from
/// the record the store keeps whole (`UsageRow.record`), which is this
/// shape as JSON; `metadata` is the caller's own object, untouched.
type UsageRecord {
    id: String = "";
    created_at: Time = `1970-01-01T00:00:00Z`;
    project: String = "";
    key: String = "";
    requested_model: String = "";
    has_requested_account: Bool = false;
    requested_account: String = "";
    endpoint: String = "responses";
    status: String = "served";
    has_served: Bool = false;
    served: ServedBy = ServedBy { };
    data_class: String = "";
    input_tokens: Int = 0;
    cached_input_tokens: Int = 0;
    cache_write_input_tokens: Int = 0;
    output_tokens: Int = 0;
    reasoning_tokens: Int = 0;
    price_micros: Int = 0;
    currency: String = "USD";
    timing: UsageTiming = UsageTiming { };
    attempts: bounded[Attempt; 8];
    metadata: std::json::Value = std::json::Value::null();
}

/// A page of the ledger, newest first; `next_cursor` is `null` on the last.
type UsageList {
    data: bounded[UsageRecord; 1000];
    has_next_cursor: Bool = false;
    next_cursor: String = "";
}

/// Which request: the `{request_id}` of the path.
type UsageRef { request_id: String; }

/// The filters `GET /admin/v1/usage` takes. The times are RFC 3339 text and
/// `metadata` one `name=value` pair, read when the handler runs so a bad
/// one is refused by name.
type UsageAsk {
    project: String = "";
    key: String = "";
    model: String = "";
    account: String = "";
    metadata: String = "";
    from: String = "";
    to: String = "";
    limit: Int = -1;
    cursor: String = "";
}

/// `GET /admin/v1/usage/summary`'s: the same filters, and the fields to group by.
type UsageSummaryAsk {
    group_by: String = "";
    project: String = "";
    key: String = "";
    model: String = "";
    account: String = "";
    metadata: String = "";
    from: String = "";
    to: String = "";
}

/// One group of a summary: `group` keys the `group_by` fields.
type UsageGroupOut {
    group: std::json::Value = std::json::Value::null();
    requests: Int = 0;
    input_tokens: Int = 0;
    output_tokens: Int = 0;
    price_micros: Int = 0;
    currency: String = "USD";
}

type UsageSummary {
    group_by: bounded[String; 32];
    has_from: Bool = false;
    from: Time = `1970-01-01T00:00:00Z`;
    has_to: Bool = false;
    to: Time = `1970-01-01T00:00:00Z`;
    data: bounded[UsageGroupOut; 1000];
}

/// The ledger, read.
locus Usage {
    params { store: st::Store; }

    /// `listUsage`: newest first.
    fn list(a: UsageAsk) -> UsageList fallible(CtlError) {
        let q = usage_query_of(a, true) or raise;
        let rows = self.store.usage_rows(q) or fail store_down(err);
        let mut out = UsageList { };
        let mut last = 0;
        for r in rows.rows {
            push(out.data, record_of(r.record, r.id) or raise) or discard;
            last = r.seq;
        }
        if rows.more {
            out.has_next_cursor = true;
            out.next_cursor = to_string(last);
        }
        return out;
    }

    /// `getUsage`.
    fn get(r: UsageRef) -> UsageRecord fallible(CtlError) {
        let row = self.store.usage(r.request_id) or fail store_down(err);
        if !row.present { fail missing("no usage record " + r.request_id); }
        return record_of(row.record, r.request_id) or raise;
    }

    /// `summarizeUsage`: totals over the matching rows, one per group.
    fn summary(a: UsageSummaryAsk) -> UsageSummary fallible(CtlError) {
        let by = group_by_of(a.group_by) or raise;
        let q = usage_query_of(
            UsageAsk {
                project: a.project,
                key: a.key,
                model: a.model,
                account: a.account,
                metadata: a.metadata,
                from: a.from,
                to: a.to,
            },
            false,
        ) or raise;
        let groups = self.store.usage_summary(
            st::UsageSummaryQuery { by: by, q: q },
        ) or fail store_down(err);
        let mut out = UsageSummary { has_from: q.has_from, from: q.from, has_to: q.has_to, to: q.to };
        out.group_by = by.items;
        for g in groups.rows {
            push(
                out.data,
                UsageGroupOut {
                    group: stored_value(g.group, "a usage group") or raise,
                    requests: g.requests,
                    input_tokens: g.input_tokens,
                    output_tokens: g.output_tokens,
                    price_micros: g.price_micros,
                    currency: g.currency,
                },
            ) or discard;
        }
        return out;
    }
}

/// A ledger row's record as the typed `UsageRecord`.
fn record_of(text: String, id: String) -> UsageRecord fallible(CtlError) {
    return UsageRecord::api_decode(text) or fail CtlError::Unavailable(
        Problem {
            code: ErrorCode::internal_error,
            message: "usage record " + id + " is stored JSON that is not a usage record (`"
                + err.field + "` is " + err.kind + ")",
        },
    );
}

// ---- the query ---------------------------------------------------------

/// The filters `GET /admin/v1/usage` and `/usage/summary` share.
fn usage_query_of(a: UsageAsk, paged: Bool) -> st::UsageQuery fallible(CtlError) {
    let mut q = st::UsageQuery {
        project: a.project,
        key: a.key,
        model: a.model,
        account: a.account,
    };
    if len(a.from) > 0 {
        q.has_from = true;
        q.from = rfc3339(a.from) or fail bad(
            "`from` is an RFC 3339 time, such as 2026-10-01T00:00:00Z",
            "from"
        );
    }
    if len(a.to) > 0 {
        q.has_to = true;
        q.to = rfc3339(a.to) or fail bad(
            "`to` is an RFC 3339 time, such as 2026-10-01T00:00:00Z",
            "to"
        );
    }
    if len(a.metadata) > 0 {
        if std::str::index_of(a.metadata, "=") < 1 {
            fail bad("`metadata` is written name=value", "metadata");
        }
        push(q.metadata.items, a.metadata) or discard;
    }
    if paged {
        if a.limit != -1 {
            if a.limit < 1 || a.limit > 1000 { fail bad("`limit` is 1 to 1000", "limit"); }
            q.limit = a.limit;
        }
        if len(a.cursor) > 0 {
            let n = std::str::parse_int(a.cursor) or 0;
            if !is_integer(a.cursor) || n < 1 {
                fail bad("`cursor` names no usage record; pass a page's `next_cursor`", "cursor");
            }
            q.cursor = n;
        }
    }
    return q;
}

/// `group_by`: the fields a summary groups by, comma separated.
fn group_by_of(raw: String) -> st::Names fallible(CtlError) {
    if len(raw) == 0 { fail bad("`group_by` is required", "group_by"); }
    let mut out = st::Names { };
    let mut rest = raw;
    while len(rest) > 0 {
        let comma = std::str::index_of(rest, ",");
        let f = if comma < 0 { rest } else { rest[0..comma] };
        rest = if comma < 0 { "" } else { rest[(comma + 1)..len(rest)] };
        if !st::valid_group(f) {
            fail bad(
                "`group_by` is any of project, key, model, account, seat, node, day, hour",
                "group_by"
            );
        }
        push(out.items, f) or fail bad("`group_by` names at most 32 fields", "group_by");
    }
    return out;
}

/// Every value `name` has in `path`'s query, in order, decoded: a repeated
/// parameter, which a route's parameters do not carry.
fn query_all(path: String, name: String) -> st::Names {
    let mut out = st::Names { };
    let qm = std::str::index_of(path, "?");
    let mut rest = if qm < 0 { "" } else { path[(qm + 1)..len(path)] };
    while len(rest) > 0 {
        let amp = std::str::index_of(rest, "&");
        let part = if amp < 0 { rest } else { rest[0..amp] };
        rest = if amp < 0 { "" } else { rest[(amp + 1)..len(rest)] };
        if std::str::starts_with(part, name + "=") {
            push(out.items, st::pct_decode(part[(len(name) + 1)..len(part)])) or discard;
        }
    }
    return out;
}
