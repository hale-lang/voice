// The managed engine's fetch: a managed seat's weights (its variant's
// files, from the hub at the variant's revision) and its runtime's archive,
// each into the data directory's content-addressed store, `blobs/<sha256>`,
// and kept only when its sha256 matches the pin (protocol.yaml
// `ManagedConfig`). A file already there is not fetched again; one cut off
// is resumed from where it stopped.
//
// It is a locus of its own, on its own thread, so a download of many
// gigabytes never keeps the session from answering on NATS. The session
// asks for a seat's fetch (`FetchWanted`) and hears how far it is
// (`FetchUpdated`). Where the hub is and the token it takes are the
// node's own, in its managed engine's `local` object in the capabilities
// file: `hub_url` (https://huggingface.co by default) and
// `hub_token_vault`, a vault entry the token is sent from on the wire and
// only to the hub's own origin (std::http drops it on a redirect to
// another). A container runtime's image is pulled here too, by its
// digest; once all of it is there, the runner starts the seat (run.hl).

/// One managed seat to fetch: its id and its config, as assigned.
type FetchJob { seat: String = ""; config: String = ""; }

topic FetchWanted { payload: FetchJob; }

/// How far a managed seat is: `fetching` with its bytes, `starting` while
/// its server loads, `up` with its endpoint, or `down` with why (a file
/// that did not verify, no room, a server that ended).
type FetchState {
    seat: String = "";
    status: String = "fetching";
    reason: String = "";
    done: Int = 0;
    total: Int = 0;
    // once its server answers (run.hl), its API's base on loopback
    endpoint: String = "";
    // and the context, in tokens, it took; 0 until it says
    context: Int = 0;
    // said by the runner, of the server it runs; else the fetcher's word
    // on what the seat is assigned
    by_runner: Bool = false;
}

topic FetchUpdated { payload: FetchState; }

/// The managed seats' fetches as the session holds them: a record, so it
/// is stored whole, its strings copied into the session's own storage.
type FetchStates { items: bounded[FetchState; 16]; }

/// The hub a variant's files come from unless the node names another.
const HUB_URL: String = "https://huggingface.co";

/// How often a fetch says how far it is: every this many bytes.
const REPORT_BYTES: Int = 67108864;

/// A file this large or larger is fetched in ranges, over the lanes: one
/// connection's speed from a CDN varies widely, and one slow connection
/// held for a whole file of gigabytes is never replaced.
const RANGED_BYTES: Int = 268435456;

/// The bytes of one range.
const RANGE_BYTES: Int = 67108864;

/// How long the lanes are measured over before they are compared.
const WINDOW_MS: Int = 10000;

/// A lane that wrote nothing in this long is stalled: dropped, its range
/// handed to another.
const STALL_MS: Int = 30000;

/// A lane that wrote less than this share of its peers' median over a
/// window is a straggler: dropped, its range handed to another.
const SLOWER: Int = 4;

/// A range that failed this many times in a row with nothing written
/// ends the fetch.
const TRIES: Int = 5;

/// What `in_ranges` says when the server does not honour `Range`: the
/// file is fetched whole instead.
const UNRANGED: String = "(unranged)";

/// A lane as the fetcher holds it: the range it was handed (`ticket` 0
/// while it has none), for which file (`job`), how far it has written
/// (`got`, and when it last moved, `since`), and the window's mark it is
/// measured from (`whole` once it was busy all of a window).
type LaneSlot {
    job: Int = 0;
    ticket: Int = 0;
    start: Int = 0;
    end: Int = 0;
    got: Int = 0;
    tries: Int = 0;
    since: Int = 0;
    mark: Int = 0;
    whole: Bool = false;
    // dropped, and waited on only once it may have written
    dropped: Bool = false;
    writing: Bool = false;
}

/// The lanes, by index: a record, so it is stored whole.
type LaneSlots { items: bounded[LaneSlot; 8]; }

/// A range to hand a lane: `found` when there is one.
type Piece {
    start: Int = 0;
    end: Int = 0;
    tries: Int = 0;
    found: Bool = false;
}

/// Why a managed seat's config cannot be fetched, "" when it can: a
/// placement, a variant with a source and files, a runtime with an
/// artifact. The coordinator checked every field when it was allowed.
fn managed_problem(config: String) -> String {
    if !std::json::valid_object(config) { return "config must be a JSON object"; }
    if len(std::json::find_string_field(config, "placement")) == 0 {
        return "config needs placement";
    }
    let v = std::json::find_field_raw(config, "variant");
    let src = std::json::find_field_raw(v, "source");
    if len(std::json::find_string_field(src, "repo")) == 0
        || len(std::json::find_string_field(src, "revision")) != 40
    {
        return "config.variant needs a source: a repo and a revision";
    }
    let mut it = std::json::array_first(std::json::find_field_raw(v, "files"));
    if it.done { return "config.variant lists no files"; }
    // every pin is checked before any of it names a path: a digest is the
    // file's name in the store, a path its name under the model
    while !it.done {
        let path = std::json::find_string_field(it.element, "path");
        if !hex(std::json::find_string_field(it.element, "sha256"), 64) {
            return "config.variant's file " + path + " needs a sha256 of 64 hex digits";
        }
        if std::json::find_int_field(it.element, "bytes") < 1 {
            return "config.variant's file " + path + " needs its size in bytes";
        }
        if !relative_path(path) {
            return "config.variant's file path " + path + " is not a relative path";
        }
        it = std::json::array_next(it);
    }
    let a = std::json::find_field_raw(std::json::find_field_raw(config, "runtime"), "artifact");
    let kind = std::json::find_string_field(a, "kind");
    if kind == "archive" {
        if !hex(std::json::find_string_field(a, "sha256"), 64)
            || std::json::find_int_field(a, "bytes") < 1
            || !std::str::starts_with(std::json::find_string_field(a, "url"), "https://")
        {
            return "config.runtime's archive needs an https url, a sha256 and its size";
        }
    } else if kind == "container" {
        let d = std::json::find_string_field(a, "digest");
        if len(std::json::find_string_field(a, "image")) == 0
            || !std::str::starts_with(d, "sha256:")
            || !hex(d[7..len(d)], 64)
        {
            return "config.runtime's container needs an image and a sha256 digest";
        }
    } else {
        return "config.runtime needs an artifact";
    }
    return "";
}

/// Exactly `n` lowercase hex digits.
@bounded_by(s)
fn hex(s: String, n: Int) -> Bool {
    if len(s) != n { return false; }
    let v = std::str::bytes_view(s);
    let mut i = 0;
    while i < n {
        let b = std::str::byte_at(v, i);
        if !((b >= 48 && b <= 57) || (b >= 97 && b <= 102)) { return false; }
        i = i + 1;
    }
    return true;
}

/// A path that stays where it is put: not empty, not absolute, no `..`.
fn relative_path(p: String) -> Bool {
    if len(p) == 0 || std::str::starts_with(p, "/") { return false; }
    return !(p == ".." || std::str::starts_with(p, "../") || std::str::ends_with(p, "/..")
            || std::str::contains(p, "/../"));
}

/// How long one read of a download waits before the fetch looks at a
/// stop again: the stream stays open across it.
const PUMP_WAIT_MS: Int = 1000;

locus Fetcher {
    params {
        data: String = "node-data";
        // the operator's capabilities file, whose managed engine's `local`
        // says where the hub is and which vault entry holds its token
        file: String = "";
        // seats to fetch, one a line: the seat's id, a tab, its config escaped
        queue: String = "";
        // the store the files go into, which fetches and verifies each
        blobs: Blobs = Blobs { data: self.data, file: self.file };
    }

    bus {
        subscribe FetchWanted as on_wanted;
        publish RunWanted;
    }

    run() {
        // a stop (SIGTERM, `systemctl stop`) drains the node: each loop
        // returns, then its locus's `drain()` and `dissolve()` run
        while !self.draining {
            self.step();
        }
    }

    /// One turn: the next seat's fetch, or a sleep, where asks arrive.
    @unbounded
    fn step() {
        if len(self.queue) == 0 {
            std::time::sleep(200ms);
            return;
        }
        let nl = std::str::index_of(self.queue, "\n");
        let line = self.queue[0..nl];
        self.queue = self.queue[(nl + 1)..len(self.queue)];
        let tab = std::str::index_of(line, "\t");
        self.fetch(line[0..tab], std::json::unescape_string(line[(tab + 1)..len(line)]));
    }

    /// A seat to fetch, queued once, with the config it was asked for last.
    @unbounded
    fn on_wanted(j: FetchJob) {
        // a seat waiting is fetched as it was asked for last
        self.queue = queue_without(self.queue, j.seat) + j.seat + "\t"
            + std::json::escape_string(j.config) + "\n";
    }

    /// Fetch every file a seat's config names that the store does not hold,
    /// and say how far, then why it is down: it is fetched and not yet run.
    @unbounded
    fn fetch(seat: String, config: String) {
        let blobs = self.data + "/blobs";
        if !std::io::fs::file_exists(blobs) { std::io::fs::mkdir(blobs) or discard; }
        let variant = std::json::find_field_raw(config, "variant");
        let src = std::json::find_field_raw(variant, "source");
        let base = hub_url(self.file) + "/" + std::json::find_string_field(src, "repo")
            + "/resolve/"
            + std::json::find_string_field(src, "revision") + "/";
        let artifact = std::json::find_field_raw(
            std::json::find_field_raw(config, "runtime"),
            "artifact",
        );
        let archive = std::json::find_string_field(artifact, "kind") == "archive";

        let mut total = 0;
        let mut done = 0;
        let mut it = std::json::array_first(std::json::find_field_raw(variant, "files"));
        while !it.done {
            let bytes = std::json::find_int_field(it.element, "bytes");
            total = total + bytes;
            if held(blobs, std::json::find_string_field(it.element, "sha256")) {
                done = done + bytes;
            }
            it = std::json::array_next(it);
        }
        if archive {
            let bytes = std::json::find_int_field(artifact, "bytes");
            total = total + bytes;
            if held(blobs, std::json::find_string_field(artifact, "sha256")) {
                done = done + bytes;
            }
        }
        // what parts on disk already hold counts as fetched; a part longer
        // than its pin is never the file, and goes
        let mut parts = 0;
        it = std::json::array_first(std::json::find_field_raw(variant, "files"));
        while !it.done {
            parts = parts
                + partial(
                    blobs,
                    std::json::find_string_field(it.element, "sha256"),
                    std::json::find_int_field(it.element, "bytes"),
                );
            it = std::json::array_next(it);
        }
        if archive {
            parts = parts
                + partial(
                    blobs,
                    std::json::find_string_field(artifact, "sha256"),
                    std::json::find_int_field(artifact, "bytes"),
                );
        }
        let free = df_available(run_out("df\n-Pk\n" + self.data));
        if total - done - parts > free {
            self.blobs.tell(
                seat,
                "down",
                "needs " + gib(total - done - parts) + " more, and " + gib(free) + " is free",
                done,
                total,
            );
            return;
        }
        self.blobs.tell(seat, "fetching", "", done, total);

        it = std::json::array_first(std::json::find_field_raw(variant, "files"));
        while !it.done {
            let f = it.element;
            let sha = std::json::find_string_field(f, "sha256");
            let bytes = std::json::find_int_field(f, "bytes");
            if !held(blobs, sha) {
                let problem = self.blobs.blob(
                    seat,
                    base + std::json::find_string_field(f, "path"),
                    std::json::find_string_field(f, "path"),
                    sha,
                    bytes,
                    true,
                    done,
                    total,
                );
                if len(problem) > 0 {
                    self.blobs.tell(seat, "down", problem, done, total);
                    return;
                }
                done = done + bytes;
            }
            it = std::json::array_next(it);
        }
        if archive && !held(blobs, std::json::find_string_field(artifact, "sha256")) {
            let bytes = std::json::find_int_field(artifact, "bytes");
            let problem = self.blobs.blob(
                seat,
                std::json::find_string_field(artifact, "url"),
                "the runtime's archive",
                std::json::find_string_field(artifact, "sha256"),
                bytes,
                false,
                done,
                total,
            );
            if len(problem) > 0 {
                self.blobs.tell(seat, "down", problem, done, total);
                return;
            }
            done = done + bytes;
        }
        if std::json::find_string_field(artifact, "kind") == "container" {
            let image = std::json::find_string_field(artifact, "image") + "@"
                + std::json::find_string_field(artifact, "digest");
            let pulled = std::process::run(
                "docker\npull\n" + image,
            ) or std::process::ProcessOutput {
                code: 127,
                signal: 0,
                stdout: "",
                stderr: "docker could not be run",
            };
            if pulled.code != 0 {
                self.blobs.tell(
                    seat,
                    "down",
                    "its runtime's image could not be pulled: " + std::str::trim(pulled.stderr),
                    done,
                    total,
                );
                return;
            }
        }
        self.blobs.tell(seat, "starting", "fetched and verified; starting its server", done, total);
        RunWanted <- RunJob { seat: seat, config: config };
    }

}

/// The data directory's store of fetched files, `blobs/<sha256>`: each one
/// fetched (resumed when a part of it is there) and kept only once its
/// size and its sha256 match its pin. No loop of its own: the fetcher's
/// thread calls it.
locus Blobs {
    params {
        data: String = "node-data";
        // the operator's capabilities file (`hub_token_vault`)
        file: String = "";
        // why the last chunk could not be read or written
        why: String = "";
        // what a file fetched in ranges takes: voice's own, smaller only
        // in its tests
        ranged: Int = RANGED_BYTES;
        piece: Int = RANGE_BYTES;
        lanes: Int = LANES;
        window_ms: Int = WINDOW_MS;
        stall_ms: Int = STALL_MS;
        report_ms: Int = 200;
        // the lanes, and the tickets handed them
        slots: LaneSlots = LaneSlots { };
        tickets: Int = 0;
        // the file being fetched in ranges: its job, where it comes from,
        // its part and sidecar, its size
        job: Int = 0;
        url: String = "";
        hub: Bool = false;
        vault: String = "";
        part: String = "";
        side: String = "";
        size: Int = 0;
        // its spans written and kept; ranges to hand again ("start end
        // tries ready" lines), the next byte not yet handed out
        spans: String = "";
        retry: String = "";
        at: Int = 0;
        // why it cannot be fetched, once that is known; the server does
        // not honour `Range`
        failure: String = "";
        unranged: Bool = false;
        // when the window ends, and the lanes dropped so far
        window_end: Int = 0;
        dropped: Int = 0;
    }

    bus {
        publish FetchUpdated;
        publish RangeWanted;
        publish RangeDropped;
        subscribe RangeHeard as on_heard;
    }

    /// One file into the store: fetched (resumed when a part of it is
    /// there), then kept as `blobs/<sha>` only when its size and its sha256
    /// match; "" when it is, else why not. A part that could still finish
    /// is kept; one that cannot be the file is removed.
    @unbounded
    fn blob(
        seat: String,
        url: String,
        name: String,
        sha: String,
        bytes: Int,
        hub: Bool,
        done: Int,
        total: Int
    ) -> String {
        let dest = self.data + "/blobs/" + sha;
        let part = dest + ".part";
        let side = dest + ".ranges";
        let mut fetched = if bytes >= self.ranged {
            self.in_ranges(seat, url, name, part, side, bytes, hub, done, total)
        } else {
            self.download(seat, url, name, part, side, bytes, hub, done, total)
        };
        if fetched == UNRANGED {
            // the server sends it whole: what the ranges wrote is not a
            // start of it, so it starts over
            std::io::fs::unlink(part) or discard;
            std::io::fs::unlink(side) or discard;
            fetched = self.download(seat, url, name, part, side, bytes, hub, done, total);
        }
        if len(fetched) > 0 { return fetched; }
        let size = std::io::fs::file_size(part) or 0;
        if size < bytes {
            return name + ": the download stopped at " + to_string(size) + " of " + to_string(bytes)
                + " bytes";
        }
        if size > bytes {
            std::io::fs::unlink(part) or discard;
            std::io::fs::unlink(side) or discard;
            return name + " is " + to_string(size) + " bytes, not the " + to_string(bytes)
                + " pinned: refused";
        }
        let digest = std::crypto::sha256_file(part) or {
            return name + " could not be read back to verify it: " + err.detail;
        };
        let got = std::hex::encode(digest);
        if got != sha {
            std::io::fs::unlink(part) or discard;
            std::io::fs::unlink(side) or discard;
            return name + "'s sha256 is " + got + ", not the " + sha + " pinned: refused";
        }
        std::io::fs::rename(part, dest) or { return name + " could not be kept: " + err.detail; };
        std::io::fs::unlink(side) or discard;
        return "";
    }

    /// The body at `url` written to `part`, from where `part` ends, over
    /// one connection; "" when it ended, else why not. Its reader and its
    /// file are its own, so both close when it returns.
    @unbounded
    fn download(
        seat: String,
        url: String,
        name: String,
        part: String,
        side: String,
        bytes: Int,
        hub: Bool,
        done: Int,
        total: Int
    ) -> String {
        if std::io::fs::file_exists(side) {
            // a part written in ranges is not a start of the file
            std::io::fs::unlink(part) or discard;
            std::io::fs::unlink(side) or discard;
        }
        let mut offset = if std::io::fs::file_exists(part) {
            std::io::fs::file_size(part) or 0
        } else {
            0
        };
        if offset >= bytes {
            if offset == bytes { return ""; }
            std::io::fs::unlink(part) or discard;
            offset = 0;
        }
        let u = std::http::parse_url(url) or { return name + ": " + url + " is not a URL"; };
        let vault = hub_token_vault(self.file);
        let r = std::http::BodyReader {
            req: std::http::ClientRequest {
                url: u,
                headers: if offset > 0 { "Range: bytes=" + to_string(offset) + "-" } else { "" },
                body: b"",
                follow_redirects: 5,
            },
            bearer: if hub && len(vault) > 0 {
                std::secret::Credential { vault: vault }
            } else {
                std::secret::Credential { }
            },
            timeout_ms: 0,
        };
        if r.status == 0 { return name + ": the request failed"; }
        if offset > 0 && r.status == 200 {
            // the server sent it whole: start the part over
            std::io::fs::unlink(part) or discard;
            offset = 0;
        } else if r.status != 200 && r.status != 206 {
            return name + ": " + url_host(url) + " answered " + to_string(r.status);
        }
        let f = std::io::file::open(part, if offset > 0 { "a" } else { "w" }) or {
            return name + ": " + part + " could not be written: " + err.detail;
        };
        let mut got = offset;
        let mut next = got + REPORT_BYTES;
        while true {
            // a stop ends the download; what is written stays in the part,
            // which the next start resumes from
            if self.draining { return name + ": stopped, the node is stopping"; }
            let n = self.pump(r, f);
            if n == -1 { return ""; }
            if n < 0 { return name + ": " + self.why; }
            got = got + n;
            if got > bytes {
                // more than the pin is never the file: stop, and let it go
                std::io::fs::unlink(part) or discard;
                return name + ": more than the " + to_string(bytes) + " bytes pinned: refused";
            }
            if got >= next {
                self.tell(seat, "fetching", "", done + got, total);
                next = got + REPORT_BYTES;
            }
        }
        return "";
    }

    /// The file at `url` fetched in ranges over the lanes into `part`, each
    /// written at its offset, what is written kept in `side`; "" once every
    /// range is written, `UNRANGED` when the server does not honour
    /// `Range`, else why not. Spans `side` holds are not fetched again;
    /// a part with no sidecar, one fetched whole and cut off, holds the
    /// start of the file.
    @unbounded
    fn in_ranges(
        seat: String,
        url: String,
        name: String,
        part: String,
        side: String,
        bytes: Int,
        hub: Bool,
        done: Int,
        total: Int
    ) -> String {
        let mut spans = "";
        if std::io::fs::file_exists(side) {
            spans = spans_read(std::io::fs::read_file(side) or "!", bytes);
            if spans == "!" {
                // a sidecar that is not this file's leaves the part unknown
                std::io::fs::unlink(part) or discard;
                std::io::fs::unlink(side) or discard;
                spans = "";
            }
        } else if std::io::fs::file_exists(part) {
            let size = std::io::fs::file_size(part) or 0;
            if size > bytes {
                std::io::fs::unlink(part) or discard;
            } else {
                spans = spans_add("", 0, size);
            }
        }
        let made = create_part(part);
        if len(made) > 0 { return name + ": " + made; }
        self.job = self.job + 1;
        self.url = url;
        self.hub = hub;
        self.vault = hub_token_vault(self.file);
        self.part = part;
        self.side = side;
        self.size = bytes;
        self.spans = spans;
        self.retry = "";
        self.at = 0;
        self.failure = "";
        self.unranged = false;
        self.fill_slots();
        // from here the part is written at offsets: the sidecar says what
        // of it is the file
        let saved = self.save();
        if len(saved) > 0 { return name + ": " + saved; }
        self.window_end = std::time::monotonic_ns() + self.window_ms * 1000000;
        let mut next = spans_total(spans) + REPORT_BYTES;
        while true {
            if self.draining {
                self.drop_all();
                self.save();
                return name + ": stopped, the node is stopping";
            }
            let state = self.turn();
            if state == 1 { return ""; }
            if state == 2 {
                self.drop_all();
                self.save();
                return name + ": " + self.failure;
            }
            if state == 3 {
                self.drop_all();
                self.settle();
                return UNRANGED;
            }
            let held = self.held();
            if held >= next {
                self.tell(seat, "fetching", "", done + held, total);
                next = held + REPORT_BYTES;
            }
            std::time::sleep(20ms);
        }
        return "";
    }

    /// One turn of a ranged fetch: stalled lanes dropped, the lanes
    /// judged at the end of a window, free lanes handed ranges. 0 while it
    /// goes on, 1 once every range is written, 2 when it cannot be
    /// (`failure` says), 3 when the server does not honour `Range`.
    fn turn() -> Int {
        if len(self.failure) > 0 { return 2; }
        if self.unranged { return 3; }
        let now = std::time::monotonic_ns();
        let mut i = 0;
        while i < count(self.slots.items) {
            let s = at(self.slots.items, i) or LaneSlot { };
            if self.live(s) && now - s.since > self.stall_ms * 1000000 {
                self.drop(i);
            }
            i = i + 1;
        }
        if len(self.failure) > 0 { return 2; }
        if now >= self.window_end {
            self.judge();
            self.save();
            self.window_end = now + self.window_ms * 1000000;
        }
        i = 0;
        while i < count(self.slots.items) {
            let s = at(self.slots.items, i) or LaneSlot { };
            if s.ticket == 0 && !self.hand(i, now) { break; }
            i = i + 1;
        }
        if spans_gap(self.spans, self.at, self.size) < self.size || len(self.retry) > 0 {
            return 0;
        }
        for s in self.slots.items {
            if s.job == self.job && s.ticket != 0 && (!s.dropped || s.writing) { return 0; }
        }
        return 1;
    }

    /// The window's end: each lane busy all of it compared with the
    /// others', and one that wrote less than `1/SLOWER` of their median
    /// dropped; then every busy lane measured afresh.
    fn judge() {
        let mut rates: [Int; 8] = [0; 8];
        let mut n = 0;
        for s in self.slots.items {
            if self.live(s) && s.whole && n < 8 {
                rates[n] = s.got - s.mark;
                n = n + 1;
            }
        }
        if n >= 2 {
            // sorted, for the upper median
            let mut i = 1;
            while i < n {
                let v = rates[i];
                let mut j = i - 1;
                while j >= 0 && rates[j] > v {
                    rates[j + 1] = rates[j];
                    j = j - 1;
                }
                rates[j + 1] = v;
                i = i + 1;
            }
            let median = rates[n / 2];
            i = 0;
            while i < count(self.slots.items) {
                let s = at(self.slots.items, i) or LaneSlot { };
                if self.live(s) && s.whole && (s.got - s.mark) * SLOWER < median {
                    self.drop(i);
                }
                i = i + 1;
            }
        }
        let mut next = LaneSlots { };
        for s in self.slots.items {
            let mut m = s;
            if self.live(m) {
                m.mark = m.got;
                m.whole = true;
            }
            push(next.items, m) or discard;
        }
        self.slots = next;
    }

    /// Hand lane `i` the next range, a range to hand again first: false
    /// when none is ready.
    fn hand(i: Int, now: Int) -> Bool {
        let p = self.take(now);
        if !p.found { return false; }
        self.tickets = self.tickets + 1;
        self.put(i, LaneSlot {
            job: self.job,
            ticket: self.tickets,
            start: p.start,
            end: p.end,
            got: p.start,
            tries: p.tries,
            since: now,
            mark: p.start,
        });
        RangeWanted <- RangeWork {
            lane: i,
            ticket: self.tickets,
            url: self.url,
            hub: self.hub,
            vault: self.vault,
            part: self.part,
            start: p.start,
            end: p.end,
            size: self.size,
            // a bound on the exchange, so no lane is held for ever: 30 s,
            // and the range at 64 KiB/s; what it wrote stands, and the
            // rest is handed again
            timeout_ms: 30000 + (p.end - p.start) / 64,
            report_ms: self.report_ms,
        };
        return true;
    }

    /// The next range: the first one to hand again that is ready, else the
    /// next gap's next `piece` bytes.
    @unbounded
    fn take(now: Int) -> Piece {
        let mut kept = "";
        let mut found = Piece { };
        let mut rest = self.retry;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            if !found.found && word(line, 3) <= now {
                found = Piece {
                    start: word(line, 0),
                    end: word(line, 1),
                    tries: word(line, 2),
                    found: true,
                };
            } else {
                kept = kept + line + "\n";
            }
        }
        if found.found {
            self.retry = kept;
            return found;
        }
        let g = spans_gap(self.spans, self.at, self.size);
        if g >= self.size { return Piece { }; }
        let gap_end = spans_gap_end(self.spans, g, self.size);
        let end = if g + self.piece < gap_end { g + self.piece } else { gap_end };
        self.at = end;
        return Piece { start: g, end: end, found: true };
    }

    /// Lane `i` dropped, a straggler or stalled: what it wrote stands, the
    /// rest of its range is handed again, and the lane is waited on only
    /// until it says it stopped.
    fn drop(i: Int) {
        let mut s = at(self.slots.items, i) or LaneSlot { };
        RangeDropped <- RangeStop { lane: i, ticket: s.ticket };
        self.dropped = self.dropped + 1;
        self.again(s, "stalled: nothing came in " + to_string(self.stall_ms / 1000) + " s");
        s.dropped = true;
        self.put(i, s);
    }

    /// What `s` wrote kept, the rest of its range to hand again; a range
    /// that failed `TRIES` times in a row with nothing written ends the
    /// fetch with `why`.
    @unbounded
    fn again(s: LaneSlot, why: String) {
        self.spans = spans_add(self.spans, s.start, s.got);
        let tries = if s.got > s.start { 0 } else { s.tries + 1 };
        if tries >= TRIES {
            if len(self.failure) == 0 {
                self.failure = "a range failed " + to_string(tries) + " times: " + why;
            }
            return;
        }
        let wait = if tries > 10 { 10 } else { tries };
        self.retry = self.retry + to_string(s.got) + " " + to_string(s.end) + " "
            + to_string(tries) + " "
            + to_string(std::time::monotonic_ns() + wait * 1000000000) + "\n";
    }

    /// Every lane still on this file dropped.
    fn drop_all() {
        let mut i = 0;
        while i < count(self.slots.items) {
            let s = at(self.slots.items, i) or LaneSlot { };
            if self.live(s) {
                RangeDropped <- RangeStop { lane: i, ticket: s.ticket };
                let mut d = s;
                d.dropped = true;
                self.put(i, d);
            }
            i = i + 1;
        }
    }

    /// Wait, a stall's time at most, until no lane dropped from this file
    /// may still write it.
    fn settle() {
        let until = std::time::monotonic_ns() + self.stall_ms * 1000000;
        while std::time::monotonic_ns() < until {
            std::time::sleep(20ms);
            let mut writing = false;
            for s in self.slots.items {
                if s.job == self.job && s.ticket != 0 && s.writing { writing = true; }
            }
            if !writing { return; }
        }
    }

    /// What a lane says: how far it wrote, then how its range ended.
    @unbounded
    fn on_heard(n: RangeNews) {
        if n.lane < 0 || n.lane >= count(self.slots.items) { return; }
        let mut s = at(self.slots.items, n.lane) or LaneSlot { };
        if s.ticket == 0 || s.ticket != n.ticket { return; }
        if n.writing { s.writing = true; }
        if s.dropped || s.job != self.job {
            // its range was handed again: only its end matters, which
            // frees the lane
            self.put(n.lane, if len(n.ended) > 0 { LaneSlot { } } else { s });
            return;
        }
        if n.got > s.got {
            s.got = n.got;
            s.since = std::time::monotonic_ns();
        }
        if len(n.ended) == 0 {
            self.put(n.lane, s);
            return;
        }
        if n.ended == RANGE_DONE {
            self.spans = spans_add(self.spans, s.start, s.end);
        } else if n.ended == RANGE_WHOLE {
            self.unranged = true;
        } else if n.ended == RANGE_UNWRITABLE {
            if len(self.failure) == 0 { self.failure = n.why; }
        } else if n.ended == RANGE_STATUS && !retried(n.status) {
            if len(self.failure) == 0 { self.failure = n.why; }
        } else {
            self.again(s, n.why);
        }
        self.put(n.lane, LaneSlot { });
        self.save();
    }

    /// Whether `s` is a lane on this file's range, not dropped.
    fn live(s: LaneSlot) -> Bool {
        return s.ticket != 0 && s.job == self.job && !s.dropped;
    }

    /// The bytes of this file written: its spans, and what each lane on it
    /// wrote of its range.
    fn held() -> Int {
        let mut n = spans_total(self.spans);
        for s in self.slots.items {
            if self.live(s) { n = n + s.got - s.start; }
        }
        return n;
    }

    /// The sidecar written: the spans and what each lane wrote of its
    /// range, put in place whole.
    @unbounded
    fn save() -> String {
        let mut text = self.spans;
        for s in self.slots.items {
            if self.live(s) { text = spans_add(text, s.start, s.got); }
        }
        std::io::fs::write_file(self.side + ".new", text) or {
            return self.side + " could not be written: " + err.detail;
        };
        std::io::fs::rename(self.side + ".new", self.side) or {
            return self.side + " could not be written: " + err.detail;
        };
        return "";
    }

    /// The lanes there are, each held once.
    fn fill_slots() {
        if count(self.slots.items) >= self.lanes { return; }
        let mut next = self.slots;
        while count(next.items) < self.lanes && count(next.items) < 8 {
            push(next.items, LaneSlot { }) or discard;
        }
        self.slots = next;
    }

    /// Lane `i` held as `s`.
    fn put(i: Int, s: LaneSlot) {
        let mut next = LaneSlots { };
        let mut j = 0;
        for x in self.slots.items {
            push(next.items, if j == i { s } else { x }) or discard;
            j = j + 1;
        }
        self.slots = next;
    }

    /// One piece of the body, read and written: its length (0 when none
    /// came within `PUMP_WAIT_MS`, so the loop can look at a stop), -1 at
    /// the end, -2 when it could not be read or written (`why` says). A
    /// call of its own, so a piece is let go once it is written.
    fn pump(r: std::http::BodyReader, f: std::io::file::File) -> Int {
        let b = r.chunk_within(PUMP_WAIT_MS) or {
            if err.kind == "idle" { return 0; }
            if err.kind == "end" { return -1; }
            self.why = err.kind + ": " + err.detail;
            return -2;
        };
        f.write_bytes(b) or {
            self.why = "could not be written: " + err.detail;
            return -2;
        };
        return len(b);
    }

    fn tell(seat: String, status: String, reason: String, done: Int, total: Int) {
        FetchUpdated <- FetchState {
            seat: seat,
            status: status,
            reason: reason,
            done: done,
            total: total,
        };
    }
}

/// The bytes a part of an unheld file already holds, 0 for none; a part
/// longer than the file's pin is removed.
fn partial(blobs: String, sha: String, bytes: Int) -> Int {
    if held(blobs, sha) { return 0; }
    let part = blobs + "/" + sha + ".part";
    if !std::io::fs::file_exists(part) { return 0; }
    let side = blobs + "/" + sha + ".ranges";
    if std::io::fs::file_exists(side) {
        // written in ranges: what its sidecar says is the file
        let spans = spans_read(std::io::fs::read_file(side) or "!", bytes);
        return if spans == "!" { 0 } else { spans_total(spans) };
    }
    let size = std::io::fs::file_size(part) or 0;
    if size > bytes {
        std::io::fs::unlink(part) or discard;
        return 0;
    }
    return size;
}

/// `part` there, made empty when it is not: "" when it is, else why not.
fn create_part(part: String) -> String {
    if std::io::fs::file_exists(part) { return ""; }
    let f = std::io::file::open(part, "w") or {
        return part + " could not be written: " + err.detail;
    };
    return "";
}

/// The `i`th of a line's space-separated numbers, 0 when there is none.
@bounded_by(line)
fn word(line: String, i: Int) -> Int {
    let mut rest = line;
    let mut k = 0;
    while k < i {
        let sp = std::str::index_of(rest, " ");
        if sp < 0 { return 0; }
        rest = rest[(sp + 1)..len(rest)];
        k = k + 1;
    }
    let sp = std::str::index_of(rest, " ");
    return std::str::parse_int(if sp < 0 { rest } else { rest[0..sp] }) or 0;
}

/// Whether a range the server answered `status` is asked for again: one it
/// may answer next time (a timeout, too many requests, its own failure).
fn retried(status: Int) -> Bool {
    return status == 408 || status == 429 || status >= 500 || status < 400;
}

/// True when the store holds `blobs/<sha>`: kept only once it verified.
fn held(blobs: String, sha: String) -> Bool {
    return len(sha) == 64 && std::io::fs::file_exists(blobs + "/" + sha);
}

/// The managed engine's `local` object in the capabilities file.
@bounded_by(file)
fn managed_local(file: String) -> String {
    let mut it = std::json::array_first(std::json::find_field_raw(file, "engines"));
    while !it.done {
        if std::json::find_string_field(it.element, "kind") == "managed" {
            return std::json::find_field_raw(it.element, "local");
        }
        it = std::json::array_next(it);
    }
    return "";
}

/// Where the hub is: the managed engine's `local.hub_url`, without a
/// trailing slash, or Hugging Face's.
fn hub_url(file: String) -> String {
    let u = std::json::find_string_field(managed_local(file), "hub_url");
    if len(u) == 0 { return HUB_URL; }
    return if std::str::ends_with(u, "/") { u[0..(len(u) - 1)] } else { u };
}

/// The vault entry the hub's token is in, "" for none.
fn hub_token_vault(file: String) -> String {
    return std::json::find_string_field(managed_local(file), "hub_token_vault");
}

/// A URL's host, for a reason.
fn url_host(url: String) -> String {
    let u = std::http::parse_url(url) or { return url; };
    return u.host;
}

/// Bytes as GiB, to a tenth.
fn gib(n: Int) -> String {
    let t = (n * 10 + 536870912) / 1073741824;
    return to_string(t / 10) + "." + to_string(t % 10) + " GiB";
}
