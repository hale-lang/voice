// Both stores answer the same: every row written reads back as it was,
// each write records its change, and the fleet's reports land. The memory
// store always; the Postgres store too when VOICE_TEST_DATABASE_URL names
// a database at the current schema (`api migrate`), which this test
// empties first.
import ".." as st;
import "../../lib/pond/db" as db;

fn t(text: String) -> Time {
    return std::time::parse_time(text) or `1970-01-01T00:00:00Z`;
}

/// When laptop/static's state began, as the store holds it.
fn since_of(s: st::Store) -> String {
    let rows = s.seat_states("laptop") or st::SeatStateRows { };
    let row = at(rows.rows, 0) or st::SeatStateRow { };
    return std::time::iso8601(row.since);
}

fn ch(action: String, target: String) -> st::ChangeRow {
    return st::ChangeRow {
        at: t("2026-10-17T12:00:00Z"),
        action: action,
        target: target,
        after: "{\"target\": \"" + target + "\"}",
    };
}

fn names(a: String, b: String) -> st::Names {
    let mut n = st::Names { };
    push(n.items, a) or discard;
    if len(b) > 0 { push(n.items, b) or discard; }
    return n;
}

fn exercise(s: st::Store, label: String) {
    let at = t("2026-10-17T12:00:00Z");

    // the catalog
    let m = st::ModelRow {
        id: "echo-1",
        owned_by: "local",
        kind: "local",
        context_length: 8192,
        priced: true,
        price: st::ModelPrice {
            input_per_mtok_micros: 3,
            output_per_mtok_micros: 15,
            currency: "USD",
        },
        recipe: "qwen3-8b",
        created_at: at,
    };
    std::test::assert(
        s.insert_model(m, ch("create", "models/echo-1")) or false,
        label + ": a model is added",
    );
    std::test::assert(
        !(s.insert_model(m, ch("create", "models/echo-1")) or true),
        label + ": once",
    );
    let got = s.model("echo-1") or st::ModelRow { };
    std::test::assert(
        got.present
            && got.priced
            && got.price.output_per_mtok_micros == 15
            && got.context_length == 8192
            && got.max_output_tokens == 0
            && got.recipe == "qwen3-8b",
        label + ": and reads back",
    );
    std::test::assert_eq_str(
        std::time::iso8601(got.created_at),
        "2026-10-17T12:00:00Z",
        label + ": its time",
    );
    let mut gone = got;
    gone.removed = true;
    gone.removed_at = at;
    gone.priced = false;
    s.update_model(gone, ch("delete", "models/echo-1")) or discard;
    let back = s.model("echo-1") or st::ModelRow { };
    std::test::assert(back.removed && !back.priced, label + ": a removal and a null price");
    std::test::assert_eq_str(back.recipe, "qwen3-8b", label + ": a change keeps the recipe");
    std::test::assert(!(s.model("nope") or st::ModelRow { }).present, label + ": an absent model");

    // recipes: the operator's, kept whole, removed without reuse
    let body = "{\"id\": \"mine-1\", \"license\": {\"name\": \"mit\", \"url\": \"https://example.org\"}, \"variants\": []}";
    std::test::assert(
        s.insert_recipe(
            st::RecipeRow { id: "mine-1", body: body, created_at: at },
            ch("create", "recipes/mine-1"),
        )
        or false,
        label + ": a recipe is added",
    );
    std::test::assert(
        !(
            s.insert_recipe(
                st::RecipeRow { id: "mine-1", body: body, created_at: at },
                ch("create", "recipes/mine-1"),
            )
            or true),
        label + ": once",
    );
    let r = s.recipe("mine-1") or st::RecipeRow { };
    std::test::assert(r.present && !r.removed, label + ": and read back");
    std::test::assert_eq_str(
        std::json::find_string_field(std::json::find_field_raw(r.body, "license"), "url"),
        "https://example.org",
        label + ": its body",
    );
    s.remove_recipe(
        st::RecipeRow { id: "mine-1", removed_at: at },
        ch("delete", "recipes/mine-1"),
    ) or discard;
    let rr = s.recipe("mine-1") or st::RecipeRow { };
    std::test::assert(rr.present && rr.removed, label + ": a removal keeps the row");
    let rows = s.recipes() or st::RecipeRows { };
    std::test::assert_eq_int(count(rows.rows), 1, label + ": listed");

    // runtimes: the operator's, kept whole, removed without reuse
    std::test::assert(
        s.insert_runtime(
            st::RuntimeRow {
                id: "rt-1",
                body: "{\"id\": \"rt-1\", \"server\": \"vllm\"}",
                created_at: at,
            },
            ch("create", "runtimes/rt-1"),
        ) or false,
        label + ": a runtime is added",
    );
    let rt = s.runtime("rt-1") or st::RuntimeRow { };
    std::test::assert_eq_str(
        std::json::find_string_field(rt.body, "server"),
        "vllm",
        label + ": and read back",
    );
    s.remove_runtime(
        st::RuntimeRow { id: "rt-1", removed_at: at },
        ch("delete", "runtimes/rt-1"),
    ) or discard;
    let rts = s.runtimes() or st::RuntimeRows { };
    let rt0 = at(rts.rows, 0) or st::RuntimeRow { };
    std::test::assert(count(rts.rows) == 1 && rt0.removed, label + ": a removal keeps the row");

    // placements: a model on nodes, found by its model, removed without reuse
    std::test::assert(
        s.insert_placement(
            st::PlacementRow {
                id: "on-node-a",
                model: "echo-1",
                body: "{\"leader\": \"node-a\"}",
                created_at: at,
            },
            ch("create", "placements/on-node-a"),
        ) or false,
        label + ": a placement is added",
    );
    let pl = s.placement("on-node-a") or st::PlacementRow { };
    std::test::assert(pl.present && pl.model == "echo-1", label + ": and read back with its model");
    std::test::assert_eq_str(
        std::json::find_string_field(pl.body, "leader"),
        "node-a",
        label + ": its body",
    );
    s.remove_placement(
        st::PlacementRow { id: "on-node-a", removed_at: at },
        ch("delete", "placements/on-node-a"),
    )
    or discard;
    let prs = s.placements() or st::PlacementRows { };
    let first = at(prs.rows, 0) or st::PlacementRow { };
    std::test::assert(count(prs.rows) == 1 && first.removed, label + ": a removal keeps the row");

    // accounts, projects, keys
    std::test::assert(
        s.insert_account(
            st::AccountRow { id: "static", name: "Static", billing: "none", created_at: at },
            ch("create", "accounts/static"),
        ) or false,
        label + ": an account",
    );
    let mut lim = st::Limits { };
    push(
        lim.items,
        st::counted(
            st::Limit {
                scope: st::LimitScope::account,
                account: "static",
                window_seconds: 60,
                requests: 5,
            },
        ),
    ) or discard;
    let mut acc = s.account("static") or st::AccountRow { };
    acc.limits = lim;
    acc.provider = "anthropic";
    s.update_account(acc, ch("update", "accounts/static")) or discard;
    let acc2 = s.account("static") or st::AccountRow { };
    let l0 = at(acc2.limits.items, 0) or st::Limit { scope: st::LimitScope::project };
    std::test::assert(
        acc2.provider == "anthropic" && count(acc2.limits.items) == 1 && l0.requests == 5,
        label + ": its limits",
    );
    std::test::assert_eq_int(l0.input_tokens, -1, label + ": a null count");

    let mut p = st::ProjectRow {
        id: "work",
        name: "Work",
        owners: names("op", ""),
        data_classes: names("public", "internal"),
        accounts: st::Restriction { any: false, names: names("static", "") },
        created_at: at,
    };
    p.budgeted = true;
    p.budget = st::BudgetSet {
        allowance_micros: 1000,
        currency: "USD",
        period: st::Period::month,
        period_anchor: t("2026-10-01T00:00:00Z"),
    };
    push(
        p.limits.items,
        st::counted(
            st::Limit { scope: st::LimitScope::project, window_seconds: 60, requests: 600 },
        ),
    ) or discard;
    push(
        p.limits.items,
        st::counted(
            st::Limit {
                scope: st::LimitScope::model,
                model: "echo-1",
                window_seconds: 3600,
                concurrent: 4,
            },
        ),
    ) or discard;
    std::test::assert(
        s.insert_project(p, ch("create", "projects/work")) or false,
        label + ": a project",
    );
    let pr = s.project("work") or st::ProjectRow { };
    std::test::assert(
        pr.models.any && !pr.accounts.any && count(pr.accounts.names.items) == 1,
        label + ": a null list and a list",
    );
    let dc1 = at(pr.data_classes.items, 1) or "";
    std::test::assert(count(pr.data_classes.items) == 2 && dc1 == "internal", label + ": in order");
    std::test::assert(
        pr.budgeted
            && pr.budget.allowance_micros == 1000
            && std::time::iso8601(pr.budget.period_anchor) == "2026-10-01T00:00:00Z",
        label + ": its budget",
    );
    std::test::assert_eq_int(count(pr.limits.items), 2, label + ": its limits");
    let pl0 = at(pr.limits.items, 0) or st::Limit { scope: st::LimitScope::project };
    std::test::assert(
        pl0.model == "" && pl0.account == "" && pl0.input_tokens == -1,
        label + ": a project limit names no model, and a null count stays null",
    );
    std::test::assert_eq_str(pr.position, "", label + ": a null text is empty");
    let pl1 = at(pr.limits.items, 1) or st::Limit { scope: st::LimitScope::project };
    std::test::assert_eq_str(pl1.model, "echo-1", label + ": a model limit names its model");
    let mut narrowed = pr;
    narrowed.models = st::Restriction { any: false, names: st::Names { } };
    narrowed.budgeted = false;
    s.update_project(narrowed, ch("update", "projects/work")) or discard;
    let pr2 = s.project("work") or st::ProjectRow { };
    std::test::assert(
        !pr2.models.any && count(pr2.models.names.items) == 0 && !pr2.budgeted,
        label + ": an empty list is not null; the budget gone",
    );

    let k = st::KeyRow {
        id: "k_1",
        project: "work",
        name: "ci",
        prefix: "vk-abcd",
        digest: "00ff",
        created_at: at,
        expires: true,
        expires_at: t("2099-01-01T00:00:00Z"),
    };
    std::test::assert(
        s.insert_key(k, ch("create", "projects/work/keys/k_1")) or false,
        label + ": a key",
    );
    let kd = s.key_by_digest("00ff") or st::KeyRow { };
    std::test::assert(
        kd.present && kd.id == "k_1" && kd.expires && !kd.used,
        label + ": found by its digest",
    );
    std::test::assert(
        !(s.key_by_digest("00fe") or st::KeyRow { }).present,
        label + ": and only by its own",
    );
    s.touch_key("k_1", t("2026-10-17T12:30:00Z")) or discard;
    let touched = s.key("k_1") or st::KeyRow { };
    std::test::assert(
        touched.used && std::time::iso8601(touched.last_used_at) == "2026-10-17T12:30:00Z",
        label + ": a key's last use",
    );
    let ks = s.keys("work") or st::KeyRows { };
    std::test::assert_eq_int(count(ks.rows), 2, label + ": the project's keys, its system key too");
    let mut archived = pr2;
    archived.archived = true;
    archived.archived_at = at;
    let mut gone = s.key("k_1") or st::KeyRow { };
    gone.revoked = true;
    gone.revoked_at = at;
    let mut revoked = st::Revocations { };
    push(revoked.keys, gone) or discard;
    push(revoked.changes, ch("revoke", "projects/work/keys/k_1")) or discard;
    s.archive_project(archived, ch("archive", "projects/work"), revoked) or discard;
    std::test::assert(
        (s.key("k_1") or st::KeyRow { }).revoked,
        label + ": archiving revokes the keys",
    );
    std::test::assert(
        (s.project("work") or st::ProjectRow { }).archived,
        label + ": and archives the project",
    );

    // nodes and seats
    std::test::assert(
        s.insert_node(
            st::NodeRow { id: "laptop", name: "Laptop", token_digest: "abcd", created_at: at },
            ch("create", "nodes/laptop"),
        ) or false,
        label + ": a node",
    );
    std::test::assert_eq_int(
        (s.node("laptop") or st::NodeRow { }).assignment_version,
        1,
        label + ": at its first assignment",
    );
    let mut seat = st::SeatRow {
        node: "laptop",
        id: "static",
        engine: "static",
        account: "static",
        data_classes: names("internal", ""),
        concurrency: 2,
        config: "{\"text\": \"hi\"}",
    };
    push(
        seat.serves.items,
        st::SeatModel { model: "echo-1", has_engine_name: true, engine_name: "echo" },
    ) or discard;
    std::test::assert(
        s.insert_seat(seat, ch("create", "nodes/laptop/seats/static")) or false,
        label + ": a seat",
    );
    std::test::assert_eq_int(
        (s.node("laptop") or st::NodeRow { }).assignment_version,
        2,
        label + ": a new assignment with it",
    );
    let sr = s.seat("laptop", "static") or st::SeatRow { };
    std::test::assert(
        sr.present && sr.ref == "laptop/static" && sr.concurrency == 2 && sr.enabled,
        label + ": the seat reads back",
    );
    let sm0 = at(sr.serves.items, 0) or st::SeatModel { };
    std::test::assert_eq_str(sm0.engine_name, "echo", label + ": its model's own name");
    std::test::assert_eq_str(
        std::json::find_string_field(sr.config, "text"),
        "hi",
        label + ": its config",
    );
    s.delete_seat(sr, ch("delete", "nodes/laptop/seats/static")) or discard;
    std::test::assert(
        !(s.seat("laptop", "static") or st::SeatRow { }).present,
        label + ": removed",
    );
    s.insert_seat(seat, ch("create", "nodes/laptop/seats/static")) or discard;
    std::test::assert_eq_int(
        (s.node("laptop") or st::NodeRow { }).assignment_version,
        4,
        label + ": every seat change moves it",
    );

    // the fleet as reported
    std::test::assert(!(s.fleet("laptop") or st::FleetRow { }).present, label + ": not registered");
    s.put_fleet(
        st::FleetRow {
            node: "laptop",
            version: "0.1.0",
            capabilities: "{\"engines\": [], \"hardware\": {\"memory_bytes\": 4}}",
            local: "{\"paused\": false, \"paused_seats\": []}",
            registered_at: at,
            protocol: 3,
        },
    ) or discard;
    s.put_beat("laptop", t("2026-10-17T12:00:05Z"), 2) or discard;
    let f = s.fleet("laptop") or st::FleetRow { };
    std::test::assert(
        f.present && f.applied_version == -1 && !f.draining && f.version == "0.1.0"
            && f.protocol == 3,
        label + ": registered, with the protocol it speaks",
    );
    std::test::assert_eq_int(
        std::json::find_int_field(
            std::json::find_field_raw(f.capabilities, "hardware"),
            "memory_bytes",
        ),
        4,
        label + ": its capabilities",
    );
    let b = s.beat("laptop") or st::Beat { };
    // the memory store keeps the time it is given; Postgres writes its own
    // clock's, which the brain judges a beat by
    let when_ok = if label == "postgres" {
        std::time::unix(std::time::current()) - std::time::unix(b.at) < 60
    } else {
        std::time::iso8601(b.at) == "2026-10-17T12:00:05Z"
    };
    std::test::assert(b.present && b.in_flight == 2 && when_ok, label + ": its heartbeat");
    let mut f2 = f;
    f2.applied_version = 4;
    f2.draining = true;
    s.put_fleet(f2) or discard;
    let f3 = s.fleet("laptop") or st::FleetRow { };
    std::test::assert(
        f3.applied_version == 4 && f3.draining && f3.protocol == 3,
        label + ": what it reported since",
    );
    s.put_seat_state(
        st::SeatStateRow {
            ref: "laptop/static",
            node: "laptop",
            seat: "static",
            status: "refused",
            reason: "no engine",
        },
    ) or discard;
    let states = s.seat_states("laptop") or st::SeatStateRows { };
    let st = at(states.rows, 0) or st::SeatStateRow { };
    std::test::assert(
        st.status == "refused" && st.reason == "no engine",
        label + ": a seat's state",
    );
    s.put_seat_state(
        st::SeatStateRow {
            ref: "laptop/static",
            node: "laptop",
            seat: "static",
            status: "fetching",
            has_progress: true,
            done_bytes: 5000000000,
            total_bytes: 80000000000,
        },
    ) or discard;
    let fetching = s.seat_states("laptop") or st::SeatStateRows { };
    let fs = at(fetching.rows, 0) or st::SeatStateRow { };
    std::test::assert(
        fs.status == "fetching"
            && fs.has_progress
            && fs.done_bytes == 5000000000
            && fs.total_bytes == 80000000000,
        label + ": a managed seat fetching, with how far",
    );
    // `since`: the time of the report that changed the seat's status or
    // its reason, kept while reports repeat them
    s.put_seat_state(
        st::SeatStateRow {
            ref: "laptop/static",
            node: "laptop",
            seat: "static",
            status: "starting",
            reason: "loading the model",
            since: t("2026-10-17T12:01:00Z"),
        },
    ) or discard;
    std::test::assert_eq_str(
        since_of(s),
        "2026-10-17T12:01:00Z",
        label + ": a state change stamps since",
    );
    s.put_seat_state(
        st::SeatStateRow {
            ref: "laptop/static",
            node: "laptop",
            seat: "static",
            status: "starting",
            reason: "loading the model",
            since: t("2026-10-17T12:02:00Z"),
        },
    ) or discard;
    s.put_seat_state(
        st::SeatStateRow {
            ref: "laptop/static",
            node: "laptop",
            seat: "static",
            status: "starting",
            reason: "loading the model",
            in_flight: 1,
            since: t("2026-10-17T12:03:00Z"),
        },
    ) or discard;
    std::test::assert_eq_str(
        since_of(s),
        "2026-10-17T12:01:00Z",
        label + ": a report that repeats the state keeps since, whatever else it says",
    );
    s.put_seat_state(
        st::SeatStateRow {
            ref: "laptop/static",
            node: "laptop",
            seat: "static",
            status: "starting",
            reason: "warming the cache",
            since: t("2026-10-17T12:04:00Z"),
        },
    ) or discard;
    std::test::assert_eq_str(
        since_of(s),
        "2026-10-17T12:04:00Z",
        label + ": a reason change stamps it again",
    );
    s.put_seat_state(
        st::SeatStateRow {
            ref: "laptop/static",
            node: "laptop",
            seat: "static",
            status: "up",
            since: t("2026-10-17T12:05:00Z"),
        },
    ) or discard;
    std::test::assert_eq_str(
        since_of(s),
        "2026-10-17T12:05:00Z",
        label + ": and so does a status change",
    );
    s.put_windows(
        "static",
        "[{\"name\": \"five_hour\", \"used_percent\": 12.5, \"observed_at\": \"2026-10-17T00:00:00Z\", \"seat\": \"laptop/static\"}]",
    ) or discard;
    std::test::assert(
        std::str::contains(s.windows("static") or "", "five_hour"),
        label + ": an account's windows",
    );
    s.put_windows(
        "static",
        "[{\"name\": \"day\", \"used_percent\": 1, \"observed_at\": \"2026-10-17T00:00:00Z\"}]",
    ) or discard;
    let seatless = s.windows("static") or "";
    std::test::assert(
        std::str::contains(seatless, "\"day\"") && !std::str::contains(seatless, "seat"),
        label + ": a window reported without a seat has no seat key: " + seatless,
    );

    // the change log
    let all = s.changes(st::ChangeQuery { }) or st::ChangeRows { };
    std::test::assert_eq_int(
        count(all.rows),
        19,
        label + ": every write recorded its change, the refused one none",
    );
    let archive_log = s.changes(
        st::ChangeQuery { target: "projects/work/keys" },
    ) or st::ChangeRows { };
    std::test::assert_eq_str(
        (at(archive_log.rows, 0) or st::ChangeRow { }).action,
        "revoke",
        label + ": the archive recorded its key's revocation",
    );
    std::test::assert(
        !(s.changes(st::ChangeQuery { cursor: "chg_999999" }) or st::ChangeRows { }).cursor_known,
        label + ": a cursor that names no change",
    );
    std::test::assert(
        !(s.changes(st::ChangeQuery { cursor: "nothing" }) or st::ChangeRows { }).cursor_known,
        label + ": nor one that names nothing",
    );
    let newest = at(all.rows, 0) or st::ChangeRow { };
    std::test::assert_eq_str(newest.target, "nodes/laptop/seats/static", label + ": newest first");
    std::test::assert_eq_str(
        std::json::find_string_field(newest.after, "target"),
        "nodes/laptop/seats/static",
        label + ": with what it became",
    );
    let page = s.changes(st::ChangeQuery { limit: 2 }) or st::ChangeRows { };
    std::test::assert(page.more && count(page.rows) == 2, label + ": a page");
    let second = at(page.rows, 1) or st::ChangeRow { };
    let next = s.changes(st::ChangeQuery { limit: 2, cursor: second.id }) or st::ChangeRows { };
    let n1 = at(next.rows, 1) or st::ChangeRow { };
    std::test::assert_eq_str(
        n1.target,
        "nodes/laptop",
        label + ": the next page goes on from the cursor",
    );
    std::test::assert(next.cursor_known, label + ": a page's own cursor is known");
    let pattern = s.changes(st::ChangeQuery { target: "%" }) or st::ChangeRows { };
    std::test::assert_eq_int(count(pattern.rows), 0, label + ": a target is a path, not a pattern");
    let underscore = s.changes(
        st::ChangeQuery { target: "projects/work/keys/k_" },
    ) or st::ChangeRows { };
    std::test::assert_eq_int(count(underscore.rows), 0, label + ": `_` matches only itself");
    let own = s.changes(st::ChangeQuery { target: "projects/work/keys/k_1" }) or st::ChangeRows { };
    std::test::assert_eq_int(count(own.rows), 2, label + ": a key's own changes");
    let under = s.changes(st::ChangeQuery { target: "projects/work" }) or st::ChangeRows { };
    std::test::assert_eq_int(count(under.rows), 5, label + ": under a target");
    // a list of the changes, not what they hold
    let bare = s.changes(st::ChangeQuery { limit: 1, bodies: false }) or st::ChangeRows { };
    let b0 = at(bare.rows, 0) or st::ChangeRow { };
    std::test::assert(
        b0.id == newest.id && b0.target == newest.target && len(b0.after) == 0
            && len(b0.before) == 0,
        label + ": a list without the bodies",
    );
    // one change, whole, by its id
    let one = s.change(newest.id) or st::ChangeRow { };
    std::test::assert(
        one.present && one.target == newest.target && one.after == newest.after,
        label + ": a change by its id, whole",
    );
    std::test::assert(
        !(s.change("chg_999999") or st::ChangeRow { present: true }).present,
        label + ": no change of an id the log has not written",
    );
    std::test::assert(
        !(s.change("nothing") or st::ChangeRow { present: true }).present,
        label + ": nor of one that is not an id",
    );
    // what a follower has not been told: past its mark, oldest first
    let oldest = at(all.rows, count(all.rows) - 1) or st::ChangeRow { };
    let after = s.changes_after(oldest.seq, 2) or st::ChangeRows { };
    let a0 = at(after.rows, 0) or st::ChangeRow { };
    let a1 = at(after.rows, 1) or st::ChangeRow { };
    std::test::assert(
        count(after.rows) == 2 && a0.seq > oldest.seq && a1.seq > a0.seq && len(a0.after) > 0,
        label + ": the changes after a mark, oldest first, whole",
    );
    let caught = s.changes_after(newest.seq, 100) or st::ChangeRows { };
    std::test::assert_eq_int(count(caught.rows), 0, label + ": none past the newest");
}

/// False when the store refused a row for being full; a failure otherwise.
fn full(e: st::StoreError) -> Bool {
    std::test::assert_eq_str(e.kind, "full", "refused as full: " + e.message);
    return false;
}

/// Both stores refuse a row past the bound every read holds, so a read
/// never drops one: 64 accounts, then a 65th refused as `full`.
fn bounded(s: st::Store, label: String) {
    let mut i = 0;
    while i < 64 {
        std::test::assert(
            s.insert_account(
                st::AccountRow { id: "a" + to_string(i), name: "A" },
                ch("create", "accounts/a" + to_string(i)),
            ) or false,
            label + ": account " + to_string(i),
        );
        i = i + 1;
    }
    let added = s.insert_account(
        st::AccountRow { id: "a64", name: "A" },
        ch("create", "accounts/a64"),
    ) or full(err);
    std::test::assert(!added, label + ": the 65th account is refused as full");
    let all = s.accounts() or st::AccountRows { };
    std::test::assert_eq_int(count(all.rows), 64, label + ": and every account reads back");
}

fn spent(
    id: String,
    when: String,
    project: String,
    key: String,
    model: String,
    node: String,
    account: String,
    input: Int,
    output: Int,
    price: Int
) -> st::UsageRow {
    let seat = if len(node) > 0 { node + "/static" } else { "" };
    return st::UsageRow {
        id: id,
        created_at: t(when),
        project: project,
        key: key,
        account: account,
        requested_model: model,
        served_model: model,
        node: node,
        seat: seat,
        status: "served",
        input_tokens: input,
        output_tokens: output,
        price_micros: price,
        served: "{\"model\": \"" + model + "\", \"node\": \"" + node + "\", \"seat\": \"" + seat
            + "\", \"account\": \"" + account + "\"}",
        record: "{\"id\": \"" + id + "\", \"project\": \"" + project
            + "\", \"conversation\": " + (if project == "work" { "\"c1\"" } else { "null" })
            + ", \"metadata\": {\"batch\": \"" + (if project == "work" { "a" } else { "b" })
            + "\", \"conversation\": \"c9\"}}"
    };
}

fn ids(r: st::UsageRows) -> String {
    let mut out = "";
    for u in r.rows {
        out = out + (if len(out) > 0 { " " } else { "" }) + u.id;
    }
    return out;
}

/// The ledger: rows written once, read back whole, paged newest first,
/// filtered, followed from a row on, and summed by group.
fn ledger(s: st::Store, label: String) {
    s.insert_usage(
        spent("u1", "2026-10-17T10:15:00Z", "work", "k1", "echo-1", "laptop", "static", 10, 5, 100),
    )
    or discard;
    s.insert_usage(
        spent("u2", "2026-10-17T10:45:00Z", "work", "k2", "echo-1", "laptop", "static", 20, 6, 200),
    )
    or discard;
    s.insert_usage(
        spent("u3", "2026-10-18T09:00:00Z", "play", "k3", "other-1", "desk", "paid", 1, 1, 5),
    )
    or discard;
    s.insert_usage(
        spent("u1", "2026-10-19T10:00:00Z", "work", "k1", "echo-1", "laptop", "static", 99, 99, 99),
    )
    or discard;
    let u1 = s.usage("u1") or st::UsageRow { };
    std::test::assert(u1.present && u1.seq == 1, label + ": a row reads back, numbered in order");
    std::test::assert(
        std::str::contains(u1.record, "\"id\": \"u1\""),
        label + ": with its whole record",
    );
    std::test::assert(
        !(s.usage("none") or st::UsageRow { present: true }).present,
        label + ": a request not in the ledger is absent",
    );
    std::test::assert_eq_str(
        ids(s.usage_rows(st::UsageQuery { }) or st::UsageRows { }),
        "u3 u2 u1",
        label + ": newest first, a request id recorded once",
    );
    let page = s.usage_rows(st::UsageQuery { limit: 2 }) or st::UsageRows { };
    std::test::assert(ids(page) == "u3 u2" && page.more, label + ": a page says there is more");
    let u2 = s.usage("u2") or st::UsageRow { };
    std::test::assert_eq_str(
        ids(s.usage_rows(st::UsageQuery { cursor: u2.seq }) or st::UsageRows { }),
        "u1",
        label + ": older than a cursor",
    );
    std::test::assert_eq_str(
        ids(s.usage_rows(st::UsageQuery { project: "play" }) or st::UsageRows { }),
        "u3",
        label + ": by project",
    );
    std::test::assert_eq_str(
        ids(s.usage_rows(st::UsageQuery { key: "k2" }) or st::UsageRows { }),
        "u2",
        label + ": by key",
    );
    std::test::assert_eq_str(
        ids(s.usage_rows(st::UsageQuery { model: "other-1" }) or st::UsageRows { }),
        "u3",
        label + ": by model",
    );
    std::test::assert_eq_str(
        ids(s.usage_rows(st::UsageQuery { account: "static" }) or st::UsageRows { }),
        "u2 u1",
        label + ": by account",
    );
    std::test::assert_eq_str(
        ids(
            s.usage_rows(st::UsageQuery { metadata: names("batch=a", "") }) or st::UsageRows { },
        ),
        "u2 u1",
        label + ": by metadata",
    );
    std::test::assert_eq_str(
        ids(s.usage_rows(st::UsageQuery { conversation: "c1" }) or st::UsageRows { }),
        "u2 u1",
        label + ": by conversation",
    );
    std::test::assert_eq_str(
        ids(s.usage_rows(st::UsageQuery { conversation: "c9" }) or st::UsageRows { }),
        "",
        label + ": the record's own, not one its metadata names",
    );
    std::test::assert_eq_str(
        ids(
            s.usage_rows(
                st::UsageQuery {
                    has_from: true,
                    from: t("2026-10-17T10:30:00Z"),
                    has_to: true,
                    to: t("2026-10-17T23:00:00Z")
                },
            ) or st::UsageRows { },
        ),
        "u2",
        label + ": by time",
    );
    std::test::assert_eq_str(
        ids(s.usage_after(1, 10) or st::UsageRows { }),
        "u2 u3",
        label + ": followed from a row on, oldest first",
    );
    std::test::assert_eq_str(
        ids(s.usage_after(1, 1) or st::UsageRows { }),
        "u2",
        label + ": for at most a limit",
    );
    std::test::assert_eq_str(
        ids(s.usage_after(3, 10) or st::UsageRows { }),
        "",
        label + ": nothing past the last",
    );

    let by_project = s.usage_summary(st::UsageSummaryQuery { by: names("project", "") })
    or st::UsageGroups { };
    std::test::assert_eq_int(count(by_project.rows), 2, label + ": two projects");
    let work = at(by_project.rows, 1) or st::UsageGroup { };
    std::test::assert_eq_str(
        work.group,
        "{\"project\": \"work\"}",
        label + ": a group is its fields, the most recently active first",
    );
    std::test::assert(
        work.requests == 2 && work.input_tokens == 30 && work.output_tokens == 11
            && work.price_micros == 300 && work.currency == "USD",
        label + ": totals of a group",
    );
    let play = at(by_project.rows, 0) or st::UsageGroup { };
    std::test::assert(play.requests == 1 && play.price_micros == 5, label + ": and of the next");
    let by_day = s.usage_summary(
        st::UsageSummaryQuery { by: names("day", "") },
    ) or st::UsageGroups { };
    std::test::assert_eq_int(count(by_day.rows), 2, label + ": two days");
    std::test::assert_eq_str(
        (at(by_day.rows, 1) or st::UsageGroup { }).group,
        "{\"day\": \"2026-10-17T00:00:00Z\"}",
        label + ": a day is its start",
    );
    let by_hour = s.usage_summary(
        st::UsageSummaryQuery { by: names("hour", "") },
    ) or st::UsageGroups { };
    std::test::assert_eq_str(
        (at(by_hour.rows, 1) or st::UsageGroup { }).group,
        "{\"hour\": \"2026-10-17T10:00:00Z\"}",
        label + ": and an hour",
    );
    let two = s.usage_summary(
        st::UsageSummaryQuery {
            by: names("node", "seat"),
            q: st::UsageQuery { project: "work" },
        },
    ) or st::UsageGroups { };
    std::test::assert_eq_int(count(two.rows), 1, label + ": filtered, then grouped");
    std::test::assert_eq_str(
        (at(two.rows, 0) or st::UsageGroup { }).group,
        "{\"node\": \"laptop\", \"seat\": \"laptop/static\"}",
        label + ": by two fields",
    );
    let turns = s.usage_summary(st::UsageSummaryQuery { by: names("conversation", "") })
    or st::UsageGroups { };
    std::test::assert_eq_int(
        count(turns.rows),
        2,
        label + ": a conversation, and requests of none",
    );
    let c1 = at(turns.rows, 1) or st::UsageGroup { };
    std::test::assert(
        c1.group == "{\"conversation\": \"c1\"}" && c1.requests == 2 && c1.input_tokens == 30,
        label + ": a conversation's turns, summed",
    );
    std::test::assert(
        std::time::iso8601(c1.first_at) == "2026-10-17T10:15:00Z"
            && std::time::iso8601(c1.last_at) == "2026-10-17T10:45:00Z" && c1.last_request == "u2",
        label + ": from its first turn to its last, the last named: "
            + std::time::iso8601(c1.first_at) + " " + std::time::iso8601(c1.last_at) + " "
            + c1.last_request,
    );
    std::test::assert_eq_str(
        (at(turns.rows, 0) or st::UsageGroup { }).group,
        "{\"conversation\": \"\"}",
        label + ": requests of no conversation, together",
    );
    let bad = s.usage_summary(st::UsageSummaryQuery { by: names("colour", "") })
    or st::UsageGroups { };
    std::test::assert_eq_int(
        count(bad.rows),
        0,
        label + ": a field it does not group by is refused",
    );
}

/// A request of `conversation` ("" for none) that ended as `status`.
fn turn(
    id: String,
    when: String,
    key: String,
    model: String,
    status: String,
    conversation: String,
    input: Int,
    cached: Int,
    output: Int,
    price: Int
) -> st::UsageRow {
    return st::UsageRow {
        id: id,
        created_at: t(when),
        project: if key == "k3" { "play" } else { "convo" },
        key: key,
        requested_model: model,
        served_model: if status == "served" { model } else { "" },
        status: status,
        input_tokens: input,
        cached_input_tokens: cached,
        output_tokens: output,
        reasoning_tokens: if status == "served" { 1 } else { 0 },
        price_micros: price,
        served: if status == "served" { "{\"model\": \"" + model + "\"}" } else { "null" },
        record: "{\"id\": \"" + id + "\", \"status\": \"" + status + "\", \"conversation\": "
            + (if len(conversation) > 0 { "\"" + conversation + "\"" } else { "null" }) + "}"
    };
}

fn conversation_ids(r: st::ConversationRows) -> String {
    let mut out = "";
    for c in r.rows {
        out = out + (if len(out) > 0 { " " } else { "" }) + c.conversation;
    }
    return out;
}

fn joined(n: st::Names) -> String {
    let mut out = "";
    for x in n.items {
        out = out + (if len(out) > 0 { " " } else { "" }) + x;
    }
    return out;
}

/// The ledger by how its requests ended, and its conversations: each one's
/// turns summed, the most recently active first, filtered and paged.
fn conversations(s: st::Store, label: String) {
    s.insert_project(
        st::ProjectRow { id: "convo", name: "Convo", created_at: std::time::current() },
        ch("create", "projects/convo"),
    ) or discard;
    s.insert_usage(turn("a1", "2026-10-17T10:00:00Z", "k1", "m1", "served", "ca", 10, 4, 2, 10))
    or discard;
    s.insert_usage(turn("a2", "2026-10-17T10:05:00Z", "k2", "m2", "failed", "cb", 5, 0, 0, 0))
    or discard;
    s.insert_usage(turn("a3", "2026-10-17T10:10:00Z", "k1", "m2", "served", "ca", 20, 0, 3, 20))
    or discard;
    s.insert_usage(turn("a4", "2026-10-17T10:15:00Z", "k1", "m1", "served", "", 1, 0, 1, 1))
    or discard;
    s.insert_usage(turn("a5", "2026-10-17T10:20:00Z", "k3", "m1", "cancelled", "cc", 7, 0, 0, 0))
    or discard;
    std::test::assert_eq_str(
        ids(s.usage_rows(st::UsageQuery { status: "failed" }) or st::UsageRows { }),
        "a2",
        label + ": by how a request ended",
    );
    std::test::assert_eq_str(
        ids(s.usage_rows(st::UsageQuery { status: "served" }) or st::UsageRows { }),
        "a4 a3 a1",
        label + ": each one so",
    );
    std::test::assert_eq_str(
        ids(
            s.usage_rows(st::UsageQuery { status: "served", key: "k2" }) or st::UsageRows { },
        ),
        "",
        label + ": and by the other filters too",
    );
    let all = s.usage_conversations(st::ConversationQuery { }) or st::ConversationRows { };
    std::test::assert_eq_str(
        conversation_ids(all),
        "cc ca cb",
        label + ": conversations, the most recently active first, a request of none in none",
    );
    let ca = at(all.rows, 1) or st::ConversationRow { };
    std::test::assert(
        ca.project == "convo" && ca.requests == 2 && ca.failed == 0 && ca.input_tokens == 30
            && ca.cached_input_tokens == 4 && ca.output_tokens == 5 && ca.reasoning_tokens == 2
            && ca.price_micros == 30 && ca.currency == "USD",
        label + ": a conversation's turns, summed",
    );
    std::test::assert(
        joined(ca.keys) == "k1" && joined(ca.models) == "m1 m2",
        label + ": its keys and models, each once, in order: " + joined(ca.keys) + " / "
            + joined(ca.models),
    );
    std::test::assert(
        std::time::iso8601(ca.first_at) == "2026-10-17T10:00:00Z"
            && std::time::iso8601(ca.last_at) == "2026-10-17T10:10:00Z" && ca.last_request == "a3"
            && ca.last_status == "served",
        label + ": from its first turn to its last, the last named and how it ended",
    );
    let cb = at(all.rows, 2) or st::ConversationRow { };
    std::test::assert(
        cb.failed == 1 && cb.last_status == "failed",
        label + ": a failed turn counted",
    );
    std::test::assert_eq_str(
        conversation_ids(
            s.usage_conversations(st::ConversationQuery { has_failures: true })
            or st::ConversationRows { },
        ),
        "cc cb",
        label + ": those with a failed turn, a cancelled one among them",
    );
    let page = s.usage_conversations(
        st::ConversationQuery { limit: 1 },
    ) or st::ConversationRows { };
    std::test::assert(
        conversation_ids(page) == "cc" && page.more,
        label + ": a page says there is more",
    );
    let cc = at(page.rows, 0) or st::ConversationRow { };
    std::test::assert_eq_str(
        conversation_ids(
            s.usage_conversations(st::ConversationQuery { cursor: cc.last_seq })
            or st::ConversationRows { },
        ),
        "ca cb",
        label + ": and the next goes on from its last",
    );
    std::test::assert_eq_str(
        conversation_ids(
            s.usage_conversations(st::ConversationQuery { q: st::UsageQuery { project: "convo" } })
            or st::ConversationRows { },
        ),
        "ca cb",
        label + ": by project",
    );
    let served = s.usage_conversations(
        st::ConversationQuery { q: st::UsageQuery { status: "served" } },
    ) or st::ConversationRows { };
    std::test::assert(
        conversation_ids(served) == "ca"
            && (at(served.rows, 0) or st::ConversationRow { }).requests == 2,
        label + ": of the requests that ended so",
    );
    let m2 = s.usage_conversations(st::ConversationQuery { q: st::UsageQuery { model: "m2" } })
    or st::ConversationRows { };
    std::test::assert(
        conversation_ids(m2) == "ca cb"
            && (at(m2.rows, 0) or st::ConversationRow { }).requests == 1,
        label + ": summed over the requests the filters keep",
    );
    std::test::assert_eq_str(
        conversation_ids(
            s.usage_conversations(
                st::ConversationQuery {
                    q: st::UsageQuery { has_to: true, to: t("2026-10-17T10:07:00Z") },
                },
            ) or st::ConversationRows { },
        ),
        "cb ca",
        label + ": and in a time range, by their latest turn in it",
    );
}

/// The operator token: none until one is kept, then the first one kept,
/// whatever a later api mints.
/// A project is made with its own system key, which no token names; the
/// requests voice makes for it are left out of its usage unless asked for.
fn system(s: st::Store, label: String) {
    s.insert_project(
        st::ProjectRow { id: "sysk", name: "Sysk", created_at: std::time::current() },
        ch("create", "projects/sysk"),
    ) or discard;
    let k = s.key(st::system_key("sysk")) or st::KeyRow { };
    std::test::assert(
        k.present && k.internal && k.project == "sysk" && k.name == "sysk-system",
        label + ": a project's system key, made with it",
    );
    let none = s.key_by_digest("") or st::KeyRow { };
    std::test::assert(!none.present, label + ": which no token names");
    let listed = s.keys("sysk") or st::KeyRows { };
    std::test::assert_eq_int(count(listed.rows), 1, label + ": listed with its keys");
    // its usage, apart
    s.insert_usage(
        st::UsageRow {
            id: "u_caller",
            project: "sysk",
            key: "k_caller",
            status: "served",
            created_at: std::time::current(),
            record: "{}",
        },
    ) or discard;
    s.insert_usage(
        st::UsageRow {
            id: "u_voice",
            project: "sysk",
            key: "sysk-system",
            status: "served",
            created_at: std::time::current(),
            record: "{}",
        },
    ) or discard;
    let theirs = s.usage_rows(st::UsageQuery { project: "sysk" }) or st::UsageRows { };
    std::test::assert_eq_int(
        count(theirs.rows),
        1,
        label + ": a project's usage leaves voice's out",
    );
    let all = s.usage_rows(
        st::UsageQuery { project: "sysk", include_internal: true },
    ) or st::UsageRows { };
    std::test::assert_eq_int(count(all.rows), 2, label + ": unless asked for");
    let mut by = st::Names { };
    push(by.items, "internal") or discard;
    let split = s.usage_summary(
        st::UsageSummaryQuery {
            by: by,
            q: st::UsageQuery { project: "sysk", include_internal: true },
        },
    ) or st::UsageGroups { };
    std::test::assert_eq_int(count(split.rows), 2, label + ": grouped by internal, a line each");
    let by_key = s.usage_rows(st::UsageQuery { key: "sysk-system" }) or st::UsageRows { };
    std::test::assert_eq_int(count(by_key.rows), 1, label + ": or its key is");
}

/// Recordings listed a page at a time: a quiet model's found behind a busy
/// one's, and a walk past one page with none twice and none skipped.
/// Recorded two to a second, from an hour ago: storing one drops those past
/// PEEK_DAYS, and within a second they list by request id.
fn peeks(s: st::Store, label: String) {
    s.insert_project(
        st::ProjectRow { id: "peeky", name: "Peeky" },
        ch("create", "projects/peeky"),
    ) or discard;
    let base = std::time::unix(std::time::current()) - 3600;
    let mut i = 0;
    while i < 60 {
        s.put_peek(
            st::PeekRow {
                request_id: peek_id(i),
                project: "peeky",
                key: "k_peek",
                model: if i % 12 == 0 { "quiet" } else { "busy" },
                created_at: std::time::time_from_unix(base + i / 2),
                input: "{}",
                output: "{}",
            },
        ) or discard;
        i = i + 1;
    }
    let quiet = s.peeks(st::PeekQuery { project: "peeky", model: "quiet", limit: 40 })
    or st::PeekRows { };
    std::test::assert_eq_int(
        count(quiet.rows),
        5,
        label + ": a quiet model's, past the busy one's",
    );
    std::test::assert(!quiet.more, label + ": all of them on one page");
    for r in quiet.rows {
        std::test::assert_eq_str(r.model, "quiet", label + ": only that model's");
        std::test::assert_eq_str(r.input, "", label + ": listed without its body");
    }
    std::test::assert_eq_str(
        (at(quiet.rows, 0) or st::PeekRow { }).request_id,
        "pk_48",
        label + ": newest first",
    );
    // every recording, 40 a page: in order, none twice, none skipped
    let mut seen = 0;
    let mut cursor = "";
    let mut pages = 0;
    let mut more = true;
    while more && pages < 10 {
        let page = s.peeks(st::PeekQuery { project: "peeky", cursor: cursor, limit: 40 })
        or st::PeekRows { };
        std::test::assert(page.cursor_known, label + ": a page's last names a recording");
        for r in page.rows {
            std::test::assert_eq_str(
                r.request_id,
                peek_id(walked(seen)),
                label + ": the next in order",
            );
            seen = seen + 1;
            cursor = r.request_id;
        }
        more = page.more;
        pages = pages + 1;
    }
    std::test::assert_eq_int(seen, 60, label + ": every recording walked");
    std::test::assert_eq_int(pages, 2, label + ": on two pages of 40");
    // a model's, 7 a page: only its own, in order
    let mut busy = 0;
    let mut last = "";
    more = true;
    pages = 0;
    while more && pages < 20 {
        let page = s.peeks(st::PeekQuery { model: "busy", cursor: last, limit: 7 })
        or st::PeekRows { };
        for r in page.rows {
            std::test::assert_eq_str(
                r.model,
                "busy",
                label + ": a model's pages hold only its own",
            );
            busy = busy + 1;
            last = r.request_id;
        }
        more = page.more;
        pages = pages + 1;
    }
    std::test::assert_eq_int(busy, 55, label + ": a model's, every one walked");
    std::test::assert_eq_int(pages, 8, label + ": on eight pages of 7");
    let lost = s.peeks(st::PeekQuery { cursor: "pk_none" }) or st::PeekRows { };
    std::test::assert(
        !lost.cursor_known && count(lost.rows) == 0,
        label + ": a cursor naming no recording",
    );
}

/// The `n`th recording `peeks` stores, its request id sorting as its number.
fn peek_id(n: Int) -> String {
    return if n < 10 { "pk_0" + to_string(n) } else { "pk_" + to_string(n) };
}

/// Which of `peeks`' recordings lists `j`th: two to a second, newest first,
/// by request id within one.
fn walked(j: Int) -> Int {
    return 2 * (29 - j / 2) + j % 2;
}

fn operator(s: st::Store, label: String) {
    std::test::assert_eq_str(s.operator_token("") or "?", "", label + ": none kept yet");
    std::test::assert_eq_str(s.operator_token("va-one") or "", "va-one", label + ": kept");
    std::test::assert_eq_str(
        s.operator_token("va-two") or "",
        "va-one",
        label + ": a second api reads the first one's",
    );
    std::test::assert_eq_str(
        s.operator_token("") or "",
        "va-one",
        label + ": and so does a reader",
    );
}

/// The hosted tools' settings (migration 36): none until set, then the last
/// set, each write a change.
fn tools(s: st::Store, label: String) {
    std::test::assert_eq_str(s.tool_settings() or "?", "", label + ": none set yet");
    s.put_tool_settings("{\"web_fetch\": {\"enabled\": false}}", ch("create", "tools")) or {
        std::test::assert(false, label + ": settings kept: " + err.message);
    };
    s.put_tool_settings(
        "{\"web_fetch\": {\"enabled\": true, \"denylist\": [\"192.0.2.0/24\"]}}",
        ch("update", "tools"),
    ) or {
        std::test::assert(false, label + ": settings replaced: " + err.message);
    };
    let kept = s.tool_settings() or "";
    std::test::assert(
        std::str::contains(kept, "192.0.2.0/24") && std::str::contains(kept, "true"),
        label + ": the last set: " + kept,
    );
    let logged = s.changes(st::ChangeQuery { target: "tools" }) or st::ChangeRows { };
    std::test::assert_eq_int(count(logged.rows), 2, label + ": each write a change");
}

/// More groups than a summary answers: the most recently active are kept.
fn crowded(s: st::Store, label: String) {
    let mut i = 0;
    while i < 1002 {
        s.insert_usage(
            spent(
                "c" + to_string(i),
                "2026-10-20T10:00:00Z",
                "crowd",
                "k" + to_string(i),
                "echo-1",
                "laptop",
                "static",
                1,
                1,
                0,
            ),
        )
        or discard;
        i = i + 1;
    }
    let g = s.usage_summary(
        st::UsageSummaryQuery { by: names("key", ""), q: st::UsageQuery { project: "crowd" } },
    ) or st::UsageGroups { };
    std::test::assert_eq_int(count(g.rows), 1000, label + ": at most 1000 groups");
    std::test::assert_eq_str(
        (at(g.rows, 0) or st::UsageGroup { }).group,
        "{\"key\": \"k1001\"}",
        label + ": the newest first",
    );
    std::test::assert_eq_str(
        (at(g.rows, 999) or st::UsageGroup { }).group,
        "{\"key\": \"k2\"}",
        label + ": the least recent left out",
    );
}

/// A link check between two nodes: kept with both nodes' assignments moved
/// on, and each rank's result written into its own column once, so two
/// reporting at once both keep theirs.
fn links(s: st::Store, label: String) {
    let at = `2026-11-03T00:00:00Z`;
    s.insert_node(
        st::NodeRow { id: "node-a", name: "node-a", token_digest: "aa01", created_at: at },
        ch("create", "nodes/node-a"),
    )
    or discard;
    s.insert_node(
        st::NodeRow { id: "node-b", name: "node-b", token_digest: "aa02", created_at: at },
        ch("create", "nodes/node-b"),
    )
    or discard;
    let before = (s.node("node-b") or st::NodeRow { }).assignment_version;
    s.insert_link_check(
        st::LinkCheckRow {
            id: "lc-1",
            node_a: "node-a",
            node_b: "node-b",
            created_at: at,
            master_addr: "198.51.100.1",
            image: "nvcr.io/nvidia/vllm@sha256:5577",
        },
    ) or discard;
    std::test::assert_eq_int(
        (s.node("node-b") or st::NodeRow { }).assignment_version,
        before + 1,
        label + ": a check moves its nodes' assignments on",
    );
    // rank 1 reports first, then rank 0, each from what it read before
    std::test::assert(
        s.put_link_result("lc-1", "node-b", "{\"ok\": true}") or false,
        label + ": rank 1's result",
    );
    std::test::assert(
        s.put_link_result("lc-1", "node-a", "{\"ok\": false}") or false,
        label + ": rank 0's",
    );
    std::test::assert(
        !(s.put_link_result("lc-1", "node-a", "{\"ok\": true}") or true),
        label + ": a rank's first result stands",
    );
    std::test::assert(
        !(s.put_link_result("lc-1", "laptop", "{\"ok\": true}") or true),
        label + ": a node with no rank writes nothing",
    );
    let rows = s.link_checks() or st::LinkCheckRows { };
    let r = at(rows.rows, 0) or st::LinkCheckRow { };
    std::test::assert(
        r.id == "lc-1" && r.master_addr == "198.51.100.1"
            && std::str::contains(r.result_a, "false") && std::str::contains(r.result_b, "true"),
        label + ": both ranks' results are kept, each its own: " + r.result_a + " " + r.result_b,
    );
}

/// What a node's store holds, kept whole as it reported it, and replaced
/// by its next report: a frontier model's hundreds of files and more, at
/// the protocol's bound.
fn inventories(s: st::Store, label: String) {
    let at = `2026-11-05T00:00:00Z`;
    s.insert_node(
        st::NodeRow { id: "node-a", name: "node-a", token_digest: "ab01", created_at: at },
        ch("create", "nodes/node-a"),
    )
    or discard;
    std::test::assert(
        !(s.inventory("node-a") or st::InventoryRow { present: true }).present,
        label + ": nothing until the node reports",
    );
    // 4096 files, the most a node reports: about 300 KiB
    let mut blobs = "";
    let mut i = 0;
    while i < 4096 {
        blobs = blobs + std::str::pad_left(to_string(i), 64, "0") + " "
            + to_string(1000000000 + i) + "\n";
        i = i + 1;
    }
    // their sizes together, past what an int4 holds
    let total = 4096 * 1000000000 + 4095 * 4096 / 2;
    s.put_inventory(
        st::InventoryRow {
            node: "node-a",
            blobs: blobs,
            files: 4096,
            bytes: total,
            reported_at: at,
        },
    ) or discard;
    let got = s.inventory("node-a") or st::InventoryRow { };
    std::test::assert(got.present && got.node == "node-a", label + ": the report is kept");
    std::test::assert_eq_int(len(got.blobs), len(blobs), label + ": whole");
    std::test::assert(got.blobs == blobs, label + ": as reported");
    std::test::assert(got.files == 4096 && got.bytes == total, label + ": with its totals");
    let short = s.inventory_summary("node-a") or st::InventoryRow { };
    std::test::assert(
        short.present && len(short.blobs) == 0 && short.files == 4096 && short.bytes == total
            && std::time::iso8601(short.reported_at) == std::time::iso8601(at),
        label + ": its summary, without the files",
    );
    std::test::assert(
        !(s.inventory_summary("node-b") or st::InventoryRow { present: true }).present,
        label + ": none for a node that never reported",
    );
    std::test::assert_eq_str(
        std::time::iso8601(got.reported_at),
        std::time::iso8601(at),
        label + ": with when",
    );
    let later = `2026-11-05T01:00:00Z`;
    s.put_inventory(
        st::InventoryRow {
            node: "node-a",
            blobs: std::str::repeat("a", 64) + " 7\n",
            files: 1,
            bytes: 7,
            reported_at: later,
        },
    ) or discard;
    let next = s.inventory("node-a") or st::InventoryRow { };
    std::test::assert(
        next.blobs == std::str::repeat("a", 64) + " 7\n" && next.files == 1 && next.bytes == 7
            && std::time::iso8601(next.reported_at) == std::time::iso8601(later),
        label + ": the next report replaces it",
    );
    s.put_inventory(st::InventoryRow { node: "node-a", blobs: "", reported_at: later }) or discard;
    let none = s.inventory("node-a") or st::InventoryRow { };
    std::test::assert(none.present && len(none.blobs) == 0, label + ": an empty store is a report");
}

/// A request in flight reads back as it was put, the conversation it is a
/// turn of with it, and one of none as none; a later attempt (put again)
/// keeps its conversation, and a landed one is gone. One asked by a name its
/// project gives a model keeps that name.
fn flights(s: st::Store, label: String) {
    let now = std::time::current();
    s.put_flight(
        st::FlightRow {
            request_id: "resp_f1",
            project: "work",
            key: "k1",
            model: "echo",
            seat: "n1/s1",
            account: "a1",
            started_at: now,
            instance: "api-1",
            conversation: "conv-7",
            alias: "coding",
        },
    ) or discard;
    s.put_flight(
        st::FlightRow {
            request_id: "resp_f2",
            project: "work",
            key: "k1",
            model: "echo",
            seat: "n1/s2",
            account: "a1",
            started_at: now,
        },
    ) or discard;
    let all = s.flights_after(0, 100) or st::FlightRows { };
    let mut turn = st::FlightRow { };
    let mut alone = st::FlightRow { conversation: "unread" };
    for f in all.rows {
        if f.request_id == "resp_f1" { turn = f; }
        if f.request_id == "resp_f2" { alone = f; }
    }
    std::test::assert_eq_str(
        turn.conversation,
        "conv-7",
        label + ": a flight's conversation reads back",
    );
    std::test::assert_eq_str(turn.instance, "api-1", label + ": with its instance");
    std::test::assert_eq_str(
        turn.alias,
        "coding",
        label + ": and the name it asked for its model by",
    );
    std::test::assert_eq_str(
        alone.alias,
        "",
        label + ": a flight that named its model has no alias",
    );
    std::test::assert_eq_str(alone.conversation, "", label + ": a flight of none has none");
    // its next attempt, on another seat
    s.put_flight(
        st::FlightRow {
            request_id: "resp_f1",
            project: "work",
            key: "k1",
            model: "echo",
            seat: "n2/s1",
            account: "a1",
            started_at: now,
            instance: "api-1",
            conversation: "conv-7",
        },
    ) or discard;
    let again = s.flights_after(turn.seq, 100) or st::FlightRows { };
    let mut moved = st::FlightRow { };
    for f in again.rows {
        if f.request_id == "resp_f1" { moved = f; }
    }
    std::test::assert(
        moved.seat == "n2/s1" && moved.conversation == "conv-7",
        label + ": its next attempt is told, its conversation kept",
    );
    s.drop_flight("resp_f1") or discard;
    s.drop_flight("resp_f2") or discard;
    let left = s.flights_after(0, 100) or st::FlightRows { };
    std::test::assert_eq_int(count(left.rows), 0, label + ": landed, none is in flight");
}

/// A ledger row as the api writes one (api/usage.hl `usage_row`): `model`
/// served it unless "", else `asked` was asked for and none served; an
/// input the seat did not report is voice's estimate, 0 in the columns.
fn ended(
    id: String,
    when: String,
    project: String,
    key: String,
    asked: String,
    model: String,
    status: String,
    input: Int,
    cached: Int,
    output: Int,
    reasoning: Int,
    price: Int,
    currency: String
) -> st::UsageRow {
    return st::UsageRow {
        id: id,
        created_at: t(when),
        project: project,
        key: key,
        requested_model: asked,
        served_model: model,
        status: status,
        input_tokens: input,
        cached_input_tokens: cached,
        output_tokens: output,
        reasoning_tokens: reasoning,
        price_micros: price,
        currency: currency,
        served: if len(model) > 0 { "{\"model\": \"" + model + "\"}" } else { "null" },
        record: "{\"id\": \"" + id + "\", \"input_tokens_estimated\": "
            + (if input == 0 && status != "served" { "true" } else { "false" }) + "}"
    };
}

/// Totals as text: each group's values of `fields`, its currency and its
/// sums, in the order read.
fn totals_said(r: st::UsageTotals, fields: st::Names) -> String {
    let mut out = "";
    for x in r.rows {
        let mut g = "";
        for f in fields.items {
            g = g + (if len(g) > 0 { "/" } else { "" }) + std::json::find_string_field(x.group, f);
        }
        out = out + (if len(out) > 0 { "; " } else { "" }) + g + " " + x.currency + " "
            + to_string(x.requests) + " " + to_string(x.failed) + " " + to_string(x.input_tokens)
            + " " + to_string(x.cached_input_tokens) + " " + to_string(x.output_tokens) + " "
            + to_string(x.reasoning_tokens) + " " + to_string(x.price_micros);
    }
    return out;
}

/// True when totals grouped by `by` are refused as invalid.
fn refused_total(s: st::Store, by: String) -> Bool {
    s.usage_totals(st::UsageTotalsQuery { by: names(by, "") }) or { return err.kind == "invalid"; };
    return false;
}

/// The hourly rollup (migration 40): each row the ledger takes is added to
/// its project's, key's, model's and currency's hour as it is written,
/// once; totals over a range are to the hour, count failures among the
/// requests and estimates in no token sum, leave a project's system key out
/// unless asked, and are what a scan of the ledger sums.
fn rollup(s: st::Store, label: String) {
    let w = "2026-11-02T";
    s.insert_usage(
        ended(
            "r1",
            w + "10:05:00Z",
            "work",
            "k1",
            "fast",
            "qwen",
            "served",
            100,
            40,
            10,
            3,
            1000,
            "USD",
        ),
    ) or discard;
    s.insert_usage(
        ended(
            "r2",
            w + "10:55:00Z",
            "work",
            "k1",
            "fast",
            "qwen",
            "incomplete",
            50,
            0,
            5,
            0,
            500,
            "USD",
        ),
    ) or discard;
    // failed with no seat: the model asked for, an estimated input (0)
    s.insert_usage(
        ended("r3", w + "10:30:00Z", "work", "k1", "fast", "", "no_capacity", 0, 0, 0, 0, 0, "USD"),
    ) or discard;
    // failed after a seat took it: its input estimated, its output reported
    s.insert_usage(
        ended("r4", w + "11:10:00Z", "work", "k2", "big", "dsv4", "failed", 0, 0, 7, 2, 70, "USD"),
    ) or discard;
    s.insert_usage(
        ended("r5", w + "12:00:00Z", "work", "k2", "big", "dsv4", "served", 9, 1, 1, 0, 90, "EUR"),
    ) or discard;
    s.insert_usage(
        ended("r6", w + "11:20:00Z", "play", "k3", "fast", "qwen", "served", 1, 0, 1, 0, 1, "USD"),
    ) or discard;
    // voice's own request for work, under its system key
    s.insert_usage(
        ended(
            "r7",
            w + "10:40:00Z",
            "work",
            "work-system",
            "decide",
            "qwen",
            "served",
            30,
            0,
            3,
            0,
            300,
            "USD",
        ),
    ) or discard;
    // a row the ledger has is not counted again
    s.insert_usage(
        ended(
            "r1",
            w + "10:05:00Z",
            "work",
            "k1",
            "fast",
            "qwen",
            "served",
            100,
            40,
            10,
            3,
            1000,
            "USD",
        ),
    ) or discard;

    let projects = names("project", "");
    std::test::assert_eq_str(
        totals_said(
            s.usage_totals(st::UsageTotalsQuery { by: projects }) or st::UsageTotals { },
            projects,
        ),
        "play USD 1 0 1 0 1 0 1; work EUR 1 0 9 1 1 0 90; work USD 4 2 150 40 22 5 1570",
        label
            + ": by project and currency, failures among the requests, estimates in no sum, the system key's left out",
    );
    std::test::assert_eq_str(
        totals_said(
            s.usage_totals(
                st::UsageTotalsQuery { by: projects, project: "work", include_internal: true },
            ) or st::UsageTotals { },
            projects,
        ),
        "work EUR 1 0 9 1 1 0 90; work USD 5 2 180 40 25 5 1870",
        label + ": the system key's too, asked for",
    );
    let km = names("key", "model");
    std::test::assert_eq_str(
        totals_said(
            s.usage_totals(st::UsageTotalsQuery { by: km, project: "work" }) or st::UsageTotals { },
            km,
        ),
        "k1/fast USD 1 1 0 0 0 0 0; k1/qwen USD 2 0 150 40 15 3 1500; k2/dsv4 EUR 1 0 9 1 1 0 90; k2/dsv4 USD 1 1 0 0 7 2 70",
        label + ": by key and model, the model that served, else the one asked for",
    );
    std::test::assert_eq_str(
        totals_said(
            s.usage_totals(
                st::UsageTotalsQuery { by: km, key: "work-system" },
            ) or st::UsageTotals { },
            km,
        ),
        "work-system/qwen USD 1 0 30 0 3 0 300",
        label + ": a system key named is its own",
    );
    std::test::assert_eq_str(
        totals_said(
            s.usage_totals(
                st::UsageTotalsQuery { by: projects, model: "fast" },
            ) or st::UsageTotals { },
            projects,
        ),
        "work USD 1 1 0 0 0 0 0",
        label + ": a model filter names the model that served, else the one asked for",
    );
    // a range is widened to whole hours: from 10:59 counts 10:00 to 10:59,
    // to 11:00 counts the hour that starts then
    std::test::assert_eq_str(
        totals_said(
            s.usage_totals(
                st::UsageTotalsQuery {
                    by: projects,
                    has_from: true,
                    from: t(w + "10:59:00Z"),
                    has_to: true,
                    to: t(w + "11:00:00Z")
                },
            ) or st::UsageTotals { },
            projects,
        ),
        "play USD 1 0 1 0 1 0 1; work USD 4 2 150 40 22 5 1570",
        label + ": to the hour, from the one holding from to the one holding to",
    );
    std::test::assert_eq_str(
        totals_said(
            s.usage_totals(
                st::UsageTotalsQuery { by: projects, has_from: true, from: t(w + "11:00:01Z") },
            ) or st::UsageTotals { },
            projects,
        ),
        "play USD 1 0 1 0 1 0 1; work EUR 1 0 9 1 1 0 90; work USD 1 1 0 0 7 2 70",
        label + ": an hour before the one holding from is not counted",
    );
    std::test::assert(
        refused_total(s, "account"),
        label + ": the totals group by project, key or model alone",
    );
    // what a scan of the ledger sums, group for group
    let summed = s.usage_summary(st::UsageSummaryQuery { by: projects }) or st::UsageGroups { };
    let totals = s.usage_totals(st::UsageTotalsQuery { by: projects }) or st::UsageTotals { };
    let mut same = count(summed.rows) == count(totals.rows);
    for g in summed.rows {
        let mut met = false;
        for x in totals.rows {
            if std::json::find_string_field(x.group, "project") == std::json::find_string_field(
                g.group,
                "project",
            )
                && x.currency == g.currency
            {
                met = x.requests == g.requests && x.input_tokens == g.input_tokens
                    && x.output_tokens == g.output_tokens && x.price_micros == g.price_micros;
            }
        }
        same = same && met;
    }
    std::test::assert(same, label + ": the totals are what a scan of the ledger sums");
}

/// 32 hex digits of the sha256 of `key`: a conversation as the store
/// keeps it.
fn hashed(key: String) -> String {
    return std::hex::encode(std::crypto::sha256(std::bytes::from_string(key)))[0..32];
}

/// The board (store.md, "The board"): none until the brain writes one;
/// then the last written, its version always above the one before, even
/// within one millisecond of the store's clock.
fn boards(s: st::Store, label: String) {
    std::test::assert_eq_str(s.board() or "?", "", label + ": no board until one is written");
    let first = s.put_board(
        "{\"models\": [{\"model\": \"echo-1\", \"shape\": \"m\"}], \"queues\": [], \"seats\": []}",
    ) or {
        std::test::assert(false, label + ": a board is written: " + err.message);
        return;
    };
    let read = s.board() or "";
    let models = std::json::array_first(std::json::find_field_raw(read, "models"));
    std::test::assert(
        first > 0 && std::json::find_int_field(read, "version") == first
            && std::str::ends_with(std::json::find_string_field(read, "at"), "Z")
            && std::json::find_string_field(models.element, "shape") == "m"
            && std::str::trim(std::json::find_field_raw(read, "queues")) == "[]",
        label + ": and reads back with its version and time: " + read,
    );
    let second = s.put_board(
        "{\"models\": [{\"model\": \"echo-1\", \"shape\": \"p\"}], \"queues\": [], \"seats\": []}",
    ) or 0;
    let again = s.board() or "";
    let changed = std::json::array_first(std::json::find_field_raw(again, "models"));
    std::test::assert(
        second > first && std::json::find_int_field(again, "version") == second
            && std::json::find_string_field(changed.element, "shape") == "p",
        label + ": a board written again replaces it, at a later version: "
            + to_string(first) + " then " + to_string(second),
    );
    let mut refused = "";
    s.put_board("[1]") or {
        refused = err.message;
        0
    };
    std::test::assert(len(refused) > 0, label + ": a board that is not an object is refused");
    std::test::assert(
        std::json::find_int_field(s.board() or "", "version") == second,
        label + ": and the board is as it was",
    );
}

/// Where a conversation is (store.md): the seat its last turn was granted
/// to, by the hash of its key.
fn conversation_seats(s: st::Store, label: String) {
    let c = hashed("conversation-1");
    let none = s.seat_conversation(c) or st::SeatConversationRow { present: true };
    std::test::assert(!none.present, label + ": a conversation no seat was granted is nowhere");
    s.put_seat_conversation(c, "spark/coder") or {
        std::test::assert(false, label + ": a conversation's seat is written: " + err.message);
        return;
    };
    let got = s.seat_conversation(c) or st::SeatConversationRow { };
    std::test::assert(
        got.present && got.conversation == c && got.seat == "spark/coder"
            && std::time::unix(got.at) > std::time::unix(std::time::current()) - 3600,
        label + ": and read back, with when: " + got.seat,
    );
    s.put_seat_conversation(c, "flare/coder") or discard;
    let moved = s.seat_conversation(c) or st::SeatConversationRow { };
    std::test::assert(
        moved.present && moved.seat == "flare/coder",
        label + ": its next turn granted elsewhere moves it: " + moved.seat,
    );
    let other = s.seat_conversation(hashed("conversation-2")) or st::SeatConversationRow { };
    std::test::assert(!other.present, label + ": another conversation is still nowhere");
    let mut refused = false;
    s.put_seat_conversation("conversation-1", "spark/coder") or { refused = true; };
    std::test::assert(refused, label + ": a key that is not a hash is refused");

    // a heartbeat corrects them: the seat's rows from before it go, but
    // for those its engine holds, which point at it
    let a = hashed("held-a");
    let b = hashed("held-b");
    let d = hashed("held-d");
    let e = hashed("held-e");
    s.put_seat_conversation(a, "spark/coder") or discard;
    s.put_seat_conversation(b, "spark/coder") or discard;
    s.put_seat_conversation(d, "mini/coder") or discard;
    std::time::sleep(20ms);
    let heard = std::time::current();
    std::time::sleep(20ms);
    // granted after the heartbeat was sent: kept, though not listed
    s.put_seat_conversation(e, "spark/coder") or discard;
    s.correct_seat_conversations("spark/coder", a + "\n" + d + "\n", heard) or {
        std::test::assert(false, label + ": a heartbeat corrects the rows: " + err.message);
    };
    std::test::assert(
        (s.seat_conversation(a) or st::SeatConversationRow { }).seat == "spark/coder",
        label + ": one it holds stays",
    );
    std::test::assert(
        !(s.seat_conversation(b) or st::SeatConversationRow { present: true }).present,
        label + ": one it no longer holds goes",
    );
    std::test::assert_eq_str(
        (s.seat_conversation(d) or st::SeatConversationRow { }).seat,
        "spark/coder",
        label + ": one it holds that pointed elsewhere points at it",
    );
    std::test::assert(
        (s.seat_conversation(e) or st::SeatConversationRow { }).seat == "spark/coder",
        label + ": one granted after the heartbeat stays",
    );
    s.correct_seat_conversations("mini/coder", "", heard) or discard;
    std::test::assert_eq_str(
        (s.seat_conversation(d) or st::SeatConversationRow { }).seat,
        "spark/coder",
        label + ": another seat's heartbeat leaves its rows alone",
    );
    // pruned by age
    let gone = s.prune_seat_conversations(
        std::time::from_nanos(std::time::nanos(std::time::current()) + 1000000000),
    ) or - 1;
    std::test::assert(gone >= 4, label + ": old rows pruned: " + to_string(gone));
    std::test::assert(
        !(s.seat_conversation(a) or st::SeatConversationRow { present: true }).present,
        label + ": and gone",
    );
}

/// The memory store keeps the newest conversations, the oldest forgotten
/// first.
fn conversations_kept() {
    let s = st::MemoryStore { };
    let mut i = 0;
    while i <= st::SEAT_CONVERSATIONS_KEPT {
        s.put_seat_conversation(hashed("c" + to_string(i)), "spark/coder") or discard;
        i = i + 1;
    }
    let oldest = s.seat_conversation(hashed("c0")) or st::SeatConversationRow { };
    let second = s.seat_conversation(hashed("c1")) or st::SeatConversationRow { };
    let newest = s.seat_conversation(
        hashed("c" + to_string(st::SEAT_CONVERSATIONS_KEPT)),
    ) or st::SeatConversationRow { };
    std::test::assert(
        !oldest.present && second.present && newest.present,
        "memory: past its most, the oldest conversation is forgotten",
    );
}

fn main() {
    std::test::assert_eq_str(
        st::parse_dsn("postgres://u:p@db:5433/v?sslmode=disable").problem,
        "",
        "a database URL",
    );
    std::test::assert(
        len(st::parse_dsn("postgres://u:p@db:54x3/v").problem) > 0,
        "a port that is not one is refused, not read as 5432",
    );
    std::test::assert(
        !std::str::contains(st::parse_dsn("postgres://u:p@db:54x3/v").problem, "54x3"),
        "without quoting the URL",
    );
    let at = st::parse_dsn("postgres://voice:p@ss@db:5433/voice");
    std::test::assert(
        at.host == "db" && at.port == 5433 && at.password == "p@ss" && at.user == "voice",
        "the credentials end at the last @",
    );
    let enc = st::parse_dsn("postgres://vo%69ce:p%40ss%2F1@db/my%20db?sslmode=disable");
    std::test::assert(
        enc.user == "voice"
            && enc.password == "p@ss/1"
            && enc.database == "my db"
            && enc.sslmode == "disable"
            && enc.port == 5432,
        "and are percent-decoded",
    );
    std::test::assert(
        !std::str::contains(st::redact("auth failed for voice with p@ss", at), "p@ss"),
        "an error never quotes the password",
    );
    // the habitat's DSN for a grafted heart: no password, its vault entry
    let habitat = st::parse_dsn(
        "postgres://heart_abc@127.0.0.1:5544/heart_abc?sslmode=disable&vault=postgres-heart_abc",
    );
    std::test::assert(
        habitat.problem == ""
            && habitat.user == "heart_abc"
            && habitat.password == ""
            && habitat.vault == "postgres-heart_abc"
            && habitat.database == "heart_abc"
            && habitat.sslmode == "disable"
            && habitat.port == 5544,
        "the habitat's DSN names its password's vault entry",
    );
    let first = st::parse_dsn("postgres://h@db/d?vault=postgres-h&sslmode=require");
    std::test::assert(first.vault == "postgres-h" && first.sslmode == "require", "in either order");
    std::test::assert(
        len(st::parse_dsn("postgres://h:pw@db/d?vault=postgres-h").problem) > 0,
        "a password and a vault entry both are refused",
    );
    std::test::assert_eq_str(
        st::database_or_habitat("postgres://u:p@db/v"),
        "postgres://u:p@db/v",
        "a database given is the one used",
    );
    // a new store has no retired system project, as a Postgres store
    // migrated from nothing has none (migration 34; scripts/upgrade.sh)
    let fresh = st::MemoryStore { };
    std::test::assert(
        !(fresh.project(st::RETIRED_SYSTEM_PROJECT) or st::ProjectRow { }).present
            && !(fresh.key(st::RETIRED_SYSTEM_PROJECT) or st::KeyRow { }).present
            && count((fresh.projects() or st::ProjectRows { }).rows) == 0,
        "memory: a new store holds no project, voice's retired one neither",
    );
    exercise(st::MemoryStore { }, "memory");
    ledger(st::MemoryStore { }, "memory");
    crowded(st::MemoryStore { }, "memory");
    conversations(st::MemoryStore { }, "memory");
    bounded(st::MemoryStore { }, "memory");
    operator(st::MemoryStore { }, "memory");
    tools(st::MemoryStore { }, "memory");
    system(st::MemoryStore { }, "memory");
    links(st::MemoryStore { }, "memory");
    inventories(st::MemoryStore { }, "memory");
    flights(st::MemoryStore { }, "memory");
    peeks(st::MemoryStore { }, "memory");
    rollup(st::MemoryStore { }, "memory");
    speeds(st::MemoryStore { }, "memory");
    boards(st::MemoryStore { }, "memory");
    conversation_seats(st::MemoryStore { }, "memory");
    conversations_kept();
    if !std::env::var_exists("VOICE_TEST_DATABASE_URL") { return; }
    let pg = st::PgStore { url: std::env::var("VOICE_TEST_DATABASE_URL") };
    std::test::assert(pg.ready(), "the test database answers");
    system(pg, "postgres");
    pg.conn.exec(
        "TRUNCATE usage, change, quota_window, seat_state, node_state, seat, node, \"limit\", budget, api_key, project, account, catalog_model, recipe, placement, runtime RESTART IDENTITY CASCADE",
    );
    exercise(pg, "postgres");
    pg.conn.exec("TRUNCATE usage RESTART IDENTITY");
    ledger(pg, "postgres");
    pg.conn.exec("TRUNCATE usage RESTART IDENTITY");
    crowded(pg, "postgres");
    pg.conn.exec("TRUNCATE usage RESTART IDENTITY");
    conversations(pg, "postgres");
    pg.conn.exec(
        "TRUNCATE usage, change, quota_window, seat_state, node_state, seat, node, \"limit\", budget, api_key, project, account, catalog_model, recipe, placement, runtime RESTART IDENTITY CASCADE",
    );
    bounded(pg, "postgres");
    pg.conn.exec("TRUNCATE operator_token");
    operator(pg, "postgres");
    pg.conn.exec("TRUNCATE tool_settings");
    pg.conn.exec("DELETE FROM change WHERE target = 'tools'");
    tools(pg, "postgres");
    pg.conn.exec("TRUNCATE link_check, seat, node RESTART IDENTITY CASCADE");
    links(pg, "postgres");
    pg.conn.exec("TRUNCATE node_inventory, link_check, seat, node RESTART IDENTITY CASCADE");
    inventories(pg, "postgres");
    pg.conn.exec("TRUNCATE in_flight RESTART IDENTITY");
    flights(pg, "postgres");
    pg.conn.exec("TRUNCATE peek");
    pg.conn.exec("DELETE FROM project WHERE id = 'peeky'");
    peeks(pg, "postgres");
    pg.conn.exec("TRUNCATE usage, usage_hourly RESTART IDENTITY");
    rollup(pg, "postgres");
    std::test::assert_eq_int(
        ledger_unlike_rollup(pg),
        0,
        "postgres: the rollup the trigger kept is a fresh sum of the ledger, hour for hour",
    );
    pg.conn.exec("TRUNCATE usage, usage_hourly, placement RESTART IDENTITY");
    speeds(pg, "postgres");
    pg.conn.exec("TRUNCATE board, seat_conversation");
    boards(pg, "postgres");
    conversation_seats(pg, "postgres");
}

/// A request seat `seat` served at `when`: `output` tokens, its first at
/// `first` ms and its end at `engine` ms (no first output when `first` is
/// below 0), voice's estimate of them when `estimated`.
fn decoded(
    id: String,
    when: String,
    seat: String,
    status: String,
    output: Int,
    first: Int,
    engine: Int,
    estimated: Bool
) -> st::UsageRow {
    let timing = "{\"wall_ms\": " + to_string(engine + 5) + ", \"queue_ms\": 0, \"load_ms\": 0"
        + (
            if first >= 0 {
                ", \"first_output_ms\": " + to_string(first) + ", \"engine_ms\": "
                    + to_string(engine)
            } else {
                ""
            }
        ) + "}";
    return st::UsageRow {
        id: id,
        created_at: t(when),
        project: "speedy",
        key: "k1",
        requested_model: "m",
        served_model: "m",
        node: seat[0..std::str::index_of(seat, "/")],
        seat: seat,
        status: status,
        output_tokens: output,
        served: "{\"model\": \"m\", \"node\": \"" + seat[0..std::str::index_of(seat, "/")]
            + "\", \"seat\": \"" + seat + "\", \"account\": \"local\"}",
        record: "{\"id\": \"" + id + "\", \"status\": \"" + status + "\", \"output_tokens\": "
            + to_string(output) + ", \"timing\": " + timing
            + (if estimated { ", \"output_tokens_estimated\": true" } else { "" }) + "}",
    };
}

fn speed_placement(
    s: st::Store,
    id: String,
    variant: String,
    nodes: String,
    seat: String,
    from: String,
    until: String
) {
    let body = "{\"id\": \"" + id + "\", \"recipe\": \"r\", \"variant\": \"" + variant
        + "\", \"nodes\": " + nodes + ", \"seat\": \"" + seat + "\"}";
    s.insert_placement(
        st::PlacementRow { id: id, model: "m", body: body, created_at: t(from) },
        ch("create", "placements/" + id),
    ) or discard;
    if len(until) > 0 {
        s.remove_placement(
            st::PlacementRow { id: id, removed_at: t(until) },
            ch("delete", "placements/" + id),
        ) or discard;
    }
}

/// What a placement's seat generated at (`decode_speeds`): its requests
/// served whole from the window's start and while it stood, its nodes in
/// byte order whichever leads, every placement of one variant on the same
/// nodes together; the median and quartiles as Postgres' percentile_disc
/// takes them.
fn speeds(s: st::Store, label: String) {
    // p0 stood until p1 took its place, the same variant on the same two
    // nodes led the other way; p2 was gone before the window
    speed_placement(
        s,
        "p0",
        "v",
        "[\"node-a\", \"node-b\"]",
        "node-a/p0",
        "2026-10-17T08:00:00Z",
        "2026-10-17T10:00:00Z",
    );
    speed_placement(
        s,
        "p1",
        "v",
        "[\"node-b\", \"node-a\"]",
        "node-b/p1",
        "2026-10-17T10:00:00Z",
        "",
    );
    speed_placement(
        s,
        "p2",
        "w",
        "[\"node-a\"]",
        "node-a/p2",
        "2026-10-17T07:00:00Z",
        "2026-10-17T08:00:00Z",
    );
    let rows = [
        // before the window
        decoded("s01", "2026-10-17T08:20:00Z", "node-a/p0", "served", 100, 0, 100, false),
        // p0's, in the window: 80 tok/s
        decoded("s02", "2026-10-17T09:00:00Z", "node-a/p0", "served", 80, 300, 1300, false),
        // on p0's seat after it was removed
        decoded("s03", "2026-10-17T10:30:00Z", "node-a/p0", "served", 100, 0, 100, false),
        // p1's: 100, 100, 50, 120 tok/s
        decoded("s04", "2026-10-17T10:10:00Z", "node-b/p1", "served", 100, 200, 1200, false),
        decoded("s05", "2026-10-17T10:20:00Z", "node-b/p1", "served", 300, 100, 3100, false),
        decoded("s06", "2026-10-17T10:40:00Z", "node-b/p1", "served", 50, 0, 1000, false),
        decoded("s07", "2026-10-17T10:50:00Z", "node-b/p1", "served", 120, 500, 1500, false),
        // not counted: cancelled, voice's estimate, too short, no first output
        decoded("s08", "2026-10-17T11:00:00Z", "node-b/p1", "cancelled", 100, 0, 100, false),
        decoded("s09", "2026-10-17T11:01:00Z", "node-b/p1", "served", 100, 0, 100, true),
        decoded("s10", "2026-10-17T11:02:00Z", "node-b/p1", "served", 10, 0, 10, false),
        decoded("s11", "2026-10-17T11:03:00Z", "node-b/p1", "served", 100, -1, 0, false),
        // p2's, gone before the window
        decoded("s12", "2026-10-17T07:30:00Z", "node-a/p2", "served", 100, 0, 1000, false),
    ];
    for r in rows {
        s.insert_usage(r) or discard;
    }
    let got = s.decode_speeds(
        st::DecodeSpeedQuery { since: t("2026-10-17T08:30:00Z"), min_output: 32, per_seat: 500 },
    ) or {
        std::test::assert(false, label + ": decode speeds: " + err.message);
        return;
    };
    let one = at(got.rows, 0) or st::DecodeSpeedRow { };
    std::test::assert(
        count(got.rows) == 1 && one.recipe == "r" && one.variant == "v"
            && one.nodes == "node-a\tnode-b",
        label + ": one group, p0's and p1's together, its nodes in order: "
            + to_string(count(got.rows)) + " " + one.variant + " " + one.nodes,
    );
    std::test::assert(
        one.requests == 5 && one.p25_tps == 80 && one.median_tps == 100 && one.p75_tps == 100,
        label + ": 50, 80, 100, 100 and 120 tok/s: " + to_string(one.requests) + " "
            + to_string(one.p25_tps) + " " + to_string(one.median_tps) + " "
            + to_string(one.p75_tps),
    );
    std::test::assert(
        std::time::iso8601(one.first_at) == "2026-10-17T09:00:00Z"
            && std::time::iso8601(one.last_at) == "2026-10-17T10:50:00Z",
        label + ": from the first counted to the last: " + std::time::iso8601(one.first_at) + " "
            + std::time::iso8601(one.last_at),
    );
    let few = s.decode_speeds(
        st::DecodeSpeedQuery { since: t("2026-10-17T08:30:00Z"), min_output: 32, per_seat: 2 },
    ) or st::DecodeSpeedRows { };
    let newest = at(few.rows, 0) or st::DecodeSpeedRow { };
    std::test::assert(
        newest.requests == 3 && newest.median_tps == 80,
        label + ": each seat's newest only (p0's 80, p1's 50 and 120): "
            + to_string(newest.requests) + " " + to_string(newest.median_tps),
    );
}

/// How many hours of the rollup differ from what the ledger sums to now,
/// either way: the sum migration 40's backfill takes.
fn ledger_unlike_rollup(pg: st::PgStore) -> Int {
    let fresh = "SELECT project, key, coalesce(served->>'model', requested_model) AS model, currency, date_trunc('hour', created_at, 'UTC') AS hour, count(*) AS requests, count(*) FILTER (WHERE status NOT IN ('served', 'incomplete')) AS failed_requests, sum(input_tokens) AS input_tokens, sum(cached_input_tokens) AS cached_input_tokens, sum(output_tokens) AS output_tokens, sum(reasoning_tokens) AS reasoning_tokens, sum(price_micros) AS price_micros FROM usage GROUP BY 1, 2, 3, 4, 5";
    let kept = "SELECT project, key, model, currency, hour, requests, failed_requests, input_tokens, cached_input_tokens, output_tokens, reasoning_tokens, price_micros FROM usage_hourly";
    let line = pg.row(
        "SELECT row_to_json(t) FROM (SELECT (SELECT count(*) FROM (" + fresh + " EXCEPT " + kept
            + ") a) + (SELECT count(*) FROM (" + kept + " EXCEPT " + fresh + ") b) AS n) t",
        db::Args { },
    ) or "";
    return if len(line) == 0 { -1 } else { std::json::find_int_field(line, "n") };
}

/// `h` hours after `base` (Unix seconds).
fn hours_after(base: Int, h: Int) -> Time {
    return std::time::time_from_unix(base + h * 3600);
}
