// CLI recipes on the admin plane (cli_recipes.hl): voice's own, from its
// files, listed read-only; the operator's created, edited, duplicated from
// voice's own, enabled and disabled, and removed while no seat names them,
// each checked by lib/harness with its refusal at the field at fault. A seat
// names a recipe voice has, with a backend of the kind it runs (a container,
// unless it opts in to the host); a disabled recipe's seats take no new
// attempt and say so; and the claim hands the node the seat's backend.
import ".." as api;
import "../../store" as st;

/// A link that publishes nothing: no node listens.
locus Quiet {
    fn place() -> String { return "nats://nats.test:4222"; }
    fn root() -> String { return "voice"; }
    fn assign(node: String, body: String) -> Bool { return true; }
    fn offer(node: String, request_id: String, reply_to: String, msg: Bytes) -> api::Offer {
        return Lost { };
    }
}

locus Lost {
    fn ack() -> api::ServeOutcome { return api::ServeOutcome { ack: "lost" }; }
    fn next(wait: Duration) -> api::LinkMsg { return api::LinkMsg { kind: "lost" }; }
    fn finish() { }
}

fn call(
    e: api::DataPlane,
    method: String,
    path: String,
    auth: String,
    body: String
) -> std::http::Response {
    return e.handle(
        std::http::Request {
            method: method,
            path: path,
            headers: "Authorization: Bearer " + auth + "\r\nContent-Type: application/json",
            body: body,
        },
    );
}

fn expect(r: std::http::Response, status: Int, what: String) {
    std::test::assert_eq_int(r.status, status, what + ": " + r.body);
}

fn str(body: String, name: String) -> String {
    return std::json::find_string_field(body, name);
}

/// The `error.param` of a refusal.
fn param_of(r: std::http::Response) -> String {
    return str(std::json::find_field_raw(r.body, "error"), "param");
}

fn shipped() -> String {
    let here = "harnesses";
    return api::shipped_harnesses(if std::io::fs::file_exists(here) { here } else { "../" + here });
}

/// An operator's recipe: `id`, run on the host alone, `install` its host
/// backend's install.
fn mine(id: String, install: String) -> String {
    return "{\"id\": " + api::jq(id)
        + ", \"name\": \"Mine\", \"version\": \"1.0.0\", \"backends\": [{\"kind\": \"host\", \"detect\": {\"command\": [\"mine\", \"--version\"], \"version\": \"mine ([0-9.]+)\"}, \"install\": {\"command\": "
        + install
        + "}}], \"command\": [\"mine\", \"--print\"], \"instruction\": {\"via\": \"stdin\"}, \"model\": {\"flag\": \"--model\"}, \"login\": {\"kind\": \"env\", \"env\": \"MINE_KEY\"}, \"env\": {}, \"reader\": \"text\", \"commits\": false, \"preamble\": \"Work in /work.\", \"egress\": [\"api.example\"]}";
}

const NPM: String = "[\"npm\", \"install\", \"--global\", \"--prefix\", \"$VOICE_CLI_PREFIX\", \"mine@1.0.0\"]";

const CAPS: String = "{\"engines\": [{\"id\": \"coding\", \"kind\": \"harness\", \"models\": null, \"config_schema\": {\"type\": \"object\", \"required\": [\"harness\"]}}]}";

const ASK: String = "{\"repo\": \"https://forge.example.com/team/app.git\", \"base\": \"main\", \"instruction\": \"add a test\", \"harness\": \"mine\", \"as\": {\"name\": \"Test Author\", \"email\": \"author@example.com\"}}";

fn seat(id: String, config: String) -> api::SeatCreate {
    let mut s = api::SeatCreate {
        node: "node-a",
        id: id,
        engine: "coding",
        account: "acct-a",
        config: std::json::Value::parse(config) or std::json::Value::null(),
    };
    push(s.serves, st::SeatModel { model: "mine-1" }) or discard;
    return s;
}

/// Why `seats` refuses seat `s`, `<param>: <message>`; "" when it makes it.
fn refusal(seats: api::Seats, s: api::SeatCreate) -> String {
    let mut why = "";
    seats.create(s) or {
        let p = api::ctl_problem(err);
        why = p.param + ": " + p.message;
    };
    return why;
}

fn main() {
    let e = api::DataPlane { link: Quiet { }, harnesses: shipped() };
    let op = e.store.operator_token("va-test") or "";
    let catalog = api::Catalog { store: e.store };
    let accounts = api::Accounts { store: e.store };
    let projects = api::Projects { store: e.store };
    let keys = api::Keys { store: e.store };
    let nodes = api::Nodes { store: e.store, link: Quiet { } };
    let seats = api::Seats { store: e.store, link: Quiet { } };

    // voice's own, from its files: listed, read-only
    expect(call(e, "GET", "/admin/v1/cli-recipes", "vk-nope", ""), 401, "the operator's alone");
    let listed = call(e, "GET", "/admin/v1/cli-recipes", op, "");
    expect(listed, 200, "listed");
    let ids = "claude\ncodex\nagy\nvibe\npi\n";
    let mut rest = ids;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let id = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let one = call(e, "GET", "/admin/v1/cli-recipes/" + id, op, "");
        expect(one, 200, id + " is there");
        std::test::assert(
            str(one.body, "origin") == "shipped" && std::json::find_bool_field(one.body, "enabled"),
            id + ": voice's own, enabled",
        );
        std::test::assert(
            std::str::contains(std::json::find_field_raw(one.body, "recipe"), "\"backends\""),
            id + ": its recipe whole",
        );
    }
    let claude = call(e, "GET", "/admin/v1/cli-recipes/claude", op, "");
    let claude_body = std::str::trim(std::json::find_field_raw(claude.body, "recipe"));
    expect(
        call(e, "PUT", "/admin/v1/cli-recipes/claude", op, claude_body),
        409,
        "voice's own is read-only",
    );
    expect(call(e, "DELETE", "/admin/v1/cli-recipes/claude", op, ""), 409, "and never removed");
    expect(call(e, "GET", "/admin/v1/cli-recipes/nope", op, ""), 404, "no such recipe");

    // the operator's: checked, each refusal at its field
    let made = call(e, "POST", "/admin/v1/cli-recipes", op, mine("mine", NPM));
    expect(made, 201, "the operator's made");
    std::test::assert(
        str(made.body, "origin") == "operator" && std::json::find_bool_field(made.body, "enabled"),
        "the operator's, enabled",
    );
    expect(
        call(e, "POST", "/admin/v1/cli-recipes", op, mine("mine", NPM)),
        409,
        "its id is its own",
    );
    expect(
        call(e, "POST", "/admin/v1/cli-recipes", op, mine("claude", NPM)),
        409,
        "voice's own ids are voice's",
    );
    let sudo = call(
        e,
        "POST",
        "/admin/v1/cli-recipes",
        op,
        mine(
            "other",
            "[\"sudo\", \"npm\", \"install\", \"-g\", \"--prefix\", \"$VOICE_CLI_PREFIX\", \"mine\"]",
        ),
    );
    expect(sudo, 400, "sudo is refused");
    std::test::assert_eq_str(
        param_of(sudo),
        "recipe.backends[0].install.command",
        "at the install's command",
    );
    let global = call(
        e,
        "POST",
        "/admin/v1/cli-recipes",
        op,
        mine("other", "[\"npm\", \"install\", \"--global\", \"mine@1.0.0\"]"),
    );
    expect(global, 400, "an install that names no prefix is refused");
    std::test::assert(
        std::str::contains(global.body, "never system-wide"),
        "saying so: " + global.body,
    );
    let yolo = call(
        e,
        "POST",
        "/admin/v1/cli-recipes",
        op,
        std::str::replace(mine("other", NPM), "\"--print\"", "\"--print\", \"--yolo\""),
    );
    expect(yolo, 400, "a bypass flag is refused");
    std::test::assert_eq_str(param_of(yolo), "recipe.command", "at the command");
    expect(call(e, "POST", "/admin/v1/cli-recipes", op, "[1]"), 400, "a body that is no object");

    // edited whole, keeping its id
    let edited = call(
        e,
        "PUT",
        "/admin/v1/cli-recipes/mine",
        op,
        std::str::replace(mine("mine", NPM), "\"Mine\"", "\"Mine, edited\""),
    );
    expect(edited, 200, "edited");
    std::test::assert_eq_str(
        str(std::json::find_field_raw(edited.body, "recipe"), "name"),
        "Mine, edited",
        "as the body says",
    );
    let renamed = call(e, "PUT", "/admin/v1/cli-recipes/mine", op, mine("yours", NPM));
    expect(renamed, 400, "its id is the one it was made with");
    std::test::assert_eq_str(param_of(renamed), "recipe.id", "at its id");

    // voice's own duplicated into one of the operator's, to edit
    let copy = call(
        e,
        "POST",
        "/admin/v1/cli-recipes/claude/duplicate",
        op,
        "{\"id\": \"claude-mine\", \"name\": \"Claude, mine\"}",
    );
    expect(copy, 201, "duplicated");
    std::test::assert(
        str(copy.body, "origin") == "operator"
            && str(std::json::find_field_raw(copy.body, "recipe"), "id") == "claude-mine"
            && str(std::json::find_field_raw(copy.body, "recipe"), "name") == "Claude, mine",
        "as the operator's, under its new id and name",
    );
    let copied = std::str::trim(std::json::find_field_raw(copy.body, "recipe"));
    expect(
        call(
            e,
            "PUT",
            "/admin/v1/cli-recipes/claude-mine",
            op,
            std::str::replace(copied, "\"acceptEdits\"", "\"plan\""),
        ),
        200,
        "and edited",
    );
    let dup_bad = call(e, "POST", "/admin/v1/cli-recipes/claude/duplicate", op, "{\"id\": \"No\"}");
    expect(dup_bad, 400, "a copy's id is a slug");
    std::test::assert_eq_str(param_of(dup_bad), "id", "at its id");

    // a seat names a recipe voice has, with a backend of the kind it runs
    catalog.create(api::CatalogModelCreate { id: "mine-1" }) or discard;
    accounts.create(api::AccountCreate { id: "acct-a", name: "A" }) or discard;
    let token = (
        nodes.create(
            api::NodeCreate { id: "node-a" },
        ) or api::Node { status: api::NodeStatus::down }
    ).enrollment_token;
    let reg = "{\"protocol\": 2, \"version\": \"0.1.0\", \"capabilities\": " + CAPS
        + ", \"local\": {\"paused\": false, \"paused_seats\": []}}";
    expect(call(e, "POST", "/node/v1/register", token, reg), 200, "registered");
    let missing = refusal(seats, seat("ghost", "{\"harness\": \"nope\", \"login\": \"x\"}"));
    std::test::assert(
        std::str::starts_with(missing, "config.harness: voice has no CLI recipe nope"),
        "a seat of a recipe voice has not is refused: " + missing,
    );
    let boxed = refusal(seats, seat("boxed", "{\"harness\": \"mine\", \"login\": \"mine-key\"}"));
    std::test::assert(
        std::str::starts_with(boxed, "config.backend: CLI recipe mine has no container backend"),
        "a seat that runs only in a container is refused a recipe with no container backend: "
            + boxed,
    );
    let odd = refusal(
        seats,
        seat("odd", "{\"harness\": \"mine\", \"login\": \"mine-key\", \"backend\": \"vm\"}"),
    );
    std::test::assert(
        std::str::starts_with(odd, "config.backend:"),
        "a backend voice has not: " + odd,
    );
    let hosted = seats.create(
        seat("coder", "{\"harness\": \"mine\", \"login\": \"mine-key\", \"backend\": \"host\"}"),
    ) or api::SeatView { status: api::SeatStatus::offline };
    std::test::assert_eq_str(hosted.id, "coder", "a seat that opts in to the host runs it");
    let named = call(e, "GET", "/admin/v1/cli-recipes/mine", op, "");
    std::test::assert(
        std::str::contains(std::json::find_field_raw(named.body, "seats"), "\"node-a/coder\""),
        "the recipe lists the seats that name it: " + named.body,
    );
    expect(
        call(e, "DELETE", "/admin/v1/cli-recipes/mine", op, ""),
        409,
        "a recipe a seat names is not removed",
    );

    // its seat says up; an attempt is claimed on it, with the seat's backend
    let version = (
        nodes.get(api::NodeRef { node: "node-a" }) or api::Node { status: api::NodeStatus::down }
    ).assignment_version;
    expect(
        call(
            e,
            "POST",
            "/node/v1/seats",
            token,
            "{\"assignment_version\": " + to_string(version)
                + ", \"seats\": [{\"id\": \"coder\", \"status\": \"up\", \"reason\": null, \"in_flight\": 0}]}",
        ),
        204,
        "its seat is up",
    );
    projects.create(api::ProjectCreate { id: "work", name: "Work" }) or discard;
    let key = (
        keys.create(
            api::KeyCreate { project: "work", name: "ci" },
        ) or api::Key { status: api::KeyStatus::revoked }
    ).secret;

    // disabled: no new attempt, and its seat says so
    let off = call(e, "PATCH", "/admin/v1/cli-recipes/mine", op, "{\"enabled\": false}");
    expect(off, 200, "disabled");
    std::test::assert(!std::json::find_bool_field(off.body, "enabled"), "it reads disabled");
    expect(
        call(e, "PATCH", "/admin/v1/cli-recipes/mine", op, "{\"enabled\": 1}"),
        400,
        "enabled is a bool",
    );
    let asked = call(e, "POST", "/v1/attempts", key, ASK);
    expect(asked, 400, "an attempt of a disabled recipe is refused");
    std::test::assert(std::str::contains(asked.body, "disabled"), "saying so: " + asked.body);
    let any = call(
        e,
        "POST",
        "/v1/attempts",
        key,
        std::str::replace(ASK, ", \"harness\": \"mine\"", ""),
    );
    expect(any, 202, "an attempt of any recipe queues");
    expect(
        call(e, "POST", "/node/v1/attempts/claim", token, "{}"),
        204,
        "and no seat of a disabled recipe takes it",
    );
    let viewed = seats.get(
        api::SeatRef { node: "node-a", seat: "coder" },
    ) or api::SeatView { status: api::SeatStatus::offline };
    let mut said = false;
    for p in viewed.problems {
        if std::str::contains(p, "CLI recipe mine is disabled") { said = true; }
    }
    std::test::assert(said, "its seat says its recipe is disabled");
    let defs = call(e, "GET", "/admin/v1/harnesses", op, "");
    std::test::assert(
        !std::str::contains(defs.body, "\"id\": \"mine\"")
            && std::str::contains(defs.body, "\"id\": \"claude\""),
        "the enabled recipes alone are listed for the seat form",
    );

    // enabled again: its seat takes the attempt, on the host
    expect(
        call(e, "PATCH", "/admin/v1/cli-recipes/mine", op, "{\"enabled\": true}"),
        200,
        "enabled",
    );
    let claimed = call(e, "POST", "/node/v1/attempts/claim", token, "{}");
    expect(claimed, 200, "claimed");
    let start = std::json::find_field_raw(claimed.body, "attempt");
    std::test::assert(
        str(start, "seat") == "coder" && str(start, "backend") == "host"
            && str(std::json::find_field_raw(start, "harness"), "id") == "mine",
        "on its seat, on the host, with its recipe: " + start,
    );

    // voice's own disabled, then enabled again
    expect(
        call(e, "PATCH", "/admin/v1/cli-recipes/claude", op, "{\"enabled\": false}"),
        200,
        "voice's own disabled",
    );
    expect(
        call(e, "PATCH", "/admin/v1/cli-recipes/claude", op, "{\"enabled\": true}"),
        200,
        "and enabled",
    );

    // removed once no seat names it
    seats.remove(api::SeatRef { node: "node-a", seat: "coder" }) or discard;
    expect(call(e, "DELETE", "/admin/v1/cli-recipes/mine", op, ""), 200, "removed");
    expect(call(e, "GET", "/admin/v1/cli-recipes/mine", op, ""), 404, "gone");
}
