// `api admin-token`: the operator token on stdout (operator.hl). What it
// prints is its product, so this file and `api arrange`'s (arrange_cli.hl)
// are the places in the api that write to stdout outside the logger.

/// `api admin-token [--database URL] [--state DIR]`: print the operator
/// token, minting it when none is kept yet. The database is the api's
/// (`--database`, `VOICE_DATABASE_URL`, or the habitat's); with none, the
/// standalone api's state directory.
fn admin_token(database: String, state: String) -> Int {
    if len(granted_operator_entry()) > 0 {
        log_error(
            "admin-token: the habitat holds the operator token: hale dna secret show operator-token",
            "",
        );
        return 1;
    }
    let token = operator_token_for(database, state) or {
        log_error("admin-token: " + err.message, "");
        return 1;
    };
    println(token);
    return 0;
}

/// The operator token as `api admin-token` reads it: kept in the database
/// (`database`), or with none in the standalone api's state directory
/// (`state`); minted when none is kept yet.
fn operator_token_for(database: String, state: String) -> String fallible(TokenError) {
    if len(database) > 0 { return operator_token_kept(st::PgStore { url: database }) or raise; }
    return operator_token_file(state_dir_or(state)) or raise;
}
