// The configuration the api reads and the admin plane writes: the
// catalog, projects and keys, accounts, nodes and seats, and the change
// log, as the rows of ../spec/store.md.
//
// Everything above this file reaches it through `Store`, so nothing
// learns which store answers. `MemoryStore` holds the rows in the process:
// it is the test double, and enough for one api instance until the
// Postgres store (spec/store.md, over pond's pq), a second implementation
// of the same interface, takes its place.
//
// Every write is one call that carries its change: the store applies the
// write and appends the change together, which a Postgres store does in
// one transaction (store.md: "each write one transaction that also appends
// to `change`").

/// A store that could not answer: `unavailable` (the database is down),
/// `full` (a list is at its bound).
type StoreError { kind: String = "unavailable"; message: String = ""; }

/// A `catalog_model` row. `removed` models keep their id forever.
type ModelRow {
    id: String = "";
    owned_by: String = "local";
    kind: String = "local";
    context_length: Int = 0;
    max_output_tokens: Int = 0;
    priced: Bool = false;
    price: ModelPrice = ModelPrice { };
    // the curated recipe its weights come from, "" for none
    recipe: String = "";
    // what it answers (api/decision.hl): `generative`, or `decision`, a
    // model that answers only structured requests, with probabilities
    contract: String = "generative";
    created_at: Time = `1970-01-01T00:00:00Z`;
    removed: Bool = false;
    removed_at: Time = `1970-01-01T00:00:00Z`;
    present: Bool = false;
}

/// A `recipe` row: one the operator allowed (voice's own are files, not
/// rows). `body` is its `RecipeCreate` as the api checked and wrote it. A
/// removed row keeps its id, which is never reused.
type RecipeRow {
    id: String = "";
    body: String = "{}";
    created_at: Time = `1970-01-01T00:00:00Z`;
    removed: Bool = false;
    removed_at: Time = `1970-01-01T00:00:00Z`;
    present: Bool = false;
}

/// An `arrangement` row: what the operator wants the whole fleet for, kept
/// under an id to be planned again on demand (api/arranger.hl). `body` is
/// its `ArrangementWants`. `planned_at` and `planned_basis`: when it was
/// last planned, and the fleet as it was then (a digest), so a later read
/// can say the fleet has changed since.
type ArrangementRow {
    id: String = "";
    name: String = "";
    body: String = "{}";
    created_at: Time = `1970-01-01T00:00:00Z`;
    updated_at: Time = `1970-01-01T00:00:00Z`;
    // the wants' revision: a new token with every save
    revision: String = "";
    planned: Bool = false;
    planned_at: Time = `1970-01-01T00:00:00Z`;
    planned_basis: String = "";
    present: Bool = false;
}

/// Every arrangement row, in the order they were added.
type ArrangementRows { rows: bounded[ArrangementRow; 64]; }

/// A `runtime` row: one the operator allowed (voice's own are files, not
/// rows). `body` is its `RuntimeCreate` as the api checked and wrote it. A
/// removed row keeps its id, which is never reused.
type RuntimeRow {
    id: String = "";
    body: String = "{}";
    created_at: Time = `1970-01-01T00:00:00Z`;
    removed: Bool = false;
    removed_at: Time = `1970-01-01T00:00:00Z`;
    present: Bool = false;
}

/// A `placement` row: a local model put on nodes. `body` is the
/// `Placement` the api decided and answered. A removed row keeps its id,
/// which is never reused.
type PlacementRow {
    id: String = "";
    model: String = "";
    body: String = "{}";
    created_at: Time = `1970-01-01T00:00:00Z`;
    removed: Bool = false;
    removed_at: Time = `1970-01-01T00:00:00Z`;
    present: Bool = false;
}

/// A `project` row, with its `budget` and its project- and model-scope
/// `limit` rows.
type ProjectRow {
    id: String = "";
    name: String = "";
    owners: Names = Names { };
    data_classes: Names = Names { };
    models: Restriction = Restriction { };
    accounts: Restriction = Restriction { };
    budgeted: Bool = false;
    budget: BudgetSet = BudgetSet { period: Period::month };
    limits: Limits = Limits { };
    position: String = "";
    created_at: Time = `1970-01-01T00:00:00Z`;
    archived: Bool = false;
    archived_at: Time = `1970-01-01T00:00:00Z`;
    // the project this one is a child of ("" for none): a tenant's is its
    // habitat's project (api/tenants.hl)
    parent: String = "";
    // its accounts are its parent's, read when it is used, not its own
    inherits: Bool = false;
    // each request it sends is recorded whole, prompt and output (peek.hl):
    // its own setting when `peek_set`, else its parent's
    peek_set: Bool = false;
    peek: Bool = false;
    // voice's old global project for its own requests, retired
    // (`RETIRED_SYSTEM_PROJECT`), never a caller's
    internal: Bool = false;
    // the names it gives models (projects.hl): its own, a JSON list of
    // `{"name", "model"}`; a child's are these over its parent's
    aliases: String = "[]";
    present: Bool = false;
}

/// An `api_key` row: the secret's digest, never the secret.
type KeyRow {
    id: String = "";
    project: String = "";
    name: String = "";
    prefix: String = "";
    digest: String = "";
    models: Restriction = Restriction { };
    accounts: Restriction = Restriction { };
    limits: Limits = Limits { };
    created_at: Time = `1970-01-01T00:00:00Z`;
    expires: Bool = false;
    expires_at: Time = `1970-01-01T00:00:00Z`;
    used: Bool = false;
    last_used_at: Time = `1970-01-01T00:00:00Z`;
    revoked: Bool = false;
    revoked_at: Time = `1970-01-01T00:00:00Z`;
    // each request it sends is recorded whole, prompt and output (peek.hl)
    peek: Bool = false;
    // its project's own key for the requests voice makes for it
    // (`system_key`): no token names it, and it is never revoked
    internal: Bool = false;
    present: Bool = false;
}

/// Voice's old global project for its own requests (migration 23), retired
/// by migration 24: archived, its key revoked. Each project's own `-system`
/// key makes voice's requests for it instead (`system_key`). Migration 34
/// removes it where nothing was recorded under it, so a store made since,
/// and the memory store, have none; its id is never a caller's either way.
const RETIRED_SYSTEM_PROJECT: String = "voice-system";

/// A project's own key for the requests voice makes for it (annotations
/// and titles, when voice annotated requests): its id and its name, made
/// with the project, which no token names. Its usage is the project's,
/// apart from its callers' keys; its limits cap what voice spends for it.
fn system_key(project: String) -> String {
    return project + "-system";
}

/// A project's system key, as the store makes it with the project.
fn system_key_row(project: String, at: Time) -> KeyRow {
    return KeyRow {
        id: system_key(project),
        project: project,
        name: system_key(project),
        created_at: at,
        internal: true,
        present: true,
    };
}

/// A request recorded whole, for a project or key that peeks: its standard
/// request as served and its final response, each the JSON it was.
type PeekRow {
    request_id: String = "";
    project: String = "";
    key: String = "";
    model: String = "";
    created_at: Time = `1970-01-01T00:00:00Z`;
    input: String = "";
    output: String = "";
    present: Bool = false;
}

/// Recorded requests, newest first: their bodies left out ("") when listed.
/// From `peeks`, `more` is true when more match past the last, and
/// `cursor_known` false when the query's cursor names no recording.
type PeekRows { rows: bounded[PeekRow; 200]; more: Bool = false; cursor_known: Bool = true; }

/// Which recordings `peeks` lists, newest first (and by request id within
/// a second): of `project`, `key` and `model` (the catalog model each was
/// routed as) where not "", past the recording `cursor` names where not "",
/// at most `limit` (1 to 200).
type PeekQuery {
    project: String = "";
    key: String = "";
    model: String = "";
    cursor: String = "";
    limit: Int = 200;
}

/// A request being served now: on which seat, since when (inference.hl). A
/// row is written as each attempt is offered and gone once it ends; the
/// admin event stream tells each new one (`request`), so a live view lights
/// a request for as long as it runs. `seq` numbers them as written. `model`
/// is the catalog model it is routed as, `alias` the name it asked for it by.
type FlightRow {
    seq: Int = 0;
    request_id: String = "";
    project: String = "";
    key: String = "";
    model: String = "";
    seat: String = "";
    account: String = "";
    started_at: Time = `1970-01-01T00:00:00Z`;
    // the api instance that admitted it ("" from before instances were kept)
    instance: String = "";
    // the conversation it is a turn of: its `prompt_cache_key` when that is a
    // string (the usage record's `conversation`), "" for none
    conversation: String = "";
    // the name its project gives `model` that it asked for (the usage
    // record's `requested_model` when it differs from `resolved_model`); ""
    // when it named the model itself, or from before it was kept
    alias: String = "";
}

type FlightRows { rows: bounded[FlightRow; 100]; }

/// A conversation's seat (store.md, "Where a conversation is"):
/// `conversation` 32 hex digits of a hash of its key, `seat` the
/// `<node>/<seat>` its last turn was granted to, at `at`.
type SeatConversationRow {
    present: Bool = false;
    conversation: String = "";
    seat: String = "";
    at: Time = `1970-01-01T00:00:00Z`;
}

/// The memory store's conversations: the most it keeps, the oldest
/// forgotten first. A conversation forgotten is a turn that goes where a
/// new conversation would.
const SEAT_CONVERSATIONS_KEPT: Int = 1024;

type SeatConversationRows { rows: bounded[SeatConversationRow; 1024]; }

/// The days a recorded request is kept.
const PEEK_DAYS: Int = 7;

/// A `PeekQuery`'s `limit`, held to 1 to 200.
fn peek_limit(limit: Int) -> Int {
    return if limit < 1 { 1 } else if limit > 200 { 200 } else { limit };
}

/// An `account` row, with its account-scope limits. `provider` "" is `null`.
type AccountRow {
    id: String = "";
    name: String = "";
    provider: String = "";
    // subscription | metered | none
    billing: String = "none";
    limits: Limits = Limits { };
    created_at: Time = `1970-01-01T00:00:00Z`;
    archived: Bool = false;
    archived_at: Time = `1970-01-01T00:00:00Z`;
    present: Bool = false;
}

/// A `node` row: the enrollment token's digest, never the token.
type NodeRow {
    id: String = "";
    name: String = "";
    token_digest: String = "";
    // bumped by any change to the node or its seats
    assignment_version: Int = 0;
    created_at: Time = `1970-01-01T00:00:00Z`;
    revoked: Bool = false;
    revoked_at: Time = `1970-01-01T00:00:00Z`;
    present: Bool = false;
}

/// A `seat` row, keyed by `ref` (`<node>/<seat>`). `config` is the
/// engine's JSON object, as written.
type SeatRow {
    ref: String = "";
    node: String = "";
    id: String = "";
    engine: String = "";
    account: String = "";
    serves: SeatModels = SeatModels { };
    data_classes: Names = Names { };
    concurrency: Int = 1;
    enabled: Bool = true;
    config: String = "{}";
    present: Bool = false;
}

/// A `change` row. `before` and `after` are the resource's JSON as its
/// `GET` answers it, "" for `null`; never a secret, digest or token.
type ChangeRow {
    seq: Int = 0;
    id: String = "";
    at: Time = `1970-01-01T00:00:00Z`;
    // create | update | delete | archive | revoke | rotate
    action: String = "";
    // the resource's path under /admin/v1
    target: String = "";
    before: String = "";
    after: String = "";
    // false for a change the log does not hold (`Store.change`)
    present: Bool = false;
}

/// A `node_state` row: what a node declared and reported, written by the
/// node plane. `capabilities` and `local` are the node's JSON as it sent
/// them. The node's last heartbeat and load are `Store.beat`'s, apart.
type FleetRow {
    node: String = "";
    version: String = "";
    capabilities: String = "";
    local: String = "";
    registered_at: Time = `1970-01-01T00:00:00Z`;
    // the assignment the node last reported on; -1 for none
    applied_version: Int = -1;
    draining: Bool = false;
    // the protocol it last registered with (protocol.yaml
    // `Registration.protocol`, 2 or 3); 0 for none on record
    protocol: Int = 0;
    present: Bool = false;
}

/// A `node_inventory` row: the files a node's store holds whole, as it
/// last reported them (api/downloads.hl), `<sha256> <bytes>` a line in the
/// order of their sha256, and how many and their size together;
/// `present` false until it reports. `inventory_summary` leaves `blobs`
/// out.
type InventoryRow {
    node: String = "";
    blobs: String = "";
    files: Int = 0;
    bytes: Int = 0;
    reported_at: Time = `1970-01-01T00:00:00Z`;
    present: Bool = false;
}

/// A `link_check` row: a check of the link between two nodes, rank 0
/// (`node_a`) and rank 1 (`node_b`), and what each reported of it, its
/// `LinkCheckResult` JSON, "" until it does (api/links.hl).
type LinkCheckRow {
    id: String = "";
    node_a: String = "";
    node_b: String = "";
    created_at: Time = `1970-01-01T00:00:00Z`;
    // where the ranks meet (node_a's address on the link) and the image
    // both run it in, by digest
    master_addr: String = "";
    image: String = "";
    result_a: String = "";
    result_b: String = "";
    present: Bool = false;
}

/// The newest link checks, newest first.
type LinkCheckRows { rows: bounded[LinkCheckRow; 64]; }

/// A node's last sign of life: its heartbeat (or registration) and the
/// requests it had in flight then.
type Beat { at: Time = `1970-01-01T00:00:00Z`; in_flight: Int = 0; present: Bool = false; }

/// A `seat_state` row, keyed by `ref`.
type SeatStateRow {
    ref: String = "";
    node: String = "";
    seat: String = "";
    // starting | fetching | up | down | disabled | paused | refused
    status: String = "";
    reason: String = "";
    in_flight: Int = 0;
    // a managed seat's fetch, in bytes, while there is one
    has_progress: Bool = false;
    done_bytes: Int = 0;
    total_bytes: Int = 0;
    // a managed seat's server's context, in tokens; 0 until it says
    context: Int = 0;
    present: Bool = false;
    // when the seat's state (its status and reason) began: written with the
    // time of the report a row is put with, and kept by `put_seat_state`
    // while a report repeats the status and reason the row holds
    since: Time = `1970-01-01T00:00:00Z`;
}

/// Which changes, newest first: under `target` (all when ""), in
/// [from, to] where set, at most `limit`, older than `cursor` (a change id)
/// when set.
type ChangeQuery {
    target: String = "";
    has_from: Bool = false;
    from: Time = `1970-01-01T00:00:00Z`;
    has_to: Bool = false;
    to: Time = `1970-01-01T00:00:00Z`;
    limit: Int = 100;
    cursor: String = "";
    // false to leave `before` and `after` unread ("" each): a list of the
    // changes, not the resources they hold
    bodies: Bool = true;
}

/// Every catalog row, removed ones included, in the order they were added.
type ModelRows { rows: bounded[ModelRow; 256]; }

/// Every recipe row, removed ones included, in the order they were added.
type RecipeRows { rows: bounded[RecipeRow; 256]; }

/// Every runtime row, removed ones included, in the order they were added.
type RuntimeRows { rows: bounded[RuntimeRow; 64]; }

/// Every placement row, removed ones included, in the order they were added.
type PlacementRows { rows: bounded[PlacementRow; 256]; }

/// Every project row, archived ones included, in the order they were added.
type ProjectRows { rows: bounded[ProjectRow; 64]; }

/// One project's key rows, revoked ones included, in the order they were added.
type KeyRows { rows: bounded[KeyRow; 64]; }

/// The keys an archive revokes, revoked, and a change for each.
type Revocations { keys: bounded[KeyRow; 64]; changes: bounded[ChangeRow; 64]; }

/// Every account row, archived ones included, in the order they were added.
type AccountRows { rows: bounded[AccountRow; 64]; }

/// Every node row, revoked ones included, in the order they were added.
type NodeRows { rows: bounded[NodeRow; 64]; }

/// Every seat row, on every node, in the order they were added.
type SeatRows { rows: bounded[SeatRow; 256]; }

/// One node's seat states.
type SeatStateRows { rows: bounded[SeatStateRow; 16]; }

/// A page of changes; `more` when older ones match too.
/// A page of the log. `cursor_known` is false when the query's cursor
/// names no change, and the page is then empty.
type ChangeRows { rows: bounded[ChangeRow; 1000]; more: Bool = false; cursor_known: Bool = true; }

/// A `usage` row: one request, as the ledger holds it. `record` is the
/// whole `UsageRecord` as the API answers it; the other fields are the
/// ones a read filters, groups or sums by, and only a write carries them
/// all: a read fills `seq`, `id`, `created_at` and `record`.
type UsageRow {
    // the order rows were written in, numbered by the store
    seq: Int = 0;
    id: String = "";
    created_at: Time = `1970-01-01T00:00:00Z`;
    project: String = "";
    key: String = "";
    // "" when no account served
    account: String = "";
    requested_model: String = "";
    // the model, node and seat that served, "" when none did
    served_model: String = "";
    node: String = "";
    seat: String = "";
    status: String = "";
    input_tokens: Int = 0;
    // of the input, what the seat's prompt cache held
    cached_input_tokens: Int = 0;
    output_tokens: Int = 0;
    // of the output, the model's thinking
    reasoning_tokens: Int = 0;
    price_micros: Int = 0;
    currency: String = "USD";
    // `Served` as JSON, `null` when none
    served: String = "null";
    record: String = "{}";
    present: Bool = false;
}

/// Which usage, newest first: of `project`, `key`, `account`, `model`
/// (requested or served), `conversation` and `status` where not "", with every `metadata` pair
/// (`name=value`), in [from, to] where set, older than `cursor` (a row's
/// `seq`) when above 0, at most `limit`.
type UsageQuery {
    project: String = "";
    key: String = "";
    model: String = "";
    account: String = "";
    // the record's `conversation`
    conversation: String = "";
    metadata: Names = Names { };
    // how the request ended (`UsageRecord.status`)
    status: String = "";
    has_from: Bool = false;
    from: Time = `1970-01-01T00:00:00Z`;
    has_to: Bool = false;
    to: Time = `1970-01-01T00:00:00Z`;
    limit: Int = 100;
    cursor: Int = 0;
    // a project's system key's rows (`system_key`): voice's own requests
    // for it, left out unless asked for, or unless `key` names one
    include_internal: Bool = false;
}

type UsageRows { rows: bounded[UsageRow; 1000]; more: Bool = false; }

/// What the rows matching `q` add up to, grouped by `by`: any of
/// project, key, model, account, seat, node, conversation, day, hour
/// (`valid_group`). The groups come most recently active first, at most
/// `SUMMARY_GROUPS` of them.
type UsageSummaryQuery {
    by: Names = Names { };
    q: UsageQuery = UsageQuery { };
}

/// One group: `group` is a JSON object keyed by the `by` fields. Rows of
/// another currency are another group.
type UsageGroup {
    group: String = "{}";
    requests: Int = 0;
    input_tokens: Int = 0;
    output_tokens: Int = 0;
    price_micros: Int = 0;
    currency: String = "USD";
    // the group's earliest and latest request, and the latest's id
    first_at: Time = `1970-01-01T00:00:00Z`;
    last_at: Time = `1970-01-01T00:00:00Z`;
    last_request: String = "";
}

type UsageGroups { rows: bounded[UsageGroup; 1000]; }

/// Which totals, from the hourly rollup (`usage_hourly`): of `project`,
/// `key` and `model` (the model that served, else the one asked for) where
/// not "", grouped by `by` (any of project, key, model), over the hours
/// that start in [the hour holding `from`, `to`] where set, so a range is
/// widened to whole hours: totals are to the hour. A project's system key's
/// hours are left out unless `include_internal` or `key` names one.
type UsageTotalsQuery {
    by: Names = Names { };
    project: String = "";
    key: String = "";
    model: String = "";
    has_from: Bool = false;
    from: Time = `1970-01-01T00:00:00Z`;
    has_to: Bool = false;
    to: Time = `1970-01-01T00:00:00Z`;
    include_internal: Bool = false;
}

/// One group's totals, by currency: `group` a JSON object keyed by the `by`
/// fields; `failed` the requests that ended other than served or incomplete
/// (`failed_status`). The token sums count what engines reported: an
/// estimated input is 0 in the ledger's columns, so in none of these.
type UsageTotal {
    group: String = "{}";
    currency: String = "USD";
    requests: Int = 0;
    failed: Int = 0;
    input_tokens: Int = 0;
    cached_input_tokens: Int = 0;
    output_tokens: Int = 0;
    reasoning_tokens: Int = 0;
    price_micros: Int = 0;
}

/// Totals in the order of their groups' values (`by`'s, in turn) and then
/// currency, at most `SUMMARY_GROUPS`, the first in that order.
type UsageTotals { rows: bounded[UsageTotal; 1000]; }

/// Which requests a placement's decode speed is measured from
/// (`Store.decode_speeds`): those its seat served from `since` (and while
/// the placement stood), whole, with at least `min_output` output tokens the
/// engine counted, and a generation time; of each placement, the newest
/// `per_seat`.
type DecodeSpeedQuery {
    since: Time = `1970-01-01T00:00:00Z`;
    min_output: Int = 32;
    per_seat: Int = 500;
}

/// What the seats of placements of one recipe variant on the same nodes
/// generated at: each request's output tokens over its generation time
/// (`timing.engine_ms` less `timing.first_output_ms`), in tokens a second,
/// rounded: the 25th, 50th and 75th percentiles (the value at or past that
/// share of them, as Postgres' `percentile_disc` takes it); how many, and
/// the first and last of them.
type DecodeSpeedRow {
    recipe: String = "";
    variant: String = "";
    // the placement's nodes in byte order, a tab between
    nodes: String = "";
    requests: Int = 0;
    p25_tps: Int = 0;
    median_tps: Int = 0;
    p75_tps: Int = 0;
    first_at: Time = `1970-01-01T00:00:00Z`;
    last_at: Time = `1970-01-01T00:00:00Z`;
}

/// By recipe, variant and nodes, in that order.
type DecodeSpeedRows { rows: bounded[DecodeSpeedRow; 256]; }

/// The most requests one group's speed is measured over in the memory
/// store.
const DECODE_SAMPLES: Int = 4096;

/// The groups a decode speed is measured for, in order.
type DecodeKeys { items: bounded[String; 256]; }

/// `keys` with `key` in it, kept in byte order.
fn decode_key_added(keys: DecodeKeys, key: String) -> DecodeKeys {
    let mut out = DecodeKeys { };
    let mut placed = false;
    for x in keys.items {
        if x == key { return keys; }
        if !placed && key < x {
            push(out.items, key) or discard;
            placed = true;
        }
        push(out.items, x) or discard;
    }
    if !placed { push(out.items, key) or discard; }
    return out;
}

/// Placement body `body`'s group: its recipe, variant and nodes, a newline
/// between.
fn decode_key(body: String) -> String {
    return std::json::find_string_field(body, "recipe") + "\n"
        + std::json::find_string_field(body, "variant") + "\n" + placement_nodes_key(body);
}

/// Placement body `body`'s nodes in byte order, a tab between.
fn placement_nodes_key(body: String) -> String {
    let mut it = std::json::array_first(std::json::find_field_raw(body, "nodes"));
    let mut a = "";
    let mut b = "";
    while !it.done {
        let n = std::json::find_string_field("{\"n\": " + it.element + "}", "n");
        if len(a) == 0 { a = n; } else if len(b) == 0 { b = n; }
        it = std::json::array_next(it);
    }
    if len(b) == 0 { return a; }
    return if b < a { b + "\t" + a } else { a + "\t" + b };
}

/// Request `r`'s decode rate in thousandths of a token a second, when `q`
/// counts it; -1 when not.
fn decode_milli(r: UsageRow, q: DecodeSpeedQuery) -> Int {
    if r.status != "served" || r.output_tokens < q.min_output { return -1; }
    if std::json::find_bool_field(r.record, "output_tokens_estimated") { return -1; }
    let timing = std::json::find_field_raw(r.record, "timing");
    if len(std::json::find_field_raw(timing, "first_output_ms")) == 0 { return -1; }
    let gen = std::json::find_int_field(timing, "engine_ms")
        - std::json::find_int_field(timing, "first_output_ms");
    if gen <= 0 { return -1; }
    return r.output_tokens * 1000000 / gen;
}

/// The value at or past share `num`/`den` of sorted `xs`' first `n`
/// (`percentile_disc`), thousandths rounded to a whole.
fn percentile_whole(xs: [Int; 4096], n: Int, num: Int, den: Int) -> Int {
    let mut i = (num * n + den - 1) / den - 1;
    if i < 0 { i = 0; }
    return (xs[i] + 500) / 1000;
}

/// One hour of the rollup: what the ledger's rows of one project, key,
/// model and currency made in it add up to (`usage_hourly`).
type HourlyRow {
    // project, key, model, currency and hour, a newline between each
    id: String = "";
    project: String = "";
    key: String = "";
    model: String = "";
    currency: String = "USD";
    hour: Time = `1970-01-01T00:00:00Z`;
    requests: Int = 0;
    failed: Int = 0;
    input_tokens: Int = 0;
    cached_input_tokens: Int = 0;
    output_tokens: Int = 0;
    reasoning_tokens: Int = 0;
    price_micros: Int = 0;
    present: Bool = false;
}

/// True for a field the totals group by.
fn valid_total_group(f: String) -> Bool {
    return f == "project" || f == "key" || f == "model";
}

/// The hour `t` is in: its start, in UTC.
fn hour_of(t: Time) -> Time {
    let s = std::time::unix(t);
    return std::time::time_from_unix(s - s % 3600);
}

/// True when hour `h` of the rollup is one `q` asks for; `from` is the
/// start of the hour holding `q.from`, in Unix seconds.
fn hourly_matches(h: HourlyRow, q: UsageTotalsQuery, from: Int) -> Bool {
    if !q.include_internal && len(q.key) == 0 && h.key == system_key(h.project) { return false; }
    if len(q.project) > 0 && h.project != q.project { return false; }
    if len(q.key) > 0 && h.key != q.key { return false; }
    if len(q.model) > 0 && h.model != q.model { return false; }
    let at = std::time::unix(h.hour);
    if q.has_from && at < from { return false; }
    if q.has_to && at > std::time::unix(q.to) { return false; }
    return true;
}

/// The memory store's totals while it sums them, each beside the text it
/// sorts by: its group's values and then its currency, each ended by a
/// newline, which sorts before any character a value holds, so the text's
/// order is the values' order, one after another.
type TotalsSorted {
    rows: bounded[UsageTotal; 1000];
    order: bounded[String; 1000];
}

/// `s` with hour `h` counted: added to its group's totals, else a group of
/// its own in its place, the first `SUMMARY_GROUPS` in order kept. A new
/// value, `s` left as it is.
@bounded_by(s)
fn total_added(s: TotalsSorted, h: HourlyRow, by: Names) -> TotalsSorted {
    let mut group = "";
    let mut order = "";
    for f in by.items {
        let v = if f == "project" { h.project } else if f == "key" { h.key } else { h.model };
        group = group + (if len(group) > 0 { ", " } else { "" }) + "\"" + f + "\": \""
            + std::json::escape_string(v) + "\"";
        order = order + v + "\n";
    }
    group = "{" + group + "}";
    order = order + h.currency + "\n";
    // where it goes: its group's place, or the first after it
    let mut n = 0;
    let mut found = false;
    while n < count(s.order) {
        let o = at(s.order, n) or "";
        if o == order { found = true; break; }
        if order < o { break; }
        n = n + 1;
    }
    if n >= SUMMARY_GROUPS { return s; }
    let had = if found {
        at(s.rows, n) or UsageTotal { }
    } else {
        UsageTotal { group: group, currency: h.currency }
    };
    let summed = UsageTotal {
        group: had.group,
        currency: had.currency,
        requests: had.requests + h.requests,
        failed: had.failed + h.failed,
        input_tokens: had.input_tokens + h.input_tokens,
        cached_input_tokens: had.cached_input_tokens + h.cached_input_tokens,
        output_tokens: had.output_tokens + h.output_tokens,
        reasoning_tokens: had.reasoning_tokens + h.reasoning_tokens,
        price_micros: had.price_micros + h.price_micros,
    };
    // the group summed in its place, those after a new one a place further
    // on, the last past the cap left out
    let mut out = TotalsSorted { };
    let mut i = 0;
    while i <= count(s.rows) {
        if i == n {
            push(out.rows, summed) or discard;
            push(out.order, order) or discard;
        }
        if i < count(s.rows) && !(found && i == n) {
            push(out.rows, at(s.rows, i) or UsageTotal { }) or discard;
            push(out.order, at(s.order, i) or "") or discard;
        }
        i = i + 1;
    }
    return out;
}

/// Which conversations, the most recently active first: the rows `q`
/// matches (its own `cursor` and `limit` aside) that name a conversation,
/// grouped by project, conversation and currency; of those, the ones whose
/// latest row is older than `cursor` (a row's `seq`) when above 0, with a
/// failed request when `has_failures`, at most `limit`.
type ConversationQuery {
    q: UsageQuery = UsageQuery { };
    has_failures: Bool = false;
    limit: Int = 40;
    cursor: Int = 0;
}

/// One conversation's requests, summed: `keys` and `models` (the served
/// model, else the requested) each sorted, at most `CONVERSATION_NAMES`;
/// `failed` the requests that ended other than served or incomplete
/// (`failed_status`).
type ConversationRow {
    project: String = "";
    conversation: String = "";
    currency: String = "USD";
    keys: Names = Names { };
    models: Names = Names { };
    requests: Int = 0;
    failed: Int = 0;
    input_tokens: Int = 0;
    cached_input_tokens: Int = 0;
    output_tokens: Int = 0;
    reasoning_tokens: Int = 0;
    price_micros: Int = 0;
    first_at: Time = `1970-01-01T00:00:00Z`;
    last_at: Time = `1970-01-01T00:00:00Z`;
    // the latest row's: the cursor of the page after it
    last_seq: Int = 0;
    last_request: String = "";
    last_status: String = "";
}

type ConversationRows { rows: bounded[ConversationRow; 100]; more: Bool = false; }

/// The memory store's conversations while it sums them: at most
/// `SUMMARY_GROUPS`, the most recently active.
type ConversationGroups { rows: bounded[ConversationRow; 1000]; }

/// The most keys, and models, a conversation's row names.
const CONVERSATION_NAMES: Int = 4;

/// True when `s` is a conversation as the store keeps it: 32 lower-case
/// hex digits.
fn conversation_hash(s: String) -> Bool {
    let v = std::str::bytes_view(s);
    if v.n != 32 { return false; }
    let mut i = 0;
    while i < v.n {
        let b = std::str::byte_at(v, i);
        if !((b >= 48 && b <= 57) || (b >= 97 && b <= 102)) { return false; }
        i = i + 1;
    }
    return true;
}

/// True for a status a request failed with: any but served and incomplete.
fn failed_status(status: String) -> Bool {
    return status != "served" && status != "incomplete";
}

/// `n` with `v` in it, kept sorted, at most `CONVERSATION_NAMES`: the
/// first in order are kept.
fn name_added(n: Names, v: String) -> Names {
    let mut out = Names { };
    let mut placed = false;
    for x in n.items {
        if x == v { return n; }
        if !placed && v < x {
            push(out.items, v) or discard;
            placed = true;
        }
        push(out.items, x) or discard;
    }
    if !placed { push(out.items, v) or discard; }
    let mut kept = Names { };
    for x in out.items {
        if count(kept.items) < CONVERSATION_NAMES { push(kept.items, x) or discard; }
    }
    return kept;
}

/// The most groups a summary answers: the most recently active.
const SUMMARY_GROUPS: Int = 1000;

/// True for a field a summary groups by.
fn valid_group(f: String) -> Bool {
    return f == "project" || f == "key" || f == "model" || f == "account" || f == "seat"
        || f == "node" || f == "conversation" || f == "internal" || f == "day" || f == "hour";
}

/// The value of group field `f` in `r`.
fn group_value(r: UsageRow, f: String) -> String {
    if f == "project" { return r.project; }
    if f == "key" { return r.key; }
    if f == "model" {
        return if len(r.served_model) > 0 { r.served_model } else { r.requested_model };
    }
    if f == "account" { return r.account; }
    if f == "seat" { return r.seat; }
    if f == "node" { return r.node; }
    if f == "conversation" { return conversation_of(r); }
    // voice's own request for the project, under its system key: "true"
    if f == "internal" { return if r.key == system_key(r.project) { "true" } else { "false" }; }
    let t = std::time::iso8601(r.created_at);
    if f == "day" { return t[0..10] + "T00:00:00Z"; }
    return t[0..13] + ":00:00Z";
}

/// The conversation `r` was a turn of, "" when it names none (`null`).
fn conversation_of(r: UsageRow) -> String {
    let raw = std::str::trim(std::json::find_field_raw(r.record, "conversation"));
    return if std::str::starts_with(raw, "\"") {
        std::json::find_string_field(r.record, "conversation")
    } else {
        ""
    };
}

/// True when `r` is one `q` asks for (all but the cursor and the limit).
fn usage_matches(r: UsageRow, q: UsageQuery) -> Bool {
    if !q.include_internal && len(q.key) == 0 && r.key == system_key(r.project) { return false; }
    if len(q.project) > 0 && r.project != q.project { return false; }
    if len(q.key) > 0 && r.key != q.key { return false; }
    if len(q.account) > 0 && r.account != q.account { return false; }
    if len(q.model) > 0 && r.requested_model != q.model && r.served_model != q.model {
        return false;
    }
    if len(q.conversation) > 0 && conversation_of(r) != q.conversation {
        return false;
    }
    if len(q.status) > 0 && r.status != q.status { return false; }
    let at = std::time::unix(r.created_at);
    if q.has_from && at < std::time::unix(q.from) { return false; }
    if q.has_to && at > std::time::unix(q.to) { return false; }
    let meta = std::json::find_field_raw(r.record, "metadata");
    for pair in q.metadata.items {
        let eq = std::str::index_of(pair, "=");
        if eq < 0 { return false; }
        let v = std::json::find_string_field(meta, pair[0..eq]);
        if v != pair[(eq + 1)..len(pair)] { return false; }
    }
    return true;
}

interface Store {
    /// What answers: `memory`, `postgres`. Readiness names it.
    fn kind() -> String;
    /// Hold `target` (a resource's path, as a change names it) from a read
    /// to the write that follows it: on any api instance, a writer of the
    /// same resource waits, so the read is current and no update is lost.
    /// The write ends the hold; `let_go` ends one that wrote nothing.
    /// `target` may name several, one a line, each held, in the order of
    /// their names so two holders never wait on each other.
    fn hold(target: String) fallible(StoreError);
    fn let_go();
    /// True when the store answers.
    fn ready() -> Bool;

    /// The row for `id`; `present` is false when there is none.
    fn model(id: String) -> ModelRow fallible(StoreError);
    fn models() -> ModelRows fallible(StoreError);
    /// Add a row; false, and nothing written, when its id is taken.
    fn insert_model(row: ModelRow, change: ChangeRow) -> Bool fallible(StoreError);
    /// Replace the row with `row.id`.
    fn update_model(row: ModelRow, change: ChangeRow) fallible(StoreError);

    /// The recipe row for `id`; `present` is false when there is none.
    fn recipe(id: String) -> RecipeRow fallible(StoreError);
    fn recipes() -> RecipeRows fallible(StoreError);
    /// Add a row; false, and nothing written, when its id is taken.
    fn insert_recipe(row: RecipeRow, change: ChangeRow) -> Bool fallible(StoreError);
    /// Mark the row with `row.id` removed, at `row.removed_at`.
    fn remove_recipe(row: RecipeRow, change: ChangeRow) fallible(StoreError);

    /// The arrangement row for `id`; `present` is false when there is none.
    fn arrangement(id: String) -> ArrangementRow fallible(StoreError);
    fn arrangements() -> ArrangementRows fallible(StoreError);
    /// Add the row, or replace the name and wants of the one with `row.id`
    /// (its plan's record cleared); true when it was added.
    fn put_arrangement(row: ArrangementRow, change: ChangeRow) -> Bool fallible(StoreError);
    /// Remove the row with `id`.
    fn delete_arrangement(id: String, change: ChangeRow) fallible(StoreError);
    /// Arrangement `id`, at revision `revision`, was planned at `at`,
    /// against the fleet `basis`: a record of the plan, no change of
    /// configuration. False, and nothing written, when the wants were
    /// saved again (another revision) or removed since.
    fn plan_arrangement_at(
        id: String,
        revision: String,
        at: Time,
        basis: String
    ) -> Bool fallible(StoreError);

    /// The runtime row for `id`; `present` is false when there is none.
    fn runtime(id: String) -> RuntimeRow fallible(StoreError);
    fn runtimes() -> RuntimeRows fallible(StoreError);
    /// Add a row; false, and nothing written, when its id is taken.
    fn insert_runtime(row: RuntimeRow, change: ChangeRow) -> Bool fallible(StoreError);
    /// Mark the row with `row.id` removed, at `row.removed_at`.
    fn remove_runtime(row: RuntimeRow, change: ChangeRow) fallible(StoreError);

    /// The placement row for `id`; `present` is false when there is none.
    fn placement(id: String) -> PlacementRow fallible(StoreError);
    fn placements() -> PlacementRows fallible(StoreError);
    /// Add a row; false, and nothing written, when its id is taken.
    fn insert_placement(row: PlacementRow, change: ChangeRow) -> Bool fallible(StoreError);
    /// Mark the row with `row.id` removed, at `row.removed_at`.
    fn remove_placement(row: PlacementRow, change: ChangeRow) fallible(StoreError);

    fn project(id: String) -> ProjectRow fallible(StoreError);
    fn projects() -> ProjectRows fallible(StoreError);
    fn insert_project(row: ProjectRow, change: ChangeRow) -> Bool fallible(StoreError);
    fn update_project(row: ProjectRow, change: ChangeRow) fallible(StoreError);
    /// Replace the row, archived, and write the keys it revokes, each with
    /// its own change, all in one write: the keys' changes first, then the
    /// project's.
    fn archive_project(
        row: ProjectRow,
        change: ChangeRow,
        revoked: Revocations
    ) fallible(StoreError);

    fn key(id: String) -> KeyRow fallible(StoreError);
    /// The key whose secret has this digest; `present` false for none.
    fn key_by_digest(digest: String) -> KeyRow fallible(StoreError);
    fn keys(project: String) -> KeyRows fallible(StoreError);
    fn insert_key(row: KeyRow, change: ChangeRow) -> Bool fallible(StoreError);
    fn update_key(row: KeyRow, change: ChangeRow) fallible(StoreError);
    /// A key was used to make a request, at `at`: its `last_used_at`, no
    /// change of configuration.
    fn touch_key(id: String, at: Time) fallible(StoreError);

    fn account(id: String) -> AccountRow fallible(StoreError);
    fn accounts() -> AccountRows fallible(StoreError);
    fn insert_account(row: AccountRow, change: ChangeRow) -> Bool fallible(StoreError);
    fn update_account(row: AccountRow, change: ChangeRow) fallible(StoreError);

    fn node(id: String) -> NodeRow fallible(StoreError);
    fn nodes() -> NodeRows fallible(StoreError);
    /// Add a row, at assignment version 1.
    fn insert_node(row: NodeRow, change: ChangeRow) -> Bool fallible(StoreError);
    /// Replace the row, its `assignment_version` moved on by one from the
    /// stored one, whatever the row says.
    fn update_node(row: NodeRow, change: ChangeRow) fallible(StoreError);

    /// The seat `<node>/<id>`; `present` false for none.
    fn seat(node: String, id: String) -> SeatRow fallible(StoreError);
    fn seats() -> SeatRows fallible(StoreError);
    /// Add, replace or remove a seat; its node's `assignment_version` moves
    /// on by one with it. Insert is false when the node has the id.
    fn insert_seat(row: SeatRow, change: ChangeRow) -> Bool fallible(StoreError);
    fn update_seat(row: SeatRow, change: ChangeRow) fallible(StoreError);
    fn delete_seat(row: SeatRow, change: ChangeRow) fallible(StoreError);

    /// The change log, as `q` asks; the store numbers each change it
    /// appends.
    fn changes(q: ChangeQuery) -> ChangeRows fallible(StoreError);
    /// The change `id` (`chg_<n>`), whole; `present` false for none.
    fn change(id: String) -> ChangeRow fallible(StoreError);
    /// Up to `limit` changes appended after the one numbered `seq`, oldest
    /// first, whole: what a follower has not been told.
    fn changes_after(seq: Int, limit: Int) -> ChangeRows fallible(StoreError);

    /// Append a request's usage to the ledger. A row with the id the
    /// ledger has is left as it is.
    fn insert_usage(row: UsageRow) fallible(StoreError);
    fn usage(id: String) -> UsageRow fallible(StoreError);
    /// Usage, as `q` asks.
    fn usage_rows(q: UsageQuery) -> UsageRows fallible(StoreError);
    /// Up to `limit` rows written after `seq`, oldest first.
    fn usage_after(seq: Int, limit: Int) -> UsageRows fallible(StoreError);
    /// A request offered to a seat: its row written anew (a new `seq`).
    fn put_flight(row: FlightRow) fallible(StoreError);
    /// The request's attempt ended: its row gone.
    fn drop_flight(request_id: String) fallible(StoreError);
    /// Rows written after `seq`, oldest first, at most `limit`, started in
    /// the last hour: a row an api left behind when it stopped is not one.
    fn flights_after(seq: Int, limit: Int) -> FlightRows fallible(StoreError);
    /// Totals over the matching rows, grouped.
    fn usage_summary(q: UsageSummaryQuery) -> UsageGroups fallible(StoreError);
    /// Totals from the hourly rollup, which each row's insert adds to:
    /// what the ledger holds, read without scanning it.
    fn usage_totals(q: UsageTotalsQuery) -> UsageTotals fallible(StoreError);
    /// The conversations the matching rows are turns of, as `q` asks.
    fn usage_conversations(q: ConversationQuery) -> ConversationRows fallible(StoreError);
    /// What each recipe variant's placements on the same nodes generated
    /// at, as `q` asks: read from the ledger by a placement's seat, never
    /// the whole ledger.
    fn decode_speeds(q: DecodeSpeedQuery) -> DecodeSpeedRows fallible(StoreError);

    /// The route table the brain last wrote (internal.yaml `RouteTable`),
    /// as JSON; "" when none has been.
    fn route_table() -> String fallible(StoreError);

    /// The board the brain last wrote (internal.yaml `Board`, store.md
    /// "The board"), as JSON, with how old it is by the store's clock
    /// (`age_ms`), so a reader on another host judges it stale without
    /// trusting its own clock; "" when none has been.
    fn board() -> String fallible(StoreError);
    /// Write the board: `body` its `models`, `queues` and `seats`, as one
    /// JSON object. Its version is the store's clock in milliseconds, and
    /// always above the one before; the version written.
    fn put_board(body: String) -> Int fallible(StoreError);

    /// The seat `conversation` (32 hex digits of a hash of its key) was
    /// last granted to; `present` false for none.
    fn seat_conversation(conversation: String) -> SeatConversationRow fallible(StoreError);
    /// `conversation`'s turn was granted to `seat` (`<node>/<seat>`), now.
    fn put_seat_conversation(conversation: String, seat: String) fallible(StoreError);
    /// What seat `seat`'s node said its engine holds on a heartbeat sent
    /// after `heard` (`held`, a conversation a line): the seat's rows older
    /// than `heard` go, but for those listed, and each listed points at the
    /// seat as of `heard` unless a later grant moved it elsewhere.
    fn correct_seat_conversations(seat: String, held: String, heard: Time) fallible(StoreError);
    /// Forget the conversations last granted or held before `before`; how
    /// many.
    fn prune_seat_conversations(before: Time) -> Int fallible(StoreError);

    /// The operator token, the admin plane's one credential (api/operator.hl):
    /// the one kept, or `fresh` kept now when none is, so every api over the
    /// store answers to the same token. "" when none is kept and `fresh` is
    /// "".
    fn operator_token(fresh: String) -> String fallible(StoreError);

    /// The habitat grant voice 0.1 kept (migration 13), as its JSON; "" when
    /// none was set. Read once, to give the habitat's project its accounts
    /// when that project is first made (api/tenants.hl).
    fn habitat_grant() -> String fallible(StoreError);

    /// The hosted tools' settings the operator last set (migration 36,
    /// api/web_fetch.hl), as their JSON; "" when none were set.
    fn tool_settings() -> String fallible(StoreError);
    /// Replace them: `body` is their JSON.
    fn put_tool_settings(body: String, change: ChangeRow) fallible(StoreError);

    // ---- the fleet as reported (the node plane's writes; no change log)

    /// The node's state; `present` false until it first registers.
    fn fleet(node: String) -> FleetRow fallible(StoreError);
    /// Replace it: a registration, or what the node reported since.
    fn put_fleet(row: FleetRow) fallible(StoreError);
    /// The node's last sign of life.
    fn beat(node: String) -> Beat fallible(StoreError);
    /// A sign of life now, with its load. Written on every heartbeat, so
    /// it keeps no text of its own.
    fn put_beat(node: String, when: Time, in_flight: Int) fallible(StoreError);
    fn seat_states(node: String) -> SeatStateRows fallible(StoreError);
    /// Replace one seat's state; a store writes it only when it changed.
    fn put_seat_state(row: SeatStateRow) fallible(StoreError);
    /// What the node's store holds, as it last reported; `present` false
    /// until it does.
    fn inventory(node: String) -> InventoryRow fallible(StoreError);
    /// The same with its `blobs` left out: what a node's summary says of
    /// it, read with every report the node makes.
    fn inventory_summary(node: String) -> InventoryRow fallible(StoreError);
    /// Replace it with what the node reported now.
    fn put_inventory(row: InventoryRow) fallible(StoreError);
    /// The newest link checks, newest first, at most 64.
    fn link_checks() -> LinkCheckRows fallible(StoreError);
    /// Add a check; both its nodes' `assignment_version`s move on with it,
    /// so each is sent its rank.
    fn insert_link_check(row: LinkCheckRow) fallible(StoreError);
    /// Write node `node`'s rank's result (`result`) into check `id`, if
    /// it has a rank there and has reported none yet, in one write that
    /// touches its rank's alone, so the two ranks reporting at once both
    /// keep theirs; true when it was written.
    fn put_link_result(id: String, node: String, result: String) -> Bool fallible(StoreError);
    /// An account's provider windows, the JSON array an engine last
    /// reported, "" for none.
    /// Record a request whole; those past `PEEK_DAYS` go.
    fn put_peek(row: PeekRow) fallible(StoreError);
    /// Recorded requests, a page of those `q` names (`PeekQuery`), their
    /// bodies left out.
    fn peeks(q: PeekQuery) -> PeekRows fallible(StoreError);
    /// One recorded request whole; `present` false when there is none.
    fn peek(request_id: String) -> PeekRow fallible(StoreError);

    fn windows(account: String) -> String fallible(StoreError);
    fn put_windows(account: String, json: String) fallible(StoreError);
}

// ---- in memory -------------------------------------------------------

@form(hashmap)
locus FleetTable { capacity { pool rows of FleetRow indexed_by node; } }

@form(hashmap)
locus InventoryTable { capacity { pool rows of InventoryRow indexed_by node; } }

@form(hashmap)
locus SeatStateTable { capacity { pool rows of SeatStateRow indexed_by ref; } }

/// An account's windows, as JSON.
type WindowRow { account: String = ""; json: String = ""; present: Bool = false; }

@form(hashmap)
locus WindowTable { capacity { pool rows of WindowRow indexed_by account; } }

@form(hashmap)
locus ModelTable { capacity { pool rows of ModelRow indexed_by id; } }

@form(hashmap)
locus RecipeTable { capacity { pool rows of RecipeRow indexed_by id; } }

@form(hashmap)
locus RuntimeTable { capacity { pool rows of RuntimeRow indexed_by id; } }

@form(hashmap)
locus PlacementTable { capacity { pool rows of PlacementRow indexed_by id; } }

@form(hashmap)
locus ProjectTable { capacity { pool rows of ProjectRow indexed_by id; } }

@form(hashmap)
locus KeyTable { capacity { pool rows of KeyRow indexed_by id; } }

/// A secret's digest, pointing at its key.
type DigestRow { digest: String = ""; key: String = ""; present: Bool = false; }

@form(hashmap)
locus DigestTable { capacity { pool rows of DigestRow indexed_by digest; } }

@form(hashmap)
locus AccountTable { capacity { pool rows of AccountRow indexed_by id; } }

@form(hashmap)
locus NodeTable { capacity { pool rows of NodeRow indexed_by id; } }

@form(hashmap)
locus SeatTable { capacity { pool rows of SeatRow indexed_by ref; } }

/// Ids in the order they were added: a hashmap iterates in bucket order.
@form(vec)
locus IdOrder { capacity { heap rows of String; } }

@form(vec)
locus ChangeLog { capacity { heap rows of ChangeRow; } }

@form(vec)
locus UsageLog { capacity { heap rows of UsageRow; } }

/// A request id's place in the usage log.
type UsageSlot { id: String = ""; seq: Int = 0; present: Bool = false; }

@form(hashmap)
locus UsageSlots { capacity { pool rows of UsageSlot indexed_by id; } }

/// The hourly rollup, by its key (`HourlyRow.id`).
@form(hashmap)
locus HourlyTable { capacity { pool rows of HourlyRow indexed_by id; } }

/// The rows in the process. Bounded as the lists it answers are.
///
/// Its writes are `@unbounded`, which `hale verify` asks of a hashmap write
/// in a long-lived locus; measured, a replaced row does not grow the
/// process (FRICTION.md). The change log only grows, as a log does.
locus MemoryStore {
    params {
        model_rows: ModelTable = ModelTable { };
        model_order: IdOrder = IdOrder { };
        recipe_rows: RecipeTable = RecipeTable { };
        recipe_order: IdOrder = IdOrder { };
        runtime_rows: RuntimeTable = RuntimeTable { };
        runtime_order: IdOrder = IdOrder { };
        placement_rows: PlacementTable = PlacementTable { };
        placement_order: IdOrder = IdOrder { };
        project_rows: ProjectTable = ProjectTable { };
        project_order: IdOrder = IdOrder { };
        key_rows: KeyTable = KeyTable { };
        key_order: IdOrder = IdOrder { };
        digests: DigestTable = DigestTable { };
        account_rows: AccountTable = AccountTable { };
        account_order: IdOrder = IdOrder { };
        node_rows: NodeTable = NodeTable { };
        node_order: IdOrder = IdOrder { };
        seat_rows: SeatTable = SeatTable { };
        seat_order: IdOrder = IdOrder { };
        log: ChangeLog = ChangeLog { };
        usage_log: UsageLog = UsageLog { };
        usage_slots: UsageSlots = UsageSlots { };
        // the ledger summed by the hour, as each row is written, and the
        // rollup's keys in the order they were first written
        hourly_rows: HourlyTable = HourlyTable { };
        hourly_order: IdOrder = IdOrder { };
        fleet_rows: FleetTable = FleetTable { };
        inventory_rows: InventoryTable = InventoryTable { };
        // a node's last beat, by its place in `node_order`: scalars set in
        // place, so a heartbeat allocates nothing
        beat_ns: bounded[Int; 64];
        beat_load: bounded[Int; 64];
        seat_state_rows: SeatStateTable = SeatStateTable { };
        // link checks, newest first, the last 64
        link_check_rows: LinkCheckRows = LinkCheckRows { };
        arrangement_rows: ArrangementRows = ArrangementRows { };
        window_rows: WindowTable = WindowTable { };
        // recorded requests, newest first, the last 200 (peek.hl)
        peek_rows: PeekRows = PeekRows { };
        // requests being served now, and the last `seq` given one
        flight_rows: FlightRows = FlightRows { };
        flight_seq: Int = 0;
        // the operator token: a standalone api's is kept in its state
        // directory and handed in here (api/operator.hl)
        operator: String = "";
        habitat_grant: String = "";
        // the hosted tools' settings, "" for none set
        tool_settings: String = "";
        // the board, "" until one is written: its body, version and time
        board_body: String = "";
        board_version: Int = 0;
        board_at: Time = `1970-01-01T00:00:00Z`;
        // each conversation's seat, oldest first
        conversation_rows: SeatConversationRows = SeatConversationRows { };
    }

    fn kind() -> String { return "memory"; }

    /// One api holds every write on its own: nothing to wait for.
    fn hold(target: String) fallible(StoreError) { }

    fn let_go() { }
    fn ready() -> Bool { return true; }

    // ---- the catalog

    fn model(id: String) -> ModelRow fallible(StoreError) {
        return self.model_rows.get(id) or ModelRow { };
    }

    @bounded_by(self.model_rows)
    fn models() -> ModelRows fallible(StoreError) {
        let mut out = ModelRows { };
        let mut i = 0;
        while i < self.model_order.len() {
            let id = self.model_order.get(i) or "";
            push(out.rows, self.model_rows.get(id) or ModelRow { }) or discard;
            i = i + 1;
        }
        return out;
    }

    @unbounded
    fn insert_model(row: ModelRow, change: ChangeRow) -> Bool fallible(StoreError) {
        let cur = self.model_rows.get(row.id) or ModelRow { };
        if cur.present { return false; }
        if self.model_order.len() >= 256 {
            fail StoreError { kind: "full", message: "the catalog holds at most 256 models" };
        }
        let mut r = row;
        r.present = true;
        self.model_rows.set(r);
        self.model_order.push(r.id);
        self.append(change);
        return true;
    }

    @unbounded
    fn update_model(row: ModelRow, change: ChangeRow) fallible(StoreError) {
        let mut r = row;
        r.present = true;
        self.model_rows.set(r);
        self.append(change);
    }

    // ---- recipes

    fn recipe(id: String) -> RecipeRow fallible(StoreError) {
        return self.recipe_rows.get(id) or RecipeRow { };
    }

    @bounded_by(self.recipe_rows)
    fn recipes() -> RecipeRows fallible(StoreError) {
        let mut out = RecipeRows { };
        let mut i = 0;
        while i < self.recipe_order.len() {
            let id = self.recipe_order.get(i) or "";
            push(out.rows, self.recipe_rows.get(id) or RecipeRow { }) or discard;
            i = i + 1;
        }
        return out;
    }

    @unbounded
    fn insert_recipe(row: RecipeRow, change: ChangeRow) -> Bool fallible(StoreError) {
        let cur = self.recipe_rows.get(row.id) or RecipeRow { };
        if cur.present { return false; }
        if self.recipe_order.len() >= 256 {
            fail StoreError { kind: "full", message: "voice holds at most 256 recipes" };
        }
        let mut r = row;
        r.present = true;
        self.recipe_rows.set(r);
        self.recipe_order.push(r.id);
        self.append(change);
        return true;
    }

    @unbounded
    fn remove_recipe(row: RecipeRow, change: ChangeRow) fallible(StoreError) {
        let mut r = self.recipe_rows.get(row.id) or RecipeRow { };
        if !r.present { return; }
        r.removed = true;
        r.removed_at = row.removed_at;
        self.recipe_rows.set(r);
        self.append(change);
    }

    // ---- runtimes

    fn runtime(id: String) -> RuntimeRow fallible(StoreError) {
        return self.runtime_rows.get(id) or RuntimeRow { };
    }

    @bounded_by(self.runtime_rows)
    fn runtimes() -> RuntimeRows fallible(StoreError) {
        let mut out = RuntimeRows { };
        let mut i = 0;
        while i < self.runtime_order.len() {
            let id = self.runtime_order.get(i) or "";
            push(out.rows, self.runtime_rows.get(id) or RuntimeRow { }) or discard;
            i = i + 1;
        }
        return out;
    }

    @unbounded
    fn insert_runtime(row: RuntimeRow, change: ChangeRow) -> Bool fallible(StoreError) {
        let cur = self.runtime_rows.get(row.id) or RuntimeRow { };
        if cur.present { return false; }
        if self.runtime_order.len() >= 64 {
            fail StoreError { kind: "full", message: "voice holds at most 64 runtimes" };
        }
        let mut r = row;
        r.present = true;
        self.runtime_rows.set(r);
        self.runtime_order.push(r.id);
        self.append(change);
        return true;
    }

    @unbounded
    fn remove_runtime(row: RuntimeRow, change: ChangeRow) fallible(StoreError) {
        let mut r = self.runtime_rows.get(row.id) or RuntimeRow { };
        if !r.present { return; }
        r.removed = true;
        r.removed_at = row.removed_at;
        self.runtime_rows.set(r);
        self.append(change);
    }

    // ---- placements

    fn placement(id: String) -> PlacementRow fallible(StoreError) {
        return self.placement_rows.get(id) or PlacementRow { };
    }

    @bounded_by(self.placement_rows)
    fn placements() -> PlacementRows fallible(StoreError) {
        let mut out = PlacementRows { };
        let mut i = 0;
        while i < self.placement_order.len() {
            let id = self.placement_order.get(i) or "";
            push(out.rows, self.placement_rows.get(id) or PlacementRow { }) or discard;
            i = i + 1;
        }
        return out;
    }

    @unbounded
    fn insert_placement(row: PlacementRow, change: ChangeRow) -> Bool fallible(StoreError) {
        let cur = self.placement_rows.get(row.id) or PlacementRow { };
        if cur.present { return false; }
        if self.placement_order.len() >= 256 {
            fail StoreError { kind: "full", message: "voice holds at most 256 placements" };
        }
        let mut r = row;
        r.present = true;
        self.placement_rows.set(r);
        self.placement_order.push(r.id);
        self.append(change);
        return true;
    }

    @unbounded
    fn remove_placement(row: PlacementRow, change: ChangeRow) fallible(StoreError) {
        let mut r = self.placement_rows.get(row.id) or PlacementRow { };
        if !r.present { return; }
        r.removed = true;
        r.removed_at = row.removed_at;
        self.placement_rows.set(r);
        self.append(change);
    }

    // ---- projects

    fn project(id: String) -> ProjectRow fallible(StoreError) {
        return self.project_rows.get(id) or ProjectRow { };
    }

    @bounded_by(self.project_rows)
    fn projects() -> ProjectRows fallible(StoreError) {
        let mut out = ProjectRows { };
        let mut i = 0;
        while i < self.project_order.len() {
            let id = self.project_order.get(i) or "";
            push(out.rows, self.project_rows.get(id) or ProjectRow { }) or discard;
            i = i + 1;
        }
        return out;
    }

    @unbounded
    fn insert_project(row: ProjectRow, change: ChangeRow) -> Bool fallible(StoreError) {
        let cur = self.project_rows.get(row.id) or ProjectRow { };
        if cur.present { return false; }
        if self.project_order.len() >= 64 {
            fail StoreError { kind: "full", message: "voice holds at most 64 projects" };
        }
        let mut r = row;
        r.present = true;
        self.project_rows.set(r);
        self.project_order.push(r.id);
        // its own key for the requests voice makes for it, made with it
        let k = system_key_row(r.id, r.created_at);
        self.key_rows.set(k);
        self.key_order.push(k.id);
        self.append(change);
        return true;
    }

    @unbounded
    fn update_project(row: ProjectRow, change: ChangeRow) fallible(StoreError) {
        let mut r = row;
        r.present = true;
        self.project_rows.set(r);
        self.append(change);
    }

    @unbounded
    fn archive_project(
        row: ProjectRow,
        change: ChangeRow,
        revoked: Revocations
    ) fallible(StoreError) {
        for k in revoked.keys {
            let mut gone = k;
            gone.present = true;
            self.key_rows.set(gone);
        }
        for c in revoked.changes {
            self.append(c);
        }
        let mut r = row;
        r.present = true;
        self.project_rows.set(r);
        self.append(change);
    }

    // ---- keys

    fn key(id: String) -> KeyRow fallible(StoreError) {
        return self.key_rows.get(id) or KeyRow { };
    }

    fn key_by_digest(digest: String) -> KeyRow fallible(StoreError) {
        // no token digests to nothing: a system key, which has none, is
        // named by none
        if len(digest) == 0 { return KeyRow { }; }
        let d = self.digests.get(digest) or DigestRow { };
        if !d.present { return KeyRow { }; }
        return self.key_rows.get(d.key) or KeyRow { };
    }

    @bounded_by(self.key_rows)
    fn keys(project: String) -> KeyRows fallible(StoreError) {
        let mut out = KeyRows { };
        let mut i = 0;
        while i < self.key_order.len() {
            let id = self.key_order.get(i) or "";
            let k = self.key_rows.get(id) or KeyRow { };
            if k.project == project { push(out.rows, k) or discard; }
            i = i + 1;
        }
        return out;
    }

    @unbounded
    fn insert_key(row: KeyRow, change: ChangeRow) -> Bool fallible(StoreError) {
        let cur = self.key_rows.get(row.id) or KeyRow { };
        if cur.present { return false; }
        let held = self.keys(row.project) or KeyRows { };
        if count(held.rows) >= 64 {
            fail StoreError { kind: "full", message: "a project holds at most 64 keys" };
        }
        let mut r = row;
        r.present = true;
        self.key_rows.set(r);
        self.key_order.push(r.id);
        self.digests.set(DigestRow { digest: r.digest, key: r.id, present: true });
        self.append(change);
        return true;
    }

    @unbounded
    fn update_key(row: KeyRow, change: ChangeRow) fallible(StoreError) {
        let mut r = row;
        r.present = true;
        self.key_rows.set(r);
        self.append(change);
    }

    @unbounded
    fn touch_key(id: String, at: Time) fallible(StoreError) {
        let mut k = self.key_rows.get(id) or KeyRow { };
        if !k.present { return; }
        k.used = true;
        k.last_used_at = at;
        self.key_rows.set(k);
    }

    // ---- accounts

    fn account(id: String) -> AccountRow fallible(StoreError) {
        return self.account_rows.get(id) or AccountRow { };
    }

    @bounded_by(self.account_rows)
    fn accounts() -> AccountRows fallible(StoreError) {
        let mut out = AccountRows { };
        let mut i = 0;
        while i < self.account_order.len() {
            let id = self.account_order.get(i) or "";
            push(out.rows, self.account_rows.get(id) or AccountRow { }) or discard;
            i = i + 1;
        }
        return out;
    }

    @unbounded
    fn insert_account(row: AccountRow, change: ChangeRow) -> Bool fallible(StoreError) {
        let cur = self.account_rows.get(row.id) or AccountRow { };
        if cur.present { return false; }
        if self.account_order.len() >= 64 {
            fail StoreError { kind: "full", message: "voice holds at most 64 accounts" };
        }
        let mut r = row;
        r.present = true;
        self.account_rows.set(r);
        self.account_order.push(r.id);
        self.append(change);
        return true;
    }

    @unbounded
    fn update_account(row: AccountRow, change: ChangeRow) fallible(StoreError) {
        let mut r = row;
        r.present = true;
        self.account_rows.set(r);
        self.append(change);
    }

    // ---- nodes and seats

    fn node(id: String) -> NodeRow fallible(StoreError) {
        return self.node_rows.get(id) or NodeRow { };
    }

    @bounded_by(self.node_rows)
    fn nodes() -> NodeRows fallible(StoreError) {
        let mut out = NodeRows { };
        let mut i = 0;
        while i < self.node_order.len() {
            let id = self.node_order.get(i) or "";
            push(out.rows, self.node_rows.get(id) or NodeRow { }) or discard;
            i = i + 1;
        }
        return out;
    }

    @unbounded
    fn insert_node(row: NodeRow, change: ChangeRow) -> Bool fallible(StoreError) {
        let cur = self.node_rows.get(row.id) or NodeRow { };
        if cur.present { return false; }
        if self.node_order.len() >= 64 {
            fail StoreError { kind: "full", message: "voice holds at most 64 nodes" };
        }
        let mut r = row;
        r.present = true;
        r.assignment_version = 1;
        self.node_rows.set(r);
        self.node_order.push(r.id);
        self.append(change);
        return true;
    }

    @unbounded
    fn update_node(row: NodeRow, change: ChangeRow) fallible(StoreError) {
        let mut r = row;
        let stored = self.node_rows.get(row.id) or NodeRow { };
        r.assignment_version = stored.assignment_version + 1;
        r.present = true;
        self.node_rows.set(r);
        self.append(change);
    }

    fn seat(node: String, id: String) -> SeatRow fallible(StoreError) {
        return self.seat_rows.get(node + "/" + id) or SeatRow { };
    }

    @bounded_by(self.seat_rows)
    fn seats() -> SeatRows fallible(StoreError) {
        let mut out = SeatRows { };
        let mut i = 0;
        while i < self.seat_order.len() {
            let ref = self.seat_order.get(i) or "";
            let s = self.seat_rows.get(ref) or SeatRow { };
            if s.present { push(out.rows, s) or discard; }
            i = i + 1;
        }
        return out;
    }

    @unbounded
    fn insert_seat(row: SeatRow, change: ChangeRow) -> Bool fallible(StoreError) {
        let ref = row.node + "/" + row.id;
        let cur = self.seat_rows.get(ref) or SeatRow { };
        if cur.present { return false; }
        let all = self.seats() or SeatRows { };
        if count(all.rows) >= 256 {
            fail StoreError { kind: "full", message: "voice holds at most 256 seats" };
        }
        let mut r = row;
        r.ref = ref;
        r.present = true;
        self.seat_rows.set(r);
        if !self.seen(ref) { self.seat_order.push(ref); }
        self.bump(row.node);
        self.append(change);
        return true;
    }

    @unbounded
    fn update_seat(row: SeatRow, change: ChangeRow) fallible(StoreError) {
        let mut r = row;
        r.ref = row.node + "/" + row.id;
        r.present = true;
        self.seat_rows.set(r);
        self.bump(row.node);
        self.append(change);
    }

    @unbounded
    fn delete_seat(row: SeatRow, change: ChangeRow) fallible(StoreError) {
        let mut r = row;
        r.ref = row.node + "/" + row.id;
        r.present = false;
        self.seat_rows.set(r);
        self.bump(row.node);
        self.append(change);
    }

    /// True when `ref` was ever a seat here: a seat removed and added again
    /// keeps its place in the order.
    fn seen(ref: String) -> Bool {
        let mut i = 0;
        while i < self.seat_order.len() {
            if (self.seat_order.get(i) or "") == ref { return true; }
            i = i + 1;
        }
        return false;
    }

    /// A change to a node's seats is a new assignment for the node.
    @unbounded
    fn bump(node: String) {
        let mut n = self.node_rows.get(node) or NodeRow { };
        if !n.present { return; }
        n.assignment_version = n.assignment_version + 1;
        self.node_rows.set(n);
    }

    // ---- the change log

    @unbounded
    fn append(change: ChangeRow) {
        let mut c = change;
        c.seq = self.log.len() + 1;
        c.id = "chg_" + pad(c.seq, 6);
        self.log.push(c);
    }

    // ---- the usage ledger

    @unbounded
    fn insert_usage(row: UsageRow) fallible(StoreError) {
        if (self.usage_slots.get(row.id) or UsageSlot { }).present { return; }
        let mut r = row;
        r.seq = self.usage_log.len() + 1;
        r.present = true;
        self.usage_log.push(r);
        self.usage_slots.set(UsageSlot { id: r.id, seq: r.seq, present: true });
        self.add_hourly(r);
    }

    /// `r` added to its hour of the rollup, with the row, as the Postgres
    /// store's insert adds it (`usage_hourly_add`): a row the ledger had
    /// already is never added again.
    @unbounded
    fn add_hourly(r: UsageRow) {
        let model = group_value(r, "model");
        let hour = hour_of(r.created_at);
        let id = r.project + "\n" + r.key + "\n" + model + "\n" + r.currency + "\n"
            + std::time::iso8601(hour);
        let cur = self.hourly_rows.get(id) or HourlyRow { };
        if !cur.present { self.hourly_order.push(id); }
        self.hourly_rows.set(
            HourlyRow {
                id: id,
                project: r.project,
                key: r.key,
                model: model,
                currency: r.currency,
                hour: hour,
                requests: cur.requests + 1,
                failed: cur.failed + (if failed_status(r.status) { 1 } else { 0 }),
                input_tokens: cur.input_tokens + r.input_tokens,
                cached_input_tokens: cur.cached_input_tokens + r.cached_input_tokens,
                output_tokens: cur.output_tokens + r.output_tokens,
                reasoning_tokens: cur.reasoning_tokens + r.reasoning_tokens,
                price_micros: cur.price_micros + r.price_micros,
                present: true,
            },
        );
    }

    fn usage_totals(q: UsageTotalsQuery) -> UsageTotals fallible(StoreError) {
        for f in q.by.items {
            if !valid_total_group(f) {
                fail StoreError { kind: "invalid", message: "no total group " + f };
            }
        }
        let from = if q.has_from { std::time::unix(hour_of(q.from)) } else { 0 };
        let mut out = TotalsSorted { };
        let mut i = 0;
        while i < self.hourly_order.len() {
            let h = self.hourly_rows.get(self.hourly_order.get(i) or "") or HourlyRow { };
            i = i + 1;
            if !hourly_matches(h, q, from) { continue; }
            out = total_added(out, h, q.by);
        }
        let mut totals = UsageTotals { };
        for t in out.rows {
            push(totals.rows, t) or discard;
        }
        return totals;
    }

    @unbounded
    fn decode_speeds(q: DecodeSpeedQuery) -> DecodeSpeedRows fallible(StoreError) {
        let since = std::time::unix(q.since);
        // each group, by its recipe, variant and nodes, in that order
        let mut keys = DecodeKeys { };
        let mut i = 0;
        while i < self.placement_order.len() {
            let p = self.placement_rows.get(self.placement_order.get(i) or "") or PlacementRow { };
            i = i + 1;
            if p.removed && std::time::unix(p.removed_at) <= since { continue; }
            keys = decode_key_added(keys, decode_key(p.body));
        }
        let mut out = DecodeSpeedRows { };
        for key in keys.items {
            let mut xs: [Int; 4096] = [0; 4096];
            let mut n = 0;
            let mut first = 0;
            let mut last = 0;
            let mut j = 0;
            while j < self.placement_order.len() {
                let p = self.placement_rows.get(
                    self.placement_order.get(j) or "",
                ) or PlacementRow { };
                j = j + 1;
                if p.removed && std::time::unix(p.removed_at) <= since { continue; }
                if decode_key(p.body) != key { continue; }
                let seat = std::json::find_string_field(p.body, "seat");
                let from = if std::time::unix(p.created_at) > since {
                    std::time::unix(p.created_at)
                } else {
                    since
                };
                // the seat's newest first, as many as `per_seat`
                let mut taken = 0;
                let mut k = self.usage_log.len();
                while k > 0 && taken < q.per_seat && n < DECODE_SAMPLES {
                    k = k - 1;
                    let r = self.usage_log.get(k) or UsageRow { };
                    let t = std::time::unix(r.created_at);
                    if r.seat != seat || t < from { continue; }
                    if p.removed && t >= std::time::unix(p.removed_at) { continue; }
                    let m = decode_milli(r, q);
                    if m < 0 { continue; }
                    // kept sorted as it is added
                    let mut at_i = n;
                    while at_i > 0 && xs[at_i - 1] > m {
                        xs[at_i] = xs[at_i - 1];
                        at_i = at_i - 1;
                    }
                    xs[at_i] = m;
                    n = n + 1;
                    taken = taken + 1;
                    if first == 0 || t < first { first = t; }
                    if t > last { last = t; }
                }
            }
            if n == 0 { continue; }
            let a = std::str::index_of(key, "\n");
            let rest = key[(a + 1)..len(key)];
            let b = std::str::index_of(rest, "\n");
            push(out.rows, DecodeSpeedRow {
                recipe: key[0..a],
                variant: rest[0..b],
                nodes: rest[(b + 1)..len(rest)],
                requests: n,
                p25_tps: percentile_whole(xs, n, 1, 4),
                median_tps: percentile_whole(xs, n, 1, 2),
                p75_tps: percentile_whole(xs, n, 3, 4),
                first_at: std::time::time_from_unix(first),
                last_at: std::time::time_from_unix(last),
            }) or discard;
        }
        return out;
    }

    fn usage(id: String) -> UsageRow fallible(StoreError) {
        let slot = self.usage_slots.get(id) or UsageSlot { };
        if !slot.present { return UsageRow { }; }
        return self.usage_log.get(slot.seq - 1) or UsageRow { };
    }

    @bounded_by(self.usage_log)
    fn usage_rows(q: UsageQuery) -> UsageRows fallible(StoreError) {
        let mut out = UsageRows { };
        let limit = if q.limit < 1 { 100 } else if q.limit > 1000 { 1000 } else { q.limit };
        let mut i = self.usage_log.len() - 1;
        while i >= 0 {
            let r = self.usage_log.get(i) or UsageRow { };
            if (q.cursor <= 0 || r.seq < q.cursor) && usage_matches(r, q) {
                if count(out.rows) >= limit {
                    out.more = true;
                    return out;
                }
                push(out.rows, r) or discard;
            }
            i = i - 1;
        }
        return out;
    }

    @bounded_by(self.usage_log)
    fn usage_after(seq: Int, limit: Int) -> UsageRows fallible(StoreError) {
        let mut out = UsageRows { };
        let mut i = if seq < 0 { 0 } else { seq };
        while i < self.usage_log.len() && count(out.rows) < limit {
            push(out.rows, self.usage_log.get(i) or UsageRow { }) or discard;
            i = i + 1;
        }
        return out;
    }

    @bounded_by(self.usage_log)
    fn usage_summary(s: UsageSummaryQuery) -> UsageGroups fallible(StoreError) {
        let mut out = UsageGroups { };
        for f in s.by.items {
            if !valid_group(f) { fail StoreError { kind: "invalid", message: "no group " + f }; }
        }
        // newest first, so a group is first met at its latest request, the
        // groups come most recently active first, and those past the cap
        // are the least recent
        let mut i = self.usage_log.len();
        while i > 0 {
            i = i - 1;
            let r = self.usage_log.get(i) or UsageRow { };
            if !usage_matches(r, s.q) { continue; }
            let mut g = "";
            for f in s.by.items {
                g = g + (if len(g) > 0 { ", " } else { "" }) + "\"" + f + "\": \""
                    + std::json::escape_string(group_value(r, f)) + "\"";
            }
            g = "{" + g + "}";
            let mut n = 0;
            let mut found = -1;
            while n < count(out.rows) {
                let u = at(out.rows, n) or UsageGroup { };
                if u.group == g && u.currency == r.currency { found = n; break; }
                n = n + 1;
            }
            if found < 0 {
                if count(out.rows) >= SUMMARY_GROUPS { continue; }
                push(
                    out.rows,
                    UsageGroup {
                        group: g,
                        currency: r.currency,
                        last_at: r.created_at,
                        last_request: r.id,
                    },
                ) or discard;
                found = count(out.rows) - 1;
            }
            let u = at(out.rows, found) or UsageGroup { };
            // the group with this request counted, a new value rather than
            // a written copy; read newest first, so this is the earliest
            set(
                out.rows,
                found,
                UsageGroup {
                    group: u.group,
                    requests: u.requests + 1,
                    input_tokens: u.input_tokens + r.input_tokens,
                    output_tokens: u.output_tokens + r.output_tokens,
                    price_micros: u.price_micros + r.price_micros,
                    currency: u.currency,
                    first_at: r.created_at,
                    last_at: u.last_at,
                    last_request: u.last_request,
                },
            ) or discard;
        }
        return out;
    }

    @unbounded
    fn usage_conversations(c: ConversationQuery) -> ConversationRows fallible(StoreError) {
        let mut groups = ConversationGroups { };
        // newest first, so a conversation is first met at its latest row
        // and the groups come most recently active first; past the cap,
        // the least recent are left out, as a summary's are
        let mut i = self.usage_log.len();
        while i > 0 {
            i = i - 1;
            let r = self.usage_log.get(i) or UsageRow { };
            let conversation = conversation_of(r);
            if len(conversation) == 0 || !usage_matches(r, c.q) { continue; }
            let mut found = -1;
            let mut n = 0;
            while n < count(groups.rows) {
                let g = at(groups.rows, n) or ConversationRow { };
                if g.project == r.project && g.conversation == conversation
                    && g.currency == r.currency
                {
                    found = n;
                    break;
                }
                n = n + 1;
            }
            if found < 0 {
                if count(groups.rows) >= SUMMARY_GROUPS { continue; }
                push(
                    groups.rows,
                    ConversationRow {
                        project: r.project,
                        conversation: conversation,
                        currency: r.currency,
                        last_at: r.created_at,
                        last_seq: r.seq,
                        last_request: r.id,
                        last_status: r.status,
                    },
                ) or discard;
                found = count(groups.rows) - 1;
            }
            let g = at(groups.rows, found) or ConversationRow { };
            // the conversation with this row counted, a new value rather
            // than a written copy; read newest first, so this is the earliest
            set(
                groups.rows,
                found,
                ConversationRow {
                    project: g.project,
                    conversation: g.conversation,
                    currency: g.currency,
                    keys: name_added(g.keys, r.key),
                    models: name_added(
                        g.models,
                        if len(r.served_model) > 0 { r.served_model } else { r.requested_model },
                    ),
                    requests: g.requests + 1,
                    failed: g.failed + (if failed_status(r.status) { 1 } else { 0 }),
                    input_tokens: g.input_tokens + r.input_tokens,
                    cached_input_tokens: g.cached_input_tokens + r.cached_input_tokens,
                    output_tokens: g.output_tokens + r.output_tokens,
                    reasoning_tokens: g.reasoning_tokens + r.reasoning_tokens,
                    price_micros: g.price_micros + r.price_micros,
                    first_at: r.created_at,
                    last_at: g.last_at,
                    last_seq: g.last_seq,
                    last_request: g.last_request,
                    last_status: g.last_status,
                },
            ) or discard;
        }
        let limit = if c.limit < 1 { 40 } else if c.limit > 100 { 100 } else { c.limit };
        let mut out = ConversationRows { };
        for g in groups.rows {
            if c.cursor > 0 && g.last_seq >= c.cursor { continue; }
            if c.has_failures && g.failed == 0 { continue; }
            if count(out.rows) >= limit {
                out.more = true;
                return out;
            }
            push(out.rows, g) or discard;
        }
        return out;
    }

    /// No brain writes to the memory store.
    fn route_table() -> String fallible(StoreError) { return ""; }

    fn board() -> String fallible(StoreError) {
        if len(self.board_body) == 0 { return ""; }
        let age = (std::time::nanos(std::time::current()) - std::time::nanos(self.board_at))
            / 1000000;
        let head = "{\"version\": " + to_string(self.board_version) + ", \"at\": \""
            + std::time::iso8601(self.board_at) + "\", \"age_ms\": "
            + to_string(if age > 0 { age } else { 0 });
        let rest = std::str::trim(self.board_body[1..len(self.board_body)]);
        return head + (if rest == "}" { "}" } else { ", " + rest });
    }

    fn put_board(body: String) -> Int fallible(StoreError) {
        if !std::json::valid_object(body) {
            fail StoreError { message: "the board is not one JSON object" };
        }
        let now = std::time::current();
        let ms = std::time::nanos(now) / 1000000;
        self.board_version = if ms > self.board_version { ms } else { self.board_version + 1 };
        self.board_at = now;
        self.board_body = std::str::trim(body);
        return self.board_version;
    }

    fn seat_conversation(conversation: String) -> SeatConversationRow fallible(StoreError) {
        for r in self.conversation_rows.rows {
            if r.conversation == conversation { return r; }
        }
        return SeatConversationRow { };
    }

    fn put_seat_conversation(conversation: String, seat: String) fallible(StoreError) {
        if !conversation_hash(conversation) {
            fail StoreError {
                message: "a conversation is 32 lower-case hex digits: " + conversation,
            };
        }
        let mut held = false;
        for r in self.conversation_rows.rows {
            if r.conversation == conversation { held = true; }
        }
        // the rest, oldest first, but the oldest when the store is full
        let mut drop = !held && count(self.conversation_rows.rows) >= SEAT_CONVERSATIONS_KEPT;
        let mut next = SeatConversationRows { };
        for r in self.conversation_rows.rows {
            if r.conversation == conversation { continue; }
            if drop {
                drop = false;
                continue;
            }
            push(next.rows, r) or discard;
        }
        push(
            next.rows,
            SeatConversationRow {
                present: true,
                conversation: conversation,
                seat: seat,
                at: std::time::current(),
            },
        ) or discard;
        self.conversation_rows = next;
    }

    @unbounded
    fn correct_seat_conversations(seat: String, held: String, heard: Time) fallible(StoreError) {
        let listed = "\n" + held + (if std::str::ends_with(held, "\n") { "" } else { "\n" });
        let mut next = SeatConversationRows { };
        for r in self.conversation_rows.rows {
            let mine = std::str::contains(listed, "\n" + r.conversation + "\n");
            if r.seat == seat && !mine && std::time::nanos(r.at) < std::time::nanos(heard) {
                continue;
            }
            if mine && std::time::nanos(r.at) < std::time::nanos(heard) {
                push(
                    next.rows,
                    SeatConversationRow {
                        present: true,
                        conversation: r.conversation,
                        seat: seat,
                        at: heard,
                    },
                ) or discard;
            } else {
                push(next.rows, r) or discard;
            }
        }
        // those listed it held no row of
        let v = std::str::bytes_view(held);
        let mut at = 0;
        while at < v.n {
            let rest = std::str::slice(v, at, v.n);
            let nl = std::str::index_of(rest, "\n");
            let end = if nl < 0 { v.n } else { at + nl };
            let c = std::str::slice(v, at, end);
            at = end + 1;
            let mut known = false;
            for r in next.rows {
                if r.conversation == c { known = true; }
            }
            if conversation_hash(c) && !known && count(next.rows) < SEAT_CONVERSATIONS_KEPT {
                push(
                    next.rows,
                    SeatConversationRow { present: true, conversation: c, seat: seat, at: heard },
                ) or discard;
            }
        }
        self.conversation_rows = next;
    }

    @unbounded
    fn prune_seat_conversations(before: Time) -> Int fallible(StoreError) {
        let mut next = SeatConversationRows { };
        let mut gone = 0;
        for r in self.conversation_rows.rows {
            if std::time::nanos(r.at) < std::time::nanos(before) {
                gone = gone + 1;
            } else {
                push(next.rows, r) or discard;
            }
        }
        self.conversation_rows = next;
        return gone;
    }

    fn operator_token(fresh: String) -> String fallible(StoreError) {
        if len(self.operator) == 0 { self.operator = fresh; }
        return self.operator;
    }

    fn habitat_grant() -> String fallible(StoreError) { return self.habitat_grant; }

    fn tool_settings() -> String fallible(StoreError) { return self.tool_settings; }

    fn put_tool_settings(body: String, change: ChangeRow) fallible(StoreError) {
        self.tool_settings = body;
        self.append(change);
    }

    fn changes(q: ChangeQuery) -> ChangeRows fallible(StoreError) {
        let mut out = ChangeRows { };
        let limit = if q.limit < 1 { 100 } else if q.limit > 1000 { 1000 } else { q.limit };
        let mut started = len(q.cursor) == 0;
        let mut i = self.log.len() - 1;
        while i >= 0 {
            let c = self.log.get(i) or ChangeRow { };
            if !started {
                if c.id == q.cursor { started = true; }
            } else if matches(c, q) {
                if count(out.rows) >= limit {
                    out.more = true;
                    return out;
                }
                let mut kept = c;
                if !q.bodies {
                    kept.before = "";
                    kept.after = "";
                }
                push(out.rows, kept) or discard;
            }
            i = i - 1;
        }
        if !started { out.cursor_known = false; }
        return out;
    }

    fn change(id: String) -> ChangeRow fallible(StoreError) {
        let n = change_number(id);
        if n < 1 || n > self.log.len() { return ChangeRow { }; }
        let c = self.log.get(n - 1) or ChangeRow { };
        if c.id != id { return ChangeRow { }; }
        let mut out = c;
        out.present = true;
        return out;
    }

    @bounded_by(self.log)
    fn changes_after(seq: Int, limit: Int) -> ChangeRows fallible(StoreError) {
        let mut out = ChangeRows { };
        let mut i = if seq < 0 { 0 } else { seq };
        while i < self.log.len() && count(out.rows) < limit {
            let mut c = self.log.get(i) or ChangeRow { };
            c.present = true;
            push(out.rows, c) or discard;
            i = i + 1;
        }
        return out;
    }

    // ---- the fleet as reported

    fn fleet(node: String) -> FleetRow fallible(StoreError) {
        return self.fleet_rows.get(node) or FleetRow { };
    }

    @unbounded
    fn put_fleet(row: FleetRow) fallible(StoreError) {
        let mut r = row;
        r.present = true;
        self.fleet_rows.set(r);
    }

    fn inventory(node: String) -> InventoryRow fallible(StoreError) {
        return self.inventory_rows.get(node) or InventoryRow { };
    }

    fn inventory_summary(node: String) -> InventoryRow fallible(StoreError) {
        let mut r = self.inventory_rows.get(node) or InventoryRow { };
        r.blobs = "";
        return r;
    }

    @unbounded
    fn put_inventory(row: InventoryRow) fallible(StoreError) {
        let mut r = row;
        r.present = true;
        self.inventory_rows.set(r);
    }

    // ---- arrangements

    fn arrangement(id: String) -> ArrangementRow fallible(StoreError) {
        for r in self.arrangement_rows.rows {
            if r.id == id { return r; }
        }
        return ArrangementRow { };
    }

    fn arrangements() -> ArrangementRows fallible(StoreError) {
        return self.arrangement_rows;
    }

    @unbounded
    fn put_arrangement(row: ArrangementRow, change: ChangeRow) -> Bool fallible(StoreError) {
        let mut next = ArrangementRows { };
        let mut found = false;
        for held in self.arrangement_rows.rows {
            if held.id == row.id {
                found = true;
                push(
                    next.rows,
                    ArrangementRow {
                        id: held.id,
                        name: row.name,
                        body: row.body,
                        created_at: held.created_at,
                        updated_at: row.updated_at,
                        revision: row.revision,
                        present: true,
                    },
                ) or discard;
            } else {
                push(next.rows, held) or discard;
            }
        }
        if !found {
            if count(self.arrangement_rows.rows) >= 64 {
                fail StoreError { kind: "full", message: "voice holds at most 64 arrangements" };
            }
            let mut r = row;
            r.present = true;
            r.planned = false;
            push(next.rows, r) or discard;
        }
        self.arrangement_rows = next;
        self.append(change);
        return !found;
    }

    @unbounded
    fn delete_arrangement(id: String, change: ChangeRow) fallible(StoreError) {
        let mut next = ArrangementRows { };
        for held in self.arrangement_rows.rows {
            if held.id != id { push(next.rows, held) or discard; }
        }
        self.arrangement_rows = next;
        self.append(change);
    }

    fn plan_arrangement_at(
        id: String,
        revision: String,
        at: Time,
        basis: String
    ) -> Bool fallible(StoreError) {
        let mut next = ArrangementRows { };
        let mut wrote = false;
        for held in self.arrangement_rows.rows {
            let mut h = held;
            if h.id == id && h.revision == revision {
                h.planned = true;
                h.planned_at = at;
                h.planned_basis = basis;
                wrote = true;
            }
            push(next.rows, h) or discard;
        }
        self.arrangement_rows = next;
        return wrote;
    }

    fn link_checks() -> LinkCheckRows fallible(StoreError) {
        return self.link_check_rows;
    }

    fn insert_link_check(row: LinkCheckRow) fallible(StoreError) {
        let mut next = LinkCheckRows { };
        let mut r = row;
        r.present = true;
        push(next.rows, r) or discard;
        for held in self.link_check_rows.rows {
            if count(next.rows) < 64 && held.id != row.id { push(next.rows, held) or discard; }
        }
        self.link_check_rows = next;
        self.bump(row.node_a);
        self.bump(row.node_b);
    }

    fn put_link_result(id: String, node: String, result: String) -> Bool fallible(StoreError) {
        let mut next = LinkCheckRows { };
        let mut wrote = false;
        for held in self.link_check_rows.rows {
            let mut h = held;
            if h.id == id && !wrote {
                if h.node_a == node && len(h.result_a) == 0 {
                    h.result_a = result;
                    wrote = true;
                } else if h.node_b == node && len(h.result_b) == 0 {
                    h.result_b = result;
                    wrote = true;
                }
            }
            push(next.rows, h) or discard;
        }
        self.link_check_rows = next;
        return wrote;
    }

    fn beat(node: String) -> Beat fallible(StoreError) {
        let i = self.node_index(node);
        if i < 0 || i >= count(self.beat_ns) { return Beat { }; }
        let ns = at(self.beat_ns, i) or 0;
        if ns == 0 { return Beat { }; }
        return Beat {
            at: std::time::from_nanos(ns),
            in_flight: at(self.beat_load, i) or 0,
            present: true,
        };
    }

    fn put_beat(node: String, when: Time, in_flight: Int) fallible(StoreError) {
        let i = self.node_index(node);
        if i < 0 { return; }
        while count(self.beat_ns) <= i {
            push(self.beat_ns, 0) or discard;
            push(self.beat_load, 0) or discard;
        }
        set(self.beat_ns, i, std::time::nanos(when)) or discard;
        set(self.beat_load, i, in_flight) or discard;
    }

    /// A node's place in the order it was added, -1 for none.
    fn node_index(node: String) -> Int {
        let mut i = 0;
        while i < self.node_order.len() {
            if (self.node_order.get(i) or "") == node { return i; }
            i = i + 1;
        }
        return -1;
    }

    @bounded_by(self.seat_state_rows)
    fn seat_states(node: String) -> SeatStateRows fallible(StoreError) {
        let mut out = SeatStateRows { };
        let mut i = 0;
        while i < self.seat_order.len() {
            let ref = self.seat_order.get(i) or "";
            let st = self.seat_state_rows.get(ref) or SeatStateRow { };
            if st.present && st.node == node { push(out.rows, st) or discard; }
            i = i + 1;
        }
        return out;
    }

    @unbounded
    fn put_seat_state(row: SeatStateRow) fallible(StoreError) {
        let cur = self.seat_state_rows.get(row.ref) or SeatStateRow { };
        if cur.present
            && cur.status == row.status
            && cur.reason == row.reason
            && cur.in_flight == row.in_flight
            && cur.has_progress == row.has_progress
            && cur.done_bytes == row.done_bytes
            && cur.total_bytes == row.total_bytes
            && cur.context == row.context
        {
            return;
        }
        let mut r = row;
        r.present = true;
        if cur.present && cur.status == row.status && cur.reason == row.reason {
            r.since = cur.since;
        }
        self.seat_state_rows.set(r);
    }

    fn put_flight(row: FlightRow) fallible(StoreError) {
        self.flight_seq = self.flight_seq + 1;
        let mut next = FlightRows { };
        for held in self.flight_rows.rows {
            if held.request_id != row.request_id && count(next.rows) < 99 {
                push(next.rows, held) or discard;
            }
        }
        let mut r = row;
        r.seq = self.flight_seq;
        push(next.rows, r) or discard;
        self.flight_rows = next;
    }

    fn drop_flight(request_id: String) fallible(StoreError) {
        let mut next = FlightRows { };
        for held in self.flight_rows.rows {
            if held.request_id != request_id { push(next.rows, held) or discard; }
        }
        self.flight_rows = next;
    }

    fn flights_after(seq: Int, limit: Int) -> FlightRows fallible(StoreError) {
        let mut out = FlightRows { };
        for r in self.flight_rows.rows {
            // one an api left behind when it stopped is not in flight
            let fresh = std::time::unix(r.started_at) > std::time::unix(std::time::current())
                - 3600;
            if r.seq > seq && fresh && count(out.rows) < limit { push(out.rows, r) or discard; }
        }
        return out;
    }

    @bounded_by(self.peek_rows)
    fn put_peek(row: PeekRow) fallible(StoreError) {
        // in the list's order, as Postgres reads it: newest first, by
        // request id within a second; a request recorded twice keeps its first
        for held in self.peek_rows.rows {
            if held.request_id == row.request_id { return; }
        }
        let mut next = PeekRows { };
        let mut r = row;
        r.present = true;
        let at = std::time::unix(r.created_at);
        let mut placed = false;
        for held in self.peek_rows.rows {
            let held_at = std::time::unix(held.created_at);
            if !placed && (at > held_at || (at == held_at && r.request_id < held.request_id)) {
                push(next.rows, r) or discard;
                placed = true;
            }
            push(next.rows, held) or discard;
        }
        if !placed { push(next.rows, r) or discard; }
        self.peek_rows = next;
    }

    fn peeks(q: PeekQuery) -> PeekRows fallible(StoreError) {
        let mut out = PeekRows { };
        let limit = peek_limit(q.limit);
        let mut started = len(q.cursor) == 0;
        for r in self.peek_rows.rows {
            if !started {
                started = r.request_id == q.cursor;
                continue;
            }
            if (len(q.project) > 0 && r.project != q.project) || (len(q.key) > 0 && r.key != q.key)
                || (len(q.model) > 0 && r.model != q.model)
            {
                continue;
            }
            if count(out.rows) >= limit {
                out.more = true;
                return out;
            }
            let mut listed = r;
            listed.input = "";
            listed.output = "";
            push(out.rows, listed) or discard;
        }
        if !started { out.cursor_known = false; }
        return out;
    }

    fn peek(request_id: String) -> PeekRow fallible(StoreError) {
        for r in self.peek_rows.rows {
            if r.request_id == request_id { return r; }
        }
        return PeekRow { };
    }

    fn windows(account: String) -> String fallible(StoreError) {
        let w = self.window_rows.get(account) or WindowRow { };
        return w.json;
    }

    @unbounded
    fn put_windows(account: String, json: String) fallible(StoreError) {
        let cur = self.window_rows.get(account) or WindowRow { };
        if cur.present && cur.json == json { return; }
        self.window_rows.set(WindowRow { account: account, json: json, present: true });
    }
}

/// True when `c` is one `q` asks for (all but the cursor and the limit).
/// The number in a change's id (`chg_<n>`); 0 for an id that is not one.
fn change_number(id: String) -> Int {
    if !std::str::starts_with(id, "chg_") || len(id) < 5 { return 0; }
    let digits = id[4..len(id)];
    let v = std::str::bytes_view(digits);
    let mut i = 0;
    while i < v.n {
        let b = std::str::byte_at(v, i);
        if b < 48 || b > 57 { return 0; }
        i = i + 1;
    }
    return std::str::parse_int(digits) or 0;
}

fn matches(c: ChangeRow, q: ChangeQuery) -> Bool {
    if len(q.target) > 0
        && c.target != q.target
        && !std::str::starts_with(c.target, q.target + "/")
    {
        return false;
    }
    let at = std::time::unix(c.at);
    if q.has_from && at < std::time::unix(q.from) { return false; }
    if q.has_to && at > std::time::unix(q.to) { return false; }
    return true;
}
