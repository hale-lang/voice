// A conversation's `prompt_cache_key` reaches its seat from Chat Completions
// as from Responses, and the same key finds the same seat each turn, the
// other seats after it in their order.
import ".." as api;
import "../../store" as st;

fn seat(id: String) -> api::Candidate {
    return api::Candidate { seat: st::SeatRow { id: id, ref: "n/" + id } };
}

/// The id of the seat offered first.
fn first_id(c: api::Candidates) -> String {
    for x in c.items { return x.seat.id; }
    return "";
}

fn main() {
    let body = api::chat_body(
        "{\"model\": \"m\", \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}], \"prompt_cache_key\": \"w4/a0\"}",
    ) or "";
    std::test::assert(
        std::str::contains(body, "\"prompt_cache_key\": \"w4/a0\""),
        "Chat Completions carries the key: " + body,
    );
    let none = api::chat_body(
        "{\"model\": \"m\", \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}",
    ) or "";
    std::test::assert(!std::str::contains(none, "prompt_cache_key"), "and none when there is none");

    let mut c = api::Candidates { serving: 3 };
    push(c.items, seat("a")) or discard;
    push(c.items, seat("b")) or discard;
    push(c.items, seat("c")) or discard;
    let first = api::first_for(c, "conv-1");
    let again = api::first_for(c, "conv-1");
    std::test::assert_eq_str(first_id(first), first_id(again), "the same key finds the same seat");
    std::test::assert_eq_int(count(first.items), 3, "every seat is still offered");
    std::test::assert_eq_int(first.serving, 3, "and the count of those serving is kept");
    let mut spread = "";
    let mut i = 0;
    while i < 24 {
        let pick = first_id(api::first_for(c, "conv-" + to_string(i)));
        if !std::str::contains(spread, pick) { spread = spread + pick; }
        i = i + 1;
    }
    std::test::assert_eq_int(len(spread), 3, "keys spread across the seats: " + spread);
}
