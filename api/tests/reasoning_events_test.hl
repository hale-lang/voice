// A model's thinking, as a seat streams it, reaches the caller under the
// standard's names: on /v1/responses as `response.reasoning_text.delta`,
// which is output reaching the caller, and on /v1/chat/completions as
// `delta.reasoning_content`. A node from before voice took up the name
// sends `response.reasoning.delta` and `.done`, which the caller is sent
// under the standard's names.
import ".." as api;

fn delta(kind: String, text: String) -> String {
    return "{\"type\": \"" + kind
        + "\", \"item_id\": \"rs_1\", \"output_index\": 0, \"content_index\": 0, \"delta\": \""
        + text + "\", \"sequence_number\": 3}";
}

fn played(out: api::EventStream) -> String {
    return out.end().body;
}

fn main() {
    let out = api::EventStream { };
    let st = api::forward(
        out,
        api::StreamState { endpoint: "responses", request_id: "req_1", begun: true },
        delta("response.reasoning_text.delta", "Seven sixes"),
    );
    let said = played(out);
    std::test::assert(
        std::str::contains(said, "event: response.reasoning_text.delta\n")
            && std::str::contains(said, "\"delta\": \"Seven sixes\""),
        "the thinking is relayed under the standard's name: " + said,
    );
    std::test::assert(st.output, "and is output reaching the caller");
    std::test::assert(
        api::output_event("response.reasoning_text.delta"),
        "the standard's name is output",
    );
    std::test::assert(
        api::output_event("response.reasoning.delta"),
        "and so is the name a node from before sends",
    );
    std::test::assert(
        !api::output_event("response.reasoning_text.done"),
        "the thinking's close is not output",
    );
    let chat = api::EventStream { };
    let cs = api::forward(
        chat,
        api::StreamState { endpoint: "chat", request_id: "req_2", model: "m", begun: true },
        delta("response.reasoning_text.delta", "Seven sixes"),
    );
    let chunks = played(chat);
    std::test::assert(
        std::str::contains(chunks, "\"reasoning_content\": \"Seven sixes\""),
        "a chat stream carries it as reasoning_content: " + chunks,
    );
    std::test::assert(cs.output, "as output");
    // a node from before's thinking reaches the caller under the
    // standard's names, its delta and its close alike
    let old = api::EventStream { };
    let os = api::forward(
        old,
        api::StreamState { endpoint: "responses", request_id: "req_4", begun: true },
        delta("response.reasoning.delta", "make 42."),
    );
    api::forward(
        old,
        os,
        "{\"type\":\"response.reasoning.done\",\"item_id\":\"rs_1\",\"output_index\":0,\"content_index\":0,\"text\":\"say \\\"response.reasoning.done\\\" here\",\"sequence_number\":5}",
    );
    let renamed = played(old);
    std::test::assert(
        std::str::contains(renamed, "event: response.reasoning_text.delta\n")
            && std::str::contains(renamed, "\"type\": \"response.reasoning_text.delta\"")
            && std::str::contains(renamed, "event: response.reasoning_text.done\n")
            && std::str::contains(renamed, "\"type\": \"response.reasoning_text.done\""),
        "a node from before's thinking is renamed for the caller: " + renamed,
    );
    std::test::assert(
        std::str::contains(renamed, "say \\\"response.reasoning.done\\\" here"),
        "and nothing within its text is: " + renamed,
    );
    std::test::assert(os.output, "its delta is output");
    let before = api::EventStream { };
    api::forward(
        before,
        api::StreamState { endpoint: "chat", request_id: "req_3", model: "m", begun: true },
        delta("response.reasoning.delta", "make 42."),
    );
    std::test::assert(
        std::str::contains(played(before), "\"reasoning_content\": \"make 42.\""),
        "a node from before's thinking reaches a chat stream too",
    );
}
