// A coding attempt, run (../spec/openapi.yaml, tag `attempts`): one run of
// an agentic coding CLI on a repository, the same wrapper for every CLI
// recipe, which is data (lib/harness, ../harnesses/). The plane asks the
// api for an attempt when a slot is free (plane.hl, `claim`), and hands it
// to a slot of its own, each its own thread (`ATTEMPT_SLOTS`), which:
//
//   1. checks out `repo` at `base` into the attempt's directory on the
//      node, `attempts/<id>`: a bare repository voice keeps (`push.git`),
//      and a clone of it on the attempt's branch, the workspace (`work`);
//   2. picks where the CLI runs: the first backend of its recipe of the
//      kind its seat runs (a container, or the host when the seat opts in)
//      that this node can run (`pick_backend`), else `backend_unavailable`.
//      For a container, it builds the recipe's image once (its base,
//      pinned by digest, with the CLI installed as the recipe says), and
//      starts the attempt's egress: a network of its own with no route
//      out, and a proxy on it that lets through only the hosts the recipe,
//      the common package registries and the seat allow, and, for a CLI
//      whose model calls go to voice (`base_url_env`), the api's own host
//      and port, as the node reaches it. For the host, it finds the CLI at
//      the recipe's pinned version (`detect`), or installs that version
//      into voice's own prefix, `clis/<recipe>/<version>`, once per node
//      (`install`);
//   3. runs the CLI: in a container of its own, the workspace mounted and
//      nothing else of the machine (no home, no other credential), as the
//      node's user, every capability dropped; or on the host, as the node's
//      user in the workspace, with a home and a temporary directory of its
//      own and none of the node's environment but its PATH, user and
//      language, and no sandbox or egress filter. Either way its login is
//      in its environment (from the vault, or voice's own key, read by a
//      shell from a private file, never an argv) or a scratch copy of the
//      login's directory, under the CLI's own permission policy (no bypass
//      flag), its output read as it comes (readers.hl), within its idle and
//      total limits;
//   4. commits what the CLI left uncommitted, as the caller's identity, in
//      a container with no network, since the workspace's git configuration
//      is the CLI's to have written (on the host, where the CLI ran as the
//      node's user already, with voice's own git, hooks and fsmonitor off);
//   5. takes the branch's commits into the bare repository (a fetch from
//      the workspace, run by voice outside the container under no
//      configuration of the workspace's), and exports them from the
//      base as a git bundle, which the api holds for the caller;
//   6. removes everything it made, whatever happened: the containers, the
//      network, a host run's process group, and the attempt's directory
//      with the workspace, the run's home and the login's scratch copy,
//      after copying back a login file the CLI refreshed. A CLI installed
//      in voice's prefix stays, shared by the attempts of its version.
//
// It reports to the api every couple of seconds (`reportAttempt`), which
// answers whether to stop: a cancel, or the attempt no longer the node's.

/// The attempts a node runs at once: its threads (main.hl's `attempters`
/// replicas, which must match). Each seat runs at most its concurrency.
const ATTEMPT_SLOTS: Int = 4;

/// How often a running attempt reports, at most, in ns.
const REPORT_EVERY_NS: Int = 2000000000;

/// How long the node keeps telling the api an attempt's end (and handing
/// its bundle) when the api does not take it: as long as the api waits for
/// a running attempt's report before it fails it as lost (api/attempts.hl,
/// `ATTEMPT_LOST_S`).
const FINAL_REPORT_S: Int = 600;

/// The most events a report carries.
const REPORT_EVENTS: Int = 400;

/// The label every container and network of an attempt carries, its node
/// the value: what a starting node removes (`clean_attempts`).
const ATTEMPT_LABEL: String = "net.hale-lang.voice.attempt.node";

/// Where the attempt's egress proxy listens on its network.
const EGRESS_PORT: Int = 8888;

/// The proxy every attempt's egress runs: tinyproxy on Alpine 3.20, pinned
/// by digest, built once per node.
const EGRESS_BASE: String = "docker.io/library/alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc";
const EGRESS_INSTALL: String = "apk add --no-cache tinyproxy";

/// The environment every git command voice runs itself has: no system or
/// user configuration, no prompt, and no ssh; with its home the attempt's
/// own empty directory (`git`), no credential of the node's user (a netrc,
/// a credential helper) is offered to the repository's host.
const GIT_ENV: String = "GIT_CONFIG_NOSYSTEM=1\nGIT_CONFIG_GLOBAL=/dev/null\nGIT_TERMINAL_PROMPT=0\nGIT_ASKPASS=/bin/false\nSSH_ASKPASS=/bin/false\nGIT_SSH_COMMAND=/bin/false\nGIT_ALLOW_PROTOCOL=http:https:git:file";

/// The workspace is the container's own to commit in, whoever the
/// container's mount says owns it (Docker Desktop shows a bind mount's root
/// as root's): git's `safe.directory`, given as git's environment.
const SAFE_WORK: String = "-e\nGIT_CONFIG_COUNT=1\n-e\nGIT_CONFIG_KEY_0=safe.directory\n-e\nGIT_CONFIG_VALUE_0=/work\n";

/// An attempt handed to a slot: its start, as the api answered the claim.
type AttemptWork { slot: Int = 0; start: String = ""; }

topic AttemptJob { payload: AttemptWork; keyed_by slot; }

/// A slot is free again.
type AttemptFreed { slot: Int = 0; id: String = ""; }

topic AttemptDone { payload: AttemptFreed; }

/// An attempt's start (`AttemptStart` in the contract), read.
type AttemptStart {
    id: String = "";
    seat: String = "";
    repo: String = "";
    base: String = "";
    branch: String = "";
    instruction: String = "";
    model: String = "";
    login: String = "";
    budget_tokens: Int = 0;
    // unix seconds
    deadline: Int = 0;
    name: String = "";
    email: String = "";
    egress: String = "";
    definition: String = "";
    // where the seat lets its recipe run: `container`, or `host` when it
    // opts in to the node's own machine
    backend: String = "container";
    // the key voice minted for the run of a harness whose login is voice's
    // own: written to a private file for the run's shell, then forgotten
    credential: String = "";
    problem: String = "";
}

/// The attempt `start` (the claim's answer) names, read and checked: a
/// problem when it is not one this node runs.
@unbounded
fn attempt_start(start: String) -> AttemptStart {
    let a = std::json::find_field_raw(start, "attempt");
    let as_ = std::json::find_field_raw(a, "as");
    let def = std::str::trim(std::json::find_field_raw(a, "harness"));
    let mut s = AttemptStart {
        id: harness::text_of(a, "id"),
        seat: harness::text_of(a, "seat"),
        repo: harness::text_of(a, "repo"),
        base: harness::text_of(a, "base"),
        branch: harness::text_of(a, "branch"),
        instruction: harness::text_of(a, "instruction"),
        model: harness::text_of(a, "model"),
        login: harness::text_of(a, "login"),
        budget_tokens: std::json::find_int_field(a, "budget_tokens"),
        deadline: std::json::find_int_field(a, "deadline"),
        name: harness::text_of(as_, "name"),
        email: harness::text_of(as_, "email"),
        egress: harness::lines_of(std::json::find_field_raw(a, "egress")),
        definition: def,
        backend: harness::text_of(a, "backend"),
        credential: harness::text_of(a, "credential"),
    };
    if len(s.backend) == 0 { s.backend = "container"; }
    if !attempt_id(s.id) {
        s.problem = "the attempt's id is not one voice makes";
        return s;
    }
    s.problem = harness::harness_problem(def);
    if len(s.problem) > 0 {
        s.problem = "its harness is not one this node runs: " + s.problem;
        return s;
    }
    if std::str::starts_with(s.egress, "!") { s.problem = "its egress is not a list of hosts"; }
    if s.backend != "container" && s.backend != "host" {
        s.problem = "its seat's backend is not one voice runs (container or host)";
    }
    let lower = std::str::lower(s.repo);
    if std::str::contains(s.repo, "\n")
        || !(std::str::starts_with(lower, "https://") || std::str::starts_with(lower, "http://")
                || std::str::starts_with(lower, "git://"))
    {
        s.problem = "its repository is not one voice fetches (https, http or git)";
    }
    if len(s.base) == 0 || std::str::starts_with(s.base, "-") || std::str::contains(s.base, "\n") {
        s.problem = "its base is not a ref";
    }
    if !std::str::starts_with(s.branch, "voice/attempt-") || std::str::contains(s.branch, "..") {
        s.problem = "its branch is not voice's";
    }
    if len(s.name) == 0 || len(s.email) == 0 || std::str::contains(s.name + s.email, "\n") {
        s.problem = "it names no identity to commit as";
    }
    let d = harness::harness_def(def);
    if d.login_kind == "home" && !harness::slug(s.login) {
        s.problem = "its login is not the name of a login directory";
    } else if d.login_kind == "env" && !std::secret::vault_name_is_safe(s.login) {
        s.problem = "its login is not a vault entry's name";
    } else if d.login_kind == "voice"
        && (len(s.credential) == 0 || std::str::contains(s.credential, "\n"))
    {
        s.problem = "the api handed no key for its harness's calls to voice";
    }
    if std::str::contains(s.model, "\n") { s.problem = "its model is not a name"; }
    return s;
}

/// `a` with its run's key let go.
fn forget_credential(a: AttemptStart) -> AttemptStart {
    let mut out = a;
    out.credential = "";
    return out;
}

/// `att_` and hex, as the api makes them: safe in a path and a name.
fn attempt_id(id: String) -> Bool {
    if !std::str::starts_with(id, "att_") || len(id) < 8 || len(id) > 64 { return false; }
    let v = std::str::bytes_view(id);
    let mut i = 4;
    while i < len(id) {
        let b = std::str::byte_at(v, i);
        if !((b >= 48 && b <= 57) || (b >= 97 && b <= 122)) { return false; }
        i = i + 1;
    }
    return true;
}

/// The image a definition runs in, built once on the node from its base
/// and its install: named for both, so a changed definition builds anew.
fn image_tag(prefix: String, base: String, install: String) -> String {
    let digest = std::hex::encode(
        std::crypto::sha256(std::bytes::from_string(base + "\n" + install)),
    );
    return prefix + ":" + digest[0..16];
}

/// The Dockerfile of an image built from `base` with `install` run on it.
fn dockerfile(base: String, install: String) -> String {
    return "FROM " + base + "\nRUN " + install + "\n";
}

/// The egress proxy's filter, matched against each request's URL (a
/// tunnel's `host:port`, a plain request's `http://host[:port]/path`): one
/// extended regular expression a line, a host whole or (`.example.com`)
/// any host under a domain, tunnelled to on the web's ports, 443 and 80,
/// or asked plainly on 80. A host's part is letters, digits, dashes and
/// dots alone, so no URL that names another host before it matches.
@bounded_by(hosts)
fn egress_filter(hosts: String) -> String {
    let mut out = "";
    let mut rest = hosts;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let h = if nl < 0 { rest } else { rest[0..nl] };
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(h) == 0 { continue; }
        let under = std::str::starts_with(h, ".");
        let host = std::str::replace(if under { h[1..len(h)] } else { h }, ".", "\\.");
        let re = if under { "([a-z0-9-]+\\.)*" + host } else { host };
        out = out + "^" + re + ":(443|80)$\n^http://" + re + "(:80)?(/|$)\n";
    }
    return out;
}

/// How a harness whose model calls go to voice reaches it: the base URL it
/// is handed, and the host and port its egress lets through; or why the
/// node's address for the api is one an attempt's container cannot use.
type ApiRoute {
    base_url: String = "";
    host: String = "";
    port: Int = 0;
    problem: String = "";
}

/// The route to the api at `api`, the address the node itself calls it at.
/// Every wire voice serves a harness on (lib/harness `PROTOCOLS`) is at its
/// `/v1`. The attempt's proxy runs on docker's bridge, where a loopback
/// address is the proxy's own: such an address is refused, as is a host
/// the proxy's filter cannot name (an IPv6 literal).
@bounded_by(api)
fn api_route(api: String) -> ApiRoute {
    let mut base = std::str::trim(api);
    while std::str::ends_with(base, "/") {
        base = base[0..(len(base) - 1)];
    }
    let u = std::http::parse_url(base + "/") or {
        return ApiRoute { problem: "the node's address for the api, " + api + ", is not a URL" };
    };
    let host = std::str::lower(u.host);
    if !route_host(host) || u.port < 1 {
        return ApiRoute {
            problem: "the node reaches the api at " + api
                + ", whose host the attempt's egress proxy cannot let through: start the node with an --api address of a host name or an IPv4 address",
        };
    }
    if host == "localhost" || std::str::ends_with(host, ".localhost")
        || std::str::starts_with(host, "127.") || host == "0.0.0.0"
    {
        return ApiRoute {
            problem: "the node reaches the api at " + api
                + ", a loopback address, which the attempt's container cannot reach: start the node with an --api address its containers can reach (the machine's host name or address)",
        };
    }
    return ApiRoute { base_url: base + "/v1", host: host, port: u.port };
}

/// A host the egress filter can name: letters, digits, dashes and dots.
@bounded_by(host)
fn route_host(host: String) -> Bool {
    let v = std::str::bytes_view(host);
    let n = len(host);
    if n == 0 || n > 253 { return false; }
    let mut i = 0;
    while i < n {
        let b = std::str::byte_at(v, i);
        if !((b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45 || b == 46) { return false; }
        i = i + 1;
    }
    return true;
}

/// The filter's lines that let through exactly the api's host and port:
/// tunnelled to, or asked plainly (with no port when it is 80).
fn route_filter(r: ApiRoute) -> String {
    if len(r.host) == 0 { return ""; }
    let host = std::str::replace(r.host, ".", "\\.");
    let port = to_string(r.port);
    return "^" + host + ":" + port + "$\n^http://" + host
        + (if r.port == 80 { "(:80)?" } else { ":" + port }) + "(/|$)\n";
}

/// The egress proxy's configuration: it denies every URL its filter does
/// not name, and tunnels only to the web's ports and `route_port` (the
/// api's, 0 for none), which the filter allows for the api's host alone.
fn egress_config(route_port: Int) -> String {
    return "Port " + to_string(EGRESS_PORT)
        + "\nListen 0.0.0.0\nTimeout 600\nMaxClients 64\nLogLevel Notice\nFilter \"/etc/voice-egress/filter\"\nFilterType ere\nFilterDefaultDeny Yes\nFilterURLs Yes\nConnectPort 443\nConnectPort 80\n"
        + (
            if route_port > 0 && route_port != 443 && route_port != 80 {
                "ConnectPort " + to_string(route_port) + "\n"
            } else {
                ""
            }
        );
}

/// The container names an attempt runs under.
fn harness_name(id: String) -> String { return "voice-attempt-" + id; }
fn commit_name(id: String) -> String { return "voice-attempt-" + id + "-commit"; }
fn egress_name(id: String) -> String { return "voice-attempt-" + id + "-egress"; }

/// The harness's `docker run`, newline-separated, from `def` for attempt
/// `a`, in `dir`, under the node's `owner` label, as `user` (uid:gid),
/// in `image`; `base_url` is voice's address for a harness whose model
/// calls go to voice ("" for one whose go to its vendor). Credentials are
/// never here: a login from the vault is passed by name (`-e NAME`), its
/// value in the docker client's own environment (`harness_argv`); a login
/// directory is a mount of the attempt's scratch copy.
@unbounded
fn docker_run_argv(
    def: harness::HarnessDef,
    a: AttemptStart,
    dir: String,
    owner: String,
    user: String,
    image: String,
    base_url: String
) -> String {
    let proxy = "http://" + egress_name(a.id) + ":" + to_string(EGRESS_PORT);
    let mut argv = "docker\nrun\n--rm\n-i\n--name\n" + harness_name(a.id) + "\n--label\n"
        + OWNER_LABEL
        + "=" + owner + "\n--label\n" + ATTEMPT_LABEL + "=" + owner + "\n--network\n"
        + harness_name(a.id) + "\n--user\n" + user
        + "\n--cap-drop\nALL\n--security-opt\nno-new-privileges\n--pids-limit\n4096\n--tmpfs\n/home/voice:rw,exec,mode=1777\n--tmpfs\n/tmp:rw,exec,mode=1777\n-e\nHOME=/home/voice\n-w\n/work\n-v\n"
        + dir + "/work:/work:rw\n-v\n" + dir + "/voice:/voice:ro\n-v\n" + dir
        + "/out:/voice/out:rw\n-e\nHTTPS_PROXY=" + proxy + "\n-e\nHTTP_PROXY=" + proxy
        + "\n-e\nhttps_proxy=" + proxy + "\n-e\nhttp_proxy=" + proxy
        + "\n-e\nNO_PROXY=localhost,127.0.0.1\n-e\nno_proxy=localhost,127.0.0.1\n-e\nGIT_AUTHOR_NAME="
        + a.name + "\n-e\nGIT_AUTHOR_EMAIL=" + a.email + "\n-e\nGIT_COMMITTER_NAME=" + a.name
        + "\n-e\nGIT_COMMITTER_EMAIL=" + a.email + "\n" + SAFE_WORK;
    // a CLI that sandboxes its own commands (codex's workspace-write, under
    // bubblewrap) makes a user namespace, which docker's default seccomp
    // profile refuses: the container keeps every other bound
    if def.nested_sandbox { argv = argv + "--security-opt\nseccomp=unconfined\n"; }
    if def.login_kind == "home" {
        argv = argv + "-v\n" + dir + "/login:" + def.login_mount + ":rw\n";
        if len(def.login_env) > 0 {
            argv = argv + "-e\n" + def.login_env + "=" + def.login_mount + "\n";
        }
    } else {
        argv = argv + "-e\n" + def.login_env + "\n";
    }
    let mut env = def.env;
    while len(env) > 0 {
        let nl = std::str::index_of(env, "\n");
        argv = argv + "-e\n" + env[0..nl] + "\n";
        env = env[(nl + 1)..len(env)];
    }
    if len(def.base_url_env) > 0 && len(base_url) > 0 {
        argv = argv + "-e\n" + def.base_url_env + "=" + base_url + "\n";
    }
    if len(a.model) > 0 && len(def.model_env) > 0 {
        argv = argv + "-e\n" + def.model_env + "=" + a.model + "\n";
    }
    argv = argv + image + "\n" + def.command;
    if len(a.model) > 0 && len(def.model_flag) > 0 {
        argv = argv + def.model_flag + "\n" + a.model + "\n";
    }
    if def.via == "argument" { argv = argv + instruction_of(def, a) + "\n"; }
    return argv;
}

/// What the harness is told: its definition's preamble, then the caller's
/// instruction. As an argument it is one line.
fn instruction_of(def: harness::HarnessDef, a: AttemptStart) -> String {
    let text = def.preamble + "\n\n" + a.instruction;
    return if def.via == "argument" { std::str::replace(text, "\n", " ") } else { text };
}

/// The whole argv of the harness's run: for a login from the vault, or
/// voice's own key, a shell that reads it from `secret` (a private file
/// the sealed credential, or the node, wrote) into the variable the
/// definition names, removes the file, and starts `docker run`, which
/// passes the variable on by name.
fn harness_argv(def: harness::HarnessDef, run: String, secret: String) -> String {
    if def.login_kind != "env" && def.login_kind != "voice" { return run; }
    return "sh\n-c\n" + def.login_env + "=\"$(cat \"$1\")\"; rm -f \"$1\"; export " + def.login_env
        + "; shift; exec \"$@\"\nsh\n" + secret + "\n" + run;
}

/// How long a host backend's detect may run, and its install, in seconds.
const DETECT_S: Int = 30;
const INSTALL_S: Int = 1200;

/// The file an install leaves in voice's prefix once it has finished: a
/// prefix without it is an install cut short, removed (`clean_clis`).
const INSTALLED_MARK: String = ".voice-installed";

/// Where voice installs recipe `def`'s CLI on the node,
/// `<data>/clis/<id>/<version>`: shared by every attempt of that version,
/// and kept.
fn cli_prefix(data: String, def: harness::HarnessDef) -> String {
    return data + "/clis/" + def.id + "/" + def.version;
}

/// A path of the container (`/work`, `/voice/out`, `/voice`, `/home/voice`)
/// as a host run in `dir` has it: the attempt's own directories in their
/// place. Any other path is as it is.
fn host_path(dir: String, p: String) -> String {
    if p == "/work" || std::str::starts_with(p, "/work/") { return dir + "/work" + p[5..len(p)]; }
    if p == "/voice/out" || std::str::starts_with(p, "/voice/out/") {
        return dir + "/out" + p[10..len(p)];
    }
    if p == "/voice" || std::str::starts_with(p, "/voice/") {
        return dir + "/voice" + p[6..len(p)];
    }
    if p == "/home/voice" || std::str::starts_with(p, "/home/voice/") {
        return dir + "/run-home" + p[11..len(p)];
    }
    return p;
}

/// An argument of a recipe's command, a path of the container in it (the
/// whole argument, or a flag's value after `=`) as a host run has it.
fn host_arg(dir: String, a: String) -> String {
    if std::str::starts_with(a, "/") { return host_path(dir, a); }
    let eq = std::str::index_of(a, "=");
    if eq > 0 && std::str::starts_with(a[(eq + 1)..len(a)], "/") {
        return a[0..(eq + 1)] + host_path(dir, a[(eq + 1)..len(a)]);
    }
    return a;
}

/// True for a byte of a word or a path: a letter, a digit, `_`, `-`, `.`
/// or `/`.
fn path_byte(b: Int) -> Bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95
        || b == 45 || b == 46 || b == 47;
}

/// Text that names the workspace as `/work` (a recipe's preamble), naming
/// a host run's workspace in `dir` instead.
@bounded_by(text)
fn host_text(dir: String, text: String) -> String {
    let v = std::str::bytes_view(text);
    let out = std::bytes::BytesBuilder { initial_cap: len(text) + 64 };
    let mut from = 0;
    let mut at = std::str::find(v, "/work", 0);
    while at >= 0 {
        let before = std::str::byte_at(v, at - 1);
        let after = std::str::byte_at(v, at + 5);
        if (at == 0 || !path_byte(before))
            && (after < 0 || (!path_byte(after) || after == 46 || after == 47))
        {
            out.append_str(std::str::slice(v, from, at) + dir + "/work");
            from = at + 5;
        }
        at = std::str::find(v, "/work", at + 5);
    }
    out.append_str(std::str::slice(v, from, v.n));
    let b = out.snapshot() or b"";
    return std::str::from_bytes(b);
}

/// Where a host run in `dir` keeps its login directory's scratch copy: the
/// login's mount, as a host run has it, when it is in the container's home
/// (the run's own home then); else the attempt's `login` directory.
fn host_login_dir(def: harness::HarnessDef, dir: String) -> String {
    let m = host_path(dir, def.login_mount);
    return if std::str::starts_with(m, dir + "/run-home/") { m } else { dir + "/login" };
}

/// The base URL a host run's harness calls voice at: the api as the node
/// itself reaches it, with `/v1`. A loopback address is the node's own, so
/// it serves here as it does not in a container.
fn host_base_url(api: String) -> String {
    let mut base = std::str::trim(api);
    while std::str::ends_with(base, "/") {
        base = base[0..(len(base) - 1)];
    }
    return base + "/v1";
}

/// The variables every host step of an attempt in `dir` runs with (detect,
/// install and the run itself), and nothing else of the node's
/// environment: `path` after voice's `prefix`'s bin, the node's user, shell
/// and language (`node_env`, `NAME=value` lines), the attempt's own home
/// and temporary directory, and the prefix.
fn host_env(dir: String, prefix: String, path: String, node_env: String) -> String {
    return "PATH=" + prefix + "/bin:" + path + "\nHOME=" + dir + "/run-home\nTMPDIR=" + dir
        + "/tmp\nVOICE_CLI_PREFIX=" + prefix + "\nNO_COLOR=1\nTERM=dumb\n" + node_env;
}

/// What a host run of `def` for attempt `a` in `dir` is told: its
/// preamble, naming the run's workspace, then the caller's instruction.
fn host_instruction(def: harness::HarnessDef, a: AttemptStart, dir: String) -> String {
    let text = host_text(dir, def.preamble) + "\n\n" + a.instruction;
    return if def.via == "argument" { std::str::replace(text, "\n", " ") } else { text };
}

/// The host run's argv, newline-separated, from `def` for attempt `a` in
/// `dir`: the recipe's command with the container's paths as the run has
/// them, its model, and its instruction when it is an argument. Its login
/// is never here (`harness_argv`, `host_run_env`).
@unbounded
fn host_run_argv(def: harness::HarnessDef, a: AttemptStart, dir: String) -> String {
    let mut argv = "";
    let mut rest = def.command;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        argv = argv + host_arg(dir, rest[0..nl]) + "\n";
        rest = rest[(nl + 1)..len(rest)];
    }
    if len(a.model) > 0 && len(def.model_flag) > 0 {
        argv = argv + def.model_flag + "\n" + a.model + "\n";
    }
    if def.via == "argument" { argv = argv + host_instruction(def, a, dir) + "\n"; }
    return argv;
}

/// The host run's environment, `NAME=value` lines: `base` (`host_env`),
/// the caller's identity for git, the recipe's own variables (a path of
/// the container as the run has it), its model, voice's address for a
/// harness whose model calls go to voice (`base_url`), and a login
/// directory's scratch copy. A login from the vault, or voice's own key,
/// is not here: the run's shell reads it from a private file
/// (`harness_argv`).
@unbounded
fn host_run_env(
    def: harness::HarnessDef,
    a: AttemptStart,
    dir: String,
    base: String,
    base_url: String
) -> String {
    let mut env = base + "GIT_AUTHOR_NAME=" + a.name + "\nGIT_AUTHOR_EMAIL=" + a.email
        + "\nGIT_COMMITTER_NAME=" + a.name + "\nGIT_COMMITTER_EMAIL=" + a.email + "\n";
    let mut rest = def.env;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let line = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let eq = std::str::index_of(line, "=");
        let value = line[(eq + 1)..len(line)];
        env = env + line[0..(eq + 1)]
            + (if std::str::starts_with(value, "/") { host_path(dir, value) } else { value })
            + "\n";
    }
    if def.login_kind == "home" && len(def.login_env) > 0 {
        env = env + def.login_env + "=" + host_login_dir(def, dir) + "\n";
    }
    if len(def.base_url_env) > 0 && len(base_url) > 0 {
        env = env + def.base_url_env + "=" + base_url + "\n";
    }
    if len(a.model) > 0 && len(def.model_env) > 0 {
        env = env + def.model_env + "=" + a.model + "\n";
    }
    return env;
}

/// How a node picks where an attempt's recipe runs: the backend, and
/// voice's prefix for the recipe's version; or why none of its backends
/// fits (`backend_unavailable`), or the attempt's stop.
type BackendPick {
    backend: harness::HarnessBackend = harness::HarnessBackend { };
    why: String = "";
    kind: String = "";
}

/// Why no backend of `def` of the kind the seat runs (`want`) is listed,
/// for the attempt's failure.
fn no_backend_of(def: harness::HarnessDef, want: String) -> String {
    if want == "host" {
        return "CLI recipe " + def.id + " has no host backend, which its seat opts in to";
    }
    return "CLI recipe " + def.id
        + " has no container backend, and its seat runs only in a container: opt the seat in to the host (`backend: host`), with no sandbox, to run it there";
}

/// How one command went.
type Ran {
    code: Int = -1;
    out: String = "";
    err: String = "";
    // it was stopped: cancelled, past its deadline or limit, or the node stopping
    stopped: Bool = false;
    // it never started
    unstarted: Bool = false;
}

/// Why an attempt failed (its `failure`), and the kind of failure that is
/// (`CodingAttempt.failure_kind`); "" for both when it did not.
type Failure { why: String = ""; kind: String = ""; }

/// The kind of failure of a container's run `r` that exited non-zero:
/// docker's own (it never started, or docker answered 125) is the
/// sandbox's, anything else what ran in it.
fn exit_kind(r: Ran) -> String {
    return if r.unstarted || r.code == 125 { "sandbox_failed" } else { "harness_failed" };
}

/// How the harness's run `ran` ended the attempt, once its work was taken:
/// its stop (`stop`) when one cut it short, else its exit, a failure it
/// reported (`reported`), a failure to commit what it left (`commit`), or
/// no change at all; no failure when it ran to its end and changed the
/// branch.
fn run_failure(
    ran: Ran,
    stop: Failure,
    reported: String,
    commit: Failure,
    changed: Bool
) -> Failure {
    if ran.stopped || len(stop.why) > 0 { return stop; }
    if ran.code != 0 {
        return Failure {
            why: "the harness exited with code " + to_string(ran.code) + tail_of(ran.err),
            kind: exit_kind(ran),
        };
    }
    if len(reported) > 0 { return Failure { why: reported, kind: "harness_failed" }; }
    if len(commit.why) > 0 { return commit; }
    if !changed { return Failure { why: "the harness made no change", kind: "no_changes" }; }
    return Failure { };
}

/// A slot attempts run on, one at a time, each in an `AttemptRun` of its
/// own, which goes with all it held when the attempt ends.
locus Attempter {
    params {
        // the node's id, its data directory, and the api's node plane
        node: String = "";
        data: String = "node-data";
        api: String = "";
        token: String = "";
        credential: std::secret::Credential = std::secret::Credential { };
        work: AttemptWork = AttemptWork { };
        waiting: Bool = false;
    }

    bus {
        subscribe AttemptJob as on_job where key == replica;
        publish AttemptDone;
    }

    run() {
        while !self.draining {
            if self.waiting {
                self.waiting = false;
                self.go(self.work);
            } else {
                std::time::sleep(200ms);
            }
        }
    }

    fn on_job(w: AttemptWork) {
        self.work = w;
        self.waiting = true;
    }

    /// Run the attempt `w` hands this slot, and free the slot.
    fn go(w: AttemptWork) {
        let r = AttemptRun {
            node: self.node,
            data: self.data,
            api: self.api,
            token: self.token,
            credential: self.credential,
        };
        let id = r.go(w.start, self);
        AttemptDone <- AttemptFreed { slot: w.slot, id: id };
    }
}

/// One attempt, run end to end: what it holds goes with it.
locus AttemptRun {
    params {
        node: String = "";
        data: String = "node-data";
        api: String = "";
        token: String = "";
        credential: std::secret::Credential = std::secret::Credential { };
        // the attempt, its directory, and how it stands
        a: AttemptStart = AttemptStart { };
        dir: String = "";
        phase: String = "";
        pending: String = "";
        pending_n: Int = 0;
        reported_ns: Int = 0;
        // why it stops early, "" while it runs, and the kind of failure
        // that is
        stop: String = "";
        stop_kind: String = "";
        // whether the stop was a cancel
        cancelled: Bool = false;
        reader: HarnessReader = HarnessReader { };
        started_ns: Int = 0;
    }

    /// Run the attempt `start` names, end to end; its id. `slot` is the
    /// slot it runs on, whose stop stops it.
    @unbounded
    fn go(start: String, slot: Attempter) -> String {
        self.a = attempt_start(start);
        self.dir = self.data + "/attempts/" + self.a.id;
        self.phase = "preparing";
        self.started_ns = std::time::monotonic_ns();
        log_info(
            "attempt started",
            fields2(std::log::kv("attempt", self.a.id), std::log::kv("seat", self.a.seat)),
        );
        if len(self.a.problem) > 0 || !attempt_id(self.a.id) {
            if attempt_id(self.a.id) {
                self.finish("failed", self.a.problem, "internal", "", "", "");
            }
            return self.a.id;
        }
        let def = harness::harness_def(self.a.definition);
        self.reader = HarnessReader { reader: def.reader };
        let outcome = self.attempt(def, slot);
        // whatever happened, nothing of it is left
        self.clean_up(def);
        log_info(
            "attempt ended",
            fields2(std::log::kv("attempt", self.a.id), std::log::kv("outcome", outcome)),
        );
        return self.a.id;
    }

    /// The attempt's steps; its outcome, reported.
    @unbounded
    fn attempt(def: harness::HarnessDef, slot: Attempter) -> String {
        let made = run_out(
            "mkdir\n-m\n700\n-p\n" + self.dir + "/voice/out\n" + self.dir + "/out\n" + self.dir
                + "/egress\n" + self.dir + "/secret\n" + self.dir + "/home\n" + self.dir
                + "/run-home\n" + self.dir + "/tmp",
        );
        if !std::io::fs::file_exists(self.dir + "/secret") {
            return self.failed(
                "the attempt's directory could not be made" + made,
                "internal",
                "",
                "",
                "",
            );
        }
        // 1. the repository, at its base
        self.note("fetching " + self.a.base + " from " + self.a.repo);
        self.phase = "fetching";
        let push = self.dir + "/push.git";
        let init = self.git("init\n--bare\n-q\n" + push, 60, slot);
        if init.code != 0 {
            return self.failed(
                "git could not start a repository: " + clip(init.err),
                "internal",
                "",
                "",
                "",
            );
        }
        let fetched = self.git(
            "--git-dir\n" + push + "\nfetch\n--no-tags\n-q\n" + self.a.repo + "\n" + self.a.base,
            1800,
            slot,
        );
        if self.stopping(slot) { return self.stopped("", ""); }
        if fetched.code != 0 {
            return self.failed(
                "the repository could not be fetched at " + self.a.base + ": " + clip(fetched.err),
                "repo_unavailable",
                "",
                "",
                "",
            );
        }
        let base_sha = std::str::trim(
            self.git("--git-dir\n" + push + "\nrev-parse\nFETCH_HEAD^{commit}", 60, slot).out,
        );
        if len(base_sha) < 40 {
            return self.failed("the base is not a commit", "repo_unavailable", "", "", "");
        }
        self.git(
            "--git-dir\n" + push + "\nupdate-ref\nrefs/heads/" + self.a.branch + "\n" + base_sha,
            60,
            slot,
        );
        let cloned = self.git(
            "clone\n-q\n--no-hardlinks\n--branch\n" + self.a.branch + "\n" + push + "\n" + self.dir
                + "/work",
            1800,
            slot,
        );
        if cloned.code != 0 {
            return self.failed(
                "the workspace could not be made: " + clip(cloned.err),
                "internal",
                base_sha,
                "",
                "",
            );
        }
        self.git("-C\n" + self.dir + "/work\nremote\nremove\norigin", 60, slot);
        self.git("-C\n" + self.dir + "/work\nconfig\nuser.name\n" + self.a.name, 60, slot);
        self.git("-C\n" + self.dir + "/work\nconfig\nuser.email\n" + self.a.email, 60, slot);
        self.report_now("", base_sha, "", "");
        // 2. where it runs: the first backend of its recipe that the seat
        // allows (a container, or the host when it opts in) and this node
        // can run
        self.phase = "building";
        let pick = self.pick_backend(def, slot);
        if len(pick.why) > 0 { return self.failed(pick.why, pick.kind, base_sha, "", ""); }
        let host = pick.backend.kind == "host";
        let user = to_string(std::process::uid()) + ":" + std::str::trim(run_out("id\n-g"));
        let mut image = "";
        let mut base_url = "";
        if host {
            // the node's own machine: no image, no network of its own, no
            // egress proxy; voice's api as the node reaches it
            if len(def.base_url_env) > 0 { base_url = host_base_url(self.api); }
            self.note(
                "running on the host, as the node's user: no sandbox and no egress filter",
            );
        } else {
            // the image, and the attempt's egress: for a harness whose model
            // calls go to voice, the api as the node reaches it
            let route = if len(def.base_url_env) > 0 { api_route(self.api) } else { ApiRoute { } };
            if len(route.problem) > 0 {
                return self.failed(route.problem, "sandbox_failed", base_sha, "", "");
            }
            image = image_tag(
                "voice-harness-" + harness::text_of(self.a.definition, "id"),
                pick.backend.base,
                pick.backend.install,
            );
            let built = self.ensure_image(image, pick.backend.base, pick.backend.install, slot);
            if len(built) > 0 { return self.failed(built, "sandbox_failed", base_sha, "", ""); }
            let proxy = image_tag("voice-egress", EGRESS_BASE, EGRESS_INSTALL);
            let pbuilt = self.ensure_image(proxy, EGRESS_BASE, EGRESS_INSTALL, slot);
            if len(pbuilt) > 0 { return self.failed(pbuilt, "sandbox_failed", base_sha, "", ""); }
            if self.stopping(slot) { return self.stopped(base_sha, ""); }
            let egress = self.start_egress(proxy, route, slot);
            if len(egress) > 0 { return self.failed(egress, "sandbox_failed", base_sha, "", ""); }
            base_url = route.base_url;
        }
        // 3. the harness
        let login = self.login_ready(def, host);
        if len(login) > 0 { return self.failed(login, "login_unavailable", base_sha, "", ""); }
        let told = if host {
            host_instruction(def, self.a, self.dir)
        } else {
            instruction_of(def, self.a)
        };
        std::io::fs::write_file(self.dir + "/voice/instruction.md", told) or discard;
        let wrote = self.write_files(def);
        if len(wrote) > 0 { return self.failed(wrote, "internal", base_sha, "", ""); }
        let run = if host {
            host_run_argv(def, self.a, self.dir)
        } else {
            docker_run_argv(def, self.a, self.dir, self.node, user, image, base_url)
        };
        let env = if host {
            host_run_env(def, self.a, self.dir, self.host_base_env(def), base_url)
        } else {
            ""
        };
        let mut argv = run;
        if def.login_kind == "env" {
            let c = std::secret::Credential { vault: self.a.login };
            if !c.ready() {
                return self.failed(
                    "the node's vault holds no login " + self.a.login + " for this seat",
                    "login_unavailable",
                    base_sha,
                    "",
                    "",
                );
            }
            if !c.write_private(self.dir + "/secret/login") {
                return self.failed(
                    "the login could not be written privately for the harness",
                    "login_unavailable",
                    base_sha,
                    "",
                    "",
                );
            }
            argv = harness_argv(def, run, self.dir + "/secret/login");
        } else if def.login_kind == "voice" {
            // voice's own key for this run, from the claim's answer: into a
            // file of the attempt's private directory, read by the shell
            // that starts the run and removed by it; the node keeps no copy
            let key = self.a.credential;
            self.a = forget_credential(self.a);
            std::io::fs::write_file(self.dir + "/secret/login", key) or {
                return self.failed(
                    "voice's key for the harness could not be written privately",
                    "login_unavailable",
                    base_sha,
                    "",
                    "",
                );
            };
            run_out("chmod\n600\n" + self.dir + "/secret/login");
            argv = harness_argv(def, run, self.dir + "/secret/login");
        }
        self.phase = "running";
        self.note(
            "running " + def.name + (if len(def.version) > 0 { " " + def.version } else { "" }),
        );
        let ran = self.harness_run(
            argv,
            if def.via == "stdin" { told } else { "" },
            def.idle_seconds,
            if host {
                std::process::SpawnOptions { cwd: self.dir + "/work", env: env, clear_env: true }
            } else {
                std::process::SpawnOptions { }
            },
            host,
            slot,
        );
        run_out("rm\n-f\n" + self.dir + "/secret/login");
        if len(def.usage_file) > 0 {
            let name = def.usage_file[len("/voice/out/")..len(def.usage_file)];
            self.reader.read_usage_file(std::io::fs::read_file(self.dir + "/out/" + name) or "");
        }
        self.copy_login_back(def, host);
        if ran.stopped && self.cancelled { return self.stopped(base_sha, ""); }
        // usage the harness reported last (its final output, or the file it
        // wrote on exit) is held to the budget as well
        if self.a.budget_tokens > 0 && self.reader.has_usage && len(self.stop) == 0
            && self.reader.input_tokens + self.reader.output_tokens > self.a.budget_tokens
        {
            self.stop = "the harness used more than its budget of "
                + to_string(self.a.budget_tokens)
                + " tokens";
            self.stop_kind = "over_budget";
        }
        // 4. what it left uncommitted, committed as the caller
        self.phase = "committing";
        let summary = self.reader.final_summary();
        let title = first_line(if len(summary) > 0 { summary } else { self.a.instruction });
        std::io::fs::write_file(
            self.dir + "/voice/message",
            title + "\n\n" + clip_lines(summary),
        ) or discard;
        let commit = if host {
            self.commit_left_host(slot)
        } else {
            self.commit_left(image, user, slot)
        };
        // 5. the branch's commits, taken and bundled
        let taken = self.git(
            "--git-dir\n" + push + "\nfetch\n--no-tags\n-q\n" + self.dir + "/work\nHEAD",
            600,
            slot,
        );
        if taken.code != 0 {
            return self.failed(
                "the workspace's commits could not be taken: " + clip(taken.err),
                "harness_failed",
                base_sha,
                "",
                summary,
            );
        }
        let head = std::str::trim(
            self.git("--git-dir\n" + push + "\nrev-parse\nFETCH_HEAD^{commit}", 60, slot).out,
        );
        let ancestor = self.git(
            "--git-dir\n" + push + "\nmerge-base\n--is-ancestor\n" + base_sha + "\n" + head,
            60,
            slot,
        );
        if ancestor.code != 0 {
            return self.failed(
                "the harness's commits do not build on the base",
                "harness_failed",
                base_sha,
                "",
                summary,
            );
        }
        self.git(
            "--git-dir\n" + push + "\nupdate-ref\nrefs/heads/" + self.a.branch + "\n" + head,
            60,
            slot,
        );
        let end = run_failure(
            ran,
            Failure { why: self.stop, kind: self.stop_kind },
            self.reader.failure,
            commit,
            head != base_sha,
        );
        if head != base_sha {
            let bundled = self.bundle(push, base_sha, slot);
            if len(bundled.why) > 0 {
                return self.failed(bundled.why, bundled.kind, base_sha, head, summary);
            }
        }
        return self.finish(
            if len(end.why) > 0 { "failed" } else { "done" },
            end.why,
            end.kind,
            base_sha,
            head,
            summary,
        );
    }

    /// Run git as voice, under no configuration but the command's.
    fn git(args: String, timeout_s: Int, slot: Attempter) -> Ran {
        return self.exec(
            "git\n-c\ncore.hooksPath=/dev/null\n-c\ncore.fsmonitor=false\n" + args,
            "",
            timeout_s,
            GIT_ENV + "\nHOME=" + self.dir + "/home\nXDG_CONFIG_HOME=" + self.dir + "/home",
            slot,
        );
    }

    /// Run `argv` to its end, or until the attempt stops or `timeout_s`
    /// passes, reporting meanwhile; its stdout and the tail of its stderr.
    @unbounded
    fn exec(argv: String, input: String, timeout_s: Int, env: String, slot: Attempter) -> Ran {
        return self.exec_with(
            argv,
            input,
            timeout_s,
            std::process::SpawnOptions { env: env },
            slot,
        );
    }

    /// `exec` under `opts` (a host step's working directory and its own
    /// environment alone).
    @unbounded
    fn exec_with(
        argv: String,
        input: String,
        timeout_s: Int,
        opts: std::process::SpawnOptions,
        slot: Attempter
    ) -> Ran {
        let child = std::process::spawn_with(argv, opts) or {
            return Ran { code: 127, err: "could not start " + first_line(argv), unstarted: true };
        };
        if len(input) > 0 { std::process::write_stdin(child, input) or discard; }
        std::process::close_stdin(child);
        let until = std::time::monotonic_ns() + timeout_s * 1000000000;
        let mut out = "";
        let mut err = "";
        while true {
            let o = std::process::read_stdout(child) or "";
            if len(o) > 0 && len(out) < 1048576 { out = out + o; }
            let e = std::process::read_stderr(child) or "";
            if len(e) > 0 { err = keep_tail(err + e, 8192); }
            let c = std::process::try_wait(child) or - 1;
            if c != -2 {
                out = out + (std::process::read_stdout(child) or "");
                err = keep_tail(err + (std::process::read_stderr(child) or ""), 8192);
                return Ran { code: c, out: out, err: err };
            }
            if self.stopping(slot) || std::time::monotonic_ns() > until {
                std::process::kill(child) or discard;
                return Ran { code: -1, out: out, err: err, stopped: true };
            }
            std::time::sleep(50ms);
        }
        return Ran { };
    }

    /// The harness's run: its output read line by line as it comes, the
    /// container removed when the attempt stops, falls silent past its
    /// idle limit, or passes its budget.
    @unbounded
    fn harness_run(
        argv: String,
        input: String,
        idle_s: Int,
        opts: std::process::SpawnOptions,
        host: Bool,
        slot: Attempter
    ) -> Ran {
        let child = std::process::spawn_with(argv, opts) or {
            return Ran {
                code: 127,
                err: if host {
                    "the CLI could not be started"
                } else {
                    "docker could not be started"
                },
                unstarted: true,
            };
        };
        if len(input) > 0 { std::process::write_stdin(child, input) or discard; }
        std::process::close_stdin(child);
        let mut heard = std::time::monotonic_ns();
        let mut raw = "";
        let mut err = "";
        while true {
            let o = std::process::read_stdout(child) or "";
            if len(o) > 0 {
                heard = std::time::monotonic_ns();
                raw = raw + o;
                let mut nl = std::str::index_of(raw, "\n");
                while nl >= 0 {
                    self.add(self.reader.feed(raw[0..nl]));
                    raw = raw[(nl + 1)..len(raw)];
                    nl = std::str::index_of(raw, "\n");
                }
            }
            let e = std::process::read_stderr(child) or "";
            if len(e) > 0 { err = keep_tail(err + e, 8192); }
            let c = std::process::try_wait(child) or - 1;
            if c != -2 {
                raw = raw + (std::process::read_stdout(child) or "");
                self.feed_rest(raw);
                err = keep_tail(err + (std::process::read_stderr(child) or ""), 8192);
                // what a host run left running in its process group goes
                // with it
                if host { stop_group(child.pid); }
                return Ran { code: c, err: err };
            }
            if self.a.budget_tokens > 0 && self.reader.has_usage
                && self.reader.input_tokens + self.reader.output_tokens > self.a.budget_tokens
                && len(self.stop) == 0
            {
                self.stop = "the harness used more than its budget of "
                    + to_string(self.a.budget_tokens) + " tokens";
                self.stop_kind = "over_budget";
            }
            if len(self.stop) == 0 && (std::time::monotonic_ns() - heard) / 1000000000 > idle_s {
                self.stop = "the harness was silent for more than " + to_string(idle_s) + " s";
                self.stop_kind = "harness_failed";
            }
            if self.stopping(slot) {
                if host {
                    stop_group(child.pid);
                } else {
                    run_out("docker\nrm\n-f\n" + harness_name(self.a.id));
                }
                std::process::kill(child) or discard;
                return Ran { code: -1, err: err, stopped: true };
            }
            std::time::sleep(20ms);
        }
        return Ran { };
    }

    /// Every line left in `raw`, read.
    @unbounded
    fn feed_rest(raw: String) {
        let mut rest = raw;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let line = if nl < 0 { rest } else { rest[0..nl] };
            rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
            self.add(self.reader.feed(line));
        }
    }

    /// Whether the attempt is to stop now: cancelled, past its deadline,
    /// stopped by a limit, or the node stopping. Reports when it is time.
    fn stopping(slot: Attempter) -> Bool {
        if std::time::monotonic_ns() - self.reported_ns >= REPORT_EVERY_NS
            || self.pending_n >= REPORT_EVENTS
        {
            self.report_now("", "", "", "");
        }
        if len(self.stop) > 0 { return true; }
        if slot.draining {
            self.stop = "the node stopped while it ran";
            self.stop_kind = "node_lost";
        } else if std::time::unix(std::time::current()) >= self.a.deadline {
            self.stop = "it passed its deadline";
            self.stop_kind = "past_deadline";
        }
        return len(self.stop) > 0;
    }

    /// Events to report.
    @unbounded
    fn add(lines: String) {
        if len(lines) == 0 { return; }
        self.pending = self.pending + lines;
        self.pending_n = self.pending_n + count_lines(lines);
    }

    /// One of voice's own lines in the transcript.
    fn note(text: String) { self.add(event_line("note", text)); }

    /// Report the attempt: every event waiting, and the fields given; a
    /// cancel in an answer stops the attempt. True when the api took it all.
    @unbounded
    fn report_now(state: String, base_sha: String, head_sha: String, extra: String) -> Bool {
        self.reported_ns = std::time::monotonic_ns();
        // what waits goes `REPORT_EVENTS` at a time, each taken before the
        // next is sent, the fields and the end with the last
        while self.pending_n > REPORT_EVENTS {
            if !self.send_report("", "", "", "") { return false; }
        }
        return self.send_report(state, base_sha, head_sha, extra);
    }

    /// `POST /node/v1/attempts/{id}/report` with the first `REPORT_EVENTS`
    /// events waiting and the fields given; true when the api took it.
    /// Events it did not take wait for the next, in order.
    @unbounded
    fn send_report(state: String, base_sha: String, head_sha: String, extra: String) -> Bool {
        let mut cut = 0;
        let mut taken = 0;
        let v = std::str::bytes_view(self.pending);
        while cut < v.n && taken < REPORT_EVENTS {
            if std::str::byte_at(v, cut) == 10 { taken = taken + 1; }
            cut = cut + 1;
        }
        let sent = self.pending[0..cut];
        let rest = self.pending[cut..len(self.pending)];
        let events = std::str::replace(std::str::trim(sent), "\n", ", ");
        let body = "{\"phase\": " + q(self.phase) + ", \"harness\": "
            + q(harness::text_of(self.a.definition, "id")) + ", \"events\": [" + events + "]"
            + (if len(state) > 0 { ", \"state\": " + q(state) } else { "" })
            + (if len(base_sha) > 0 { ", \"base_sha\": " + q(base_sha) } else { "" })
            + (if len(head_sha) > 0 { ", \"head_sha\": " + q(head_sha) } else { "" })
            + (if self.reader.has_usage {
                ", \"usage\": {\"input_tokens\": " + to_string(self.reader.input_tokens)
                    + ", \"output_tokens\": " + to_string(self.reader.output_tokens) + "}"
            } else {
                ""
            }) + ", \"wall_ms\": "
            + to_string((std::time::monotonic_ns() - self.started_ns) / 1000000)
            + extra + "}";
        let resp = self.call("POST", "/node/v1/attempts/" + self.a.id + "/report", body);
        if resp.status != 200 { return false; }
        self.pending = rest;
        self.pending_n = self.pending_n - taken;
        if std::json::find_bool_field(std::str::from_bytes(resp.body), "cancel") {
            if len(self.stop) == 0 && len(state) == 0 {
                self.cancelled = true;
                self.stop = "it was cancelled";
            }
        }
        return true;
    }

    /// The attempt's end, reported (state, failure and its kind, commits,
    /// summary), and told back as the outcome.
    fn finish(
        state: String,
        failure: String,
        kind: String,
        base_sha: String,
        head_sha: String,
        summary: String
    ) -> String {
        if len(failure) > 0 { self.add(event_line("error", failure)); }
        self.phase = "";
        // the end is the attempt's result: told until the api takes it
        // (an api restarting, or briefly away), and only then is what the
        // attempt made removed; past `FINAL_REPORT_S` the api has failed it
        // as lost
        let extra = (if len(failure) > 0 { ", \"failure\": " + q(failure) } else { "" })
            + (if state == "failed" { ", \"failure_kind\": " + q(kind) } else { "" })
            + (if len(summary) > 0 { ", \"summary\": " + q(summary) } else { "" });
        let until = std::time::monotonic_ns() + FINAL_REPORT_S * 1000000000;
        let mut wait_ms = 1000;
        while !self.report_now(state, base_sha, head_sha, extra) {
            if std::time::monotonic_ns() > until {
                log_error(
                    "an attempt's end could not be reported",
                    fields2(std::log::kv("attempt", self.a.id), std::log::kv("state", state)),
                );
                return state;
            }
            std::time::sleep(wait_ms * 1ms);
            wait_ms = if wait_ms < 30000 { wait_ms * 2 } else { 30000 };
        }
        return state;
    }

    /// An attempt stopped before its harness's commits were taken.
    fn stopped(base_sha: String, head_sha: String) -> String {
        if self.cancelled { return self.finish("cancelled", "", "", base_sha, head_sha, ""); }
        return self.finish("failed", self.stop, self.stop_kind, base_sha, head_sha, "");
    }

    /// A step failed, `why`, of kind `kind`: once the attempt was stopped
    /// (the stop cuts every step after it short), it ends as its stop.
    fn failed(
        why: String,
        kind: String,
        base_sha: String,
        head_sha: String,
        summary: String
    ) -> String {
        if len(self.stop) > 0 { return self.stopped(base_sha, head_sha); }
        return self.finish("failed", why, kind, base_sha, head_sha, summary);
    }

    /// The image `tag`, built from `base` with `install` when the node has
    /// none of that name; "" when it is there, else why not.
    fn ensure_image(tag: String, base: String, install: String, slot: Attempter) -> String {
        let has = std::process::run(
            "docker\nimage\ninspect\n--format\n{{.Id}}\n" + tag,
        ) or std::process::ProcessOutput {
            code: 127,
            signal: 0,
            stdout: "",
            stderr: "",
        };
        if has.code == 0 { return ""; }
        if has.code == 127 { return "this node has no docker: attempts run in a container"; }
        self.note("building " + tag);
        let b = self.exec(
            "docker\nbuild\n-q\n-t\n" + tag + "\n--label\nnet.hale-lang.voice.image=harness\n-",
            dockerfile(base, install),
            2400,
            "",
            slot,
        );
        if b.code != 0 {
            return if b.stopped && len(self.stop) > 0 {
                self.stop
            } else {
                "the image " + tag + " could not be built: " + clip(b.err)
            };
        }
        return "";
    }

    /// The attempt's network, with no route out, and its egress proxy on
    /// it and on docker's own bridge, which also lets through `route`'s
    /// host and port, the api's (none when it has no host): "" when they
    /// run, else why not.
    @unbounded
    fn start_egress(proxy: String, route: ApiRoute, slot: Attempter) -> String {
        // the api's list holds the definition's hosts, the registries and the
        // seat's
        let hosts = self.a.egress;
        std::io::fs::write_file(
            self.dir + "/egress/filter",
            egress_filter(hosts) + route_filter(route),
        ) or discard;
        std::io::fs::write_file(
            self.dir + "/egress/tinyproxy.conf",
            egress_config(route.port),
        ) or discard;
        run_out("chmod\n755\n" + self.dir + "/egress");
        run_out(
            "chmod\n644\n" + self.dir + "/egress/filter\n" + self.dir + "/egress/tinyproxy.conf",
        );
        let net = self.exec(
            "docker\nnetwork\ncreate\n--internal\n--label\n" + ATTEMPT_LABEL + "=" + self.node
                + "\n"
                + harness_name(self.a.id),
            "",
            60,
            "",
            slot,
        );
        if net.code != 0 { return "the attempt's network could not be made: " + clip(net.err); }
        let p = self.exec(
            "docker\nrun\n-d\n--name\n" + egress_name(self.a.id) + "\n--label\n" + OWNER_LABEL + "="
                + self.node + "\n--label\n" + ATTEMPT_LABEL + "=" + self.node
                + "\n--user\n65534:65534\n--cap-drop\nALL\n--security-opt\nno-new-privileges\n-v\n"
                + self.dir + "/egress:/etc/voice-egress:ro\n" + proxy
                + "\ntinyproxy\n-d\n-c\n/etc/voice-egress/tinyproxy.conf",
            "",
            120,
            "",
            slot,
        );
        if p.code != 0 { return "the attempt's egress proxy could not start: " + clip(p.err); }
        let c = self.exec(
            "docker\nnetwork\nconnect\n" + harness_name(self.a.id) + "\n" + egress_name(self.a.id),
            "",
            60,
            "",
            slot,
        );
        if c.code != 0 {
            return "the attempt's egress proxy could not join its network: " + clip(c.err);
        }
        self.note(
            "egress: " + std::str::replace(std::str::trim(hosts), "\n", ", ")
                + (
                    if len(route.host) > 0 {
                        "; voice's api at " + route.host + ":" + to_string(route.port)
                    } else {
                        ""
                    }
                ),
        );
        return "";
    }

    /// The login a run needs, ready: a vault entry is read later, into the
    /// run alone; a login directory's files are copied into the attempt's
    /// scratch copy. "" when it is ready, else why not.
    @unbounded
    fn login_ready(def: harness::HarnessDef, host: Bool) -> String {
        if def.login_kind != "home" { return ""; }
        let from = self.data + "/logins/" + self.a.login
            + (if len(def.login_from) > 0 { "/" + def.login_from } else { "" });
        let scratch = login_scratch(def, self.dir, host);
        run_out("mkdir\n-m\n700\n-p\n" + scratch);
        let mut files = def.login_files;
        while len(files) > 0 {
            let nl = std::str::index_of(files, "\n");
            let f = files[0..nl];
            files = files[(nl + 1)..len(files)];
            if !std::io::fs::file_exists(from + "/" + f) {
                return "login " + self.a.login + " holds no " + f
                    + " on this node: set it up as the harness says ("
                    + harness::text_of(
                        std::json::find_field_raw(self.a.definition, "login"),
                        "setup",
                    )
                    + ")";
            }
            let c = std::process::run(
                "cp\n-p\n" + from + "/" + f + "\n" + scratch + "/" + f,
            ) or std::process::ProcessOutput {
                code: 1,
                signal: 0,
                stdout: "",
                stderr: "",
            };
            if c.code != 0 { return "login " + self.a.login + "'s " + f + " could not be copied"; }
        }
        return "";
    }

    /// A login file the CLI refreshed in its scratch copy, put back in the
    /// login's directory (a new file, renamed over the old one).
    @unbounded
    fn copy_login_back(def: harness::HarnessDef, host: Bool) {
        if def.login_kind != "home" { return; }
        let scratch = login_scratch(def, self.dir, host);
        let to = self.data + "/logins/" + self.a.login
            + (if len(def.login_from) > 0 { "/" + def.login_from } else { "" });
        let mut files = def.login_files;
        while len(files) > 0 {
            let nl = std::str::index_of(files, "\n");
            let f = files[0..nl];
            files = files[(nl + 1)..len(files)];
            let mine = scratch + "/" + f;
            if std::io::fs::file_exists(mine) {
                let same = std::process::run(
                    "cmp\n-s\n" + mine + "\n" + to + "/" + f,
                ) or std::process::ProcessOutput {
                    code: 1,
                    signal: 0,
                    stdout: "",
                    stderr: "",
                };
                if same.code != 0 {
                    run_out("cp\n-p\n" + mine + "\n" + to + "/." + f + ".voice-new");
                    run_out("mv\n-f\n" + to + "/." + f + ".voice-new\n" + to + "/" + f);
                }
            }
        }
    }

    /// Where the attempt's recipe runs: the first of its backends of the
    /// kind its seat runs (`container`, or `host` when the seat opts in)
    /// that this node can run. A container needs docker; the host, its
    /// CLI at the recipe's pinned version, found by detect or put in
    /// voice's prefix by the backend's install. None fits: why, and
    /// `backend_unavailable`.
    @unbounded
    fn pick_backend(def: harness::HarnessDef, slot: Attempter) -> BackendPick {
        let want = if self.a.backend == "host" { "host" } else { "container" };
        let mut why = "";
        let mut listed = false;
        for b in def.backends {
            if b.kind != want { continue; }
            listed = true;
            if b.kind == "container" {
                if has_docker() { return BackendPick { backend: b }; }
                why = why + "this node has no docker, which a container needs; ";
            } else {
                let found = self.detect(def, b);
                if len(found) == 0 { return BackendPick { backend: b }; }
                if len(b.install_argv) == 0 {
                    why = why + found + " (and the backend installs nothing); ";
                } else {
                    let put = self.install(def, b, slot);
                    if self.stopping(slot) {
                        return BackendPick { why: self.stop, kind: self.stop_kind };
                    }
                    if len(put) > 0 {
                        why = why + found + "; " + put + "; ";
                    } else {
                        let again = self.detect(def, b);
                        if len(again) == 0 { return BackendPick { backend: b }; }
                        why = why + "installed, but " + again + "; ";
                    }
                }
            }
        }
        if !listed {
            return BackendPick { why: no_backend_of(def, want), kind: "backend_unavailable" };
        }
        let said = std::str::trim(why);
        return BackendPick {
            why: "no " + want + " backend of CLI recipe " + def.id + " runs on this node: "
                + (if std::str::ends_with(said, ";") { said[0..(len(said) - 1)] } else { said }),
            kind: "backend_unavailable",
        };
    }

    /// The node's own variables a host step keeps: its user, shell and
    /// language.
    fn node_env() -> String {
        let mut out = "";
        let names = "USER\nLOGNAME\nSHELL\nLANG\nLC_ALL\n";
        let mut rest = names;
        while len(rest) > 0 {
            let nl = std::str::index_of(rest, "\n");
            let n = rest[0..nl];
            rest = rest[(nl + 1)..len(rest)];
            if std::env::var_exists(n) && !std::str::contains(std::env::var(n), "\n") {
                out = out + n + "=" + std::env::var(n) + "\n";
            }
        }
        return out;
    }

    /// The variables every host step of the attempt runs with (`host_env`)
    /// for recipe `def`.
    fn host_base_env(def: harness::HarnessDef) -> String {
        let path = if std::env::var_exists("PATH") && len(std::env::var("PATH")) > 0 {
            std::env::var("PATH")
        } else {
            "/usr/local/bin:/usr/bin:/bin"
        };
        return host_env(self.dir, cli_prefix(self.data, def), path, self.node_env());
    }

    /// "" when host backend `b`'s detect finds the CLI at the recipe's
    /// pinned version (on the node's PATH, after voice's prefix), else what
    /// it found. It runs as an argv, with no shell, the host steps' own
    /// environment and a time limit.
    @unbounded
    fn detect(def: harness::HarnessDef, b: harness::HarnessBackend) -> String {
        let argv = harness::with_prefix(b.detect, cli_prefix(self.data, def));
        let r = std::process::run_with(
            argv,
            std::process::SpawnOptions {
                cwd: self.dir + "/run-home",
                env: self.host_base_env(def),
                clear_env: true,
                timeout: DETECT_S * 1s,
            },
        ) or std::process::ProcessOutput { code: 127, signal: 0, stdout: "", stderr: "" };
        if harness::version_detected(b.detect_version, def.version, r.stdout + "\n" + r.stderr) {
            return "";
        }
        let said = first_line(r.stdout + "\n" + r.stderr);
        return "detect (" + std::str::replace(std::str::trim(argv), "\n", " ") + ") found no "
            + def.name + " " + def.version
            + (
                if r.code == 127 && len(said) == 0 {
                    ": not on the node's PATH"
                } else if len(said) > 0 {
                    ", it said: " + said
                } else {
                    ", it exited " + to_string(r.code)
                }
            );
    }

    /// Recipe `def`'s CLI, at its pinned version, put in voice's prefix by
    /// host backend `b`'s install, once per node: "" when it is there (put
    /// now, or before), else why not. One install at a time of a version
    /// (a lock directory beside it); an install cut short leaves no prefix.
    @unbounded
    fn install(def: harness::HarnessDef, b: harness::HarnessBackend, slot: Attempter) -> String {
        let prefix = cli_prefix(self.data, def);
        let mark = prefix + "/" + INSTALLED_MARK;
        if std::io::fs::file_exists(mark) { return ""; }
        run_out("mkdir\n-m\n700\n-p\n" + self.data + "/clis/" + def.id);
        let lock = prefix + ".lock";
        let until = std::time::monotonic_ns() + INSTALL_S * 1000000000;
        while !locked(lock) {
            if std::io::fs::file_exists(mark) { return ""; }
            if self.stopping(slot) { return self.stop; }
            if std::time::monotonic_ns() > until {
                return "another attempt's install of " + def.name + " " + def.version
                    + " did not finish";
            }
            std::time::sleep(1000ms);
        }
        if std::io::fs::file_exists(mark) {
            run_out("rmdir\n" + lock);
            return "";
        }
        run_out("rm\n-rf\n" + prefix);
        run_out("mkdir\n-m\n700\n-p\n" + prefix);
        self.note("installing " + def.name + " " + def.version + " into voice's prefix, " + prefix);
        let r = self.exec_with(
            harness::with_prefix(b.install_argv, prefix),
            "",
            INSTALL_S,
            std::process::SpawnOptions {
                cwd: prefix,
                env: self.host_base_env(def) + harness::with_prefix(b.install_env, prefix),
                clear_env: true,
            },
            slot,
        );
        if r.code != 0 || r.stopped {
            run_out("rm\n-rf\n" + prefix);
            run_out("rmdir\n" + lock);
            if r.stopped && len(self.stop) > 0 { return self.stop; }
            return "its install exited with code " + to_string(r.code) + tail_of(r.err);
        }
        std::io::fs::write_file(mark, def.id + " " + def.version + "\n") or discard;
        run_out("rmdir\n" + lock);
        return "";
    }

    /// The recipe's files, written in the attempt's /voice: "" when they
    /// are, else why not.
    @unbounded
    fn write_files(def: harness::HarnessDef) -> String {
        if len(def.files) == 0 { return ""; }
        let mut it = std::json::array_first(def.files);
        while !it.done {
            let path = harness::text_of(it.element, "path");
            let name = path[len("/voice/")..len(path)];
            std::io::fs::write_file(
                self.dir + "/voice/" + name,
                std::json::find_string_field(it.element, "text"),
            ) or {
                return "the recipe's file " + path + " could not be written";
            };
            it = std::json::array_next(it);
        }
        return "";
    }

    /// Commit what a host run left in the workspace, as the caller: voice's
    /// own git, with no hooks and no fsmonitor, under no configuration but
    /// the workspace's own (which the CLI, as the node's user, could write;
    /// it could as well run anything as that user). No failure when it
    /// went, or there was nothing.
    fn commit_left_host(slot: Attempter) -> Failure {
        let r = self.exec_with(
            "sh\n-c\nif [ -n \"$(git status --porcelain)\" ]; then git -c core.hooksPath=/dev/null -c core.fsmonitor=false add -A && git -c core.hooksPath=/dev/null -c core.fsmonitor=false commit -q --no-verify -F \"$1\"; fi\nsh\n"
                + self.dir + "/voice/message",
            "",
            600,
            std::process::SpawnOptions {
                cwd: self.dir + "/work",
                env: GIT_ENV + "\nHOME=" + self.dir + "/home\nXDG_CONFIG_HOME=" + self.dir
                    + "/home\nGIT_AUTHOR_NAME=" + self.a.name + "\nGIT_AUTHOR_EMAIL=" + self.a.email
                    + "\nGIT_COMMITTER_NAME=" + self.a.name + "\nGIT_COMMITTER_EMAIL="
                    + self.a.email,
            },
            slot,
        );
        if r.stopped && len(self.stop) > 0 {
            return Failure { why: self.stop, kind: self.stop_kind };
        }
        if r.code != 0 {
            return Failure {
                why: "what the harness left could not be committed: " + clip(r.err),
                kind: "harness_failed",
            };
        }
        return Failure { };
    }

    /// Commit what the harness left in the workspace, as the caller, in a
    /// container with no network: no failure when it went, or there was
    /// nothing.
    fn commit_left(image: String, user: String, slot: Attempter) -> Failure {
        let r = self.exec(
            "docker\nrun\n--rm\n--name\n" + commit_name(self.a.id) + "\n--label\n" + OWNER_LABEL
                + "="
                + self.node + "\n--label\n" + ATTEMPT_LABEL + "=" + self.node
                + "\n--network\nnone\n--user\n"
                + user
                + "\n--cap-drop\nALL\n--security-opt\nno-new-privileges\n--tmpfs\n/home/voice:rw,mode=1777\n-e\nHOME=/home/voice\n-w\n/work\n-v\n"
                + self.dir + "/work:/work:rw\n-v\n" + self.dir
                + "/voice:/voice:ro\n-e\nGIT_AUTHOR_NAME="
                + self.a.name + "\n-e\nGIT_AUTHOR_EMAIL=" + self.a.email
                + "\n-e\nGIT_COMMITTER_NAME="
                + self.a.name + "\n-e\nGIT_COMMITTER_EMAIL=" + self.a.email + "\n" + SAFE_WORK
                + image
                + "\nsh\n-c\nif [ -n \"$(git status --porcelain)\" ]; then git add -A && git -c core.hooksPath=/dev/null commit -q --no-verify -F /voice/message; fi",
            "",
            600,
            "",
            slot,
        );
        if r.stopped && len(self.stop) > 0 {
            return Failure { why: self.stop, kind: self.stop_kind };
        }
        if r.code != 0 {
            return Failure {
                why: "what the harness left could not be committed: " + clip(r.err),
                kind: exit_kind(r),
            };
        }
        return Failure { };
    }

    /// The branch's commits from `base_sha`, as a bundle the api holds
    /// for the caller: no failure when it is held.
    fn bundle(push: String, base_sha: String, slot: Attempter) -> Failure {
        let file = self.dir + "/attempt.bundle";
        let b = self.git(
            "--git-dir\n" + push + "\nbundle\ncreate\n-q\n" + file + "\n" + base_sha
                + "..refs/heads/" + self.a.branch,
            600,
            slot,
        );
        if b.code != 0 {
            return Failure {
                why: "the commits could not be bundled: " + clip(b.err),
                kind: "internal",
            };
        }
        let bytes = std::io::fs::read_bytes(file) or b"";
        if len(bytes) == 0 {
            return Failure { why: "the bundle could not be read", kind: "internal" };
        }
        if len(bytes) > 6291456 {
            return Failure {
                why: "the commits' bundle is over 6 MiB, the most voice holds",
                kind: "bundle_too_large",
            };
        }
        let body = "{\"bytes\": " + to_string(len(bytes)) + ", \"bundle\": \""
            + std::text::base64::encode(bytes) + "\"}";
        // held until the api takes it, as the attempt's end is
        let until = std::time::monotonic_ns() + FINAL_REPORT_S * 1000000000;
        let mut wait_ms = 1000;
        let mut resp = self.call("PUT", "/node/v1/attempts/" + self.a.id + "/bundle", body);
        while (resp.status == 0 || resp.status >= 500) && std::time::monotonic_ns() < until {
            std::time::sleep(wait_ms * 1ms);
            wait_ms = if wait_ms < 30000 { wait_ms * 2 } else { 30000 };
            resp = self.call("PUT", "/node/v1/attempts/" + self.a.id + "/bundle", body);
        }
        if resp.status != 204 {
            return Failure {
                why: "the api did not take the bundle (" + to_string(resp.status) + ")",
                kind: "internal",
            };
        }
        self.note("bundled the commits from " + base_sha[0..12]);
        return Failure { };
    }

    /// Everything the attempt made, removed: its containers (the harness's
    /// is gone with `--rm` unless it was stopped), its network, and its
    /// directory with the workspace, the login's scratch copy and the
    /// bundle.
    fn clean_up(def: harness::HarnessDef) {
        run_out(
            "docker\nrm\n-f\n" + harness_name(self.a.id) + "\n" + commit_name(self.a.id) + "\n"
                + egress_name(self.a.id),
        );
        run_out("docker\nnetwork\nrm\n" + harness_name(self.a.id));
        if attempt_id(self.a.id) && std::str::ends_with(self.dir, "/attempts/" + self.a.id) {
            run_out("rm\n-rf\n" + self.dir);
        }
    }

    /// One node-plane call; a status of 0 when the api cannot be reached.
    fn call(method: String, path: String, body: String) -> std::http::ClientResponse {
        let url = std::http::parse_url(self.api + path) or std::http::Url { };
        if len(url.host) == 0 { return std::http::ClientResponse { status: 0, body: b"" }; }
        let client = std::http::Client { timeout_ms: 30000, max_retries: 0 };
        // the token goes on the wire as it is held (spec/semantics.md, "@sealed")
        if len(self.token) > 0 {
            return client.request(
                std::http::ClientRequest {
                    method: method,
                    url: url,
                    headers: "Authorization: Bearer " + self.token
                        + "\r\nContent-Type: application/json",
                    body: std::bytes::from_string(body),
                },
            ) or std::http::ClientResponse { status: 0, body: b"" };
        }
        return client.request(
            std::http::ClientRequest {
                method: method,
                url: url,
                headers: "Authorization: Bearer " + self.credential.reveal_text()
                    + "\r\nContent-Type: application/json",
                body: std::bytes::from_string(body),
            },
        ) or std::http::ClientResponse { status: 0, body: b"" };
    }
}

/// Where a run of `def` in `dir` keeps its login directory's scratch copy:
/// the attempt's `login` directory, mounted in a container; on the host,
/// where the login's mount is as a host run has it (`host_login_dir`).
fn login_scratch(def: harness::HarnessDef, dir: String, host: Bool) -> String {
    return if host { host_login_dir(def, dir) } else { dir + "/login" };
}

/// Whether this node has docker, which a container backend needs: its
/// client answers.
fn has_docker() -> Bool {
    let r = std::process::run("docker\n--version") or std::process::ProcessOutput {
        code: 127,
        signal: 0,
        stdout: "",
        stderr: "",
    };
    return r.code == 0;
}

/// Directory `path` made, as a lock: true when this call made it (no other
/// holds it).
fn locked(path: String) -> Bool {
    std::io::fs::mkdir(path) or { return false; };
    return true;
}

/// Everything left running in the process group a host run started
/// (`pid`, its leader: every child voice spawns leads a group of its own),
/// stopped.
fn stop_group(pid: Int) {
    if pid > 1 { run_out("kill\n-s\nKILL\n--\n-" + to_string(pid)); }
}

/// What installs of CLIs in voice's prefix left from before the node
/// started, removed: a version whose install was cut short (no
/// `INSTALLED_MARK`), and its lock. A finished install stays, shared by
/// the attempts of that version.
@unbounded
fn clean_clis(data: String) {
    let root = data + "/clis";
    if !std::io::fs::file_exists(root) { return; }
    let n = std::io::fs::list_dir_count(root) or 0;
    let mut i = 0;
    while i < n {
        let recipe = std::io::fs::list_dir_at(root, i) or "";
        i = i + 1;
        if !harness::slug(recipe) { continue; }
        let dir = root + "/" + recipe;
        let m = std::io::fs::list_dir_count(dir) or 0;
        let mut gone = "";
        let mut j = 0;
        while j < m {
            let entry = std::io::fs::list_dir_at(dir, j) or "";
            j = j + 1;
            if len(entry) == 0
                || std::str::starts_with(entry, ".")
                || std::str::contains(entry, "/")
            {
                continue;
            }
            if std::str::ends_with(entry, ".lock")
                || !std::io::fs::file_exists(dir + "/" + entry + "/" + INSTALLED_MARK)
            {
                gone = gone + dir + "/" + entry + "\n";
            }
        }
        if len(gone) > 0 { run_out("rm\n-rf\n" + gone[0..(len(gone) - 1)]); }
    }
}

/// The node's attempts left from before it started, removed: every
/// container and network an attempt of this node made (by its label), and
/// the directory attempts are run in. No attempt is running yet, so none
/// of them is held.
fn clean_attempts(node: String, data: String) {
    let containers = run_out("docker\nps\n-aq\n--filter\nlabel=" + ATTEMPT_LABEL + "=" + node);
    remove_each("docker\nrm\n-f\n", containers);
    let nets = run_out("docker\nnetwork\nls\n-q\n--filter\nlabel=" + ATTEMPT_LABEL + "=" + node);
    remove_each("docker\nnetwork\nrm\n", nets);
    if std::io::fs::file_exists(data + "/attempts") { run_out("rm\n-rf\n" + data + "/attempts"); }
    run_out("mkdir\n-m\n700\n-p\n" + data + "/attempts");
    clean_clis(data);
}

/// `command` run for each id, a line each, in `ids`.
@bounded_by(ids)
fn remove_each(command: String, ids: String) {
    let mut rest = ids;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let id = std::str::trim(if nl < 0 { rest } else { rest[0..nl] });
        rest = if nl < 0 { "" } else { rest[(nl + 1)..len(rest)] };
        if len(id) > 0 { run_out(command + id); }
    }
}

/// The last `n` bytes of `s`.
fn keep_tail(s: String, n: Int) -> String {
    if len(s) <= n { return s; }
    let v = std::str::bytes_view(s);
    let mut from = len(s) - n;
    while from < len(s) && std::str::byte_at(v, from) >= 128 && std::str::byte_at(v, from) < 192 {
        from = from + 1;
    }
    return s[from..len(s)];
}

/// A command's stderr, short, for a failure.
fn clip(s: String) -> String {
    return harness::clip_utf8(std::str::trim(s), 300);
}

/// ": " and the end of a harness's stderr, for its failure; "" for none.
fn tail_of(err: String) -> String {
    let t = std::str::trim(keep_tail(err, 300));
    return if len(t) > 0 { ": " + t } else { "" };
}

/// The first line of `s`, at most 72 bytes.
fn first_line(s: String) -> String {
    let t = std::str::trim(s);
    let nl = std::str::index_of(t, "\n");
    let line = std::str::trim(if nl < 0 { t } else { t[0..nl] });
    return harness::clip_utf8(line, 72);
}

/// `s` with at most 16 KiB of it.
fn clip_lines(s: String) -> String {
    return harness::clip_utf8(s, 16384);
}

/// How many lines `s` holds.
@bounded_by(s)
fn count_lines(s: String) -> Int {
    let v = std::str::bytes_view(s);
    let mut n = 0;
    let mut i = 0;
    while i < v.n {
        if std::str::byte_at(v, i) == 10 { n = n + 1; }
        i = i + 1;
    }
    return n;
}
