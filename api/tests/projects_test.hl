// Projects on the admin plane: the rows of `Projects` (list, create, get,
// update, archive), called on a receiver over a store.
import ".." as api;
import "../../store" as st;

fn names(xs: bounded[String; 32]) -> String {
    let mut out = "";
    for x in xs {
        out = out + (if len(out) > 0 { "," } else { "" }) + x;
    }
    return out;
}

fn limit(scope: st::LimitScope, requests: Int) -> st::Limit {
    return st::counted(st::Limit { scope: scope, window_seconds: 60, requests: requests });
}

fn main() {
    let store = st::MemoryStore { };
    let projects = api::Projects { store: store };
    let keys = api::Keys { store: store };
    let changes = api::Changes { store: store };

    let none = projects.list(api::ProjectQuery { }) or api::ProjectList { };
    std::test::assert_eq_int(count(none.data), 0, "no projects yet");

    let mut c = api::ProjectCreate { id: "work", name: "Work" };
    push(c.owners, "operator@example.com") or discard;
    push(c.data_classes, "public") or discard;
    push(c.data_classes, "internal") or discard;
    let work = projects.create(c) or api::Project { status: api::Lifecycle::archived };
    std::test::assert(work.status == api::Lifecycle::active, "a new project is active");
    std::test::assert_eq_str(work.id, "work", "its id");
    std::test::assert_eq_str(names(work.owners), "operator@example.com", "its owners");
    std::test::assert_eq_str(names(work.data_classes), "public,internal", "its data classes");
    std::test::assert(!work.has_models, "the whole catalog");
    std::test::assert(!work.has_accounts, "any account");
    std::test::assert(!work.has_budget, "no budget yet");
    std::test::assert_eq_int(count(work.limits), 0, "no limits yet");
    std::test::assert_eq_int(work.key_count, 0, "no keys");
    std::test::assert(!work.has_archived_at, "not archived");

    let mut l = api::ProjectCreate { id: "lab", name: "Lab", has_models: true };
    push(l.models, "echo-1") or discard;
    let lab = projects.create(l) or api::Project { status: api::Lifecycle::archived };
    std::test::assert_eq_str(
        names(lab.data_classes),
        "internal",
        "data classes default to internal",
    );
    std::test::assert(lab.has_models, "restricted");
    std::test::assert_eq_str(names(lab.models), "echo-1", "restricted to one model");

    let mut failed = "";
    projects.create(api::ProjectCreate { id: "work", name: "Again" }) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).message;
    };
    std::test::assert_eq_str(
        failed,
        "conflict project work exists; a project id is never reused",
        "an id is taken once",
    );
    failed = "";
    projects.create(api::ProjectCreate { id: "Work", name: "W" }) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid id", "an id is lowercase");
    failed = "";
    projects.create(api::ProjectCreate { id: "-w", name: "W" }) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid id", "an id starts with a letter or digit");
    failed = "";
    projects.create(api::ProjectCreate { id: "w", name: "" }) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid name", "a name is required");
    failed = "";
    projects.create(
        api::ProjectCreate {
            id: "w",
            name: "W",
            has_budget: true,
            budget: api::BudgetInput { allowance_micros: -1, period: st::Period::month },
        },
    ) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid allowance_micros", "an allowance is at least 0");
    failed = "";
    projects.get(api::ProjectRef { project: "w" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "a refused create made nothing");

    let mut b = api::ProjectCreate {
        id: "w",
        name: "W",
        has_budget: true,
        budget: api::BudgetInput { allowance_micros: 1000, period: st::Period::month },
    };
    push(b.limits, limit(st::LimitScope::project, 600)) or discard;
    let budgeted = projects.create(b) or api::Project { status: api::Lifecycle::archived };
    std::test::assert_eq_str(budgeted.id, "w", "a project with its budget and limits");
    std::test::assert(budgeted.has_budget, "it has a budget");
    std::test::assert_eq_int(budgeted.budget.allowance_micros, 1000, "its budget");
    std::test::assert_eq_int(count(budgeted.limits), 1, "one limit");
    let mut requests = -1;
    for lim in budgeted.limits {
        requests = lim.requests;
    }
    std::test::assert_eq_int(requests, 600, "its limit");

    failed = "";
    let mut code_is_unsupported = false;
    projects.update(api::ProjectUpdate { project: "w", has_budget: true }) or {
        failed = api::ctl_class(err);
        code_is_unsupported = api::ctl_problem(err).code == api::ErrorCode::unsupported;
    };
    std::test::assert_eq_str(failed, "invalid", "a budget has its own endpoint");
    std::test::assert(code_is_unsupported, "unsupported");
    failed = "";
    projects.update(api::ProjectUpdate { project: "w", has_limits: true }) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid limits", "so do the limits");
    failed = "";
    projects.update(api::ProjectUpdate { project: "w", has_id: true, id: "x" }) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).param;
    };
    std::test::assert_eq_str(failed, "invalid id", "an id never changes");

    let got = projects.get(api::ProjectRef { project: "work" }) or api::Project {
        status: api::Lifecycle::archived,
    };
    std::test::assert_eq_str(got.id, "work", "get");
    failed = "";
    projects.get(api::ProjectRef { project: "nope" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "not_found", "an unknown project");

    let renamed = projects.update(
        api::ProjectUpdate { project: "lab", has_name: true, name: "The lab", clear_models: true },
    ) or api::Project { status: api::Lifecycle::archived };
    std::test::assert_eq_str(renamed.name, "The lab", "renamed");
    std::test::assert(!renamed.has_models, "the restriction lifted");
    std::test::assert_eq_str(names(renamed.data_classes), "internal", "a field not set stays");
    failed = "";
    projects.update(api::ProjectUpdate { project: "lab", has_name: true, name: "" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a name is not empty");

    // narrowing a project below what its keys name is refused, naming them
    let mut n = api::ProjectCreate { id: "nar", name: "N", has_models: true };
    push(n.models, "echo-1") or discard;
    push(n.models, "live-1") or discard;
    projects.create(n) or discard;
    let mut nk = api::KeyCreate { project: "nar", name: "k", has_models: true };
    push(nk.models, "live-1") or discard;
    let narrow_key = keys.create(nk) or api::Key { status: api::KeyStatus::revoked };
    let narrow_id = narrow_key.id;
    std::test::assert(len(narrow_id) > 0, "a key to narrow below");
    let mut to_echo = api::ProjectUpdate { project: "nar", has_models: true };
    push(to_echo.models, "echo-1") or discard;
    failed = "";
    projects.update(to_echo) or {
        failed = api::ctl_class(err) + " " + api::ctl_problem(err).message;
    };
    std::test::assert(
        std::str::starts_with(failed, "invalid "),
        "narrowing below a key: " + failed,
    );
    std::test::assert(std::str::contains(failed, narrow_id), "names the key: " + failed);
    let mut wider = api::ProjectUpdate { project: "nar", has_models: true };
    push(wider.models, "echo-1") or discard;
    push(wider.models, "live-1") or discard;
    push(wider.models, "more-1") or discard;
    let widened = projects.update(wider) or api::Project { status: api::Lifecycle::archived };
    std::test::assert_eq_str(names(widened.models), "echo-1,live-1,more-1", "widening is fine");
    keys.revoke(api::KeyRef { project: "nar", key: narrow_id }) or discard;
    let narrowed = projects.update(to_echo) or api::Project { status: api::Lifecycle::archived };
    std::test::assert_eq_str(
        names(narrowed.models),
        "echo-1",
        "once the key is revoked, the project narrows",
    );

    // archiving revokes the project's keys and takes it out of the list
    let key = keys.create(api::KeyCreate { project: "lab", name: "ci" }) or api::Key {
        status: api::KeyStatus::revoked,
    };
    std::test::assert(len(key.id) > 0, "a key to revoke");
    let gone = projects.archive(api::ProjectRef { project: "lab" }) or api::Project {
        status: api::Lifecycle::active,
    };
    std::test::assert(gone.status == api::Lifecycle::archived, "archived");
    std::test::assert(
        gone.has_archived_at && std::str::ends_with(std::time::iso8601(gone.archived_at), "Z"),
        "when",
    );
    let revoked = keys.get(api::KeyRef { project: "lab", key: key.id }) or api::Key {
        status: api::KeyStatus::active,
    };
    std::test::assert(revoked.status == api::KeyStatus::revoked, "its key is revoked");
    let log = changes.list(api::ChangeAsk { target: "projects/lab" }) or api::ChangeList { };
    std::test::assert(count(log.data) >= 2, "the log holds the archive and the revoke");
    let mut newest = api::Change { action: api::ChangeAction::create };
    let mut next = api::Change { action: api::ChangeAction::create };
    let mut at = 0;
    for ch in log.data {
        if at == 0 { newest = ch; }
        if at == 1 { next = ch; }
        at = at + 1;
    }
    std::test::assert(newest.action == api::ChangeAction::archive, "the archive, newest");
    std::test::assert(
        next.action == api::ChangeAction::revoke,
        "with a change for the key it revoked",
    );
    std::test::assert_eq_str(
        next.target,
        "projects/lab/keys/" + key.id,
        "under the key's own target",
    );
    std::test::assert_eq_str(
        std::json::find_string_field(next.after.text, "status"),
        "revoked",
        "as it became",
    );
    let again = projects.archive(api::ProjectRef { project: "lab" }) or api::Project {
        status: api::Lifecycle::active,
    };
    std::test::assert(
        again.status == api::Lifecycle::archived,
        "archiving again changes nothing",
    );
    let after_log = changes.list(api::ChangeAsk { target: "projects/lab" }) or api::ChangeList { };
    std::test::assert_eq_int(count(after_log.data), count(log.data), "and logs nothing");
    failed = "";
    let mut late_code = false;
    keys.create(api::KeyCreate { project: "lab", name: "late" }) or {
        failed = api::ctl_class(err);
        late_code = api::ctl_problem(err).code == api::ErrorCode::invalid_request;
    };
    std::test::assert_eq_str(failed, "invalid", "an archived project takes no key");
    std::test::assert(late_code, "as an invalid request, not a conflict");
    failed = "";
    projects.create(api::ProjectCreate { id: "lab", name: "Lab" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "its id is never reused");

    let active = projects.list(api::ProjectQuery { }) or api::ProjectList { };
    let mut seen_work = false;
    let mut seen_lab = false;
    for p in active.data {
        if p.id == "work" { seen_work = true; }
        if p.id == "lab" { seen_lab = true; }
    }
    std::test::assert(seen_work && !seen_lab, "the list leaves archived projects out");
    let all = projects.list(api::ProjectQuery { include_archived: true }) or api::ProjectList { };
    seen_lab = false;
    for p in all.data {
        if p.id == "lab" { seen_lab = true; }
    }
    std::test::assert(seen_lab, "unless it is asked for them");
}
