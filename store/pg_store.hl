    fn insert_recipe_locked(row: RecipeRow, change: ChangeRow) -> Bool fallible(StoreError) {
        self.begin() or raise;
        self.room(
            "SELECT count(*) FROM recipe",
            db::Args { },
            256,
            "voice holds at most 256 recipes",
        ) or raise;
        let a = db::Args { };
        a.add(row.id);
        a.add(row.body);
        a.add(std::time::iso8601(row.created_at));
        let n = self.step(
            "INSERT INTO recipe (id, body, created_at) VALUES ($1, $2::jsonb, $3::timestamptz) ON CONFLICT (id) DO NOTHING",
            a,
        ) or raise;
        if n == 0 {
            self.rollback();
            return false;
        }
        self.commit_with(change) or raise;
        return true;
    }

    fn remove_recipe(row: RecipeRow, change: ChangeRow) fallible(StoreError) {
        self.lock.enter();
        self.remove_recipe_locked(row, change) or {
            self.lock.leave();
            fail err;
        };
        self.lock.leave();
    }

    fn remove_recipe_locked(row: RecipeRow, change: ChangeRow) fallible(StoreError) {
        self.begin() or raise;
        let a = db::Args { };
        a.add(row.id);
        a.add(std::time::iso8601(row.removed_at));
        self.step("UPDATE recipe SET removed_at = $2::timestamptz WHERE id = $1", a) or raise;
        self.commit_with(change) or raise;
    }

