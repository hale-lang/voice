// The caller plane's catalog: GET /v1/models and GET /v1/models/{model},
// as the presented project key sees them, through the router.
import ".." as api;
import "../../store" as st;

fn caller(e: api::DataPlane, path: String, key: String) -> std::http::Response {
    return e.handle(
        std::http::Request { method: "GET", path: path, headers: "Authorization: Bearer " + key },
    );
}

fn expect(r: std::http::Response, status: Int, what: String) {
    std::test::assert_eq_int(r.status, status, what + ": " + r.body);
}

fn code(r: std::http::Response) -> String {
    return std::json::find_string_field(std::json::find_field_raw(r.body, "error"), "code");
}

/// A new key's secret.
fn key(keys: api::Keys, c: api::KeyCreate) -> String {
    let k = keys.create(c) or api::Key { status: api::KeyStatus::revoked };
    std::test::assert(k.has_secret, "a key under " + c.project);
    return k.secret;
}

fn main() {
    let e = api::DataPlane { };
    let catalog = api::Catalog { store: e.store };
    let projects = api::Projects { store: e.store };
    let keys = api::Keys { store: e.store };
    catalog.create(
        api::CatalogModelCreate {
            id: "echo-1",
            context_length: 8192,
            max_output_tokens: 1024,
            has_price: true,
            price: st::ModelPrice {
                input_per_mtok_micros: 3000000,
                output_per_mtok_micros: 15000000,
            },
        },
    ) or discard;
    catalog.create(
        api::CatalogModelCreate {
            id: "claude-sonnet-5",
            owned_by: "anthropic",
            has_kind: true,
            kind: api::ModelKind::hosted,
        },
    ) or discard;
    catalog.create(api::CatalogModelCreate { id: "old-1" }) or discard;
    catalog.remove(api::ModelRef { model: "old-1" }) or discard;
    projects.create(api::ProjectCreate { id: "work", name: "Work" }) or discard;
    let mut lab_project = api::ProjectCreate { id: "lab", name: "Lab", has_models: true };
    push(lab_project.models, "echo-1") or discard;
    projects.create(lab_project) or discard;
    let open = key(keys, api::KeyCreate { project: "work", name: "ci" });
    let mut narrow_key = api::KeyCreate { project: "work", name: "narrow", has_models: true };
    push(narrow_key.models, "claude-sonnet-5") or discard;
    let narrow = key(keys, narrow_key);
    let lab = key(keys, api::KeyCreate { project: "lab", name: "lab" });

    // who may ask
    let none = e.handle(std::http::Request { method: "GET", path: "/v1/models" });
    expect(none, 401, "no key");
    std::test::assert_eq_str(code(none), "invalid_key", "invalid_key");
    std::test::assert_eq_str(
        std::json::find_string_field(std::json::find_field_raw(none.body, "error"), "type"),
        "authentication_error",
        "an authentication error",
    );
    expect(
        caller(e, "/v1/models", "vk-0000000000000000000000000000000000000000"),
        401,
        "an unknown key",
    );
    expect(
        e.handle(
            std::http::Request {
                method: "GET",
                path: "/v1/models",
                headers: "Authorization: Basic " + open,
            },
        ),
        401,
        "not a bearer",
    );
    std::test::assert_eq_str(none.headers, "WWW-Authenticate: Bearer", "a 401 says what it takes");
    expect(
        e.handle(
            std::http::Request {
                method: "GET",
                path: "/v1/models",
                headers: "authorization: bearer " + open,
            },
        ),
        200,
        "the scheme in any case",
    );

    // what each key sees
    let all = caller(e, "/v1/models", open);
    expect(all, 200, "the open key");
    std::test::assert(std::str::starts_with(all.headers, "X-Request-Id: req_"), "a request id");
    std::test::assert_eq_str(std::json::find_string_field(all.body, "object"), "list", "a list");
    let ci_keys = keys.list(api::ProjectRef { project: "work" }) or api::KeyList { };
    let mut used = false;
    for k in ci_keys.data {
        if k.name == "ci" { used = k.has_last_used_at; }
    }
    std::test::assert(used, "a key used has its last use");
    std::test::assert(
        std::str::contains(all.body, "\"echo-1\"")
            && std::str::contains(all.body, "\"claude-sonnet-5\""),
        "the whole catalog",
    );
    std::test::assert(!std::str::contains(all.body, "old-1"), "but no removed model");
    std::test::assert(
        !std::str::contains(caller(e, "/v1/models", narrow).body, "\"echo-1\""),
        "a key's restriction narrows it",
    );
    let labs = caller(e, "/v1/models", lab);
    std::test::assert(
        std::str::contains(labs.body, "\"echo-1\"")
            && !std::str::contains(labs.body, "claude-sonnet-5"),
        "and so does a project's",
    );

    // one model
    let one = caller(e, "/v1/models/echo-1", open);
    expect(one, 200, "get");
    std::test::assert_eq_str(std::json::find_string_field(one.body, "object"), "model", "a model");
    std::test::assert_eq_str(
        std::json::find_string_field(one.body, "owned_by"),
        "local",
        "owned_by",
    );
    std::test::assert(
        std::json::find_int_field(one.body, "created") > 1700000000,
        "created, in Unix seconds",
    );
    let v = std::json::find_field_raw(one.body, "voice");
    std::test::assert_eq_str(std::json::find_string_field(v, "kind"), "local", "kind");
    std::test::assert_eq_int(
        std::json::find_int_field(v, "max_output_tokens"),
        1024,
        "max_output_tokens",
    );
    std::test::assert_eq_int(
        std::json::find_int_field(std::json::find_field_raw(v, "price"), "input_per_mtok_micros"),
        3000000,
        "its price",
    );
    std::test::assert(!std::json::find_bool_field(v, "available"), "no seat serves it yet");
    std::test::assert_eq_str(
        std::str::trim(std::json::find_field_raw(v, "data_classes")),
        "[]",
        "so no data class either",
    );

    let hidden = caller(e, "/v1/models/echo-1", narrow);
    expect(hidden, 404, "a model the key cannot see");
    std::test::assert_eq_str(code(hidden), "model_not_found", "is one that does not exist");
    expect(caller(e, "/v1/models/old-1", open), 404, "a removed model");
    expect(caller(e, "/v1/models/nope", open), 404, "an unknown model");
    expect(
        e.handle(std::http::Request { method: "GET", path: "/v1/models/echo-1" }),
        401,
        "a key first",
    );

    // a key stops working when it is revoked, or its project archived
    let listed = keys.list(api::ProjectRef { project: "work" }) or api::KeyList { };
    std::test::assert_eq_int(count(listed.data), 2, "the project's keys");
    let mut ci = "";
    let mut narrow_id = "";
    for k in listed.data {
        if k.name == "ci" { ci = k.id; } else { narrow_id = k.id; }
    }
    keys.revoke(api::KeyRef { project: "work", key: ci }) or discard;
    expect(caller(e, "/v1/models", open), 401, "a revoked key");
    expect(caller(e, "/v1/models", narrow), 200, "the project's other key still works");
    keys.update(
        api::KeyUpdate {
            project: "work",
            key: narrow_id,
            has_expires_at: true,
            expires_at: `2020-01-01T00:00:00Z`,
        },
    ) or discard;
    let aged = keys.get(
        api::KeyRef { project: "work", key: narrow_id },
    ) or api::Key { status: api::KeyStatus::revoked };
    std::test::assert(aged.status == api::KeyStatus::expired, "is expired");
    expect(caller(e, "/v1/models", narrow), 401, "an expired key");
    projects.archive(api::ProjectRef { project: "lab" }) or discard;
    expect(caller(e, "/v1/models", lab), 401, "an archived project's key");
}
