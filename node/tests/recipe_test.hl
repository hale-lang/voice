// CLI recipes (lib/harness): their backends, a container voice builds or the
// node's own machine, in order; the older `image` read as one container
// backend; a host backend's detect and install held to plain argv, with no
// shell, no other user's privileges, and voice's prefix the only place an
// install writes (as far as its argv says); a version read from what detect
// prints by the pattern's first group; every refusal naming its field; and
// the bypass flags refused whatever the backends. Then a host run's argv and
// environment (node/attempt.hl): the container's paths as the run has them,
// its login by name or as a scratch copy in its own home, never its value.
import ".." as node;
import "../../lib/harness" as harness;

fn path(rel: String) -> String {
    return if std::io::fs::file_exists(rel) { rel } else { "../" + rel };
}

fn shipped(id: String) -> String {
    return std::str::trim(std::io::fs::read_file(path("harnesses/" + id + ".json")) or "");
}

/// A recipe of the test's: a container and a host backend, `host` the
/// host backend's JSON.
fn recipe(host: String) -> String {
    return "{\"id\": \"stub\", \"name\": \"Stub\", \"version\": \"1.2.3\", \"backends\": [{\"kind\": \"container\", \"base\": \"docker.io/library/alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc\", \"install\": \"apk add --no-cache git\"}, "
        + host
        + "], \"command\": [\"stub\", \"--out\", \"/voice/out/x.json\", \"--cwd=/work\"], \"instruction\": {\"via\": \"stdin\"}, \"model\": {\"flag\": \"--model\"}, \"login\": {\"kind\": \"env\", \"env\": \"STUB_KEY\"}, \"env\": {\"STUB_DIR\": \"/home/voice/.stub\", \"STUB_JSON\": \"{\\\"a\\\": 1}\"}, \"reader\": \"text\", \"commits\": false, \"preamble\": \"You work in /work, at /work/src too; not /workspace.\", \"egress\": [\"stub.example.com\"]}";
}

const HOST_OK: String = "{\"kind\": \"host\", \"detect\": {\"command\": [\"stub\", \"--version\"], \"version\": \"stub ([0-9][0-9.]*) \\\\(build\\\\)\"}, \"install\": {\"command\": [\"npm\", \"install\", \"--global\", \"--prefix\", \"$VOICE_CLI_PREFIX\", \"stub@1.2.3\"]}}";

/// The field a recipe is refused at, and that it is refused at all.
fn refused_at(json: String, field: String, what: String) {
    let p = harness::recipe_problem(json);
    std::test::assert(len(p.why) > 0, what + ": refused");
    std::test::assert_eq_str(p.field, field, what + ": at its field (" + p.why + ")");
}

fn host_with(install: String) -> String {
    return recipe(
        "{\"kind\": \"host\", \"detect\": {\"command\": [\"stub\", \"--version\"], \"version\": \"([0-9.]+)\"}, \"install\": "
            + install + "}",
    );
}

fn main() {
    // the shipped recipes: a container backend as before, then the host
    let ids = "claude\ncodex\nagy\nvibe\npi\n";
    let mut rest = ids;
    while len(rest) > 0 {
        let nl = std::str::index_of(rest, "\n");
        let id = rest[0..nl];
        rest = rest[(nl + 1)..len(rest)];
        let j = shipped(id);
        std::test::assert_eq_str(harness::harness_problem(j), "", id + " is a recipe voice runs");
        let d = harness::harness_def(j);
        let first = at(d.backends, 0) or harness::HarnessBackend { };
        let second = at(d.backends, 1) or harness::HarnessBackend { };
        std::test::assert(
            count(d.backends) == 2 && first.kind == "container" && second.kind == "host",
            id + ": a container, then the host",
        );
        std::test::assert(
            std::str::contains(first.base, "@sha256:") && len(first.install) > 0,
            id + ": its container as before",
        );
        std::test::assert(len(second.detect) > 0, id + ": its host backend detects the CLI");
        std::test::assert(
            harness::has_backend(j, "host") && harness::has_backend(j, "container"),
            id + ": has either",
        );
    }
    // agy's vendor publishes no pinned version: detect alone
    let agy = harness::harness_def(shipped("agy"));
    std::test::assert_eq_str(
        (at(agy.backends, 1) or harness::HarnessBackend { }).install_argv,
        "",
        "agy's host backend installs nothing",
    );
    // the others install the pin into voice's prefix
    let vibe = at(harness::harness_def(shipped("vibe")).backends, 1) or harness::HarnessBackend { };
    std::test::assert(
        std::str::contains(vibe.install_argv, "mistral-vibe==3.0.1")
            && std::str::contains(vibe.install_env, "UV_TOOL_BIN_DIR=$VOICE_CLI_PREFIX/bin"),
        "vibe's install puts its pin in the prefix: " + vibe.install_env,
    );
    // pi's provider is a file of the recipe, written in /voice for the run
    let pi = harness::harness_def(shipped("pi"));
    std::test::assert(
        std::str::contains(pi.files, "/voice/voice-pi.js")
            && std::str::contains(pi.command, "/voice/voice-pi.js\n"),
        "pi loads its provider from /voice",
    );

    // each CLI's own --version, as it prints it, is read as its pin
    std::test::assert(
        harness::version_detected(
            "([0-9][0-9.]*) \\(Claude Code\\)",
            "2.1.283",
            "2.1.283 (Claude Code)\n",
        ),
        "claude's version",
    );
    std::test::assert(
        harness::version_detected("codex-cli ([0-9][0-9.]*)", "0.166.0", "codex-cli 0.166.0\n"),
        "codex's",
    );
    std::test::assert(harness::version_detected("([0-9][0-9.]*)", "1.5.6", "1.5.6\n"), "agy's");
    std::test::assert(
        harness::version_detected("vibe ([0-9][0-9.]*)", "3.0.1", "vibe 3.0.1\n"),
        "vibe's",
    );
    std::test::assert(
        harness::version_detected("([0-9][0-9.]*)", "1.5.2", "warming up\n1.5.2\r\n"),
        "pi's, on a line of its own",
    );
    // another version is not the pin, nor a version inside a longer one
    std::test::assert(
        !harness::version_detected("codex-cli ([0-9][0-9.]*)", "0.166.0", "codex-cli 0.167.0\n"),
        "a newer version is not the pin",
    );
    std::test::assert(
        !harness::version_detected("([0-9][0-9.]*)", "1.5.6", "11.5.6\n"),
        "a version inside a longer one is not the pin",
    );
    std::test::assert(
        !harness::version_detected("vibe ([0-9][0-9.]*)", "3.0.1", "command not found: vibe\n"),
        "nothing found",
    );
    std::test::assert(
        harness::version_detected("v?([0-9.]+)-\\w+", "2.0.0", "v2.0.0-beta\n"),
        "a class escape reads as its class",
    );

    // the backends shape, and the older image
    std::test::assert_eq_str(harness::harness_problem(recipe(HOST_OK)), "", "a host backend");
    let legacy = std::str::trim(
        std::io::fs::read_file(path("scripts/e2e-harnesses/fake.json")) or "",
    );
    std::test::assert_eq_str(harness::harness_problem(legacy), "", "the older image");
    let ld = harness::harness_def(legacy);
    let lb = at(ld.backends, 0) or harness::HarnessBackend { };
    std::test::assert(
        count(ld.backends) == 1 && lb.kind == "container" && lb.install == "apk add --no-cache git",
        "is one container backend",
    );
    std::test::assert(
        harness::has_backend(legacy, "container") && !harness::has_backend(legacy, "host"),
        "and none on the host",
    );
    refused_at(
        std::str::replace(
            recipe(HOST_OK),
            "\"backends\": [",
            "\"image\": {\"base\": \"x\", \"install\": \"y\"}, \"backends\": [",
        ),
        "image",
        "an image and backends both",
    );
    refused_at(
        std::str::replace(recipe(HOST_OK), "\"kind\": \"host\"", "\"kind\": \"vm\""),
        "backends[1].kind",
        "a kind voice has not",
    );
    refused_at(
        std::str::replace(recipe(HOST_OK), "alpine@sha256:", "alpine:3@sha256:x"),
        "backends[0].base",
        "a container's base by tag",
    );

    // a host backend: plain argv, no shell, never another user's privileges
    refused_at(
        host_with(
            "{\"command\": [\"sudo\", \"npm\", \"install\", \"-g\", \"--prefix\", \"$VOICE_CLI_PREFIX\", \"stub\"]}",
        ),
        "backends[1].install.command",
        "sudo",
    );
    refused_at(
        host_with(
            "{\"command\": [\"su\", \"-c\", \"npm install --prefix $VOICE_CLI_PREFIX stub\"]}",
        ),
        "backends[1].install.command",
        "su",
    );
    refused_at(
        host_with(
            "{\"command\": [\"/usr/bin/env\", \"bash\", \"-c\", \"npm install --prefix $VOICE_CLI_PREFIX stub\"]}",
        ),
        "backends[1].install.command",
        "a shell",
    );
    refused_at(
        std::str::replace(
            recipe(HOST_OK),
            "[\"stub\", \"--version\"]",
            "[\"sh\", \"-c\", \"stub --version\"]",
        ),
        "backends[1].detect.command",
        "a shell to detect",
    );
    // voice's prefix, and nowhere else its argv names
    refused_at(
        host_with("{\"command\": [\"npm\", \"install\", \"--global\", \"stub@1.2.3\"]}"),
        "backends[1].install.command",
        "an install that names no prefix",
    );
    refused_at(
        host_with(
            "{\"command\": [\"npm\", \"install\", \"--prefix\", \"/usr/local\", \"stub\", \"$VOICE_CLI_PREFIX\"]}",
        ),
        "backends[1].install.command",
        "a path outside the prefix",
    );
    refused_at(
        host_with(
            "{\"command\": [\"pip\", \"install\", \"--target=$VOICE_CLI_PREFIX/../x\", \"stub\"]}",
        ),
        "backends[1].install.command",
        "a path out of the prefix",
    );
    refused_at(
        host_with(
            "{\"command\": [\"pip\", \"install\", \"--user\", \"--target\", \"$VOICE_CLI_PREFIX\", \"stub\"]}",
        ),
        "backends[1].install.command",
        "a flag that writes outside it",
    );
    refused_at(
        host_with(
            "{\"command\": [\"uv\", \"tool\", \"install\", \"stub\"], \"env\": {\"UV_TOOL_DIR\": \"/opt/tools\"}}",
        ),
        "backends[1].install.env.UV_TOOL_DIR",
        "a variable naming a path outside it",
    );
    refused_at(
        host_with(
            "{\"command\": [\"uv\", \"tool\", \"install\", \"stub\"], \"env\": {\"PATH\": \"$VOICE_CLI_PREFIX/bin\"}}",
        ),
        "backends[1].install.env.PATH",
        "a variable voice sets",
    );
    std::test::assert_eq_str(
        harness::harness_problem(
            host_with(
                "{\"command\": [\"uv\", \"tool\", \"install\", \"stub\"], \"env\": {\"UV_TOOL_DIR\": \"${VOICE_CLI_PREFIX}/tools\", \"UV_TOOL_BIN_DIR\": \"$VOICE_CLI_PREFIX/bin\"}}",
            ),
        ),
        "",
        "an install whose variables name the prefix",
    );
    std::test::assert_eq_str(
        harness::with_prefix("a\n$VOICE_CLI_PREFIX/bin\n${VOICE_CLI_PREFIX}\n", "/d/clis/x/1"),
        "a\n/d/clis/x/1/bin\n/d/clis/x/1\n",
        "voice puts the prefix where an argv names it",
    );
    // detect's version: a pattern of one group, which reads the pin
    refused_at(
        std::str::replace(recipe(HOST_OK), "\"1.2.3\"", "\"\""),
        "version",
        "a host backend with no pinned version",
    );
    refused_at(
        std::str::replace(recipe(HOST_OK), "stub ([0-9][0-9.]*) \\\\(build\\\\)", "stub [0-9.]+"),
        "backends[1].detect.version",
        "a pattern with no group",
    );
    refused_at(
        std::str::replace(
            recipe(HOST_OK),
            "stub ([0-9][0-9.]*) \\\\(build\\\\)",
            "stub ([0-9.]+)|other",
        ),
        "backends[1].detect.version",
        "a pattern with `|` outside its group",
    );
    refused_at(
        std::str::replace(recipe(HOST_OK), "stub ([0-9][0-9.]*) \\\\(build\\\\)", "stub ([a-z]+)"),
        "backends[1].detect.version",
        "a group that cannot read the pin",
    );
    refused_at(
        std::str::replace(recipe(HOST_OK), "stub ([0-9][0-9.]*) \\\\(build\\\\)", "stub ([0-9.]+"),
        "backends[1].detect.version",
        "a group not closed",
    );
    // the bypass flags, whatever the backends
    refused_at(
        std::str::replace(recipe(HOST_OK), "\"--cwd=/work\"", "\"--cwd=/work\", \"--yolo\""),
        "command",
        "a bypass flag",
    );
    // the recipe's files: in /voice, beside the instruction, not as it
    refused_at(
        std::str::replace(
            recipe(HOST_OK),
            "\"model\":",
            "\"files\": [{\"path\": \"/voice/instruction.md\", \"text\": \"x\"}], \"model\":",
        ),
        "files[0].path",
        "a file over voice's own",
    );
    refused_at(
        std::str::replace(
            recipe(HOST_OK),
            "\"model\":",
            "\"files\": [{\"path\": \"/etc/x\", \"text\": \"x\"}], \"model\":",
        ),
        "files[0].path",
        "a file outside /voice",
    );
    refused_at(
        std::str::replace(
            recipe(HOST_OK),
            "\"login\": {\"kind\": \"env\", \"env\": \"STUB_KEY\"}",
            "\"login\": {\"kind\": \"env\"}",
        ),
        "login.env",
        "a login with no variable",
    );

    // a host run: the container's paths as the run has them
    let dir = "/data/attempts/att_0123456789ab";
    std::test::assert_eq_str(node::host_path(dir, "/work"), dir + "/work", "the workspace");
    std::test::assert_eq_str(
        node::host_path(dir, "/voice/out/export.json"),
        dir + "/out/export.json",
        "what voice reads after the run",
    );
    std::test::assert_eq_str(
        node::host_path(dir, "/voice/instruction.md"),
        dir + "/voice/instruction.md",
        "what voice writes for it",
    );
    std::test::assert_eq_str(
        node::host_path(dir, "/home/voice/.codex"),
        dir + "/run-home/.codex",
        "its home, its own",
    );
    std::test::assert_eq_str(node::host_path(dir, "/workspace"), "/workspace", "no other path");
    std::test::assert_eq_str(
        node::host_text(dir, "You work in /work, at /work/src too; not /workspace."),
        "You work in " + dir + "/work, at " + dir + "/work/src too; not /workspace.",
        "its preamble names its workspace",
    );
    let def = harness::harness_def(recipe(HOST_OK));
    let a = node::AttemptStart {
        id: "att_0123456789ab",
        instruction: "add a test",
        model: "stub-large",
        login: "stub-key--work",
        name: "Test Author",
        email: "author@example.com",
        backend: "host",
    };
    let argv = node::host_run_argv(def, a, dir);
    std::test::assert_eq_str(
        argv,
        "stub\n--out\n" + dir + "/out/x.json\n--cwd=" + dir + "/work\n--model\nstub-large\n",
        "its argv",
    );
    let base = node::host_env(dir, "/data/clis/stub/1.2.3", "/usr/bin:/bin", "USER=op\n");
    std::test::assert(
        std::str::starts_with(
            base,
            "PATH=/data/clis/stub/1.2.3/bin:/usr/bin:/bin\nHOME=" + dir + "/run-home\nTMPDIR=" + dir
                + "/tmp\nVOICE_CLI_PREFIX=/data/clis/stub/1.2.3\n",
        ) && std::str::ends_with(base, "USER=op\n"),
        "voice's prefix first on its PATH, its home its own: " + base,
    );
    let env = node::host_run_env(def, a, dir, base, "");
    std::test::assert(
        std::str::contains(env, "\nSTUB_DIR=" + dir + "/run-home/.stub\n")
            && std::str::contains(env, "\nSTUB_JSON={\"a\": 1}\n")
            && std::str::contains(env, "\nGIT_AUTHOR_NAME=Test Author\n"),
        "its variables, a path as the run has it: " + env,
    );
    // a login from the vault: by name, read from a private file by the
    // run's shell, never in its argv or its environment here
    std::test::assert(!std::str::contains(env, "STUB_KEY"), "the login is not in its environment");
    let wrapped = node::harness_argv(def, argv, dir + "/secret/login");
    std::test::assert(
        std::str::starts_with(wrapped, "sh\n-c\nSTUB_KEY=\"$(cat \"$1\")\"; rm -f \"$1\"")
            && std::str::contains(wrapped, "\nsh\n" + dir + "/secret/login\nstub\n"),
        "the shell reads the login from the file, then runs the CLI",
    );
    // a login directory: its scratch copy in the run's own home, named
    let codex = harness::harness_def(shipped("codex"));
    std::test::assert_eq_str(
        node::host_login_dir(codex, dir),
        dir + "/run-home/.codex",
        "codex's login, in the run's home",
    );
    let cenv = node::host_run_env(codex, a, dir, base, "");
    std::test::assert(
        std::str::contains(cenv, "\nCODEX_HOME=" + dir + "/run-home/.codex\n"),
        "named by its variable",
    );
    let cargv = node::host_run_argv(codex, a, dir);
    std::test::assert(
        std::str::contains(cargv, "\n-C\n" + dir + "/work\n"),
        "codex in the workspace",
    );
    std::test::assert_eq_str(harness::bypass_in(cargv), "", "no bypass flag on the host either");
    // voice's own key: by name; voice's address as the node reaches it, a
    // loopback one included
    let pid = harness::harness_def(shipped("pi"));
    let penv = node::host_run_env(pid, a, dir, base, node::host_base_url("http://127.0.0.1:8080/"));
    std::test::assert(
        std::str::contains(penv, "\nVOICE_BASE_URL=http://127.0.0.1:8080/v1\n")
            && std::str::contains(penv, "\nPI_CODING_AGENT_DIR=" + dir + "/run-home/.pi/agent\n")
            && !std::str::contains(penv, "VOICE_API_KEY"),
        "pi on the host: " + penv,
    );
    std::test::assert(
        std::str::contains(
            node::host_run_argv(pid, a, dir),
            "\n-e\n" + dir + "/voice/voice-pi.js\n",
        ),
        "its provider from the run's /voice",
    );
    std::test::assert_eq_str(
        node::cli_prefix("/data", def),
        "/data/clis/stub/1.2.3",
        "the prefix, per recipe and version",
    );
}
