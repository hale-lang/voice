// A store failure answers without what the store said: Postgres's own
// text can name constraints and the values they refused, so it goes to
// the api's stderr only, and the answer quotes an id the log has.
import ".." as api;
import "../../store" as st;

fn main() {
    // the control plane: a classed failure
    let failed = api::store_down(
        st::StoreError {
            kind: "unavailable",
            message: "query_failed: duplicate key value violates unique constraint \"secret_idx\"",
        },
    );
    let problem = api::ctl_problem(failed);
    std::test::assert(
        api::ctl_status(failed) == 503
            && api::ctl_class(failed) == "unavailable"
            && problem.code == api::ErrorCode::internal_error
            && !std::str::contains(problem.message, "secret_idx"),
        "an admin failure answers without what the store said: " + problem.message,
    );
    std::test::assert(
        std::str::contains(problem.message, "err_")
            && problem.has_incident
            && std::str::starts_with(problem.incident, "err_"),
        "and with an incident the api's log has",
    );
    let full = api::store_down(
        st::StoreError { kind: "full", message: "voice holds at most 64 projects" },
    );
    std::test::assert(
        api::ctl_status(full) == 422
            && api::ctl_class(full) == "invalid"
            && api::ctl_problem(full).message == "voice holds at most 64 projects",
        "a full store is the caller's to fix, and says so",
    );

    // the data plane keeps the OpenAI envelope
    let data = api::store_failed(
        st::StoreError { kind: "unavailable", message: "query_failed: secret_idx" },
    );
    std::test::assert(
        data.status == 500
            && !std::str::contains(data.message, "secret_idx")
            && std::str::starts_with(data.voice.request_id, "err_"),
        "the data plane's failure too: " + data.message,
    );
    let metering = api::metering_failed(
        st::StoreError { kind: "unavailable", message: "query_failed: secret_idx" },
    );
    std::test::assert(
        metering.status == 503 && !std::str::contains(metering.message, "secret_idx"),
        "on the caller plane too",
    );
    let data_full = api::store_failed(
        st::StoreError { kind: "full", message: "voice holds at most 64 projects" },
    );
    std::test::assert(
        data_full.status == 400 && data_full.message == "voice holds at most 64 projects",
        "a full store on the data plane is a 400",
    );
}
