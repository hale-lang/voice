// The change log: every applied admin write, who made it (nobody yet:
// admin authentication is off), when, and the resource before and after.

/// A change as the router answers it: `Change`, its `before` and `after`
/// the text the store holds, written as it is.
type ChangeRead {
    id: String = "";
    at: Time = `1970-01-01T00:00:00Z`;
    // who made it: nobody yet, admin authentication is off
    has_principal: Bool = false;
    principal: String = "";
    action: ChangeAction;
    target: String = "";
    has_before: Bool = false;
    before: String = "";
    has_after: Bool = false;
    after: String = "";
}

/// `Change`, as the surface describes it: `before` and `after` the
/// resource's JSON, free-form, or `null`. `getChange` answers it.
type Change {
    id: String = "";
    at: Time = `1970-01-01T00:00:00Z`;
    has_principal: Bool = false;
    principal: String = "";
    action: ChangeAction;
    target: String = "";
    has_before: Bool = false;
    before: std::json::Value = std::json::Value::null();
    has_after: Bool = false;
    after: std::json::Value = std::json::Value::null();
}

/// `ChangeSummary`: a change as `listChanges` lists it, without the
/// resource it holds (`getChange` has it).
type ChangeSummary {
    id: String = "";
    at: Time = `1970-01-01T00:00:00Z`;
    has_principal: Bool = false;
    principal: String = "";
    action: ChangeAction;
    target: String = "";
}

/// A page of changes, at most `CHANGE_PAGE_MAX`; `next_cursor` is `null` on
/// the last.
type ChangeList {
    data: bounded[ChangeSummary; 100];
    has_next_cursor: Bool = false;
    next_cursor: String = "";
}

/// The most changes a page lists, and the page it lists unasked: a
/// change's summary is under 300 bytes, so a page is under 32 KiB.
const CHANGE_PAGE_MAX: Int = 100;

/// Which change: the `{change}` of the path.
type ChangeRef { change: String; }

/// `listChanges`' query: the times are RFC 3339 text, read when the handler
/// runs so a bad one is refused by name.
type ChangeAsk {
    target: String = "";
    from: String = "";
    to: String = "";
    limit: Int = -1;
    cursor: String = "";
}

locus Changes {
    params {
        store: st::Store;
        // serializes the store's use across requests (store/lock.hl): the admin plane takes turns, a row at a time
        gate: st::Lock = st::Lock { };
    }

    /// `listChanges`: newest first, each without the resource it holds.
    fn list(a: ChangeAsk) -> ChangeList fallible(CtlError) {
        self.gate.enter();
        let gated = self.list_in_gate(a) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `list`, inside the gate.
    fn list_in_gate(a: ChangeAsk) -> ChangeList fallible(CtlError) {
        let mut q = change_query_of(a) or raise;
        q.bodies = false;
        let rows = self.store.changes(q) or fail store_down(err);
        if !rows.cursor_known {
            fail bad("`cursor` names no change; pass a page's `next_cursor`", "cursor");
        }
        let mut out = ChangeList { };
        let mut last = "";
        for c in rows.rows {
            let r = change_read_of(c);
            push(
                out.data,
                ChangeSummary {
                    id: r.id,
                    at: r.at,
                    has_principal: r.has_principal,
                    principal: r.principal,
                    action: r.action,
                    target: r.target,
                },
            ) or discard;
            last = c.id;
        }
        if rows.more {
            out.has_next_cursor = true;
            out.next_cursor = last;
        }
        return out;
    }

    /// `getChange`: the change whole, `before` and `after` as free-form JSON.
    fn get(r: ChangeRef) -> Change fallible(CtlError) {
        self.gate.enter();
        let gated = self.get_in_gate(r) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `get`, inside the gate.
    fn get_in_gate(r: ChangeRef) -> Change fallible(CtlError) {
        let c = self.store.change(r.change) or fail store_down(err);
        if !c.present { fail missing("no change " + r.change); }
        return change_of_read(change_read_of(c)) or raise;
    }
}

/// A row of the log as the event stream's `ChangeRead`, its `before` and
/// `after` as stored.
fn change_read_of(c: st::ChangeRow) -> ChangeRead {
    return ChangeRead {
        id: c.id,
        at: c.at,
        action: action_of(c.action),
        target: c.target,
        has_before: len(c.before) > 0,
        before: c.before,
        has_after: len(c.after) > 0,
        after: c.after,
    };
}

/// A `ChangeRead` as the surface's typed `Change`.
fn change_of_read(c: ChangeRead) -> Change fallible(CtlError) {
    return Change {
        id: c.id,
        at: c.at,
        has_principal: c.has_principal,
        principal: c.principal,
        action: c.action,
        target: c.target,
        has_before: c.has_before,
        before: if c.has_before {
            stored_value(c.before, "change " + c.id + "'s before") or raise
        } else {
            std::json::Value::null()
        },
        has_after: c.has_after,
        after: if c.has_after {
            stored_value(c.after, "change " + c.id + "'s after") or raise
        } else {
            std::json::Value::null()
        },
    };
}

/// A change made now. `before` and `after` are JSON, "" for `null`.
fn change(action: String, target: String, before: String, after: String) -> st::ChangeRow {
    return st::ChangeRow {
        at: now_seconds(),
        action: action,
        target: target,
        before: before,
        after: after,
    };
}

/// A change made now, whose `before` and `after` are checked to read back: the
/// change list reads them as a `std::json::Value` (at most 64 KiB and 64
/// levels), so a resource whose stored form it could not read is refused at
/// the write, whatever member makes it so.
fn checked_change(
    action: String,
    target: String,
    before: String,
    after: String
) -> st::ChangeRow fallible(CtlError) {
    readable(before, "before", target) or raise;
    readable(after, "after", target) or raise;
    return change(action, target, before, after);
}

/// Whether the change log can read `json` back, as `change_of_read` does.
fn readable(json: String, which: String, target: String) -> Bool fallible(CtlError) {
    if len(json) == 0 { return true; }
    std::json::Value::parse(json) or fail bad(
        "the " + which + " of the change for " + target + " would be " + to_string(len(json))
            + " bytes of JSON, which the change log cannot read back (at most 65536 bytes and 64 levels deep): make the resource smaller",
        ""
    );
    return true;
}

// ---- the query ---------------------------------------------------------

/// `GET /admin/v1/changes`'s query as the store takes it.
fn change_query_of(a: ChangeAsk) -> st::ChangeQuery fallible(CtlError) {
    let mut q = st::ChangeQuery { target: a.target, cursor: a.cursor };
    if len(a.from) > 0 {
        q.has_from = true;
        q.from = rfc3339(a.from) or fail bad(
            "`from` is an RFC 3339 time, such as 2026-10-01T00:00:00Z",
            "from"
        );
    }
    if len(a.to) > 0 {
        q.has_to = true;
        q.to = rfc3339(a.to) or fail bad(
            "`to` is an RFC 3339 time, such as 2026-10-01T00:00:00Z",
            "to"
        );
    }
    q.limit = CHANGE_PAGE_MAX;
    if a.limit != -1 {
        if a.limit < 1 || a.limit > CHANGE_PAGE_MAX {
            fail bad("`limit` is 1 to " + to_string(CHANGE_PAGE_MAX), "limit");
        }
        q.limit = a.limit;
    }
    return q;
}

// ---- the event stream's JSON ----------------------------------------------

fn change_json(c: ChangeRead) -> String {
    return "{\"id\": " + jq(c.id) + ", \"at\": " + jtime(c.at) + ", \"principal\": "
        + jstring_or_null(c.has_principal, c.principal) + ", \"action\": "
        + jq(action_name(c.action))
        + ", \"target\": " + jq(c.target) + ", \"before\": " + jraw_if(c.has_before, c.before)
        + ", \"after\": " + jraw_if(c.has_after, c.after) + "}";
}
