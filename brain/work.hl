// The work stream and its queues' consumers (docs/design/queue-routing.md,
// "The stream" and "Consumers"; internal.yaml `WorkStream`, `WorkConsumer`
// and `QueuesReset`), which the working brain keeps, and the plans it
// publishes to nodes (protocol.yaml `ConsumePlan`). The api queues a
// request on it when every seat that could serve the request pulls
// (api/queue.hl), and nodes pull from its queues (node/pull.hl); any other
// request is still offered through the route table.
//
// Each tick the working brain reads the seats configured to serve
// (`WORK_READ`), works out the queues they make (`partitions`) and each
// node's plan (plan.hl), and hands them to the keeper (`WorkKeeper`), a
// pinned locus with a NATS connection of its own, so the tick never waits
// on NATS. A standby hands it nothing, and its keeper never dials. Given
// the queues, the keeper makes sure of the stream and of one consumer per
// queue (`upkeep`), a JetStream request each, every tick: the stream's
// settings brought up to date where NATS changes them in place, the stream
// made again where it cannot, and the new stream's incarnation told on
// `<root>.queues.reset` whenever the keeper created it. Then it publishes
// each node's plan on `<root>.node.<node>.consume` when it changed, with
// the board's version, and every 30 s regardless (`PLAN_REPEAT_MS`), and
// reads each queue's consumer (`read_queues`): its readings go back to the
// brain for its next tick. Last, it deletes the consumers no queue is any
// longer, each once empty past the longest wait (`prune`). Before anything
// that loses tickets (a consumer deleted, the stream deleted to be made
// again) it asks its fence whether its brain still holds the lock
// (`Fence`); creating stays idempotent.
//
// NATS or JetStream not answering is said once, and the keeper tries again
// on the next tick; the route table and the board are written meanwhile,
// and nodes pull on the last plan they were given.

import "../lib/work" as work;

/// JetStream's refusals the keeper acts on (its `err_code`): no such
/// stream; a stream of that name with other settings; settings an update
/// cannot change in place (storage, retention to or from a work queue); no
/// such consumer.
const NO_STREAM: Int = 10059;
const NO_CONSUMER: Int = 10014;
const STREAM_NAME_IN_USE: Int = 10058;
const UPDATE_REFUSED: Int = 10052;

/// The seats configured to serve, whether or not they are up: enabled, on
/// a node not revoked. Per seat, its provider account, the catalog models
/// it serves (a model the catalog no longer holds is left out), its data
/// classes, its engine's kind (the node's declared capabilities, null for
/// a node that never registered) and the part of its config that says
/// whether it carries tools (`work::carries_tools`), and its rank in a
/// pair (null for none).
const WORK_READ: String = "SELECT row_to_json(t) FROM (SELECT s.node, s.id, s.account, coalesce((SELECT jsonb_agg(m->'model') FROM jsonb_array_elements(s.serves) m WHERE EXISTS (SELECT 1 FROM catalog_model c WHERE c.id = m->>'model' AND c.removed_at IS NULL)), '[]'::jsonb) AS models, s.data_classes, (SELECT e->>'kind' FROM jsonb_array_elements(ns.capabilities->'engines') e WHERE e->>'id' = s.engine LIMIT 1) AS kind, jsonb_strip_nulls(jsonb_build_object('runtime', jsonb_build_object('server', s.config->'runtime'->'server'), 'variant', jsonb_build_object('tool_call_parser', s.config->'variant'->'tool_call_parser'), 'tool_call', s.config->'tool_call')) AS tools, (s.config->'cluster'->>'rank')::int AS cluster_rank FROM seat s JOIN node n ON n.id = s.node LEFT JOIN node_state ns ON ns.node = s.node WHERE s.enabled AND n.status <> 'revoked' ORDER BY s.node, s.id) t";

// ---- the stream's and the consumers' settings -----------------------------

/// The work stream under `root`, as lib/work sets it.
fn stream_spec(root: String) -> nats::StreamSpec {
    return nats::StreamSpec {
        name: work::stream_name(root),
        subjects: work::work_subjects(root),
        retention: work::STREAM_RETENTION,
        storage: work::STREAM_STORAGE,
        max_age_ms: work::STREAM_MAX_AGE_MS,
        max_msgs_per_subject: work::STREAM_MAX_MSGS_PER_SUBJECT,
        discard: work::STREAM_DISCARD,
        discard_new_per_subject: work::STREAM_DISCARD_NEW_PER_SUBJECT,
        duplicate_window_ms: work::STREAM_DUPLICATE_WINDOW_MS,
        allow_msg_ttl: work::STREAM_ALLOW_MSG_TTL,
    };
}

/// The durable pull consumer of the queue on `subject`, as lib/work sets
/// it: filtered on that one subject, shared by every seat that consumes
/// it.
fn consumer_spec(subject: String) -> nats::ConsumerSpec {
    return nats::ConsumerSpec {
        durable: work::consumer_name(subject),
        filter: subject,
        deliver: work::CONSUMER_DELIVER_POLICY,
        ack_wait_ms: work::CONSUMER_ACK_WAIT_MS,
        max_ack_pending: work::CONSUMER_MAX_ACK_PENDING,
        max_deliver: work::CONSUMER_MAX_DELIVER,
    };
}

// ---- the queues -----------------------------------------------------------

/// A model's provider accounts among the seats that serve it: the first
/// one, and whether there is another.
type Shape {
    model: String = "";
    account: String = "";
    several: Bool = false;
    present: Bool = false;
}

@form(hashmap)
locus Shapes { capacity { pool rows of Shape indexed_by model; } }

type Taken { subject: String = ""; present: Bool = false; }

@form(hashmap)
locus TakenSubjects { capacity { pool rows of Taken indexed_by subject; } }

/// Whether a row of `WORK_READ` makes queues (lib/work `makes_queues`): a
/// pair's follower (rank other than 0) serves nothing itself, so it makes
/// none.
fn makes_queues(row: String) -> Bool {
    return work::makes_queues(
        if std::json::string_field(row, "cluster_rank").kind == "number" {
            std::json::find_int_field(row, "cluster_rank")
        } else {
                -1
        },
    );
}

/// The models' shapes the seats of `rows` (`WORK_READ`, one a line) give
/// them, into `shapes`: a model's first provider account among the seats
/// that make queues, and whether another serves it too (lib/work
/// `makes_queues`, `several_with`). Read from configuration alone, never
/// from which seats are up, so a model's shape changes only when its seats
/// do.
@bounded_by(rows)
fn fill_shapes(shapes: Shapes, rows: String) {
    let lines = std::str::bytes_view(rows);
    let mut start = 0;
    while start < lines.n {
        let nl = st::line_end(lines, start);
        let row = std::str::trim(std::str::slice(lines, start, nl));
        start = nl + 1;
        if len(row) > 0 && makes_queues(row) {
            let account = st::pg_text(row, "account");
            let mut it = std::json::array_first(std::json::find_field_raw(row, "models"));
            while !it.done {
                let model = json_string(it.element);
                let s = shapes.get(model) or Shape { };
                if !s.present {
                    shapes.set(Shape { model: model, account: account, present: true });
                } else if !s.several && work::several_with(s.account, s.several, account) {
                    shapes.set(
                        Shape { model: model, account: s.account, several: true, present: true },
                    );
                }
                it = std::json::array_next(it);
            }
        }
    }
}

/// The queues each seat of `rows` (`WORK_READ`, one a line) consumes under
/// `root`, the models in the shapes `shapes` holds (`fill_shapes`), one a
/// line: `<node>/<seat>`, the queue's subject, its shape (`m`, `p`, or `s`
/// for the seat's own), its model, provider account (in the `p` shape),
/// data class and need, tab-separated ("" for what the queue has not). A
/// seat's own queue first, then, for each model it serves, each data class
/// it carries: `any`, and `tools` too when the seat carries tools; in the
/// order configuration gives them, the order a seat consumes them in with
/// no pressure. A pair's follower consumes none. By lib/work's rule
/// (`makes_queues`, `partition`), which the api publishes by.
@bounded_by(rows)
fn seat_queues(root: String, rows: String, shapes: Shapes) -> String {
    let out = std::bytes::BytesBuilder { initial_cap: 4096 };
    let lines = std::str::bytes_view(rows);
    let mut start = 0;
    while start < lines.n {
        let nl = st::line_end(lines, start);
        let row = std::str::trim(std::str::slice(lines, start, nl));
        start = nl + 1;
        if len(row) > 0 && makes_queues(row) {
            let node = st::pg_text(row, "node");
            let ref = node + "/" + st::pg_text(row, "id");
            let account = st::pg_text(row, "account");
            let tools = work::carries_tools(
                st::pg_text(row, "kind"),
                std::json::find_field_raw(row, "tools"),
            );
            out.append_str(
                ref + "\t" + work::seat_subject(root, node, st::pg_text(row, "id"))
                    + "\ts\t\t\t\t\n",
            );
            let classes = std::json::find_field_raw(row, "data_classes");
            let mut m = std::json::array_first(std::json::find_field_raw(row, "models"));
            while !m.done {
                let model = json_string(m.element);
                let s = shapes.get(model) or Shape { };
                let shape = if s.several { "p" } else { "m" };
                let under = if s.several { account } else { "" };
                let mut c = std::json::array_first(classes);
                while !c.done {
                    let class = json_string(c.element);
                    let head = ref + "\t";
                    let tail = "\t" + shape + "\t" + model + "\t" + under + "\t" + class + "\t";
                    out.append_str(
                        head + work::partition(root, model, s.several, account, class, "any") + tail
                            + "any\n",
                    );
                    if tools {
                        out.append_str(
                            head + work::partition(root, model, s.several, account, class, "tools")
                                + tail
                                + "tools\n",
                        );
                    }
                    c = std::json::array_next(c);
                }
                m = std::json::array_next(m);
            }
        }
    }
    let b = out.finish() or b"";
    return std::str::from_bytes(b);
}

/// The `k`th tab-separated field of `line` (from 0), "" past its end.
fn tab_field(line: String, k: Int) -> String {
    let v = std::str::bytes_view(line);
    let mut at = 0;
    let mut i = 0;
    while i < k {
        let tab = std::str::index_of(std::str::slice(v, at, v.n), "\t");
        if tab < 0 { return ""; }
        at = at + tab + 1;
        i = i + 1;
    }
    let rest = std::str::slice(v, at, v.n);
    let tab = std::str::index_of(rest, "\t");
    return if tab < 0 { rest } else { std::str::slice(v, at, at + tab) };
}

/// The queues the seats of `rows` (`WORK_READ`, one a line) make under
/// `root`, each once, one a line, in the order `seat_queues` first names
/// them: the consumers the keeper keeps.
@bounded_by(rows)
fn partitions(root: String, rows: String) -> String {
    let shapes = Shapes { };
    fill_shapes(shapes, rows);
    let queues = seat_queues(root, rows, shapes);
    let taken = TakenSubjects { };
    let out = std::bytes::BytesBuilder { initial_cap: 4096 };
    let lines = std::str::bytes_view(queues);
    let mut start = 0;
    while start < lines.n {
        let nl = st::line_end(lines, start);
        let line = std::str::slice(lines, start, nl);
        start = nl + 1;
        if len(line) > 0 { out.append_str(taken_once(taken, tab_field(line, 1))); }
    }
    let b = out.finish() or b"";
    return std::str::from_bytes(b);
}

/// `subject` and a line break the first time, "" after. `taken` holds a
/// subject once, and lives for one `partitions`.
@bounded_by(taken)
fn taken_once(taken: TakenSubjects, subject: String) -> String {
    let t = taken.get(subject) or Taken { };
    if t.present { return ""; }
    taken.set(Taken { subject: subject, present: true });
    return subject + "\n";
}

/// A JSON string's text, "" for anything else.
fn json_string(raw: String) -> String {
    let e = std::str::trim(raw);
    if len(e) < 2 || !std::str::starts_with(e, "\"") || !std::str::ends_with(e, "\"") {
        return "";
    }
    return std::json::unescape_string(e[1..(len(e) - 1)]);
}

// ---- keeping them ---------------------------------------------------------

/// What the working brain hands its keeper each tick: the queues to keep,
/// one a line; each node's plan (plan.hl `Planned.plans`, "" when the
/// board was not written this tick) and the board's version they are part
/// of; and the brain's term, which grows each time it takes the lock, so a
/// keeper starts its plans afresh under a new one.
type Wanted {
    subjects: String = "";
    plans: String = "";
    version: Int = 0;
    term: Int = 0;
    // the brain's session that holds the lock (main.hl `LEADER_READ`),
    // which the keeper's fence checks before anything that loses tickets
    leader_pid: Int = 0;
    leader_start: Int = 0;
}

/// From the brain's tick to its keeper, in the process only.
topic WorkWanted { payload: Wanted; subject: "voice.brain.work_wanted"; }

/// The queues' readings, from the keeper to the brain's next tick (plan.hl
/// `fill_readings`), from its pass over the board at `version` under the
/// brain's `term`: `<subject>\t<depth>\t<ack pending>\t<standing
/// pulls>\t<oldest ticket's age in ms, -1 for none>` a line.
type Read { lines: String = ""; version: Int = 0; term: Int = 0; }

/// From the keeper to the brain, in the process only.
topic QueuesRead { payload: Read; subject: "voice.brain.queues_read"; }

/// How one pass of `upkeep` went.
type Upkeep {
    // the stream was missing and is created, or had settings an update
    // cannot change and is made again (`replaced`); or brought up to date
    created: Bool = false;
    replaced: Bool = false;
    updated: Bool = false;
    // the stream's creation time, in ms (0 when the pass did not read it)
    incarnation: Int = 0;
    // a new incarnation still to be told on `<root>.queues.reset`
    owed: Bool = false;
    // the stream must be made again and this pass was not let to delete it
    // (`may_replace` false): nothing was changed
    unreplaced: Bool = false;
    // told on this pass
    told: Bool = false;
    // consumers in place, and refused
    consumers: Int = 0;
    refused: Int = 0;
    // what failed, "" when nothing did: the step, and what NATS said, by
    // that call's own result (never the client's `last_error`, which keeps
    // a failure after later calls succeed)
    step: String = "";
    kind: String = "";
    code: Int = 0;
    detail: String = "";
}

/// `u`, failed at `step` with `e`.
fn failed_at(u: Upkeep, step: String, e: nats::NatsError) -> Upkeep {
    let mut out = u;
    out.step = step;
    out.kind = e.kind;
    out.code = e.code;
    out.detail = e.detail;
    return out;
}

/// Whether `e` is JetStream's refusal `code`.
fn refused_with(e: nats::NatsError, code: Int) -> Bool {
    return e.kind == "jetstream" && e.code == code;
}

/// One pass over the connection `c`: the work stream under `root` made
/// sure of, then a consumer for each queue of `subjects` (one a line), then
/// the stream's new incarnation told on `<root>.queues.reset` while one is
/// `owed` (a pass that created the stream owes one; a pass that fails
/// before telling it keeps owing it). A consumer JetStream refuses is
/// counted and the rest are made; any other failure ends the pass. A
/// stream whose settings cannot change in place is deleted and made again
/// only when `may_replace`, which loses the tickets it holds: else the
/// pass ends there, `unreplaced`, having changed nothing (`keep_stream`
/// asks the fence first).
@bounded_by(subjects)
fn upkeep(
    c: nats::NatsClient,
    root: String,
    subjects: String,
    owed: Bool,
    may_replace: Bool
) -> Upkeep {
    let spec = stream_spec(root);
    let mut out = Upkeep { owed: owed };
    let none = nats::NatsError { };
    let mut e = none;
    let info = nats::js_stream_info(c, spec.name) or {
        e = err;
        nats::StreamInfo { }
    };
    let mut missing = false;
    if len(e.kind) > 0 {
        if !refused_with(e, NO_STREAM) { return failed_at(out, "reading the work stream", e); }
        e = none;
        missing = true;
    } else {
        out.incarnation = info.created_ns / 1000000;
        // the same settings: nothing to do; others: brought up to date, or,
        // where NATS cannot change them in place, the stream made again
        nats::js_stream_create_with(c, spec) or { e = err; };
        if len(e.kind) > 0 {
            if !refused_with(e, STREAM_NAME_IN_USE) {
                return failed_at(out, "making sure of the work stream", e);
            }
            e = none;
            nats::js_stream_update(c, spec) or { e = err; };
            if len(e.kind) == 0 {
                out.updated = true;
            } else if refused_with(e, UPDATE_REFUSED) {
                if !may_replace {
                    out.unreplaced = true;
                    return out;
                }
                e = none;
                nats::js_stream_delete(c, spec.name) or { e = err; };
                if len(e.kind) > 0 {
                    return failed_at(out, "deleting the work stream to make it again", e);
                }
                out.replaced = true;
                missing = true;
            } else {
                return failed_at(out, "updating the work stream", e);
            }
        }
    }
    if missing {
        nats::js_stream_create_with(c, spec) or { e = err; };
        if len(e.kind) > 0 { return failed_at(out, "creating the work stream", e); }
        out.created = true;
        out.owed = true;
        let made = nats::js_stream_info(c, spec.name) or {
            e = err;
            nats::StreamInfo { }
        };
        if len(e.kind) > 0 { return failed_at(out, "reading the new work stream", e); }
        out.incarnation = made.created_ns / 1000000;
    }
    let mut refusal = none;
    let lines = std::str::bytes_view(subjects);
    let mut start = 0;
    while start < lines.n {
        let nl = st::line_end(lines, start);
        let subject = std::str::trim(std::str::slice(lines, start, nl));
        start = nl + 1;
        if len(subject) > 0 {
            nats::js_consumer_create(c, spec.name, consumer_spec(subject)) or { e = err; };
            if len(e.kind) == 0 {
                out.consumers = out.consumers + 1;
            } else if e.kind == "jetstream" {
                out.refused = out.refused + 1;
                if len(refusal.kind) == 0 { refusal = e; }
                e = none;
            } else {
                return failed_at(out, "making a queue's consumer", e);
            }
        }
    }
    if out.owed && out.incarnation > 0 {
        let reset = std::bytes::from_string(work::reset_json(out.incarnation));
        c.pub_msg(work::reset_subject(root), "", reset) or { e = err; };
        if len(e.kind) == 0 { c.flush() or { e = err; }; }
        if len(e.kind) > 0 { return failed_at(out, "telling the work stream's incarnation", e); }
        out.owed = false;
        out.told = true;
    }
    if len(refusal.kind) > 0 { return failed_at(out, "making a queue's consumer", refusal); }
    return out;
}

// ---- the fence ------------------------------------------------------------

/// Whether the brain session `$1` (its pid), started at `$2` (microseconds
/// since the Unix epoch), holds the brain's lock now (main.hl `BRAIN_LOCK`:
/// one bigint key, its low 32 bits in `objid`).
const FENCE_READ: String = "SELECT EXISTS (SELECT 1 FROM pg_locks l JOIN pg_stat_activity a ON a.pid = l.pid WHERE l.locktype = 'advisory' AND l.granted AND l.objsubid = 1 AND l.objid::bigint = (hashtext('voice.brain')::bigint & 4294967295) AND l.pid = $1::int AND (extract(epoch FROM a.backend_start) * 1000000)::bigint = $2::bigint)";

/// The keeper's fence: before it deletes the work stream to make it again,
/// or deletes a consumer, it asks Postgres whether the brain that handed it
/// the work still holds the lock (`FENCE_READ`, on a connection of its
/// own, opened the first time it asks). A brain that lost the lock (its
/// session ended while it was stopped, and a standby works) may still have
/// a pass in hand; the fence keeps it from deleting what the working
/// brain keeps, and the tickets in it. Creating stays idempotent and needs
/// no fence. Anything but a yes is a no.
locus Fence {
    params {
        database: String = "";
        conn: pq::PgConn = pq::PgConn { sslmode: "prefer" };
        opened: Bool = false;
        // the lock's holder as the brain said it
        pid: Int = 0;
        start: Int = 0;
    }

    fn holds() -> Bool {
        if self.pid <= 0 || len(self.database) == 0 { return false; }
        if !self.opened {
            let d = st::parse_dsn(self.database);
            self.conn.host = d.host;
            self.conn.port = d.port;
            self.conn.user = d.user;
            self.conn.password = d.password;
            self.conn.vault = d.vault;
            self.conn.database = d.database;
            self.conn.sslmode = d.sslmode;
            let opened = self.conn.open();
            if !opened.ok { return false; }
            self.opened = true;
        }
        let a = db::Args { };
        a.add(to_string(self.pid));
        a.add(to_string(self.start));
        let r = self.conn.query_params(FENCE_READ, a);
        if !r.ok {
            self.conn.close();
            self.opened = false;
            return false;
        }
        return std::str::trim(r.csv) == "t";
    }

    dissolve() {
        if self.opened { self.conn.close(); }
    }
}

/// `upkeep`, the stream made again only once `fence` says this brain still
/// holds the lock: a pass first changes nothing it cannot undo, and is
/// made again, let to replace the stream, only after the fence answers yes.
/// A fence that answers no leaves the stream as it is (`unreplaced`, with
/// `step` saying so).
@bounded_by(subjects)
fn keep_stream(
    c: nats::NatsClient,
    root: String,
    subjects: String,
    owed: Bool,
    fence: Fence
) -> Upkeep {
    let u = upkeep(c, root, subjects, owed, false);
    if !u.unreplaced { return u; }
    if !fence.holds() {
        let mut out = u;
        out.step = "making the work stream again";
        out.kind = "fenced";
        out.detail = "this brain no longer holds the lock: the stream is the working brain's";
        return out;
    }
    return upkeep(c, root, subjects, owed, true);
}

// ---- letting a queue go -----------------------------------------------------

/// A consumer of the work stream no seat consumes any longer, and since
/// when the keeper has seen it so (Unix ms), as of its pass `pass`.
type Unwanted { name: String = ""; since_ms: Int = 0; pass: Int = 0; present: Bool = false; }

@form(hashmap)
locus Unwanteds { capacity { pool rows of Unwanted indexed_by name; } }

/// How a prune went: consumers deleted, those left for being not yet
/// empty, whether the fence refused, and what failed.
type Pruned {
    deleted: Int = 0;
    waiting: Int = 0;
    fenced: Bool = false;
    gone: String = "";
    step: String = "";
    kind: String = "";
    detail: String = "";
}

/// The consumers of the work stream under `root` that no queue of
/// `subjects` (one a line) is, deleted once each is empty (nothing
/// waiting, nothing pulled and not acked) and has been no queue's for
/// `drain_ms` (the longest a ticket waits) by `now_ms`, each only after
/// `fence` says this brain holds the lock; `seen` keeps since when each
/// has been no queue's, across passes (`pass` this one's number). Only
/// voice's own consumers (`w_`) are looked at, a page of JetStream's list
/// at a time. A refused fence ends the prune; deleting none, it is tried
/// again next pass.
@unbounded
fn prune(
    c: nats::NatsClient,
    root: String,
    subjects: String,
    seen: Unwanteds,
    pass: Int,
    now_ms: Int,
    drain_ms: Int,
    fence: Fence
) -> Pruned {
    let stream = work::stream_name(root);
    let wanted = "\n" + subjects;
    let mut out = Pruned { };
    let mut offset = 0;
    let mut more = true;
    while more {
        let mut e = nats::NatsError { };
        let page = nats::js_call(
            c,
            "$JS.API.CONSUMER.LIST." + stream,
            "{\"offset\": " + to_string(offset) + "}",
        ) or {
            e = err;
            ""
        };
        if len(e.kind) > 0 {
            out.step = "listing the queues' consumers";
            out.kind = e.kind;
            out.detail = e.detail;
            return out;
        }
        let total = std::json::find_int_field(page, "total");
        let mut n = 0;
        let mut it = std::json::array_first(std::json::find_field_raw(page, "consumers"));
        while !it.done {
            n = n + 1;
            let info = std::str::trim(it.element);
            let name = st::pg_text(info, "name");
            let subject = st::pg_text(std::json::find_field_raw(info, "config"), "filter_subject");
            if std::str::starts_with(name, work::CONSUMER_PREFIX) {
                if std::str::contains(wanted, "\n" + subject + "\n") {
                    seen.remove(name) or discard;
                } else {
                    let was = seen.get(name) or Unwanted { };
                    let since = if was.present { was.since_ms } else { now_ms };
                    seen.set(Unwanted { name: name, since_ms: since, pass: pass, present: true });
                    let empty = std::json::find_int_field(info, "num_pending") == 0
                        && std::json::find_int_field(info, "num_ack_pending") == 0;
                    if now_ms - since >= drain_ms {
                        if !empty {
                            out.waiting = out.waiting + 1;
                        } else if !out.fenced {
                            if !fence.holds() {
                                out.fenced = true;
                            } else {
                                nats::js_consumer_delete(c, stream, name) or { e = err; };
                                if len(e.kind) > 0
                                    && !(e.kind == "jetstream" && e.code == NO_CONSUMER)
                                {
                                    out.step = "deleting a queue's consumer";
                                    out.kind = e.kind;
                                    out.detail = e.detail;
                                    return out;
                                }
                                e = nats::NatsError { };
                                seen.remove(name) or discard;
                                out.deleted = out.deleted + 1;
                                out.gone = out.gone + subject + "\n";
                            }
                        }
                    }
                }
            }
            it = std::json::array_next(it);
        }
        offset = offset + n;
        more = n > 0 && offset < total;
    }
    // forget the consumers no longer listed
    let mut stale = "";
    for u in seen.entries {
        if u.pass != pass { stale = stale + u.name + "\n"; }
    }
    let v = std::str::bytes_view(stale);
    let mut at_line = 0;
    while at_line < v.n {
        let nl = st::line_end(v, at_line);
        seen.remove(std::str::slice(v, at_line, nl)) or discard;
        at_line = nl + 1;
    }
    return out;
}

/// How reading the queues went (`read_queues`): the readings, or what
/// failed.
type QueuesState {
    lines: String = "";
    step: String = "";
    kind: String = "";
    code: Int = 0;
    detail: String = "";
}

/// Each queue of `subjects` (one a line) under `root`, as its consumer and
/// the stream say now (`Read`): its tickets waiting (`num_pending`, the
/// backlog), pulled and not acked, and the pulls standing on it, from
/// `CONSUMER.INFO`; and, when tickets wait, its oldest's age at `now_ms`
/// (Unix ms), from the stream's first message on its subject. A queue with
/// no consumer yet is left out; any failure other than a JetStream refusal
/// ends the pass. Each call judged by its own result.
@bounded_by(subjects)
fn read_queues(c: nats::NatsClient, root: String, subjects: String, now_ms: Int) -> QueuesState {
    let stream = work::stream_name(root);
    let out = std::bytes::BytesBuilder { initial_cap: 4096 };
    let none = nats::NatsError { };
    let lines = std::str::bytes_view(subjects);
    let mut start = 0;
    while start < lines.n {
        let nl = st::line_end(lines, start);
        let subject = std::str::trim(std::str::slice(lines, start, nl));
        start = nl + 1;
        if len(subject) > 0 {
            let mut e = none;
            let info = nats::js_consumer_info(c, stream, work::consumer_name(subject)) or {
                e = err;
                nats::ConsumerInfo { }
            };
            if len(e.kind) > 0 && e.kind != "jetstream" {
                return QueuesState {
                    step: "reading a queue's consumer",
                    kind: e.kind,
                    code: e.code,
                    detail: e.detail,
                };
            }
            if len(e.kind) == 0 {
                let mut oldest = -1;
                if info.num_pending > 0 {
                    let m = nats::js_stream_msg_next(c, stream, subject, 0) or {
                        e = err;
                        nats::StoredMsg { }
                    };
                    if len(e.kind) > 0 && e.kind != "jetstream" && e.kind != "no_messages" {
                        return QueuesState {
                            step: "reading a queue's oldest ticket",
                            kind: e.kind,
                            code: e.code,
                            detail: e.detail,
                        };
                    }
                    if len(e.kind) == 0 && m.time_ns > 0 {
                        let age = now_ms - m.time_ns / 1000000;
                        oldest = if age > 0 { age } else { 0 };
                    }
                }
                out.append_str(
                    subject + "\t" + to_string(info.num_pending) + "\t"
                        + to_string(info.num_ack_pending) + "\t" + to_string(info.num_waiting)
                        + "\t" + to_string(oldest) + "\n",
                );
            }
        }
    }
    let b = out.finish() or b"";
    return QueuesState { lines: std::str::from_bytes(b) };
}

/// A node's plan as its keeper last published it: its seats' part (the
/// JSON list), the board's version it went with, when (monotonic ms), and
/// under which of the brain's terms.
type Sent {
    node: String = "";
    seats: String = "";
    version: Int = 0;
    at_ms: Int = 0;
    term: Int = 0;
    present: Bool = false;
}

@form(hashmap)
locus SentPlans { capacity { pool rows of Sent indexed_by node; } }

/// A node's plan as it goes on `<root>.node.<node>.consume`
/// (protocol.yaml `ConsumePlan`): `seats`, a JSON list of `SeatPlan`s, at
/// `version`.
fn plan_message(version: Int, seats: String) -> String {
    return "{\"version\": " + to_string(version) + ", \"seats\": " + seats + "}";
}

/// A seat plan's hold in `seats` (a JSON list of `SeatPlan`s) for seat
/// `id`: its reason, "" when it consumes, `\n` when `seats` does not name
/// it.
fn hold_in(seats: String, id: String) -> String {
    let mut it = std::json::array_first(seats);
    while !it.done {
        if st::pg_text(it.element, "seat") == id { return st::pg_text(it.element, "hold"); }
        it = std::json::array_next(it);
    }
    return "\n";
}

/// Each node's plan (`plans`, `<node>\t<seats>` a line, plan.hl), published
/// over `c` on `<root>.node.<node>.consume` when it is not the one last
/// published under the brain's `term` (`sent`), with the board's `version`
/// it came with; and again, as it was, every `PLAN_REPEAT_MS` (`now_ms`
/// monotonic), since core NATS delivers at most once and a node ignores a
/// plan no newer than its own. A seat held or let go is said once. What
/// NATS refused, `kind` "" for nothing.
@unbounded
fn publish_plans(
    c: nats::NatsClient,
    root: String,
    plans: String,
    version: Int,
    term: Int,
    sent: SentPlans,
    now_ms: Int
) -> nats::NatsError {
    let mut e = nats::NatsError { };
    if len(plans) == 0 { return e; }
    let mut sent_any = false;
    let v = std::str::bytes_view(plans);
    let mut start = 0;
    while start < v.n && len(e.kind) == 0 {
        let nl = st::line_end(v, start);
        let line = std::str::slice(v, start, nl);
        start = nl + 1;
        let node = tab_field(line, 0);
        let seats = tab_field(line, 1);
        if len(node) > 0 {
            let had = sent.get(node) or Sent { };
            let fresh = !had.present || had.term != term;
            let mut at_version = had.version;
            let mut due = false;
            if fresh || had.seats != seats {
                at_version = version;
                due = true;
                if !fresh { say_holds(node, had.seats, seats); }
            } else if now_ms - had.at_ms >= work::PLAN_REPEAT_MS {
                due = true;
            }
            if due {
                c.pub_msg(
                    work::consume_subject(root, node),
                    "",
                    std::bytes::from_string(plan_message(at_version, seats)),
                ) or { e = err; };
                if len(e.kind) == 0 {
                    sent_any = true;
                    sent.set(
                        Sent {
                            node: node,
                            seats: seats,
                            version: at_version,
                            at_ms: now_ms,
                            term: term,
                            present: true,
                        },
                    );
                }
            }
        }
    }
    if sent_any && len(e.kind) == 0 { c.flush() or { e = err; }; }
    return e;
}

/// Say each seat of `node` that its new plan (`now`) holds or lets go,
/// against the one published before (`was`).
@unbounded
fn say_holds(node: String, was: String, now: String) {
    let mut it = std::json::array_first(now);
    while !it.done {
        let id = st::pg_text(it.element, "seat");
        let hold = st::pg_text(it.element, "hold");
        let before = hold_in(was, id);
        if hold != before {
            let seat = std::log::kv("seat", node + "/" + id);
            if len(hold) > 0 {
                log_info(
                    "a seat is held: it pulls nothing",
                    fields2(seat, std::log::kv("why", hold)),
                );
            } else if before != "\n" {
                log_info("a seat is let go: it pulls again", seat);
            }
        }
        it = std::json::array_next(it);
    }
}

/// Keeps the work stream and its consumers, on a thread of its own: each
/// `WorkWanted` from the working brain's tick is one pass (`upkeep`, the
/// plans, `read_queues`), the newest replacing one not begun yet. It dials
/// only once it is handed work, and drops its connection after any failure
/// other than a JetStream refusal, dialling again on the next pass. Trouble
/// is said once while it lasts, and its end once.
locus WorkKeeper {
    params {
        // voice's own NATS (grafted, the habitat's broker: its account, the
        // vault entry of its password, its subjects' root and its inbox);
        // with none (`url` ""), nothing is kept
        url: String = "";
        user: String = "";
        vault: String = "";
        root: String = "voice";
        inbox: String = "_INBOX";
        timeout: Duration = 2s;
        client: nats::NatsClient = nats::NatsClient { };
        credential: std::secret::Credential = std::secret::Credential { };
        connected: Bool = false;
        // the newest queues and plans handed over, and whether a pass is
        // due for them
        wanted: String = "";
        plans: String = "";
        version: Int = 0;
        term: Int = 0;
        due: Bool = false;
        // each node's plan as last published
        sent: SentPlans = SentPlans { };
        // voice's Postgres, for the fence, and the brain's session that
        // holds the lock, as the last work handed over said
        database: String = "";
        fence: Fence = Fence { };
        leader_pid: Int = 0;
        leader_start: Int = 0;
        // the consumers no queue is, since when; the passes so far; and the
        // longest a ticket waits, after which an empty one is deleted
        unwanted: Unwanteds = Unwanteds { };
        passes: Int = 0;
        fence_said: Bool = false;
        drain_ms: Int = work::STREAM_MAX_AGE_MS;
        // a new incarnation not told yet
        owed: Bool = false;
        // the trouble last said ("" none), and the consumers last said
        trouble: String = "";
        consumers: Int = -1;
    }
    bus {
        subscribe WorkWanted as on_wanted;
        publish QueuesRead;
    }

    birth() {
        self.client.url = self.url;
        self.client.user = self.user;
        self.client.name = "voice-brain-work";
        self.client.timeout = self.timeout;
        self.client.inbox_prefix = self.inbox;
        self.credential = std::secret::Credential { vault: self.vault };
    }

    @bounded_by(w)
    fn on_wanted(w: Wanted) {
        self.wanted = w.subjects;
        self.plans = w.plans;
        self.version = w.version;
        self.term = w.term;
        self.leader_pid = w.leader_pid;
        self.leader_start = w.leader_start;
        self.due = true;
    }

    // @unbounded: the keeper's loop, for the process's life; between
    // passes it sleeps, and the bus hands a new `WorkWanted` over there.
    @unbounded
    run() {
        while !self.draining {
            if self.due && len(self.url) > 0 {
                self.due = false;
                self.pass();
            } else {
                std::time::sleep(20ms);
            }
        }
    }

    fn pass() {
        if !self.connected {
            if !self.client.open_as(self.credential) {
                self.trouble_is("dial", "NATS does not answer: " + self.client.last_error);
                return;
            }
            self.connected = true;
        }
        self.fence.database = self.database;
        self.fence.pid = self.leader_pid;
        self.fence.start = self.leader_start;
        self.passes = self.passes + 1;
        let u = keep_stream(self.client, self.root, self.wanted, self.owed, self.fence);
        self.owed = u.owed;
        let stream = std::log::kv("stream", work::stream_name(self.root));
        if u.created {
            log_info(
                if u.replaced {
                    "the work stream made again: its settings could not change in place"
                } else {
                    "the work stream created"
                },
                fields2(stream, std::log::kv("incarnation", to_string(u.incarnation))),
            );
        }
        if u.updated { log_info("the work stream's settings brought up to date", stream); }
        if u.told {
            log_info(
                "the work stream's new incarnation told",
                fields2(
                    std::log::kv("subject", work::reset_subject(self.root)),
                    std::log::kv("incarnation", to_string(u.incarnation)),
                ),
            );
        }
        if len(u.step) > 0 {
            if u.kind != "jetstream" && u.kind != "fenced" {
                self.client.close();
                self.connected = false;
            }
            self.trouble_is(
                u.step + " " + u.kind + " " + to_string(u.code),
                u.step + ": " + u.kind + ": " + u.detail,
            );
            return;
        }
        if u.consumers != self.consumers {
            log_info(
                "the work queues' consumers are in place",
                fields2(stream, std::log::kv("queues", to_string(u.consumers))),
            );
            self.consumers = u.consumers;
        }
        let e = publish_plans(
            self.client,
            self.root,
            self.plans,
            self.version,
            self.term,
            self.sent,
            std::time::monotonic_ns() / 1000000,
        );
        if len(e.kind) > 0 {
            self.client.close();
            self.connected = false;
            self.trouble_is(
                "plans " + e.kind,
                "publishing a node's plan: " + e.kind + ": " + e.detail,
            );
            return;
        }
        let r = read_queues(
            self.client,
            self.root,
            self.wanted,
            std::time::nanos(std::time::current()) / 1000000,
        );
        if len(r.step) > 0 {
            self.client.close();
            self.connected = false;
            self.trouble_is(
                r.step + " " + r.kind + " " + to_string(r.code),
                r.step + ": " + r.kind + ": " + r.detail,
            );
            return;
        }
        QueuesRead <- Read { lines: r.lines, version: self.version, term: self.term };
        // with a board written this tick, the queues no seat consumes, once
        // empty and past the longest wait
        if self.version > 0 {
            let pr = prune(
                self.client,
                self.root,
                self.wanted,
                self.unwanted,
                self.passes,
                std::time::nanos(std::time::current()) / 1000000,
                self.drain_ms,
                self.fence,
            );
            if len(pr.step) > 0 {
                self.client.close();
                self.connected = false;
                self.trouble_is(
                    pr.step + " " + pr.kind,
                    pr.step + ": " + pr.kind + ": " + pr.detail,
                );
                return;
            }
            self.said_pruned(pr);
        }
        self.trouble_is("", "");
    }

    /// Say each consumer deleted, and a fence that refused, once while it
    /// does.
    @unbounded
    fn said_pruned(pr: Pruned) {
        let v = std::str::bytes_view(pr.gone);
        let mut at_line = 0;
        while at_line < v.n {
            let nl = st::line_end(v, at_line);
            let subject = std::str::slice(v, at_line, nl);
            at_line = nl + 1;
            if len(subject) > 0 {
                log_info(
                    "a queue no seat consumes is let go: empty past the longest wait",
                    std::log::kv("subject", subject),
                );
            }
        }
        if pr.fenced && !self.fence_said {
            log_warn(
                "a queue's consumer is kept: this brain no longer holds the lock",
                std::log::kv("pid", to_string(self.leader_pid)),
            );
        }
        self.fence_said = pr.fenced;
    }

    /// Say trouble once while it is the same (`key`), and its end once.
    fn trouble_is(key: String, what: String) {
        if key == self.trouble { return; }
        if len(key) > 0 {
            log_warn(
                "the work stream is not kept: " + what + "; trying again each tick",
                std::log::kv("nats", self.url),
            );
        } else {
            log_info("the work stream is kept again", std::log::kv("nats", self.url));
        }
        self.trouble = key;
    }
}
