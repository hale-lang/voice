        self.step(
            "UPDATE node SET name = $2, token_digest = decode($3, 'hex'), max_in_flight = $4::int, status = CASE WHEN $5 = 'revoked' OR status = 'revoked' THEN 'revoked' ELSE status END, assignment_version = assignment_version + 1, created_at = $6::timestamptz, revoked_at = $7::timestamptz WHERE id = $1",
            node_update_args(row),
        ) or raise;
        self.commit_with(change) or raise;
    }

