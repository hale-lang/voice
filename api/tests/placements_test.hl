// Placements on the admin plane: a local model put on a node, the variant
// chosen by what the node declared it has, and refused when none fits.
import ".." as api;
import "../../store" as st;

fn fixtures(sub: String) -> String {
    let here = "spec/validate/recipes/" + sub;
    return if std::io::fs::file_exists(here) { here } else { "../" + here };
}

fn blank() -> api::Placement { return api::Placement { id: "refused" }; }

/// A node that registered, declaring `hardware`.
fn node(store: st::Store, id: String, hardware: String) {
    store.insert_node(
        st::NodeRow { id: id, name: id, max_in_flight: 4, created_at: api::now_seconds() },
        api::change("create", "nodes/" + id, "", "{}"),
    ) or discard;
    store.put_fleet(
        st::FleetRow {
            node: id,
            capabilities: "{\"max_in_flight\": 4, \"engines\": [], \"hardware\": " + hardware + "}",
            present: true,
        },
    ) or discard;
}

fn hardware(accel: String, model_memory: Int, disk: Int) -> String {
    return "{\"os\": \"linux\", \"arch\": \"arm64\", \"memory_bytes\": 137438953472, \"model_memory_bytes\": "
        + to_string(model_memory) + ", \"accelerators\": " + accel + ", \"disk_free_bytes\": "
        + to_string(disk) + "}";
}

fn main() {
    let store = st::MemoryStore { };
    let recipes = api::Recipes { store: store, shipped: api::shipped_recipes(fixtures("ok")) };
    let catalog = api::Catalog { store: store, recipes: recipes };
    let placements = api::Placements { store: store, recipes: recipes };
    let gb10 = "[{\"kind\": \"cuda\", \"name\": \"NVIDIA GB10\", \"memory_bytes\": 128000000000, \"unified\": true}]";

    catalog.create(
        api::CatalogModelCreate { id: "fixture", has_recipe: true, recipe: "fixture-1" },
    ) or discard;
    catalog.create(api::CatalogModelCreate { id: "bare" }) or discard;
    node(store, "spark", hardware(gb10, 128000000000, 3500000000000));
    node(store, "small", hardware("[]", 4000000000, 3500000000000));
    node(store, "full", hardware(gb10, 128000000000, 1000000000));
    store.insert_node(
        st::NodeRow {
            id: "unmeasured",
            name: "unmeasured",
            max_in_flight: 4,
            created_at: api::now_seconds(),
        },
        api::change("create", "nodes/unmeasured", "", "{}"),
    ) or discard;

    let mut one = api::PlacementCreate { id: "on-spark", model: "fixture" };
    push(one.nodes, "spark") or discard;
    let p = placements.create(one) or blank();
    std::test::assert_eq_str(p.id, "on-spark", "a model is placed");
    std::test::assert_eq_str(p.variant, "gguf-q4_k_m", "on the variant that fits");
    std::test::assert(
        p.chosen_by == api::PlacementChooser::coordinator,
        "chosen by the coordinator",
    );
    std::test::assert_eq_str(p.leader, "spark", "led by its node");
    let fit = at(p.fit, 0) or api::VariantFit { };
    std::test::assert(
        fit.fits && std::str::contains(fit.reason, "gguf runs on cuda"),
        "and says why: " + fit.reason,
    );
    let read = placements.get(api::PlacementRef { placement: "on-spark" }) or blank();
    std::test::assert(read.variant == p.variant && count(read.fit) == 1, "it reads back");

    let mut failed = "";
    let mut again = api::PlacementCreate { id: "twice", model: "fixture" };
    push(again.nodes, "spark") or discard;
    placements.create(again) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "a model is placed once on a node");

    let mut small = api::PlacementCreate { id: "on-small", model: "fixture" };
    push(small.nodes, "small") or discard;
    let mut why = "";
    placements.create(small) or {
        why = api::ctl_message(err);
    };
    std::test::assert(
        std::str::contains(why, "needs 5.6 GB of 4.0 GB for models"),
        "too little memory: " + why,
    );
    let mut full = api::PlacementCreate { id: "on-full", model: "fixture" };
    push(full.nodes, "full") or discard;
    why = "";
    placements.create(full) or {
        why = api::ctl_message(err);
    };
    std::test::assert(
        std::str::contains(why, "needs 4.9 GB of 1.0 GB free"),
        "too little disk: " + why,
    );

    let mut named = api::PlacementCreate {
        id: "named",
        model: "fixture",
        has_variant: true,
        variant: "nope",
    };
    push(named.nodes, "full") or discard;
    failed = "";
    placements.create(named) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a variant the recipe has not");
    let mut unmeasured = api::PlacementCreate { id: "blind", model: "fixture" };
    push(unmeasured.nodes, "unmeasured") or discard;
    failed = "";
    placements.create(unmeasured) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a node that declared no hardware");
    let mut bare = api::PlacementCreate { id: "bare", model: "bare" };
    push(bare.nodes, "spark") or discard;
    failed = "";
    placements.create(bare) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "invalid", "a model with no recipe has no weights to place");

    failed = "";
    catalog.remove(api::ModelRef { model: "fixture" }) or {
        failed = api::ctl_class(err);
    };
    std::test::assert_eq_str(failed, "conflict", "a placed model stays in the catalog");
    let gone = placements.remove(api::PlacementRef { placement: "on-spark" }) or blank();
    std::test::assert_eq_str(gone.id, "on-spark", "a placement is withdrawn");
    let listed = placements.list() or api::PlacementList { };
    std::test::assert_eq_int(count(listed.data), 0, "and no longer listed");
    let removed = catalog.remove(api::ModelRef { model: "fixture" }) or api::CatalogModel {
        kind: api::ModelKind::local,
    };
    std::test::assert_eq_str(removed.id, "fixture", "then the model can go");
}
