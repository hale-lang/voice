// A PATCH field is three-way (hale's presence triple): left out keeps what
// is held, `null` clears it, a value sets it, on the codec's wire
// (what the REST transport decodes a PATCH body with).
import ".." as api;

fn main() {
    let kept = api::NodeUpdate::api_decode(
        "{\"node\": \"n\", \"name\": \"x\"}",
    ) or api::NodeUpdate { node: "refused" };
    std::test::assert(
        kept.node == "n" && !kept.has_max_in_flight && !kept.clear_max_in_flight,
        "left out: kept",
    );
    let cleared = api::NodeUpdate::api_decode(
        "{\"node\": \"n\", \"max_in_flight\": null}",
    ) or api::NodeUpdate { node: "refused" };
    std::test::assert(cleared.clear_max_in_flight && !cleared.has_max_in_flight, "null: cleared");
    let set = api::NodeUpdate::api_decode(
        "{\"node\": \"n\", \"max_in_flight\": 3}",
    ) or api::NodeUpdate { node: "refused" };
    std::test::assert(
        set.has_max_in_flight && !set.clear_max_in_flight && set.max_in_flight == 3,
        "a value: set",
    );
    std::test::assert(
        std::str::contains(api::NodeUpdate::api_encode(cleared), "\"max_in_flight\":null")
            || std::str::contains(api::NodeUpdate::api_encode(cleared), "\"max_in_flight\": null"),
        "and written back as null: " + api::NodeUpdate::api_encode(cleared),
    );
    std::test::assert(
        !std::str::contains(api::NodeUpdate::api_encode(kept), "max_in_flight"),
        "a field left out is written out of the object",
    );

    let key = api::KeyUpdate::api_decode(
        "{\"project\": \"p\", \"key\": \"k\", \"models\": null, \"accounts\": [\"a\"], \"expires_at\": null}",
    ) or api::KeyUpdate { project: "refused", key: "" };
    std::test::assert(
        key.clear_models
            && !key.has_models
            && key.has_accounts
            && count(key.accounts) == 1
            && key.clear_expires_at
            && !key.has_expires_at,
        "a list cleared, a list set, an expiry cleared",
    );

    let kept_key = api::KeyUpdate::api_decode(
        "{\"project\": \"p\", \"key\": \"k\", \"name\": \"n\"}",
    ) or api::KeyUpdate { project: "refused", key: "" };
    std::test::assert(
        kept_key.project == "p"
            && !kept_key.has_models
            && !kept_key.clear_models
            && !kept_key.has_expires_at
            && !kept_key.clear_expires_at,
        "a key's fields left out: kept",
    );
    let price = api::CatalogModelUpdate::api_decode(
        "{\"model\": \"m\", \"price\": null}",
    ) or api::CatalogModelUpdate { model: "refused" };
    std::test::assert(price.clear_price && !price.has_price, "a price cleared");
    let provider = api::AccountUpdate::api_decode(
        "{\"account\": \"a\", \"provider\": null}",
    ) or api::AccountUpdate { account: "refused" };
    std::test::assert(provider.clear_provider && !provider.has_provider, "a provider cleared");
    let project = api::ProjectUpdate::api_decode(
        "{\"project\": \"p\", \"models\": null, \"accounts\": [\"a\"]}",
    ) or api::ProjectUpdate { project: "refused" };
    std::test::assert(
        project.clear_models
            && !project.has_models
            && project.has_accounts
            && !project.clear_accounts,
        "a project's restriction cleared, another set",
    );
}
