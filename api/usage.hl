// The usage ledger: one row per inference request, written where the
// request ends (inference.hl: `settled` and `unfinished`), read back by
// the admin plane (`GET /admin/v1/usage`, `/usage/{request_id}`,
// `/usage/summary`) and followed by the event stream (admin_events.hl).
// A row is the `UsageRecord` of ../spec/openapi.yaml, kept whole in the
// store (`UsageRow.record`) beside the columns a read filters and sums by.

/// The row for a request of `r` that ended as `status`: `by` is what
/// served it, `t` the tokens its seat reported. A
/// request the caller named `metadata` on keeps it, untouched, and one
/// that named a `prompt_cache_key` keeps it as its `conversation`.
fn usage_row(
    r: InferenceRequest,
    request_id: String,
    project: String,
    key: String,
    by: ServedBy,
    status: String,
    t: Tokens,
    price_micros: Int,
    currency: String,
    timing: String,
    attempts: bounded[Attempt; 8]
) -> st::UsageRow {
    let at = now_seconds();
    let meta = std::str::trim(std::json::find_field_raw(r.body, "metadata"));
    let metadata = if std::json::valid_object(meta) { meta } else { "{}" };
    let served = served_by_json(by);
    let conversation = conversation_of(r);
    let record = "{\"id\": " + jq(request_id) + ", \"created_at\": " + jtime(at)
        + ", \"project\": " + jq(project) + ", \"key\": " + jq(key)
        + ", \"requested_model\": " + jq(asked_for(r)) + ", \"resolved_model\": " + jq(r.model)
        + ", \"requested_account\": "
        + jstring_or_null(len(r.account) > 0, r.account) + ", \"endpoint\": "
        + jq(endpoint_name(r)) + ", \"status\": " + jq(status) + ", \"served\": " + served
        + ", \"data_class\": " + jq(r.data_class) + ", \"input_tokens\": " + to_string(t.input)
        + ", \"cached_input_tokens\": " + to_string(t.cached)
        + ", \"cache_write_input_tokens\": 0, \"output_tokens\": " + to_string(t.output)
        + ", \"reasoning_tokens\": " + to_string(t.reasoning) + ", \"price_micros\": "
        + to_string(price_micros) + ", \"currency\": " + jq(currency)
        + ", \"timing\": " + timing + ", \"attempts\": " + attempts_json(attempts)
        + ", \"conversation\": " + jstring_or_null(len(conversation) > 0, conversation)
        + ", \"instance\": " + jstring_or_null(len(r.instance) > 0, r.instance)
        + ", \"internal\": " + jbool(key == st::system_key(project))
        + ", \"metadata\": " + metadata + ", \"input_tokens_estimated\": " + jbool(t.estimated)
        + "}";
    return st::UsageRow {
        id: request_id,
        created_at: at,
        project: project,
        key: key,
        account: by.account,
        requested_model: asked_for(r),
        served_model: by.model,
        node: by.node,
        seat: by.seat,
        status: status,
        // the ledger's sums count what engines reported, never an estimate
        input_tokens: if t.estimated { 0 } else { t.input },
        cached_input_tokens: t.cached,
        output_tokens: t.output,
        reasoning_tokens: t.reasoning,
        price_micros: price_micros,
        currency: currency,
        served: served,
        record: record
    };
}

/// The conversation a request is a turn of: the `prompt_cache_key` it
/// named, "" for none. Only a string names one: `null` (which Responses
/// allows) names none. Its usage record and its row in flight both keep it.
fn conversation_of(r: InferenceRequest) -> String {
    return r.conversation;
}

/// A request body's conversation: its `prompt_cache_key` when that is a
/// string, "" when none.
fn conversation_in(body: String) -> String {
    let cache_key = std::json::string_field(body, "prompt_cache_key");
    return if cache_key.kind == "string" { cache_key.text } else { "" };
}

/// The key a request's turns keep their seat by, so the seat's prompt cache
/// holds what the conversation said: the `prompt_cache_key` it names, else
/// the one derived from its turn (`derived_conversation`), which is never
/// its `conversation` nor recorded as one.
fn affinity_of(r: InferenceRequest) -> String {
    return if len(r.conversation) > 0 { r.conversation } else { derived_conversation(r.body) };
}

/// The most of each end of one opening text a derived key reads
/// (`sampled`): a body may be 12 MiB, and the key is not worth a copy of it.
const DERIVED_SAMPLE: Int = 4096;

/// The conversation a standard request body that names none is a turn of,
/// as voice derives it to keep its turns on one seat: `derived:` and 32 hex
/// digits of the sha256 of its `instructions` and its opening, every
/// message of the system, developer or user before the first item of the
/// model's (its words, thinking or calls) or a call's output, each by its
/// role and its content as written (`sampled`). An agent resends the whole
/// conversation each turn, its opening the same, so each turn derives the
/// same key; another conversation opens with another task and derives
/// another. "" when the body has neither.
@unbounded
fn derived_conversation(body: String) -> String {
    let v = std::str::bytes_view(body);
    let mut told = "";
    let mut input_at = -1;
    let mut input_end = -1;
    let mut it = std::json::object_first(body);
    while !it.done {
        if std::json::obj_key_eq(it, body, "instructions")
            && std::str::byte_at(v, it.val_start) == 34
        {
            told = "instructions\n" + sampled(v, it.val_start, it.val_end) + "\n";
        } else if std::json::obj_key_eq(it, body, "input") {
            input_at = it.val_start;
            input_end = it.val_end;
        }
        it = std::json::object_next(it, body);
    }
    let mut text = told;
    let opener = if input_at >= 0 { std::str::byte_at(v, input_at) } else { -1 };
    if opener == 34 {
        text = text + "user\n" + sampled(v, input_at, input_end) + "\n";
    } else if opener == 91 {
        // the list's items, and each item's members, read where they lie in
        // the body, none copied: an item of any size is told by its type and
        // role
        let mut item = std::json::array_next_span(
            std::json::ArrayIterSpan { pos: input_at + 1, cur_start: -1, cur_end: 0, done: false },
            body,
        );
        let mut opening = true;
        while !item.done && opening && item.cur_end <= input_end {
            let said = opening_message(body, v, item);
            if len(said) == 0 { opening = false; } else { text = text + said; }
            item = std::json::array_next_span(item, body);
        }
    }
    if len(text) == 0 { return ""; }
    let digest = std::hex::encode(std::crypto::sha256(std::bytes::from_string(text)));
    return "derived:" + digest[0..32];
}

/// Input item `item` of `body` as a derived key reads it: a message of the
/// system, developer or user as its role and its content (`sampled`); ""
/// for any other item, which ends the opening. Its members are read where
/// they lie, so an item of any size costs no copy of it.
@unbounded
fn opening_message(body: String, v: std::str::ByteView, item: std::json::ArrayIterSpan) -> String {
    if std::str::byte_at(v, item.cur_start) != 123 { return ""; }
    let mut kind = "";
    let mut role = "";
    let mut content_at = -1;
    let mut content_end = -1;
    let mut it = std::json::object_next(
        std::json::ObjectIterSpan {
            pos: item.cur_start + 1,
            key_start: -1,
            key_end: 0,
            val_start: -1,
            val_end: 0,
            done: false,
        },
        body,
    );
    while !it.done && it.val_end <= item.cur_end {
        if std::json::obj_key_eq(it, body, "type") {
            kind = std::json::obj_value_string(it, body);
        } else if std::json::obj_key_eq(it, body, "role") {
            role = std::json::obj_value_string(it, body);
        } else if std::json::obj_key_eq(it, body, "content") {
            content_at = it.val_start;
            content_end = it.val_end;
        }
        it = std::json::object_next(it, body);
    }
    let message = kind == "message" || len(kind) == 0;
    if !message || !(role == "system" || role == "developer" || role == "user") { return ""; }
    return role + "\n" + (if content_at >= 0 { sampled(v, content_at, content_end) } else { "" })
        + "\n";
}

/// The text of `v` in [from, to) as a derived key reads it: whole up to
/// twice `DERIVED_SAMPLE`, else its length and its first and last
/// `DERIVED_SAMPLE` bytes, so no long text is copied whole. Two texts that
/// differ only between those ends read the same: they keep one seat, which
/// costs a cache, never an answer.
fn sampled(v: std::str::ByteView, from: Int, to: Int) -> String {
    if to - from <= 2 * DERIVED_SAMPLE { return std::str::slice(v, from, to); }
    return to_string(to - from) + "\n" + std::str::slice(v, from, from + DERIVED_SAMPLE)
        + std::str::slice(v, to - DERIVED_SAMPLE, to);
}

/// The model a caller asked for: the alias, when it named one (aliases.hl).
fn asked_for(r: InferenceRequest) -> String {
    return if len(r.alias) > 0 { r.alias } else { r.model };
}

/// The tokens a seat reported for a request: its input, of it what the
/// seat's prompt cache held, its output, of it the model's thinking.
/// `estimated` when the seat reported none and `input` is voice's own
/// estimate (`estimated_input_tokens`), not an engine's count.
type Tokens {
    input: Int = 0;
    cached: Int = 0;
    output: Int = 0;
    reasoning: Int = 0;
    estimated: Bool = false;
}

/// Voice's estimate of a request's input tokens, for a request whose seat
/// reported none (it was cancelled or failed first): its instructions,
/// input and tools as the caller wrote them, a token per four characters,
/// rounded up, as a node counts an upstream that reports no usage
/// (node/engine.hl `tokens_of`). It tells a request cut off with a long
/// prompt from one cut off with a short one, never what an engine read.
fn estimated_input_tokens(body: String) -> Int {
    let instructions = std::json::string_field(body, "instructions");
    let chars = (if instructions.kind == "string" { len(instructions.text) } else { 0 })
        + len(std::str::trim(std::json::find_field_raw(body, "input")))
        + len(std::str::trim(std::json::find_field_raw(body, "tools")));
    return (chars + 3) / 4;
}

/// A request a seat served, as its row.
fn served_usage(r: InferenceRequest, s: Served) -> st::UsageRow {
    let v = s.voice;
    return usage_row(
        r,
        s.request_id,
        v.project,
        v.key,
        v.served,
        if s.status == "incomplete" { "incomplete" } else { "served" },
        Tokens {
            input: s.input_tokens,
            cached: s.cached_tokens,
            output: s.output_tokens,
            reasoning: s.reasoning_tokens,
        },
        v.price_micros,
        v.currency,
        timing_json(v.wall_ms, v.queue_ms, v.has_engine_timing, v.first_output_ms, v.engine_ms),
        v.attempts
    );
}

/// A request seat `c` began and did not finish, as its row: nothing is
/// charged, and the seat reported no tokens, so its input is voice's
/// estimate, marked so.
fn unfinished_row(
    r: InferenceRequest,
    request_id: String,
    k: st::KeyRow,
    m: st::ModelRow,
    c: Candidate,
    status: String,
    wall_ms: Int,
    attempts: bounded[Attempt; 8]
) -> st::UsageRow {
    return usage_row(
        r,
        request_id,
        k.project,
        k.id,
        ServedBy {
            model: if len(c.engine_name) > 0 { c.engine_name } else { m.id },
            node: c.seat.node,
            seat: c.seat.ref,
            account: c.seat.account,
            engine: c.seat.engine,
        },
        status,
        Tokens { input: estimated_input_tokens(r.body), estimated: true },
        0,
        if m.priced { m.price.currency } else { "USD" },
        timing_json(wall_ms, 0, false, 0, 0),
        attempts
    );
}

// ---- the ledger, as rows ---------------------------------------------

/// How long a request took, in `UsageRecord.timing`.
type UsageTiming {
    wall_ms: Int = 0;
    queue_ms: Int = 0;
    load_ms: Int = 0;
    // the seat's own, when it produced output (`timing_json`)
    has_first_output_ms: Bool = false;
    first_output_ms: Int = 0;
    has_engine_ms: Bool = false;
    engine_ms: Int = 0;
}

/// `UsageRecord`: one request, as the ledger holds it. A row is read from
/// the record the store keeps whole (`UsageRow.record`), which is this
/// shape as JSON; `metadata` is the caller's own object, untouched.
type UsageRecord {
    id: String = "";
    created_at: Time = `1970-01-01T00:00:00Z`;
    project: String = "";
    key: String = "";
    requested_model: String = "";
    // the catalog model it was routed as: `requested_model`, or the model
    // the project's alias of that name named (aliases.hl); none in a record
    // from before it was kept
    has_resolved_model: Bool = false;
    resolved_model: String = "";
    has_requested_account: Bool = false;
    requested_account: String = "";
    endpoint: String = "responses";
    status: String = "served";
    has_served: Bool = false;
    served: ServedBy = ServedBy { };
    data_class: String = "";
    input_tokens: Int = 0;
    cached_input_tokens: Int = 0;
    cache_write_input_tokens: Int = 0;
    output_tokens: Int = 0;
    reasoning_tokens: Int = 0;
    price_micros: Int = 0;
    currency: String = "USD";
    timing: UsageTiming = UsageTiming { };
    attempts: bounded[Attempt; 8];
    has_conversation: Bool = false;
    conversation: String = "";
    // the api instance that admitted it (main.hl); none from before
    has_instance: Bool = false;
    instance: String = "";
    // a request of its project's system key (st::system_key): voice's own
    // for the project, an annotation or a title, apart from its usage
    internal: Bool = false;
    metadata: std::json::Value = std::json::Value::null();
    // `input_tokens` is voice's estimate, the seat having reported none
    // (`unfinished_row`); false in a record from before it was kept
    input_tokens_estimated: Bool = false;
}

/// `UsageRecordSummary`: a request as `listUsage` lists it, without its
/// attempts or the caller's `metadata` (`getUsage` has them both); an
/// internal request's own `annotates` and `side`, from its metadata.
type UsageRecordSummary {
    id: String = "";
    created_at: Time = `1970-01-01T00:00:00Z`;
    project: String = "";
    key: String = "";
    requested_model: String = "";
    has_resolved_model: Bool = false;
    resolved_model: String = "";
    has_requested_account: Bool = false;
    requested_account: String = "";
    endpoint: String = "responses";
    status: String = "served";
    has_served: Bool = false;
    served: ServedBy = ServedBy { };
    data_class: String = "";
    input_tokens: Int = 0;
    cached_input_tokens: Int = 0;
    cache_write_input_tokens: Int = 0;
    output_tokens: Int = 0;
    reasoning_tokens: Int = 0;
    price_micros: Int = 0;
    currency: String = "USD";
    timing: UsageTiming = UsageTiming { };
    has_conversation: Bool = false;
    conversation: String = "";
    has_instance: Bool = false;
    instance: String = "";
    internal: Bool = false;
    // an internal request's: the request it annotated and its stage (or
    // `title`), as voice wrote them in its metadata
    has_annotates: Bool = false;
    annotates: String = "";
    has_side: Bool = false;
    side: String = "";
    input_tokens_estimated: Bool = false;
}

/// A page of the ledger, newest first, at most `USAGE_PAGE_MAX`;
/// `next_cursor` is `null` on the last.
type UsageList {
    data: bounded[UsageRecordSummary; 40];
    has_next_cursor: Bool = false;
    next_cursor: String = "";
}

/// The most requests a page lists, and the page it lists unasked: a
/// request's summary is about 750 bytes, so a page is about 30 KiB.
const USAGE_PAGE_MAX: Int = 40;

/// Which request: the `{request_id}` of the path.
type UsageRef { request_id: String; }

/// The filters `GET /admin/v1/usage` takes. The times are RFC 3339 text and
/// `metadata` one `name=value` pair or a JSON object of several
/// (`metadata_pairs`), read when the handler runs so a bad one is refused by
/// name.
type UsageAsk {
    project: String = "";
    key: String = "";
    model: String = "";
    account: String = "";
    conversation: String = "";
    metadata: String = "";
    from: String = "";
    to: String = "";
    limit: Int = -1;
    cursor: String = "";
    // voice's own requests for its projects (their system keys'), left out
    // unless asked for
    include_internal: Bool = false;
}

/// `GET /admin/v1/usage/summary`'s: the same filters, and the fields to group by.
type UsageSummaryAsk {
    group_by: String = "";
    project: String = "";
    key: String = "";
    model: String = "";
    account: String = "";
    conversation: String = "";
    metadata: String = "";
    from: String = "";
    to: String = "";
    include_internal: Bool = false;
}

/// One group of a summary: `group` keys the `group_by` fields.
type UsageGroupOut {
    group: std::json::Value = std::json::Value::null();
    requests: Int = 0;
    input_tokens: Int = 0;
    output_tokens: Int = 0;
    price_micros: Int = 0;
    currency: String = "USD";
    first_at: Time = `1970-01-01T00:00:00Z`;
    last_at: Time = `1970-01-01T00:00:00Z`;
    last_request: String = "";
}

type UsageSummary {
    group_by: bounded[String; 32];
    has_from: Bool = false;
    from: Time = `1970-01-01T00:00:00Z`;
    has_to: Bool = false;
    to: Time = `1970-01-01T00:00:00Z`;
    data: bounded[UsageGroupOut; 1000];
}

/// The ledger, read.
locus Usage {
    params {
        store: st::Store;
        // serializes the store's use across requests (store/lock.hl): the admin plane takes turns, a row at a time
        gate: st::Lock = st::Lock { };
    }

    /// `listUsage`: newest first.
    fn list(a: UsageAsk) -> UsageList fallible(CtlError) {
        self.gate.enter();
        let gated = self.list_in_gate(a) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `list`, inside the gate.
    fn list_in_gate(a: UsageAsk) -> UsageList fallible(CtlError) {
        let q = usage_query_of(a, true) or raise;
        let rows = self.store.usage_rows(q) or fail store_down(err);
        let mut out = UsageList { };
        let mut last = 0;
        for r in rows.rows {
            push(out.data, usage_summary_of(record_of(r.record, r.id) or raise)) or discard;
            last = r.seq;
        }
        if rows.more {
            out.has_next_cursor = true;
            out.next_cursor = to_string(last);
        }
        return out;
    }

    /// `getUsage`.
    fn get(r: UsageRef) -> UsageRecord fallible(CtlError) {
        self.gate.enter();
        let gated = self.get_in_gate(r) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `get`, inside the gate.
    fn get_in_gate(r: UsageRef) -> UsageRecord fallible(CtlError) {
        let row = self.store.usage(r.request_id) or fail store_down(err);
        if !row.present { fail missing("no usage record " + r.request_id); }
        return record_of(row.record, r.request_id) or raise;
    }

    /// `summarizeUsage`: totals over the matching rows, one per group.
    fn summary(a: UsageSummaryAsk) -> UsageSummary fallible(CtlError) {
        self.gate.enter();
        let gated = self.summary_in_gate(a) or {
            self.gate.leave();
            fail err;
        };
        self.gate.leave();
        return gated;
    }

    /// `summary`, inside the gate.
    fn summary_in_gate(a: UsageSummaryAsk) -> UsageSummary fallible(CtlError) {
        let by = group_by_of(a.group_by) or raise;
        let q = usage_query_of(
            UsageAsk {
                project: a.project,
                key: a.key,
                model: a.model,
                account: a.account,
                conversation: a.conversation,
                metadata: a.metadata,
                from: a.from,
                to: a.to,
                include_internal: a.include_internal,
            },
            false,
        ) or raise;
        let groups = self.store.usage_summary(
            st::UsageSummaryQuery { by: by, q: q },
        ) or fail store_down(err);
        let mut out = UsageSummary {
            has_from: q.has_from,
            from: q.from,
            has_to: q.has_to,
            to: q.to,
        };
        out.group_by = by.items;
        for g in groups.rows {
            push(
                out.data,
                UsageGroupOut {
                    group: stored_value(g.group, "a usage group") or raise,
                    requests: g.requests,
                    input_tokens: g.input_tokens,
                    output_tokens: g.output_tokens,
                    price_micros: g.price_micros,
                    currency: g.currency,
                    first_at: g.first_at,
                    last_at: g.last_at,
                    last_request: g.last_request,
                },
            ) or discard;
        }
        return out;
    }
}

/// A record as `listUsage` lists it.
fn usage_summary_of(r: UsageRecord) -> UsageRecordSummary {
    let annotates = if r.internal {
        std::json::string_field(r.metadata.text, "annotates")
    } else {
        std::json::string_field("{}", "annotates")
    };
    let side = if r.internal {
        std::json::string_field(r.metadata.text, "side")
    } else {
        std::json::string_field("{}", "side")
    };
    return UsageRecordSummary {
        id: r.id,
        created_at: r.created_at,
        project: r.project,
        key: r.key,
        requested_model: r.requested_model,
        has_resolved_model: r.has_resolved_model,
        resolved_model: r.resolved_model,
        has_requested_account: r.has_requested_account,
        requested_account: r.requested_account,
        endpoint: r.endpoint,
        status: r.status,
        has_served: r.has_served,
        served: r.served,
        data_class: r.data_class,
        input_tokens: r.input_tokens,
        cached_input_tokens: r.cached_input_tokens,
        cache_write_input_tokens: r.cache_write_input_tokens,
        output_tokens: r.output_tokens,
        reasoning_tokens: r.reasoning_tokens,
        price_micros: r.price_micros,
        currency: r.currency,
        timing: r.timing,
        has_conversation: r.has_conversation,
        conversation: r.conversation,
        has_instance: r.has_instance,
        instance: r.instance,
        internal: r.internal,
        has_annotates: annotates.kind == "string",
        annotates: annotates.text,
        has_side: side.kind == "string",
        side: side.text,
        input_tokens_estimated: r.input_tokens_estimated,
    };
}

/// A ledger row's record as the typed `UsageRecord`.
fn record_of(text: String, id: String) -> UsageRecord fallible(CtlError) {
    return UsageRecord::api_decode(text) or fail CtlError::Unavailable(
        Problem {
            code: ErrorCode::internal_error,
            message: "usage record " + id + " is stored JSON that is not a usage record (`"
                + err.field + "` is " + err.kind + ")",
        },
    );
}

// ---- the query ---------------------------------------------------------

/// The metadata pairs a filter asks for, each `name=value`: one written so,
/// or several as a JSON object of them, all of which a request must have.
/// The parameter is given once (a row reads the first of a repeated query
/// key), so several pairs travel as one object.
fn metadata_pairs(m: String) -> st::Names fallible(CtlError) {
    let mut out = st::Names { };
    let t = std::str::trim(m);
    if len(t) == 0 { return out; }
    if !std::str::starts_with(t, "{") {
        if std::str::index_of(t, "=") < 1 {
            fail bad("`metadata` is written name=value, or a JSON object of pairs", "metadata");
        }
        push(out.items, t) or discard;
        return out;
    }
    if !std::json::valid_object(t) {
        fail bad("`metadata` is written name=value, or a JSON object of pairs", "metadata");
    }
    let mut it = std::json::object_first(t);
    while !it.done {
        let name = std::json::obj_key_string(it, t);
        let v = std::json::string_field(t, name);
        it = std::json::object_next(it, t);
        if v.kind != "string" || len(name) == 0 || std::str::contains(name, "=") {
            fail bad(
                "`metadata`'s pairs are each a name (no `=` in it) and a string value",
                "metadata"
            );
        }
        if count(out.items) == 16 { fail bad("`metadata` asks at most 16 pairs", "metadata"); }
        push(out.items, name + "=" + v.text) or discard;
    }
    return out;
}

/// The filters `GET /admin/v1/usage` and `/usage/summary` share.
fn usage_query_of(a: UsageAsk, paged: Bool) -> st::UsageQuery fallible(CtlError) {
    let mut q = st::UsageQuery {
        project: a.project,
        key: a.key,
        model: a.model,
        account: a.account,
        conversation: a.conversation,
        include_internal: a.include_internal,
    };
    if len(a.from) > 0 {
        q.has_from = true;
        q.from = rfc3339(a.from) or fail bad(
            "`from` is an RFC 3339 time, such as 2026-10-01T00:00:00Z",
            "from"
        );
    }
    if len(a.to) > 0 {
        q.has_to = true;
        q.to = rfc3339(a.to) or fail bad(
            "`to` is an RFC 3339 time, such as 2026-10-01T00:00:00Z",
            "to"
        );
    }
    q.metadata = metadata_pairs(a.metadata) or raise;
    if paged {
        q.limit = USAGE_PAGE_MAX;
        if a.limit != -1 {
            if a.limit < 1 || a.limit > USAGE_PAGE_MAX {
                fail bad("`limit` is 1 to " + to_string(USAGE_PAGE_MAX), "limit");
            }
            q.limit = a.limit;
        }
        if len(a.cursor) > 0 {
            let n = std::str::parse_int(a.cursor) or 0;
            if !is_integer(a.cursor) || n < 1 {
                fail bad("`cursor` names no usage record; pass a page's `next_cursor`", "cursor");
            }
            q.cursor = n;
        }
    }
    return q;
}

/// `group_by`: the fields a summary groups by, comma separated.
fn group_by_of(raw: String) -> st::Names fallible(CtlError) {
    if len(raw) == 0 { fail bad("`group_by` is required", "group_by"); }
    let mut out = st::Names { };
    let mut rest = raw;
    while len(rest) > 0 {
        let comma = std::str::index_of(rest, ",");
        let f = if comma < 0 { rest } else { rest[0..comma] };
        rest = if comma < 0 { "" } else { rest[(comma + 1)..len(rest)] };
        if !st::valid_group(f) {
            fail bad(
                "`group_by` is any of project, key, model, account, seat, node, conversation, internal, day, hour",
                "group_by"
            );
        }
        push(out.items, f) or fail bad("`group_by` names at most 32 fields", "group_by");
    }
    return out;
}

/// Every value `name` has in `path`'s query, in order, decoded: a repeated
/// parameter, which a route's parameters do not carry.
fn query_all(path: String, name: String) -> st::Names {
    let mut out = st::Names { };
    let qm = std::str::index_of(path, "?");
    let mut rest = if qm < 0 { "" } else { path[(qm + 1)..len(path)] };
    while len(rest) > 0 {
        let amp = std::str::index_of(rest, "&");
        let part = if amp < 0 { rest } else { rest[0..amp] };
        rest = if amp < 0 { "" } else { rest[(amp + 1)..len(rest)] };
        if std::str::starts_with(part, name + "=") {
            push(out.items, st::pct_decode(part[(len(name) + 1)..len(part)])) or discard;
        }
    }
    return out;
}
