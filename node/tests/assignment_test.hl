// An assignment applied: the node runs the seats within what it offers,
// refuses the rest, and holds the ones its local controls pause.
import ".." as node;

const CAPS: String = "{\"max_in_flight\": 4, \"engines\": [{\"id\": \"static\", \"kind\": \"static\"}, {\"id\": \"other\", \"kind\": \"claude-cli\"}]}";

fn main() {
    let a = "{\"version\": 3, \"max_in_flight\": 2, \"seats\": [{\"id\": \"s1\", \"engine\": \"static\", \"account\": \"a\", \"serves\": [{\"model\": \"m\"}], \"config\": {\"text\": \"hi\"}}, {\"id\": \"s2\", \"engine\": \"cli\", \"account\": \"a\", \"serves\": [{\"model\": \"m\"}], \"config\": {}}, {\"id\": \"s3\", \"engine\": \"static\", \"account\": \"a\", \"serves\": [{\"model\": \"m\"}], \"config\": {}}, {\"id\": \"s4\", \"engine\": \"static\", \"account\": \"a\", \"serves\": [{\"model\": \"m\"}], \"enabled\": false, \"config\": {\"text\": \"hi\"}}, {\"id\": \"s5\", \"engine\": \"other\", \"account\": \"a\", \"serves\": [{\"model\": \"m\"}], \"config\": {}}]}";
    let seats = node::apply_assignment(a, CAPS, node::LOCAL_DEFAULT);
    std::test::assert_eq_int(seats.version, 3, "its version");
    std::test::assert_eq_str(
        node::seat_of(seats, "s1").status,
        "up",
        "a seat within what the node offers",
    );
    std::test::assert_eq_str(
        node::seat_of(seats, "s2").status,
        "refused",
        "an engine the node does not offer",
    );
    std::test::assert(
        std::str::contains(node::seat_of(seats, "s2").reason, "no engine cli"),
        "and why",
    );
    std::test::assert_eq_str(
        node::seat_of(seats, "s3").status,
        "refused",
        "a config its engine rejects",
    );
    std::test::assert_eq_str(node::seat_of(seats, "s4").status, "disabled", "a disabled seat");
    std::test::assert_eq_str(
        node::seat_of(seats, "s5").status,
        "refused",
        "a kind this build does not run",
    );
    std::test::assert_eq_str(node::seat_of(seats, "nope").id, "", "a seat not assigned");
    std::test::assert(
        std::str::contains(
            node::states_json(seats, ""),
            "{\"id\": \"s1\", \"status\": \"up\", \"reason\": null, \"in_flight\": 0}",
        ),
        "states as the node plane takes them",
    );
    std::test::assert(
        std::str::contains(
            node::states_json(seats, "0\ts1\tresp_a\n"),
            "{\"id\": \"s1\", \"status\": \"up\", \"reason\": null, \"in_flight\": 1}",
        ),
        "with the request a seat is serving",
    );
    // several at once: two on s1, one on s3
    let busy = "0\ts1\tresp_a\n2\ts3\tresp_b\n1\ts1\tresp_c\n";
    std::test::assert(
        std::str::contains(
            node::states_json(seats, busy),
            "{\"id\": \"s1\", \"status\": \"up\", \"reason\": null, \"in_flight\": 2}",
        ),
        "a seat serving two at once says so",
    );
    std::test::assert_eq_int(node::busy_count(busy), 3, "three served");
    std::test::assert_eq_int(node::seat_busy(busy, "s3"), 1, "one of them on s3");
    std::test::assert_eq_int(node::free_slot(busy, 8), 3, "the lowest free slot");
    std::test::assert_eq_int(node::free_slot(busy, 3), -1, "none free under the cap");
    std::test::assert_eq_int(node::busy_count(node::busy_without(busy, 2)), 2, "a slot freed");
    std::test::assert_eq_int(
        node::seat_busy(node::busy_without(busy, 2), "s3"),
        0,
        "its seat with it",
    );
    std::test::assert_eq_int(node::free_slot(node::busy_without(busy, 0), 8), 0, "and free again");

    let held = node::apply_assignment(
        a,
        CAPS,
        "{\"paused\": false, \"paused_seats\": [\"s1\"], \"max_in_flight\": null, \"reason\": null}",
    );
    std::test::assert_eq_str(
        node::seat_of(held, "s1").status,
        "paused",
        "a seat a local control holds",
    );
    let all = node::apply_assignment(
        a,
        CAPS,
        "{\"paused\": true, \"paused_seats\": [], \"max_in_flight\": null, \"reason\": null}",
    );
    std::test::assert_eq_str(
        node::seat_of(all, "s1").status,
        "paused",
        "a paused node holds every seat it would run",
    );
    std::test::assert_eq_str(
        node::seat_of(all, "s2").status,
        "refused",
        "and still refuses what it cannot",
    );

    // a placement's seat serves what its runtime is started with, whatever
    // a coordinator from before assigned it (concurrency 1, and a cap it
    // reads past); any other seat serves its assigned concurrency
    let managed = "{\"engines\": [{\"id\": \"managed\", \"kind\": \"managed\"}, {\"id\": \"static\", \"kind\": \"static\"}]}";
    let old = "{\"version\": 4, \"max_in_flight\": 1, \"seats\": ["
        + "{\"id\": \"tf\", \"engine\": \"managed\", \"concurrency\": 1, \"config\": {\"placement\": \"tf\", \"model\": \"m\", \"variant\": {}, \"runtime\": {\"server\": \"tensorfold\"}}}, "
        + "{\"id\": \"llama\", \"engine\": \"managed\", \"concurrency\": 1, \"config\": {\"placement\": \"llama\", \"model\": \"m\", \"context_length\": 131072, \"cache_tokens\": 65536, \"variant\": {}, \"runtime\": {\"server\": \"llama-server\"}}}, "
        + "{\"id\": \"canned\", \"engine\": \"static\", \"concurrency\": 3, \"config\": {\"text\": \"hi\"}}]}";
    let applied = node::apply_assignment(old, managed, node::LOCAL_DEFAULT);
    std::test::assert_eq_int(node::seat_of(applied, "tf").concurrency, 32, "TensorFold's 32");
    std::test::assert_eq_int(
        node::seat_of(applied, "llama").concurrency,
        2,
        "llama-server's two slots",
    );
    std::test::assert_eq_int(
        node::seat_of(applied, "canned").concurrency,
        3,
        "a static seat's own",
    );

    // the node takes a TensorFold seat's 32 at once, beside its other seats,
    // and refuses the 33rd for capacity; no cap of the node's narrows it
    let tf = node::seat_of(applied, "tf");
    let mut busy = "";
    let mut taken = 0;
    while taken < 40 {
        if len(node::at_capacity(busy, tf, node::SLOTS)) > 0 { break; }
        busy = busy + to_string(node::free_slot(busy, node::SLOTS)) + "\ttf\tr" + to_string(taken)
            + "\n";
        taken = taken + 1;
    }
    std::test::assert_eq_int(taken, 32, "32 at once on the TensorFold seat");
    std::test::assert_eq_str(
        node::at_capacity(busy, tf, node::SLOTS),
        "seat tf is serving 32, its most at once",
        "the 33rd is refused for the seat's capacity",
    );
    let canned = node::seat_of(applied, "canned");
    std::test::assert_eq_str(
        node::at_capacity(busy, canned, node::SLOTS),
        "",
        "another seat still takes one",
    );
    let mut full = "";
    let mut i = 0;
    while i < node::SLOTS {
        full = full + to_string(i) + "\tx\tr" + to_string(i) + "\n";
        i = i + 1;
    }
    std::test::assert(
        std::str::starts_with(
            node::at_capacity(full, canned, node::SLOTS),
            "the node is serving 64",
        ),
        "only once every slot serves is the node full",
    );

    let shown = node::status_seats(a, seats, "");
    std::test::assert(
        std::str::contains(shown, "\"account\": \"a\"")
            && std::str::contains(shown, "\"status\": \"refused\""),
        "the admin API shows each seat with its state",
    );
}
