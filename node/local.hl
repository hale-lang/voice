/// The node's local controls (LocalControls in ../spec/protocol.yaml): pause the
/// node or seats. They only restrict. Kept in `<data>/local.json`.
const LOCAL_DEFAULT: String = "{\"paused\": false, \"paused_seats\": [], \"reason\": null}";

/// The local controls as kept: a file a node from before wrote, with a
/// local cap, is read without it, as no cap of the node's stands.
fn read_local(data: String) -> String {
    let stored = std::io::fs::read_file(data + "/local.json") or "";
    if len(stored) == 0 || !std::json::valid_object(stored) { return LOCAL_DEFAULT; }
    return normalized_local(stored);
}

/// Why `body` is not valid local controls, or "" when it is.
fn local_problem(body: String) -> String {
    if !std::json::valid_object(body) { return "the body must be a JSON object"; }
    let paused = top_value(body, "paused");
    if paused != "true" && paused != "false" { return "paused must be true or false"; }
    let seats = top_value(body, "paused_seats");
    if !std::str::starts_with(seats, "[") { return "paused_seats must be a list of seat ids"; }
    let mut it = std::json::array_first_span(seats);
    while !it.done {
        if !std::str::starts_with(std::json::iter_substring(it, seats), "\"") {
            return "paused_seats must be a list of seat ids";
        }
        it = std::json::array_next_span(it, seats);
    }
    // a local cap is gone: the node serves each seat up to the seat's
    // concurrency. A body from before that sends none (null) still works
    let cap = top_value(body, "max_in_flight");
    if len(cap) > 0 && cap != "null" {
        return "max_in_flight was removed: the node serves each seat up to the seat's concurrency; pause the node or a seat instead";
    }
    let reason = top_value(body, "reason");
    if len(reason) > 0 && reason != "null" && !std::str::starts_with(reason, "\"") {
        return "reason must be text or null";
    }
    return "";
}

/// Valid local controls, with only the known fields and nulls filled in.
fn normalized_local(body: String) -> String {
    let paused = top_value(body, "paused");
    let seats = top_value(body, "paused_seats");
    let reason = top_value(body, "reason");
    return "{\"paused\": " + (if paused == "true" { "true" } else { "false" })
        + ", \"paused_seats\": " + (if std::str::starts_with(seats, "[") { seats } else { "[]" })
        + ", \"reason\": " + (if len(reason) > 0 { reason } else { "null" }) + "}";
}
