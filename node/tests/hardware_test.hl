// The machine's hardware as the node reads it, from each command's output
// as each platform writes it, and what the operator holds back.
import ".." as node;

fn main() {
    std::test::assert_eq_str(node::os_of("Darwin\n"), "darwin", "macOS");
    std::test::assert_eq_str(node::os_of("Linux\n"), "linux", "Linux");
    std::test::assert_eq_str(node::arch_of("aarch64\n"), "arm64", "Linux on arm");
    std::test::assert_eq_str(node::arch_of("arm64\n"), "arm64", "Apple silicon");
    std::test::assert_eq_str(node::arch_of("x86_64\n"), "x86_64", "a PC");

    let meminfo = "MemTotal:       131416892 kB\nMemFree:        120000000 kB\n";
    std::test::assert_eq_int(node::meminfo_total(meminfo), 131416892 * 1024, "MemTotal, in bytes");
    std::test::assert_eq_int(node::meminfo_total(""), 0, "no meminfo");

    let df = "Filesystem     1024-blocks      Used Available Capacity Mounted on\n/dev/nvme0n1p2  3843514416 123456789 3524512000       4% /\n";
    std::test::assert_eq_int(node::df_available(df), 3524512000 * 1024, "df's available, in bytes");
    std::test::assert_eq_int(node::df_available(""), 0, "no df");

    let memory = 131416892 * 1024;
    let gb10 = node::nvidia_accelerators("NVIDIA GB10, [N/A]\n", memory);
    std::test::assert(
        std::str::contains(gb10, "\"name\": \"NVIDIA GB10\"")
            && std::str::contains(gb10, "\"memory_bytes\": " + to_string(memory))
            && std::str::contains(gb10, "\"unified\": true"),
        "a GPU with no memory of its own shares the machine's",
    );
    let two = node::nvidia_accelerators(
        "NVIDIA GeForce RTX 4090, 24564\nNVIDIA GeForce RTX 4090, 24564\n",
        memory,
    );
    std::test::assert(
        std::str::contains(two, "\"memory_bytes\": " + to_string(24564 * 1048576))
            && std::str::contains(two, "\"unified\": false")
            && std::str::contains(two, "}, {"),
        "two GPUs, each with its own memory",
    );
    std::test::assert_eq_str(node::nvidia_accelerators("", memory), "[]", "no nvidia-smi, no GPU");
    let mut many = "";
    let mut g = 0;
    while g < 20 {
        many = many + "NVIDIA H100, 81559\n";
        g = g + 1;
    }
    std::test::assert_eq_int(node::gpu_count(many), 20, "twenty GPUs are counted");
    let declared = node::nvidia_accelerators(many, memory);
    let mut n = 0;
    let mut it = std::json::array_first(declared);
    while !it.done {
        n = n + 1;
        it = std::json::array_next(it);
    }
    std::test::assert_eq_int(n, 16, "and the first sixteen declared, as the api takes them");

    let plain = "{\"max_in_flight\": 1, \"engines\": [{\"id\": \"static\", \"kind\": \"static\"}]}";
    std::test::assert_eq_int(node::model_memory(plain, 1000), 1000, "models may use it all");
    let held = "{\"max_in_flight\": 1, \"hardware\": {\"model_memory_bytes\": 600}, \"engines\": [{\"id\": \"static\", \"kind\": \"static\"}]}";
    std::test::assert_eq_int(node::model_memory(held, 1000), 600, "the operator holds some back");
    std::test::assert_eq_int(node::model_memory(held, 500), 500, "and can only lower it");
    std::test::assert_eq_str(node::capabilities_problem(held), "", "a file that holds memory back");
    let bad = "{\"max_in_flight\": 1, \"hardware\": {\"model_memory_bytes\": \"lots\"}, \"engines\": [{\"id\": \"static\", \"kind\": \"static\"}]}";
    std::test::assert(len(node::capabilities_problem(bad)) > 0, "not a number is refused");

    let caps = node::with_hardware(
        "{\"max_in_flight\": 1, \"engines\": []}",
        "{\"os\": \"linux\"}",
    );
    std::test::assert(std::json::valid_object(caps), "the capabilities stay one object");
    std::test::assert_eq_str(
        std::json::find_string_field(std::json::find_field_raw(caps, "hardware"), "os"),
        "linux",
        "with the hardware in them",
    );

    // vLLM's share of the GPU: what the variant needs and its cache, from
    // 5 to 90 hundredths, nothing when the GPU's memory is not known
    std::test::assert_eq_str(
        node::gpu_share(1000000000, 128000000000),
        "0.05",
        "a small model on a large GPU: the floor",
    );
    std::test::assert_eq_str(
        node::gpu_share(3000000000, 24000000000),
        "0.22",
        "its need and its cache, rounded up",
    );
    std::test::assert_eq_str(
        node::gpu_share(80000000000, 80000000000),
        "0.90",
        "never more than nine tenths",
    );
    std::test::assert_eq_str(node::gpu_share(3000000000, 0), "", "no GPU known, no share");
    std::test::assert_eq_int(
        node::gpu_memory_of(
            "{\"accelerators\": [{\"kind\": \"cuda\", \"memory_bytes\": 137000000000, \"unified\": true}]}",
        ),
        137000000000,
        "the first GPU's memory",
    );
    std::test::assert_eq_int(node::gpu_memory_of("{\"accelerators\": []}"), 0, "none");

    // AMD and Intel: the kernel's DRM devices, as lin1 has them (a Radeon RX
    // 9070 XT and the Ryzen's own small Radeon)
    let drm = "0x1002 17095983104 Advanced Micro Devices, Inc. [AMD/ATI] Navi 48 [Radeon RX 9070/9070 XT/9070 GRE] (rev c0)\n0x1002 536870912 Advanced Micro Devices, Inc. [AMD/ATI] Granite Ridge [Radeon Graphics] (rev cb)\n";
    let rocm = node::other_accelerators(drm, true);
    std::test::assert(
        std::str::contains(rocm, "\"kind\": \"rocm\"")
            && std::str::contains(rocm, "\"kind\": \"vulkan\"")
            && std::str::contains(rocm, "\"memory_bytes\": 17095983104"),
        "a discrete AMD card is rocm and vulkan, with its own memory: " + rocm,
    );
    std::test::assert(
        !std::str::contains(rocm, "Granite Ridge"),
        "the integrated one is not placed on",
    );
    let vk = node::other_accelerators(drm, false);
    std::test::assert(
        !std::str::contains(vk, "rocm") && std::str::contains(vk, "\"kind\": \"vulkan\""),
        "without ROCm's compute device, Vulkan only: " + vk,
    );
    let arc = node::other_accelerators(
        "0x8086 17179869184 Intel Corporation DG2 [Arc A770]\n",
        true,
    );
    std::test::assert(
        std::str::contains(arc, "\"kind\": \"vulkan\"") && !std::str::contains(arc, "rocm"),
        "an Intel card is Vulkan: " + arc,
    );
    std::test::assert_eq_str(node::other_accelerators("", true), "[]", "no DRM device, no GPU");

    // the collector itself, on sysfs as each driver lays it out: AMD's
    // memory counter, Intel's (i915) own, and a card with neither
    let root = node::run_out("mktemp\n-d");
    let r = std::str::trim(root);
    node::run_out(
        "sh\n-c\nmkdir -p $0/sys/class/drm/card0/device $0/sys/class/drm/card1/device $0/sys/class/drm/card2/device $0/sys/class/drm/card0-DP-1 && echo 0x1002 > $0/sys/class/drm/card0/device/vendor && echo 17095983104 > $0/sys/class/drm/card0/device/mem_info_vram_total && echo 0x8086 > $0/sys/class/drm/card1/device/vendor && echo 17179869184 > $0/sys/class/drm/card1/lmem_total_bytes && echo 0x8086 > $0/sys/class/drm/card2/device/vendor\n"
            + r,
    );
    let listed = node::run_out("sh\n-c\n" + node::DRM_GPUS + "\nsh\n" + r);
    let found = node::other_accelerators(listed, false);
    std::test::assert(
        std::str::contains(found, "\"memory_bytes\": 17095983104")
            && std::str::contains(found, "\"memory_bytes\": 17179869184"),
        "AMD's and Intel's memory, each through its own driver's counter: " + listed,
    );
    std::test::assert(
        std::str::contains(listed, "0x8086 0 "),
        "a card with neither counter reads 0, and is not placed on: " + listed,
    );
    node::run_out("rm\n-rf\n" + r);
}
