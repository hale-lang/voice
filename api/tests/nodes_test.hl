// Nodes and seats on the admin plane: the Nodes and Seats rows
// (GET/POST /admin/v1/nodes, /admin/v1/nodes/{node}, its token, and
// /admin/v1/nodes/{node}/seats/{seat}), called as the surface calls them.
import ".." as api;
import "../../store" as st;

/// A failed call, as `class param: message`; "" when it succeeded.
fn why(err: api::CtlError) -> String {
    let p = api::ctl_problem(err);
    return api::ctl_class(err) + " " + p.param + ": " + p.message;
}

/// What a failed call falls back to; each assertion on it then fails.
fn no_node() -> api::Node {
    return api::Node { status: api::NodeStatus::revoked, has_max_in_flight: true };
}

fn no_seat() -> api::SeatView {
    return api::SeatView { status: api::SeatStatus::offline, enabled: true, concurrency: 0 };
}

fn model(id: String) -> st::SeatModel {
    return st::SeatModel { model: id };
}

fn static_seat(node: String, id: String, account: String) -> api::SeatCreate {
    let mut c = api::SeatCreate { node: node, id: id, engine: "static", account: account };
    push(c.serves, model("echo-1")) or discard;
    return c;
}

fn version(nodes: api::Nodes, node: String) -> Int {
    let n = nodes.get(api::NodeRef { node: node }) or no_node();
    return n.assignment_version;
}

fn main() {
    let store = st::MemoryStore { };
    let catalog = api::Catalog { store: store };
    let accounts = api::Accounts { store: store };
    let nodes = api::Nodes { store: store, link: api::NatsLink { } };
    let seats = api::Seats { store: store, link: api::NatsLink { } };
    let changes = api::Changes { store: store };
    catalog.create(api::CatalogModelCreate { id: "echo-1" }) or discard;
    accounts.create(api::AccountCreate { id: "static", name: "Static" }) or discard;

    // nodes
    let made = nodes.create(api::NodeCreate { id: "laptop", name: "Laptop" }) or no_node();
    std::test::assert(
        made.has_enrollment_token
            && std::str::starts_with(made.enrollment_token, "vn-")
            && len(made.enrollment_token) == 43,
        "a token, shown once",
    );
    let token = made.enrollment_token;
    std::test::assert(made.status == api::NodeStatus::pending, "pending until it connects");
    std::test::assert(!made.has_capabilities, "it has declared nothing");
    std::test::assert(!made.has_max_in_flight, "no coordinator cap");
    std::test::assert_eq_int(made.assignment_version, 1, "its first assignment");
    let got = nodes.get(api::NodeRef { node: "laptop" }) or no_node();
    std::test::assert_eq_str(got.id, "laptop", "get");
    std::test::assert(
        !got.has_enrollment_token && got.enrollment_token != token,
        "never the token again",
    );
    let listed_nodes = nodes.list() or api::NodeList { };
    let first_node = at(listed_nodes.data, 0) or no_node();
    std::test::assert(
        count(listed_nodes.data) == 1
            && first_node.id == "laptop"
            && !first_node.has_enrollment_token,
        "nor in the list",
    );

    let mut failed = "";
    nodes.create(api::NodeCreate { id: "laptop" }) or { failed = why(err); };
    std::test::assert_eq_str(
        failed,
        "conflict : node laptop exists; a node id is never reused",
        "an id is taken once",
    );
    failed = "";
    nodes.create(api::NodeCreate { id: "Laptop" }) or { failed = why(err); };
    std::test::assert(std::str::starts_with(failed, "invalid id: "), "an id is a slug: " + failed);
    failed = "";
    nodes.create(api::NodeCreate { id: "x", has_max_in_flight: true, max_in_flight: 0 }) or {
        failed = why(err);
    };
    std::test::assert(std::str::starts_with(failed, "invalid "), "a cap is at least 1: " + failed);
    failed = "";
    nodes.get(api::NodeRef { node: "nope" }) or { failed = why(err); };
    std::test::assert_eq_str(failed, "not_found : no node nope", "an unknown node");

    let capped = nodes.update(
        api::NodeUpdate { node: "laptop", has_max_in_flight: true, max_in_flight: 4 },
    ) or no_node();
    std::test::assert(capped.has_max_in_flight && capped.max_in_flight == 4, "set a cap");
    std::test::assert_eq_int(capped.assignment_version, 2, "a new assignment");
    std::test::assert_eq_str(capped.name, "Laptop", "a field not set stays");
    let uncapped = nodes.update(
        api::NodeUpdate { node: "laptop", clear_max_in_flight: true },
    ) or no_node();
    std::test::assert(!uncapped.has_max_in_flight, "the cap lifted");
    failed = "";
    nodes.update(api::NodeUpdate { node: "laptop", has_id: true, id: "other" }) or {
        failed = why(err);
    };
    std::test::assert_eq_str(
        failed,
        "invalid id: a node's `id` cannot change",
        "the id cannot change",
    );

    let rotated = nodes.rotate_token(api::NodeRef { node: "laptop" }) or no_node();
    std::test::assert(
        rotated.has_enrollment_token
            && std::str::starts_with(rotated.enrollment_token, "vn-")
            && rotated.enrollment_token != token,
        "a new token",
    );

    // seats
    let mut create = static_seat("laptop", "static", "static");
    create.serves = api::SeatCreate { node: "", id: "", engine: "", account: "" }.serves;
    push(create.serves, model("echo-1")) or discard;
    push(
        create.serves,
        st::SeatModel { model: "gone-1", has_engine_name: true, engine_name: "g" },
    ) or discard;
    create.concurrency = 4;
    create.config = std::json::Value::parse(
        "{\"text\": \"hello from voice\", \"chunk_chars\": 8}",
    ) or std::json::Value::null();
    let seat = seats.create(create) or no_seat();
    std::test::assert_eq_str(seat.ref, "laptop/static", "its full name");
    std::test::assert(seat.status == api::SeatStatus::offline, "its node has not connected");
    std::test::assert_eq_str(
        at(seat.data_classes, 0) or "",
        "internal",
        "data classes default to internal",
    );
    std::test::assert_eq_int(count(seat.data_classes), 1, "and only that");
    std::test::assert_eq_str(
        std::json::find_string_field(seat.config.text, "text"),
        "hello from voice",
        "its config, as written",
    );
    std::test::assert_eq_int(
        std::json::find_int_field(seat.config.text, "chunk_chars"),
        8,
        "all of it",
    );
    let mut problems = "";
    for p in seat.problems {
        problems = problems + p + "\n";
    }
    std::test::assert(
        std::str::contains(problems, "has not connected"),
        "the node has declared no engines",
    );
    std::test::assert(
        std::str::contains(problems, "model gone-1 is not in the catalog"),
        "a model not in the catalog",
    );
    std::test::assert_eq_int(version(nodes, "laptop"), 5, "a seat is a new assignment");
    let logged = changes.list(
        api::ChangeAsk { target: "nodes/laptop/seats" },
    ) or api::ChangeList { };
    std::test::assert_eq_str(
        (at(logged.data, 0) or api::Change { action: api::ChangeAction::delete }).target,
        "nodes/laptop/seats/static",
        "the change names the seat's path",
    );
    let echo = catalog.get(
        api::ModelRef { model: "echo-1" },
    ) or api::CatalogModel { kind: api::ModelKind::hosted };
    std::test::assert_eq_str(at(echo.seats, 0) or "", "laptop/static", "the model lists the seat");
    let account = accounts.get(api::AccountRef { account: "static" }) or api::Account {
        billing: api::Billing::none,
        status: api::Lifecycle::archived,
    };
    std::test::assert_eq_str(
        at(account.seats, 0) or "",
        "laptop/static",
        "and so does its account",
    );

    failed = "";
    seats.create(static_seat("laptop", "static", "static")) or { failed = why(err); };
    std::test::assert_eq_str(
        failed,
        "conflict : node laptop has a seat static",
        "a seat id is the node's once",
    );
    failed = "";
    seats.create(static_seat("laptop", "x", "nope")) or { failed = why(err); };
    std::test::assert_eq_str(failed, "invalid account: no account nope", "an account that exists");
    failed = "";
    let mut none = static_seat("laptop", "x", "static");
    none.serves = api::SeatCreate { node: "", id: "", engine: "", account: "" }.serves;
    seats.create(none) or { failed = why(err); };
    std::test::assert(
        std::str::starts_with(failed, "invalid serves: "),
        "at least one model: " + failed,
    );
    failed = "";
    seats.create(static_seat("nope", "x", "static")) or { failed = why(err); };
    std::test::assert_eq_str(failed, "not_found : no node nope", "on a node that exists");

    let listed = seats.list(api::NodeRef { node: "laptop" }) or api::SeatList { };
    std::test::assert_eq_str(
        (at(listed.data, 0) or no_seat()).ref,
        "laptop/static",
        "list",
    );
    let shown = nodes.get(api::NodeRef { node: "laptop" }) or no_node();
    std::test::assert_eq_str(
        (at(shown.seats, 0) or no_seat()).ref,
        "laptop/static",
        "the node shows its seats",
    );

    let mut patch = api::SeatUpdate {
        node: "laptop",
        seat: "static",
        has_enabled: true,
        enabled: false,
    };
    patch.has_serves = true;
    push(patch.serves, model("echo-1")) or discard;
    let off = seats.update(patch) or no_seat();
    std::test::assert(!off.enabled, "disabled");
    std::test::assert(
        count(off.serves) == 1 && (at(off.serves, 0) or model("")).model == "echo-1",
        "serves replaced",
    );
    std::test::assert_eq_int(off.concurrency, 4, "a field not set stays");
    failed = "";
    seats.update(api::SeatUpdate { node: "laptop", seat: "static", has_id: true, id: "other" }) or {
        failed = why(err);
    };
    std::test::assert_eq_str(
        failed,
        "invalid id: a seat's `id` cannot change",
        "the id cannot change",
    );
    failed = "";
    seats.get(api::SeatRef { node: "laptop", seat: "nope" }) or { failed = why(err); };
    std::test::assert_eq_str(
        failed,
        "not_found : no seat nope on node laptop",
        "an unknown seat",
    );

    accounts.archive(api::AccountRef { account: "static" }) or discard;
    let broken = seats.get(api::SeatRef { node: "laptop", seat: "static" }) or no_seat();
    let mut why_broken = "";
    for p in broken.problems {
        why_broken = why_broken + p + "\n";
    }
    std::test::assert(
        std::str::contains(why_broken, "account static is archived"),
        "the seat shows the problem",
    );

    let removed = seats.remove(
        api::SeatRef { node: "laptop", seat: "static" },
    ) or no_seat();
    std::test::assert_eq_str(removed.ref, "laptop/static", "the removed seat");
    failed = "";
    seats.get(api::SeatRef { node: "laptop", seat: "static" }) or { failed = why(err); };
    std::test::assert(std::str::starts_with(failed, "not_found"), "gone: " + failed);

    // revoking
    let revoked = nodes.revoke(api::NodeRef { node: "laptop" }) or no_node();
    std::test::assert(revoked.status == api::NodeStatus::revoked, "revoked");
    std::test::assert(revoked.has_revoked_at, "when");
    failed = "";
    nodes.rotate_token(api::NodeRef { node: "laptop" }) or { failed = why(err); };
    std::test::assert(
        std::str::starts_with(failed, "conflict"),
        "a revoked node gets no token: " + failed,
    );
    failed = "";
    seats.create(static_seat("laptop", "y", "static")) or { failed = why(err); };
    std::test::assert(std::str::starts_with(failed, "conflict"), "nor a seat: " + failed);
    failed = "";
    nodes.create(api::NodeCreate { id: "laptop" }) or { failed = why(err); };
    std::test::assert(
        std::str::starts_with(failed, "conflict"),
        "its id is never reused: " + failed,
    );
}
