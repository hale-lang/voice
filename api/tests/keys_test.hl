// Keys on the admin plane: GET/POST /admin/v1/projects/{project}/keys and
// GET/PATCH/DELETE /admin/v1/projects/{project}/keys/{key}, through the
// router.
import ".." as api;

fn call(e: api::Endpoints, method: String, path: String, body: String) -> std::http::Response {
    return e.handle(std::http::Request { method: method, path: path, body: body });
}

fn expect(r: std::http::Response, status: Int, what: String) {
    std::test::assert_eq_int(r.status, status, what + ": " + r.body);
}

fn raw(r: std::http::Response, name: String) -> String {
    return std::str::trim(std::json::find_field_raw(r.body, name));
}

fn main() {
    let e = api::Endpoints { };
    expect(call(e, "POST", "/admin/v1/projects", "{\"id\": \"work\", \"name\": \"Work\", \"accounts\": [\"claude-work\", \"static\"]}"), 201, "a project");
    expect(call(e, "POST", "/admin/v1/projects", "{\"id\": \"home\", \"name\": \"Home\"}"), 201, "another");

    expect(call(e, "POST", "/admin/v1/projects/nope/keys", "{\"name\": \"ci\"}"), 404, "a key needs its project");
    let made = call(e, "POST", "/admin/v1/projects/work/keys", "{\"name\": \"ci\", \"accounts\": [\"claude-work\"]}");
    expect(made, 201, "create");
    let id = std::json::find_string_field(made.body, "id");
    let secret = std::json::find_string_field(made.body, "secret");
    std::test::assert(std::str::starts_with(id, "k_"), "a key id");
    std::test::assert(std::str::starts_with(secret, "vk-") && len(secret) == 43, "a secret, shown once");
    std::test::assert_eq_str(std::json::find_string_field(made.body, "prefix"), secret[0..7], "the prefix is the secret's start");
    std::test::assert_eq_str(std::json::find_string_field(made.body, "project"), "work", "its project");
    std::test::assert_eq_str(std::json::find_string_field(made.body, "status"), "active", "active");
    std::test::assert_eq_str(raw(made, "accounts"), "[\"claude-work\"]", "its accounts");
    std::test::assert_eq_str(raw(made, "models"), "null", "the project's models");
    std::test::assert_eq_str(raw(made, "expires_at"), "null", "no expiry");
    std::test::assert_eq_str(raw(made, "last_used_at"), "null", "never used");

    let second = call(e, "POST", "/admin/v1/projects/work/keys", "{\"name\": \"laptop\"}");
    std::test::assert(std::json::find_string_field(second.body, "secret") != secret, "every key has its own secret");

    expect(call(e, "POST", "/admin/v1/projects/work/keys", "{\"name\": \"x\", \"accounts\": [\"codex\"]}"), 400, "a key's accounts sit within its project's");
    expect(call(e, "POST", "/admin/v1/projects/work/keys", "{}"), 400, "a name is required");
    expect(call(e, "POST", "/admin/v1/projects/work/keys", "{\"name\": \"x\", \"expires_at\": \"2020-01-01T00:00:00Z\"}"), 400, "an expiry in the past");
    expect(call(e, "POST", "/admin/v1/projects/work/keys", "{\"name\": \"x\", \"expires_at\": \"tomorrow\"}"), 400, "an expiry is a time");
    expect(call(e, "POST", "/admin/v1/projects/work/keys", "{\"name\": \"x\", \"limits\": []}"), 400, "key limits are not served yet");
    let dated = call(e, "POST", "/admin/v1/projects/work/keys", "{\"name\": \"temp\", \"expires_at\": \"2099-01-01T00:00:00Z\"}");
    expect(dated, 201, "a key that expires");
    std::test::assert_eq_str(std::json::find_string_field(dated.body, "expires_at"), "2099-01-01T00:00:00Z", "when");

    let listed = call(e, "GET", "/admin/v1/projects/work/keys", "");
    expect(listed, 200, "list");
    std::test::assert(std::str::contains(listed.body, id), "the key is listed");
    std::test::assert(!std::str::contains(listed.body, "secret") && !std::str::contains(listed.body, secret), "never its secret");
    std::test::assert_eq_int(std::json::find_int_field(call(e, "GET", "/admin/v1/projects/work", "").body, "key_count"), 3, "the project counts its keys");
    std::test::assert_eq_str(std::str::trim(call(e, "GET", "/admin/v1/projects/home/keys", "").body), "{\"data\": []}", "keys are per project");

    let got = call(e, "GET", "/admin/v1/projects/work/keys/" + id, "");
    expect(got, 200, "get");
    std::test::assert(!std::str::contains(got.body, "secret"), "no secret after creation");
    expect(call(e, "GET", "/admin/v1/projects/home/keys/" + id, ""), 404, "a key of another project is not found");
    expect(call(e, "GET", "/admin/v1/projects/work/keys/k_nope", ""), 404, "an unknown key");

    let changed = call(e, "PATCH", "/admin/v1/projects/work/keys/" + id, "{\"name\": \"ci-2\", \"models\": [\"echo-1\"], \"expires_at\": \"2099-06-01T00:00:00Z\"}");
    expect(changed, 200, "patch");
    std::test::assert_eq_str(std::json::find_string_field(changed.body, "name"), "ci-2", "renamed");
    std::test::assert_eq_str(raw(changed, "models"), "[\"echo-1\"]", "restricted");
    std::test::assert_eq_str(raw(changed, "accounts"), "[\"claude-work\"]", "a field not set stays");
    let cleared = call(e, "PATCH", "/admin/v1/projects/work/keys/" + id, "{\"expires_at\": null}");
    std::test::assert_eq_str(raw(cleared, "expires_at"), "null", "the expiry removed");
    expect(call(e, "PATCH", "/admin/v1/projects/work/keys/" + id, "{\"accounts\": [\"codex\"]}"), 400, "still within the project's accounts");

    let revoked = call(e, "DELETE", "/admin/v1/projects/work/keys/" + id, "");
    expect(revoked, 200, "revoke");
    std::test::assert_eq_str(std::json::find_string_field(revoked.body, "status"), "revoked", "revoked");
    std::test::assert(std::str::ends_with(std::json::find_string_field(revoked.body, "revoked_at"), "Z"), "when");
    expect(call(e, "DELETE", "/admin/v1/projects/work/keys/" + id, ""), 200, "revoking again changes nothing");
}
