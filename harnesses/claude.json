{
  "id": "claude",
  "name": "Claude Code",
  "version": "2.1.283",
  "image": {
    "base": "docker.io/library/node@sha256:7702d8aa4d5910871692af4480eb3ba86f23047a6417a44d857d06c95d060d3f",
    "install": "npm install --global --no-fund --no-audit @anthropic-ai/claude-code@2.1.283"
  },
  "command": [
    "claude",
    "-p",
    "--output-format",
    "stream-json",
    "--verbose",
    "--no-session-persistence",
    "--permission-mode",
    "acceptEdits",
    "--allowedTools",
    "Bash,Read,Edit,Write,MultiEdit,Glob,Grep,LS,TodoWrite,NotebookEdit",
    "--disallowedTools",
    "Bash(git push:*),WebFetch,WebSearch",
    "--setting-sources",
    "user",
    "--strict-mcp-config",
    "--mcp-config",
    "{\"mcpServers\":{}}"
  ],
  "instruction": {
    "via": "stdin"
  },
  "model": {
    "flag": "--model"
  },
  "login": {
    "kind": "env",
    "entry": "claude-token--{account}",
    "env": "CLAUDE_CODE_OAUTH_TOKEN",
    "setup": "claude setup-token",
    "describe": "A Claude subscription's long-lived token: run `claude setup-token` once per account and keep what it prints in the node's vault under the entry the seat names."
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "reader": "claude-stream-json",
  "commits": true,
  "nested_sandbox": false,
  "preamble": "You are working in a git repository checked out for you at /work, on a branch of its own. Commit your work with git as you go. Do not push, and do not change the repository's remotes or git configuration: voice takes the commits when you finish. End with a short summary of what you changed; its first line is the change's title.",
  "egress": [
    "api.anthropic.com",
    "statsig.anthropic.com"
  ],
  "idle_seconds": 1800,
  "base_url_env": "ANTHROPIC_BASE_URL",
  "protocol": "anthropic-messages",
  "mcp": null
}
