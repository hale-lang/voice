// Links found from cabled ports (cabling.hl): two pairs of DGX
// Sparks as their nodes find their ports (node-a and node-b on IPv4 /30s with
// IPv6 link-local addresses too; node-c and node-d on IPv4 /24s with IPv6
// off), each Spark's two halves sharing one QSFP cable, so each port sees
// both of the other's and its own other half. Paired by what each sees,
// addressed at what they have, the GID that carries it picked; a link an
// operator declares wins; a pair with no address is cabled, not addressed.
import ".." as api;
import "../../store" as st;

fn shipped(dir: String) -> String {
    return if std::io::fs::file_exists(dir) { dir } else { "../" + dir };
}

/// One cabled port: its addresses (with prefixes) and RoCE v2 GIDs
/// (`index=address`) and what it sees, each a comma-separated list.
fn port(
    ifname: String,
    mac: String,
    hca: String,
    addrs: String,
    gids: String,
    sees: String
) -> String {
    return "{\"ifname\": " + api::jq(ifname) + ", \"mac\": " + api::jq(mac)
        + ", \"speed_mbps\": 200000, \"mtu\": 9000, \"hca\": " + api::jq(hca) + ", \"addresses\": ["
        + quoted(addrs) + "], \"gids\": [" + gid_list(gids) + "], \"neighbors\": [" + quoted(sees)
        + "]}";
}

@unbounded
fn quoted(list: String) -> String {
    if len(list) == 0 { return ""; }
    let mut out = "";
    let mut rest = list + ",";
    while len(rest) > 0 {
        let c = std::str::index_of(rest, ",");
        if len(out) > 0 { out = out + ", "; }
        out = out + api::jq(rest[0..c]);
        rest = rest[(c + 1)..len(rest)];
    }
    return out;
}

@unbounded
fn gid_list(list: String) -> String {
    if len(list) == 0 { return ""; }
    let mut out = "";
    let mut rest = list + ",";
    while len(rest) > 0 {
        let c = std::str::index_of(rest, ",");
        let one = rest[0..c];
        let eq = std::str::index_of(one, "=");
        if len(out) > 0 { out = out + ", "; }
        out = out + "{\"index\": " + one[0..eq] + ", \"address\": "
            + api::jq(one[(eq + 1)..len(one)])
            + "}";
        rest = rest[(c + 1)..len(rest)];
    }
    return out;
}

/// A Spark's capabilities with its cabled ports (a JSON list's members)
/// and declared links.
fn gb10_caps(ports: String, links: String) -> String {
    return "{\"engines\": [{\"id\": \"managed\", \"kind\": \"managed\", \"config_schema\": {}}], \"hardware\": {\"os\": \"linux\", \"arch\": \"arm64\", \"memory_bytes\": 129922760704, \"model_memory_bytes\": 121802588160, \"accelerators\": [{\"kind\": \"cuda\", \"name\": \"NVIDIA GB10\", \"memory_bytes\": 129922760704, \"unified\": true}], \"disk_free_bytes\": 3500000000000}"
        + (if len(links) > 0 { ", \"links\": [" + links + "]" } else { "" })
        + (if len(ports) > 0 { ", \"ports\": [" + ports + "]" } else { "" }) + "}";
}

const NODE_A_SEES: String = "02:00:5e:00:01:15,02:00:5e:00:02:6f,02:00:5e:00:02:73";
const NODE_A2_SEES: String = "02:00:5e:00:01:11,02:00:5e:00:02:6f,02:00:5e:00:02:73";
const NODE_B_SEES: String = "02:00:5e:00:01:11,02:00:5e:00:01:15,02:00:5e:00:02:73";
const NODE_B2_SEES: String = "02:00:5e:00:01:11,02:00:5e:00:01:15,02:00:5e:00:02:6f";

/// node-a's two halves: on IPv4 when `v4`, on IPv6 link-local when `v6`.
fn node_a(v4: Bool, v6: Bool) -> String {
    return port(
        "enP2p1s0f0np0",
        "02:00:5e:00:01:15",
        "roceP2p1s0f0",
        both(v4, "203.0.113.1/30", v6, "fe80::5eff:fe00:115/64"),
        "1=fe80::5eff:fe00:115" + (if v4 { ",3=203.0.113.1" } else { "" }),
        NODE_A2_SEES,
    ) + ", "
        + port(
            "enp1s0f0np0",
            "02:00:5e:00:01:11",
            "rocep1s0f0",
            both(v4, "198.51.100.1/30", v6, "fe80::5eff:fe00:111/64"),
            "1=fe80::5eff:fe00:111" + (if v4 { ",3=198.51.100.1" } else { "" }),
            NODE_A_SEES,
        );
}

fn node_b(v4: Bool, v6: Bool) -> String {
    return port(
        "enP2p1s0f0np0",
        "02:00:5e:00:02:73",
        "roceP2p1s0f0",
        both(v4, "203.0.113.2/30", v6, "fe80::5eff:fe00:273/64"),
        "1=fe80::5eff:fe00:273" + (if v4 { ",3=203.0.113.2" } else { "" }),
        NODE_B2_SEES,
    ) + ", "
        + port(
            "enp1s0f0np0",
            "02:00:5e:00:02:6f",
            "rocep1s0f0",
            both(v4, "198.51.100.2/30", v6, "fe80::5eff:fe00:26f/64"),
            "1=fe80::5eff:fe00:26f" + (if v4 { ",3=198.51.100.2" } else { "" }),
            NODE_B_SEES,
        );
}

fn both(a: Bool, x: String, b: Bool, y: String) -> String {
    if a && b { return x + "," + y; }
    if a { return x; }
    if b { return y; }
    return "";
}

/// node-c and node-d: IPv4 /24s, IPv6 off on the link (no link-local
/// address; the GIDs are there still), seen by ARP and LLDP.
fn node_c() -> String {
    return port(
        "enP2p1s0f0np0",
        "02:00:5e:00:03:ca",
        "roceP2p1s0f0",
        "203.0.113.2/24",
        "1=fe80::5eff:fe00:3ca,3=203.0.113.2",
        "02:00:5e:00:03:c6,02:00:5e:00:04:e2,02:00:5e:00:04:e6",
    ) + ", "
        + port(
            "enp1s0f0np0",
            "02:00:5e:00:03:c6",
            "rocep1s0f0",
            "198.51.100.2/24",
            "1=fe80::5eff:fe00:3c6,3=198.51.100.2",
            "02:00:5e:00:03:ca,02:00:5e:00:04:e2,02:00:5e:00:04:e6",
        );
}

fn node_d() -> String {
    return port(
        "enP2p1s0f0np0",
        "02:00:5e:00:04:e6",
        "roceP2p1s0f0",
        "203.0.113.1/24",
        "1=fe80::5eff:fe00:4e6,3=203.0.113.1",
        "02:00:5e:00:03:c6,02:00:5e:00:03:ca",
    ) + ", "
        + port(
            "enp1s0f0np0",
            "02:00:5e:00:04:e2",
            "rocep1s0f0",
            "198.51.100.1/24",
            "1=fe80::5eff:fe00:4e2,3=198.51.100.1",
            "02:00:5e:00:03:c6",
        );
}

fn add_node(store: st::Store, id: String, capabilities: String) {
    store.insert_node(
        st::NodeRow { id: id, name: id, created_at: api::now_seconds() },
        api::change("create", "nodes/" + id, "", "{}"),
    ) or discard;
    store.put_fleet(st::FleetRow { node: id, capabilities: capabilities, present: true })
    or discard;
    store.put_beat(id, api::now_seconds(), 0) or discard;
}

fn first_port(link: String) -> String {
    return std::json::array_first(std::json::find_field_raw(link, "ports")).element;
}

fn main() {
    // the contract: a node's cabled ports are taken as it declares them
    let decoded = api::node_capabilities(
        gb10_caps(node_a(true, true), ""),
    ) or api::no_capabilities();
    std::test::assert(decoded.has_ports && count(decoded.ports) == 2, "the ports are taken");
    let encoded = api::NodeCapabilities::api_encode(decoded);
    std::test::assert(
        std::str::contains(encoded, "\"neighbors\"")
            && std::str::contains(encoded, "02:00:5e:00:02:73")
            && std::str::contains(encoded, "\"gids\""),
        "and kept as declared: " + encoded,
    );

    // node-a and node-b: paired by what their ports see, met on the IPv4
    // pair the lower id's first port is on, every port at its own IPv4
    // address, at the GID that carries it (3)
    let s4 = gb10_caps(node_a(true, true), "");
    let f4 = gb10_caps(node_b(true, true), "");
    let sf = api::found_link("node-a", s4, "node-b", f4);
    std::test::assert(sf.cabled && sf.addressed, "cabled and addressed");
    std::test::assert_eq_str(
        sf.link,
        "{\"peer\": \"node-b\", \"ports\": [{\"ifname\": \"enP2p1s0f0np0\", \"address\": \"203.0.113.1\", \"hca\": \"roceP2p1s0f0\"}, {\"ifname\": \"enp1s0f0np0\", \"address\": \"198.51.100.1\", \"hca\": \"rocep1s0f0\"}], \"gid_index\": 3}",
        "node-a's end: both halves, IPv4, GID 3",
    );
    let fs = api::found_link("node-b", f4, "node-a", s4);
    std::test::assert_eq_str(
        std::json::find_string_field(first_port(fs.link), "address"),
        "203.0.113.2",
        "node-b's end meets node-a's on the same pair, chosen alike from either end",
    );
    std::test::assert_eq_int(
        std::json::find_int_field(fs.link, "gid_index"),
        3,
        "node-b's GID too",
    );

    // node-c and node-d: /24s, no link-local address, seen by ARP and LLDP
    let n4 = gb10_caps(node_c(), "");
    let a4 = gb10_caps(node_d(), "");
    let na = api::found_link("node-c", n4, "node-d", a4);
    std::test::assert(na.addressed, "the other pair too: " + na.link);
    std::test::assert_eq_str(
        std::json::find_string_field(first_port(na.link), "address"),
        "203.0.113.2",
        "on its IPv4 /24",
    );
    std::test::assert_eq_int(std::json::find_int_field(na.link, "gid_index"), 3, "at GID 3");
    let an = api::found_link("node-d", a4, "node-c", n4);
    std::test::assert(
        an.addressed
            && std::json::find_string_field(first_port(an.link), "address") == "203.0.113.1",
        "node-d sees one of node-c's halves, and node-c sees both of its: one sighting either way pairs them: "
            + an.link,
    );
    // the two pairs share addresses, but no port of one sees the other's
    std::test::assert(
        !api::found_link("node-a", s4, "node-c", n4).cabled,
        "node-a is not cabled to node-c",
    );
    std::test::assert(!api::found_link("node-d", a4, "node-b", f4).cabled, "nor node-d to node-b");

    // no IPv4: the link-local addresses, at the RoCE v2 GID that carries
    // them (1); the leader's address reached out of each node's own port
    let s6 = gb10_caps(node_a(false, true), "");
    let f6 = gb10_caps(node_b(false, true), "");
    let ll = api::found_link("node-a", s6, "node-b", f6);
    std::test::assert(ll.addressed, "IPv6 link-local addresses meet: " + ll.link);
    std::test::assert_eq_str(
        std::json::find_string_field(first_port(ll.link), "address"),
        "fe80::5eff:fe00:115",
        "without its prefix or a scope",
    );
    std::test::assert_eq_int(std::json::find_int_field(ll.link, "gid_index"), 1, "at GID 1");
    let fl = api::found_link("node-b", f6, "node-a", s6);
    std::test::assert_eq_str(
        api::reached_from("fe80::5eff:fe00:115", fl.link),
        "fe80::5eff:fe00:115%enP2p1s0f0np0",
        "node-b reaches node-a's address out of its own first port",
    );
    std::test::assert_eq_str(
        api::reached_from("203.0.113.1", fl.link),
        "203.0.113.1",
        "IPv4 as it is",
    );
    // IPv4 on one end alone: they meet on IPv6 link-local
    let mixed = api::found_link("node-a", s4, "node-b", f6);
    std::test::assert_eq_int(
        std::json::find_int_field(mixed.link, "gid_index"),
        1,
        "one family both share",
    );

    // no address at all: cabled, not addressed, its ports shown
    let s0 = gb10_caps(node_a(false, false), "");
    let f0 = gb10_caps(node_b(false, false), "");
    let none = api::found_link("node-a", s0, "node-b", f0);
    std::test::assert(
        none.cabled && !none.addressed && len(none.link) == 0,
        "cabled but not addressed",
    );
    std::test::assert(
        std::str::contains(none.ports, "\"ifname\": \"enP2p1s0f0np0\"")
            && !std::str::contains(none.ports, "\"address\"")
            && std::str::contains(none.ports, "\"speed_mbps\": 200000"),
        "its ports, with no address: " + none.ports,
    );

    // a meeting port past the fourth: it comes first, and three others
    // follow it; the list stays whole
    let lows = port(
        "a0",
        "02:00:00:00:00:01",
        "h0",
        "10.0.9.1/30",
        "3=10.0.9.1",
        "02:00:00:00:01:05",
    );
    let mut highs = "";
    let mut k = 1;
    while k <= 4 {
        highs = highs + port(
            "b" + to_string(k),
            "02:00:00:00:01:0" + to_string(k),
            "h" + to_string(k),
            "10.0." + to_string(k) + ".2/30",
            "3=10.0." + to_string(k) + ".2",
            "02:00:00:00:00:01",
        ) + ", ";
        k = k + 1;
    }
    highs = highs
        + port("b5", "02:00:00:00:01:05", "h5", "10.0.9.2/30", "3=10.0.9.2", "02:00:00:00:00:01");
    let five = api::found_link("zed", gb10_caps(highs, ""), "abe", gb10_caps(lows, ""));
    std::test::assert(std::json::valid(five.link), "a valid link: " + five.link);
    std::test::assert_eq_str(
        std::json::find_string_field(first_port(five.link), "ifname"),
        "b5",
        "the meeting port first",
    );
    let mut n = 0;
    let mut p = std::json::array_first(std::json::find_field_raw(five.link, "ports"));
    while !p.done {
        n = n + 1;
        p = std::json::array_next(p);
    }
    std::test::assert_eq_int(n, 4, "and three others, four in all");

    // through the store: an operator's declared link wins; a found one
    // fills in for a peer with none declared
    let store = st::MemoryStore { };
    let link = api::NatsLink { };
    let declared = "{\"peer\": \"node-b\", \"ports\": [{\"ifname\": \"enp1s0f0np0\", \"address\": \"198.51.100.1\", \"hca\": \"rocep1s0f0\"}], \"gid_index\": 5}";
    add_node(store, "node-a", gb10_caps(node_a(true, true), declared));
    add_node(store, "node-b", f4);
    add_node(store, "node-c", n4);
    add_node(store, "node-d", a4);
    let fleet = api::fleet_caps(store) or api::FleetCaps { };
    std::test::assert_eq_int(count(fleet.items), 4, "the nodes with cabled ports");
    let node_a_links = api::effective_links(
        fleet,
        "node-a",
        gb10_caps(node_a(true, true), declared),
    );
    std::test::assert_eq_str(
        node_a_links,
        declared,
        "node-a's declared link wins over the one found",
    );
    let node_b_links = api::effective_links(fleet, "node-b", f4);
    std::test::assert(
        std::str::contains(node_b_links, "\"peer\": \"node-a\"")
            && std::str::contains(node_b_links, "\"gid_index\": 3")
            && !std::str::contains(node_b_links, "node-c"),
        "node-b declares none, and its found one to node-a is used: " + node_b_links,
    );
    let linked = api::linked(store, "node-b", f4) or "";
    std::test::assert_eq_str(
        api::link_ports(linked, "node-a"),
        std::str::trim(std::json::find_field_raw(api::link_to(linked, "node-a"), "ports")),
        "the capabilities as the coordinator uses them carry it",
    );
    std::test::assert(
        std::str::contains(linked, "\"hardware\"") && std::str::contains(linked, "\"ports\""),
        "and the rest as declared",
    );
    std::test::assert_eq_str(
        api::linked(store, "x", "{\"engines\": []}") or "",
        "{\"engines\": []}",
        "no ports: as declared",
    );

    // the node's view: declared, found, addressed or not
    let views = api::node_links(store, "node-a", gb10_caps(node_a(true, true), declared))
    or api::NodeLinks { };
    let json = api::node_links_json(views);
    std::test::assert(
        std::str::contains(
            json,
            "{\"peer\": \"node-b\", \"paired\": true, \"source\": \"declared\", \"addressed\": true",
        )
            && std::str::contains(json, "\"gid_index\": 5")
            && !std::str::contains(json, "\"source\": \"discovered\""),
        "node-a's link to node-b as declared, node-b's found one back: " + json,
    );
    let fviews = api::node_links_json(api::node_links(store, "node-b", f4) or api::NodeLinks { });
    std::test::assert(
        std::str::contains(
            fviews,
            "\"peer\": \"node-a\", \"paired\": true, \"source\": \"discovered\", \"addressed\": true",
        )
            && std::str::contains(
                fviews,
                "\"ports\": [{\"ifname\": \"enP2p1s0f0np0\", \"address\": \"203.0.113.2\"",
            )
            && std::str::contains(fviews, "\"gid_index\": 3"),
        "node-b's found link: " + fviews,
    );
    let bare = st::MemoryStore { };
    add_node(bare, "node-a", s0);
    add_node(bare, "node-b", f0);
    let bviews = api::node_links_json(api::node_links(bare, "node-a", s0) or api::NodeLinks { });
    std::test::assert(
        std::str::contains(
            bviews,
            "\"peer\": \"node-b\", \"paired\": true, \"source\": \"discovered\", \"addressed\": false",
        ),
        "cabled, not addressed: " + bviews,
    );
    // `getNode` answers the typed `Node`: each link's ports a list of
    // ports, never their JSON as a string, a declared link's and a found
    // one's alike, as the contract says them (`NodeLink.ports`)
    let nodes = api::Nodes { store: store, link: link };
    let got_a = api::Node::api_encode(
        nodes.get(api::NodeRef { node: "node-a" }) or api::Node {
            status: api::NodeStatus::down,
        },
    );
    std::test::assert_eq_str(
        std::str::trim(
            std::json::find_field_raw(
                std::json::array_first(std::json::find_field_raw(got_a, "links")).element,
                "ports",
            ),
        ),
        "[{\"ifname\":\"enp1s0f0np0\",\"address\":\"198.51.100.1\",\"hca\":\"rocep1s0f0\"}]",
        "node-a's declared link's ports, a list: " + got_a,
    );
    let got_b = api::Node::api_encode(
        nodes.get(api::NodeRef { node: "node-b" }) or api::Node {
            status: api::NodeStatus::down,
        },
    );
    let found_ports = std::str::trim(
        std::json::find_field_raw(
            std::json::array_first(std::json::find_field_raw(got_b, "links")).element,
            "ports",
        ),
    );
    std::test::assert(
        std::str::starts_with(
            found_ports,
            "[{\"ifname\":\"enP2p1s0f0np0\",\"address\":\"203.0.113.2\"",
        )
            && std::str::contains(found_ports, "\"speed_mbps\":200000"),
        "node-b's found link's ports, a list: " + got_b,
    );
    let got_bare = api::Node::api_encode(
        api::Nodes { store: bare, link: link }.get(api::NodeRef { node: "node-a" }) or api::Node {
            status: api::NodeStatus::down,
        },
    );
    let bare_ports = std::str::trim(
        std::json::find_field_raw(
            std::json::array_first(std::json::find_field_raw(got_bare, "links")).element,
            "ports",
        ),
    );
    std::test::assert(
        std::str::starts_with(bare_ports, "[{\"ifname\":")
            && !std::str::contains(bare_ports, "\"address\""),
        "a link not addressed: its ports, with no address: " + got_bare,
    );

    let lone = st::MemoryStore { };
    add_node(lone, "node-a", s4);
    std::test::assert_eq_str(
        api::node_links_json(api::node_links(lone, "node-a", s4) or api::NodeLinks { }),
        "",
        "cabled to no node voice knows: no link (the ports say the rest)",
    );

    // a check of a found link: both nodes assigned their rank, each with
    // its end of the link; over link-local addresses, rank 0's address
    // reached out of each node's own port
    let ls = st::MemoryStore { };
    add_node(ls, "node-a", s6);
    add_node(ls, "node-b", f6);
    let rts = api::Runtimes { store: ls, shipped: api::shipped_runtimes(shipped("runtimes")) };
    let usable = rts.usable_in_gate() or api::RuntimeList { };
    let c = api::check_link_in(ls, link, usable, "node-a", "node-b") or api::no_check();
    std::test::assert(len(c.id) > 0, "a found link is checked as a declared one is");
    let rows = ls.link_checks() or st::LinkCheckRows { };
    let jobs = api::link_jobs(
        rows,
        "node-b",
        api::linked(ls, "node-b", f6) or "",
        api::now_seconds(),
    );
    let job = at(jobs.items, 0) or api::LinkJob { };
    std::test::assert_eq_str(
        job.master_addr,
        "fe80::5eff:fe00:115%enP2p1s0f0np0",
        "scoped to node-b's port",
    );
    std::test::assert(
        std::str::contains(api::link_jobs_json(jobs), "\"link\": {\"peer\": \"node-a\"")
            && std::str::contains(job.link, "\"gid_index\": 1"),
        "with node-b's end of the link: " + api::link_jobs_json(jobs),
    );
    let refused = api::check_link_in(bare, link, usable, "node-a", "node-b") or {
        std::test::assert(
            std::str::contains(api::ctl_message(err), "no addressed link to node-b"),
            "a link with no address is not checked: " + api::ctl_message(err),
        );
        api::no_check()
    };
    std::test::assert(len(refused.id) == 0, "and none started");
}
